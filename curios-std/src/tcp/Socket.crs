use /std/{Bytes, Str, Nat, Bool, Try, Io};
use /std/tcp/{resolve, Socket, release};
use /std/internal/{Handle, error};

satisfy Io/Read(Socket) {
    read(c, n, @positive) = Io/read(@Handle, c.0, n, @positive),
}

satisfy Io/Write(Socket) {
    write(c, b) = Io/write(c.0, b),
    flush(c) = Io/flush(c.0),
}

--- `c`'s sending half ended, with `c` still reading: the peer reads the end of the stream — a TLS peer its closure alert first — and whatever it sends after is still `c`'s to read. It is how a connection says it has finished, where `close` says nothing and resets a connection that holds unread bytes.
satisfy Io/Finish(Socket) {
    finish(c) = Io/finish(c.0),
}

--- Close `c` before its scope ends, saying nothing to the peer. The scope's own release then finds nothing to close.
satisfy Io/Close(Socket) {
    close(c) = Io/close(c.0),
}

let close_raising(@A: Type, h: Handle, e: Io/Error) -> Try(Io, Io/Error, A) =
    let _ = Io/close(h)!;
    Try/raise(e);

--- Create a socket for the family of this address: `ok` beside its handle, or the status of the failure.
foreign socket_open(Bytes) -> {status: Nat, handle: Handle};

let opened(addr: Bytes) -> Try(Io, Io/Error, Handle) =
    let reply = socket_open(addr)!;
    match reply.status == /sys/status/ok
    | true => Try/pure(reply.handle)
    | false => Try/raise(error(reply.status))
    end;

--- Start connecting this socket to this address: `ok`, or the status of the failure.
foreign socket_connect(Handle, Bytes) -> Nat;

let open_and_connect(addr: Bytes) -> Try(Io, Io/Error, {Handle, Bool}) =
    let h = opened(addr)!;
    let status = socket_connect(h, addr)!;
    choose
    | status == /sys/status/ok => Try/pure((h, false))
    | status == /sys/status/would_block => Try/pure((h, true))
    | _ =>
        let _ = Io/close(h)!;
        Try/raise(error(status))
    end;

--- How a connect under way ended: `ok`, or the status of the failure.
foreign socket_finish_connect(Handle) -> Nat;

let settle(h: Handle, pending: Bool) -> Try(Io, Io/Error, {}) =
    match pending
    | false => Try/pure(())
    | true =>
        let _ = Handle/wait(h, Handle/Interest/writable)!;
        let status = socket_finish_connect(h)!;
        choose
        | status == /sys/status/ok => Try/pure(())
        | status == /sys/status/would_block => settle(h, true)
        | _ => Try/raise(error(status))
        end
    end;

--- Upgrade this socket to a TLS client stream for this server name: `ok`, or the status of the failure.
foreign tls_start(Handle, Bytes) -> Nat;

let upgrade(h: Handle, host: Str, tls: Bool) -> Try(Io, Io/Error, {}) =
    match tls
    | true =>
        let status = tls_start(h, Str/to_bytes(host))!;
        match status == /sys/status/ok
        | true => Try/pure(())
        | false => Try/raise(error(status))
        end
    | false => Try/pure(())
    end;

let connect_addr(s: Io/Scope, host: Str, addr: Bytes, tls: Bool) -> Try(Io, Io/Error, Socket) =
    let (h, pending) = open_and_connect(addr)!;
    let _ = Io/Scope/defer(s, (how) => release(h, how))!;
    let _ = Try/rescue(settle(h, pending), (e) => close_raising(h, e))!;
    let _ = Try/rescue(upgrade(h, host, tls), (e) => close_raising(h, e))!;
    Try/pure(Socket { h });

--- A connection to `host` at `port`, in the clear, opened into `s`. When `s` ends the connection is closed, and where `s` finished, what it holds of the writes it accepted is handed on and its sending half ended first, a courtesy whose failure is no one's: a body that must know its last writes left flushes them itself.
pub let connect(s: Io/Scope, host: Str, port: Nat) -> Try(Io, Io/Error, Socket) =
    let addr = resolve(host, port)!;
    connect_addr(s, host, addr, false);

--- A connection to `host` at `port` under TLS, the certificate checked against `host`, opened into `s` as `connect` opens one.
pub let connect_tls(s: Io/Scope, host: Str, port: Nat) -> Try(Io, Io/Error, Socket) =
    let addr = resolve(host, port)!;
    connect_addr(s, host, addr, true);

--- `request` written whole and the reply read to its end: one exchange with a peer that closes when it has answered.
pub let call(c: Socket, request: Bytes) -> Try(Io, Io/Error, Bytes) =
    let _ = Io/write(c, request)!;
    Io/read_all(c);
