mod tests;

-- The problems that keep a declaration from describing one unambiguous command line.
mod check;

-- A line's tokens read as GNU reads them, and the known name nearest to one that names nothing.
mod scan;

-- The screens a command line answers with.
mod render;

-- A line read against a command: what it parsed into, a request for help or the version, or the refusal.
mod parse;

--- What a line parses into: the slots a command's options and positionals fill, the values they hold, and the reads of them by name.
pub mod Parsed;
pub use Parsed/{let Parsed, Slot, Carrier, option_slots, slots, Slots, Values, Chosen, Lookup, Has,
    get, HasIn, NamedIn, HasCommand, Named, command};

use /std/{Str, Bytes, Nat, Int, Flt, Bool, Char, List, Option, Result, Map, Io, Show, Fmt, Process,
    print, print_err};
use /std/ops/{Eql};

--- How an argument's text is read: the type it is read into, the placeholder help shows for it, the reader, the printer help shows a default with, and the values it takes where they are a closed set, which help lists.
pub struct Value: pub Type {
    A: Type,
    metavar: Str,
    read: (Str) -> Result(Str, A),
    show: (A) -> Str,
    choices: List(Str),
}

--- Text, as written.
pub let str: Value =
    Value {
        A = Str,
        metavar = "S",
        read = (s) => Result/success(s),
        show = (s) => s,
        choices = [] };

--- A natural number in decimal.
pub let nat: Value =
    Value {
        A = Nat,
        metavar = "N",
        read =
            (s) =>
                match Nat/of_str(s)
                | some(n) => Result/success(n)
                | none() => Result/failure(Fmt/render("expected a natural number, found '%'")(s))
                end,
        show = Nat/to_str,
        choices = [] };

--- An integer in decimal, with an optional sign.
pub let int: Value =
    Value {
        A = Int,
        metavar = "N",
        read =
            (s) =>
                match Int/of_str(s)
                | some(n) => Result/success(n)
                | none() => Result/failure(Fmt/render("expected an integer, found '%'")(s))
                end,
        show = Show/show,
        choices = [] };

--- A floating-point number.
pub let flt: Value =
    Value {
        A = Flt,
        metavar = "X",
        read =
            (s) =>
                match Flt/of_str(s)
                | some(x) => Result/success(x)
                | none() => Result/failure(Fmt/render("expected a number, found '%'")(s))
                end,
        show = Show/show,
        choices = [] };

--- A reader of a program's own type: `read` turns the text into a value or says why it cannot, and `show` writes a value back, as help shows a default.
pub let reader(@A: Type, metavar: Str, read: (Str) -> Result(Str, A), show: (A) -> Str) -> Value =
    Value { A = A, metavar = metavar, read = read, show = show, choices = [] };

--- One of a closed set of values, each read from its name: help lists the names, and shows a value by its own.
pub let one_of(@A: Type, use Eql(A), metavar: Str, named: List({Str, A})) -> Value =
    let names = List/map(named, (entry: {Str, A}) => entry.0);
    Value {
        A = A,
        metavar = metavar,
        read =
            (s) =>
                match List/find(named, (entry: {Str, A}) => entry.0 == s)
                | some(entry) => Result/success(entry.1)
                | none() =>
                    Result/failure(
                        Fmt/render("expected one of %, found '%'")(Str/join(", ", names))(s))
                end,
        show =
            (a) =>
                match List/find(named, (entry: {Str, A}) => entry.1 == a)
                | some(entry) => entry.0
                | none() => ""
                end,
        choices = names };

--- Whether an option must be given, may be absent, or stands for `a` where it is absent.
pub induct Presence(A: Type): pub Type
--- It must be given.
| required()
--- It may be absent, and is read as an `Option`.
| optional()
--- It stands for `a` where it is absent.
| default(a: A)
end

--- One flag of a choice: its name, its help, and the value it stands for.
pub struct Alternative(A: Type): pub Type {
    long: Str,
    help: Str,
    value: A,
}

--- What an option is.
pub induct Kind: pub Type
--- A name alone: `true` where it is given.
| flag()
--- A name given any number of times, counted: `-vvv` is three.
| count()
--- A switch read as `--x` and `--no-x`, the last one given standing, and `fallback` where neither is.
| toggle(fallback: Bool)
--- A name taking a value, the last one given standing.
| option(v: Value, presence: Presence(v.A))
--- A name taking a value each time it is given, every value kept in order.
| many(v: Value)
--- Flags of which at most one is given, each standing for a value.
| choice(A: Type, alternatives: List(Alternative(A)), presence: Presence(A))
end

--- One option a command takes: its long name, the short one it may have, the other long names it answers to, its help, the environment variable that stands for it where the line does not give it, whether help leaves it out, and its kind. A choice is given by its alternatives' names, and its own long name is the one it is read by.
pub struct Field: pub Type {
    long: Str,
    short: Option(Char),
    aliases: List(Str),
    help: Str,
    env: Option(Str),
    hidden: Bool,
    kind: Kind,
}

let named(long: Str, help: Str, kind: Kind) -> Field =
    Field {
        long = long,
        short = Option/none(),
        aliases = [],
        help = help,
        env = Option/none(),
        hidden = false,
        kind = kind };

--- A flag `--long`, `true` where it is given.
pub let flag(long: Str, help: Str) -> Field =
    named(long, help, Kind/flag());

--- A flag counted: `-vvv` is three, and none is zero.
pub let count(long: Str, help: Str) -> Field =
    named(long, help, Kind/count());

--- A switch read as `--long` and `--no-long`, the last one given standing, and `fallback` where neither is.
pub let toggle(long: Str, fallback: Bool, help: Str) -> Field =
    named(long, help, Kind/toggle(fallback));

--- An option `--long VALUE` that must be given.
pub let option(long: Str, v: Value, help: Str) -> Field =
    named(long, help, Kind/option(v, Presence/required()));

--- An option that may be absent, read as an `Option`.
pub let optional(long: Str, v: Value, help: Str) -> Field =
    named(long, help, Kind/option(v, Presence/optional()));

--- An option that stands for `fallback` where it is absent.
pub let default(long: Str, v: Value, fallback: v.A, help: Str) -> Field =
    named(long, help, Kind/option(v, Presence/default(fallback)));

--- An option given any number of times, every value kept in order.
pub let many(long: Str, v: Value, help: Str) -> Field =
    named(long, help, Kind/many(v));

--- Flags of which at most one is given, each standing for its value: read by `long`, as `presence` says where none is given.
pub let choice(
    @A: Type,
    long: Str,
    alternatives: List(Alternative(A)),
    presence: Presence(A),
    help: Str,
) -> Field =
    named(long, help, Kind/choice(A, alternatives, presence));

--- An argument read by its place: its name, which help shows and `get` reads it by, its help, and how it is read.
pub struct Positional: pub Type {
    name: Str,
    help: Str,
    v: Value,
}

--- A positional, `NAME` in help.
pub let positional(name: Str, v: Value, help: Str) -> Positional =
    Positional { name = name, help = help, v = v };

--- What a command reads by place, in the one order a line can give them: those it requires, then those that may be absent, then the one that takes every positional after them.
pub struct Positionals: pub Type {
    required: List(Positional),
    optional: List(Positional),
    rest: Option(Positional),
}

--- `required`, and nothing after them.
pub let positionals(required: List(Positional)) -> Positionals =
    Positionals { required = required, optional = [], rest = Option/none() };

--- A command a program is made of: a leaf reads its options and its positionals, and a group reads its options and hands the rest of the line to the command its next word names.
pub induct Command: pub Type
--- A command that does the work.
| leaf(name: Str, about: Str, options: List(Field), positionals: Positionals)
--- A command of commands.
| group(name: Str, about: Str, options: List(Field), commands: List(Command))
end

pub use Command/*;

--- The word a command is chosen by.
pub let name(c: Command) -> Str =
    match c | leaf(n, _, _, _) => n | group(n, _, _, _) => n end;

--- A name as a line spells it: `--long`, `--no-long` for a switch's negation, or `-c`.
pub induct Spelled: pub Type
| long(Str)
| negated(Str)
| short(Char)
end

-- The text a line writes `s` as.
let text_of(s: Spelled) -> Str =
    match s
    | long(n) => Str/concat("--", n)
    | negated(n) => Str/concat("--no-", n)
    | short(c) => Str/concat("-", Str/of_char(c))
    end;

--- What keeps a declaration from describing one unambiguous command line.
pub induct Problem: pub Type
--- A long name, an alias, a positional's or a command's name, or an environment variable, that no line can write or no host can set.
| invalid_name(Str)
--- A short name no cluster can hold, or a digit, which a negative number would be read as.
| invalid_short(Char)
--- Two options of one command, or one and a built-in, answer to this name.
| duplicate_name(Spelled)
--- Two of a command's options and positionals are read by this name.
| duplicate_slot(Str)
--- Two commands of one group answer to this word.
| duplicate_command(Str)
--- A problem of the command of this name, beneath the one it is reported in.
| within(command: Str, problem: Problem)
end

let described(p: Problem) -> Str =
    match p
    | invalid_name(n) => Fmt/render("invalid name #")(n)
    | invalid_short(c) => Fmt/render("invalid short name '%'")(c)
    | duplicate_name(n) => Fmt/render("duplicate name %")(text_of(n))
    | duplicate_slot(n) => Fmt/render("two arguments read by #")(n)
    | duplicate_command(n) => Fmt/render("duplicate command #")(n)
    | within(c, inner) => Fmt/render("in command #: %")(c)(described(inner))
    end;

satisfy Show(Problem) {
    show(p) = described(p),
}

--- What a declaration with these problems is: a proposition nothing proves, so a declaration that has them is refused where it is written, by its problems.
pub induct Refused: (List(Problem)) -> pub Prop
end

let Clear(problems: List(Problem)) -> Prop =
    match problems | [] => Bool/True | [p, ..more] => Refused([p, ..more]) end;

--- That `command`, with `version` where it has one, describes one unambiguous command line, decided by reduction: `Bool/True` where it does, and otherwise `Refused` of every problem it has.
pub let WellFormed(command: Command, version: Option(Str)) -> Prop =
    Clear(check/problems(command, version));

--- A command line a program reads: its root command, the version `--version` answers with where it has one, and the evidence that the two describe one unambiguous command line.
pub struct Cli: pub Type {
    command: Command,
    version: Option(Str),
    @ok: WellFormed(command, version),
}

--- A fixed declaration, checked by reduction where it is written: one with problems is refused there, by them.
pub let declare(command: Command, version: Option(Str), @ok: WellFormed(command, version)) -> Cli =
    Cli { command = command, version = version, @ok = ok };

--- A declaration checked as the program runs: the command line, or every problem that keeps it from describing one.
pub let checked(command: Command, version: Option(Str)) -> Result(List(Problem), Cli) =
    match check/problems(command, version): (problems) =>
        (made: (ok: Clear(problems)) -> Cli) -> Result(List(Problem), Cli)
    | [] => (made) => Result/success(made(Bool/True/qed()))
    | [p, ..more] => (_) => Result/failure([p, ..more])
    end((ok) => Cli { command = command, version = version, @ok = ok });

--- Why a line was refused.
pub induct Failure: pub Type
--- A token no name of the command matches, and the known name nearest to it.
| unknown_option(token: Str, near: Option(Str))
--- An option was given without the value it takes.
| missing_value(name: Str)
--- An argument the command requires was not given.
| missing_required(name: Str)
--- A token nothing was left to take.
| unexpected(token: Str)
--- A value was read and refused, for this reason.
| bad_value(name: Str, reason: Str)
--- Alternatives of one choice were given together.
| conflict(names: List(Str))
--- A word that names none of the group's commands, the nearest that does, and those there are.
| unknown_command(word: Str, near: Option(Str), known: List(Str))
--- A group was given no command, and those it has.
| missing_command(known: List(Str))
end

--- What a line read as: the parse, a request for the help of the command `path` names from the root, one for the version, or the refusal with the path of the command that refused it.
pub induct Reading(A: Type): pub Type
--- The line parsed.
| parsed(A)
--- The line asked for help.
| help(path: List(Str))
--- The line asked for the version.
| version(text: Str)
--- The line was refused.
| refused(path: List(Str), failure: Failure)
end

-- `name` as help writes a positional's.
let shouted(name: Str) -> Str =
    Str/flatten(List/map(Str/to_list(name), (c) => Str/of_char(Char/to_ascii_upper(c))));

--- `argv` read against `cli`, `env` the environment variables the declaration names: what it parsed into, a request for help or the version, or the refusal. Help is answered before anything else on the line is, and the version next.
pub let parse(cli: Cli, argv: List(Str), env: Map(Str, Str)) -> Reading(Parsed(cli.command)) =
    parse/command(cli.command, argv, [], cli.version, env);

--- The help of the command `path` names from the root, as `--help` writes it.
pub let help(cli: Cli, path: List(Str)) -> Str =
    render/help(cli.command, cli.version, path);

--- The usage line of the command `path` names from the root.
pub let usage(cli: Cli, path: List(Str)) -> Str =
    render/usage(cli.command, path);

--- `failure` as `main` reports it: what the line got wrong, the usage line of the command `path` names, and where help is.
pub let report(cli: Cli, path: List(Str), failure: Failure) -> Str =
    render/report(cli.command, path, failure);

let decode(raw: List(Bytes)) -> Result(Nat, List(Str)) =
    let walk(rest: List(Bytes), at: Nat) -> Result(Nat, List(Str)) =
        match rest
        | [] => Result/success([])
        | [b, ..more] =>
            match Str/of_bytes(b)
            | failure(_) => Result/failure(at)
            | success(s) =>
                let tail = walk(more, at + 1)!;
                Result/success([s, ..tail])
            end
        end;
    walk(raw, 0);

-- Every environment variable `c` and the commands beneath it declare.
let variables(c: Command) -> List(Str) =
    match c
    | leaf(_, _, options, _) =>
        List/concat_map(options, (f) => match f.env | some(n) => [n] | none() => [] end)
    | group(_, _, options, commands) =>
        [
            ..List/concat_map(options, (f) => match f.env | some(n) => [n] | none() => [] end),
            ..variables_of(commands)]
    end
and variables_of(commands: List(Command)) -> List(Str) =
    match commands | [] => [] | [c, ..more] => [..variables(c), ..variables_of(more)] end;

let environment(names: List(Str)) -> Io(Map(Str, Str)) =
    match names
    | [] => Io/pure(Map/empty())
    | [n, ..more] =>
        let held = environment(more)!;
        let value = Process/env(n)!;
        Io/pure(
            match Option/bind(value, (b) => Result/to_option(Str/of_bytes(b)))
            | some(text) => Map/insert(held, n, text)
            | none() => held
            end)
    end;

let refuse(text: Str) -> Io({}) =
    let _ = print_err(text)!;
    Process/exit(2);

--- The process's command line read against `cli`, beside the environment variables it declares, and what it parsed into handed to `run`. Help and the version are written to standard output; a line refused is reported on standard error with the usage of the command that refused it, and ends the program with 2.
pub let main(cli: Cli, run: (Parsed(cli.command)) -> Io({})) -> Io({}) =
    let raw = Process/args()!;
    let dropped = match raw | [] => [] | [_, ..more] => more end;
    match decode(dropped)
    | failure(at) =>
        refuse(
            Fmt/render(
                "error: argument % is not valid UTF-8\n\n%\n\nFor more information, try '--help'.\n")(
                at + 1)(
                usage(cli, [name(cli.command)])))
    | success(argv) =>
        let env = environment(variables(cli.command))!;
        match parse(cli, argv, env)
        | parsed(p) => run(p)
        | help(path) => print(help(cli, path))
        | version(text) => print(Str/concat(text, "\n"))
        | refused(path, f) => refuse(report(cli, path, f))
        end
    end;

--- `command` checked as the program starts and run as `main` runs a declared one; a declaration with problems is reported on standard error before the line is read, and ends the program with 1.
pub let try_main(
    command: Command,
    version: Option(Str),
    run: (Parsed(command)) -> Io({}),
) -> Io({}) =
    match check/problems(command, version): (problems) =>
        (go: (ok: Clear(problems)) -> Io({})) -> Io({})
    | [] => (go) => go(Bool/True/qed())
    | [p, ..more] =>
        (_) =>
            let _ =
                Fmt/print_err("error: invalid command line declaration: %\n")(
                    Str/join("; ", List/map([p, ..more], described)))!;
            Process/exit(1)
    end((ok) => main(Cli { command = command, version = version, @ok = ok }, run));
