use /std/{Str, Bytes, Nat, Int, Flt, Bool, Char, List, Option, Result, Io, print, print_err, proc};
use /std/Bool/{True, False};

pub mod Grammar;
pub use Grammar/{let Grammar};

pub mod Prepared;
pub use Prepared/{let Prepared};

pub mod SpecError;
pub use SpecError/{let SpecError};

pub mod record;
pub use record/{let record};

pub mod render;

pub mod Reading;
pub use Reading/{let Reading};

pub mod interpret;
pub use interpret/{let interpret};

pub mod Declaration;
pub use Declaration/{let Declaration, group, checked, declare, Sound, Declared};

--- How an argument's text is read into a value: the placeholder shown in help, and the reader.
pub struct Value: pub Type {
    A: Type,
    metavar: Str,
    read: (Str) -> Result(Str, A),
}

--- A string, as written.
pub let str: Value =
    Value { A = Str, metavar = "S", read = (s) => Result/success(s) };

--- A natural number in decimal.
pub let nat: Value =
    Value {
        A = Nat,
        metavar = "N",
        read =
            (s) =>
                match Nat/of_str(s)
                | some(n) => Result/success(n)
                | none() => Result/failure(Str/flatten(["expected a number, found '", s, "'"]))
                end };

--- An integer in decimal, with an optional sign.
pub let int: Value =
    Value {
        A = Int,
        metavar = "N",
        read =
            (s) =>
                match Int/of_str(s)
                | some(n) => Result/success(n)
                | none() => Result/failure(Str/flatten(["expected an integer, found '", s, "'"]))
                end };

--- A floating-point number.
pub let flt: Value =
    Value {
        A = Flt,
        metavar = "X",
        read =
            (s) =>
                match Flt/of_str(s)
                | some(x) => Result/success(x)
                | none() => Result/failure(Str/flatten(["expected a number, found '", s, "'"]))
                end };

--- A reader of a program's own type, shown as `metavar` in help.
pub let reader(@A: Type, metavar: Str, f: (Str) -> Result(Str, A)) -> Value =
    Value { A = A, metavar = metavar, read = f };

--- Whether an option must appear, may be absent, or stands for `a` when absent.
pub induct Presence(A: Type): pub Type
--- It must appear.
| required()
--- It may be absent.
| optional()
--- It stands for `a` when absent.
| default(a: A)
end

--- What an argument is: a flag, an option taking a value, an option taking every value it is given, a positional, or the collector of every remaining positional.
pub induct Kind: pub Type
--- A name alone, present or not.
| flag()
--- A name taking one value.
| option(v: Value, presence: Presence(v.A))
--- A name taking every value it is given.
| many(v: Value)
--- A value taken by its place rather than by name.
| positional(v: Value)
--- The collector of every positional after the ones declared.
| rest(v: Value)
end

--- One argument a program declares: its long name, an optional short one, its help line and its kind.
pub struct Arg: pub Type {
    long: Str,
    short: Option(Char),
    help: Str,
    kind: Kind,
}

--- A flag `--long`.
pub let flag(long: Str, help: Str) -> Arg =
    Arg { long = long, short = Option/none(), help = help, kind = Kind/flag() };

--- A required option `--long VALUE`.
pub let option(long: Str, v: Value, help: Str) -> Arg =
    Arg {
        long = long,
        short = Option/none(),
        help = help,
        kind = Kind/option(v, Presence/required()) };

--- An option that may be absent, read as an `Option`.
pub let optional(long: Str, v: Value, help: Str) -> Arg =
    Arg {
        long = long,
        short = Option/none(),
        help = help,
        kind = Kind/option(v, Presence/optional()) };

--- An option that stands for `fallback` when absent.
pub let default(long: Str, v: Value, fallback: v.A, help: Str) -> Arg =
    Arg {
        long = long,
        short = Option/none(),
        help = help,
        kind = Kind/option(v, Presence/default(fallback)) };

--- An option that keeps every value it is given.
pub let many(long: Str, v: Value, help: Str) -> Arg =
    Arg { long = long, short = Option/none(), help = help, kind = Kind/many(v) };

--- A required positional, filled in declaration order.
pub let positional(long: Str, v: Value, help: Str) -> Arg =
    Arg { long = long, short = Option/none(), help = help, kind = Kind/positional(v) };

--- The collector of every positional after the declared ones. At most one, and after every positional.
pub let rest(long: Str, v: Value, help: Str) -> Arg =
    Arg { long = long, short = Option/none(), help = help, kind = Kind/rest(v) };

let KindCarrier(k: Kind) -> Type =
    match k
    | flag() => Bool
    | option(v, presence) =>
        match presence | required() => v.A | optional() => Option(v.A) | default(_) => v.A end
    | many(v) => List(v.A)
    | positional(v) => v.A
    | rest(v) => List(v.A)
    end;

--- The type a parsed argument has in the record: `Bool` for a flag, the reader's type for a required or defaulted option and a positional, an `Option` for an optional one, and a list for `many` and `rest`.
pub let Carrier(a: Arg) -> Type =
    KindCarrier(a.kind);

--- The record a line parsed into, indexed by the arguments it was parsed against.
pub induct Values: (List(Arg)) -> pub Type
--- No arguments were declared, so nothing was parsed.
| nil(): ([])
--- One argument's value, then the rest.
| cons(@a: Arg, @rest: List(Arg), head: Carrier(a), tail: Values(rest)): ([a, ..rest])
end

--- The type `get` answers for `name` in `spec`.
pub let Lookup(spec: List(Arg), name: Str) -> Type =
    match spec
    | [] => {}
    | [a, ..rest] => match a.long == name | true => Carrier(a) | false => Lookup(rest, name) end
    end;

--- That `name` is one of `spec`'s long names, decided by reduction: a name the declaration lacks is refused where it is written.
pub let Has(spec: List(Arg), name: Str) -> Prop =
    match spec
    | [] => False
    | [a, ..rest] => match a.long == name | true => True | false => Has(rest, name) end
    end;

--- The field named `name`, at the type its argument decides.
pub let get(
    @spec: List(Arg),
    v: Values(spec),
    name: Str,
    @ok: Has(spec, name),
) -> Lookup(spec, name) =
    match v
    | nil() => match ok end
    | cons(@a, @rest, head, tail) =>
        let pick =
            match a.long == name: (b) =>
                (here: match b | true => True | false => Has(rest, name) end) -> match b
                | true => Carrier(a)
                | false => Lookup(rest, name)
                end
            | true => (_) => head
            | false => (later) => get(@rest, tail, name, @later)
            end;
        pick(ok)
    end;

--- A transparent command tree whose evidence certifies every declaration before invocation processing.
pub struct Cli: pub Type {
    tree: Declaration,
    @sound: Sound(tree),
}

--- Declare a command whose handler receives exactly the result of its certified grammar.
pub let leaf(
    @A: Type,
    name: Str,
    about: Str,
    version: Option(Str),
    grammar: Grammar(A),
    run: (A) -> Io({}),
) -> Declaration =
    Declaration/command(name, about, version, Prepared/prepare(grammar), run);

pub let name(cli: Cli) -> Str =
    Declaration/name(cli.tree);

pub let about(cli: Cli) -> Str =
    Declaration/about(cli.tree);

pub let version(cli: Cli) -> Option(Str) =
    Declaration/version(cli.tree);

--- Why a line was refused.
pub induct Failure: pub Type
--- A token no declared name matches.
| unknown_option(token: Str)
--- An option was given without the value it takes.
| missing_value(name: Str)
--- A required argument never appeared.
| missing_required(name: Str)
--- A token nothing was left to take.
| unexpected(token: Str)
--- The value was read and refused, for this reason.
| bad_value(name: Str, reason: Str)
--- A singular value-taking option appeared more than once.
| repeated(name: Str)
--- Explicit occurrences selected incompatible alternatives.
| conflict(names: List(Str))
--- No alternative received a distinguishing occurrence or positional value.
| missing_alternative(names: List(Str))
--- A validation of a parsed group refused its result.
| validation(reason: Str)
--- A subcommand no declaration names, beside those that do.
| unknown_command(name: Str, known: List(Str))
--- A subcommand was owed and none was given, beside those that would do.
| missing_command(known: List(Str))
end

--- The record adapter distinguishes specification errors from invocation outcomes.
pub let Outcome(spec: List(Arg)) -> Type =
    Result(SpecError, Reading(Values(spec)));

pub let parse(spec: List(Arg), argv: List(Str), version: Option(Str)) -> Outcome(spec) =
    let grammar = record/checked_record(spec)!;
    interpret(Prepared/prepare(grammar), argv, version);

let shout(s: Str) -> Str =
    Str/flatten(List/map(Str/to_list(s), (c) => Str/of_char(Char/to_ascii_upper(c))));

--- Render the usage of a certified command tree.
pub let usage(within: List(Str), cli: Cli) -> Str =
    let invoked = [..within, name(cli)];
    match cli.tree
    | command(_, _, _, prepared, _) => render/usage(invoked, prepared)
    | group(_, _, _, _) => Str/flatten(["Usage: ", Str/join(" ", [..invoked, "<COMMAND>"])])
    end;

--- Render a certified tree, retaining grouping and exclusivity in its synopsis.
pub let help(within: List(Str), cli: Cli) -> Str =
    let usage_text = usage(within, cli);
    let sections =
        match cli.tree
        | command(_, _, v, prepared, _) => render/sections(prepared, v)
        | group(_, _, v, commands) =>
            Str/concat(
                render/section("Options:", render/builtins(v)),
                render/section(
                    "Commands:",
                    List/map(commands, (child) =>
                        (Declaration/name(child), Declaration/about(child)))))
        end;
    Str/flatten([about(cli), "\n\n", usage_text, "\n\n", sections]);

let complaint(f: Failure) -> Str =
    match f
    | unknown_option(t) => Str/flatten(["unexpected argument '", t, "'"])
    | missing_value(n) => Str/flatten(["a value is required for '--", n, "'"])
    | missing_required(n) => Str/flatten(["the argument '", shout(n), "' is required"])
    | unexpected(t) => Str/flatten(["unexpected argument '", t, "'"])
    | bad_value(n, r) => Str/flatten(["invalid value for '--", n, "': ", r])
    | repeated(n) => Str/flatten(["the argument '--", n, "' cannot be used more than once"])
    | conflict(names) => Str/concat("conflicting arguments: ", Str/join(", ", names))
    | missing_alternative(names) =>
        Str/concat("one of these arguments is required: ", Str/join(", ", names))
    | validation(reason) => reason
    | unknown_command(n, known) =>
        Str/flatten(["unrecognized subcommand '", n, "'\n  available: ", Str/join(", ", known)])
    | missing_command(known) =>
        Str/flatten(["a subcommand is required\n  available: ", Str/join(", ", known)])
    end;

--- A refusal names the invocation error and the usage of the certified tree.
pub let report(within: List(Str), cli: Cli, failure: Failure) -> Str =
    Str/flatten([
        "error: ",
        complaint(failure),
        "\n\n",
        usage(within, cli),
        "\n\nFor more information, try '--help'.\n"]);

--- The certified child and its remaining line, a control request, or an invocation refusal.
pub induct Chosen: pub Type
--- This certified subcommand, and the line left for it.
| chose(sub: Cli, rest: List(Str))
--- The line asked for help.
| wanted_help()
--- The line asked for this version text.
| wanted_version(text: Str)
--- The invocation was refused.
| refused(failure: Failure)
end

let command_names(commands: List(Declaration)) -> List(Str) =
    List/map(commands, Declaration/name);

-- Selection extracts the child's existing evidence from the certified sibling list.
let named(
    subs: List(Declaration),
    wanted: Str,
    @sound: Declaration/ChildrenSound(subs),
) -> Option(Cli) =
    match subs
    | [] => Option/none()
    | [child, ..more] =>
        match Declaration/name(child) == wanted
        | true => Option/some(Cli { tree = child, @sound = sound.1 })
        | false => named(more, wanted, @sound.2)
        end
    end;

--- A group owns its first token. Tokens after a command name belong to that certified child.
pub let select(cli: Cli, argv: List(Str)) -> Chosen =
    match cli.tree
    | command(_, _, _, _, _) => Chosen/refused(Failure/missing_command([]))
    | group(_, _, v, commands) =>
        let names = command_names(commands);
        match argv
        | [] => Chosen/refused(Failure/missing_command(names))
        | [first, ..rest] =>
            let prepared = Prepared/prepare(Grammar/pure(()));
            let available: interpret/Available(Grammar/aliases(prepared.grammar.tree), v) =
                (
                    True/qed(),
                    True/qed(),
                    match v | none() => True/qed() | some(_) => True/qed() end);
            match interpret/certified(prepared, [first], v, @available)
            | help() => Chosen/wanted_help()
            | version(text) => Chosen/wanted_version(text)
            | _ =>
                match named(commands, first, @cli.sound.1)
                | some(sub) => Chosen/chose(sub, rest)
                | none() => Chosen/refused(Failure/unknown_command(first, names))
                end
            end
        end
    end;

let decode(raw: List(Bytes)) -> Result(Nat, List(Str)) =
    let walk(rest: List(Bytes), at: Nat) -> Result(Nat, List(Str)) =
        match rest
        | [] => Result/success([])
        | [b, ..more] =>
            match Str/of_bytes(b)
            | failure(_) => Result/failure(at)
            | success(s) =>
                let tail = walk(more, at + 1)!;
                Result/success([s, ..tail])
            end
        end;
    walk(raw, 0);

let fail_with(text: Str) -> Io({}) =
    let _ = print_err(text)!;
    proc/exit(2);

--- Report a construction failure on standard error and exit 1 before invocation processing.
pub let specification_error(error: SpecError) -> Io({}) =
    let _ =
        print_err(
            Str/flatten([
                "error: invalid command specification: ",
                SpecError/to_str(error),
                "\n"]))!;
    proc/exit(1);

let drive(within: List(Str), cli: Cli, argv: List(Str)) -> Io({}) =
    match cli.tree
    | command(_, _, v, prepared, run) =>
        match interpret/certified(prepared, argv, v, @cli.sound.1)
        | help() => print(help(within, cli))
        | version(text) => print(Str/concat(text, "\n"))
        | failure(f) => fail_with(report(within, cli, f))
        | parsed(value) => run(value)
        end
    | group(_, _, _, _) =>
        match select(cli, argv)
        | wanted_help() => print(help(within, cli))
        | wanted_version(text) => print(Str/concat(text, "\n"))
        | refused(f) => fail_with(report(within, cli, f))
        | chose(sub, rest) => drive([..within, name(cli)], sub, rest)
        end
    end;

--- Decode UTF-8 and dispatch a certified command tree. Invocation errors exit 2; owned help/version succeed with 0.
pub let main(cli: Cli) -> Io({}) =
    let raw = proc/args()!;
    let dropped = match raw | [] => [] | [_, ..more] => more end;
    match decode(dropped)
    | failure(at) =>
        fail_with(
            Str/flatten([
                "error: argument ",
                Nat/to_str(at + 1),
                " is not valid UTF-8\n\n",
                usage([], cli),
                "\n\nFor more information, try '--help'.\n"]))
    | success(argv) => drive([], cli, argv)
    end;
