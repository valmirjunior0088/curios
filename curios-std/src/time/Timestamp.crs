use /std/{Nat, Int, Str, Io, Ord, Hash, Show, Spell, Fmt};
use /std/ops/{Eql, Cmp};
use /std/time/{Duration};

--- A moment: nanoseconds since 1970-01-01T00:00:00Z, counted as POSIX counts its seconds, with no leap second, and signed, so a moment before 1970 is one too.
pub struct Timestamp: Type {
    nanos: Int,
}

satisfy Eql(Timestamp) {
    ..
}

satisfy Ord(Timestamp) {
    ..
}

satisfy Hash(Timestamp) {
    ..
}

satisfy Cmp(Timestamp) {
    lt(a, b) = a.nanos < b.nanos,
    le(a, b) = a.nanos <= b.nanos,
    gt(a, b) = a.nanos > b.nanos,
    ge(a, b) = a.nanos >= b.nanos,
}

--- As its constructor's call: `Timestamp/of_unix_nanos(+1500000000)`.
satisfy Spell(Timestamp) {
    spell(t) = Fmt/render("Timestamp/of_unix_nanos(#)")(t.nanos),
}

--- `secs.nanos`: the Unix second the moment lies in, and the nanoseconds past it in nine digits.
satisfy Show(Timestamp) {
    show(t) =
        let split = Int/DivMod/of(t.nanos, 1000000000);
        Fmt/render("%.%")(split.quotient)(Str/pad_start(Nat/to_str(split.remainder), 9, '0')),
}

--- The moment `n` seconds after the epoch.
pub let of_unix_secs(n: Int) -> Timestamp =
    Timestamp { nanos = n * 1000000000 };

--- The moment `n` nanoseconds after the epoch.
pub let of_unix_nanos(n: Int) -> Timestamp =
    Timestamp { nanos = n };

--- The Unix second the moment lies in, as POSIX counts it: floored, so a moment half a second before the epoch lies in its second `-1`.
pub let to_unix_secs(t: Timestamp) -> Int =
    Int/DivMod/of(t.nanos, 1000000000).quotient;

--- The nanoseconds since the epoch, exactly.
pub let to_unix_nanos(t: Timestamp) -> Int =
    t.nanos;

--- The wall clock: seconds since the Unix epoch, signed, and the nanoseconds past them.
foreign clock_wall() -> {secs: Int, nanos: Nat};

--- The wall clock now.
pub let now() -> Io(Timestamp) =
    let r = clock_wall()!;
    Io/pure(Timestamp { nanos = r.secs * 1000000000 + Nat/to_int(r.nanos) });

--- The moment `d` after `t`.
pub let add(t: Timestamp, d: Duration) -> Timestamp =
    Timestamp { nanos = t.nanos + Duration/to_nanos(d) };

--- The moment `d` before `t`.
pub let sub(t: Timestamp, d: Duration) -> Timestamp =
    Timestamp { nanos = t.nanos - Duration/to_nanos(d) };

--- How long after `b` the moment `a` is: below zero where `a` is the earlier.
pub let diff(a: Timestamp, b: Timestamp) -> Duration =
    Duration/of_nanos(a.nanos - b.nanos);
