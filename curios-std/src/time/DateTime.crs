use /std/{Ord, Hash, Spell};
use /std/ops/{Eql};
use /std/time/{Date, Time};

--- A date and a time of day, at no offset: a civil date-time, as TOML's local date-time and java.time's `LocalDateTime` are. It names no moment by itself; `OffsetDateTime` places one on the timeline.
pub struct DateTime: pub Type {
    date: Date,
    time: Time,
}

satisfy Eql(DateTime) {
    ..
}

satisfy Ord(DateTime) {
    ..
}

satisfy Hash(DateTime) {
    ..
}

satisfy Spell(DateTime) {
    ..
}
