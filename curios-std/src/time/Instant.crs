use /std/{Nat, Int, Io, Ord, Hash};
use /std/ops/{Eql, Cmp};
use /std/time/{Duration};

--- A reading of the monotonic clock: nanoseconds since its origin, which two readings share only within one run.
pub struct Instant: Type {
    nanos: Int,
}

satisfy Eql(Instant) {
    ..
}

satisfy Ord(Instant) {
    ..
}

satisfy Hash(Instant) {
    ..
}

satisfy Cmp(Instant) {
    lt(a, b) = a.nanos < b.nanos,
    le(a, b) = a.nanos <= b.nanos,
    gt(a, b) = a.nanos > b.nanos,
    ge(a, b) = a.nanos >= b.nanos,
}

--- The monotonic clock: seconds since a fixed origin, and the nanoseconds within the second.
foreign clock_mono() -> {secs: Nat, nanos: Nat};

--- The clock now.
pub let now() -> Io(Instant) =
    let r = clock_mono()!;
    Io/pure(Instant { nanos = Nat/to_int(r.secs) * 1000000000 + Nat/to_int(r.nanos) });

--- The instant `d` after `t`.
pub let add(t: Instant, d: Duration) -> Instant =
    Instant { nanos = t.nanos + Duration/to_nanos(d) };

--- The instant `d` before `t`.
pub let sub(t: Instant, d: Duration) -> Instant =
    Instant { nanos = t.nanos - Duration/to_nanos(d) };

--- How long after `b` the reading `a` was taken: below zero where `a` is the earlier.
pub let diff(a: Instant, b: Instant) -> Duration =
    Duration/of_nanos(a.nanos - b.nanos);
