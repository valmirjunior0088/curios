use /std/{Bool, Io};
use /std/time/{Duration};

--- A reading of the monotonic clock.
pub struct Instant: Type {
    elapsed: Duration,
}

--- The monotonic clock: seconds since a fixed origin, and the nanoseconds within the second.
foreign clock_mono: {secs: Nat, nanos: Nat};

--- The clock now.
pub let now() -> Io(Instant) =
    let r = clock_mono!;
    Io/pure(Instant { elapsed = Duration/of(r.secs, r.nanos) });

--- The moment `d` after `t`.
pub let add(t: Instant, d: Duration) -> Instant =
    Instant { elapsed = Duration/add(t.elapsed, d) };

--- `a - b`, and zero when `a` is not after `b`.
pub let diff(a: Instant, b: Instant) -> Duration =
    Duration/sub(a.elapsed, b.elapsed);

--- Whether `a` was read before `b`.
pub let before(a: Instant, b: Instant) -> Bool =
    Duration/before(a.elapsed, b.elapsed);
