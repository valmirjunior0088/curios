use /std/{Nat, Int, Ord, Hash, Spell, Str, Option, Show};
use /std/ops/{Eql};
use /std/time/{Date, Time, DateTime, Offset, Timestamp, iso8601};

--- A date and a time of day at an offset from UTC: RFC 3339's `date-time`, a moment that keeps the offset it was written with.
pub struct OffsetDateTime: pub Type {
    date_time: DateTime,
    offset: Offset,
}

satisfy Eql(OffsetDateTime) {
    ..
}

satisfy Hash(OffsetDateTime) {
    ..
}

satisfy Spell(OffsetDateTime) {
    ..
}

--- By the moment first, as java.time compares, then the local date-time, then the offset, `unknown()` first: two compare equal exactly where they are one value.
satisfy Ord(OffsetDateTime) {
    ord(a, b) =
        Ord/lexicographic([
            Ord/ord(to_timestamp(a), to_timestamp(b)),
            Ord/ord(a.date_time, b.date_time),
            Ord/ord(a.offset, b.offset)]),
}

--- The moment the date-time names at its offset: its seconds counted as POSIX counts a date and a time, less how far ahead of UTC the offset is, so a second of `60` counts as the next minute's first.
pub let to_timestamp(odt: OffsetDateTime) -> Timestamp =
    let date = odt.date_time.date;
    let time = odt.date_time.time;
    let seconds =
        Date/to_days(date) * 86400 + Nat/to_int(time.hour * 3600 + time.minute * 60 + time.second)
            - Offset/ahead(odt.offset);
    Timestamp/of_unix_nanos(seconds * 1000000000 + Nat/to_int(time.nanosecond));

--- The moment `t` as the calendar and the clock name it at `o`. It never answers a second of `60`.
pub let of_timestamp(t: Timestamp, o: Offset) -> OffsetDateTime =
    let local =
        Int/DivMod/of(Timestamp/to_unix_nanos(t) + Offset/ahead(o) * 1000000000, 1000000000);
    let day = Int/DivMod/of(local.quotient, 86400);
    OffsetDateTime {
        date_time =
            DateTime {
                date = Date/of_days(day.quotient),
                time = Time/of_seconds(day.remainder, local.remainder) },
        offset = o };

--- The moment as ISO 8601's extended format writes it, at the offset it holds: `2024-02-29T08:49:37+05:30`.
pub let to_str(odt: OffsetDateTime) -> Str =
    iso8601/write_offset_date_time(odt);

--- The OffsetDateTime ISO 8601's extended format writes as `s`, or `none` for text that writes none.
pub let of_str(s: Str) -> Option(OffsetDateTime) =
    iso8601/whole(iso8601/offset_date_time, s);

satisfy Show(OffsetDateTime) {
    show = to_str,
}
