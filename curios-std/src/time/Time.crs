use /std/{Nat, Bool, Option, Ord, Hash, Spell, Str, Show};
use /std/Bool/{True, Holds};
use /std/ops/{Eql};
use /std/time/{iso8601};

let sound(hour: Nat, minute: Nat, second: Nat, nanosecond: Nat) -> Bool =
    hour <= 23 && minute <= 59 && second <= 60 && nanosecond <= 999999999;

--- That the four spell a time of day. A second of `60` is admitted, since RFC 3339 and TOML write a leap second that way; `OffsetDateTime/to_timestamp` counts it as the next minute's first, as POSIX does.
pub let Valid(hour: Nat, minute: Nat, second: Nat, nanosecond: Nat) -> Prop =
    Holds(sound(hour, minute, second, nanosecond));

--- A time of day, to the nanosecond.
pub struct Time: pub Type {
    hour: Nat,
    minute: Nat,
    second: Nat,
    nanosecond: Nat,
    @ok: Valid(hour, minute, second, nanosecond),
}

satisfy Eql(Time) {
    ..
}

satisfy Ord(Time) {
    ..
}

satisfy Hash(Time) {
    ..
}

satisfy Spell(Time) {
    ..
}

--- The time, under the evidence that the four spell one.
pub let of(
    hour: Nat,
    minute: Nat,
    second: Nat,
    nanosecond: Nat,
    @ok: Valid(hour, minute, second, nanosecond),
) -> Time =
    Time { hour = hour, minute = minute, second = second, nanosecond = nanosecond };

--- The time, decided: `none` where the four spell none.
pub let try_of(hour: Nat, minute: Nat, second: Nat, nanosecond: Nat) -> Option(Time) =
    match Bool/holds(sound(hour, minute, second, nanosecond))
    | some(ok) => Option/some(of(hour, minute, second, nanosecond, @ok))
    | none() => Option/none()
    end;

--- The time of day `seconds` after midnight and `nanosecond` past that second: what a count of seconds reads as on its day. It never names a second of `60`.
pub let of_seconds(
    seconds: Nat,
    nanosecond: Nat,
    @in_day: Holds(seconds < 86400),
    @in_second: Holds(nanosecond < 1000000000),
) -> Time =
    let hour = seconds / 3600;
    let minute = seconds % 3600 / 60;
    let second = seconds % 60;
    Time {
        hour = hour,
        minute = minute,
        second = second,
        nanosecond = nanosecond,
        @ok =
            Bool/and/both(
                hour <= 23 && minute <= 59 && second <= 60,
                nanosecond <= 999999999,
                Bool/and/both(
                    hour <= 23 && minute <= 59,
                    second <= 60,
                    Bool/and/both(hour <= 23, minute <= 59, True/proved(), True/proved()),
                    True/proved()),
                True/proved()) };

--- The time of day as ISO 8601's extended format writes it: `08:49:37`, and the fraction where there is one, trimmed of trailing zeros.
pub let to_str(t: Time) -> Str =
    iso8601/write_time(t);

--- The Time ISO 8601's extended format writes as `s`, or `none` for text that writes none.
pub let of_str(s: Str) -> Option(Time) =
    iso8601/whole(iso8601/time, s);

satisfy Show(Time) {
    show = to_str,
}
