use /std/{Bytes, Nat, Option, Try, Async, Io};

--- The request's method.
pub mod Method;
pub use Method/{let Method};

--- One field line of a message: a name that is a token and a value that holds no control octet, so a message's fields are written as they are held.
pub mod Field;
pub use Field/{let Field};

--- A reply's status: its three-digit code and its reason phrase, and which codes carry content.
pub mod Status;
pub use Status/{let Status};

--- The version an HTTP/1 message states.
pub mod Version;
pub use Version/{let Version};

--- How much of a message a reader takes before it refuses the rest.
pub mod Limits;
pub use Limits/{let Limits};

--- Why a message is not read, and the status a server answers each reason with.
pub mod Refusal;
pub use Refusal/{let Refusal};

--- How a message's body is delimited, read from its start line and its fields.
pub mod Framing;
pub use Framing/{let Framing};

--- The pieces a message is read in — its head, a body of a stated length, a chunked body — each a function of the bytes held that answers the piece, a refusal, or that more is wanted. They hold no stream: a program with a transport of its own reads HTTP through them as the server and the client do.
pub mod read;

--- A head's lines: the start line of each direction and the field lines after it.
mod syntax;

--- Octets as a head's grammar reads them: optional whitespace, lists and decimal numbers.
mod octets;

--- Where a request goes, read from text and refused at a literal that does not read.
pub mod Url;
pub use Url/{let Url};

--- What is sent, as data, and the bytes it goes out as.
pub mod Request;
pub use Request/{let Request, get, post};

--- What comes back, as data, with the readers and makers an exchange ends in.
pub mod Response;
pub use Response/{let Response};

--- How an exchange is performed: the deadline, the redirect limit and how much of a reply is taken.
pub mod Client;
pub use Client/{let Client};

--- A body read off a socket through its reader, and what the peer's close means for it.
mod stream;

--- A server: each connection's request read as its framing delimits it and answered by a handler, a refusal answered with its status, and the connection ended as HTTP asks.
pub mod Server;
pub use Server/{let Server};

--- Why an exchange failed: the wire, a reply that is not read, a reply cut short, the deadline, or a redirect chain past the client's limit.
pub induct Error: pub Type
--- The wire failed.
| net(Io/Error)
--- The reply is not one the client reads: it is malformed, past the client's bounds, or in a coding the client does not implement; which.
| refused(Refusal)
--- The peer closed before its reply was whole (RFC 9112 §8). What arrived comes with it: nothing where the head itself was cut short, and otherwise the head and the content received, the octets of a stated length or the whole chunks of a chunked body.
| incomplete(Option({Response/Head, Bytes}))
--- The deadline passed.
| timeout()
--- The redirect chain ran past the client's limit, after this many.
| redirected(Nat)
end

--- One exchange under the default client.
pub let perform(request: Request) -> Try(Async, Error, Response) =
    Client/perform(Client/default, request);
