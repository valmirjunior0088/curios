-- Waiting in `Io`: what a wait holds of the branch beside it, and what a bracket tells its finalizer.
use /std/{Bool, Cell, Io, Test};
use /std/Io/{Channel};
use /std/time/{Duration};

-- A finalizer that leaves how its body ended where a take finds it.
let told(sender: Channel/Sender(Io/Ended), ended: Io/Ended) -> Io({}) =
    let _ = Channel/try_send(sender, ended)!;
    Io/pure(());

-- Whether the next take is `finished`, where `finished` says so, or `cancelled` otherwise.
let heard(receiver: Channel/Receiver(Io/Ended), finished: Bool) -> Io(Bool) =
    let taken = Channel/try_recv(receiver)!;
    Io/pure(
        match taken
        | item(ended) =>
            match ended | finished() => finished | cancelled() => Bool/not(finished) end
        | _ => false
        end);

test a_yield_at_the_top_of_a_program_goes_on =
    Test/perform(() =>
        let _ = Io/yield()!;
        Io/pure(Test/assert(true)));

test a_sleep_holds_only_its_own_branch =
    Test/perform(() =>
        let n = Io/race([Io/bind(Io/sleep(Duration/of_secs(3600)), (_) => Io/pure(1)), Io/pure(2)])!;
        Io/pure(Test/assert(n == 2)));

test a_wait_on_a_cell_goes_on_once_the_branch_beside_it_fills_it =
    Test/perform(() =>
        let cell = Cell/new()!;
        let (waited, filled) = Io/both(Io/bind(Io/wait_filled([cell]), (_) => Io/pure(true)), Cell/fill(cell, ()))!;
        Io/pure(Test/assert(waited && filled)));

test using_tells_its_finalizer_a_body_ran_to_its_end =
    Test/perform(() =>
        let ends = Channel/new(@Io/Ended, 1)!;
        let n = Io/using((ended) => told(ends.0, ended), Io/pure(3))!;
        let finished = heard(ends.1, true)!;
        Io/pure(Test/assert(n == 3 && finished)));

test using_tells_its_finalizer_a_body_was_dropped_while_it_waited =
    Test/perform(() =>
        let ends = Channel/new(@Io/Ended, 1)!;
        let never = Cell/new()!;
        let body = Io/using((ended) => told(ends.0, ended), Io/bind(Io/wait_filled([never]), (_) => Io/pure(3)));
        let _ = Io/race([body, Io/pure(4)])!;
        let cancelled = heard(ends.1, false)!;
        Io/pure(Test/assert(cancelled)));
