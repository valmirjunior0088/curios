-- The size-indexed view: what composes, what reads back, where its cursor stands, and what a cut keeps of a wide glyph.
use /std/{Nat, Str, Option, Test};
use /std/Tui/{Style, Frame, View};

let shown(@w: Nat, @h: Nat, v: View(w, h)) -> Str =
    Str/join("/", Frame/to_lines(Frame/of_view(v)));

let row(s: Str, w: Nat) -> View(w, 1) =
    View/fit(View/text(Style/plain, s), w, 1);

-- `beside` joins at `w1 + w2` and `above` at `h1 + h2`, both sizes the type's rather than a count made as the program runs.
test beside_and_above_join_at_the_sum_of_their_sizes =
    Test/equal(
        Str/join(" ", [
            shown(View/beside(View/blank(2, 2), View/blank(1, 2))),
            shown(View/above(View/blank(2, 1), View/blank(2, 2)))]),
        "   /      /  /  ");

-- The one coercion, in both directions at once: a view wider and shorter than the target is cropped on the right and padded below.
test fit_crops_what_overflows_and_pads_what_falls_short =
    let wide = View/above(row("abcdef", 6), row("ghijkl", 6));
    Test/equal(
        Str/join(" ", [shown(View/fit(wide, 3, 3)), shown(View/fit(wide, 8, 1))]),
        "abc/ghi/    abcdef  ");

-- A text view is as wide as its line: a double-width glyph takes its column and the one after, and reads back as itself.
test a_text_is_as_wide_as_its_line =
    Test/equal(shown(View/text(Style/plain, "日a")), "日a");

-- A cut through a wide glyph leaves no half of it: cropped at the column after its first, it shows a blank there.
test a_cut_through_a_wide_glyph_shows_a_blank =
    Test/equal(Str/join(" ", [shown(row("a日", 2)), shown(View/crop(row("日b", 3), 1, 0))]), "a   b");

-- `over` clips rather than demanding a proof that the patch fits: where a popup sits is known only as the program runs.
test over_clips_a_patch_at_the_edge =
    let base = View/above(View/above(row("....", 4), row("....", 4)), row("....", 4));
    let patch = View/above(row("XX", 2), row("XX", 2));
    Test/equal(
        Str/join(" ", [
            shown(View/over(base, patch, 1, 1)),
            shown(View/over(base, patch, 3, 2)),
            shown(View/over(base, patch, 9, 9))]),
        "..../.XX./.XX. ..../..../...X ..../..../....");

-- A tile is read under the bounds the frame's own type decides, which a literal discharges.
test a_tile_is_read_under_the_frame_s_own_bounds =
    let f = Frame/of_view(View/above(row("ab", 2), row("cd", 2)));
    Test/assert(Frame/get(f, 1, 1) == Frame/get(Frame/of_view(row("d", 1)), 0, 0));

-- A cursor asked for inside a view stands where the view is placed: shifted past what stands beside it and above it, carried over a patch's offset, and lost where a fit crops it away.
test a_cursor_stands_where_its_view_is_placed =
    let caret = View/with_cursor(View/blank(3, 1), View/Point(3, 1) { x = 1, y = 0 });
    let column = (p: View/Point(5, 2)) => p.x;
    let line = (p: View/Point(5, 2)) => p.y;
    let placed = View/above(View/blank(5, 1), View/beside(View/blank(2, 1), caret));
    Test/all([
        Test/equal(Option/map(View/cursor(placed), column), Option/some(3)),
        Test/equal(Option/map(View/cursor(placed), line), Option/some(1)),
        Test/equal(
            Option/map(View/cursor(View/over(View/blank(5, 2), caret, 2, 1)), column),
            Option/some(3)),
        Test/equal(
            Option/map(View/cursor(View/fit(placed, 2, 2)), (p: View/Point(2, 2)) => p.x),
            Option/none())]);
