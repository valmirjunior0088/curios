-- Parsing through `Parse`: a text parser reads characters and pieces of its input by position, a refusal says the byte offset it stopped at, and of two refusals open to an alternative the one that reached further is reported.
use /std/{Parse, Str, Char, List, Result, Test};

let shown(@A: Type, r: Result(Parse/Error, A), f: (A) -> Str) -> Str =
    match r | success(a) => f(a) | failure(e) => Parse/Error/to_str(e) end;

let pair: Parse(Str, {Str, Str}) =
    let word = Parse/text/take_while((c) => Char/to_nat(c) != 32)!;
    let _ = Parse/text/expect(' ')!;
    let _ = Parse/text/literal("wö")!;
    let rest = Parse/text/rest!;
    let _ = Parse/eof()!;
    Parse/pure((word, rest));

-- A text parser answers characters and the pieces of its input it read: a run of non-spaces, a separator, a literal of multi-byte characters and what follows it.
test a_text_parser_reads_characters_and_pieces =
    Test/equal(
        shown(Parse/run(pair, "héllo wörld"), ((w, r)) => Str/flatten([w, "|", r])),
        "héllo|rld");

-- A text refusal is where it stopped as a byte offset into the input: the literal `wö` is wanted after `héllo `, whose `é` is two bytes.
test a_text_refusal_is_at_a_byte_offset =
    Test/equal(
        shown(Parse/run(pair, "héllo world"), ((w, r)) => Str/flatten([w, "|", r])),
        "expected \"wö\" at byte 7");

let two: Parse(Str, {Char, Char}) =
    let a = Parse/text/char!;
    let b = Parse/text/char!;
    Parse/pure((a, b));

let peeked: Parse(Str, Str) =
    let first = Parse/text/peek!;
    let taken = Parse/text/char!;
    Parse/pure(
        Str/concat(
            match first | some(c) => Str/of_char(c) | none() => "none" end,
            Str/of_char(taken)));

-- The end of the input refuses a character, and `peek` sees one without consuming it.
test a_character_is_refused_at_the_end =
    Test/all([
        Test/equal(
            shown(Parse/run(two, "€"), ((_, b)) => Str/of_char(b)),
            "unexpected end of input at byte 3"),
        Test/equal(shown(Parse/run(peeked, "€"), (s) => s), "€€")]);

-- Of two alternatives that both decline, the refusal reported is the one that reached further into the input, in either order: `ab` then `cd` stops at byte 2, where `x` stopped at the start.
test or_reports_the_refusal_that_reached_further =
    let far: Parse(Str, {}) = Parse/bind(Parse/text/literal("ab"), (_) => Parse/text/literal("cd"));
    let near: Parse(Str, {}) = Parse/text/literal("x");
    Test/all([
        Test/equal(
            shown(Parse/run(Parse/or(far, near), "abx"), (_) => "ok"),
            "expected \"cd\" at byte 2"),
        Test/equal(
            shown(Parse/run(Parse/or(near, far), "abx"), (_) => "ok"),
            "expected \"cd\" at byte 2")]);

-- A bytes parser walks its literal byte by byte, and declines where it started when the input is not it.
test a_bytes_literal_is_read_byte_by_byte =
    Test/all([
        Test/equal(
            shown(Parse/run(Parse/bytes/literal("ab"), x['a', 'b', 'c']), (_) => "ok"),
            "ok"),
        Test/equal(
            shown(Parse/run(Parse/bytes/literal("ab"), x['a']), (_) => "ok"),
            "expected \"ab\" at byte 0")]);

let digit: Parse(Str, Char) =
    Parse/label(Parse/text/char_if(Char/is_digit), "expected a digit");

let comma: Parse(Str, {}) =
    Parse/text/literal(",");

let whole(list: Parse(Str, List(Char))) -> Parse(Str, Str) =
    let items = list!;
    let _ = Parse/eof()!;
    Parse/pure(Str/flatten(List/map(items, Str/of_char)));

let read(list: Parse(Str, List(Char)), input: Str) -> Str =
    shown(Parse/run(whole(list), input), (s) => Str/flatten(["[", s, "]"]));

-- A separator owes the element after it, so a dangling one is refused at the element it lacks rather than handed back for whatever follows to trip on. A `_trailing` list lets a last separator close it, and a `sep_by1` owes its first element too.
test a_separator_owes_the_element_after_it =
    Test/equal(
        Str/join("|", [
            read(Parse/sep_by0(digit, comma), "1,2"),
            read(Parse/sep_by0(digit, comma), ""),
            read(Parse/sep_by0(digit, comma), "1,2,"),
            read(Parse/sep_by0_trailing(digit, comma), "1,2,"),
            read(Parse/sep_by0_trailing(digit, comma), ""),
            read(Parse/sep_by1(digit, comma), ""),
            read(Parse/sep_by1_trailing(digit, comma), "1,"),
            read(Parse/sep_by1_trailing(digit, comma), ",")]),
        "[12]|[]|expected a digit at byte 4|[12]|[]|expected a digit at byte 0|[1]|expected a digit at byte 0");

-- `many1` owes its first value where `many0` answers an empty list.
test many1_owes_its_first_value =
    Test/equal(
        Str/join("|", [
            read(Parse/many0(digit), "12"),
            read(Parse/many0(digit), ""),
            read(Parse/many1(digit), "12"),
            read(Parse/many1(digit), "")]),
        "[12]|[]|[12]|expected a digit at byte 0");

-- Of two alternatives that decline at one offset, the first's refusal is reported: it is the reading the choice led with.
test or_reports_the_first_refusal_on_a_tie =
    Test/equal(
        shown(
            Parse/run(Parse/or(Parse/text/literal("a"), Parse/text/literal("b")), "x"),
            (_) => "ok"),
        "expected \"a\" at byte 0");
