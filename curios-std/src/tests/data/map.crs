-- `Map`, the crit-bit trie over `Key`-encoded bytes, and `Set` over it: lookups, the canonical shape, and the rewriting functions.
use /std/{Str, Nat, Int, Bool, Byte, Bytes, List, Option, Eq, Hash, Ord, Ordering, Map, Set, Test};
use /std/Bool/{True, False, Holds};

test a_key_an_empty_map_lacks_is_tried_as_none =
    let m: Map(Str, Str) = Map/empty();
    Test/equal(Map/try_get(m, "missing"), Option/none());

-- A read under a guard on `has` takes the evidence the guard gives and answers the value, with no `Option` to open.
test get_reads_the_key_its_guard_found =
    let m: Map(Str, Nat) = Map/of_list([("one", 1), ("two", 2)]);
    let at(k: Str) -> Nat = match Map/has(m, k) | true => Map/get(m, k) | false => 0 end;
    Test/equal([at("one"), at("two"), at("three")], [1, 2, 0]);

-- "", "a", "ab", "abc" and "b" force the trie to branch on the presence-marker bits: a key that is a proper prefix of another differs from it only at a marker position, the case a plain per-byte comparison would miss.
test roundtrips_prefix_related_keys =
    let m: Map(Str, Str) =
        Map/of_list([("", "nil"), ("ab", "AB"), ("a", "A"), ("abc", "ABC"), ("b", "B")]);
    let at(k: Str) -> Str = Option/unwrap_or(Map/try_get(m, k), "?");
    Test/equal(
        Str/join(",", [at(""), at("a"), at("ab"), at("abc"), at("b"), at("c")]),
        "nil,A,AB,ABC,B,?");

-- An integer below zero encodes as a complement, so a negative key, its negation and zero are three entries, and a key never inserted is absent.
test integer_keys_keep_their_signs_apart =
    let m: Map(Int, Str) = Map/of_list([(-2, "minus two"), (+0, "zero"), (+2, "two")]);
    let at(k: Int) -> Str = Option/unwrap_or(Map/try_get(m, k), "?");
    Test/equal(Str/join(",", [at(-2), at(+0), at(+2), at(-1)]), "minus two,zero,two,?");

-- A digest's eight bytes at the empty run, whose three lanes each stand at their seed, at a short text and at eight bytes of ones. Pinned, and not stable: a digest may change between compiler versions, and this is where a change shows.
test a_digest_is_eight_bytes_of_its_three_lanes =
    Test/equal(
        [
            Hash/digest(x[]),
            Hash/digest(Str/to_bytes("curios")),
            Hash/digest(x[0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF])],
        [
            x[0x01, 0x00, 0x00, 0x01, 0x00, 0x00, 0x01, 0x00],
            x[0x92, 0xFE, 0x2C, 0x0A, 0xB2, 0x2F, 0x89, 0x23],
            x[0x2E, 0x53, 0x52, 0x90, 0x8B, 0x42, 0xD9, 0x43]]);

-- A natural's first byte holds how many bytes follow it and its top four bits, so a number below sixteen is one byte, one below 4 096 two, and one below `2^20` three.
test a_natural_encodes_its_length_and_its_top_in_its_first_byte =
    Test/equal(
        [
            Hash/hash(0),
            Hash/hash(15),
            Hash/hash(16),
            Hash/hash(255),
            Hash/hash(4095),
            Hash/hash(4096),
            Hash/hash(1048575),
            Hash/hash(1048576)],
        [
            x[0x80],
            x[0x8F],
            x[0x90, 0x10],
            x[0x90, 0xFF],
            x[0x9F, 0xFF],
            x[0xA0, 0x10, 0x00],
            x[0xAF, 0xFF, 0xFF],
            x[0xB0, 0x10, 0x00, 0x00]]);

-- A map of naturals enumerates them in their order, across every boundary of the first byte: the top four bits, each rank, and the run that writes a rank past six.
test natural_keys_enumerate_in_number_order =
    let edge(rank: Nat) -> Nat = 16 * Nat/pow(256, rank);
    let keys: List(Nat) =
        [
            256, 1, 2, 65536, 255, 257, 0, 513, 15, 16, 4095, 4096, 1048575, 1048576,
            edge(6) - 1,
            edge(6),
            edge(13),
            edge(14)];
    Test/equal(Set/to_list(Set/of_list(keys)), List/sort(keys));

-- A smaller natural's encoding is before a larger one's, by the law beside the code.
let _a_smaller_natural_encodes_before_a_larger(
    a: Nat,
    b: Nat,
    under: Holds(a < b),
) -> Eq()(Bytes/ord(Hash/hash(a), Hash/hash(b)), Ordering/lt()) =
    Bytes/ord/below/lt(Hash/hash(a), Hash/hash(b), Hash/nat/of_lt(a, b, under));

-- An integer at or above zero encodes as its natural, and one below as the complement of the natural `-1 - i`'s, so no byte is spent on the sign.
test an_integer_encodes_as_its_natural_or_as_a_complement =
    Test/equal(
        [
            Hash/hash(+0),
            Hash/hash(+15),
            Hash/hash(+1048576),
            Hash/hash(Nat/to_int(4096)),
            Hash/hash(-1),
            Hash/hash(-16),
            Hash/hash(-17),
            Hash/hash(-1048576)],
        [
            x[0x80],
            x[0x8F],
            x[0xB0, 0x10, 0x00, 0x00],
            Hash/hash(4096),
            x[0x7F],
            x[0x70],
            x[0x6F, 0xEF],
            x[0x50, 0x00, 0x00]]);

-- A map of integers enumerates them in their order: every boundary of a natural's first byte, and the `-1 - n` that mirrors each below zero.
test integer_keys_enumerate_in_number_order =
    let edge(rank: Nat) -> Nat = 16 * Nat/pow(256, rank);
    let naturals: List(Nat) =
        [
            256, 1, 2, 65536, 255, 257, 0, 513, 15, 16, 4095, 4096, 1048575, 1048576,
            edge(6) - 1,
            edge(6),
            edge(13),
            edge(14)];
    let keys: List(Int) = List/concat_map(naturals, (n) => [Nat/to_int(n), -1 - Nat/to_int(n)]);
    Test/equal(Set/to_list(Set/of_list(keys)), List/sort(keys));

-- A smaller integer's encoding is before a larger one's, by the law beside the code.
let _a_smaller_integer_encodes_before_a_larger(
    a: Int,
    b: Int,
    under: Holds(a < b),
) -> Eq()(Bytes/ord(Hash/hash(a), Hash/hash(b)), Ordering/lt()) =
    Bytes/ord/below/lt(Hash/hash(a), Hash/hash(b), Hash/int/of_lt(a, b, under));

-- An insert stands in a type, everything it reaches being known to terminate: what three inserts leave is decided by reduction, in the order of the numbers.
let _an_insert_stands_in_a_type: Eq()(
    Map/keys(Map/insert(Map/insert(Map/insert(Map/empty(), 256, "a"), 1, "b"), 0, "c")),
    [0, 1, 256]) =
    Eq/refl();

-- The keys of a map are in their type's own order, each before the one after it, under the map's key alone: the theorem beside `Map/keys`, read at a map of any key type.
let _a_maps_keys_are_in_their_order(
    @K: Type,
    use Map/Key(K),
    @V: Type,
    m: Map(K, V),
) -> Holds(List/ordered(Map/keys(m), Ord/lt((a: K, b: K) => Ord/ord(a, b)))) =
    Map/keys/ordered(m);

-- The elements of a set are in their type's own order at every pair.
let _a_sets_elements_are_in_their_order(
    @K: Type,
    use Map/Key(K),
    s: Set(K),
) -> List/Pairwise(Ord/lt((a: K, b: K) => Ord/ord(a, b)))(Set/to_list(s)) =
    Set/to_list/pairwise(s);

-- A map is a function of its entries: two orders of insertion build one map, decided by reduction.
let _two_insertion_orders_build_one_map: Eq()(
    Map/insert(Map/insert(Map/empty(), 1, "a"), 256, "b"),
    Map/insert(Map/insert(Map/empty(), 256, "b"), 1, "a")) =
    Eq/refl();

-- Removing a key inserted where the map had none gives the map back, for every map: the two agree at every key, which `Map/try_get/injective` takes to the maps.
let _a_key_removed_after_its_insertion_leaves_the_map(
    @K: Type,
    use Map/Key(K),
    @V: Type,
    m: Map(K, V),
    k: K,
    v: V,
    absent: Eq()(Map/try_get(m, k), Option/none()),
) -> Eq()(Map/remove(Map/insert(m, k, v), k), m) =
    Map/try_get/injective(
        Map/remove(Map/insert(m, k, v), k),
        m,
        (key) =>
            match Hash/hash(k) == Hash/hash(key)
            | true =>
                Eq/subst(
                    (y: K) =>
                        Eq()(Map/try_get(Map/remove(Map/insert(m, k, v), k), y), Map/try_get(m, y)),
                    Map/Key/same(k, key, True/qed()),
                    Eq/trans(Map/try_get/of_remove(Map/insert(m, k, v), k), Eq/sym(absent)))
            | false =>
                let apart = Map/Key/apart(k, key, True/qed());
                Eq/trans(
                    Map/try_get/of_remove_other(Map/insert(m, k, v), k, key, apart),
                    Map/try_get/of_insert_other(m, k, v, key, apart))
            end);

-- Inserting an element twice is inserting it once, for every set: the two have the same elements, which `Set/has/extensional` takes to the sets.
let _an_element_inserted_twice_is_inserted_once(
    @K: Type,
    use Map/Key(K),
    s: Set(K),
    k: K,
) -> Eq()(Set/insert(Set/insert(s, k), k), Set/insert(s, k)) =
    Set/has/extensional(
        Set/insert(Set/insert(s, k), k),
        Set/insert(s, k),
        (key) =>
            match Hash/hash(k) == Hash/hash(key)
            | true =>
                Eq/subst(
                    (y: K) =>
                        Eq()(
                            Set/has(Set/insert(Set/insert(s, k), k), y),
                            Set/has(Set/insert(s, k), y)),
                    Map/Key/same(k, key, True/qed()),
                    Eq/trans(
                        Set/has/of_insert(Set/insert(s, k), k),
                        Eq/sym(Set/has/of_insert(s, k))))
            | false =>
                Set/has/of_insert_other(Set/insert(s, k), k, key, Map/Key/apart(k, key, True/qed()))
            end);

-- Inserts at two keys commute, for every map: at either key each side has that key's value, and at any other key both have the map's.
let _inserts_at_two_keys_commute(
    @K: Type,
    use Map/Key(K),
    @V: Type,
    m: Map(K, V),
    a: K,
    x: V,
    b: K,
    y: V,
    apart: (Eq()(b, a)) -> False,
) -> Eq()(Map/insert(Map/insert(m, a, x), b, y), Map/insert(Map/insert(m, b, y), a, x)) =
    let left = Map/insert(Map/insert(m, a, x), b, y);
    let right = Map/insert(Map/insert(m, b, y), a, x);
    let aside: (Eq()(a, b)) -> False = (e) => apart(Eq/sym(e));
    Map/try_get/injective(left, right, (key) =>
        match Hash/hash(b) == Hash/hash(key)
        | true =>
            Eq/subst(
                (z: K) => Eq()(Map/try_get(left, z), Map/try_get(right, z)),
                Map/Key/same(b, key, True/qed()),
                Eq/trans(
                    Map/try_get/of_insert(Map/insert(m, a, x), b, y),
                    Eq/sym(
                        Eq/trans(
                            Map/try_get/of_insert_other(Map/insert(m, b, y), a, x, b, apart),
                            Map/try_get/of_insert(m, b, y)))))
        | false =>
            let not_b = Map/Key/apart(b, key, True/qed());
            match Hash/hash(a) == Hash/hash(key)
            | true =>
                Eq/subst(
                    (z: K) => Eq()(Map/try_get(left, z), Map/try_get(right, z)),
                    Map/Key/same(a, key, True/qed()),
                    Eq/trans(
                        Eq/trans(
                            Map/try_get/of_insert_other(Map/insert(m, a, x), b, y, a, aside),
                            Map/try_get/of_insert(m, a, x)),
                        Eq/sym(Map/try_get/of_insert(Map/insert(m, b, y), a, x))))
            | false =>
                let not_a = Map/Key/apart(a, key, True/qed());
                Eq/trans(
                    Eq/trans(
                        Map/try_get/of_insert_other(Map/insert(m, a, x), b, y, key, not_b),
                        Map/try_get/of_insert_other(m, a, x, key, not_a)),
                    Eq/sym(
                        Eq/trans(
                            Map/try_get/of_insert_other(Map/insert(m, b, y), a, x, key, not_a),
                            Map/try_get/of_insert_other(m, b, y, key, not_b))))
            end
        end);

-- The keys of the least and of the greatest entry of the map of `keys`.
let ends(@K: Type, use Map/Key(K), keys: List(K)) -> List(Option(K)) =
    let m: Map(K, Nat) = Map/of_list(List/map(keys, (k: K) => (k, 0)));
    [Option/map(Map/least(m), ((k, _)) => k), Option/map(Map/greatest(m), ((k, _)) => k)];

-- The first and the last of `keys` sorted.
let sorted_ends(@K: Type, use Ord(K), keys: List(K)) -> List(Option(K)) =
    let sorted = List/sort(keys);
    [List/try_get(sorted, 0), List/last(sorted)];

-- The least and the greatest key of a map are the first and the last of its keys sorted, at every key type, and the empty map has neither.
test the_least_and_the_greatest_key_are_the_ends_of_the_sorted_keys =
    let naturals: List(Nat) = [256, 1, 65536, 0, 255, 4096];
    let integers: List(Int) = [+2, -3, +0, -1, -65536, +4096];
    let texts: List(Str) = ["b", "", "ab", "a"];
    let runs: List(Bytes) = [x[0x01, 0x00], x[], x[0xFF], x[0x01]];
    let bytes: List(Byte) = [0x7F, 0x00, 0xFF, 0x80];
    let truths: List(Bool) = [true, false];
    let none: List(Nat) = [];
    Test/all([
        Test/equal(ends(naturals), sorted_ends(naturals)),
        Test/equal(ends(integers), sorted_ends(integers)),
        Test/equal(ends(texts), sorted_ends(texts)),
        Test/equal(ends(runs), sorted_ends(runs)),
        Test/equal(ends(bytes), sorted_ends(bytes)),
        Test/equal(ends(truths), sorted_ends(truths)),
        Test/equal(ends(none), [Option/none(), Option/none()])]);

-- No key of a map is below its least or above its greatest, and each of the two is a key of the map: the theorems beside the two walks, read under the map's key alone.
let _no_key_is_past_a_maps_ends(
    @K: Type,
    use Map/Key(K),
    @V: Type,
    m: Map(K, V),
    x: K,
    i: List/Member()(x, Map/keys(m)),
) -> {Map/least/Below(Map/least(m), x), Map/greatest/Above(Map/greatest(m), x)} =
    (Map/least/below(m, x, i), Map/greatest/above(m, x, i));

-- Setting an existing key goes down the `replace` path: same size, new value, no duplicate leaf.
test insert_replaces_without_growing =
    let m: Map(Str, Nat) = Map/insert(Map/insert(Map/empty(), "k", 1), "k", 2);
    Test/equal(m, Map/of_list([("k", 2)]));

-- Deleting a present key collapses its parent fork — the sibling is spliced up — deleting an absent key is the identity, and deleting the last key returns to the empty map.
test remove_collapses_and_is_the_identity_on_an_absent_key =
    let m: Map(Str, Nat) = Map/of_list([("a", 1), ("b", 2), ("c", 3)]);
    let d: Map(Str, Nat) = Map/remove(m, "b");
    Test/all([
        Test/equal(d, Map/of_list([("a", 1), ("c", 3)])),
        Test/equal(Map/remove(d, "b"), d),
        Test/equal(Map/remove(Map/remove(d, "a"), "c"), Map/empty())]);

-- Iteration order is a property of the canonical shape, not of insertion order: the zero side of a fork holds the smaller keys, and the marker bits sort a prefix before its extensions.
test iterates_in_lexicographic_key_order =
    let m: Map(Str, Nat) = Map/of_list([("b", 0), ("abc", 0), ("", 0), ("a", 0), ("ab", 0)]);
    Test/equal(Str/join(",", Map/keys(m)), ",a,ab,abc,b");

-- Canonicity, observed through the API: the same entry set reached by two insertion histories — one of them through a later-deleted key — is the same map.
test entries_agree_across_insertion_orders =
    let m1: Map(Str, Nat) = Map/of_list([("x", 1), ("y", 2), ("z", 3)]);
    let m2: Map(Str, Nat) = Map/remove(Map/of_list([("z", 3), ("w", 0), ("y", 2), ("x", 1)]), "w");
    Test/equal(m1, m2);

-- 300 sequential keys rendered as decimal share long prefixes — "1" against "10" against "100" — exercising deep shared paths and the presence markers that separate a key from its own extensions; deleting the even half exercises collapse at scale. Keys are `Str` because the shared prefixes are what this exercises, and a decimal rendering is how you get them.
test holds_many_keys_with_shared_prefixes =
    let build(i: Nat, acc: Map(Str, Str)) -> Map(Str, Str) =
        match i | 0 => acc | _ => build(i - 1, Map/insert(acc, Nat/to_str(i), Nat/to_str(i))) end;
    let drop_even(i: Nat, acc: Map(Str, Str)) -> Map(Str, Str) =
        match i
        | 0 => acc
        | _ =>
            match i % 2 == 0
            | true => drop_even(i - 1, Map/remove(acc, Nat/to_str(i)))
            | false => drop_even(i - 1, acc)
            end
        end;
    let m: Map(Str, Str) = build(300, Map/empty());
    let d: Map(Str, Str) = drop_even(300, m);
    let at(n: Nat) -> Str = Option/unwrap_or(Map/try_get(d, Nat/to_str(n)), "?");
    Test/equal(
        Str/join(",", [
            Nat/to_str(Map/len(m)),
            Nat/to_str(Map/len(d)),
            at(2),
            at(3),
            at(255),
            at(256),
            at(257)]),
        "300,150,?,3,255,?,257");

-- `update` is the one rewriting entry point: the function sees the current value or `none`, and answers the value to keep or `none` to remove. `map` and `filter` walk the entries, `union` is right-biased, and `get_or` reads with a default.
test update_map_filter_union_and_get_or_rewrite_entries =
    let m: Map(Str, Nat) = Map/of_list([("a", 1), ("b", 2), ("c", 3)]);
    Test/all([
        Test/equal(
            Map/update(m, "a", (o: Option(Nat)) => Option/map(o, (n: Nat) => n + 10)),
            Map/of_list([("a", 11), ("b", 2), ("c", 3)])),
        Test/equal(
            Map/update(m, "b", (_o: Option(Nat)) => Option/none()),
            Map/of_list([("a", 1), ("c", 3)])),
        Test/equal(
            Map/update(m, "d", (_o: Option(Nat)) => Option/some(4)),
            Map/of_list([("a", 1), ("b", 2), ("c", 3), ("d", 4)])),
        Test/equal(Map/map(m, (n: Nat) => n * 2), Map/of_list([("a", 2), ("b", 4), ("c", 6)])),
        Test/equal(
            Map/filter(m, (_k: Str, n: Nat) => Bool/not(Nat/is_even(n))),
            Map/of_list([("a", 1), ("c", 3)])),
        Test/equal(
            Map/union(Map/of_list([("a", 1), ("x", 9)]), Map/of_list([("a", 100), ("y", 8)])),
            Map/of_list([("a", 100), ("x", 9), ("y", 8)])),
        Test/equal(Map/get_or(m, "z", 0), 0),
        Test/equal(Map/get_or(m, "c", 0), 3)]);

-- A `Set(K)` is a structure over `Map(K, {})`, whose leaves hold the keys themselves, so `to_list` hands the elements back typed — `List(Str)` here, joined without a decoder.
test a_set_stores_its_keys_typed_and_unions =
    let s = Set/of_list(["b", "a", "c", "a"]);
    let u = Set/union(s, Set/insert(Set/of_list(["d"]), "a"));
    Test/all([
        Test/equal(Set/len(s), 3),
        Test/assert(Set/has(s, "a")),
        Test/assert(Bool/not(Set/has(s, "z"))),
        Test/equal(Set/to_list(Set/remove(s, "b")), ["a", "c"]),
        Test/equal(u, Set/of_list(["a", "b", "c", "d"])),
        Test/equal(
            Set/fold(Set/of_list(["x", "yy", "zzz"]), 0, (x: Str, acc: Nat) => Str/len(x) + acc),
            6)]);
