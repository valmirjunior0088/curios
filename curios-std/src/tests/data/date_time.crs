-- The calendar under its proofs: a day count and a date are one, leap days fall where the Gregorian calendar puts them, a date outside it is no date, and a moment crosses to its date and time at an offset and back.
use /std/{Nat, Int, List, Option, Test};
use /std/time/{Timestamp, Duration, Date, Time, DateTime, Month, Weekday, Offset, OffsetDateTime};

-- The date a day count names, as its fields.
let fields(n: Int) -> {Int, Nat, Nat} =
    let d = Date/of_days(n);
    (d.year, Month/to_nat(d.month), d.day);

-- The epoch is the first of January 1970, a Thursday, and a day count reaches either side of it.
test the_epoch_is_a_thursday_and_the_count_reaches_either_side =
    Test/all([
        Test/equal(fields(+0), (+1970, 1, 1)),
        Test/equal(Date/weekday(Date/of_days(+0)), Weekday/thursday()),
        Test/equal(fields(-1), (+1969, 12, 31)),
        Test/equal(fields(-719528), (+0, 1, 1)),
        Test/equal(fields(-719529), (-1, 12, 31)),
        Test/equal(fields(+2932896), (+9999, 12, 31)),
        Test/equal(fields(+2932897), (+10000, 1, 1))]);

-- A leap day: four divides its year, and a hundred does not unless four hundred does; a century it does not has none, so the day after its twenty-eighth of February is the first of March.
test a_leap_day_falls_where_the_calendar_puts_it =
    Test/all([
        Test/equal(
            Option/map(Date/try_of(+2024, Month/february(), 29), Date/to_days),
            Option/some(+19782)),
        Test/equal(
            Option/map(Date/try_of(+2000, Month/february(), 29), Date/weekday),
            Option/some(Weekday/tuesday())),
        Test/equal(Date/try_of(+1900, Month/february(), 29), Option/none()),
        Test/equal(Date/try_of(+2023, Month/february(), 29), Option/none()),
        Test/equal(fields(+47540), (+2100, 2, 28)),
        Test/equal(fields(+47541), (+2100, 3, 1)),
        Test/equal(Date/days_in_month(+2400, Month/february()), 29),
        Test/equal(Date/days_in_year(-4), 366)]);

-- Each month's length, in a common year and a leap one.
test every_month_has_its_length =
    Test/equal(
        List/map(Month/all, (m: Month) =>
            Date/days_in_month(+2023, m) + Date/days_in_month(+2024, m)),
        [62, 57, 62, 60, 62, 60, 62, 62, 60, 62, 60, 62]);

-- Days added and counted between: across a month, a year and the epoch, below zero where the second date is the earlier.
test days_are_added_and_counted_between_dates =
    Test/all([
        Test/equal(Date/to_days(Date/add_days(Date/of_days(+19781), +1)), +19782),
        Test/equal(Date/days_between(Date/of_days(+0), Date/of_days(-365)), -365),
        Test/equal(Date/days_between(Date/of_days(-1), Date/of_days(+59)), +60)]);

-- A moment crosses to its date and time at an offset and back, a leap second counted as the next minute's first, and two offsets of one moment compare by the moment first.
test a_moment_crosses_to_its_calendar_at_an_offset_and_back =
    let t = Timestamp/of_unix_nanos(+784111777000000500);
    let india = OffsetDateTime/of_timestamp(t, Offset/known(+19800));
    let utc = OffsetDateTime/of_timestamp(t, Offset/utc);
    Test/all([
        Test/equal(OffsetDateTime/to_timestamp(india), t),
        Test/equal(OffsetDateTime/to_timestamp(utc), t),
        Test/equal(
            (utc.date_time.time.hour, utc.date_time.time.minute, utc.date_time.time.second),
            (8, 49, 37)),
        Test/equal((india.date_time.time.hour, india.date_time.time.minute), (14, 19)),
        Test/equal(utc == OffsetDateTime/of_timestamp(t, Offset/unknown()), false),
        Test/equal(
            OffsetDateTime/to_timestamp(
                OffsetDateTime {
                    date_time =
                        DateTime {
                            date = Date/of_days(+17166),
                            time = Time { hour = 23, minute = 59, second = 60, nanosecond = 0 } },
                    offset = Offset/unknown() }),
            Timestamp/of_unix_secs(+1483228800)),
        Test/equal(Timestamp/of_unix_nanos(-1) < Timestamp/of_unix_nanos(+0), true),
        Test/equal(
            fields(
                Date/to_days(
                    OffsetDateTime/of_timestamp(
                        Timestamp/of_unix_nanos(-1),
                        Offset/utc).date_time.date)),
            (+1969, 12, 31))]);

-- Every form reads back as it was written: a year past four digits with its sign, the leap second, a fraction trimmed, an offset with seconds past ISO 8601, `-00:00` read as the `Z` RFC 9557 writes it, a moment at any offset as its UTC instant, and durations of both signs.
test every_time_reads_back_as_it_was_written =
    Test/all([
        Test/equal(Option/map(Date/of_str("2024-02-29"), Date/to_str), Option/some("2024-02-29")),
        Test/equal(
            Option/map(Date/of_str("+10000-01-01"), Date/to_str),
            Option/some("+10000-01-01")),
        Test/equal(Option/map(Date/of_str("-0001-12-31"), Date/to_str), Option/some("-0001-12-31")),
        Test/equal(Option/map(Time/of_str("23:59:60.50"), Time/to_str), Option/some("23:59:60.5")),
        Test/equal(
            Option/map(
                OffsetDateTime/of_str("1979-05-27T00:32:00.999999-07:00"),
                OffsetDateTime/to_str),
            Option/some("1979-05-27T00:32:00.999999-07:00")),
        Test/equal(
            Option/map(OffsetDateTime/of_str("1979-05-27T07:32:00-00:00"), OffsetDateTime/to_str),
            Option/some("1979-05-27T07:32:00Z")),
        Test/equal(
            Option/map(
                OffsetDateTime/of_str("1979-05-27T07:32:00+05:30:15"),
                OffsetDateTime/to_str),
            Option/some("1979-05-27T07:32:00+05:30:15")),
        Test/equal(
            Option/map(Timestamp/of_str("1969-12-31T23:00:00-01:00"), Timestamp/to_str),
            Option/some("1970-01-01T00:00:00Z")),
        Test/equal(Option/map(Duration/of_str("PT90M"), Duration/to_str), Option/some("PT1H30M")),
        Test/equal(Option/map(Duration/of_str("-PT1.5S"), Duration/to_str), Option/some("-PT1.5S")),
        Test/equal(Duration/to_str(Duration/zero), "PT0S"),
        Test/equal(Date/of_str("2023-02-29"), Option/none()),
        Test/equal(Date/of_str("+999-01-01"), Option/none()),
        Test/equal(Duration/of_str("PT"), Option/none())]);
