-- Packed atom splices, the folds that sum a sequence, and a packed value shown.
use /std/{Str, Nat, Byte, Bytes, Bool, Bits, Eq, List, Option, Ordering, Show, Test};

-- `..` splices one generator into a packed literal, between literal runs and adjacent to another atom. `i` and `bang` are bound rather than written, so the run is genuinely spliced rather than folded at parse time.
test atom_splice_builds_the_written_sequence =
    let i: Byte = 0x69;
    let bang: Byte = 0x21;
    Test/equal(x[0x48, i, bang], Str/to_bytes("Hi!"));

-- An atom leading a spread lowers to the cons spelling the packed-match refinement builds — the singleton `append(x[], h)` concatenated with the tail — so a literal written that way *is* the cons spine rather than merely equal to one. Stated over symbolic operands through `len` and `try_get`, the two observations that reduce across that spine, so nothing here is reached by folding literals. These are proofs rather than tests: each is a claim about every `h` and `t`, so it is stated in a type and discharged by the kernel on every build, and there is nothing left for a run to decide.
let _bytes_cons_has_the_length_of_its_tail_plus_one(
    h: Byte,
    t: Bytes,
) -> Eq()(Bytes/len(x[h, ..t]), Nat/add(1, Bytes/len(t))) =
    Eq/refl();

let _bytes_cons_decodes_its_head_first(
    h: Byte,
    t: Bytes,
) -> Eq()(Bytes/try_get(x[h, ..t], 0), Option/some(h)) =
    Eq/refl();

let _bits_cons_has_the_length_of_its_tail_plus_one(
    h: Bool,
    t: Bits,
) -> Eq()(Bits/len(b[h, ..t]), Nat/add(1, Bits/len(t))) =
    Eq/refl();

test list_fold_sums_elements =
    Test/equal(List/fold([10, 20, 30], 0, (e, acc) => Nat/add(acc, e)), 60);

test bytes_fold_sums_bytes =
    Test/equal(
        Bytes/fold(x[0x0A, 0x14, 0x1E], 0, (byte, acc) => Nat/add(acc, Byte/to_nat(byte))),
        60);

-- Bytes show as two hexadecimal digits each, a leading zero kept, built from characters rather than decoded from bytes.
test bytes_show_as_hexadecimal =
    Test/equal(Show/show(x[0x0F, 0xA0, 0x00]), "0fa000");

-- The orders of `Bytes`, `Bits` and `Str` walk both runs' structure, so a type may name them: each is stated reflexive here, a statement an index walked upward under a guard is refused for.
let _bytes_order_is_reflexive(a: Bytes) -> Eq()(Bytes/ord(a, a), Ordering/eq()) =
    match a: (m) => Eq()(Bytes/ord(m, m), Ordering/eq())
    | x[] => Eq/refl()
    | x[_, .._]; ih => ih
    end;

let _bits_order_is_reflexive(a: Bits) -> Eq()(Bits/ord(a, a), Ordering/eq()) =
    match a: (m) => Eq()(Bits/ord(m, m), Ordering/eq())
    | b[] => Eq/refl()
    | b[h, .._]; ih => match h | true => ih | false => ih end
    end;

let _str_order_is_reflexive(a: Str) -> Eq()(Str/ord(a, a), Ordering/eq()) =
    _bytes_order_is_reflexive(Str/to_bytes(a));

-- A proper prefix first, then the first place the two differ.
test packed_orders_compare_by_prefix_then_by_atom =
    Test/all([
        Test/equal(Bytes/ord(x[], x[]), Ordering/eq()),
        Test/equal(Bytes/ord(x[1], x[1, 0]), Ordering/lt()),
        Test/equal(Bytes/ord(x[1, 0], x[1]), Ordering/gt()),
        Test/equal(Bytes/ord(x[255], x[1, 0]), Ordering/gt()),
        Test/equal(Bytes/ord(x[1, 2], x[1, 3]), Ordering/lt()),
        Test/equal(Bits/ord(b[], b[0]), Ordering/lt()),
        Test/equal(Bits/ord(b[1], b[0, 1]), Ordering/gt()),
        Test/equal(Bits/ord(b[0, 1], b[0, 1]), Ordering/eq()),
        Test/equal(Str/ord("ab", "b"), Ordering/lt()),
        Test/equal(Str/ord("b", "ab"), Ordering/gt())]);
