-- The `List` functions every peer ships: structural predicates and searches, the fold-shaped builders, `traverse` over a monad, and the stable sort.
use /std/{Nat, Str, Bool, List, Option, Eq, Ord, Ordering, Test};
use /std/Bool/{True, Holds};
use /std/List/{Member, Permutation, Pairwise};

test predicates_and_searches_answer_over_the_elements =
    let l = [3, 1, 4, 1, 5];
    let empty: List(Nat) = [];
    Test/all([
        Test/assert(List/any(l, (x: Nat) => x > 4)),
        Test/assert(List/all(l, (x: Nat) => x > 0)),
        Test/assert(Bool/not(List/all(l, (x: Nat) => x > 1))),
        Test/assert(List/contains(l, 4)),
        Test/assert(Bool/not(List/contains(l, 2))),
        Test/equal(List/index_of(l, 1), Option/some(1)),
        Test/equal(List/index_of(l, 9), Option/none()),
        Test/equal(List/find_index(l, (x: Nat) => x > 3), Option/some(2)),
        Test/equal(List/find(l, (x: Nat) => x > 3), Option/some(4)),
        Test/equal(List/last(l), Option/some(5)),
        Test/equal(List/last(empty), Option/none())]);

test builders_reshape_a_list =
    let l = [3, 1, 4, 1, 5];
    let (evens, odds) = List/partition(l, (x: Nat) => Nat/is_even(x));
    let (xs, ys) = List/unzip([(1, "a"), (2, "b")]);
    Test/all([
        Test/equal(List/reverse(l), [5, 1, 4, 1, 3]),
        Test/equal(List/filter(l, (x: Nat) => x > 2), [3, 4, 5]),
        Test/equal(
            List/filter_map(l, (x: Nat) =>
                match x > 2 | true => Option/some(x * 10) | false => Option/none() end),
            [30, 40, 50]),
        Test/equal(List/take(l, 2), [3, 1]),
        Test/equal(List/take(l, 9), [3, 1, 4, 1, 5]),
        Test/equal(List/take_while(l, (x: Nat) => x < 4), [3, 1]),
        Test/equal(List/drop_while(l, (x: Nat) => x < 4), [4, 1, 5]),
        Test/equal(evens, [4]),
        Test/equal(odds, [3, 1, 1, 5]),
        Test/equal(List/zip(l, ["a", "b"]), [(3, "a"), (1, "b")]),
        Test/equal(xs, [1, 2]),
        Test/equal(ys, ["a", "b"]),
        Test/equal(List/range(2, 5), [2, 3, 4]),
        Test/equal(List/range(5, 2), []),
        Test/equal(List/replicate(3, 7), [7, 7, 7]),
        Test/equal(List/concat_map([1, 2], (x: Nat) => [x, x]), [1, 1, 2, 2]),
        Test/equal(List/intersperse([1, 2, 3], 0), [1, 0, 2, 0, 3])]);

-- `traverse` collects under any `Monad`: over `Option` a single `none` sinks the whole list.
test traverse_collects_under_a_monad =
    let halve(x: Nat) -> Option(Nat) =
        match Nat/is_even(x) | true => Option/some(x / 2) | false => Option/none() end;
    Test/all([
        Test/equal(List/traverse([2, 4, 6], halve), Option/some([1, 2, 3])),
        Test/equal(List/traverse([2, 3, 6], halve), Option/none())]);

-- The sort merges runs, the older on the left, and takes from the left where the comparator ties, which is what makes it stable: the two `1`s keep their order, and `sort_by` under a reversed comparator reverses the distinct keys while equal keys still keep theirs.
test sort_is_stable_and_sort_by_takes_a_comparator =
    let pairs = [(2, "b"), (1, "x"), (2, "a"), (1, "y")];
    Test/all([
        Test/equal(List/sort([3, 1, 2]), [1, 2, 3]),
        Test/equal(List/sort(["b", "a", "c"]), ["a", "b", "c"]),
        Test/equal(
            List/sort_by(pairs, (p: {Nat, Str}, q: {Nat, Str}) => Nat/ord(p.0, q.0)),
            [(1, "x"), (1, "y"), (2, "b"), (2, "a")]),
        Test/equal(
            List/sort_by(pairs, (p: {Nat, Str}, q: {Nat, Str}) => Nat/ord(q.0, p.0)),
            [(2, "b"), (2, "a"), (1, "x"), (1, "y")])]);

-- Every predicate and search is a case split on `[head, ..tail]` with a call on the tail, which the totality analysis grades as a decrease — so `find` and `any` compute in a type. Stated as proofs: the claim is in the type and the kernel discharges it where the unit is checked, which is a stronger statement than a run of them would be.
let _find_computes_in_a_type: Eq()(List/find([1, 2, 3], (x: Nat) => x > 1), Option/some(2)) =
    Eq/refl();

let _any_computes_in_a_type: Eq()(List/any([1, 2, 3], (x: Nat) => Nat/is_even(x)), true) =
    Eq/refl();

-- Membership and permutation are propositions a proof builds by naming the place or the exchange, and each is stated here of closed lists as a reader would write it, every implicit left to the lists.
let _the_second_of_three_is_a_member: Member()(2, [1, 2, 3]) =
    Member/there(Member/here());

let _a_swap_is_a_permutation: Permutation()([2, 1, 3], [1, 2, 3]) =
    Permutation/swap();

let _a_rotation_is_a_permutation: Permutation()([1, 2, 3], [3, 1, 2]) =
    Permutation/trans(Permutation/skip(Permutation/swap()), Permutation/swap());

let _a_member_is_carried_across_a_permutation: Member()(1, [3, 1, 2]) =
    Permutation/member(_a_rotation_is_a_permutation, Member/here());

-- `ordered` decides a relation at each adjacent pair, and a comparator is read as one: by `Ord/le` alone, and by `Ord/then` with a second relation among what the comparator ties.
test ordered_decides_each_adjacent_pair =
    let empty: List(Nat) = [];
    let by_number(p: {Nat, Str}, q: {Nat, Str}) -> Ordering = Nat/ord(p.0, q.0);
    let by_text(p: {Nat, Str}, q: {Nat, Str}) -> Ordering = Str/ord(p.1, q.1);
    let tied = [(1, "b"), (1, "a"), (2, "a")];
    Test/all([
        Test/assert(List/ordered(empty, Ord/le(Nat/ord))),
        Test/assert(List/ordered([1, 2, 2, 5], Ord/le(Nat/ord))),
        Test/assert(Bool/not(List/ordered([1, 3, 2], Ord/le(Nat/ord)))),
        Test/assert(List/ordered(tied, Ord/le(by_number))),
        Test/assert(Bool/not(List/ordered(tied, Ord/then(by_number, Ord/le(by_text)))))]);

-- A list in order at adjacent pairs is in order at every pair, where the relation carries across a middle element: stated over any relation and its law.
let _adjacent_order_reaches_every_pair(
    @T: Type,
    le: (T, T) -> Bool,
    carries: Ord/Transitive(le),
    l: List(T),
    given: Holds(List/ordered(l, le)),
) -> Pairwise(le)(l) =
    Pairwise/of_ordered(le, carries, l, given);

let counted(n: Nat, each: (Nat) -> Nat) -> List(Nat) =
    let go(i: Nat, left: Nat, acc: List(Nat)) -> List(Nat) =
        match left | 0 => acc | fewer + 1 => go(i + 1, fewer, [..acc, each(i)]) end;
    go(0, n, []);

let whole_and_in_order(l: List(Nat)) -> Test =
    let sorted = List/sort(l);
    Test/all([
        Test/equal(List/len(sorted), List/len(l)),
        Test/assert(List/ordered(sorted, Ord/le(Nat/ord)))]);

-- A hundred thousand elements, which a sort as deep as its input or as costly as its square does not answer for: already in order, in reverse, and scattered.
test sort_answers_at_a_hundred_thousand_elements_in_any_order =
    Test/all([
        whole_and_in_order(counted(100000, (i) => i)),
        whole_and_in_order(counted(100000, (i) => 99999 - i)),
        whole_and_in_order(counted(100000, (i) => (i * 7919 + 13) % 100003))]);

-- The sort descends on its lists' structure alone, so a closed sort computes in a type and its order is decided there.
let _a_closed_sort_computes: Eq()(List/sort_by([3, 1, 2, 1], Nat/ord), [1, 1, 2, 3]) =
    Eq/refl();

let _a_closed_sort_is_in_order: Holds(
    List/ordered(List/sort_by([3, 1, 2, 1], Nat/ord), Ord/le(Nat/ord))) =
    True/qed();

-- The theorem's two statements, each over any comparator: the answer is the input rearranged, under no law, and it is in order under the comparator's flip.
let _a_sort_rearranges_under_any_comparator(
    @T: Type,
    ord: (T, T) -> Ordering,
    l: List(T),
) -> Permutation()(l, List/sort_by(l, ord)) =
    List/sort_by/permuted(l, ord);

let _a_sort_is_in_order_under_the_flip(
    @T: Type,
    ord: (T, T) -> Ordering,
    flips: Ord/Flips(ord),
    l: List(T),
) -> Holds(List/ordered(List/sort_by(l, ord), Ord/le(ord))) =
    List/sort_by/sorted(ord, flips, l);

-- What stable buys: a list sorted by one comparator and then by another is in order by the second, and by the first among what the second ties.
let _two_sorts_order_by_both_keys(
    @T: Type,
    later: (T, T) -> Ordering,
    earlier: (T, T) -> Ordering,
    later_flips: Ord/Flips(later),
    earlier_flips: Ord/Flips(earlier),
    earlier_carries: Ord/Transitive(Ord/le(earlier)),
    l: List(T),
) -> Holds(
    List/ordered(List/sort_by(List/sort_by(l, earlier), later), Ord/then(later, Ord/le(earlier)))) =
    let once = List/sort_by(l, earlier);
    List/sort_by/ordered(
        later,
        later_flips,
        Ord/le(earlier),
        once,
        Pairwise/of_ordered(
            Ord/le(earlier),
            earlier_carries,
            once,
            List/sort_by/sorted(earlier, earlier_flips, l)));
