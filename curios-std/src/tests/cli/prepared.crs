use /std/{Cli, Nat, Str, List, Option, Map, Test};
use /std/Cli/{Grammar};
use /std/Cli/Grammar/{Named, Positional};

let names(long: Str) -> Named =
    Named { long = long, short = Option/none(), help = "" };

let grammar() -> Grammar({{}, Str}) =
    Grammar/product(
        Grammar/choice(Grammar/flag(names("first")), Grammar/flag(names("second"))),
        Grammar/positional(Positional { name = "path", help = "Path" }, Cli/str));

test every_metadata_id_and_ownership_path_is_bounded_by_its_actual_tree =
    let prepared = Cli/prepare(grammar());
    let limit = Cli/Prepared/size(prepared.grammar.tree);
    Test/assert(
        List/all(prepared.metadata.named, (entry) =>
            entry.id.value < limit && List/all(entry.owners, (owner) => owner.value < limit)));

test independent_choices_keep_their_own_routes =
    let pair = Grammar/choice(Grammar/flag(names("a")), Grammar/flag(names("b")));
    let triple =
        Grammar/choice(
            Grammar/choice(Grammar/flag(names("c")), Grammar/flag(names("d"))),
            Grammar/flag(names("e")));
    let prepared = Cli/prepare(Grammar/product(pair, triple));
    Test/all([
        Test/equal(List/len(prepared.metadata.named), 5),
        Test/equal(Map/len(prepared.lookup), 5)]);

test long_and_short_aliases_find_the_same_leaf =
    let prepared =
        Cli/prepare(
            Grammar/option(
                Named { long = "port", short = Option/some('p'), help = "Port" },
                Cli/nat));
    match (Map/get(prepared.lookup, "--port"), Map/get(prepared.lookup, "-p"))
    | (some(long), some(short)) => Test/equal(long.id.value, short.id.value)
    | _ => Test/fail("an alias disappeared")
    end;

test positional_entries_retain_their_order_and_rest_shape =
    let prepared =
        Cli/prepare(
            Cli/record([Cli/positional("first", Cli/str, ""), Cli/rest("remaining", Cli/str, "")]));
    Test/equal(
        List/map(prepared.metadata.positional, (entry) => (entry.names.name, entry.rest)),
        [("first", false), ("remaining", true)]);

test nested_choice_owners_have_distinct_node_identifiers =
    let prepared =
        Cli/prepare(
            Grammar/choice(
                Grammar/choice(Grammar/flag(names("a")), Grammar/flag(names("b"))),
                Grammar/flag(names("c"))));
    match Map/get(prepared.lookup, "--a")
    | none() => Test/fail("the leaf disappeared")
    | some(entry) =>
        let ids = List/map(entry.owners, (owner) => owner.value);
        Test/equal(ids, [2, 1, 0])
    end;
