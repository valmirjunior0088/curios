use /std/{Cli, Str, Nat, List, Option, Test};
use /std/Cli/{Grammar, SpecError};
use /std/Cli/Grammar/{Node, Named, Positional};

let named(long: Str) -> Named =
    Named { long = long, short = Option/none(), help = "" };

let position(name: Str) -> Positional =
    Positional { name = name, help = "" };

let raw_flag(name: Str) -> Node({}) =
    Node/flag(named(name));

let raw_position(name: Str) -> Node(Str) =
    Node/positional(position(name), Grammar/reader(Cli/str));

let problem(@A: Type, tree: Node(A)) -> Str =
    match Grammar/checked(tree)
    | success(_) => "accepted"
    | failure(error) => SpecError/to_str(error)
    end;

let fixed() -> Grammar({{}, Option(Nat)}) =
    Grammar/product(
        Grammar/choice(Grammar/flag(named("first")), Grammar/flag(named("second"))),
        Grammar/optional(
            Grammar/option(
                Named { long = "port", short = Option/some('p'), help = "Port" },
                Cli/nat)));

test fixed_combinators_preserve_their_typed_tree =
    Test/equal(List/len(Grammar/aliases(fixed().tree)), 4);

test nested_and_independent_choices_do_not_require_a_product_of_all_variants =
    let first = Grammar/choice(Grammar/flag(named("a")), Grammar/flag(named("b")));
    let nested = Grammar/choice(first, Grammar/flag(named("c")));
    let independent =
        Grammar/product(nested, Grammar/choice(Grammar/flag(named("d")), Grammar/flag(named("e"))));
    Test/equal(List/len(Grammar/aliases(independent.tree)), 5);

test dynamic_certification_rejects_duplicate_long_and_short_names =
    let names = Named { long = "port", short = Option/some('p'), help = "" };
    let tree = Grammar/option(names, Cli/nat).tree;
    Test/equal(problem(Node/product(tree, tree)), "duplicate option names: --port, -p");

test dynamic_certification_checks_the_names_actual_characters =
    Test/all([
        Test/equal(problem(raw_flag("bad name")), "invalid long option name \"bad name\""),
        Test/equal(
            problem(Node/flag(Named { long = "good", short = Option/some('-'), help = "" })),
            "invalid short option name '-'"),
        Test/equal(problem(raw_flag("a=b")), "invalid long option name \"a=b\"")]);

test a_nullable_positional_cannot_precede_another_positional =
    let first = raw_position("first");
    let second = raw_position("second");
    Test/equal(
        problem(Node/product(Node/optional(first), second)),
        "nullable positional groups and rest must end the positional list");

test two_rest_collectors_cannot_compete_for_the_suffix =
    let first = Node/rest(position("first"), Grammar/reader(Cli/str));
    let second = Node/rest(position("second"), Grammar/reader(Cli/str));
    Test/equal(
        problem(Node/product(first, second)),
        "nullable positional groups and rest must end the positional list");

test two_positional_alternatives_have_no_distinguishing_selector =
    Test/equal(
        problem(Node/choice(raw_position("first"), raw_position("second"))),
        "at most one alternative may lack a required named selector");

test defaults_do_not_make_an_empty_alternative_selectable =
    Test/equal(
        problem(Node/choice(Node/pure(()), raw_flag("flag"))),
        "each alternative must own a named or positional occurrence");

test repetition_accepts_named_leaves_and_refuses_groups =
    let repeated = Grammar/repeat(Grammar/option(named("item"), Cli/str));
    Test/all([
        Test/equal(problem(repeated.tree), "accepted"),
        Test/equal(
            problem(Node/repeat(Node/product(raw_flag("a"), raw_flag("b")))),
            "only a named leaf may be repeated")]);

test optional_positionals_are_fixed_blocks =
    let rest = Node/rest(position("remaining"), Grammar/reader(Cli/str));
    Test/equal(
        problem(Node/optional(rest)),
        "optional positional groups must contain a fixed required block");

test a_singular_option_can_explicitly_keep_its_last_occurrence =
    let grammar =
        Grammar/on_repeat(Grammar/option(named("port"), Cli/nat), Grammar/Multiplicity/last());
    Test/equal(problem(grammar.tree), "accepted");

test the_record_adapter_preserves_its_dependent_result_type =
    let spec = [Cli/option("port", Cli/nat, "Port"), Cli/flag("quiet", "Quiet")];
    let grammar: Grammar(Cli/Values(spec)) = Cli/record(spec);
    Test/equal(List/len(Grammar/aliases(grammar.tree)), 2);

test a_dynamic_record_reports_its_duplicate_field =
    let duplicate = [Cli/flag("same", ""), Cli/flag("same", "")];
    match Cli/record/checked_record(duplicate)
    | success(_) => Test/fail("the duplicate was accepted")
    | failure(error) => Test/equal(SpecError/to_str(error), "duplicate record field \"same\"")
    end;

test a_positional_record_field_cannot_silently_drop_a_short_alias =
    let field = Cli/Arg { ..Cli/positional("path", Cli/str, "Path"), short = Option/some('p') };
    match Cli/record/checked_record([field])
    | success(_) => Test/fail("the positional alias was accepted")
    | failure(error) =>
        Test/equal(SpecError/to_str(error), "positional \"path\" cannot own short option -p")
    end;
