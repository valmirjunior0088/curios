use /std/{Cli, Str, Bool, Option, Test};
use /std/Cli/{Grammar};
use /std/Cli/Grammar/{Named};
use /cli/interpret/common/{named, position, text};

let value() -> Grammar(Str) =
    Grammar/option(Named { long = "value", short = Option/some('v'), help = "" }, Cli/str);

test a_value_taking_option_owns_help_and_version_tokens =
    Test/all([
        Test/equal(text(value(), ["--value", "--help"], (s) => s), "--help"),
        Test/equal(text(value(), ["--value=--help"], (s) => s), "--help"),
        Test/equal(text(value(), ["-v", "--version"], (s) => s), "--version"),
        Test/equal(text(value(), ["-v--help"], (s) => s), "--help"),
        Test/equal(text(value(), ["-vh"], (s) => s), "h")]);

test the_sentinel_only_acts_in_argument_position =
    Test/all([
        Test/equal(
            text(Grammar/positional(position("path"), Cli/str), ["--", "--help"], (s) => s),
            "--help"),
        Test/equal(text(value(), ["--value", "--"], (s) => s), "--"),
        Test/equal(text(value(), ["--value", "--", "--help"], (s) => s), "help")]);

test owned_help_precedes_version_and_input_errors =
    Test/all([
        Test/equal(text(value(), ["--unknown", "--help"], (s) => s), "help"),
        Test/equal(text(value(), ["--version", "--help"], (s) => s), "help"),
        Test/equal(text(value(), ["--unknown", "--version"], (s) => s), "version 1.0")]);

test short_clusters_respect_the_first_value_taking_option =
    let quiet = Grammar/switch(Named { long = "quiet", short = Option/some('q'), help = "" });
    let grammar = Grammar/product(quiet, value());
    Test/all([
        Test/equal(
            text(grammar, ["-qqvhello"], ((quiet, value)) => Str/concat(Bool/to_str(quiet), value)),
            "truehello"),
        Test/equal(text(grammar, ["-qvh"], ((_, value)) => value), "h"),
        Test/equal(text(grammar, ["-qh"], ((_, value)) => value), "help")]);

test attached_values_are_refused_for_flags_including_builtins =
    Test/all([
        Test/equal(text(Grammar/switch(named("quiet")), ["--quiet=yes"], Bool/to_str), "bad quiet"),
        Test/equal(text(value(), ["--help=yes"], (s) => s), "bad help")]);

test a_missing_value_is_reported_without_reading_any_leaf =
    Test/equal(text(value(), ["--value"], (s) => s), "missing value value");

test a_dash_leading_numeric_value_belongs_to_its_option =
    Test/equal(
        text(Grammar/option(named("count"), Cli/int), ["--count", "-10"], /std/Int/to_str),
        "-10");

test disabled_version_is_an_ordinary_option_name =
    let prepared = Cli/Prepared/prepare(Grammar/option(named("version"), Cli/str));
    Test/equal(
        match Cli/interpret(prepared, ["--version", "mine"], Option/none())
        | success(reading) => match reading | parsed(value) => value | _ => "failed" end
        | _ => "failed"
        end,
        "mine");

test active_builtin_collisions_precede_help =
    let grammar = Grammar/option(named("version"), Cli/str);
    Test/equal(
        text(grammar, ["--help"], (s) => s),
        "option \"--version\" collides with an active built-in");
