-- `/std/Cli`: the specification a program declares, the record computed from it, the grammar a line is read by, the screens it answers with, and how a subcommand is chosen.
mod spec;

mod parse;

mod render;

mod subcommand;

mod grammar;

mod prepared;

mod interpret;

mod validation;
use /std/{Cli, Str, Result};

pub let rendered(value: Result(Cli/SpecError, Str)) -> Str =
    match value | success(text) => text | failure(error) => Cli/SpecError/to_str(error) end;
