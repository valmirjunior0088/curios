use /std/{Str, Char, Bool, Show, Spell, Io};

--- A parsed format string: literal pieces, and the places an argument goes — shown at a `%`, spelled at a `#`.
pub induct Fmt: pub Type
--- Nothing left of the string.
| nil()
--- A literal piece, then the rest.
| lit(piece: Str, rest: Fmt)
--- A place a `Show`-able argument goes, written `%`.
| show(Fmt)
--- A place a `Spell`-able argument goes, written `#`.
| spell(Fmt)
end

--- The type of a function taking one argument per place in `f` — a `Show`-able one at a `%`, a `Spell`-able one at a `#` — and answering a `T`.
pub let format_type_with(T: Type, f: Fmt) -> Type =
    match f
    | nil() => T
    | lit(_, rest) => format_type_with(T, rest)
    | show(rest) => (@A: Type, use Show(A), a: A) -> format_type_with(T, rest)
    | spell(rest) => (@A: Type, use Spell(A), a: A) -> format_type_with(T, rest)
    end;

--- Where a walk over a format stands: the tree read so far, last piece first; the literal run it is in; and whether a backslash waits for the character it may escape.
let Walk: Type =
    {Fmt, Str, Bool};

--- `c` read where no backslash waits: a place closes the run before it, a backslash waits for what follows, and any other character joins the run.
let plain(c: Char, read: Fmt, run: Str) -> Walk =
    match Char/to_nat(c)
    | '%' => (Fmt/show(Fmt/lit(run, read)), "", false)
    | '#' => (Fmt/spell(Fmt/lit(run, read)), "", false)
    | '\\' => (read, run, true)
    | _ => (read, Str/concat(run, Str/of_char(c)), false)
    end;

--- The walk one character on. After a backslash a place's character is the literal one, and any other character leaves the backslash a character of the run and is read as it stands.
let step(c: Char, walk: Walk) -> Walk =
    let (read, run, escaped) = walk;
    match escaped
    | false => plain(c, read, run)
    | true =>
        match Char/to_nat(c)
        | '%' => (read, Str/concat(run, "%"), false)
        | '#' => (read, Str/concat(run, "#"), false)
        | _ => plain(c, read, Str/concat(run, "\\"))
        end
    end;

--- `read`, a tree whose last piece comes first, turned around onto `rest`.
let turned(read: Fmt, rest: Fmt) -> Fmt =
    match read
    | nil() => rest
    | lit(piece, before) => turned(before, Fmt/lit(piece, rest))
    | show(before) => turned(before, Fmt/show(rest))
    | spell(before) => turned(before, Fmt/spell(rest))
    end;

--- The format `s` spells: `%` is a place an argument is shown at and `#` one it is spelled at; `\%` and `\#` are the literal characters, and a backslash before anything else is itself. A fold over the characters, so every piece is text because every character it is built from is, and the walk ends where the string does.
pub let parse(s: Str) -> Fmt =
    let start: Walk = (Fmt/nil(), "", false);
    let (read, run, escaped) = Str/fold(s, start, step);
    turned(
        Fmt/lit(match escaped | true => Str/concat(run, "\\") | false => run end, read),
        Fmt/nil());

let go_with(T: Type, finish: (Str) -> T, f: Fmt, acc: Str) -> format_type_with(T, f) =
    match f
    | nil() => finish(acc)
    | lit(piece, rest) => go_with(T, finish, rest, Str/concat(acc, piece))
    | show(rest) => (@_, use _, a) => go_with(T, finish, rest, Str/concat(acc, Show/show(a)))
    | spell(rest) => (@_, use _, a) => go_with(T, finish, rest, Str/concat(acc, Spell/spell(a)))
    end;

--- The text of `s` with its places filled by the arguments that follow.
pub let render(s: Str) -> format_type_with(Str, parse(s)) =
    go_with(Str, (x) => x, parse(s), "");

--- The text of `s` with its places filled, written to standard output.
pub let print(s: Str) -> format_type_with(Io({}), parse(s)) =
    go_with(Io({}), (x) => /std/print(x), parse(s), "");

--- The text of `s` with its places filled, written to standard error.
pub let print_err(s: Str) -> format_type_with(Io({}), parse(s)) =
    go_with(Io({}), (x) => /std/print_err(x), parse(s), "");
