use /std/{Nat, Int, Bool, Byte, Bytes, Parse, Toml};
use /std/Toml/{Date, Time, OffsetDateTime, LocalDateTime};

let digit: Parse(Bytes, Nat) =
    Parse/label(
        Parse/map(
            Parse/bytes/byte_if((b) => Nat/in_range(Byte/to_nat(b), '0', '9')),
            (b) => Byte/to_nat(b) - '0'),
        "expected digit");

let fixed(count: Nat, acc: Nat) -> Parse(Bytes, Nat) =
    match count
    | 0 => Parse/pure(acc)
    | pred + 1 =>
        let d = digit!;
        fixed(pred, acc * 10 + d)
    end;

let expect(want: Byte) -> Parse(Bytes, {}) =
    Parse/label(Parse/map(Parse/bytes/expect(want), (_) => ()), "malformed date-time");

let nat_pow10(n: Nat) -> Nat =
    match n | 0 => 1 | _ + 1; ih => ih * 10 end;

let frac_stop(taken: Nat, acc: Nat, seen: Bool) -> Parse(Bytes, Nat) =
    match seen
    | true => Parse/pure(acc * nat_pow10(9 - taken))
    | false => Parse/fail("expected digit")
    end;

let frac_digits(taken: Nat, acc: Nat, seen: Bool) -> Parse(Bytes, Nat) =
    let next = Parse/bytes/peek!;
    match next
    | none() => frac_stop(taken, acc, seen)
    | some(b) =>
        match Nat/in_range(Byte/to_nat(b), '0', '9')
        | false => frac_stop(taken, acc, seen)
        | true =>
            let _ = Parse/bytes/byte!;
            match taken < 9
            | true => frac_digits(taken + 1, acc * 10 + (Byte/to_nat(b) - '0'), true)
            | false => frac_digits(taken, acc, true)
            end
        end
    end;

let frac_part: Parse(Bytes, Nat) =
    let dot = Parse/optional(Parse/bytes/expect('.'))!;
    match dot | some(_) => frac_digits(0, 0, false) | none() => Parse/pure(0) end;

let date_fields(y: Nat) -> Parse(Bytes, Date) =
    let mo = fixed(2, 0)!;
    let _ = expect('-')!;
    let d = fixed(2, 0)!;
    match Date/try_of(y, mo, d)
    | some(date) => Parse/pure(date)
    | none() => Parse/fail("invalid date")
    end;

let date_parse: Parse(Bytes, Date) =
    let y = fixed(4, 0)!;
    let _ = expect('-')!;
    Parse/commit(date_fields(y));

let time_fields(h: Nat) -> Parse(Bytes, Time) =
    let mi = fixed(2, 0)!;
    let _ = expect(':')!;
    let s = fixed(2, 0)!;
    let ns = frac_part!;
    match Time/try_of(h, mi, s, ns)
    | some(time) => Parse/pure(time)
    | none() => Parse/fail("invalid time")
    end;

let time_parse: Parse(Bytes, Time) =
    let h = fixed(2, 0)!;
    let _ = expect(':')!;
    Parse/commit(time_fields(h));

let offset_fields(sign: Byte) -> Parse(Bytes, Int) =
    let oh = fixed(2, 0)!;
    let _ = expect(':')!;
    let om = fixed(2, 0)!;
    match oh <= 23 && om <= 59
    | true =>
        let mins = oh * 60 + om;
        match sign == '-'
        | true => Parse/pure(+0 - Nat/to_int(mins))
        | false => Parse/pure(Nat/to_int(mins))
        end
    | false => Parse/fail("invalid offset")
    end;

let offset_parse: Parse(Bytes, Int) =
    let zulu = Parse/optional(Parse/bytes/byte_if((b) => b == 'Z' || b == 'z'))!;
    match zulu
    | some(_) => Parse/pure(+0)
    | none() =>
        let sign =
            Parse/label(Parse/bytes/byte_if((b) => b == '+' || b == '-'), "expected offset")!;
        Parse/commit(offset_fields(sign))
    end;

let offset_tail(date: Date, time: Time) -> Parse(Bytes, Toml) =
    let off = offset_parse!;
    match OffsetDateTime/try_of(date, time, off)
    | some(odt) => Parse/pure(Toml/offset_date_time(odt))
    | none() => Parse/fail("invalid offset")
    end;

let date_time_tail(date: Date) -> Parse(Bytes, Toml) =
    let _ = Parse/bytes/byte_if((b) => b == 'T' || b == 't' || b == ' ')!;
    let time = time_parse!;
    Parse/or(
        offset_tail(date, time),
        Parse/pure(Toml/local_date_time(LocalDateTime { date = date, time = time })));

let date_led: Parse(Bytes, Toml) =
    let date = date_parse!;
    Parse/or(date_time_tail(date), Parse/pure(Toml/local_date(date)));

--- A date, a time, or the two together, with or without an offset.
pub let datetime_value: Parse(Bytes, Toml) =
    Parse/or(date_led, Parse/map(time_parse, (time) => Toml/local_time(time)));
