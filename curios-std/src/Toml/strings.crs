use /std/{Nat, Bool, Char, Str, Option, Parse};
use /std/Toml/scan/{hex_val};

let hex_digit: Parse(Str, Nat) =
    let next = Parse/text/peek!;
    match next
    | none() => Parse/fail("unterminated escape")
    | some(c) =>
        match hex_val(Char/to_nat(c))
        | some(v) =>
            let _ = Parse/text/char!;
            Parse/pure(v)
        | none() => Parse/fail("invalid hex digit in escape")
        end
    end;

let hex_digits(count: Nat, acc: Nat) -> Parse(Str, Nat) =
    match count
    | 0 => Parse/pure(acc)
    | pred + 1 =>
        let v = hex_digit!;
        hex_digits(pred, acc * 0x10 + v)
    end;

--- The character `code` is, as the text it is, declining a value that is no Unicode scalar.
let scalar(code: Nat) -> Parse(Str, Str) =
    match Char/of_nat(code)
    | some(c) => Parse/pure(Str/of_char(c))
    | none() => Parse/fail("invalid Unicode scalar in escape")
    end;

--- What follows a backslash: the character the escape names.
let escape: Parse(Str, Str) =
    let next = Parse/text/peek!;
    match next
    | none() => Parse/fail("unterminated escape")
    | some(c) =>
        let _ = Parse/text/char!;
        match Char/to_nat(c)
        | 'b' => Parse/pure("\u{8}")
        | 't' => Parse/pure("\t")
        | 'n' => Parse/pure("\n")
        | 'f' => Parse/pure("\u{C}")
        | 'r' => Parse/pure("\r")
        | '"' => Parse/pure("\"")
        | '\\' => Parse/pure("\\")
        | 'u' =>
            let code = hex_digits(4, 0)!;
            scalar(code)
        | 'U' =>
            let code = hex_digits(8, 0)!;
            scalar(code)
        | _ => Parse/fail("unknown escape")
        end
    end;

let crlf: Parse(Str, Option({Char, Char})) =
    Parse/optional(Parse/and(Parse/text/expect('\r'), Parse/text/expect('\n')));

--- Whether `c` stands in a string as written whatever delimits it: a tab, or any character that is no control character.
let is_text(c: Char) -> Bool =
    let n = Char/to_nat(c);
    n == '\t' || n >= 0x20 && n != 0x7F;

--- A basic string's body from where it stands: the runs of the input between its escapes and the character each escape names, joined after `acc`, up to the closing quote.
let basic_body(acc: Str) -> Parse(Str, Str) =
    let run = Parse/text/take_while((c) => is_text(c) && c != '"' && c != '\\')!;
    let here = Str/concat(acc, run);
    let next = Parse/text/peek!;
    match next
    | none() => Parse/fail("unterminated string")
    | some(c) =>
        choose
        | c == '"' =>
            let _ = Parse/text/char!;
            Parse/pure(here)
        | c == '\\' =>
            let _ = Parse/text/char!;
            let piece = escape!;
            basic_body(Str/concat(here, piece))
        | _ => Parse/fail("control character in string")
        end
    end;

let basic_str_scan: Parse(Str, Str) =
    let _ = Parse/label(Parse/text/expect('"'), "expected string")!;
    basic_body("");

--- A literal string's body: the piece of the input up to the closing quote, taken as written.
let literal_body: Parse(Str, Str) =
    let run = Parse/text/take_while((c) => is_text(c) && c != '\'')!;
    let next = Parse/text/peek!;
    match next
    | none() => Parse/fail("unterminated string")
    | some(c) =>
        match c == '\''
        | true =>
            let _ = Parse/text/char!;
            Parse/pure(run)
        | false => Parse/fail("control character in string")
        end
    end;

let literal_str_scan: Parse(Str, Str) =
    let _ = Parse/label(Parse/text/expect('\''), "expected string")!;
    literal_body;

let trim_run(seen_nl: Bool) -> Parse(Str, {}) =
    let stop: Parse(Str, {}) =
        match seen_nl | true => Parse/pure(()) | false => Parse/fail("invalid escape") end;
    let next = Parse/text/peek!;
    match next
    | none() => stop
    | some(c) =>
        choose
        | c == ' ' =>
            let _ = Parse/text/char!;
            trim_run(seen_nl)
        | c == '\t' =>
            let _ = Parse/text/char!;
            trim_run(seen_nl)
        | c == '\n' =>
            let _ = Parse/text/char!;
            trim_run(true)
        | c == '\r' =>
            let pair = crlf!;
            match pair
            | some(_) => trim_run(true)
            | none() => Parse/fail("bare carriage return")
            end
        | _ => stop
        end
    end;

let skip_opening_newline: Parse(Str, {}) =
    let lf = Parse/optional(Parse/text/expect('\n'))!;
    match lf
    | some(_) => Parse/pure(())
    | none() =>
        let _ = crlf!;
        Parse/pure(())
    end;

--- A run of `quote` inside a multi-line string, read whole: fewer than three are text and the body goes on, three to five close the string with what is past the third kept as text, and six or more are refused. The text so far, and whether the string is closed.
let quote_run(quote: Char, acc: Str) -> Parse(Str, {Str, Bool}) =
    let run = Parse/text/take_while((c) => c == quote)!;
    let q = Str/len(run);
    let mark = Str/of_char(quote);
    choose
    | q >= 6 => Parse/fail("too many quotes")
    | q >= 3 => Parse/pure((Str/concat(acc, Str/repeat(mark, q - 3)), true))
    | _ => Parse/pure((Str/concat(acc, run), false))
    end;

let ml_basic_body(acc: Str) -> Parse(Str, Str) =
    let run = Parse/text/take_while((c) => is_text(c) && c != '"' && c != '\\')!;
    let here = Str/concat(acc, run);
    let next = Parse/text/peek!;
    match next
    | none() => Parse/fail("unterminated string")
    | some(c) =>
        choose
        | c == '"' =>
            let (kept, closed) = quote_run('"', here)!;
            match closed | true => Parse/pure(kept) | false => ml_basic_body(kept) end
        | c == '\\' =>
            let _ = Parse/text/char!;
            let folded = Parse/text/peek!;
            match folded
            | some(w) =>
                match w == ' ' || w == '\t' || w == '\n' || w == '\r'
                | true =>
                    let _ = trim_run(false)!;
                    ml_basic_body(here)
                | false =>
                    let piece = escape!;
                    ml_basic_body(Str/concat(here, piece))
                end
            | none() =>
                let piece = escape!;
                ml_basic_body(Str/concat(here, piece))
            end
        | c == '\n' =>
            let _ = Parse/text/char!;
            ml_basic_body(Str/concat(here, "\n"))
        | c == '\r' =>
            let pair = crlf!;
            match pair
            | some(_) => ml_basic_body(Str/concat(here, "\r\n"))
            | none() => Parse/fail("bare carriage return")
            end
        | _ => Parse/fail("control character in string")
        end
    end;

let ml_literal_body(acc: Str) -> Parse(Str, Str) =
    let run = Parse/text/take_while((c) => is_text(c) && c != '\'')!;
    let here = Str/concat(acc, run);
    let next = Parse/text/peek!;
    match next
    | none() => Parse/fail("unterminated string")
    | some(c) =>
        choose
        | c == '\'' =>
            let (kept, closed) = quote_run('\'', here)!;
            match closed | true => Parse/pure(kept) | false => ml_literal_body(kept) end
        | c == '\n' =>
            let _ = Parse/text/char!;
            ml_literal_body(Str/concat(here, "\n"))
        | c == '\r' =>
            let pair = crlf!;
            match pair
            | some(_) => ml_literal_body(Str/concat(here, "\r\n"))
            | none() => Parse/fail("bare carriage return")
            end
        | _ => Parse/fail("control character in string")
        end
    end;

--- A basic string, delimited by `"`, with its escapes resolved.
pub let str_basic: Parse(Str, Str) =
    basic_str_scan;

--- A literal string, delimited by `'`, taken as written.
pub let str_literal: Parse(Str, Str) =
    literal_str_scan;

--- A multi-line basic string, delimited by `"""`, with its escapes resolved and the opening line break dropped.
pub let str_ml_basic: Parse(Str, Str) =
    let _ = Parse/text/literal("\"\"\"")!;
    let _ = skip_opening_newline!;
    ml_basic_body("");

--- A multi-line literal string, delimited by `'''`, taken as written with the opening line break dropped.
pub let str_ml_literal: Parse(Str, Str) =
    let _ = Parse/text/literal("'''")!;
    let _ = skip_opening_newline!;
    ml_literal_body("");
