use /std/{Nat, Int, Flt, Bool, Char, Str, List, Map, Option, Toml, Fmt};
use /std/time/{rfc3339};
use /std/Toml/scan/{is_bare_char};

let bare_ok(s: Str) -> Bool =
    Bool/not(Str/is_empty(s)) && Str/fold(s, true, (c, ok) => ok && is_bare_char(c));

--- What a character is written as inside a basic string, when it is not written as itself: the quote, the backslash, the control characters and DEL, which TOML escapes.
let escaped(c: Char) -> Option(Str) =
    let n = Char/to_nat(c);
    match n
    | '"' => Option/some("\\\"")
    | '\\' => Option/some("\\\\")
    | '\u{8}' => Option/some("\\b")
    | '\t' => Option/some("\\t")
    | '\n' => Option/some("\\n")
    | '\u{C}' => Option/some("\\f")
    | '\r' => Option/some("\\r")
    | _ =>
        match n < 0x20 || n == 0x7F
        | true =>
            Option/some(
                Str/flatten([
                    "\\u00",
                    Str/of_char(Char/hex_digit(n / 0x10)),
                    Str/of_char(Char/hex_digit(n % 0x10))]))
        | false => Option/none()
        end
    end;

let quote_str(s: Str) -> Str =
    Str/flatten(["\"", Str/escape(s, escaped), "\""]);

let spell_key(k: Str) -> Str =
    match bare_ok(k) | true => k | false => quote_str(k) end;

let int_str(n: Int) -> Str =
    match n >= +0
    | true => Nat/to_str(Int/to_nat(n))
    | false => Str/concat("-", Nat/to_str(Int/abs(n)))
    end;

let flt_str(f: Flt) -> Str =
    match Flt/is_finite(f)
    | false =>
        choose
        | f > +0.0 => "inf"
        | f < +0.0 => "-inf"
        | Flt/is_sign_minus(f) => "-nan"
        | _ => "nan"
        end
    | true =>
        let raw = Flt/to_str(f);
        let unsigned = match Str/strip_prefix(raw, "+") | some(bare) => bare | none() => raw end;
        match Str/contains(unsigned, '.') || Str/contains(unsigned, 'e')
        | true => unsigned
        | false => Str/concat(unsigned, ".0")
        end
    end;

let value_str(v: Toml) -> Str =
    match v
    | str(s) => quote_str(s)
    | int(n) => int_str(n)
    | flt(f) => flt_str(f)
    | bool(x) => Bool/to_str(x)
    | offset_date_time(odt) =>
        Str/flatten([
            rfc3339/write_date(odt.date_time.date),
            "T",
            rfc3339/write_time(odt.date_time.time),
            rfc3339/write_offset(odt.offset)])
    | local_date_time(ldt) =>
        Str/flatten([rfc3339/write_date(ldt.date), "T", rfc3339/write_time(ldt.time)])
    | local_date(d) => rfc3339/write_date(d)
    | local_time(t) => rfc3339/write_time(t)
    | arr(items) =>
        let start: List(Str) = [];
        let parts = List/fold(items, start, (item, parts) => [..parts, value_str(item)]);
        Fmt/render("[%]")(Str/join(", ", parts))
    | table(m) =>
        match List/len(Map/to_list(m)) == 0
        | true => "{}"
        | false => Fmt/render("{ % }")(pairs_str(Map/to_list(m)))
        end
    end
and pairs_str(entries: List({Str, Toml})) -> Str =
    let start: List(Str) = [];
    let parts =
        List/fold(entries, start, (entry, parts) =>
            [..parts, Fmt/render("% = %")(spell_key(entry.0))(value_str(entry.1))]);
    Str/join(", ", parts);

let encode_table(prefix: List(Str), m: Map(Str, Toml)) -> Str =
    let entries = Map/to_list(m);
    let start: List(Str) = [];
    let value_lines =
        List/fold(entries, start, (entry, lines) =>
            match entry.1
            | table(_) => lines
            | _ => [..lines, Fmt/render("% = %\n")(spell_key(entry.0))(value_str(entry.1))]
            end);
    let table_blocks =
        List/fold(entries, start, (entry, blocks) =>
            match entry.1
            | table(sub) =>
                let k = spell_key(entry.0);
                [
                    ..blocks,
                    Fmt/render("[%]\n%")(
                        Str/join(".", [..prefix, k]))(
                        encode_table([..prefix, k], sub))]
            | _ => blocks
            end);
    Str/concat(Str/flatten(value_lines), Str/flatten(table_blocks));

--- `m` as one deterministic document: the root's plain values first, then its tables. Every table has a spelling, so nothing is refused.
pub let encode(m: Map(Str, Toml)) -> Str =
    encode_table([], m);
