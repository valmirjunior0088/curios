use /std/{Bool, Flt, Str, List};

--- A JSON value.
pub induct Json: pub Type
| null()
--- `true` or `false`.
| bool(Bool)
--- A number, which is finite: JSON spells no infinity and no NaN, so a float that is one has no `num`. A literal's proof discharges by reduction, and `Flt/finite` answers a computed float's.
| num(value: Flt, @finite: Flt/Finite(value))
--- A string.
| str(Str)
--- An array, in order.
| arr(List(Json))
--- An object: its members, in the order they were written.
| obj(List({Str, Json}))
end

pub use Json/*;

mod encode;
pub use encode/{encode};

mod decode;
pub use decode/{decode};
