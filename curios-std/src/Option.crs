pub use /sys/{Option};
pub use /sys/Option/{some, none};
use /std/{Bool, Eq, Show, Spell, Str, Monad, Result, Ordering, Ord};
use /std/Bool/{True, False};
use /std/ops/{Eql, Cmp};

--- `f` on the value, or `none`.
pub let bind(@A: Sort, @B: Sort, m: Option(A), f: (A) -> Option(B)) -> Option(B) =
    match m | some(a) => f(a) | none() => Option/none() end;

--- `f` on the value, kept as an option.
pub let map(@A: Sort, @B: Sort, m: Option(A), f: (A) -> B) -> Option(B) =
    match m | some(a) => Option/some(f(a)) | none() => Option/none() end;

--- The value, or `default` when there is none.
pub let unwrap_or(@A: Sort, m: Option(A), default: A) -> A =
    match m | some(a) => a | none() => default end;

--- Whether a value is present.
pub let is_some(@A: Sort, m: Option(A)) -> Bool =
    match m | some(_) => true | none() => false end;

--- Whether no value is present.
pub let is_none(@A: Sort, m: Option(A)) -> Bool =
    match m | some(_) => false | none() => true end;

--- `m` when it holds a value, `other` otherwise.
pub let or(@A: Sort, m: Option(A), other: Option(A)) -> Option(A) =
    match m | some(a) => Option/some(a) | none() => other end;

--- `m` when it holds a value, otherwise what `other` answers.
pub let or_else(@A: Sort, m: Option(A), other: () -> Option(A)) -> Option(A) =
    match m | some(a) => Option/some(a) | none() => other() end;

--- The value when `pred` accepts it, `none` otherwise or when there is none.
pub let filter(@A: Sort, m: Option(A), pred: (A) -> Bool) -> Option(A) =
    match m
    | some(a) => match pred(a) | true => Option/some(a) | false => Option/none() end
    | none() => Option/none()
    end;

--- An option of an option collapsed to one.
pub let flatten(@A: Sort, m: Option(Option(A))) -> Option(A) =
    match m | some(inner) => inner | none() => Option/none() end;

--- The value as a success, or `e` as the failure.
pub let to_result(@A: Type, @E: Type, m: Option(A), e: E) -> Result(E, A) =
    match m | some(a) => Result/success(a) | none() => Result/failure(e) end;

--- The value, or what `default` answers when there is none.
pub let unwrap_or_else(@A: Sort, m: Option(A), default: () -> A) -> A =
    match m | some(a) => a | none() => default() end;

--- Whether `m` holds a value, as a decided proposition: `True` at `some` and `False` at `none`.
---
--- A literal discharges it by reduction, and an option a guard has refined discharges it with nothing written.
pub let IsSome(@A: Sort, m: Option(A)) -> Prop =
    match m | some(_) => True | none() => False end;

--- The value, under the evidence that there is one.
pub let get(@A: Sort, m: Option(A), @ok: IsSome(m)) -> A =
    match m
    | some(a) => a
    | none() => match ok end
    end;

-- What an equation between two options says of what they hold: at two values, that they are one.
let SameValue(@A: Sort, a: Option(A), b: Option(A)) -> Prop =
    match a
    | some(x) => match b | some(y) => Eq()(x, y) | none() => True end
    | none() => True
    end;

let same_value_refl(@A: Sort, m: Option(A)) -> SameValue(m, m) =
    match m: (z) => SameValue(z, z) | some(_) => Eq/refl() | none() => True/qed() end;

--- `some` is injective: two equal options that each hold a value hold one value.
---
--- What takes an encoding apart with no value invented. A reader that answers an option is one function of every input, so `Eq/cong` carries an equation between two encodings to one between what it reads from each, and this carries that to the values read.
pub let some_injective(
    @A: Sort,
    @x: A,
    @y: A,
    same: Eq()(Option/some(x), Option/some(y)),
) -> Eq()(x, y) =
    match same: (s, t, _) => SameValue(s, t) | refl(@value) => same_value_refl(value) end;

satisfy (@A: Type, use Eql(A)) => Eql(Option(A)) {
    ..
}

satisfy (@A: Type, use Show(A)) => Show(Option(A)) {
    show(m) =
        match m
        | some(x) => Str/concat("some(", Str/concat(Show/show(x), ")"))
        | none() => "none()"
        end,
}

satisfy (@A: Type, use Spell(A)) => Spell(Option(A)) {
    ..
}

satisfy Monad(Option) {
    pure = some,
    bind = bind,
}

--- `none` below `some`, and two values by `A`'s order.
pub let ord(@A: Type, use Ord(A), a: Option(A), b: Option(A)) -> Ordering =
    match a
    | none() => match b | none() => Ordering/eq() | some(_) => Ordering/lt() end
    | some(x) => match b | none() => Ordering/gt() | some(y) => Ord/ord(x, y) end
    end;

satisfy (@A: Type, use Ord(A)) => Cmp(Option(A)) {
    lt(a, b) = Ordering/is_lt(ord(a, b)),
    le(a, b) = Ordering/is_le(ord(a, b)),
    gt(a, b) = Ordering/is_gt(ord(a, b)),
    ge(a, b) = Ordering/is_ge(ord(a, b)),
}

satisfy (@A: Type, use Ord(A)) => Ord(Option(A)) {
    ord = ord,
}
