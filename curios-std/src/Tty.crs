use /std/{Nat, Bool, Str, Try, Async, Io, Handle, Show};
use /std/ops/{Eql};

--- A terminal this process holds a handle on.
pub struct Tty: Type {
    Handle,
}

--- The terminal behind standard input.
pub let stdin: Tty =
    Tty { Handle/stdin };

--- The terminal's size in cells.
pub struct Size: pub Type {
    cols: Nat,
    rows: Nat,
}

satisfy Eql(Size) {
    ..
}

satisfy Show(Size) {
    show(s) = Str/flatten([Nat/to_str(s.cols), "x", Nat/to_str(s.rows)]),
}

--- Put this terminal in raw mode, or restore it: `ok`, or the status of the failure.
foreign tty_raw: (Handle, Bool) -> Nat;

--- This terminal's dimensions: `ok` beside its columns and its rows, or the status of the failure.
foreign tty_size: (Handle) -> {status: Nat, cols: Nat, rows: Nat};

--- Raw mode on `t`, or off.
pub let raw(t: Tty, on: Bool) -> Try(Io, Io/Error, {}) =
    let status = tty_raw(t.0, on)!;
    match status == /sys/status/ok
    | true => Try/pure(())
    | false => Try/raise(Io/Error/of(status))
    end;

--- The terminal's size now.
pub let size(t: Tty) -> Try(Io, Io/Error, Size) =
    let reply = tty_size(t.0)!;
    match reply.status == /sys/status/ok
    | true => Try/pure(Size { cols = reply.cols, rows = reply.rows })
    | false => Try/raise(Io/Error/of(reply.status))
    end;

let restore(t: Tty) -> Io({}) =
    Io/bind(tty_raw(t.0, false), (_) => Io/pure(()));

--- Raw mode on `t` around `body`, restored whichever way the body ends.
pub let with_raw(@A: Type, t: Tty, body: Try(Io, Io/Error, A)) -> Try(Io, Io/Error, A) =
    let _ = raw(t, true)!;
    let a =
        Try/rescue(body, (e) =>
            let _ = restore(t)!;
            Try/raise(e))!;
    let _ = restore(t)!;
    Try/pure(a);

--- The same bracket inside a fiber, registered with the scheduler, so a cancelled task restores the mode.
pub let with_raw_async(@A: Type, t: Tty, body: Try(Async, Io/Error, A)) -> Try(Async, Io/Error, A) =
    let _ = raw(t, true)!;
    let outcome = Async/using(restore(t), Try/run(body))!;
    let a = outcome!;
    Try/pure(a);
