use /std/{Nat, Bool, Str, Try, Io, Show};
use /std/ops/{Eql};
use /std/internal/{Handle, error};

--- A terminal this process holds a handle on.
pub struct Tty: Type {
    Handle,
}

--- The terminal behind standard input.
pub let stdin: Tty =
    Tty { Handle/stdin };

--- The terminal's size in cells.
pub struct Size: pub Type {
    cols: Nat,
    rows: Nat,
}

satisfy Eql(Size) {
    ..
}

satisfy Show(Size) {
    show(s) = Str/flatten([Nat/to_str(s.cols), "x", Nat/to_str(s.rows)]),
}

--- Put this terminal in raw mode, or restore it: `ok`, or the status of the failure.
foreign tty_raw(Handle, Bool) -> Nat;

let switch(t: Tty, on: Bool) -> Try(Io, Io/Error, {}) =
    let status = tty_raw(t.0, on)!;
    match status == /sys/status/ok | true => Try/pure(()) | false => Try/raise(error(status)) end;

--- This terminal's dimensions: `ok` beside its columns and its rows, or the status of the failure.
foreign tty_size(Handle) -> {status: Nat, cols: Nat, rows: Nat};

--- The terminal's size now.
pub let size(t: Tty) -> Try(Io, Io/Error, Size) =
    let reply = tty_size(t.0)!;
    match reply.status == /sys/status/ok
    | true => Try/pure(Size { cols = reply.cols, rows = reply.rows })
    | false => Try/raise(error(reply.status))
    end;

let restore(t: Tty) -> Io({}) =
    Io/bind(tty_raw(t.0, false), (_) => Io/pure(()));

--- Raw mode on `t` for the rest of `s`, which restores it when it ends, however it ends.
pub let raw(s: Io/Scope, t: Tty) -> Try(Io, Io/Error, {}) =
    let _ = switch(t, true)!;
    Io/Scope/defer(s, (_) => restore(t));
