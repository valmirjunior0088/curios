use /std/{Nat, Str, Bytes, Try, Io};
use /std/internal/{Handle, error};

--- The terminal's size in cells.
pub mod Size;
pub use Size/{let Size};

--- The terminal this process's session has: one device, read for its keys and written for its screen.
pub struct Tty: Type {
    Handle,
}

--- The controlling terminal, opened to read and write into `s`, which closes it when it ends: the terminal whatever the standard streams are, so a program reading data from standard input and writing its answer to standard output still meets its user. A process outside any session has none, and is refused.
pub let open(s: Io/Scope) -> Try(Io, Io/Error, Tty) =
    let h = Handle/open(Str/to_bytes("/dev/tty"), /sys/open_mode/read_write)!;
    let t = Tty { h };
    let _ = Io/Scope/defer(s, (_) => Io/close(t))!;
    Try/pure(t);

--- Close `t` before its scope ends. The scope's own close then finds nothing to close.
satisfy Io/Close(Tty) {
    close(t) = Io/close(t.0),
}

satisfy Io/Read(Tty) {
    read(t, n, @positive) = Io/read(@Handle, t.0, n, @positive),
}

satisfy Io/Write(Tty) {
    write(t, b) = Io/write(t.0, b),
    flush(t) = Io/flush(t.0),
}

--- Take this terminal with the bytes that undo what the program will set on it, and put it in raw mode: `ok`, or the status of the failure.
foreign tty_take(Handle, Bytes) -> Nat;

--- Give this terminal back, its leave bytes written and its settings restored: `ok`, or the status of the failure.
foreign tty_give(Handle) -> Nat;

let given(status: Nat) -> Try(Io, Io/Error, {}) =
    match status == /sys/status/ok | true => Try/pure(()) | false => Try/raise(error(status)) end;

let give_back(t: Tty) -> Io({}) =
    Io/bind(tty_give(t.0), (_) => Io/pure(()));

--- Raw mode on `t` for the rest of `s`, with `leave` the bytes that undo what the program sets on the terminal meanwhile: when `s` ends, however it ends, `leave` is written and the settings `t` had are restored. The host holds both, so a trap, an exit or a terminating signal undoes the terminal too, where no release of `s` runs.
pub let raw(s: Io/Scope, t: Tty, leave: Bytes) -> Try(Io, Io/Error, {}) =
    let status = tty_take(t.0, leave)!;
    let _ = given(status)!;
    Io/Scope/defer(s, (_) => give_back(t));

--- This terminal's dimensions: `ok` beside its columns and its rows, or the status of the failure.
foreign tty_size(Handle) -> {status: Nat, cols: Nat, rows: Nat};

--- The terminal's size now.
pub let size(t: Tty) -> Try(Io, Io/Error, Size) =
    let reply = tty_size(t.0)!;
    match reply.status == /sys/status/ok
    | true => Try/pure(Size { cols = reply.cols, rows = reply.rows })
    | false => Try/raise(error(reply.status))
    end;
