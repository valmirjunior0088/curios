use /std/{Nat, Bool, Eq, Ordering, Ord, proved};

--- The order of the two.
pub let ord(x: Nat, y: Nat) -> Ordering =
    choose | x < y => Ordering/lt() | x == y => Ordering/eq() | _ => Ordering/gt() end;

-- Of two naturals that differ, the one that is at most the other is below it.
let below(
    a: Nat,
    b: Nat,
    le: Bool/Holds(b <= a),
    ne: Bool/Holds(Bool/not(a == b)),
) -> Bool/Holds(b < a) =
    match b < a
    | true => Bool/True/qed()
    | false =>
        let same: Eq()(a, b) = Nat/le/antisym(a, b, proved(), le);
        match Eq/subst((x: Nat) => Bool/Holds(Bool/not(a == x)), Eq/sym(same), ne) end
    end;

--- A number is `eq` to itself.
pub let refl(a: Nat) -> Eq()(ord(a, a), Ordering/eq()) =
    Eq/refl();

--- `a < b` gives `ord(a, b)` as `lt`.
pub let of_lt(a: Nat, b: Nat, p: Bool/Holds(a < b)) -> Eq()(ord(a, b), Ordering/lt()) =
    match a < b
    | true => Eq/refl()
    | false => match proved(@Bool/False) end
    end;

--- An equation gives `ord(a, b)` as `eq`.
pub let of_eq(a: Nat, b: Nat, e: Eq()(a, b)) -> Eq()(ord(a, b), Ordering/eq()) =
    Eq/subst((x: Nat) => Eq()(ord(a, x), Ordering/eq()), e, refl(a));

--- `b < a` gives `ord(a, b)` as `gt`.
pub let of_gt(a: Nat, b: Nat, p: Bool/Holds(b < a)) -> Eq()(ord(a, b), Ordering/gt()) =
    match a < b
    | true => match proved(@Bool/False) end
    | false =>
        match a == b
        | true => match proved(@Bool/False) end
        | false => Eq/refl()
        end
    end;

--- `ord(a, b)` is `lt` only where `a < b`.
pub let lt(a: Nat, b: Nat, h: Eq()(ord(a, b), Ordering/lt())) -> Bool/Holds(a < b) =
    match a < b
    | true => Bool/True/qed()
    | false =>
        match a == b
        | true => match Ordering/eq_neq_lt(h) end
        | false => match Ordering/gt_neq_lt(h) end
        end
    end;

--- `ord(a, b)` is `eq` only where `a` is `b`: the order agrees with equality.
pub let eq(a: Nat, b: Nat, h: Eq()(ord(a, b), Ordering/eq())) -> Eq()(a, b) =
    match a < b
    | true => match Ordering/eq_neq_lt(Eq/sym(h)) end
    | false =>
        match a == b
        | true => Nat/eq_of_eql(a, b, Bool/True/qed())
        | false => match Ordering/gt_neq_eq(h) end
        end
    end;

--- `ord(a, b)` is `gt` only where `b < a`.
pub let gt(a: Nat, b: Nat, h: Eq()(ord(a, b), Ordering/gt())) -> Bool/Holds(b < a) =
    match a < b
    | true => match Ordering/gt_neq_lt(Eq/sym(h)) end
    | false =>
        match a == b
        | true => match Ordering/gt_neq_eq(Eq/sym(h)) end
        | false => below(a, b, proved(), Bool/True/qed())
        end
    end;

--- `ord(a, b)` is not `gt` only where `a <= b`.
pub let le(a: Nat, b: Nat, h: Bool/Holds(Ordering/is_le(ord(a, b)))) -> Bool/Holds(a <= b) =
    match a < b
    | true => proved()
    | false =>
        match a == b
        | true => Nat/le/of_eq(Nat/eq_of_eql(a, b, Bool/True/qed()))
        | false => match h end
        end
    end;

--- `a <= b` gives `ord(a, b)` as `lt` or `eq`.
pub let of_le(a: Nat, b: Nat, p: Bool/Holds(a <= b)) -> Bool/Holds(Ordering/is_le(ord(a, b))) =
    match a < b
    | true => Bool/True/qed()
    | false =>
        match a == b
        | true => Bool/True/qed()
        | false =>
            let strict: Bool/Holds(b < a) = below(a, b, proved(), Bool/True/qed());
            match proved(@Bool/False) end
        end
    end;

--- `ord` answers the flipped answer with its operands swapped.
---
--- By the two guards `ord` reads, taken on each side. The arms no two numbers reach are refuted from the guards, and the two a failed `==` leaves are closed by the equation the other guards give, carried into the comparison that failed.
pub let flips: Ord/Flips(ord) =
    (a, b) =>
        match a < b
        | true =>
            match b < a
            | true => match proved(@Bool/False) end
            | false =>
                match b == a
                | true => match proved(@Bool/False) end
                | false => Eq/refl()
                end
            end
        | false =>
            match a == b
            | true =>
                match b < a
                | true => match proved(@Bool/False) end
                | false =>
                    match b == a
                    | true => Eq/refl()
                    | false =>
                        let same = Nat/eq_of_eql(a, b, proved());
                        let held: Bool/Holds(b == a) =
                            Eq/subst((x: Nat) => Bool/Holds(b == x), Eq/sym(same), Bool/True/qed());
                        match held end
                    end
                end
            | false =>
                match b < a
                | true => Eq/refl()
                | false =>
                    let same = Nat/le/antisym(a, b, proved(), proved());
                    let held: Bool/Holds(a == b) =
                        Eq/subst((x: Nat) => Bool/Holds(a == x), same, Bool/True/qed());
                    match held end
                end
            end
        end;

--- `ord` as a relation carries across a middle element.
pub let transitive: Ord/Transitive(Ord/le(ord)) =
    (a, b, c, p, q) => of_le(a, c, Nat/le/trans(le(a, b, p), le(b, c, q)));
