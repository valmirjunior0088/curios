pub use /sys/Nat/{min};
use /std/{Nat, Eq};
use /std/Bool/{Holds};

--- `min(a, b)` is `a` where `a <= b`.
---
--- Conversion decides it where it decides the comparison of the two operands as terms, and reads no hypothesis: this is the step a proof takes under one. With `b` read as `a + (b - a)`, which [`Nat/le/add_sub_cancel`] states under `p`, the greater operand is dropped.
pub let of_le(a: Nat, b: Nat, p: Holds(a <= b)) -> Eq()(min(a, b), a) =
    Eq/sym(Eq/cong((x) => min(a, x), Nat/le/add_sub_cancel(a, b, p)));

--- `min(a, b)` is `b` where `b <= a`.
pub let of_ge(a: Nat, b: Nat, p: Holds(b <= a)) -> Eq()(min(a, b), b) =
    Eq/sym(Eq/cong((x) => min(x, b), Nat/le/add_sub_cancel(b, a, p)));
