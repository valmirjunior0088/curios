use /std/{Nat};
use /std/Bool/{True, False, Holds};

-- Nothing lies below a measure that a bound of zero holds.
let none_below(m: Nat, k: Nat, below: Holds(m < k), within: Holds(k <= 0)) -> False =
    False/refuted();

--- Induction over a measure: the step may assume `P` at every state whose measure is below `s`'s.
---
--- The recursion is structural, on a number the measure fits under, so it is total as it stands. The step never meets the bound: it is handed a hypothesis that holds at any state below, given the proof that it lies below, which the arithmetic in scope usually writes. Over the identity it is course-of-values induction on `Nat`. `Nat/recurse` is the same recursion where `P` is a family of data.
pub let descend(
    @S: Type,
    measure: (S) -> Nat,
    P: (S) -> Prop,
    step: (s: S, ih: (t: S, r: Holds(measure(t) < measure(s))) -> P(t)) -> P(s),
    s: S,
) -> P(s) =
    let go(k: Nat, s: S, within: Holds(measure(s) <= k)) -> P(s) =
        match k
        | 0 => step(s, (t, r) => match none_below(measure(t), measure(s), r, within) end)
        | kp + 1 => step(s, (t, r) => go(kp, t, True/proved()))
        end;
    go(measure(s), s, Nat/le/refl(measure(s)));
