use /std/{Nat};
use /std/Bool/{True, False, Holds};

-- Nothing lies below a measure that a bound of zero holds.
let none_below(m: Nat, k: Nat, below: Holds(m < k), within: Holds(k <= 0)) -> False =
    False/refuted();

--- The fixpoint over a measure: the step may assume `P` at every state whose measure is below `s`'s.
---
--- The recursion is structural, on a number the measure fits under, so it is total as it stands and computes wherever a value is demanded, in a type as at runtime. The step never meets the bound: it is handed a hypothesis that recurs at any state below, with the proof that it lies below, which the arithmetic in scope usually writes. Over the identity it is course-of-values recursion on `Nat`.
---
--- The loop is local to a wrapper that does not recurse, so inlining the wrapper at a call fuses `step` into the loop. A `descend` that passed `step` to itself would keep an indirect call at every level, and run out of stack sooner.
pub let descend(
    @S: Type,
    measure: (S) -> Nat,
    P: (S) -> Type,
    step: (s: S, ih: (t: S, r: Holds(measure(t) < measure(s))) -> P(t)) -> P(s),
    s: S,
) -> P(s) =
    let go(k: Nat, s: S, within: Holds(measure(s) <= k)) -> P(s) =
        match k
        | 0 => step(s, (t, r) => match none_below(measure(t), measure(s), r, within) end)
        | kp + 1 => step(s, (t, r) => go(kp, t, True/proved()))
        end;
    go(measure(s), s, Nat/le/refl(measure(s)));
