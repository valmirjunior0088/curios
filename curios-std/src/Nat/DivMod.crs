use /std/{Nat, Eq};
use /std/Bool/{True, Holds};

--- `n` divided by `d`: the quotient and remainder, with Euclid's identity and the remainder's bound beside them.
pub struct DivMod(n: Nat, d: Nat): pub Type {
    --- How many whole `d`s `n` holds.
    quotient: Nat,
    --- What is left over.
    remainder: Nat,
    --- `n` is the quotient's multiple of `d` and the remainder.
    joined: Eq()(n, quotient * d + remainder),
    --- The remainder is below `d`.
    bounded: Holds(remainder < d),
}

--- Division with remainder, certified: the quotient and remainder `/` and `%` compute, with their equation and bound.
---
--- Both proofs are the reducer's own: Euclid's identity recombines the quotient and remainder into `n`, and a remainder sits below its divisor by definition.
pub let of(n: Nat, d: Nat, @ok: Holds(0 < d)) -> DivMod(n, d) =
    DivMod { quotient = n / d, remainder = n % d, joined = Eq/refl(), bounded = True/qed() };

--- `m * d <= n` gives `m <= n / d`: the quotient is the largest multiplier that fits.
---
--- A quotient below `m` would put `n` under `(n / d + 1) * d`, which the quotient's own bound puts above `n` — a product of the negated bound with `0 <= d`, which the elaborator proves from the facts in scope.
pub let le_div_of_mul_le(
    m: Nat,
    n: Nat,
    d: Nat,
    @ok: Holds(0 < d),
    p: Holds(m * d <= n),
) -> Holds(m <= n / d) =
    True/proved();

--- `n < m * d` gives `n / d < m`: a quotient of at least `m` would scale past `n`, since the quotient's multiple of `d` is at most `n` — a product the elaborator proves from the facts in scope.
pub let div_lt_of_lt_mul(
    m: Nat,
    n: Nat,
    d: Nat,
    @ok: Holds(0 < d),
    p: Holds(n < m * d),
) -> Holds(n / d < m) =
    True/proved();

--- A quotient and a remainder are the ones `/` and `%` compute: a `q` and an `r` with `n = q * d + r` and `r < d` are `n / d` and `n % d`.
---
--- What a Euclidean argument ends in: a multiple's quotient is its multiplier, and its remainder zero. The quotient is pinned from both sides by its own bounds, each a product the elaborator proves from the facts in scope, and the remainder is what Euclid's identity leaves once the two quotients are one.
pub let unique(
    n: Nat,
    d: Nat,
    q: Nat,
    r: Nat,
    @ok: Holds(0 < d),
    joined: Eq()(n, q * d + r),
    bounded: Holds(r < d),
) -> {quotient: Eq()(q, n / d), remainder: Eq()(r, n % d)} =
    let quotient: Eq()(q, n / d) = Nat/le/antisym(q, n / d, True/proved(), True/proved());
    let euclid: Eq()(n, n / d * d + n % d) = Eq/refl();
    let rejoined: Eq()(n, q * d + n % d) =
        Eq/subst((x: Nat) => Eq()(n, x * d + n % d), Eq/sym(quotient), euclid);
    (
        quotient = quotient,
        remainder = Eq/cong((x: Nat) => x - q * d, Eq/trans(Eq/sym(joined), rejoined)));
