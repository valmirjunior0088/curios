mod tests;

-- How UTF-8 reads bytes: what a byte begins, how far through a character a walk has come, and the ranges a character in flight can still end in.
mod utf8;
pub use utf8/{classify, step, scan_from, count_scalars};
use utf8/{pending, concluded, advanced, begins_scalars_of};

--- That bytes are well-formed UTF-8, which is what `Str` carries: what that rests on, from any scan state, and what the operations carry it through.
pub mod Valid;
pub use Valid/{let Valid};

--- A position in text: a byte offset at which a character may begin, typed by the text it belongs to.
---
--- Deciding one reads a single byte; that such an offset is where valid text divides into valid text is `Valid/before` and `Valid/after`.
pub mod At;
pub use At/{let At};

-- The walks a search makes: a character a predicate accepts, a piece held at a position forward or back, and a needle's first occurrence.
mod search;
use search/{seek, meets, meets_back, occurrence, first_occurrence, back_over};

--- How many characters, not bytes, with how a concatenation's count is its halves'.
pub mod len;
pub use len/{let len};

--- The order of two texts, by code point, and its laws.
pub mod ord;
pub use ord/{let ord};

use /std/{Char, Nat, Byte, Bytes, Bool, List, Option, Result, Eq, Show, Spell, Ordering, Ord,
    proved};
use /std/ops/{Eql, Cmp};

--- What a byte begins, as UTF-8 reads it.
pub induct Class: pub Type
--- A character of one byte.
| ascii()
--- The first of a character whose remaining `count` bytes must each lie between `lo` and `hi`.
| lead(count: Nat, lo: Nat, hi: Nat, payload: Nat)
--- A byte no character may begin with.
| bad()
end

--- How far through a character a walk over bytes has come.
pub induct Scan: pub Type
--- Between characters, where a new one may begin.
| lead()
--- Inside a character, with `remaining` bytes still owed, each between `lo` and `hi`.
| cont(remaining: Nat, lo: Nat, hi: Nat)
--- Past a byte the encoding does not admit, which nothing recovers from.
| bad()
end

--- Text: bytes certified as UTF-8.
pub struct Str: pub Type {
    --- The bytes themselves.
    bytes: Bytes,
    --- Why they are well-formed UTF-8.
    @valid: Valid(bytes),
}

--- The UTF-8 bytes.
pub let to_bytes(s: Str) -> Bytes =
    s.bytes;

--- How many bytes of what a scan has read are text once it has read `rest` from `sc`: `last`, where it last stood between characters, when it meets a byte the encoding does not admit or ends inside a character. `read` is how many bytes lie before `rest`.
---
--- Each byte is put to `scan_from` by itself rather than to `step`: only bytes that are not text are read here, and a second caller of `step` would keep it from being folded into the scan every `of_bytes` runs.
let text_before(sc: Scan, rest: Bytes, read: Nat, last: Nat) -> Nat =
    match rest
    | x[] => last
    | x[h, ..t] =>
        match scan_from(sc, x[h])
        | lead() => text_before(Scan/lead(), t, read + 1, read + 1)
        | cont(rem, lo, hi) => text_before(Scan/cont(rem, lo, hi), t, read + 1, last)
        | bad() => last
        end
    end;

--- The text the bytes encode, or where they stop being text: the length of their longest prefix that is well-formed UTF-8, which is where the first character that is not begins.
pub let of_bytes(b: Bytes) -> Result(Nat, Str) =
    match Valid/try(Scan/lead(), b)
    | some(v) => Result/success(Str { bytes = b })
    | none() => Result/failure(text_before(Scan/lead(), b, 0, 0))
    end;

--- The one-character string.
pub let of_char(c: Char) -> Str =
    Str { bytes = Char/to_utf8(c), @valid = Valid/encoded(c) };

--- Equal bytes are equal strings.
pub let eq_of_bytes(a: Str, b: Str, p: Eq()(a.bytes, b.bytes)) -> Eq()(a, b) =
    Eq/subst(
        (bytes: Bytes) => (valid: Valid(bytes)) -> Eq()(a, Str { bytes = bytes }),
        p,
        (_: Valid(a.bytes)) => Eq/refl())(
        b.valid);

--- `a` then `b`.
pub let concat(a: Str, b: Str) -> Str =
    Str { bytes = x[..a.bytes, ..b.bytes], @valid = Valid/concat(a.valid, b.valid) };

--- The text before `at`, cut in O(1).
pub let before(s: Str, at: At(s)) -> Str =
    Str {
        bytes = Bytes/slice(s.bytes, 0, at.offset, @at.within),
        @valid = Valid/before(s.valid, at.offset, at.within, at.boundary) };

--- The text from `at` on, cut in O(1).
pub let after(s: Str, at: At(s)) -> Str =
    Str {
        bytes = Bytes/drop(s.bytes, at.offset, @at.within),
        @valid = Valid/after(s.valid, at.offset, at.within, at.boundary) };

--- The text from `from` to `to`, cut in O(1): what lies before `to` in the text after `from`.
pub let between(
    s: Str,
    from: At(s),
    to: At(s),
    @ordered: Bool/Holds(from.offset <= to.offset),
) -> Str =
    before(after(s, from), At/to_after(s, from, to, @ordered));

--- `s` as its extended grapheme clusters, in order: what a reader sees as its characters, each a letter with its marks, an emoji sequence or a flag as one, by the boundaries of [`At/next_grapheme`].
pub let graphemes(s: Str) -> List(Str) =
    At/forward(
        (_: At(s)) => List(Str),
        (p, again) =>
            match At/try_next_grapheme(s, p)
            | none() => []
            | some(cluster) =>
                [between(s, p, cluster.past), ..again(cluster.past, cluster.progress)]
            end,
        At/start(s));

--- The concatenation, in order.
pub let flatten(parts: List(Str)) -> Str =
    List/fold(parts, "", (p, acc) => concat(acc, p));

--- Whether the two are equal.
pub let eql(a: Str, b: Str) -> Bool =
    to_bytes(a) == to_bytes(b);

let lower_ascii_byte(byte: Byte) -> Byte =
    let n = Byte/to_nat(byte);
    match Nat/in_range(n, 'A', 'Z') | true => Nat/to_byte((n + 0x20) % 0x80) | false => byte end;

let lower_ascii_bytes(b: Bytes) -> Bytes =
    Bytes/fold(b, x[], (byte, acc) => x[..acc, lower_ascii_byte(byte)]);

--- Equality with ASCII letters compared regardless of case; every other character exactly.
pub let eql_ignoring_ascii_case(a: Str, b: Str) -> Bool =
    lower_ascii_bytes(to_bytes(a)) == lower_ascii_bytes(to_bytes(b));

--- `s` written `n` times.
---
--- Half the copies are built once and joined to themselves, with `s` once more where `n` is odd, so `n` copies take a number of joins logarithmic in `n` and hold each half once.
pub let repeat(s: Str, n: Nat) -> Str =
    match n < 2
    | true => match n | 0 => "" | _ => s end
    | false =>
        let half = repeat(s, n / 2);
        let doubled = concat(half, half);
        match n % 2 | 0 => doubled | _ => concat(doubled, s) end
    end;

--- Whether a scan state can only finish its character at a scalar value, `partial` being the bits gathered so far: `pending` inside a character, and nothing owed between them.
let pending_at(sc: Scan, partial: Nat) -> Bool =
    match sc | cont(rem, lo, hi) => pending(rem, lo, hi, partial) | _ => true end;

--- Left to right over the characters with `f(char, acc)`.
---
--- The walk carries the string's validity from the state it has reached and, beside the bits of the character in flight, the proof that it can only end at a scalar value. So every character it hands `f` is built with its proof, and a byte the encoding does not admit is a contradiction rather than an arm. Both proofs erase, and the accumulator is what it was.
pub let fold(@A: Type, s: Str, init: A, f: (Char, A) -> A) -> A =
    let go(
        sc: Scan,
        b: Bytes,
        v: Valid/from(sc, b),
        acc: {A, Nat},
        p: Bool/Holds(pending_at(sc, acc.1)),
    ) -> {A, Nat} =
        match b
        | x[] => acc
        | x[h, ..t] =>
            match sc
            | lead() =>
                match classify(h)
                | ascii() =>
                    go(
                        Scan/lead(),
                        t,
                        v,
                        (f(Char { code = Byte/to_nat(h) }, acc.0), 0),
                        Bool/True/qed())
                | lead(rem, lo, hi, partial) =>
                    go(Scan/cont(rem, lo, hi), t, v, (acc.0, partial), begins_scalars_of(h))
                | bad() => match Valid/from_bad(@t, v) end
                end
            | cont(rem, lo, hi) =>
                let partial = acc.1 * 0x40 + (Byte/to_nat(h) - 0x80);
                match Nat/in_range(Byte/to_nat(h), lo, hi)
                | false => match Valid/from_bad(@t, v) end
                | true =>
                    match rem == 1
                    | true =>
                        let last =
                            Eq/subst(
                                (r: Nat) => Bool/Holds(pending(r, lo, hi, acc.1)),
                                Nat/eq_of_eql(rem, 1, Bool/True/qed()),
                                p);
                        go(
                            Scan/lead(),
                            t,
                            v,
                            (
                                f(
                                    Char {
                                        code = partial,
                                        @valid =
                                            concluded(
                                                lo,
                                                hi,
                                                acc.1,
                                                Byte/to_nat(h),
                                                last,
                                                Bool/True/qed()) },
                                    acc.0),
                                0),
                            Bool/True/qed())
                    | false =>
                        go(
                            Scan/cont(rem - 1, 0x80, 0xBF),
                            t,
                            v,
                            (acc.0, partial),
                            advanced(
                                rem,
                                lo,
                                hi,
                                acc.1,
                                Byte/to_nat(h),
                                p,
                                Bool/True/qed(),
                                Bool/True/qed()))
                    end
                end
            | bad() => match Valid/from_bad(@x[h, ..t], v) end
            end
        end;
    go(Scan/lead(), s.bytes, s.valid, (init, 0), Bool/True/qed()).0;

--- The characters.
pub let to_list(s: Str) -> List(Char) =
    fold(s, [], (c, acc) => [..acc, c]);

--- `count_scalars` splits at the seam of a concatenation whose first half reads to the end, from whatever state the reading starts in — the strengthening `len/concat` needs to descend a byte, where the state has moved.
let count_concat(
    a: Bytes,
    b: Bytes,
    @s: Scan,
    w: Valid/from(s, a),
) -> Eq()(count_scalars(s, x[..a, ..b]), count_scalars(s, a) + count_scalars(Scan/lead(), b)) =
    match a
    | x[] =>
        match s
        | lead() => Eq/refl()
        | cont(_, _, _) => match w end
        | bad() => match w end
        end
    | x[h, ..t] =>
        match s
        | lead() => Eq/cong((n: Nat) => n + 1, count_concat(t, b, @step(h, Scan/lead()), w))
        | cont(_, _, _) => count_concat(t, b, @step(h, s), w)
        | bad() => count_concat(t, b, @step(h, Scan/bad()), w)
        end
    end;

--- Whether there are no characters.
pub let is_empty(s: Str) -> Bool =
    Bytes/len(to_bytes(s)) == 0;

--- Where the first character `pred` accepts is, or `none`.
pub let find_index(s: Str, pred: (Char) -> Bool) -> Option(At(s)) =
    Option/map(seek(s, At/start(s), pred), (found) => found.at);

--- Where the first `target` is, or `none`.
pub let index_of(s: Str, target: Char) -> Option(At(s)) =
    find_index(s, (c) => c == target);

--- The first character `pred` accepts, or `none`.
pub let find(s: Str, pred: (Char) -> Bool) -> Option(Char) =
    Option/map(seek(s, At/start(s), pred), (found) => found.char);

--- Whether `target` occurs in `s`.
pub let contains(s: Str, target: Char) -> Bool =
    Option/is_some(index_of(s, target));

--- `parts` with `sep` between each pair.
pub let join(sep: Str, parts: List(Str)) -> Str =
    List/balanced(
        List/len(parts),
        "",
        (i, ok) => List/get(@Str, parts, i, @ok),
        (l, r) => concat(concat(l, sep), r));

--- Where `piece` follows `from` in `s`: the position past it, which is not before `from`, or `none` when `s` does not hold it there.
pub let follows(
    s: Str,
    from: At(s),
    piece: Str,
) -> Option({past: At(s), reach: Bool/Holds(from.offset <= past.offset)}) =
    meets(s, from, piece, At/start(piece));

--- The position past the longest run of characters from `from` that `pred` accepts, which is not before `from`: one walk forward, which stops at the first character refused or at the end.
pub let span(
    s: Str,
    from: At(s),
    pred: (Char) -> Bool,
) -> {past: At(s), reach: Bool/Holds(from.offset <= past.offset)} =
    At/forward(
        (at) =>
            (reached: Bool/Holds(from.offset <= at.offset)) -> {
                past: At(s),
                reach: Bool/Holds(from.offset <= past.offset)},
        (at, again) =>
            (reached) =>
                match At/try_next(s, at)
                | some(n) =>
                    match pred(n.char)
                    | true => again(n.past, n.progress)(proved())
                    | false => (past = at, reach = reached)
                    end
                | none() => (past = at, reach = reached)
                end,
        from)(
        Nat/le/refl(from.offset));

--- Where `needle` first occurs in `s`, or `none`; an empty needle occurs at the start.
pub let index_of_substr(s: Str, needle: Str) -> Option(At(s)) =
    Option/map(first_occurrence(s, needle), (found) => found.start);

--- Without leading and trailing whitespace.
pub let trim(s: Str) -> Str =
    trim_end(trim_start(s));

--- Without leading whitespace.
pub let trim_start(s: Str) -> Str =
    match find_index(s, (c) => Bool/not(Char/is_ascii_whitespace(c)))
    | some(at) => after(s, at)
    | none() => ""
    end;

--- Without trailing whitespace.
pub let trim_end(s: Str) -> Str =
    before(s, back_over(s, At/finish(s), Char/is_ascii_whitespace));

--- `s` without `prefix` at its front, or `none` when it does not begin with it.
pub let strip_prefix(s: Str, prefix: Str) -> Option(Str) =
    Option/map(meets(s, At/start(s), prefix, At/start(prefix)), (met) => after(s, met.past));

--- `s` without `suffix` at its end, or `none` when it does not end with it.
pub let strip_suffix(s: Str, suffix: Str) -> Option(Str) =
    Option/map(meets_back(s, At/finish(s), suffix, At/finish(suffix)), (start) => before(s, start));

--- Whether `s` begins with `prefix`.
pub let starts_with(s: Str, prefix: Str) -> Bool =
    Option/is_some(strip_prefix(s, prefix));

--- Whether `s` ends with `suffix`.
pub let ends_with(s: Str, suffix: Str) -> Bool =
    Option/is_some(strip_suffix(s, suffix));

--- The text before the first `sep` and the text after it, or `none` when `sep` does not occur.
pub let split_once(s: Str, sep: Str) -> Option({Str, Str}) =
    Option/map(first_occurrence(s, sep), (found) => (before(s, found.start), after(s, found.past)));

--- Whether `needle` occurs in `s` as a run of characters.
---
--- Named apart from [`contains`], which is the element reading `/std/List` and `/std/Bytes` both give that word. The substring family beside it — `starts_with`, `ends_with`, `strip_prefix`, `strip_suffix`, `split_once`, `split`, `replace` and `index_of_substr` — takes a `Str` needle too and needs no such mark, because none of them names an operation another carrier spells differently.
pub let has_substr(s: Str, needle: Str) -> Bool =
    Option/is_some(first_occurrence(s, needle));

--- The pieces between occurrences of `sep`, the separators dropped; an empty separator splits into characters.
pub let split(s: Str, sep: Str) -> List(Str) =
    match At/try_next(sep, At/start(sep))
    | none() => List/map(to_list(s), of_char)
    | some(first) =>
        At/forward(
            (_) => (pieces: List(Str)) -> List(Str),
            (at, again) =>
                (pieces) =>
                    match occurrence(s, at, sep, first)
                    | some(found) =>
                        again(found.past, proved())(
                            [..pieces, between(s, at, found.start, @found.ordered)])
                    | none() => [..pieces, after(s, at)]
                    end,
            At/start(s))(
            [])
    end;

--- Every occurrence of `from` replaced by `to`, left to right; an empty `from` changes nothing.
pub let replace(s: Str, from: Str, to: Str) -> Str =
    match At/try_next(from, At/start(from))
    | none() => s
    | some(first) =>
        At/forward(
            (_) => (written: Str) -> Str,
            (at, again) =>
                (written) =>
                    match occurrence(s, at, from, first)
                    | some(found) =>
                        again(found.past, proved())(
                            concat(
                                concat(written, between(s, at, found.start, @found.ordered)),
                                to))
                    | none() => concat(written, after(s, at))
                    end,
            At/start(s))(
            "")
    end;

--- `s` with each character `with` answers for replaced by the answer, and the runs between copied as the pieces of `s` they are, so what comes back is text without being checked again: one walk forward, which is what an encoder escapes through.
pub let escape(s: Str, with: (Char) -> Option(Str)) -> Str =
    At/forward(
        (at) => (written: Str, run: At(s), ordered: Bool/Holds(run.offset <= at.offset)) -> Str,
        (at, again) =>
            (written, run, ordered) =>
                match At/try_next(s, at)
                | none() => concat(written, between(s, run, at, @ordered))
                | some(n) =>
                    match with(n.char)
                    | none() => again(n.past, n.progress)(written, run, proved())
                    | some(replacement) =>
                        again(n.past, n.progress)(
                            concat(concat(written, between(s, run, at, @ordered)), replacement),
                            n.past,
                            Nat/le/refl(n.past.offset))
                    end
                end,
        At/start(s))(
        "",
        At/start(s),
        Nat/le/refl(0));

--- The lines: split on newlines, one trailing carriage return dropped from each, and a final newline closing the last line rather than opening an empty one.
pub let lines(s: Str) -> List(Str) =
    let strip(line: Str) -> Str =
        match strip_suffix(line, "\r") | some(bare) => bare | none() => line end;
    let newline = At/next("\n", At/start("\n"));
    At/forward(
        (_) => (read: List(Str)) -> List(Str),
        (at, again) =>
            (read) =>
                match occurrence(s, at, "\n", newline)
                | some(found) =>
                    again(found.past, proved())(
                        [..read, strip(between(s, at, found.start, @found.ordered))])
                | none() =>
                    let rest = after(s, at);
                    match is_empty(rest) | true => read | false => [..read, strip(rest)] end
                end,
        At/start(s))(
        []);

--- `s` widened to `n` characters with `c` at the front; a string already that wide is unchanged.
pub let pad_start(s: Str, n: Nat, c: Char) -> Str =
    concat(repeat(of_char(c), n - len(s)), s);

--- `s` widened to `n` characters with `c` at the end; a string already that wide is unchanged.
pub let pad_end(s: Str, n: Nat, c: Char) -> Str =
    concat(s, repeat(of_char(c), n - len(s)));

satisfy Eql(Str) {
    eql = eql,
    neq(a, b) = Bool/not(eql(a, b)),
}

satisfy Show(Str) {
    show(s) = s,
}

--- A string literal, escaped where the literal grammar needs it.
satisfy Spell(Str) {
    spell(s) =
        let body =
            fold(s, "", (c, acc) =>
                concat(
                    acc,
                    match Char/to_nat(c)
                    | '\n' => "\\n"
                    | '\t' => "\\t"
                    | '\r' => "\\r"
                    | '\\' => "\\\\"
                    | '"' => "\\\""
                    | _ => of_char(c)
                    end));
        concat("\"", concat(body, "\"")),
}

satisfy Cmp(Str) {
    lt(a, b) = Ordering/is_lt(ord(a, b)),
    le(a, b) = Ordering/is_le(ord(a, b)),
    gt(a, b) = Ordering/is_gt(ord(a, b)),
    ge(a, b) = Ordering/is_ge(ord(a, b)),
}

satisfy Ord(Str) {
    ord = ord,
}
