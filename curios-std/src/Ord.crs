use /std/{Nat, List, Bool, Eq};
use /std/Bool/{Holds};
use /std/ops/{Eql};

--- The three-way answer a comparison gives, with its distinctness proofs.
pub mod Ordering;
pub use Ordering/{let Ordering};

--- A total order: `ord` decides `lt`, `eq` or `gt`, and `Eql` is its superclass.
pub concept Ord(A: Type): pub Type {
    use Eql(A),
    ord(A, A) -> Ordering,
}

pub use Ord/*;

--- The first answer that is not `eq`, or `eq` where they all agree.
pub let lexicographic(pieces: List(Ordering)) -> Ordering =
    List/fold(pieces, Ordering/eq(), (piece, acc) => match acc | eq() => piece | _ => acc end);

--- Two constructors ordered by declaration position, answering `same` where they agree.
---
--- A derived witness compares the constructors before it looks at payloads and consults `same` only when they match, so a value of a later constructor is above one of an earlier constructor whatever the payloads say.
pub let by_tag(left: Nat, right: Nat, same: Ordering) -> Ordering =
    match Nat/ord(left, right) | lt() => Ordering/lt() | eq() => same | gt() => Ordering/gt() end;

--- Nothing left to distinguish.
pub let tied: Ordering =
    Ordering/eq();

--- The law that `ord` answers the flipped answer with its operands swapped: `gt` one way exactly where `lt` the other, and `eq` both ways or neither.
---
--- A comparator's proof of it stands in a module beside the comparator, `Nat/ord/flips`, and a theorem that needs it takes it as a hypothesis: `Ord` itself carries no law.
pub let Flips(@T: Type, ord: (T, T) -> Ordering) -> Prop =
    (a: T, b: T) -> Eq()(ord(b, a), Ordering/flip(ord(a, b)));

--- The law that `le` carries across a middle element.
pub let Transitive(@T: Type, le: (T, T) -> Bool) -> Prop =
    (a: T, b: T, c: T, Holds(le(a, b)), Holds(le(b, c))) -> Holds(le(a, c));

--- `ord` as a relation: what it does not answer `gt` at.
pub let le(@T: Type, ord: (T, T) -> Ordering) -> (T, T) -> Bool =
    (a, b) => Ordering/is_le(ord(a, b));

--- `ord` as a strict relation: what it answers `lt` at.
pub let lt(@T: Type, ord: (T, T) -> Ordering) -> (T, T) -> Bool =
    (a, b) => Ordering/is_lt(ord(a, b));

--- `ord`, and `second` among what `ord` ties: the relation that holds where `ord` answers `lt`, and where it answers `eq` and `second` holds.
---
--- At a `second` that always holds it is `le(ord)`. It is the order two sorts in a row leave a list in, the later sort's comparator first.
pub let then(@T: Type, ord: (T, T) -> Ordering, second: (T, T) -> Bool) -> (T, T) -> Bool =
    (a, b) => match ord(a, b) | lt() => true | eq() => second(a, b) | gt() => false end;
