pub use /sys/{Nat};
pub use /sys/Nat/{succ, eql, neq, add, sub, mul, div, rem, gt, ge, and, or, xor, shl, shr, pow,
    to_int, to_flt, to_byte};
use /std/{Str, Option, Char, Bool, Show, Spell, Ord, Eq};
use /std/Bool/{Holds};
use /std/ops/{Eql, Cmp, Add, Sub, Mul, Div, Rem};

--- `a < b`'s laws, and its crossings with `a <= b`.
---
--- Proved by recursion on the numbers rather than on evidence: one more on each side of a decided comparison cancels, so the hypothesis about `a + 1` and `b + 1` already is the one about `a` and `b`.
pub mod lt;
pub use lt/{let lt};

--- `a <= b`'s laws.
---
--- Decided, so a guard already taken discharges it for free; a proof that has to recurse walks the numbers, as `lt`'s do.
pub mod le;
pub use le/{let le};

--- The smaller of two naturals, and the laws a hypothesis decides it by.
---
--- Conversion decides `min` from its operands as terms — it commutes, associates, drops an operand another is at most and stands a shared literal outside — and reads no hypothesis, so under a guard on `a <= b` these laws are the step.
pub mod min;
pub use min/{let min};

--- The larger of two naturals, and the laws a hypothesis decides it by.
pub mod max;
pub use max/{let max};

satisfy Eql(Nat) {
    eql = eql,
    neq = neq,
}

satisfy Cmp(Nat) {
    lt = lt,
    le = le,
    gt = gt,
    ge = ge,
}

satisfy Add(Nat) {
    add = add,
}

satisfy Sub(Nat) {
    sub = sub,
}

satisfy Mul(Nat) {
    mul = mul,
}

--- The divisor must be positive: `Holds(0 < b)`.
satisfy Div(Nat) {
    Ok(b) = Holds(0 < b),
    div = div,
}

--- The divisor must be positive: `Holds(0 < b)`.
satisfy Rem(Nat) {
    Ok(b) = Holds(0 < b),
    rem = rem,
}

--- The decimal digit of `d` modulo ten.
let single_digit(d: Nat) -> Str =
    Str/of_char(Char/hex_digit(d % 10));

--- The decimal digits of `n`.
pub let to_str(n: Nat) -> Str =
    match n < 10
    | true => single_digit(n)
    | false => Str/concat(to_str(n / 10), single_digit(n % 10))
    end;

--- The number a nonempty run of decimal digits spells, or `none` for any other text.
pub let of_str(s: Str) -> Option(Nat) =
    match Str/is_empty(s)
    | true => Option/none()
    | false =>
        Str/fold(
            s,
            Option/some(0),
            (cp, acc) =>
                let n = acc!;
                match Char/is_digit(cp)
                | true => Option/some(n * 10 + (Char/to_nat(cp) - '0'))
                | false => Option/none()
                end)
    end;

--- `a - 1`, and `0` at zero.
pub let pred(a: Nat) -> Nat =
    a - 1;

--- The greatest common divisor, with `gcd(a, 0)` as `a`, so `gcd(0, 0)` is `0`. It is [`Gcd/of`]'s value: a type may mention it, and its laws are `Gcd`'s.
pub let gcd(a: Nat, b: Nat) -> Nat =
    Gcd/of(a, b).value;

--- The least common multiple, with `lcm(0, 0)` as `0`.
pub let lcm(a: Nat, b: Nat) -> Nat =
    match gcd(a, b) | 0 => 0 | g + 1 => a * b / (g + 1) end;

--- The exponent of the highest power of two not above `n`, and `0` at zero.
pub let log2(n: Nat) -> Nat =
    match n < 2 | true => 0 | false => log2(n / 2) + 1 end;

--- The floor of the square root. General recursion, so a type may not mention it.
---
--- Newton's iteration from a power of two above the root, so the cost is the root's bit width rather than the root: counting up to it would take `2⁶⁴` steps for a 128-bit `n`, an input an unbounded `Nat` holds.
pub let sqrt(n: Nat) -> Nat =
    let go(x: Nat) -> Nat =
        match x
        | 0 => 0
        | xp + 1 =>
            let y = (x + n / (xp + 1)) / 2;
            match y < x | true => go(y) | false => x end
        end;
    go(shl(1, log2(n) / 2 + 1));

--- Whether `n` is even.
pub let is_even(n: Nat) -> Bool =
    n % 2 == 0;

--- Whether `lo <= c <= hi`.
pub let in_range(c: Nat, lo: Nat, hi: Nat) -> Bool =
    match c >= lo | true => c <= hi | false => false end;

--- A decided equality is an equation: `a == b` gives `Eq()(a, b)`, by recursion on both sides, since `a + 1 == b + 1` is `a == b` after cancellation.
pub let eq_of_eql(a: Nat, b: Nat, h: Holds(a == b)) -> Eq()(a, b) =
    match a
    | 0 =>
        match b
        | 0 => Eq/refl()
        | _ + 1 => match h end
        end
    | ap + 1 =>
        match b
        | 0 => match h end
        | bp + 1 => Eq/cong((x) => x + 1, eq_of_eql(ap, bp, h))
        end
    end;

--- The order of two naturals, and its laws.
pub mod ord;
pub use ord/{let ord};

satisfy Show(Nat) {
    show = to_str,
}

satisfy Spell(Nat) {
    spell = to_str,
}

satisfy Ord(Nat) {
    ord = ord,
}

--- Division with remainder, certified: `of` hands back the quotient and remainder `/` and `%` compute, with Euclid's identity and the remainder's bound.
pub mod DivMod;
pub use DivMod/{let DivMod};

--- That `d` divides `n`, with its laws beneath.
pub mod Divides;
pub use Divides/{let Divides};

--- A greatest common divisor with its proofs: it divides both operands, and every common divisor divides it.
pub mod Gcd;
pub use Gcd/{let Gcd};

--- That two numbers share no divisor but one, with Euclid's lemma and the reduced fraction beneath.
pub mod Coprime;
pub use Coprime/{let Coprime};
