use /std/{Str, Char, Nat, Bool, List, Option, Result, Parse, Html};
use /std/Html/{Attr};

let is_ws(c: Char) -> Bool =
    match Char/to_nat(c)
    | ' ' => true
    | '\t' => true
    | '\n' => true
    | '\r' => true
    | '\u{C}' => true
    | _ => false
    end;

let ws: Parse(Str, {}) =
    Parse/map(Parse/text/take_while(is_ws), (_) => ());

let is_name_char(c: Char) -> Bool =
    let n = Char/to_nat(c);
    Bool/not(is_ws(c) || n == '<' || n == '>' || n == '/' || n == '=' || n == '"' || n == '\'');

--- A tag or attribute name: everything up to whitespace or a delimiter, empty when there is none.
let name: Parse(Str, Str) =
    Parse/text/take_while(is_name_char);

--- Everything before the next `stop`, or to the end of the input.
let until_char(stop: Char) -> Parse(Str, Str) =
    Parse/text/take_while((c) => c != stop);

let named_reference(body: Str) -> Option(Str) =
    choose
    | body == "amp" => Option/some("&")
    | body == "lt" => Option/some("<")
    | body == "gt" => Option/some(">")
    | body == "quot" => Option/some("\"")
    | body == "apos" => Option/some("'")
    | body == "nbsp" => Option/some(" ")
    | _ => Option/none()
    end;

let hex_of_str(s: Str) -> Option(Nat) =
    match Str/is_empty(s)
    | true => Option/none()
    | false =>
        Str/fold(
            s,
            Option/some(0),
            (c, acc) =>
                Option/bind(acc, (n) => Option/map(Char/of_hex_digit(c), (d) => n * 16 + d)))
    end;

let numeric_reference(digits: Str) -> Option(Str) =
    let code =
        match Option/or(Str/strip_prefix(digits, "x"), Str/strip_prefix(digits, "X"))
        | some(hex) => hex_of_str(hex)
        | none() => Nat/of_str(digits)
        end;
    Option/bind(code, (n) => Option/map(Char/of_nat(n), Str/of_char));

--- What the reference `&body;` stands for, or `none` when it names nothing known.
let reference(body: Str) -> Option(Str) =
    match Str/strip_prefix(body, "#")
    | some(digits) => numeric_reference(digits)
    | none() => named_reference(body)
    end;

--- The reference at the start of a piece that followed an `&`, when it is one.
let decoded_reference(piece: Str) -> Option(Str) =
    let (body, rest) = Str/split_once(piece, ";")!;
    match Str/len(body) <= 8 && Bool/not(Str/is_empty(body))
    | false => Option/none()
    | true =>
        let s = reference(body)!;
        Option/some(Str/concat(s, rest))
    end;

--- A piece that followed an `&`: the reference at its start decoded when it is one, the `&` kept otherwise.
let decode_piece(piece: Str) -> Str =
    Option/unwrap_or(decoded_reference(piece), Str/concat("&", piece));

--- `s` with its character references decoded — the five markup needs, `nbsp`, and numbers in decimal or hex; one that names nothing known is kept as written.
pub let decode(s: Str) -> Str =
    match Str/split(s, "&")
    | [] => s
    | [first, ..rest] => Str/concat(first, Str/flatten(List/map(rest, decode_piece)))
    end;

let quoted(quote: Char) -> Parse(Str, Str) =
    let _ = Parse/text/expect(quote)!;
    let value = until_char(quote)!;
    let _ = Parse/optional(Parse/text/expect(quote))!;
    Parse/pure(value);

let unquoted: Parse(Str, Str) =
    Parse/text/take_while((c) => Bool/not(is_ws(c) || c == '>'));

let attr_value: Parse(Str, Str) =
    let _ = ws!;
    let _ = Parse/text/expect('=')!;
    let _ = ws!;
    Parse/or(quoted('"'), Parse/or(quoted('\''), unquoted));

--- One attribute: a name, then `=` and a value, quoted or bare, when there is one. Declines at anything but a name, which ends the run.
let attribute: Parse(Str, Attr) =
    let _ = ws!;
    let n = name!;
    match Str/is_empty(n)
    | true => Parse/fail("an attribute has a name")
    | false =>
        let value = Parse/optional(attr_value)!;
        Parse/pure(match value | some(v) => Attr/attr(n, decode(v)) | none() => Attr/flag(n) end)
    end;

let close_tag: Parse(Str, {}) =
    let _ = Parse/text/literal("</")!;
    let _ = name!;
    let _ = ws!;
    let _ = Parse/optional(Parse/text/expect('>'))!;
    Parse/pure(());

let comment: Parse(Str, Html) =
    let _ = Parse/text/literal("<!--")!;
    let body = Parse/text/until("-->")!;
    let _ = Parse/optional(Parse/text/literal("-->"))!;
    Parse/pure(Html/comment(body));

--- A doctype or any other `<!…>` declaration, skipped as an empty run.
let declaration: Parse(Str, Html) =
    let _ = Parse/text/literal("<!")!;
    let _ = until_char('>')!;
    let _ = Parse/optional(Parse/text/expect('>'))!;
    Parse/pure(Html/fragment([]));

let text_run: Parse(Str, Html) =
    let chunk = until_char('<')!;
    Parse/pure(Html/text(decode(chunk)));

let lone_bracket: Parse(Str, Html) =
    Parse/map(Parse/text/char, (_) => Html/text("<"));

--- An element from its opening tag: one closed with `/>` is `void`; `script` and `style` hold their text as written up to their closing tag; any other holds the trees up to the next closing tag, whichever name it bears, or the end of the input — so `<br>` written without the slash holds what follows it, since no element name is consulted.
let element: Parse(Str, Html) =
    let _ = Parse/text/expect('<')!;
    let n = name!;
    let attrs = Parse/many0(attribute)!;
    let _ = ws!;
    let closed = Parse/optional(Parse/text/expect('/'))!;
    let _ = ws!;
    let _ = Parse/optional(Parse/text/expect('>'))!;
    match Option/is_some(closed)
    | true => Parse/pure(Html/void(n, attrs))
    | false =>
        match Html/is_raw_text(n)
        | true =>
            let body = Parse/text/until(Str/concat("</", n))!;
            let _ = Parse/optional(close_tag)!;
            Parse/pure(Html/element(n, attrs, [Html/text(body)]))
        | false =>
            let children = trees!;
            let _ = Parse/optional(close_tag)!;
            Parse/pure(Html/element(n, attrs, children))
        end
    end
and tree: Parse(Str, Html) =
    let next = Parse/text/peek!;
    match next
    | none() => Parse/fail("the end of the input")
    | some(c) =>
        match c == '<'
        | false => text_run
        | true =>
            let (_, second) = Parse/lookahead(Parse/and(Parse/text/char, Parse/text/peek))!;
            match second
            | none() => lone_bracket
            | some(after) =>
                choose
                | after == '/' => Parse/fail("a closing tag")
                | after == '!' => Parse/or(comment, declaration)
                | is_name_char(after) => element
                | _ => lone_bracket
                end
            end
        end
    end
and trees: Parse(Str, List(Html)) =
    Parse/many0(tree);

let stray_close: Parse(Str, Html) =
    Parse/map(close_tag, (_) => Html/fragment([]));

let is_empty_fragment(h: Html) -> Bool =
    match h
    | fragment(children) => match children | [] => true | _ => false end
    | _ => false
    end;

let content: Parse(Str, Html) =
    let all = Parse/many0(Parse/or(tree, stray_close))!;
    let _ = Parse/eof()!;
    let read = List/filter(all, (n) => Bool/not(is_empty_fragment(n)));
    Parse/pure(
        match read
        | [] => Html/fragment([])
        | [one, ..rest] => match rest | [] => one | _ => Html/fragment(read) end
        end);

--- The tree `s` spells, read as the markup `render` writes rather than as a browser reads a page: what `render` writes reads back equal. No element name is consulted, so an element is void only where it is written `<name/>`, and any other holds the trees up to the next closing tag, whichever name it bears, or to its parent's end — `<br>` written without the slash holds what follows it, and a second `<li>` or `<p>` nests in the first. A name keeps the case it was written in, a stray closing tag is skipped, a declaration is dropped, and a reference decodes as `decode` reads it, one that names nothing known kept as written. A single tree is returned as itself, several as a fragment. The grammar declines nothing today; the refusal is the parser's to report should it ever.
pub let of_str(s: Str) -> Result(Parse/Error, Html) =
    Parse/run(content, s);
