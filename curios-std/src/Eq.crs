--- Propositional equality: `x` and `y` are one value.
pub induct Eq(@A: Sort): (A, A) -> pub Prop
--- A value equals itself, which is the only way an equality is made.
| refl(@z: A): (z, z)
end

pub use Eq/*;

--- Symmetry.
pub let sym(@A: Sort, @x: A, @y: A, p: Eq()(x, y)) -> Eq()(y, x) =
    match p | refl() => Eq/refl() end;

--- Transitivity.
pub let trans(@A: Sort, @x: A, @y: A, @z: A, p: Eq()(x, y), q: Eq()(y, z)) -> Eq()(x, z) =
    match q | refl() => p end;

--- Equal arguments give equal results under any `f`.
pub let cong(@A: Sort, @B: Sort, @x: A, @y: A, f: (A) -> B, p: Eq()(x, y)) -> Eq()(f(x), f(y)) =
    match p | refl() => Eq/refl() end;

--- A `P(x)` carried to `P(y)` along an equality: a proof where `P` is a family of propositions, and a value where it is one of types.
pub let subst(@A: Sort, @x: A, @y: A, P: (A) -> Sort, p: Eq()(x, y), v: P(x)) -> P(y) =
    match p | refl() => v end;
