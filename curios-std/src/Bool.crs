pub use /sys/{Bool};
pub use /sys/Bool/{xor, eql, Holds};

--- The trivial proposition, inhabited by `qed`: what a decided bound reduces to when it holds.
pub mod True;
pub use True/{let True};

--- The empty proposition: what a decided bound reduces to when it fails.
pub mod False;
pub use False/{let False};

--- Conjunction, with what a proof of one holds of its halves.
pub mod and;
pub use and/{let and};

--- Disjunction, with what makes one hold.
pub mod or;
pub use or/{let or};

use /std/{Str, Option, Eq, Show, Spell, Ordering, Ord};
use /std/ops/{Eql, Or, And, Cmp};

--- The other value.
pub let not(b: Bool) -> Bool =
    xor(b, true);

--- `true` or `false`, as written.
pub let to_str(b: Bool) -> Str =
    match b | true => "true" | false => "false" end;

--- The value `to_str` writes, or `none` for any other text.
pub let of_str(s: Str) -> Option(Bool) =
    choose
    | s == "true" => Option/some(true)
    | s == "false" => Option/some(false)
    | _ => Option/none()
    end;

--- `false` and `true` are distinct: the absurdity every decision procedure over a `Bool` discharges its impossible arm with.
pub let false_neq_true(p: Eq()(false, true)) -> False =
    Eq/subst((b: Bool) => match b | true => False | false => True end, p, True/qed());

--- The decision as an equation: `Holds(b)` says `b` is `true`, and this says it the way `Eq/subst` rewrites with. By cases on `b`, since `Holds` reduces at each.
pub let eq_of_holds(b: Bool, h: Holds(b)) -> Eq()(b, true) =
    match b
    | true => Eq/refl()
    | false => match h end
    end;

--- The equation as the decision, back: `True/qed()` carried along the equation read the other way.
pub let holds_of_eq(b: Bool, p: Eq()(b, true)) -> Holds(b) =
    Eq/subst((x: Bool) => Holds(x), Eq/sym(p), True/qed());

--- The procedure that decides `Holds(b)`: `some` of the proof where `b` holds, `none` where it does not. What every procedure deciding a bound answers, `Int/non_neg` and `Date/try_of`'s among them.
pub let holds(b: Bool) -> Option(Holds(b)) =
    match b: (r) => Option(Holds(r)) | true => Option/some(True/qed()) | false => Option/none() end;

satisfy Eql(Bool) {
    eql = eql,
    neq = xor,
}

satisfy Or(Bool) {
    or = or,
}

satisfy And(Bool) {
    and = and,
}

satisfy Show(Bool) {
    show = to_str,
}

satisfy Spell(Bool) {
    spell = to_str,
}

--- `false` below `true`.
pub let ord(a: Bool, b: Bool) -> Ordering =
    match a
    | false => match b | false => Ordering/eq() | true => Ordering/lt() end
    | true => match b | false => Ordering/gt() | true => Ordering/eq() end
    end;

satisfy Cmp(Bool) {
    lt(a, b) = Ordering/is_lt(ord(a, b)),
    le(a, b) = Ordering/is_le(ord(a, b)),
    gt(a, b) = Ordering/is_gt(ord(a, b)),
    ge(a, b) = Ordering/is_ge(ord(a, b)),
}

satisfy Ord(Bool) {
    ord = ord,
}
