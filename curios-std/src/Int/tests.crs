-- `Int` through its sign view, at zero, at both signs and at equal magnitudes of opposite sign: the order's laws, cancellation, the extrema, `abs` and `sign` of a product, the signed scale and floored division.
use /std/{Nat, Int, Bool, List, Ordering, Eq, Test};
use /std/Bool/{True, Holds};

let _a_number_orders_as_equal_to_itself(a: Int) -> Eq()(Int/ord(a, a), Ordering/eq()) =
    Int/ord/refl(a);

let _opposite_signs_of_one_magnitude_are_ordered: Holds(-7 < +7) =
    Int/ord/lt(-7, +7, Eq/refl());

let _an_answer_of_eq_is_an_equation(a: Int, h: Eq()(Int/ord(a, +0), Ordering/eq())) -> Eq()(a, +0) =
    Int/ord/eq(a, +0, h);

let _swapping_the_operands_flips_the_answer(
    a: Int,
    b: Int,
) -> Eq()(Int/ord(b, a), Ordering/flip(Int/ord(a, b))) =
    Int/ord/flips(a, b);

let _the_order_is_transitive(
    a: Int,
    b: Int,
    c: Int,
    p: Holds(Ordering/is_le(Int/ord(a, b))),
    q: Holds(Ordering/is_le(Int/ord(b, c))),
) -> Holds(Ordering/is_le(Int/ord(a, c))) =
    Int/ord/transitive(a, b, c, p, q);

let _the_naturals_order_the_same_way(
    a: Nat,
    b: Nat,
) -> Eq()(Nat/ord(b, a), Ordering/flip(Nat/ord(a, b))) =
    Nat/ord/flips(a, b);

let _a_factor_below_zero_cancels(a: Int, b: Int, e: Eq()(a * -3, b * -3)) -> Eq()(a, b) =
    Int/mul/cancel_r(a, b, -3, e);

let _a_nonzero_factor_cancels_on_the_left(
    a: Int,
    b: Int,
    k: Int,
    @nz: Int/NonZero(k),
    e: Eq()(k * a, k * b),
) -> Eq()(a, b) =
    Int/mul/cancel_l(a, b, k, e);

let _the_magnitude_of_a_product_is_the_product_of_the_magnitudes(
    a: Int,
    b: Int,
) -> Eq()(Int/abs(a * b), Int/abs(a) * Int/abs(b)) =
    Int/abs/of_mul(a, b);

let _the_sign_of_a_product_is_the_product_of_the_signs(
    a: Int,
    b: Int,
) -> Eq()(Int/sign(a * b), Int/sign(a) * Int/sign(b)) =
    Int/sign/of_mul(a, b);

let _a_sign_is_its_own_sign(a: Int) -> Eq()(Int/sign(Int/sign(a)), Int/sign(a)) =
    Int/sign/of_sign(a);

let _an_integer_is_its_sign_times_its_magnitude(
    a: Int,
) -> Eq()(a, Int/sign(a) * Nat/to_int(Int/abs(a))) =
    Int/sign/times_abs(a);

test parity_the_extrema_and_the_sign_compute =
    Test/all([
        Test/assert(Nat/is_even(0)),
        Test/assert(Bool/not(Nat/is_even(7))),
        Test/equal([Int/min(-3, +2), Int/max(-3, +2)], [-3, +2]),
        Test/equal([Nat/min(7, 3), Nat/max(7, 3), Nat/min(4, 4)], [3, 7, 4]),
        Test/equal(
            [Nat/min(18446744073709551616, 5), Nat/max(18446744073709551616, 5)],
            [5, 18446744073709551616]),
        Test/equal(
            [
                Int/min(-18446744073709551616, +5),
                Int/max(-18446744073709551616, -18446744073709551617)],
            [-18446744073709551616, -18446744073709551616]),
        Test/equal([Int/sign(-9), Int/sign(+0), Int/sign(+4)], [-1, +0, +1]),
        Test/equal([Int/sign(-18446744073709551616), Int/sign(+18446744073709551616)], [-1, +1]),
        Test/equal(
            [Int/abs(-9), Int/abs(+0), Int/abs(+4), Int/abs(-1073741824)],
            [9, 0, 4, 1073741824]),
        Test/equal(
            [Int/abs(-18446744073709551616), Int/abs(+18446744073709551616)],
            [18446744073709551616, 18446744073709551616])]);

let _a_shift_splits_at_a_smaller_count(
    x: Int,
    i: Nat,
    j: Nat,
    fits: Holds(j <= i),
) -> Eq()(Int/shl(x, i), Int/shl(Int/shl(x, i - j), j)) =
    Int/shl/split(x, i, j, fits);

let _two_odd_mantissas_of_one_value_are_one(
    m: Int,
    k: Nat,
    odd: Holds(Int/abs(m) % 2 == 1),
    e: Eq()(Int/shl(m, k), Int/shl(-3, 4)),
) -> {count: Eq()(k, 4), value: Eq()(m, -3)} =
    Int/shl/unique(m, k, -3, 4, odd, True/qed(), e);

-- Floored division, where `/` and `%` truncate: a negative dividend's quotient is the next one down where a remainder is left, the remainder lies from zero to below the divisor, a natural divides as truncation does, and `unique` names the split a caller states.
let _a_negative_dividend_floors_its_quotient: Holds(
    Int/DivMod/of(-7, 2).quotient == -4 && Int/DivMod/of(-7, 2).remainder == 1) =
    True/qed();

let _an_exact_negative_multiple_leaves_no_remainder: Holds(
    Int/DivMod/of(-8, 2).quotient == -4 && Int/DivMod/of(-8, 2).remainder == 0) =
    True/qed();

let _a_natural_dividend_divides_as_truncation_does: Holds(
    Int/DivMod/of(+7, 2).quotient == +7 / +2 && Int/DivMod/of(+7, 2).remainder == 1) =
    True/qed();

let _a_stated_split_is_the_computed_one: {
    quotient: Eq()(-4, Int/DivMod/of(-7, 2).quotient),
    remainder: Eq()(1, Int/DivMod/of(-7, 2).remainder)} =
    Int/DivMod/unique(-7, 2, -4, 1, Eq/refl(), True/qed());

-- Floored division at both signs, each split rejoined: the quotient's multiple of the divisor and the remainder are the dividend, and the remainder is below the divisor, where `/` and `%` leave a negative remainder.
test floored_division_rejoins_every_dividend_with_a_remainder_below_its_divisor =
    Test/assert(
        List/all(
            [-7, -6, -5, -1, +0, +1, +5, +6, +7],
            (n: Int) =>
                let split = Int/DivMod/of(n, 3);
                split.quotient * +3 + Nat/to_int(split.remainder) == n && split.remainder < 3));
