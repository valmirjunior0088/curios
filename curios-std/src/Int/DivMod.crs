use /std/{Nat, Int, Eq};
use /std/Bool/{True, Holds};

--- `n` divided by `d`, floored: the quotient and the remainder, with Euclid's identity and the remainder's bound beside them.
pub struct DivMod(n: Int, d: Nat): pub Type {
    --- The greatest integer whose multiple of `d` is at most `n`.
    quotient: Int,
    --- What is left over, from zero to below `d` whatever `n`'s sign.
    remainder: Nat,
    --- `n` is the quotient's multiple of `d` and the remainder.
    joined: Eq()(n, quotient * Nat/to_int(d) + Nat/to_int(remainder)),
    --- The remainder is below `d`.
    bounded: Holds(remainder < d),
}

--- Division with remainder rounded toward negative infinity, certified, where `/` and `%` round toward zero: `of(-7, 2)` is `-4` and `1`.
---
--- Through `Int`'s sign view: a natural is divided as `Nat/DivMod` divides it, and one below zero, `-1 - m`, has the quotient `-1 - m / d` and the remainder `d - 1 - m % d`. Each identity is an equation the elaborator proves from Euclid's at `Nat`, read through `Nat/to_int`.
pub let of(n: Int, d: Nat, @ok: Holds(0 < d)) -> DivMod(n, d) =
    match Int/view(n)
    | nonneg(m) =>
        DivMod {
            quotient = Nat/to_int(m / d),
            remainder = m % d,
            joined =
                Int/eq_of_eql(
                    Nat/to_int(m),
                    Nat/to_int(m / d) * Nat/to_int(d) + Nat/to_int(m % d),
                    True/proved()),
            bounded = True/qed() }
    | neg(m) =>
        DivMod {
            quotient = -1 - Nat/to_int(m / d),
            remainder = d - 1 - m % d,
            joined =
                Int/eq_of_eql(
                    -1 - Nat/to_int(m),
                    (-1 - Nat/to_int(m / d)) * Nat/to_int(d) + Nat/to_int(d - 1 - m % d),
                    True/proved()),
            bounded = True/proved() }
    end;

--- A quotient and a remainder are the ones `of` computes: a `q` and an `r` with `n = q * d + r` and `r < d` are its.
---
--- Two splits of one `n` differ by a multiple of `d` that two remainders below `d` cannot make up, so the quotients are one, which the elaborator proves from the two identities and the bounds; the remainders are then what the identity leaves once the quotient is rewritten.
pub let unique(
    n: Int,
    d: Nat,
    q: Int,
    r: Nat,
    @ok: Holds(0 < d),
    joined: Eq()(n, q * Nat/to_int(d) + Nat/to_int(r)),
    bounded: Holds(r < d),
) -> {quotient: Eq()(q, of(n, d).quotient), remainder: Eq()(r, of(n, d).remainder)} =
    let split = of(n, d);
    let same: Holds(
        q * Nat/to_int(d) + Nat/to_int(r)
            == split.quotient * Nat/to_int(d) + Nat/to_int(split.remainder)) = True/proved();
    let quotient: Eq()(q, split.quotient) = Int/eq_of_eql(q, split.quotient, True/proved());
    let rest: Holds(
        split.quotient * Nat/to_int(d) + Nat/to_int(r)
            == split.quotient * Nat/to_int(d) + Nat/to_int(split.remainder)) =
        Eq/subst(
            (x: Int) =>
                Holds(
                    x * Nat/to_int(d) + Nat/to_int(r)
                        == split.quotient * Nat/to_int(d) + Nat/to_int(split.remainder)),
            quotient,
            same);
    (quotient = quotient, remainder = Nat/eq_of_eql(r, split.remainder, True/proved()));
