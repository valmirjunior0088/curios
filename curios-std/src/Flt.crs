pub use /sys/{Flt};
pub use /sys/Flt/{add, sub, mul, div, fma, rem, min, max, eql, neq, lt, gt, le, ge, neg, abs, sqrt,
    round, floor, ceil, trunc, nearest, copysign, to_nat, to_int, mantissa, exponent, to_le_bytes,
    of_le_bytes};

--- IEEE 754's rounding directions.
pub mod Rounding;
pub use Rounding/{let Rounding};

--- IEEE 754's five exceptions, as a value.
pub mod Exceptions;
pub use Exceptions/{let Exceptions};

--- IEEE 754's ten classes.
pub mod Class;
pub use Class/{let Class};

--- IEEE 754's floating-point environment: the rounding direction and the raised exceptions, as a monad.
pub mod Env;
pub use Env/{let Env};

--- The operations that round, each in the direction its first argument names.
pub mod rounded;

--- The exceptions each rounded operation raises, beside the result `rounded` computes.
pub mod signals;

--- The exact layer every rounding in this library goes through.
mod exact;

--- What `Flt`'s own modules share and no program sees: a `pub` inside it reaches all of `Flt` and no further.
mod internal;
use internal/{Dyadic};

--- The terms §9.4's reductions add and multiply, read exactly.
mod reduction;

--- The shortest digits that read back as a float, and the digits a precision keeps, laid out as text.
mod digits;
use digits/{pow2, render, to_str_significant_in};

--- The text a float is read from: the grammar `of_str`, `of_decimal` and `of_hex_str` read.
mod grammar;
use grammar/{of_decimal_in, of_str_in, of_hex_str_in};

use /std/{Nat, Byte, Int, Str, Char, Bool, Option, Bytes, List, Ordering, Show, Spell, Fmt, Ord,
    Vec, Eq};
use /std/Bool/{True, False, Holds};
use /std/ops/{Eql, Cmp, Add, Sub, Mul, Div, Rem};

--- That `b` is eight bytes long, decided.
pub let EightBytes(b: Bytes) -> Prop =
    Holds(Bytes/len(b) == 8);

--- Whether `f` is a number: neither infinity nor a NaN.
pub let is_finite(f: Flt) -> Bool =
    f > -inf.0 && f < +inf.0;

--- That `f` is a number, decided: the domain `to_int` states.
pub let Finite(f: Flt) -> Prop =
    Holds(-inf.0 < f && f < +inf.0);

--- That `f` is zero or above and a number, decided: the domain `to_nat` states. `-0.0` qualifies.
pub let NonNeg(f: Flt) -> Prop =
    Holds(+0.0 <= f && f < +inf.0);

--- Whether `f` is a NaN, of either sign and kind.
pub let is_nan(f: Flt) -> Bool =
    Bool/not(f == f);

--- Whether `f` is a signaling NaN: a NaN whose quiet bit is clear.
pub let is_signaling(f: Flt) -> Bool =
    is_nan(f) && Nat/is_even(Nat/shr(exact/bits(f), 51));

--- Whether `f`'s sign bit is set, a NaN's and a zero's included.
pub let is_sign_minus(f: Flt) -> Bool =
    exact/bits(f) >= Nat/shl(1, 63);

--- Whether `f` is an infinity of either sign.
pub let is_infinite(f: Flt) -> Bool =
    f == +inf.0 || f == -inf.0;

--- Whether `f` is a zero of either sign.
pub let is_zero(f: Flt) -> Bool =
    f == +0.0;

--- Whether `f` is subnormal: nonzero and finite with the exponent field clear.
pub let is_subnormal(f: Flt) -> Bool =
    Bool/not(is_zero(f)) && Nat/shr(exact/bits(f), 52) % 2048 == 0;

--- Whether `f` is normal: finite, nonzero and not subnormal.
pub let is_normal(f: Flt) -> Bool =
    is_finite(f) && Bool/not(is_zero(f)) && Bool/not(is_subnormal(f));

--- Every binary64 encoding is canonical (§5.7.2): there is one per value.
pub let is_canonical(_: Flt) -> Bool =
    true;

--- The format's radix.
pub let radix(_: Flt) -> Nat =
    2;

--- This library follows IEEE 754-2019.
pub let is_754_version_2019: Bool =
    true;

--- The class `f` falls in.
pub let class(f: Flt) -> Class =
    let minus = is_sign_minus(f);
    choose
    | is_signaling(f) => Class/signaling_nan()
    | is_nan(f) => Class/quiet_nan()
    | is_infinite(f) =>
        match minus | true => Class/negative_infinity() | false => Class/positive_infinity() end
    | is_zero(f) => match minus | true => Class/negative_zero() | false => Class/positive_zero() end
    | is_subnormal(f) =>
        match minus | true => Class/negative_subnormal() | false => Class/positive_subnormal() end
    | _ => match minus | true => Class/negative_normal() | false => Class/positive_normal() end
    end;

--- Whether either is a NaN, so that no order relates them.
pub let unordered(a: Flt, b: Flt) -> Bool =
    is_nan(a) || is_nan(b);

--- That `f` is a finite nonzero value, decided: the domain of `log_b`.
pub let FiniteNonZero(f: Flt) -> Prop =
    Holds(is_finite(f) && Bool/not(is_zero(f)));

--- `f` is finite, read off the evidence that it is finite and nonzero: the decision `Finite` states splits, and where it fails `FiniteNonZero(f)` is `False`.
let finite_of_non_zero(f: Flt, @ok: FiniteNonZero(f)) -> Finite(f) =
    match -inf.0 < f && f < +inf.0: (d) => (Holds(d && Bool/not(is_zero(f)))) -> Holds(d)
    | true => (_) => True/qed()
    | false => (no) => match no end
    end(ok);

--- The procedure that decides `FiniteNonZero(f)`.
pub let finite_non_zero(f: Flt) -> Option(FiniteNonZero(f)) =
    match is_finite(f) && Bool/not(is_zero(f)): (r) => Option(Holds(r))
    | true => Option/some(True/qed())
    | false => Option/none()
    end;

--- IEEE's `remainder` (§5.3.1): `x - n · y` for the integer `n` nearest `x / y`, ties to even, which is exact. A zero answer has `x`'s sign; an infinite `x` or a zero `y` is invalid, and an infinite `y` leaves `x`. Unlike `rem`, which truncates the quotient, the answer is at most half of `y` in magnitude.
pub let remainder(x: Flt, y: Flt) -> Flt =
    choose
    | is_nan(x) || is_nan(y) => x + y
    | (some(d), some(v)) = (Dyadic/try_of(x), Dyadic/try_of(y)) =>
        let e = Int/min(d.exponent, v.exponent);
        let a = Nat/shl(Int/abs(d.mantissa), Int/abs(d.exponent - e));
        let b = Nat/shl(Int/abs(v.mantissa), Int/abs(v.exponent - e));
        -- `x`'s sign, which a zero answer keeps, `-0` included.
        let negative = is_sign_minus(x);
        match b
        -- A zero divisor, which is invalid.
        | 0 => +nan.0
        | bp + 1 =>
            let q = a / (bp + 1);
            let r = a % (bp + 1);
            -- The quotient rounded to the nearest integer, ties to even: `r` is what truncating left, so rounding up leaves `r - b`.
            let up = r * 2 > b || r * 2 == b && Bool/not(Nat/is_even(q));
            match up
            | false => exact/round(Rounding/ties_to_even(), negative, r, e, false)
            | true => exact/round(Rounding/ties_to_even(), Bool/not(negative), b - r, e, false)
            end
        end
    -- An infinity: invalid when it is `x`, and `x` itself when it is only `y`.
    | _ => match is_infinite(x) | true => +nan.0 | false => x end
    end;

--- IEEE's `sum` (§9.4), rounded ties to even: `rounded/sum` takes the direction.
pub let sum(p: List(Flt)) -> Flt =
    rounded/sum(Rounding/ties_to_even(), p);

--- IEEE's `dot` (§9.4), rounded ties to even.
pub let dot(@n: Nat, p: Vec(Flt, n), q: Vec(Flt, n)) -> Flt =
    rounded/dot(Rounding/ties_to_even(), p, q);

--- IEEE's `sumSquare` (§9.4), rounded ties to even.
pub let sum_square(p: List(Flt)) -> Flt =
    rounded/sum_square(Rounding/ties_to_even(), p);

--- IEEE's `sumAbs` (§9.4), rounded ties to even.
pub let sum_abs(p: List(Flt)) -> Flt =
    rounded/sum_abs(Rounding/ties_to_even(), p);

--- IEEE's `scaledProd` (§9.4), rounded ties to even.
pub let scaled_prod(p: List(Flt)) -> {Flt, Int} =
    rounded/scaled_prod(Rounding/ties_to_even(), p);

--- IEEE's `scaledProdSum` (§9.4), rounded ties to even.
pub let scaled_prod_sum(@n: Nat, p: Vec(Flt, n), q: Vec(Flt, n)) -> {Flt, Int} =
    rounded/scaled_prod_sum(Rounding/ties_to_even(), p, q);

--- IEEE's `scaledProdDiff` (§9.4), rounded ties to even.
pub let scaled_prod_diff(@n: Nat, p: Vec(Flt, n), q: Vec(Flt, n)) -> {Flt, Int} =
    rounded/scaled_prod_diff(Rounding/ties_to_even(), p, q);

--- The pair §9.5's augmented operations answer for a nonzero exact value `v`: `a`, `v` rounded ties toward zero, and `b`, what `a` leaves of `v` rounded the same way, which is exact unless it underflows. An `a` that overflows answers itself twice, and a zero `b` takes `a`'s sign.
let augmented(v: Dyadic) -> {Flt, Flt} =
    let a = exact/ties_toward_zero(v.mantissa, v.exponent);
    match Dyadic/try_of(a)
    | none() => (a, a)
    | some(h) =>
        let rest = v - h;
        let b = exact/ties_toward_zero(rest.mantissa, rest.exponent);
        (a, match is_zero(b) | true => copysign(+0.0, a) | false => b end)
    end;

--- IEEE's `augmentedAddition` (§9.5): `x + y` as the pair `(a, b)` of its value rounded ties toward zero and the error that rounding made, so that `a + b` is the exact sum whenever `b` does not underflow. An exact zero sum answers the zero `x + y` does, twice; a NaN or an infinity answers the sum twice.
pub let augmented_add(x: Flt, y: Flt) -> {Flt, Flt} =
    let s = x + y;
    match (Dyadic/try_of(x), Dyadic/try_of(y))
    | (some(a), some(b)) =>
        let v = a + b;
        match v.mantissa == +0 | true => (s, s) | false => augmented(v) end
    | _ => (s, s)
    end;

--- IEEE's `augmentedSubtraction` (§9.5): `augmented_add(x, neg(y))`.
pub let augmented_sub(x: Flt, y: Flt) -> {Flt, Flt} =
    augmented_add(x, neg(y));

--- IEEE's `augmentedMultiplication` (§9.5): `x · y` as the pair `augmented_add` answers for a sum, a zero product signed as the operands are.
pub let augmented_mul(x: Flt, y: Flt) -> {Flt, Flt} =
    let p = x * y;
    match (Dyadic/try_of(x), Dyadic/try_of(y))
    | (some(a), some(b)) =>
        let v = a * b;
        match v.mantissa == +0 | true => (p, p) | false => augmented(v) end
    | _ => (p, p)
    end;

--- IEEE's `nextUp` (§5.3.1): the least float above `f`. `-0` and `+0` step to the least subnormal, the negative least subnormal to `-0`, `-inf` to the negative largest finite value, and `+inf` stays; a NaN answers itself quieted.
pub let next_up(f: Flt) -> Flt =
    let b = exact/bits(f);
    choose
    | is_nan(f) => f + f
    | f == +inf.0 => f
    | is_zero(f) => exact/of_bits(1)
    | is_sign_minus(f) => exact/of_bits(b - 1)
    | _ => exact/of_bits(b + 1)
    end;

--- IEEE's `nextDown`: the greatest float below `f`, `neg(next_up(neg(f)))`.
pub let next_down(f: Flt) -> Flt =
    neg(next_up(neg(f)));

--- IEEE's `scaleB` (§5.3.3): `f · 2^n`, rounded once, ties to even. `rounded/scale` takes the direction.
pub let scale(f: Flt, n: Int) -> Flt =
    rounded/scale(Rounding/ties_to_even(), f, n);

--- IEEE's `logB` (§5.3.3): the exponent of `f`'s leading bit, `⌊log₂|f|⌋`, subnormals included. A zero, an infinity or a NaN has none, which the bound excludes.
pub let log_b(f: Flt, @ok: FiniteNonZero(f)) -> Int =
    let finite = finite_of_non_zero(f, @ok);
    exponent(f, @finite) + Nat/to_int(exact/bit_len(Int/abs(mantissa(f, @finite)))) - +1;

--- `log_b(f)`, or `none` for a zero, an infinity or a NaN.
pub let try_log_b(f: Flt) -> Option(Int) =
    match finite_non_zero(f) | some(ok) => Option/some(log_b(f, @ok)) | none() => Option/none() end;

--- IEEE's `minimumNumber` (§9.6): the lesser of the two, a NaN giving way to a number and `-0` below `+0`; two NaNs answer a NaN.
pub let minimum_number(a: Flt, b: Flt) -> Flt =
    choose
    | is_nan(a) && is_nan(b) => a + b
    | is_nan(a) => b
    | is_nan(b) => a
    | _ => min(a, b)
    end;

--- IEEE's `maximumNumber`, the twin of `minimum_number`.
pub let maximum_number(a: Flt, b: Flt) -> Flt =
    choose
    | is_nan(a) && is_nan(b) => a + b
    | is_nan(a) => b
    | is_nan(b) => a
    | _ => max(a, b)
    end;

--- IEEE's `minimumMagnitude`: the one of lesser magnitude, `min` at equal magnitudes; a NaN propagates.
pub let minimum_magnitude(a: Flt, b: Flt) -> Flt =
    choose
    | is_nan(a) || is_nan(b) => a + b
    | abs(a) < abs(b) => a
    | abs(b) < abs(a) => b
    | _ => min(a, b)
    end;

--- IEEE's `maximumMagnitude`, the twin of `minimum_magnitude`.
pub let maximum_magnitude(a: Flt, b: Flt) -> Flt =
    choose
    | is_nan(a) || is_nan(b) => a + b
    | abs(a) > abs(b) => a
    | abs(b) > abs(a) => b
    | _ => max(a, b)
    end;

--- IEEE's `minimumMagnitudeNumber`: `minimum_magnitude`, a NaN giving way to a number.
pub let minimum_magnitude_number(a: Flt, b: Flt) -> Flt =
    choose
    | is_nan(a) && is_nan(b) => a + b
    | is_nan(a) => b
    | is_nan(b) => a
    | _ => minimum_magnitude(a, b)
    end;

--- IEEE's `maximumMagnitudeNumber`, the twin of `minimum_magnitude_number`.
pub let maximum_magnitude_number(a: Flt, b: Flt) -> Flt =
    choose
    | is_nan(a) && is_nan(b) => a + b
    | is_nan(a) => b
    | is_nan(b) => a
    | _ => maximum_magnitude(a, b)
    end;

--- How many payloads a NaN carries: the trailing significand less its quiet bit.
let payload_room: Nat =
    Nat/shl(1, 51);

--- IEEE's `getPayload` (§9.7): a NaN's payload as a non-negative integral float, and `-1` for anything else.
pub let payload(f: Flt) -> Flt =
    match is_nan(f) | true => Nat/to_flt(exact/bits(f) % payload_room) | false => -1.0 end;

--- `p` as a payload, when it is an integral float in `[low, 2^51)`.
let admissible(p: Flt, low: Nat) -> Option(Nat) =
    let n = try_to_nat(p)!;
    match Nat/to_flt(n) == p && n >= low && n < payload_room
    | true => Option/some(n)
    | false => Option/none()
    end;

--- IEEE's `setPayload` (§9.7): the positive quiet NaN whose payload is `p`, or `+0` when `p` is not an integral float in `[0, 2^51)`.
pub let quiet_nan(p: Flt) -> Flt =
    match admissible(p, 0) | some(n) => exact/of_bits(0x7FF8000000000000 + n) | none() => +0.0 end;

--- IEEE's `setPayloadSignaling` (§9.7): the positive signaling NaN whose payload is `p`, or `+0` when `p` is not an integral float in `[1, 2^51)` — a zero payload with the quiet bit clear is an infinity.
pub let signaling_nan(p: Flt) -> Flt =
    match admissible(p, 1) | some(n) => exact/of_bits(0x7FF0000000000000 + n) | none() => +0.0 end;

--- The float whose little-endian bytes these are, or `none` unless there are exactly eight.
pub let try_of_le_bytes(b: Bytes) -> Option(Flt) =
    match Bytes/len(b) == 8: (_) => Option(Flt)
    | true => Option/some(of_le_bytes(b, @True/qed()))
    | false => Option/none()
    end;

--- The procedure that decides `Finite(f)`: the evidence when `f` is a number, `none` otherwise.
pub let finite(f: Flt) -> Option(Finite(f)) =
    match -inf.0 < f && f < +inf.0: (r) => Option(Holds(r))
    | true => Option/some(True/qed())
    | false => Option/none()
    end;

--- The procedure that decides `NonNeg(f)`: the evidence when `f` is a non-negative number, `none` otherwise. `-0.0` qualifies.
pub let non_neg(f: Flt) -> Option(NonNeg(f)) =
    match f >= +0.0 && f < +inf.0: (r) => Option(Holds(r))
    | true => Option/some(True/qed())
    | false => Option/none()
    end;

--- `f` truncated toward zero, or `none` unless it is a non-negative number.
pub let try_to_nat(f: Flt) -> Option(Nat) =
    match non_neg(f) | some(ok) => Option/some(to_nat(f, @ok)) | none() => Option/none() end;

--- `f` truncated toward zero, or `none` unless it is a number.
pub let try_to_int(f: Flt) -> Option(Int) =
    match finite(f) | some(ok) => Option/some(to_int(f, @ok)) | none() => Option/none() end;

--- The two in IEEE 754's total order, which tells every `Flt` apart: the negative NaNs, then `-inf` up through `-0`, then `+0` up through `+inf`, then the positive NaNs. NaNs order by their bits outward from the infinity of their sign, so a signaling NaN sits nearer it than a quiet one, as §5.10 orders them.
---
--- `==` and `<` stay IEEE's comparisons, which call the two zeros equal and leave a NaN unordered. This is the order `Ord`, and so `List/sort`, needs, and the identity `Hash` already reads. It is also how this library spells IEEE's `totalOrder(x, y)`, as `ord(x, y) != gt`, and `totalOrderMag(x, y)`, as `ord(abs(x), abs(y)) != gt`.
---
--- It computes the order `Nat/ord` reads through [`total_key`], which is injective ([`total_key_injective`]): that order is total and answers `eq` exactly at an equation by `Nat/ord`'s laws. That `ord` is that order at every pair, the comparisons it leads with included, is not proved here: no law ties `Flt`'s `<` to the bits.
pub let ord(x: Flt, y: Flt) -> Ordering =
    choose
    | x < y => Ordering/lt()
    | y < x => Ordering/gt()
    | _ => Nat/ord(total_key(x), total_key(y))
    end;

--- `f`'s bits as the natural whose order is the total one: a negative pattern complemented below `2⁶³`, a positive one lifted above it. In [`ord`] only equal numbers and NaNs reach it, since a comparison decides every other pair.
pub let total_key(f: Flt) -> Nat =
    let bits = Bytes/to_nat(to_le_bytes(f));
    let top = pow2(63);
    match bits >= top | true => pow2(64) - 1 - bits | false => bits + top end;

--- A float is its bytes: two floats with one encoding are one float.
---
--- [`to_le_bytes`] is injective because `of_le_bytes` undoes it, which is what makes the bytes a float's identity: the two zeros and every NaN pattern are apart, as their encodings are.
pub let eq_of_le_bytes(a: Flt, b: Flt, same: Eq()(to_le_bytes(a), to_le_bytes(b))) -> Eq()(a, b) =
    Option/some_injective(Eq/cong(try_of_le_bytes, same));

--- Two floats with one [`total_key`] are one float: the key tells every pattern apart.
---
--- So the order `Nat/ord` reads through the key is a total order that answers `eq` exactly at an equation, by `Nat/ord`'s own laws. A key at or above `2^63` is a pattern with its sign clear, lifted, and one below it a pattern with its sign set, complemented, and neither map folds two patterns into one below `2^64`, where eight bytes keep every pattern.
pub let total_key_injective(a: Flt, b: Flt, e: Eq()(total_key(a), total_key(b))) -> Eq()(a, b) =
    let la: Holds(Bytes/to_nat(to_le_bytes(a)) < 18446744073709551616) =
        Bytes/to_nat/below(to_le_bytes(a));
    let lb: Holds(Bytes/to_nat(to_le_bytes(b)) < 18446744073709551616) =
        Bytes/to_nat/below(to_le_bytes(b));
    let bits: Eq()(Bytes/to_nat(to_le_bytes(a)), Bytes/to_nat(to_le_bytes(b))) =
        match Bytes/to_nat(to_le_bytes(a)) >= 9223372036854775808
        | true =>
            match Bytes/to_nat(to_le_bytes(b)) >= 9223372036854775808
            | true =>
                Nat/le/antisym(
                    Bytes/to_nat(to_le_bytes(a)),
                    Bytes/to_nat(to_le_bytes(b)),
                    True/proved(),
                    True/proved())
            | false => match False/refuted() end
            end
        | false =>
            match Bytes/to_nat(to_le_bytes(b)) >= 9223372036854775808
            | true => match False/refuted() end
            | false =>
                Nat/le/antisym(
                    Bytes/to_nat(to_le_bytes(a)),
                    Bytes/to_nat(to_le_bytes(b)),
                    True/proved(),
                    True/proved())
            end
        end;
    eq_of_le_bytes(a, b, Bytes/to_nat_injective(to_le_bytes(a), to_le_bytes(b), Eq/refl(), bits));

--- The shortest decimal that reads back as `f`, always signed: `+2.5`, `-0`, `+inf`, `-inf`. A NaN writes its sign, its kind and its payload where that is not the kind's own — `+nan`, `-snan`, `+nan(0x5)` — so every NaN reads back as the pattern it is.
pub let to_str(f: Flt) -> Str =
    let b = to_le_bytes(f);
    -- `to_le_bytes`'s length reduces to eight, so every index below discharges its bound by reduction.
    let at(i: Nat, @ok: Holds(i < 8)) -> Nat = Byte/to_nat(Bytes/get(b, i, @ok));
    let b6 = at(6);
    let b7 = at(7);
    let exp_field = b7 % 0x80 * 16 + b6 / 0x10;
    let place = (acc: Nat, v: Nat) => Nat/shl(acc, 8) + v;
    let mant_field =
        place(
            place(place(place(place(place(b6 % 0x10, at(5)), at(4)), at(3)), at(2)), at(1)),
            at(0));
    let sign = match b7 >= 0x80 | true => "-" | false => "+" end;
    choose
    | exp_field == 0x7FF && mant_field == 0 => Str/concat(sign, "inf")
    | exp_field == 0x7FF =>
        let quiet = mant_field >= pow2(51);
        let payload = mant_field % pow2(51);
        -- The least payload each kind carries, which goes unwritten: none for a quiet NaN, one for a signaling one, whose payload cannot be zero.
        let unwritten = match quiet | true => 0 | false => 1 end;
        let kind = match quiet | true => "nan" | false => "snan" end;
        let suffix =
            match payload == unwritten
            | true => ""
            | false => Fmt/render("(0x%)")(hex_str(payload))
            end;
        Str/flatten([sign, kind, suffix])
    | exp_field == 0 && mant_field == 0 => Str/concat(sign, "0")
    | _ =>
        let f_mant = match exp_field == 0 | true => mant_field | false => mant_field + pow2(52) end;
        let even = Nat/is_even(f_mant);
        Str/concat(sign, render(f_mant, exp_field, even))
    end;

--- Ten to the power `n`, as a float.
pub let pow10(n: Nat) -> Flt =
    match n | 0 => +1.0 | _ + 1; ih => ih * +10.0 end;

--- The float nearest to `d` times ten to the `e`, correctly rounded with ties to even, negated when `negative`. `digits` is how many decimal digits spelled `d`, leading zeros included.
pub let of_decimal(negative: Bool, d: Nat, e: Int, digits: Nat) -> Flt =
    of_decimal_in(Rounding/ties_to_even(), negative, d, e, digits);

--- The float a decimal or hex text spells, correctly rounded: an optional sign, then digits with an optional point and an optional `e` exponent, or `0x` and hex digits with an optional point and an optional `p` exponent. An optional sign before `inf`, `infinity`, `nan` or `snan`, in any case, reads as that value of that sign, and a NaN may carry a payload as `nan(0x5)`: every spelling `to_str` and `to_hex_str` write, and what IEEE 754 §5.12.1 requires a reader to accept. `none` for any other text.
pub let of_str(s: Str) -> Option(Flt) =
    of_str_in(Rounding/ties_to_even(), s);

--- `n`'s hex digits, most significant first and lowercase, `0` for zero.
let hex_str(n: Nat) -> Str =
    let go(n: Nat, acc: Str) -> Str =
        let written = Str/concat(Str/of_char(Char/hex_digit(n % 16)), acc);
        match n < 16 | true => written | false => go(n / 16, written) end;
    go(n, "");

--- `f` as a hex significand and a binary exponent (§5.12.3), always signed and exact, since the digits are the significand's own bits: `+0x1.8p+1` for `3`, `+0x0.0000000000001p-1022` for the least subnormal, `+0x0p+0` and `-0x0p+0` for the zeros, and the infinities and NaNs as `to_str` spells them.
pub let to_hex_str(f: Flt) -> Str =
    let b = exact/bits(f);
    let sign = match is_sign_minus(f) | true => "-" | false => "+" end;
    let field = Nat/shr(b, 52) % 2048;
    let fraction = b % pow2(52);
    choose
    | field == 2047 => to_str(f)
    | field == 0 && fraction == 0 => Str/concat(sign, "0x0p+0")
    | _ =>
        let lead = match field == 0 | true => "0x0" | false => "0x1" end;
        let exponent = match field == 0 | true => -1022 | false => Nat/to_int(field) - +1023 end;
        let (digits, count) = trimmed(fraction, 13);
        let point =
            match count == 0
            | true => ""
            | false => Str/concat(".", Str/pad_start(hex_str(digits), count, '0'))
            end;
        Str/flatten([sign, lead, point, "p", Int/to_str(exponent)])
    end;

--- `n` as `count` hex digits with its trailing zero digits dropped: what is left and how many digits it spans.
let trimmed(n: Nat, count: Nat) -> {Nat, Nat} =
    match count
    | 0 => (n, 0)
    | pred + 1 => match n % 16 == 0 | true => trimmed(n / 16, pred) | false => (n, count) end
    end;

--- The float hex text spells, `0x` and all: an optional sign, `0x`, hex digits with an optional point, and an optional `p` exponent, rounded once — and the infinities and NaNs by the names `to_hex_str` writes for them. `none` for any other text.
pub let of_hex_str(s: Str) -> Option(Flt) =
    of_hex_str_in(Rounding/ties_to_even(), s);

--- `f` written with exactly `n` significant digits, rounded to nearest with ties to even, and laid out as `to_str` lays out digits (§5.12.2). `rounded/to_str_significant` takes the direction.
pub let to_str_significant(f: Flt, n: Nat, @ok: Holds(0 < n)) -> Str =
    match n
    | 0 => match ok end
    | k + 1 => to_str_significant_in(Rounding/ties_to_even(), f, k + 1)
    end;

satisfy Eql(Flt) {
    eql = eql,
    neq = neq,
}

satisfy Cmp(Flt) {
    lt = lt,
    le = le,
    gt = gt,
    ge = ge,
}

satisfy Add(Flt) {
    add = add,
}

satisfy Sub(Flt) {
    sub = sub,
}

satisfy Mul(Flt) {
    mul = mul,
}

--- No precondition: IEEE division is total.
satisfy Div(Flt) {
    Ok(_) = True,
    div(a, b) = div(a, b),
}

--- No precondition: IEEE remainder is total.
satisfy Rem(Flt) {
    Ok(_) = True,
    rem(a, b) = rem(a, b),
}

satisfy Show(Flt) {
    show = to_str,
}

--- A finite value spells as a literal, the sign dropped and a point added where `to_str` wrote none; the infinities and the default NaN of either sign spell as their literals, and any other NaN as the eight bytes that build it, so what reads back is the same pattern.
satisfy Spell(Flt) {
    spell(f) =
        match is_finite(f)
        | false =>
            choose
            | f > +0.0 => "+inf.0"
            | f < +0.0 => "-inf.0"
            | exact/bits(f) == exact/bits(+nan.0) => "+nan.0"
            | exact/bits(f) == exact/bits(-nan.0) => "-nan.0"
            | _ =>
                let atoms =
                    Bytes/fold(
                        to_le_bytes(f),
                        "",
                        (b, acc) =>
                            let atom = Nat/to_str(Byte/to_nat(b));
                            match Str/is_empty(acc)
                            | true => atom
                            | false => Str/concat(Str/concat(acc, ", "), atom)
                            end);
                Fmt/render("/std/Flt/of_le_bytes(x[%], @/std/Bool/True/qed())")(atoms)
            end
        | true =>
            let raw = to_str(f);
            let unsigned =
                match Str/strip_prefix(raw, "+") | some(bare) => bare | none() => raw end;
            match Str/contains(unsigned, '.') || Str/contains(unsigned, 'e')
            | true => unsigned
            | false => Str/concat(unsigned, ".0")
            end
        end,
}

satisfy Ord(Flt) {
    ord = ord,
}
