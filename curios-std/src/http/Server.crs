use /std/{Bytes, Str, Nat, Bool, Option, Result, Try, Async, Io};
use /std/tcp/{Socket, Listener};
use /std/http/{Url, Request, Response, Limits};

--- A bound server: the listener its connections arrive on.
pub struct Server: Type {
    Listener,
}

--- The handler a server runs per request: given the request, it answers with the response to send. The server writes it and closes the connection.
pub let Handler: Type =
    (Request) -> Try(Async, Io/Error, Response);

--- A server bound to `host` at `port`.
pub let listen(host: Str, port: Nat) -> Try(Async, Io/Error, Server) =
    let l = Listener/listen(host, port)!;
    Try/pure(Server { l });

--- Close `s`.
pub let close(s: Server) -> Io({}) =
    Listener/close(s.0);

--- Whether the bytes held are a request that has all arrived, or one that never will be a request: anything but one that is only cut short so far.
let settled(held: Bytes) -> Bool =
    match Request/of_bytes(Limits/server, Url/Scheme/http(), held)
    | failure(incomplete()) => false
    | _ => true
    end;

--- The bytes `c` sends, read until they hold a whole request or one that is refused, or the peer closes.
let request_bytes(c: Socket) -> Async(Result(Io/Error, Bytes)) =
    let go(acc: Bytes, fuel: Nat) -> Async(Result(Io/Error, Bytes)) =
        match settled(acc) || fuel == 0
        | true => Async/pure(Result/success(acc))
        | false =>
            let next = Socket/read(c, 4096)!;
            match next
            | chunk(bytes) => go(x[..acc, ..bytes], fuel - 1)
            | eof() => Async/pure(Result/success(acc))
            | error(e) => Async/pure(Result/failure(e))
            end
        end;
    go(x[], 1024);

--- The request `c` sent, or `none` where its bytes do not read as one. A wire failure is raised, and `c` is left open either way for the caller to answer and close.
pub let read_request(c: Socket) -> Try(Async, Io/Error, Option(Request)) =
    let bytes = Try/attempt(request_bytes(c))!;
    Try/pure(
        match Request/of_bytes(Limits/server, Url/Scheme/http(), bytes)
        | success(request) => Option/some(request)
        | failure(_) => Option/none()
        end);

let send(c: Socket, response: Response) -> Async(Result(Io/Error, {})) =
    Socket/write(c, Response/render(response));

let answer(c: Socket, handler: Handler) -> Async({}) =
    let read = Try/run(read_request(c))!;
    match read
    | failure(_) => Async/pure(())
    | success(parsed) =>
        match parsed
        | none() =>
            let _ = send(c, Response/of_text(400, "bad request"))!;
            Async/pure(())
        | some(request) =>
            let answered = Try/run(handler(request))!;
            match answered
            | success(response) =>
                let _ = send(c, response)!;
                Async/pure(())
            | failure(_) => Async/pure(())
            end
        end
    end;

--- Every connection to `host` at `port` answered by `handler`, one request per connection in a fiber of its own, the connection closed whichever way the handler ends, until an accept fails. Written over `Listener/serve`, so a slow request holds up no other connection.
pub let serve(host: Str, port: Nat, handler: Handler) -> Try(Async, Io/Error, {}) =
    Listener/serve(host, port, (c) => answer(c, handler));
