use /std/{Bytes, Str, Nat, Bool, List, Result, Try, Async, Io};
use /std/time/{Duration};
use /std/tcp/{Socket, Listener};
use /std/http/{Method, Url, Field, Request, Response, Version, Limits, Refusal, Framing, read,
    stream};
use /std/http/Url/{Scheme};

--- How a server reads a request and ends a connection: how much of a request it takes, how long a request may take to arrive whole, and how long it reads on from a peer that has gone quiet once it has answered.
pub struct Server: pub Type {
    --- What a request may hold. Past them it is answered 414, a request line too long; 431, a head too large; and 413, content too large.
    limits: Limits,
    --- A request that has not arrived whole within this is answered 408.
    deadline: Duration,
    --- Once it has answered, a server reads what its peer still sends until the peer closes; a peer that sends nothing for this long is closed on.
    quiet: Duration,
}

--- `Limits/server`'s bounds, thirty seconds for a request to arrive, and a second of quiet.
pub let default: Server =
    Server { limits = Limits/server, deadline = Duration/of_secs(30), quiet = Duration/of_secs(1) };

--- The handler a server runs per request: given the request, it answers with the response to send. The server writes it and ends the connection.
pub let Handler: Type =
    (Request) -> Try(Async, Io/Error, Response);

-- Whether the request `head` expects `100 Continue` before it sends its content (RFC 9110 §10.1.1): an HTTP/1.1 request whose `Expect` lists it.
let expects_continue(head: Request/Head) -> Bool =
    Version/is_1_1(head.version)
        && List/any(
            Field/members(head.headers, "Expect"),
            (member) =>
                match Str/of_bytes(member)
                | some(expectation) => Str/eql_ascii_ci(expectation, "100-continue")
                | none() => false
                end);

-- How reading a request stopped short of one: with the refusal the server answers, or with nothing to answer — a peer that connected and sent nothing, or a wire that failed.
induct Unread: Type
| refused(Refusal)
| silent()
end

-- A request's head with what it alone decides: where the request is addressed and how its body is delimited.
struct Opened: Type {
    head: Request/Head,
    url: Url,
    framing: Framing,
}

let opened(scheme: Scheme, lines: Bytes) -> Result(Refusal, Opened) =
    let head = Request/head_of(lines)!;
    let framing = Request/framing(head)!;
    let url = Request/url_of(scheme, head)!;
    Result/success(Opened { head = head, url = url, framing = framing });

-- `100 Continue` written to `c` where the request expects it and its body is still to arrive: one whose head already refuses it, or whose content came with its head, is not invited to send it.
let invite(limits: Limits, c: Socket, o: Opened, held: Bytes) -> Async(Result(Io/Error, {})) =
    match expects_continue(o.head)
    | false => Async/pure(Result/success(()))
    | true =>
        match read/body(limits, o.framing, x[], held)
        | more(_, _) => Socket/write(c, Str/to_bytes("HTTP/1.1 100 Continue\r\n\r\n"))
        | _ => Async/pure(Result/success(()))
        end
    end;

-- The request `c` sends, read as its framing delimits it: the head, then everything a head alone decides — the address, the framing, whether the peer waits to be told to continue — and only then the body.
let request(limits: Limits, scheme: Scheme, c: Socket) -> Async(Result(Unread, Request)) =
    let first =
        stream/fetch(
            c,
            (searched: Nat, held: Bytes) => read/head(limits, true, searched, held),
            0,
            x[])!;
    match first
    | failure(stop) =>
        Async/pure(
            Result/failure(
                match stop
                | refused(why) => Unread/refused(why)
                | failed(_) => Unread/silent()
                | ended((_, held)) =>
                    match Bytes/len(held)
                    | 0 => Unread/silent()
                    | _ => Unread/refused(Refusal/incomplete())
                    end
                end))
    | success((lines, rest)) =>
        match opened(scheme, lines)
        | failure(why) => Async/pure(Result/failure(Unread/refused(why)))
        | success(o) =>
            let invited = invite(limits, c, o, rest)!;
            match invited
            | failure(_) => Async/pure(Result/failure(Unread/silent()))
            | success(_) =>
                let content = stream/body(limits, c, o.framing, rest)!;
                Async/pure(
                    match content
                    | success((body, _)) =>
                        Result/success(
                            Request {
                                method = o.head.method,
                                url = o.url,
                                headers = o.head.headers,
                                body = body,
                            })
                    | failure(stop) =>
                        Result/failure(
                            match stop
                            | refused(why) => Unread/refused(why)
                            | ended(_) => Unread/refused(Refusal/incomplete())
                            | failed(_) => Unread/silent()
                            end)
                    end)
            end
        end
    end;

-- What `c`'s peer still sends, read and dropped until the peer closes, sends nothing for `quiet`, or has sent `left` octets.
let drain(c: Socket, quiet: Duration, left: Nat) -> Async({}) =
    match left
    | 0 => Async/pure(())
    | _ =>
        let arrived = Async/timeout(quiet, Socket/read(c, 65536))!;
        match arrived
        | none() => Async/pure(())
        | some(read) =>
            match read
            | chunk(bytes) => drain(c, quiet, left - Nat/min(left, Bytes/len(bytes)))
            | eof() => Async/pure(())
            | error(_) => Async/pure(())
            end
        end
    end;

-- `reply` written to `c` in answer to a request of `method` — its head alone where the method is `HEAD`, stating the length its body has — and the connection ended as RFC 9112 §9.6 asks: the sending half first, then what the peer still sends read on, since a close over unread bytes would reset the connection under the reply.
let send(s: Server, c: Socket, method: Method, reply: Response) -> Async({}) =
    let bytes =
        match method
        | head() => Response/render_head(reply, reply.body)
        | _ => Response/render(reply)
        end;
    let wrote = Socket/write(c, bytes)!;
    match wrote
    | failure(_) => Async/pure(())
    | success(_) =>
        let _ = Async/Write/flush(c)!;
        let _ = Socket/finish(c)!;
        drain(c, s.quiet, s.limits.head + s.limits.content)
    end;

--- What a server does with one connection of `scheme`: read a request as its framing delimits it, hand it to `handler`, write the reply, and end the connection as HTTP asks — the sending half ended, what the peer still sends read until it closes or falls quiet, and the close left to whoever opened the connection. A request the reader refuses is answered with the status its refusal names, one that has not arrived whole within `s.deadline` 408, and a handler that fails 500; a peer that sends nothing is told nothing. `serve` and `serve_tls` run it over a listener of their own, and a program with a listener of its own hands it each socket it accepts.
pub let answer(s: Server, scheme: Scheme, handler: Handler) -> (Socket) -> Async({}) =
    (c) =>
        let arrived = Async/timeout(s.deadline, request(s.limits, scheme, c))!;
        match arrived
        | none() => send(s, c, Method/get(), Response/of_refusal(Refusal/timed_out()))
        | some(read) =>
            match read
            | failure(why) =>
                match why
                | refused(reason) => send(s, c, Method/get(), Response/of_refusal(reason))
                | silent() => Async/pure(())
                end
            | success(asked) =>
                let answered = Try/run(handler(asked))!;
                match answered
                | success(reply) => send(s, c, asked.method, reply)
                | failure(_) =>
                    send(s, c, asked.method, Response/of_text(500, "the handler failed"))
                end
            end
        end;

--- Every connection to `host` at `port` answered by `handler` as `answer` answers one, in the clear: one request per connection in a fiber of its own, until an accept fails. A slow request holds up no other connection.
pub let serve(s: Server, host: Str, port: Nat, handler: Handler) -> Try(Async, Io/Error, {}) =
    Listener/serve(host, port, answer(s, Scheme/http(), handler));

--- `serve` under TLS: every connection is upgraded with the certificate chain `cert` and the private key `key` before a request is read from it.
pub let serve_tls(
    s: Server,
    host: Str,
    port: Nat,
    cert: Bytes,
    key: Bytes,
    handler: Handler,
) -> Try(Async, Io/Error, {}) =
    Listener/serve_tls(host, port, cert, key, answer(s, Scheme/https(), handler));
