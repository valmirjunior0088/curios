use /std/{Bytes, Byte, Str, Nat, Bool, List, Option, Result, Spell};
use /std/Bool/{Holds};
use /std/ops/{Eql};
use /std/http/{Method, Url, Field, Version, Limits, Refusal, Framing, read, syntax};
use /std/http/Field/{Name, Value};
use /std/http/Url/{Scheme};

--- What is sent: the method, where to, the headers and the body. Where to is the URL, whose scheme decides the connection and whose host and port the `Host` header.
pub struct Request: pub Type {
    method: Method,
    url: Url,
    headers: List(Field),
    body: Bytes,
}

satisfy Eql(Request) {
    ..
}

satisfy Spell(Request) {
    ..
}

--- A `GET` of `url`.
pub let get(url: Url) -> Request =
    Request { method = Method/get(), url = url, headers = [], body = x[] };

--- A `POST` of `body` to `url`.
pub let post(url: Url, body: Bytes) -> Request =
    Request { method = Method/post(), url = url, headers = [], body = body };

--- `r` with the field `name: value` appended to its headers. A field the renderer owns — `Host`, `Content-Length`, `Transfer-Encoding`, `Connection` — is kept and not sent.
pub let with_header(
    r: Request,
    name: Str,
    value: Str,
    @Holds(Name/is_token(name)),
    @Holds(Bytes/all(Str/to_bytes(value), Value/admits)),
) -> Request =
    Request { ..r, headers = [..r.headers, Field/of(name, value)] };

--- The value of the first header named `name`, compared without case, or `none`.
pub let header(r: Request, name: Str) -> Option(Value) =
    Field/find(r.headers, name);

let host_header(u: Url) -> Str =
    match u.port == Url/default_port(u.scheme)
    | true => u.host
    | false => Str/flatten([u.host, ":", Nat/to_str(u.port)])
    end;

--- The request target: the path, and the query after it when there is one.
pub let target(u: Url) -> Str =
    match u.query | some(q) => Str/flatten([u.path, "?", q]) | none() => u.path end;

--- Whether a request's renderer writes the field named `name` itself: `Host`, the framing fields and `Connection`. A caller's own field of one of these names is not sent.
pub let owned(name: Name) -> Bool =
    Name/is(name, "Host") || Name/is(name, "Content-Length") || Name/is(name, "Transfer-Encoding")
        || Name/is(name, "Connection");

--- Whether a request of method `m` states its length even where it has no content: the methods that define a meaning for content sent with them (RFC 9110 §8.6).
let states_length(m: Method) -> Bool =
    match m
    | post() => true
    | put() => true
    | patch() => true
    | _ => false
    end;

let length_line(r: Request) -> Bytes =
    match Bytes/len(r.body) != 0 || states_length(r.method)
    | true => Str/to_bytes(Str/flatten(["Content-Length: ", Nat/to_str(Bytes/len(r.body)), "\r\n"]))
    | false => x[]
    end;

--- The request as the bytes sent on the wire: the request line as HTTP/1.1, `Host`, `Connection: close`, since a client keeps no connection, the length where there is a body or the method always states one, the headers the renderer does not own, then the body. The target and the host are written percent-encoded wherever the wire cannot carry an octet of them, so every request is one a wire can carry and there is nothing to refuse.
pub let render(r: Request) -> Bytes =
    x[
        ..Str/to_bytes(Method/to_str(r.method)),
        ' ',
        ..Url/escaped(target(r.url)).bytes,
        ..Str/to_bytes(" HTTP/1.1\r\nHost: "),
        ..Url/escaped(host_header(r.url)).bytes,
        ..Str/to_bytes("\r\nConnection: close\r\n"),
        ..length_line(r),
        ..Field/lines(r.headers, owned),
        '\r',
        '\n',
        ..r.body];

--- A request's head as it is read: the method, the target as its request line spells it, the version it states and its headers.
pub struct Head: pub Type {
    method: Method,
    target: Str,
    version: Version,
    headers: List(Field),
}

satisfy Eql(Head) {
    ..
}

satisfy Spell(Head) {
    ..
}

-- The method `b` spells: malformed where it is no token, and not implemented where it is one this library does not name.
let method_of(b: Bytes) -> Result(Refusal, Method) =
    match Str/of_bytes(b)
    | none() => Result/failure(Refusal/malformed("a method is a token"))
    | some(spelled) =>
        match Name/is_token(spelled)
        | false => Result/failure(Refusal/malformed("a method is a token"))
        | true =>
            match Method/of_str(spelled)
            | some(method) => Result/success(method)
            | none() => Result/failure(Refusal/not_implemented(Str/concat("the method ", spelled)))
            end
        end
    end;

--- The head `bytes` spell, the bytes of a request line and its field lines: a request line of a method, a target and a version between single spaces, and field lines none of which begins with whitespace (RFC 9112 §3, §5). A method this library does not name is not implemented, a major version other than 1 not supported, and anything else that is no head malformed.
pub let head_of(bytes: Bytes) -> Result(Refusal, Head) =
    match syntax/lines(bytes)
    | [] => Result/failure(Refusal/malformed("a request begins with its request line"))
    | [first, ..rest] =>
        let parts = syntax/request_line(first)!;
        let version = syntax/version(parts.version)!;
        let method = method_of(parts.method)!;
        let headers = syntax/fields(rest, false)!;
        match Str/of_bytes(parts.target)
        | some(target) =>
            Result/success(
                Head { method = method, target = target, version = version, headers = headers })
        | none() => Result/failure(Refusal/malformed("a request target is text"))
        end
    end;

-- Whether `host` is what a `Host` field holds: a host and, after a colon, a port, with none of what would begin a path, a query, a fragment or user information.
let is_authority(host: Str) -> Bool =
    Bool/not(Str/is_empty(host))
        && Bytes/all(
            Str/to_bytes(host),
            (b) =>
                let n = Byte/to_nat(b);
                Nat/in_range(n, 33, 126) && n != '/' && n != '?' && n != '#' && n != '@');

-- The authority a request's `Host` fields state: the one field's value, where there is one field and its value is an authority.
let host_of(headers: List(Field)) -> Result(Refusal, Option(Str)) =
    let stated(one: Field) -> Result(Refusal, Option(Str)) =
        match Value/to_str(one.value)
        | some(host) =>
            match is_authority(host)
            | true => Result/success(Option/some(host))
            | false =>
                Result/failure(Refusal/malformed("Host is a host and, after a colon, a port"))
            end
        | none() => Result/failure(Refusal/malformed("Host is a host and, after a colon, a port"))
        end;
    match List/filter(headers, (f: Field) => Name/is(f.name, "Host"))
    | [] => Result/success(Option/none())
    | [one, ..others] =>
        match others
        | [] => stated(one)
        | _ => Result/failure(Refusal/malformed("a request states one Host"))
        end
    end;

let read_url(text: Str) -> Result(Refusal, Url) =
    match Url/of_str(text)
    | success(url) => Result/success(url)
    | failure(why) => Result/failure(Refusal/malformed(why.message))
    end;

-- Where a request whose target is a path or a whole URL is addressed, `host` being the authority its `Host` field states.
let resource_of(scheme: Scheme, head: Head, host: Option(Str)) -> Result(Refusal, Url) =
    match (Str/contains(head.target, '#'), Str/starts_with(head.target, "/"))
    | (true, _) => Result/failure(Refusal/malformed("a request target has no fragment"))
    | (false, true) =>
        match host
        | some(authority) =>
            read_url(Str/flatten([Url/scheme_str(scheme), "://", authority, head.target]))
        | none() => Result/failure(Refusal/malformed("a request names its host"))
        end
    | (false, false) =>
        match (Url/of_str(head.target), Option/is_none(host) && Version/is_1_1(head.version))
        | (failure(_), _) =>
            Result/failure(Refusal/malformed("a request target is a path or a whole URL"))
        | (success(_), true) =>
            Result/failure(Refusal/malformed("an HTTP/1.1 request states its Host"))
        | (success(url), false) => Result/success(url)
        end
    end;

--- What a request is addressed to: a resource, by its URL, or the server as a whole, which is what `OPTIONS *` asks about (RFC 9112 §3.2.4).
pub induct Address: pub Type
| resource(Url)
| server()
end

satisfy Eql(Address) {
    ..
}

satisfy Spell(Address) {
    ..
}

--- What the request `head` is addressed to, over a connection of `scheme` (RFC 9112 §3.2, §3.3). A target in origin-form, a path and its query, is joined to the authority its one `Host` field states; one in absolute-form, a whole URL, is the address, with `Host` ignored though HTTP/1.1 still owes one; and `*` is the server itself, which only `OPTIONS` is asked of, an HTTP/1.1 request still owing its `Host`. A request for a resource with no authority, one with two `Host` fields or one that is no authority, and one with a target of none of those forms, is malformed.
pub let address_of(scheme: Scheme, head: Head) -> Result(Refusal, Address) =
    let host = host_of(head.headers)!;
    match Str/eql(head.target, "*")
    | false => Result/map_success(resource_of(scheme, head, host), (url) => Address/resource(url))
    | true =>
        choose
        | head.method != Method/options() =>
            Result/failure(Refusal/malformed("only OPTIONS is asked of the server itself"))
        | Option/is_none(host) && Version/is_1_1(head.version) =>
            Result/failure(Refusal/malformed("an HTTP/1.1 request states its Host"))
        | _ => Result/success(Address/server())
        end
    end;

--- The URL of the resource the request `head` is addressed to, as `address_of` reads it. A request for the server itself has none and is refused: a `Request` is addressed to a resource.
pub let url_of(scheme: Scheme, head: Head) -> Result(Refusal, Url) =
    let address = address_of(scheme, head)!;
    match address
    | resource(url) => Result/success(url)
    | server() => Result/failure(Refusal/malformed("a request for the server itself has no URL"))
    end;

--- How the body of the request `head` is delimited.
pub let framing(head: Head) -> Result(Refusal, Framing) =
    Framing/of_request(head.version, head.headers);

--- The request `head` and `body` make, over a connection of `scheme`.
pub let from_head(scheme: Scheme, head: Head, body: Bytes) -> Result(Refusal, Request) =
    let url = url_of(scheme, head)!;
    Result/success(
        Request { method = head.method, url = url, headers = head.headers, body = body });

--- A whole request read from `bytes`, as a server over a connection of `scheme` reads it within `limits`: the head, the framing its fields state, the body that framing delimits, and the URL its target and its `Host` address. What follows the request is not read. A request that has not all arrived is `incomplete`.
pub let of_bytes(limits: Limits, scheme: Scheme, bytes: Bytes) -> Result(Refusal, Request) =
    match read/head(limits, true, 0, bytes)
    | more(_, _) => Result/failure(Refusal/incomplete())
    | refused(why) => Result/failure(why)
    | took(lines, rest) =>
        let head = head_of(lines)!;
        let delimited = framing(head)!;
        let (body, _) = read/whole(limits, delimited, rest)!;
        from_head(scheme, head, body)
    end;
