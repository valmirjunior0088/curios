use /std/{Bytes, Byte, Str, Nat, Bool, List, Option, Parse, Spell};
use /std/Bool/{Holds};
use /std/ops/{Eql};
use /std/http/{Method, Url, Field};
use /std/http/Field/{Name, Value};

--- What is sent: the method, where to, the headers and the body. Where to is the URL, whose scheme decides the connection and whose host and port the `Host` header.
pub struct Request: pub Type {
    method: Method,
    url: Url,
    headers: List(Field),
    body: Bytes,
}

satisfy Eql(Request) {
    ..
}

satisfy Spell(Request) {
    ..
}

--- A `GET` of `url`.
pub let get(url: Url) -> Request =
    Request { method = Method/get(), url = url, headers = [], body = x[] };

--- A `POST` of `body` to `url`.
pub let post(url: Url, body: Bytes) -> Request =
    Request { method = Method/post(), url = url, headers = [], body = body };

--- `r` with the field `name: value` appended to its headers. A field the renderer owns — `Host`, `Content-Length`, `Transfer-Encoding`, `Connection` — is kept and not sent.
pub let with_header(
    r: Request,
    name: Str,
    value: Str,
    @Holds(Name/is_token(name)),
    @Holds(Bytes/all(Str/to_bytes(value), Value/admits)),
) -> Request =
    Request { ..r, headers = [..r.headers, Field/of(name, value)] };

--- The value of the first header named `name`, compared without case, or `none`.
pub let header(r: Request, name: Str) -> Option(Value) =
    Field/find(r.headers, name);

let host_header(u: Url) -> Str =
    match u.port == Url/default_port(u.scheme)
    | true => u.host
    | false => Str/flatten([u.host, ":", Nat/to_str(u.port)])
    end;

--- The request target: the path, and the query after it when there is one.
pub let target(u: Url) -> Str =
    match u.query | some(q) => Str/flatten([u.path, "?", q]) | none() => u.path end;

--- Whether a request's renderer writes the field named `name` itself: `Host`, the framing fields and `Connection`. A caller's own field of one of these names is not sent.
pub let owned(name: Name) -> Bool =
    Name/is(name, "Host") || Name/is(name, "Content-Length") || Name/is(name, "Transfer-Encoding")
        || Name/is(name, "Connection");

--- Whether a request of method `m` states its length even where it has no content: the methods that define a meaning for content sent with them (RFC 9110 §8.6).
let states_length(m: Method) -> Bool =
    match m
    | post() => true
    | put() => true
    | patch() => true
    | _ => false
    end;

let length_line(r: Request) -> Bytes =
    match Bytes/len(r.body) != 0 || states_length(r.method)
    | true => Str/to_bytes(Str/flatten(["Content-Length: ", Nat/to_str(Bytes/len(r.body)), "\r\n"]))
    | false => x[]
    end;

--- The request as the bytes sent on the wire: the request line as HTTP/1.1, `Host`, `Connection: close`, since a client keeps no connection, the length where there is a body or the method always states one, the headers the renderer does not own, then the body. The target and the host are written percent-encoded wherever the wire cannot carry an octet of them, so every request is one a wire can carry and there is nothing to refuse.
pub let render(r: Request) -> Bytes =
    x[
        ..Str/to_bytes(Method/to_str(r.method)),
        ' ',
        ..Url/escaped(target(r.url)).bytes,
        ..Str/to_bytes(" HTTP/1.1\r\nHost: "),
        ..Url/escaped(host_header(r.url)).bytes,
        ..Str/to_bytes("\r\nConnection: close\r\n"),
        ..length_line(r),
        ..Field/lines(r.headers, owned),
        '\r',
        '\n',
        ..r.body];

let until(target: Byte) -> (Byte) -> Bool =
    (byte) => Bool/not(byte == target);

let text(b: Bytes) -> Parse(Bytes, Str) =
    match Str/of_bytes(b)
    | some(s) => Parse/pure(s)
    | none() => Parse/fail("a request is text before its body")
    end;

let request_line: Parse(Bytes, {Method, Str}) =
    let m = Parse/bytes/take_while(until(' '))!;
    let _ = Parse/bytes/expect(' ')!;
    let t = Parse/bytes/take_while(until(' '))!;
    let _ = Parse/bytes/expect(' ')!;
    let _ = Parse/bytes/take_while(until('\r'))!;
    let _ = Parse/bytes/literal("\r\n")!;
    let spelled = text(m)!;
    let target = text(t)!;
    match Method/of_str(spelled)
    | some(method) => Parse/pure((method, target))
    | none() => Parse/fail(Str/flatten(["unknown method '", spelled, "'"]))
    end;

let guard_header: Parse(Bytes, {}) =
    let next = Parse/bytes/peek!;
    match next
    | none() => Parse/fail("unexpected end of headers")
    | some(byte) =>
        match byte == '\r' | true => Parse/fail("end of header block") | false => Parse/pure(()) end
    end;

--- One `name: value` line; the value is trimmed. A name that is no token and a value holding a control octet are refused.
pub let header_line: Parse(Bytes, Field) =
    let _ = guard_header!;
    let name = Parse/bytes/take_while(until(':'))!;
    let _ = Parse/bytes/expect(':')!;
    let value = Parse/bytes/take_while(until('\r'))!;
    let _ = Parse/bytes/literal("\r\n")!;
    let n = text(name)!;
    let v = text(value)!;
    match Field/read(n, Str/to_bytes(Str/trim(v)))
    | some(field) => Parse/pure(field)
    | none() =>
        Parse/commit(Parse/fail("a field's name is a token, and its value holds no control octet"))
    end;

let lookup(headers: List(Field), name: Str) -> Option(Str) =
    Option/bind(Field/find(headers, name), Value/to_str);

let body_of(headers: List(Field)) -> Parse(Bytes, Bytes) =
    match Option/bind(lookup(headers, "Content-Length"), Nat/of_str)
    | some(n) => Parse/bytes/take(n)
    | none() => Parse/pure(x[])
    end;

let url_of(headers: List(Field), target: Str) -> Parse(Bytes, Url) =
    let authority = Option/unwrap_or(lookup(headers, "Host"), "localhost");
    match Url/of_str(Str/flatten(["http://", authority, target]))
    | success(u) => Parse/pure(u)
    | failure(why) => Parse/fail(why.message)
    end;

--- A whole request as a server reads it: the request line, the headers, then `Content-Length` bytes of body or none. The URL is rebuilt from `Host` and the target, under `http`, since the wire does not say.
pub let decode: Parse(Bytes, Request) =
    let (method, target) = request_line!;
    let headers = Parse/many0(header_line)!;
    let _ = Parse/bytes/literal("\r\n")!;
    let body = body_of(headers)!;
    let url = url_of(headers, target)!;
    Parse/pure(Request { method = method, url = url, headers = headers, body = body });
