use /std/{Bytes, Byte, Nat, Bool, Option, Result};
use /std/Bool/{True, Holds};
use /std/http/{Limits, Refusal, Framing};
use /std/http/Field/{Value};
use /std/Io/{Reader};

let is(b: Bytes, i: Nat, byte: Nat) -> Bool =
    match Bytes/try_get(b, i) | some(x) => Byte/to_nat(x) == byte | none() => false end;

--- Where a search of `b` from `from` on found what it sought: an index at or after `from`, with `room` bytes of `b` from it on, so a cut there needs no bound decided again.
pub let Found(b: Bytes, from: Nat, room: Nat) -> Type =
    {at: Nat, onward: Holds(from <= at), within: Holds(at + room <= Bytes/len(b))};

-- The search behind `line_end`, the index it began at carried down so the answer states it and the walk is a loop.
let line_end_from(
    b: Bytes,
    from: Nat,
    i: Nat,
    @onward: Holds(from <= i),
) -> Option(Found(b, from, 2)) =
    match Bool/holds(i + 1 < Bytes/len(b))
    | none() => Option/none()
    | some(room) =>
        match is(b, i, '\r') && is(b, i + 1, '\n')
        | true => Option/some((at = i, onward = onward, within = True/proved()))
        | false => line_end_from(b, from, i + 1)
        end
    end;

--- Where the first line end at or after `i` begins in `b`, both its bytes within `b`, or `none`.
pub let line_end(b: Bytes, i: Nat) -> Option(Found(b, i, 2)) =
    line_end_from(b, i, i);

--- How far a head's reading has come in the bytes held: where its start line begins, past the empty lines a lenient reading passes over; how many octets it has searched; how many of the four octets of the empty line that ends a head the searched octets end with, none of them before the start line; and whether the start line has ended among them.
pub struct Searched: pub Type {
    start: Nat,
    through: Nat,
    ending: Nat,
    lined: Bool,
    @begun: Holds(start + ending <= through),
}

--- A head's reading before it has searched anything.
pub let unsearched: Searched =
    Searched { start = 0, through = 0, ending = 0, lined = false };

-- The reading of a head carried from `s` on, an octet at a time, until its empty line ends it, a bound refuses it, or every octet held is searched. What a bound measures is what is known to be the start line's or the head's, which the octets the empty line may begin with are not, so a verdict does not depend on where the bytes were cut.
let head_from(
    limits: Limits,
    lenient: Bool,
    s: Searched,
    held: Bytes,
) -> Reader/Step(Searched, Refusal, Bytes) =
    let i = s.through;
    let next(
        ending: Nat,
        lined: Bool,
        @ok: Holds(s.start + ending <= i + 1),
    ) -> Reader/Step(Searched, Refusal, Bytes) =
        head_from(
            limits,
            lenient,
            Searched { start = s.start, through = i + 1, ending = ending, lined = lined },
            held);
    match Bool/holds(i < Bytes/len(held))
    | none() =>
        let known = Bytes/len(held) - s.ending;
        choose
        | Bool/not(s.lined) && known - s.start > limits.line =>
            Reader/Step/refused(Refusal/line_too_long())
        | known > limits.head => Reader/Step/refused(Refusal/head_too_large())
        | _ => Reader/Step/more(s, held)
        end
    | some(inside) =>
        let byte = Byte/to_nat(Bytes/get(held, i));
        match byte == '\r'
        | true => match s.ending == 2 | true => next(3, s.lined) | false => next(1, s.lined) end
        | false =>
            match (byte == '\n', s.ending == 3, s.ending == 1)
            | (true, true, _) =>
                let at = i - 3;
                match at <= limits.head
                | true =>
                    Reader/Step/took(
                        Bytes/slice(held, s.start, at - s.start),
                        Bytes/drop(held, i + 1))
                | false => Reader/Step/refused(Refusal/head_too_large())
                end
            | (true, false, true) =>
                match s.lined
                | true => next(2, true)
                | false =>
                    choose
                    | lenient && i - 1 == s.start =>
                        head_from(
                            limits,
                            lenient,
                            Searched { start = i + 1, through = i + 1, ending = 0, lined = false },
                            held)
                    | i - 1 - s.start <= limits.line => next(2, true)
                    | _ => Reader/Step/refused(Refusal/line_too_long())
                    end
                end
            | _ => next(0, s.lined)
            end
        end
    end;

--- A message's head: the bytes of its start line and its fields, their line ends between them, without the empty line that ends them. `lenient` passes over the empty lines a request may be preceded by (RFC 9112 §2.2). The state is how far the reading has come, so a look reads only the octets that arrived since the last. A start line past `limits.line` is refused, and so is a head past `limits.head`, the empty lines before it counted.
pub let head(
    limits: Limits,
    lenient: Bool,
    searched: Searched,
    held: Bytes,
) -> Reader/Step(Searched, Refusal, Bytes) =
    head_from(limits, lenient, searched, held);

--- A body of `n` bytes: the bytes held once there are that many. One longer than `limits.content` is refused before any of it is read.
pub let length(limits: Limits, n: Nat, held: Bytes) -> Reader/Step({}, Refusal, Bytes) =
    match n <= limits.content
    | false => Reader/Step/refused(Refusal/content_too_large())
    | true =>
        match n <= Bytes/len(held)
        | true => Reader/Step/took(Bytes/slice(held, 0, n), Bytes/drop(held, n))
        | false => Reader/Step/more((), held)
        end
    end;

let hex(byte: Byte) -> Option(Nat) =
    let n = Byte/to_nat(byte);
    choose
    | Nat/in_range(n, '0', '9') => Option/some(n - '0')
    | Nat/in_range(n, 'a', 'f') => Option/some(n - 'a' + 10)
    | Nat/in_range(n, 'A', 'F') => Option/some(n - 'A' + 10)
    | _ => Option/none()
    end;

-- A chunk's size, read from its size line: hexadecimal digits, one or more, then nothing or an extension, which begins with `;` and holds no control octet. Anything else is no size line.
let chunk_size(line: Bytes) -> Option(Nat) =
    let go(i: Nat, value: Nat, digits: Nat) -> Option(Nat) =
        match Bool/holds(i < Bytes/len(line))
        | none() => match digits | 0 => Option/none() | _ => Option/some(value) end
        | some(inside) =>
            let byte = Bytes/get(line, i, @inside);
            match hex(byte)
            | some(d) => go(i + 1, value * 16 + d, digits + 1)
            | none() =>
                match Byte/to_nat(byte) == ';' && digits != 0
                    && Bytes/all(Bytes/drop(line, i), Value/admits)
                | true => Option/some(value)
                | false => Option/none()
                end
            end
        end;
    go(0, 0, 0);

--- How far into a chunk the reading of a chunked body has come, in bytes held that begin at the chunk's size line.
pub induct Chunking: pub Type
--- Through `searched` octets of the size line, `ending` saying whether the last of them is a carriage return.
| size_line(searched: Nat, ending: Bool)
--- Into a chunk whose size line ends at `at` and states its `size`, until its data and the line end after it have arrived.
| data(at: Nat, size: Nat)
--- Past the size line of the last chunk, which ends at `at`, through `searched` octets of the trailer section, whose unfinished line begins at `line` and `ending` as for a size line.
| trailers(at: Nat, line: Nat, searched: Nat, ending: Bool)
end

--- What a body's reading has decoded, and where it resumes: the content of a chunked body's whole chunks, and how far into the next it has come. A body framed otherwise decodes nothing and leaves both as they were.
pub struct Decoded: pub Type {
    content: Bytes,
    at: Chunking,
}

--- A body's reading before it has decoded anything.
pub let undecoded: Decoded =
    Decoded { content = x[], at = Chunking/size_line(0, false) };

-- How many octets a carriage return the searched octets end with adds to what is known.
let carried(ending: Bool) -> Nat =
    match ending | true => 1 | false => 0 end;

-- A chunk's size line searched from `i` on, `ending` saying whether the octet before `i` is a carriage return: the chunk it states once it ends, more wanted until then. Its length is measured as a head's is, by what is known to be the line's.
let size_from(
    limits: Limits,
    content: Bytes,
    i: Nat,
    ending: Bool,
    held: Bytes,
) -> Reader/Step(Decoded, Refusal, Bytes) =
    match Bool/holds(i < Bytes/len(held))
    | none() =>
        match Bytes/len(held) - carried(ending) <= limits.chunk_line
        | true =>
            Reader/Step/more(
                Decoded { content = content, at = Chunking/size_line(i, ending) },
                held)
        | false => Reader/Step/refused(Refusal/malformed("a chunk's size line is too long"))
        end
    | some(inside) =>
        let byte = Byte/to_nat(Bytes/get(held, i));
        match ending && byte == '\n'
        | false => size_from(limits, content, i + 1, byte == '\r', held)
        | true =>
            let at = i - 1;
            match (at <= limits.chunk_line, chunk_size(Bytes/slice(held, 0, at)))
            | (false, _) =>
                Reader/Step/refused(Refusal/malformed("a chunk's size line is too long"))
            | (true, none()) =>
                Reader/Step/refused(
                    Refusal/malformed("a chunk states its size in hexadecimal digits"))
            | (true, some(size)) =>
                match size
                | 0 => trailers_from(limits, content, at, i + 1, i + 1, false, held)
                | _ =>
                    match Bytes/len(content) + size <= limits.content
                    | false => Reader/Step/refused(Refusal/content_too_large())
                    | true => data_from(limits, content, at, size, held)
                    end
                end
            end
        end
    end
-- A chunk whose size line ends at `at` and states `size`: its data once it and the line end after it have arrived, read on into the chunks after it.
and data_from(
    limits: Limits,
    content: Bytes,
    at: Nat,
    size: Nat,
    held: Bytes,
) -> Reader/Step(Decoded, Refusal, Bytes) =
    match at + 2 + size + 2 <= Bytes/len(held)
    | false => Reader/Step/more(Decoded { content = content, at = Chunking/data(at, size) }, held)
    | true =>
        match is(held, at + 2 + size, '\r') && is(held, at + 3 + size, '\n')
        | false => Reader/Step/refused(Refusal/malformed("a chunk is followed by a line end"))
        | true =>
            size_from(
                limits,
                x[..content, ..Bytes/slice(held, at + 2, size)],
                0,
                false,
                Bytes/drop(held, at + 4 + size))
        end
    end;

-- The trailer section past the last chunk's size line, which ends at `at`, searched from `i` on, its unfinished line beginning at `line` and `ending` saying whether the octet before `i` is a carriage return: the content once an empty line ends the section, more wanted until then. Its length is measured from `at`, by what is known to be the section's.
let trailers_from(
    limits: Limits,
    content: Bytes,
    at: Nat,
    line: Nat,
    i: Nat,
    ending: Bool,
    held: Bytes,
) -> Reader/Step(Decoded, Refusal, Bytes) =
    match Bool/holds(i < Bytes/len(held))
    | none() =>
        match Bytes/len(held) - carried(ending) - at <= limits.head
        | true =>
            Reader/Step/more(
                Decoded { content = content, at = Chunking/trailers(at, line, i, ending) },
                held)
        | false => Reader/Step/refused(Refusal/head_too_large())
        end
    | some(inside) =>
        let byte = Byte/to_nat(Bytes/get(held, i));
        match (ending && byte == '\n', i - 1 == line)
        | (false, _) => trailers_from(limits, content, at, line, i + 1, byte == '\r', held)
        | (true, false) => trailers_from(limits, content, at, i + 1, i + 1, false, held)
        | (true, true) =>
            match i - 1 - at <= limits.head
            | true => Reader/Step/took(content, Bytes/drop(held, i + 1))
            | false => Reader/Step/refused(Refusal/head_too_large())
            end
        end
    end;

--- A chunked body (RFC 9112 §7.1): the content its chunks hold, the trailer section read past and dropped. The state is what the reading has decoded and where it resumes, so a look reads the octets that arrived since the last, and a size line it completes once more, for the size the line states. A size line that is none, a chunk not followed by a line end, a size line past `limits.chunk_line`, a trailer section past `limits.head` and content past `limits.content` are refused.
pub let chunked(
    limits: Limits,
    decoded: Decoded,
    held: Bytes,
) -> Reader/Step(Decoded, Refusal, Bytes) =
    match decoded.at
    | size_line(searched, ending) => size_from(limits, decoded.content, searched, ending, held)
    | data(at, size) => data_from(limits, decoded.content, at, size, held)
    | trailers(at, line, searched, ending) =>
        trailers_from(limits, decoded.content, at, line, searched, ending, held)
    end;

--- A body as `framing` delimits it: nothing, `length`'s octets, `chunked`'s content, or everything until its stream ends. The state is what the reading has decoded, which a chunked body alone keeps apart from the bytes held. A body framed by the close is never taken: it wants more until whoever owns its stream sees it end, when the bytes held are the body, and it holds no more than `limits.content`.
pub let body(
    limits: Limits,
    framing: Framing,
    decoded: Decoded,
    held: Bytes,
) -> Reader/Step(Decoded, Refusal, Bytes) =
    match framing
    | none() => Reader/Step/took(x[], held)
    | length(n) =>
        match length(limits, n, held)
        | took(taken, rest) => Reader/Step/took(taken, rest)
        | more(_, kept) => Reader/Step/more(decoded, kept)
        | refused(why) => Reader/Step/refused(why)
        end
    | chunked() => chunked(limits, decoded, held)
    | close() =>
        match Bytes/len(held) <= limits.content
        | true => Reader/Step/more(decoded, held)
        | false => Reader/Step/refused(Refusal/content_too_large())
        end
    end;

--- A whole body from bytes that will not grow, as `framing` delimits it: what whoever holds the entire message is answered. A body that has not all arrived is `incomplete`, and one framed by the close is everything held.
pub let whole(limits: Limits, framing: Framing, held: Bytes) -> Result(Refusal, {Bytes, Bytes}) =
    match body(limits, framing, undecoded, held)
    | took(taken, rest) => Result/success((taken, rest))
    | refused(why) => Result/failure(why)
    | more(_, kept) =>
        match framing
        | close() => Result/success((kept, x[]))
        | _ => Result/failure(Refusal/incomplete())
        end
    end;
