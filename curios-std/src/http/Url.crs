use /std/{Bytes, Byte, Char, Str, Nat, Bool, List, Option, Result, Parse, Spell};
use /std/Bool/{True, False, Holds};
use /std/ops/{Eql};
use /std/http/Field/{Value};
use /std/http/Field/Value/{Octet};

--- The scheme, which decides the port when none is written and whether the connection is under TLS.
pub induct Scheme: pub Type
--- `http`: port 80 where none is written, and in the clear.
| http()
--- `https`: port 443 where none is written, and under TLS.
| https()
end

pub use Scheme/*;

satisfy Eql(Scheme) {
    ..
}

satisfy Spell(Scheme) {
    ..
}

--- Where a request goes: the scheme, the host, the port, the path, and the query as written after `?`, if any. A fragment is the client's and is dropped.
pub struct Url: pub Type {
    scheme: Scheme,
    host: Str,
    port: Nat,
    path: Str,
    query: Option(Str),
}

satisfy Eql(Url) {
    ..
}

satisfy Spell(Url) {
    ..
}

--- The port a scheme implies.
pub let default_port(s: Scheme) -> Nat =
    match s | http() => 80 | https() => 443 end;

let until(stops: List(Char)) -> (Char) -> Bool =
    (c) => Bool/not(List/any(stops, (stop) => c == stop));

-- Whether the wire carries `b` as it is: visible ASCII.
let visible(b: Byte) -> Bool =
    Nat/in_range(Byte/to_nat(b), 33, 126);

-- One part of a URL. A space, a control octet and an octet past ASCII have no place in one: each is written percent-encoded, and one left bare is refused.
let part(s: Str) -> Parse(Str, Str) =
    match Bytes/all(Str/to_bytes(s), visible)
    | true => Parse/pure(s)
    | false =>
        Parse/fail(
            "a URL holds no space, control octet or octet past ASCII, each of which is written percent-encoded")
    end;

let scheme: Parse(Str, Scheme) =
    let name = Parse/text/take_while(until([':']))!;
    let _ = Parse/text/literal("://")!;
    choose
    | Str/eql_ascii_ci(name, "http") => Parse/pure(Scheme/http())
    | Str/eql_ascii_ci(name, "https") => Parse/pure(Scheme/https())
    | _ => Parse/fail(Str/flatten(["unknown scheme '", name, "'"]))
    end;

let is_digit(c: Char) -> Bool =
    Nat/in_range(Char/to_nat(c), '0', '9');

-- Whether the authority ends here: at the path, the query, the fragment, or the end of the text.
let ends_authority(next: Option(Char)) -> Bool =
    match next
    | some(c) =>
        match Char/to_nat(c)
        | '/' => true
        | '?' => true
        | '#' => true
        | _ => false
        end
    | none() => true
    end;

-- The port after a `:`: its digits up to where the authority ends. None is the scheme's, as RFC 3986 §3.2.3 reads an empty port, and a number no port holds is refused here rather than at the connection.
let port_number(s: Scheme) -> Parse(Str, Nat) =
    let _ = Parse/text/expect(':')!;
    let digits = Parse/text/take_while(is_digit)!;
    let next = Parse/text/peek!;
    match ends_authority(next)
    | false => Parse/fail("a port is a number")
    | true =>
        match Str/is_empty(digits)
        | true => Parse/pure(default_port(s))
        | false =>
            match Nat/of_str(digits)
            | some(n) =>
                match n <= 65535
                | true => Parse/pure(n)
                | false => Parse/fail("a port is at most 65535")
                end
            | none() => Parse/fail("a port is a number")
            end
        end
    end;

let port_of(s: Scheme) -> Parse(Str, Nat) =
    let next = Parse/text/peek!;
    match next
    | some(c) => match Char/to_nat(c) | ':' => port_number(s) | _ => Parse/pure(default_port(s)) end
    | none() => Parse/pure(default_port(s))
    end;

let path: Parse(Str, Str) =
    let written = Parse/text/take_while(until(['?', '#']))!;
    let s = part(written)!;
    match Str/is_empty(s) | true => Parse/pure("/") | false => Parse/pure(s) end;

let query_text: Parse(Str, Option(Str)) =
    let _ = Parse/text/expect('?')!;
    let written = Parse/text/take_while(until(['#']))!;
    let s = part(written)!;
    Parse/pure(Option/some(s));

let query: Parse(Str, Option(Str)) =
    let next = Parse/text/peek!;
    match next
    | some(c) => match Char/to_nat(c) | '?' => query_text | _ => Parse/pure(Option/none()) end
    | none() => Parse/pure(Option/none())
    end;

let url: Parse(Str, Url) =
    let s = scheme!;
    let h = Parse/text/take_while(until([':', '/', '?', '#']))!;
    let host = part(h)!;
    let p = port_of(s)!;
    let pa = path!;
    let q = query!;
    let _ = Parse/text/rest!;
    match Str/is_empty(host)
    | true => Parse/fail("a URL names a host")
    | false => Parse/pure(Url { scheme = s, host = host, port = p, path = pa, query = q })
    end;

--- `s` read as a URL, or why it is not: a scheme other than `http` and `https`, a missing host, or a port that is no number of at most 65535. A port left empty, as in `http://h:/`, is the scheme's.
pub let of_str(s: Str) -> Result(Parse/Error, Url) =
    Parse/run(url, s);

--- That `r` is a URL that read.
pub let Read(r: Result(Parse/Error, Url)) -> Prop =
    match r | success(_) => True | failure(_) => False end;

--- That `s` reads as a URL, decided by reduction: a literal that does not is refused where it is written.
pub let Valid(s: Str) -> Prop =
    Read(of_str(s));

--- The URL the literal `s` spells, at no cost at run time beyond the read.
pub let lit(s: Str, @ok: Valid(s)) -> Url =
    match of_str(s): (r) => (Read(r)) -> Url
    | success(u) => (_) => u
    | failure(_) => (absent) => match absent end
    end(ok);

--- The scheme as a URL spells it.
pub let scheme_str(s: Scheme) -> Str =
    match s | http() => "http" | https() => "https" end;

let port_str(u: Url) -> Str =
    match u.port == default_port(u.scheme)
    | true => ""
    | false => Str/concat(":", Nat/to_str(u.port))
    end;

let query_str(q: Option(Str)) -> Str =
    match q | some(s) => Str/concat("?", s) | none() => "" end;

--- The URL as text.
pub let to_str(u: Url) -> Str =
    Str/flatten([scheme_str(u.scheme), "://", u.host, port_str(u), u.path, query_str(u.query)]);

-- The sixteen hexadecimal digits, uppercase, each an octet a value may hold.
let hex_octets: List(Octet) =
    [
        Octet { byte = '0' },
        Octet { byte = '1' },
        Octet { byte = '2' },
        Octet { byte = '3' },
        Octet { byte = '4' },
        Octet { byte = '5' },
        Octet { byte = '6' },
        Octet { byte = '7' },
        Octet { byte = '8' },
        Octet { byte = '9' },
        Octet { byte = 'A' },
        Octet { byte = 'B' },
        Octet { byte = 'C' },
        Octet { byte = 'D' },
        Octet { byte = 'E' },
        Octet { byte = 'F' }];

-- The hexadecimal digit of the nibble `n`, read off the sixteen under the bound that makes it one.
let hex_octet(n: Nat, @nibble: Holds(n < 16)) -> Octet =
    List/get(hex_octets, n);

-- `b` with every octet that is not visible ASCII written as its `%XX`.
let escaped_bytes(b: Bytes) -> Value =
    match b
    | x[] => Value/empty
    | x[h, .._]; rest =>
        let n = Byte/to_nat(h);
        let quoted =
            Value/cons(
                Octet { byte = '%' },
                Value/cons(hex_octet(n / 16), Value/cons(hex_octet(n % 16), rest)));
        match Value/admits(h)
        | false => quoted
        | true =>
            match visible(h) | true => Value/cons(Octet { byte = h }, rest) | false => quoted end
        end
    end;

--- `s` as the wire carries it, a value a field may hold: every octet that is not visible ASCII written as its `%XX`. Text `of_str` read is unchanged by it, and text that reached a `Url` by another road still cannot end a line.
pub let escaped(s: Str) -> Value =
    escaped_bytes(Str/to_bytes(s));

--- The URL as a field's value, as `Location` carries one.
pub let to_value(u: Url) -> Value =
    escaped(to_str(u));

--- The path's segments, for a server to match on: `/a/b/` is `["a", "b"]`.
pub let segments(u: Url) -> List(Str) =
    List/filter(Str/split(u.path, "/"), (s) => Bool/not(Str/is_empty(s)));

--- The hexadecimal digit of the nibble `n`, uppercase as a percent-encoding is written.
let hex_digit(n: Nat) -> Str =
    Str/of_char(Char/to_ascii_upper(Char/hex_digit(n)));

let unreserved(n: Nat) -> Bool =
    Nat/in_range(n, 'a', 'z') || Nat/in_range(n, 'A', 'Z') || Nat/in_range(n, '0', '9') || n == '-'
        || n == '_'
        || n == '.'
        || n == '~';

--- What a character is written as in a percent-encoded component, when it is not written as itself: each of its UTF-8 bytes as `%XX`.
let percent(c: Char) -> Option(Str) =
    match unreserved(Char/to_nat(c))
    | true => Option/none()
    | false =>
        Option/some(
            Str/flatten(
                Bytes/fold(
                    Char/to_utf8(c),
                    [],
                    (byte, acc) =>
                        let n = Byte/to_nat(byte);
                        [..acc, "%", hex_digit(n / 16), hex_digit(n % 16)])))
    end;

--- `component` percent-encoded: every character but the unreserved ones as the `%XX` of each of its bytes.
pub let encode(component: Str) -> Str =
    Str/escape(component, percent);

-- The digit travels with the evidence that it is one, because the caller combines two of them into a byte and reduction cannot see a bound a guard established. Deciding the range once is what produces both: the ladder yields a value `16` for anything that is not a hex digit, and the single comparison below is at once the refusal and the proof. Masking the digit instead would state a width this encoding does not have — a hex digit is four bits because of what it is, not because of where it is stored.
let hex_value(byte: Byte) -> Option({v: Nat, ok: Holds(v < 16)}) =
    let n = Byte/to_nat(byte);
    let digit =
        choose
        | Nat/in_range(n, '0', '9') => n - '0'
        | Nat/in_range(n, 'a', 'f') => n - 'a' + 10
        | Nat/in_range(n, 'A', 'F') => n - 'A' + 10
        | _ => 16
        end;
    match Nat/lt/try(digit, 16)
    | some(ok) => Option/some((v = digit, ok = ok))
    | none() => Option/none()
    end;

let decode_at(rest: Bytes, acc: Bytes) -> Option(Bytes) =
    match rest
    | x[] => Option/some(acc)
    | x[byte, ..after] =>
        match Byte/to_nat(byte)
        | '+' => decode_at(after, x[..acc, ' '])
        | '%' =>
            match after
            | x[] => Option/none()
            | x[high, ..low_on] =>
                match low_on
                | x[] => Option/none()
                | x[low, ..onward] =>
                    match (hex_value(high), hex_value(low))
                    | (some(hi), some(lo)) =>
                        decode_at(onward, x[..acc, Nat/to_byte(hi.v * 16 + lo.v)])
                    | (some(_), none()) => Option/none()
                    | (none(), _) => Option/none()
                    end
                end
            end
        | _ => decode_at(after, x[..acc, byte])
        end
    end;

--- `component` percent-decoded, `+` read as a space, or `none` when an escape is malformed or the result is not text.
pub let decode(component: Str) -> Option(Str) =
    Option/bind(
        decode_at(Str/to_bytes(component), x[]),
        (decoded) => Result/to_option(Str/of_bytes(decoded)));

--- The query as decoded pairs: `a=1&b=x+y` is `[("a", "1"), ("b", "x y")]`. A pair without `=` is a name with an empty value and an empty piece — `a=1&&b=2`, or a query that is empty — is no pair, as the form encoding reads them; `none` where a name or a value does not decode, since a query read short of a pair is not the query that was sent.
pub let query_pairs(u: Url) -> Option(List({Str, Str})) =
    match u.query
    | none() => Option/some([])
    | some(q) =>
        List/traverse(
            List/filter(Str/split(q, "&"), (pair) => Bool/not(Str/is_empty(pair))),
            (pair) =>
                let (name, value) = Option/unwrap_or(Str/split_once(pair, "="), (pair, ""));
                let n = decode(name)!;
                let v = decode(value)!;
                Option/some((n, v)))
    end;

--- `u` with `pairs` as its query, each name and value encoded.
pub let with_query(u: Url, pairs: List({Str, Str})) -> Url =
    match pairs
    | [] => Url { ..u, query = Option/none() }
    | _ =>
        Url {
            ..u,
            query =
                Option/some(
                    Str/join(
                        "&",
                        List/map(pairs, ((name, value)) =>
                            Str/flatten([encode(name), "=", encode(value)])))),
        }
    end;
