use /std/{Nat, Bool, Spell};
use /std/Bool/{Holds};
use /std/ops/{Eql};

--- The version an HTTP/1 message states: its minor number, one digit (RFC 9112 §2.3). The major number is 1, the only one this library speaks.
pub struct Version: pub Type {
    minor: Nat,
    --- Why the minor number is one digit.
    @digit: Holds(minor <= 9),
}

satisfy Eql(Version) {
    ..
}

satisfy Spell(Version) {
    ..
}

--- Whether the version is HTTP/1.1 or a later minor: what a sender must state before a recipient reads its `Transfer-Encoding`, answers its `Expect`, or holds it to a `Host`.
pub let is_1_1(v: Version) -> Bool =
    1 <= v.minor;
