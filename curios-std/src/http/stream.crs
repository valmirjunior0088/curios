use /std/{Bytes, Result, Async};
use /std/Io/{Reader};
use /std/Io/Reader/{Stop};
use /std/tcp/{Socket};
use /std/http/{Limits, Refusal, Framing, read};

--- The body `framing` delimits, read through `r`, or how it went unread. A body framed by the close is whole when the peer closes; any other the peer closes on is cut short, and what stopped the reading holds the content that had arrived: the octets of a stated length, the whole chunks of a chunked body.
pub let body(
    limits: Limits,
    r: Reader(Socket),
    framing: Framing,
) -> Async(Result(Stop(Bytes, Refusal), Bytes)) =
    let read =
        Reader/take(
            r,
            (content: Bytes, bytes: Bytes) => read/body(limits, framing, content, bytes),
            x[])!;
    match read
    | success(taken) => Async/pure(Result/success(taken))
    | failure(stop) =>
        match stop
        | refused(why) => Async/pure(Result/failure(Stop/refused(why)))
        | failed(content, e) => Async/pure(Result/failure(Stop/failed(content, e)))
        | ended(content) =>
            let held = Reader/held(r)!;
            Async/pure(
                match framing
                | close() => Result/success(held)
                | chunked() => Result/failure(Stop/ended(content))
                | _ => Result/failure(Stop/ended(held))
                end)
        end
    end;
