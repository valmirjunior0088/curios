use /std/{Bytes, Result, Io};
use /std/Io/{Reader};
use /std/tcp/{Socket};
use /std/http/{Limits, Refusal, Framing, read};

--- The body `framing` delimits, read through `r`, or how it went unread. A body framed by the close is whole when the peer closes; any other the peer closes on is cut short, and what stopped the reading holds the content that had arrived: the octets of a stated length, the whole chunks of a chunked body.
pub let body(
    limits: Limits,
    r: Reader(Socket),
    framing: Framing,
) -> Io(Result(Reader/Stop(Bytes, Refusal), Bytes)) =
    let read =
        Reader/take(
            r,
            (decoded: read/Decoded, bytes: Bytes) => read/body(limits, framing, decoded, bytes),
            read/undecoded)!;
    match read
    | success(taken) => Io/pure(Result/success(taken))
    | failure(stop) =>
        match stop
        | refused(why) => Io/pure(Result/failure(Reader/Stop/refused(why)))
        | failed(decoded, e) => Io/pure(Result/failure(Reader/Stop/failed(decoded.content, e)))
        | ended(decoded) =>
            let held = Reader/held(r)!;
            Io/pure(
                match framing
                | close() => Result/success(held)
                | chunked() => Result/failure(Reader/Stop/ended(decoded.content))
                | _ => Result/failure(Reader/Stop/ended(held))
                end)
        end
    end;
