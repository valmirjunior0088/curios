use /std/{Str, Option, Spell, Show};
use /std/ops/{Eql};

--- The request's method.
pub induct Method: pub Type
| get()
| head()
| post()
| put()
| delete()
| patch()
| options()
end

pub use Method/*;

satisfy Eql(Method) {
    ..
}

satisfy Spell(Method) {
    ..
}

--- The method as the wire spells it.
pub let to_str(m: Method) -> Str =
    match m
    | get() => "GET"
    | head() => "HEAD"
    | post() => "POST"
    | put() => "PUT"
    | delete() => "DELETE"
    | patch() => "PATCH"
    | options() => "OPTIONS"
    end;

--- Shown as the wire spells it.
satisfy Show(Method) {
    show = to_str,
}

--- The method `s` spells, or `none`.
pub let of_str(s: Str) -> Option(Method) =
    choose
    | s == "GET" => Option/some(Method/get())
    | s == "HEAD" => Option/some(Method/head())
    | s == "POST" => Option/some(Method/post())
    | s == "PUT" => Option/some(Method/put())
    | s == "DELETE" => Option/some(Method/delete())
    | s == "PATCH" => Option/some(Method/patch())
    | s == "OPTIONS" => Option/some(Method/options())
    | _ => Option/none()
    end;
