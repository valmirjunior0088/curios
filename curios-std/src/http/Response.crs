use /std/{Bytes, Byte, Str, Nat, Bool, List, Option, Result, Parse, Json, Html, Spell};
use /std/Bool/{Holds};
use /std/ops/{Eql};
use /std/http/{Url, Field, Status};
use /std/http/Field/{Name, Value};

--- What came back: the status, the headers and the body. A reply holds content only where its status carries any, so one built with a body on a 1xx, 204, 205 or 304 status is refused where it is built, and every reply is one `render` can write.
pub struct Response: pub Type {
    status: Status,
    headers: List(Field),
    body: Bytes,
    --- Why the body is one the status carries.
    @bodied: Holds(Status/carries_content(status.code) || Bytes/len(body) == 0),
}

satisfy Eql(Response) {
    ..
}

satisfy Spell(Response) {
    ..
}

let until(target: Byte) -> (Byte) -> Bool =
    (byte) => Bool/not(byte == target);

let is_digit(byte: Byte) -> Bool =
    Nat/in_range(Byte/to_nat(byte), '0', '9');

let as_text(b: Bytes) -> Parse(Bytes, Str) =
    match Str/of_bytes(b)
    | some(s) => Parse/pure(s)
    | none() => Parse/fail("a reply is text before its body")
    end;

--- The status line: the version, the code and the reason. A code that is not three digits is a refusal, and so is a reason holding a control octet.
pub let status_line: Parse(Bytes, Status) =
    let _ = Parse/bytes/take_while(until(' '))!;
    let _ = Parse/bytes/expect(' ')!;
    let digits = Parse/bytes/take_while(is_digit)!;
    let _ = Parse/bytes/expect(' ')!;
    let reason = Parse/bytes/take_while(until('\r'))!;
    let _ = Parse/bytes/literal("\r\n")!;
    let spelled = as_text(digits)!;
    match Nat/of_str(spelled)
    | none() => Parse/fail("a status code is a number")
    | some(code) =>
        match 100 <= code && code <= 999
        | false => Parse/fail("a status code is three digits")
        | true =>
            match Value/of_bytes(reason)
            | some(phrase) => Parse/pure(Status { code = code, reason = phrase })
            | none() => Parse/fail("a reason phrase holds no control octet")
            end
        end
    end;

let guard_header: Parse(Bytes, {}) =
    let next = Parse/bytes/peek!;
    match next
    | none() => Parse/fail("unexpected end of headers")
    | some(byte) =>
        match byte == '\r' | true => Parse/fail("end of header block") | false => Parse/pure(()) end
    end;

let header_line: Parse(Bytes, Field) =
    let _ = guard_header!;
    let name = Parse/bytes/take_while(until(':'))!;
    let _ = Parse/bytes/expect(':')!;
    let value = Parse/bytes/take_while(until('\r'))!;
    let _ = Parse/bytes/literal("\r\n")!;
    let n = as_text(name)!;
    let v = as_text(value)!;
    match Field/read(n, Str/to_bytes(Str/trim(v)))
    | some(field) => Parse/pure(field)
    | none() =>
        Parse/commit(Parse/fail("a field's name is a token, and its value holds no control octet"))
    end;

let lookup(headers: List(Field), name: Str) -> Option(Str) =
    Option/bind(Field/find(headers, name), Value/to_str);

let hex_value(byte: Byte) -> Option(Nat) =
    let n = Byte/to_nat(byte);
    choose
    | Nat/in_range(n, '0', '9') => Option/some(n - '0')
    | Nat/in_range(n, 'a', 'f') => Option/some(n - 'a' + 10)
    | Nat/in_range(n, 'A', 'F') => Option/some(n - 'A' + 10)
    | _ => Option/none()
    end;

--- One hexadecimal digit's value; declines, consuming nothing, at anything else.
let hex_digit: Parse(Bytes, Nat) =
    Parse/bind(Parse/bytes/byte, (byte) =>
        match hex_value(byte)
        | some(v) => Parse/pure(v)
        | none() => Parse/fail("a hexadecimal digit")
        end);

--- One chunk's size line: the hexadecimal size, any extension after `;` ignored, then the line's end.
let chunk_size: Parse(Bytes, Nat) =
    let digits = Parse/label(Parse/many1(hex_digit), "a chunk states its size")!;
    let _ = Parse/bytes/take_while(until('\r'))!;
    let _ = Parse/bytes/literal("\r\n")!;
    Parse/pure(List/fold(digits, 0, (digit, acc) => acc * 16 + digit));

--- The chunks until the empty one, then any trailers, then the block's end; `acc` is what has arrived.
let chunks(acc: Bytes) -> Parse(Bytes, Bytes) =
    let n = chunk_size!;
    match n
    | 0 =>
        let _ = Parse/many0(header_line)!;
        let _ = Parse/bytes/literal("\r\n")!;
        Parse/pure(acc)
    | _ =>
        let chunk = Parse/bytes/take(n)!;
        let _ = Parse/bytes/literal("\r\n")!;
        chunks(x[..acc, ..chunk])
    end;

--- Whether the transfer encoding lists `chunked`, compared without case, wherever it stands in the list.
let chunked(headers: List(Field)) -> Bool =
    match lookup(headers, "Transfer-Encoding")
    | some(value) =>
        List/any(Str/split(value, ","), (coding) => Str/eql_ascii_ci(Str/trim(coding), "chunked"))
    | none() => false
    end;

let body_of(headers: List(Field)) -> Parse(Bytes, Bytes) =
    match chunked(headers)
    | true => chunks(x[])
    | false =>
        match Option/bind(lookup(headers, "Content-Length"), Nat/of_str)
        | some(n) => Parse/bytes/take(n)
        | none() => Parse/bytes/rest
        end
    end;

--- The reply `status`, `headers` and `body` make: the body dropped where the status has none whatever its fields say, and a refusal where a 205 reply carries content.
let framed(status: Status, headers: List(Field), body: Bytes) -> Parse(Bytes, Response) =
    match Status/carries_content(status.code)
    | true => Parse/pure(Response { status = status, headers = headers, body = body })
    | false =>
        match Status/bodiless(status.code)
        | true => Parse/pure(Response { status = status, headers = headers, body = x[] })
        | false =>
            match Bytes/len(body) == 0
            | true => Parse/pure(Response { status = status, headers = headers, body = body })
            | false => Parse/fail("a 205 reply carries no content")
            end
        end
    end;

--- A whole reply: the status line, the headers, then the body — the chunks when the transfer encoding is chunked, `Content-Length` bytes when the header is there, clamped to what arrived, and everything the peer sent otherwise. A 1xx, 204 or 304 reply has no body.
pub let decode: Parse(Bytes, Response) =
    let status = status_line!;
    let headers = Parse/many0(header_line)!;
    let _ = Parse/bytes/literal("\r\n")!;
    let body = body_of(headers)!;
    framed(status, headers, body);

--- Whether a reply's renderer writes the field named `name` itself: the framing fields and `Connection`. A caller's own field of one of these names is not sent.
pub let owned(name: Name) -> Bool =
    Name/is(name, "Content-Length") || Name/is(name, "Transfer-Encoding")
        || Name/is(name, "Connection");

let length_line(n: Nat) -> Bytes =
    Str/to_bytes(Str/flatten(["Content-Length: ", Nat/to_str(n), "\r\n"]));

--- The reply's head as the bytes sent on the wire, stating the length of `body`: the status line as HTTP/1.1, `Connection: close`, since a server keeps no connection, `Content-Length` unless the status is 1xx, 204 or 304, then the headers the renderer does not own, and the blank line.
pub let render_head(r: Response, body: Bytes) -> Bytes =
    x[
        ..Str/to_bytes(Str/flatten(["HTTP/1.1 ", Nat/to_str(r.status.code), " "])),
        ..r.status.reason.bytes,
        ..Str/to_bytes("\r\nConnection: close\r\n"),
        ..match Status/bodiless(r.status.code)
        | true => x[]
        | false => length_line(Bytes/len(body))
        end,
        ..Field/lines(r.headers, owned),
        '\r',
        '\n'];

--- The reply as the bytes sent on the wire: its head, then its body. Every reply is one a wire can carry, so there is nothing to refuse.
pub let render(r: Response) -> Bytes =
    x[..render_head(r, r.body), ..r.body];

--- The value of the first header named `name`, compared without case, or `none`.
pub let header(r: Response, name: Str) -> Option(Value) =
    Field/find(r.headers, name);

--- `r` with the field `name: value` appended to its headers. A field the renderer owns — `Content-Length`, `Transfer-Encoding`, `Connection` — is kept and not sent.
pub let with_header(
    r: Response,
    name: Str,
    value: Str,
    @Holds(Name/is_token(name)),
    @Holds(Bytes/all(Str/to_bytes(value), Value/admits)),
) -> Response =
    Response { ..r, headers = [..r.headers, Field/of(name, value)], @bodied = r.bodied };

--- Whether the status is a success, 200 through 299.
pub let ok(r: Response) -> Bool =
    Nat/in_range(r.status.code, 200, 299);

--- The body as text, or `none` unless it is UTF-8.
pub let text(r: Response) -> Option(Str) =
    Str/of_bytes(r.body);

--- The body decoded as JSON, or the decoder's refusal.
pub let json(r: Response) -> Result(Parse/Error, Json) =
    Parse/run(Json/decode, r.body);

--- A reply with `code`, its usual reason, `Content-Type` set to `kind`, and `body`. A status that carries no content takes no body but the empty one.
pub let of(
    code: Nat,
    kind: Str,
    body: Bytes,
    @Holds(100 <= code && code <= 999),
    @Holds(Bytes/all(Str/to_bytes(kind), Value/admits)),
    @Holds(Status/carries_content(code) || Bytes/len(body) == 0),
) -> Response =
    Response { status = Status/of(code), headers = [Field/of("Content-Type", kind)], body = body };

--- A reply with `code`, its usual reason, and neither headers nor content: what a 204 or a 304 is.
pub let empty(code: Nat, @Holds(100 <= code && code <= 999)) -> Response =
    Response { status = Status/of(code), headers = [], body = x[] };

--- Plain text, under a status that carries content.
pub let of_text(
    code: Nat,
    s: Str,
    @Holds(100 <= code && code <= 999),
    @content: Holds(Status/carries_content(code)),
) -> Response =
    match Status/carries_content(code)
    | true => of(code, "text/plain; charset=utf-8", Str/to_bytes(s))
    | false => match content end
    end;

--- JSON, under a status that carries content.
pub let of_json(
    code: Nat,
    j: Json,
    @Holds(100 <= code && code <= 999),
    @content: Holds(Status/carries_content(code)),
) -> Response =
    match Status/carries_content(code)
    | true => of(code, "application/json", Str/to_bytes(Json/encode(j)))
    | false => match content end
    end;

--- HTML, rendered as `Html/render` writes it, under a status that carries content.
pub let of_html(
    code: Nat,
    h: Html,
    @Holds(100 <= code && code <= 999),
    @content: Holds(Status/carries_content(code)),
) -> Response =
    match Status/carries_content(code)
    | true => of(code, "text/html; charset=utf-8", Str/to_bytes(Html/render(h)))
    | false => match content end
    end;

--- A `303 See Other` to `url`, its `Location` the URL as the wire carries it.
pub let redirect(url: Url) -> Response =
    Response {
        status = Status/of(303),
        headers = [Field { name = Name { text = "Location" }, value = Url/to_value(url) }],
        body = x[],
    };

--- A `404 Not Found` with an empty body.
pub let not_found: Response =
    Response { status = Status/of(404), headers = [], body = x[] };
