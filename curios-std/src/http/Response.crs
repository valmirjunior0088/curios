use /std/{Bytes, Str, Nat, Bool, List, Option, Result, Parse, Json, Html, Spell};
use /std/Bool/{Holds};
use /std/ops/{Eql};
use /std/http/{Method, Url, Field, Status, Version, Limits, Refusal, Framing, read, syntax};
use /std/http/Field/{Name, Value};

--- What came back: the status, the headers and the body. A reply holds content only where its status carries any, so one built with a body on a 1xx, 204, 205 or 304 status is refused where it is built, and every reply is one `render` can write.
pub struct Response: pub Type {
    status: Status,
    headers: List(Field),
    body: Bytes,
    --- Why the body is one the status carries.
    @bodied: Holds(Status/carries_content(status.code) || Bytes/len(body) == 0),
}

satisfy Eql(Response) {
    ..
}

satisfy Spell(Response) {
    ..
}

--- Whether a reply's renderer writes the field named `name` itself: the framing fields and `Connection`. A caller's own field of one of these names is not sent.
pub let owned(name: Name) -> Bool =
    Name/is(name, "Content-Length") || Name/is(name, "Transfer-Encoding")
        || Name/is(name, "Connection");

let length_line(n: Nat) -> Bytes =
    Str/to_bytes(Str/flatten(["Content-Length: ", Nat/to_str(n), "\r\n"]));

--- The reply's head as the bytes sent on the wire, stating the length of `body`: the status line as HTTP/1.1, `Connection: close`, since a server keeps no connection, `Content-Length` unless the status is 1xx, 204 or 304, then the headers the renderer does not own, and the blank line.
pub let render_head(r: Response, body: Bytes) -> Bytes =
    x[
        ..Str/to_bytes(Str/flatten(["HTTP/1.1 ", Nat/to_str(r.status.code), " "])),
        ..r.status.reason.bytes,
        ..Str/to_bytes("\r\nConnection: close\r\n"),
        ..match Status/bodiless(r.status.code)
        | true => x[]
        | false => length_line(Bytes/len(body))
        end,
        ..Field/lines(r.headers, owned),
        '\r',
        '\n'];

--- The reply as the bytes sent on the wire: its head, then its body. Every reply is one a wire can carry, so there is nothing to refuse.
pub let render(r: Response) -> Bytes =
    x[..render_head(r, r.body), ..r.body];

--- The value of the first header named `name`, compared without case, or `none`.
pub let header(r: Response, name: Str) -> Option(Value) =
    Field/find(r.headers, name);

--- `r` with the field `name: value` appended to its headers. A field the renderer owns — `Content-Length`, `Transfer-Encoding`, `Connection` — is kept and not sent.
pub let with_header(
    r: Response,
    name: Str,
    value: Str,
    @Holds(Name/is_token(name)),
    @Holds(Bytes/all(Str/to_bytes(value), Value/admits)),
) -> Response =
    Response { ..r, headers = [..r.headers, Field/of(name, value)], @bodied = r.bodied };

--- Whether the status is a success, 200 through 299.
pub let ok(r: Response) -> Bool =
    Nat/in_range(r.status.code, 200, 299);

--- The body as text, or where it stops being UTF-8, as `Str/of_bytes` answers.
pub let text(r: Response) -> Result(Nat, Str) =
    Str/of_bytes(r.body);

--- The body decoded as JSON, or the decoder's refusal.
pub let json(r: Response) -> Result(Parse/Error, Json) =
    Parse/run(Json/decode, r.body);

--- A reply with `code`, its usual reason, `Content-Type` set to `kind`, and `body`. A status that carries no content takes no body but the empty one.
pub let of(
    code: Nat,
    kind: Str,
    body: Bytes,
    @Holds(100 <= code && code <= 999),
    @Holds(Bytes/all(Str/to_bytes(kind), Value/admits)),
    @Holds(Status/carries_content(code) || Bytes/len(body) == 0),
) -> Response =
    Response { status = Status/of(code), headers = [Field/of("Content-Type", kind)], body = body };

--- A reply with `code`, its usual reason, and neither headers nor content: what a 204 or a 304 is.
pub let empty(code: Nat, @Holds(100 <= code && code <= 999)) -> Response =
    Response { status = Status/of(code), headers = [], body = x[] };

--- Plain text, under a status that carries content.
pub let of_text(
    code: Nat,
    s: Str,
    @Holds(100 <= code && code <= 999),
    @content: Holds(Status/carries_content(code)),
) -> Response =
    match Status/carries_content(code)
    | true => of(code, "text/plain; charset=utf-8", Str/to_bytes(s))
    | false => match content end
    end;

--- JSON, under a status that carries content.
pub let of_json(
    code: Nat,
    j: Json,
    @Holds(100 <= code && code <= 999),
    @content: Holds(Status/carries_content(code)),
) -> Response =
    match Status/carries_content(code)
    | true => of(code, "application/json", Str/to_bytes(Json/encode(j)))
    | false => match content end
    end;

--- HTML, rendered as `Html/render` writes it, under a status that carries content.
pub let of_html(
    code: Nat,
    h: Html,
    @Holds(100 <= code && code <= 999),
    @content: Holds(Status/carries_content(code)),
) -> Response =
    match Status/carries_content(code)
    | true => of(code, "text/html; charset=utf-8", Str/to_bytes(Html/render(h)))
    | false => match content end
    end;

--- The reply a server owes a request refused for `why`, which says why in plain text: 400 for a request that is malformed or cut short, 414 for a request line too long (RFC 9112 §3), 431 for a head too large (RFC 6585 §5), 413 for content too large, 501 for what is not implemented, 505 for a version not served, and 408 for a request that did not arrive in time.
pub let of_refusal(why: Refusal) -> Response =
    let said = Refusal/to_str(why);
    match why
    | malformed(_) => of_text(400, said)
    | incomplete() => of_text(400, said)
    | line_too_long() => of_text(414, said)
    | head_too_large() => of_text(431, said)
    | content_too_large() => of_text(413, said)
    | not_implemented(_) => of_text(501, said)
    | version_not_supported() => of_text(505, said)
    | timed_out() => of_text(408, said)
    end;

--- A `303 See Other` to `url`, its `Location` the URL as the wire carries it.
pub let redirect(url: Url) -> Response =
    Response {
        status = Status/of(303),
        headers = [Field { name = Name { text = "Location" }, value = Url/to_value(url) }],
        body = x[],
    };

--- A `404 Not Found` with an empty body.
pub let not_found: Response =
    Response { status = Status/of(404), headers = [], body = x[] };

--- A reply's head as it is read: its status, the version it states and its headers.
pub struct Head: pub Type {
    status: Status,
    version: Version,
    headers: List(Field),
}

satisfy Eql(Head) {
    ..
}

satisfy Spell(Head) {
    ..
}

--- The head `bytes` spell, the bytes of a status line and its field lines: a status line of a version, a three-digit code and a reason phrase (RFC 9112 §4), and field lines, a fold among them read as a space and what follows it (§5.2). Anything else is malformed.
pub let head_of(bytes: Bytes) -> Result(Refusal, Head) =
    match syntax/lines(bytes)
    | [] => Result/failure(Refusal/malformed("a reply begins with its status line"))
    | [first, ..rest] =>
        let (version, status) = syntax/status_line(first)!;
        let headers = syntax/fields(rest, true)!;
        Result/success(Head { status = status, version = version, headers = headers })
    end;

--- How the body of the reply `head` is delimited, given the method of the request it answers.
pub let framing(method: Method, head: Head) -> Result(Refusal, Framing) =
    Framing/of_reply(method, head.status.code, head.version, head.headers);

--- The reply `head` and `body` make. A 205 reply that carries content is malformed, since its server sends none (RFC 9110 §15.3.6), and a 1xx, 204 or 304 reply has no body to be given.
pub let from_head(head: Head, body: Bytes) -> Result(Refusal, Response) =
    match Status/carries_content(head.status.code)
    | true => Result/success(Response { status = head.status, headers = head.headers, body = body })
    | false =>
        match Bytes/len(body) == 0
        | true =>
            Result/success(Response { status = head.status, headers = head.headers, body = body })
        | false => Result/failure(Refusal/malformed("a reply of this status carries no content"))
        end
    end;

--- A whole reply read from `bytes`, as a client that sent a request of `method` reads it within `limits`: every 1xx reply ahead of the final one passed over (RFC 9110 §15.2), then the head, the framing its fields state, and the body that framing delimits — none in reply to `HEAD` or under a 1xx, 204 or 304 status, the chunks where it is chunked, `Content-Length` octets where the field is there, and everything the peer sent otherwise. A reply that has not all arrived is `incomplete`.
pub let of_bytes(limits: Limits, method: Method, bytes: Bytes) -> Result(Refusal, Response) =
    match read/head(limits, false, 0, bytes)
    | more(_, _) => Result/failure(Refusal/incomplete())
    | refused(why) => Result/failure(why)
    | took(lines, rest) =>
        let head = head_of(lines)!;
        match head.status.code < 200
        | true => of_bytes(limits, method, rest)
        | false =>
            let delimited = framing(method, head)!;
            let (body, _) = read/whole(limits, delimited, rest)!;
            from_head(head, body)
        end
    end;
