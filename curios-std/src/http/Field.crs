use /std/{Str, Bytes, Byte, Nat, Bool, List, Option, Spell};
use /std/Bool/{Holds};
use /std/ops/{Eql};
use /std/http/{octets};

--- A field's name: a token.
pub mod Name;
pub use Name/{let Name};

--- A field's value: octets, none of them a control octet but the tab.
pub mod Value;
pub use Value/{let Value};

--- One field line of a message: its name and its value, each what a line can carry, so a message's fields are written as they are held.
pub struct Field: pub Type {
    name: Name,
    value: Value,
}

satisfy Eql(Field) {
    ..
}

satisfy Spell(Field) {
    ..
}

--- The field the literals `name` and `value` spell.
pub let of(
    name: Str,
    value: Str,
    @_: Holds(Name/is_token(name)),
    @_: Holds(Bytes/all(Str/to_bytes(value), Value/admits)),
) -> Field =
    Field { name = Name { text = name }, value = Value/lit(value) };

--- The field `name` and `value` make, or `none` where the name is no token or an octet of the value may not stand in one.
pub let read(name: Str, value: Bytes) -> Option(Field) =
    let n = Name/of_str(name)!;
    let v = Value/of_bytes(value)!;
    Option/some(Field { name = n, value = v });

--- The value of the first of `fields` named `name`, compared without case, or `none`.
pub let find(fields: List(Field), name: Str) -> Option(Value) =
    Option/map(List/find(fields, (f: Field) => Name/is(f.name, name)), (f: Field) => f.value);

-- The pieces of a list between its commas, a comma inside a quoted string being its member's (RFC 9110 §5.6.4).
let pieces(b: Bytes) -> List(Bytes) =
    let go(
        from: Nat,
        at: Nat,
        quoted: Bool,
        escaped: Bool,
        found: List(Bytes),
        @ordered: Holds(from <= at),
        @reached: Holds(at <= Bytes/len(b)),
    ) -> List(Bytes) =
        match Nat/lt/try(at, Bytes/len(b))
        | none() => List/reverse([Bytes/slice(b, from, at - from), ..found])
        | some(inside) =>
            let n = Byte/to_nat(Bytes/get(b, at, @inside));
            choose
            | escaped => go(from, at + 1, quoted, false, found)
            | quoted => go(from, at + 1, n != '"', n == '\\', found)
            | n == ',' =>
                go(at + 1, at + 1, false, false, [Bytes/slice(b, from, at - from), ..found])
            | _ => go(from, at + 1, n == '"', false, found)
            end
        end;
    go(0, 0, false, false, []);

--- The members of the lists the `fields` named `name` hold, every line's in order, as RFC 9110 §5.2 joins the lines of one name: each without the whitespace around it, the empty ones left out as §5.6.1 has a recipient do, and a comma inside a quoted string left to its member.
pub let members(fields: List(Field), name: Str) -> List(Bytes) =
    List/filter(
        List/flatten(
            List/map(
                List/filter(fields, (f: Field) => Name/is(f.name, name)),
                (f: Field) => List/map(pieces(f.value.bytes), octets/trim))),
        (member) => Bytes/len(member) != 0);

--- The field as its line on the wire: the name, a colon and a space, the value, and the line's end.
pub let line(f: Field) -> Bytes =
    x[..Str/to_bytes(f.name.text), ':', ' ', ..f.value.bytes, '\r', '\n'];

--- The lines of the `fields` whose name `owned` does not claim, in order: what a renderer writes of a caller's fields beside the ones it writes itself.
pub let lines(fields: List(Field), owned: (Name) -> Bool) -> Bytes =
    Bytes/flatten(List/map(List/filter(fields, (f: Field) => Bool/not(owned(f.name))), line));
