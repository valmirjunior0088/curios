use /std/{Bytes, Byte, Nat, Bool, List, Option};
use /std/Bool/{Holds};

--- Whether `b` is optional whitespace, a space or a tab (RFC 9110 §5.6.3): the whitespace a field line's value and a list's members are trimmed of, and no other.
pub let is_ows(b: Byte) -> Bool =
    let n = Byte/to_nat(b);
    n == ' ' || n == '\t';

--- Whether `b` is a decimal digit.
pub let is_digit(b: Byte) -> Bool =
    Nat/in_range(Byte/to_nat(b), '0', '9');

--- Whether the byte of `b` at `i` is `byte`; `false` past its end.
pub let at(b: Bytes, i: Nat, byte: Byte) -> Bool =
    match Bytes/try_get(b, i) | some(found) => found == byte | none() => false end;

--- Where the first `byte` of `b` stands, with the proof that it lies within `b`, or `none`.
pub let index_of(b: Bytes, byte: Byte) -> Option({at: Nat, within: Holds(at < Bytes/len(b))}) =
    let go(i: Nat) -> Option({at: Nat, within: Holds(at < Bytes/len(b))}) =
        match Nat/lt/try(i, Bytes/len(b))
        | none() => Option/none()
        | some(within) =>
            match Bytes/get(b, i, @within) == byte
            | true => Option/some((at = i, within = within))
            | false => go(i + 1)
            end
        end;
    go(0);

-- `b` from `start` up to `stop`, without the optional whitespace that ends it.
let trim_end(
    b: Bytes,
    start: Nat,
    stop: Nat,
    @ordered: Holds(start <= stop),
    @reached: Holds(stop <= Bytes/len(b)),
) -> Bytes =
    match Nat/lt/try(start, stop)
    | none() => Bytes/slice(b, start, stop - start)
    | some(room) =>
        match is_ows(Bytes/get(b, stop - 1))
        | true => trim_end(b, start, stop - 1)
        | false => Bytes/slice(b, start, stop - start)
        end
    end;

-- `b` from `start` on, without the optional whitespace at either end: the walk that finds where it begins hands the index to the one that finds where it ends, so each cut is made under the bounds its walk kept.
let trim_from(b: Bytes, start: Nat, @reached: Holds(start <= Bytes/len(b))) -> Bytes =
    match Nat/lt/try(start, Bytes/len(b))
    | none() => x[]
    | some(inside) =>
        match is_ows(Bytes/get(b, start, @inside))
        | true => trim_from(b, start + 1)
        | false => trim_end(b, start, Bytes/len(b))
        end
    end;

--- `b` without the optional whitespace at either end.
pub let trim(b: Bytes) -> Bytes =
    trim_from(b, 0);

--- The pieces of `b` between each `sep`, in order: one more than the separators it holds.
pub let split(b: Bytes, sep: Byte) -> List(Bytes) =
    let go(
        from: Nat,
        at: Nat,
        found: List(Bytes),
        @ordered: Holds(from <= at),
        @reached: Holds(at <= Bytes/len(b)),
    ) -> List(Bytes) =
        match Nat/lt/try(at, Bytes/len(b))
        | none() => List/reverse([Bytes/slice(b, from, at - from), ..found])
        | some(inside) =>
            match Bytes/get(b, at, @inside) == sep
            | true => go(at + 1, at + 1, [Bytes/slice(b, from, at - from), ..found])
            | false => go(from, at + 1, found)
            end
        end;
    go(0, 0, []);

--- The number `b` spells in decimal digits, one or more and nothing else, or `none`.
pub let number(b: Bytes) -> Option(Nat) =
    match Bytes/len(b) != 0 && Bytes/all(b, is_digit)
    | true => Option/some(Bytes/fold(b, 0, (byte, n) => n * 10 + (Byte/to_nat(byte) - '0')))
    | false => Option/none()
    end;
