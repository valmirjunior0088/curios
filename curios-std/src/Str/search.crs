use /std/{Str, Char, Bool, Bytes, Nat, Option};
use /std/Str/{At};
use /std/Bool/{True, Holds};

--- The first character at or after `from` that `pred` accepts, and where it is, or `none`: one walk forward, which stops there.
pub let seek(s: Str, from: At(s), pred: (Char) -> Bool) -> Option({at: At(s), char: Char}) =
    At/forward(
        (_) => Option({at: At(s), char: Char}),
        (at, again) =>
            match At/try_next(s, at)
            | some(n) =>
                match pred(n.char)
                | true => Option/some((at = at, char = n.char))
                | false => again(n.past, n.progress)
                end
            | none() => Option/none()
            end,
        from);

-- That the walk has not gone back goes down with the position, here, in `span` and in `occurrence`, so the recursion is a tail call and a character passed keeps no frame.
--- Where `s` holds `piece` from `from` on, stepping both a character at a time from `p`: the position past it, which is not before `from`, or `none`.
pub let meets(
    s: Str,
    from: At(s),
    piece: Str,
    p: At(piece),
) -> Option({past: At(s), reach: Holds(from.offset <= past.offset)}) =
    At/forward(
        (at) =>
            (p: At(piece), reached: Holds(from.offset <= at.offset)) -> Option(
                {past: At(s), reach: Holds(from.offset <= past.offset)}),
        (at, again) =>
            (p, reached) =>
                match At/try_next(piece, p)
                | none() => Option/some((past = at, reach = reached))
                | some(want) =>
                    match At/try_next(s, at)
                    | some(have) =>
                        match have.char == want.char
                        | true => again(have.past, have.progress)(want.past, True/proved())
                        | false => Option/none()
                        end
                    | none() => Option/none()
                    end
                end,
        from)(p, Nat/le/refl(from.offset));

--- Where `s` holds `piece` up to `from`, stepping both back a character at a time from `p`: the position where it starts, or `none`.
pub let meets_back(s: Str, from: At(s), piece: Str, p: At(piece)) -> Option(At(s)) =
    At/backward(
        (_) => (p: At(piece)) -> Option(At(s)),
        (at, again) =>
            (p) =>
                match At/try_prev(piece, p)
                | none() => Option/some(at)
                | some(want) =>
                    match At/try_prev(s, at)
                    | some(have) =>
                        match have.char == want.char
                        | true => again(have.past, have.progress)(want.past)
                        | false => Option/none()
                        end
                    | none() => Option/none()
                    end
                end,
        from)(p);

--- An occurrence of a needle at or after `from`: where it starts, which is not before `from`, and the position past it, which is past the start — the needle holds a character.
pub let Found(s: Str, from: At(s)) -> Type =
    {
        start: At(s),
        past: At(s),
        ordered: Holds(from.offset <= start.offset),
        progress: Holds(start.offset < past.offset)};

--- The first occurrence at or after `from` of the needle whose first character `first` reads, or `none`.
---
--- A candidate is a position whose byte is the needle's first — cheap to test, and a position because the walk steps only from one character to the next — confirmed by stepping both from there. Every other character is skipped without being decoded.
pub let occurrence(
    s: Str,
    from: At(s),
    needle: Str,
    first: {char: Char, past: At(needle), progress: Holds(0 < past.offset)},
) -> Option(Found(s, from)) =
    let lead_byte =
        Bytes/get(
            needle.bytes,
            0,
            @Nat/lt/of_lt_le(
                0,
                first.past.offset,
                Bytes/len(needle.bytes),
                first.progress,
                first.past.within));
    At/forward(
        (at) => (reached: Holds(from.offset <= at.offset)) -> Option(Found(s, from)),
        (at, again) =>
            (reached) =>
                match at.offset < Bytes/len(s.bytes)
                | false => Option/none()
                | true =>
                    let onward = At/skip(s, at);
                    let later() -> Option(Found(s, from)) =
                        again(onward.past, onward.progress)(True/proved());
                    match Bytes/get(s.bytes, at.offset) == lead_byte
                    | false => later()
                    | true =>
                        let have = At/next(s, at);
                        match have.char == first.char
                        | false => later()
                        | true =>
                            match meets(s, have.past, needle, first.past)
                            | some(met) =>
                                Option/some((
                                    start = at,
                                    past = met.past,
                                    ordered = reached,
                                    progress = True/proved()))
                            | none() => later()
                            end
                        end
                    end
                end,
        from)(Nat/le/refl(from.offset));

--- The first occurrence of `needle` in `s`: where it starts and the position past it, or `none`. An empty needle occurs at the start.
pub let first_occurrence(s: Str, needle: Str) -> Option({start: At(s), past: At(s)}) =
    match At/try_next(needle, At/start(needle))
    | none() => Option/some((start = At/start(s), past = At/start(s)))
    | some(first) =>
        match occurrence(s, At/start(s), needle, first)
        | some(found) => Option/some((start = found.start, past = found.past))
        | none() => Option/none()
        end
    end;

--- The last position at or before `from` past which `s` holds only characters `pred` accepts: one walk back.
pub let back_over(s: Str, from: At(s), pred: (Char) -> Bool) -> At(s) =
    At/backward(
        (_) => At(s),
        (at, again) =>
            match At/try_prev(s, at)
            | some(p) => match pred(p.char) | true => again(p.past, p.progress) | false => at end
            | none() => at
            end,
        from);
