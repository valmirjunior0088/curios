use /std/{Str, Nat, Bool, Char, List, Option, Map};
use /std/Cli/{Failure};
use /std/Cli/Prepared/{NamedEntry};

pub struct Raw(limit: Nat): pub Type {
    occurrences: Map(Nat, List(Str)),
    present: Map(Nat, {}),
    positional: List(Str),
    help: Bool,
    version: Bool,
    failure: Option(Failure),
}

induct Claim(limit: Nat): Type
| argument(NamedEntry(limit))
| help()
| version()
end

let find(
    @limit: Nat,
    lookup: Map(Str, NamedEntry(limit)),
    name: Str,
    version: Bool,
) -> Option(Claim(limit)) =
    choose
    | name == "--help" || name == "-h" => Option/some(Claim/help())
    | name == "--version" && version => Option/some(Claim/version())
    | _ => Option/map(Map/try_get(lookup, name), Claim/argument)
    end;

let takes_value(@limit: Nat, claim: Claim(limit)) -> Bool =
    match claim | argument(entry) => entry.takes_value | help() => false | version() => false end;

let label(@limit: Nat, claim: Claim(limit)) -> Str =
    match claim
    | argument(entry) => entry.names.long
    | help() => "help"
    | version() => "version"
    end;

let put(@limit: Nat, raw: Raw(limit), claim: Claim(limit), text: Str) -> Raw(limit) =
    match claim
    | help() => Raw { ..raw, help = true }
    | version() => Raw { ..raw, version = true }
    | argument(entry) =>
        Raw {
            ..raw,
            occurrences =
                Map/update(raw.occurrences, entry.id.value, (old) =>
                    Option/some([text, ..Option/unwrap_or(old, [])])),
            present =
                List/fold(entry.owners, raw.present, (owner, held) =>
                    Map/insert(held, owner.value, ())) }
    end;

let refuse(@limit: Nat, raw: Raw(limit), failure: Failure) -> Raw(limit) =
    Raw {
        ..raw,
        failure = match raw.failure | some(_) => raw.failure | none() => Option/some(failure) end };

let take(
    @limit: Nat,
    raw: Raw(limit),
    claim: Claim(limit),
    attached: Option(Str),
    more: List(Str),
) -> {Raw(limit), List(Str)} =
    match takes_value(claim)
    | false =>
        match attached
        | some(_) =>
            (refuse(raw, Failure/bad_value(label(claim), "this flag takes no value")), more)
        | none() => (put(raw, claim, ""), more)
        end
    | true =>
        match attached
        | some(value) => (put(raw, claim, value), more)
        | none() =>
            match more
            | [] => (refuse(raw, Failure/missing_value(label(claim))), [])
            | [value, ..rest] => (put(raw, claim, value), rest)
            end
        end
    end;

let cluster(
    @limit: Nat,
    lookup: Map(Str, NamedEntry(limit)),
    raw: Raw(limit),
    chars: List(Char),
    whole: Str,
    more: List(Str),
    version: Bool,
) -> {Raw(limit), List(Str)} =
    match chars
    | [] => (raw, more)
    | [c, ..rest] =>
        let spelling = Str/concat("-", Str/of_char(c));
        match find(lookup, spelling, version)
        | none() =>
            cluster(lookup, refuse(raw, Failure/unknown_option(whole)), rest, whole, more, version)
        | some(claim) =>
            match takes_value(claim)
            | false => cluster(lookup, put(raw, claim, ""), rest, whole, more, version)
            | true =>
                let attached =
                    match rest
                    | [] => Option/none()
                    | [_, .._] => Option/some(Str/flatten(List/map(rest, Str/of_char)))
                    end;
                take(raw, claim, attached, more)
            end
        end
    end;

let step(
    @limit: Nat,
    lookup: Map(Str, NamedEntry(limit)),
    raw: Raw(limit),
    literal: Bool,
    tokens: List(Str),
    version: Bool,
) -> Raw(limit) =
    match tokens
    | [] => Raw { ..raw, positional = List/reverse(raw.positional) }
    | [token, ..more] =>
        choose
        | literal =>
            step(lookup, Raw { ..raw, positional = [token, ..raw.positional] }, true, more, version)
        | token == "--" => step(lookup, raw, true, more, version)
        | some(body) = Str/strip_prefix(token, "--") =>
            let (name, attached) =
                match Str/split_once(body, "=")
                | none() => (body, Option/none())
                | some((name, value)) => (name, Option/some(value))
                end;
            match find(lookup, Str/concat("--", name), version)
            | none() =>
                step(lookup, refuse(raw, Failure/unknown_option(token)), false, more, version)
            | some(claim) =>
                let (next, remaining) = take(raw, claim, attached, more);
                step(lookup, next, false, remaining, version)
            end
        | some(body) = Option/filter(
            Str/strip_prefix(token, "-"),
            (body) => Bool/not(Str/is_empty(body))) =>
            let (next, remaining) = cluster(lookup, raw, Str/to_list(body), token, more, version);
            step(lookup, next, false, remaining, version)
        | _ =>
            step(
                lookup,
                Raw { ..raw, positional = [token, ..raw.positional] },
                false,
                more,
                version)
        end
    end;

--- Ownership is settled before controls, selection or readers are interpreted. Value-taking options own their next token even when it looks like a control.
pub let scan(
    @limit: Nat,
    lookup: Map(Str, NamedEntry(limit)),
    argv: List(Str),
    version: Bool,
) -> Raw(limit) =
    step(
        lookup,
        Raw {
            occurrences = Map/empty(),
            present = Map/empty(),
            positional = [],
            help = false,
            version = false,
            failure = Option/none() },
        false,
        argv,
        version);
