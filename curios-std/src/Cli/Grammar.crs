use /std/{Str, Char, Nat, Bool, List, Option, Result};
use /std/Bool/{True, Holds};
use /std/Cli/{Value};
use /std/ops/{Eql};
use /std/Cli/{SpecError};

--- The names and help attached to one named argument.
pub struct Named: pub Type {
    long: Str,
    short: Option(Char),
    help: Str,
}

--- The label and help attached to a positional argument.
pub struct Positional: pub Type {
    name: Str,
    help: Str,
}

--- A typed reader belonging to one leaf, before any surrounding grammar maps its result.
pub struct Reader(A: Type): pub Type {
    metavar: Str,
    read: (Str) -> Result(Str, A),
}

--- How a singular value-taking option handles repeated occurrences.
pub induct Multiplicity: pub Type
| reject()
| last()
end

--- The typed structure interpreted by the command-line engine.
pub induct Node: (Type) -> pub Type
| pure(@A: Type, A): (A)
| flag(Named): ({})
| option(@A: Type, Named, Reader(A), Multiplicity): (A)
| positional(@A: Type, Positional, Reader(A)): (A)
| rest(@A: Type, Positional, Reader(A)): (List(A))
| map(@A: Type, @B: Type, Node(A), (A) -> B): (B)
| validate(@A: Type, @B: Type, Node(A), (A) -> Result(Str, B)): (B)
| product(@A: Type, @B: Type, Node(A), Node(B)): ({A, B})
| choice(@A: Type, Node(A), Node(A)): (A)
| optional(@A: Type, Node(A)): (Option(A))
| default(@A: Type, Node(A), A): (A)
| repeat(@A: Type, Node(A)): (List(A))
end

--- The two option namespaces are distinct: `--x` and `-x` are different names.
pub induct Alias: pub Type
| long(Str)
| short(Char)
end

satisfy Eql(Alias) {
    ..
}

pub let alias_text(alias: Alias) -> Str =
    match alias
    | long(name) => Str/concat("--", name)
    | short(name) => Str/concat("-", Str/of_char(name))
    end;

pub let aliases_of(names: Named) -> List(Alias) =
    [Alias/long(names.long), ..match names.short | none() => [] | some(c) => [Alias/short(c)] end];

pub let aliases(@A: Type, tree: Node(A)) -> List(Alias) =
    match tree
    | pure(_) => []
    | flag(names) => aliases_of(names)
    | option(names, _, _) => aliases_of(names)
    | positional(_, _) => []
    | rest(_, _) => []
    | map(inner, _) => aliases(inner)
    | validate(inner, _) => aliases(inner)
    | product(left, right) => [..aliases(left), ..aliases(right)]
    | choice(left, right) => [..aliases(left), ..aliases(right)]
    | optional(inner) => aliases(inner)
    | default(inner, _) => aliases(inner)
    | repeat(inner) => aliases(inner)
    end;

pub let disjoint(left: List(Alias), right: List(Alias)) -> Bool =
    List/fold(left, true, (name, held) => held && Bool/not(List/contains(right, name)));

pub let valid_character(c: Char) -> Bool =
    let n = Char/to_nat(c);
    Bool/not(Char/is_whitespace(c)) && 0x20 < n && (n < 0x7F || 0x9F < n);

pub let valid_long(name: Str) -> Bool =
    Bool/not(Str/is_empty(name)) && Bool/not(Str/starts_with(name, "-"))
        && Str/fold(name, true, (c, held) => held && valid_character(c) && c != '=');

pub let valid_short(name: Option(Char)) -> Bool =
    match name | none() => true | some(c) => valid_character(c) && c != '-' && c != '=' end;

pub let valid_named(names: Named) -> Bool =
    valid_long(names.long) && valid_short(names.short);

pub let valid_positional(name: Str) -> Bool =
    Bool/not(Str/is_empty(name)) && Str/fold(name, true, (c, held) => held && valid_character(c));

--- Whether this subtree can own positional values, independently of which alternative is selected.
pub let has_positions(@A: Type, tree: Node(A)) -> Bool =
    match tree
    | pure(_) => false
    | flag(_) => false
    | option(_, _, _) => false
    | positional(_, _) => true
    | rest(_, _) => true
    | map(inner, _) => has_positions(inner)
    | validate(inner, _) => has_positions(inner)
    | product(left, right) => has_positions(left) || has_positions(right)
    | choice(left, right) => has_positions(left) || has_positions(right)
    | optional(inner) => has_positions(inner)
    | default(inner, _) => has_positions(inner)
    | repeat(inner) => has_positions(inner)
    end;

--- A block with no nullable or unbounded positional member. Named alternatives can select different fixed blocks.
pub let required_block(@A: Type, tree: Node(A)) -> Bool =
    match tree
    | pure(_) => true
    | flag(_) => true
    | option(_, _, _) => true
    | positional(_, _) => true
    | rest(_, _) => false
    | map(inner, _) => required_block(inner)
    | validate(inner, _) => required_block(inner)
    | product(left, right) => required_block(left) && required_block(right)
    | choice(left, right) => required_block(left) && required_block(right)
    | optional(inner) => Bool/not(has_positions(inner))
    | default(inner, _) => Bool/not(has_positions(inner))
    | repeat(inner) => Bool/not(has_positions(inner))
    end;

pub let nullable_positions(@A: Type, tree: Node(A)) -> Bool =
    match tree
    | pure(_) => false
    | flag(_) => false
    | option(_, _, _) => false
    | positional(_, _) => false
    | rest(_, _) => true
    | map(inner, _) => nullable_positions(inner)
    | validate(inner, _) => nullable_positions(inner)
    | product(left, right) => nullable_positions(left) || nullable_positions(right)
    | choice(left, right) => nullable_positions(left) || nullable_positions(right)
    | optional(inner) => has_positions(inner)
    | default(inner, _) => has_positions(inner)
    | repeat(inner) => has_positions(inner)
    end;

pub let ordered_positions(@A: Type, @B: Type, left: Node(A), right: Node(B)) -> Bool =
    Bool/not(nullable_positions(left)) || Bool/not(has_positions(right));

--- Every successful interpretation requires some named selector, possibly a different one in each nested alternative.
pub let requires_named(@A: Type, tree: Node(A)) -> Bool =
    match tree
    | pure(_) => false
    | flag(_) => true
    | option(_, _, _) => true
    | positional(_, _) => false
    | rest(_, _) => false
    | map(inner, _) => requires_named(inner)
    | validate(inner, _) => requires_named(inner)
    | product(left, right) => requires_named(left) || requires_named(right)
    | choice(left, right) => requires_named(left) && requires_named(right)
    | optional(_) => false
    | default(_, _) => false
    | repeat(_) => false
    end;

--- Nested choices flatten for this count; products retain their own independently selected choices.
pub let unnamed_alternatives(@A: Type, tree: Node(A)) -> Nat =
    match tree
    | choice(left, right) => unnamed_alternatives(left) + unnamed_alternatives(right)
    | map(inner, _) => unnamed_alternatives(inner)
    | validate(inner, _) => unnamed_alternatives(inner)
    | _ => match requires_named(tree) | true => 0 | false => 1 end
    end;

pub let owns_input(@A: Type, tree: Node(A)) -> Bool =
    match tree
    | pure(_) => false
    | flag(_) => true
    | option(_, _, _) => true
    | positional(_, _) => true
    | rest(_, _) => true
    | map(inner, _) => owns_input(inner)
    | validate(inner, _) => owns_input(inner)
    | product(left, right) => owns_input(left) || owns_input(right)
    | choice(left, right) => owns_input(left) || owns_input(right)
    | optional(inner) => owns_input(inner)
    | default(inner, _) => owns_input(inner)
    | repeat(inner) => owns_input(inner)
    end;

pub let distinguishable(@A: Type, left: Node(A), right: Node(A)) -> Bool =
    required_block(left) && required_block(right) && owns_input(left) && owns_input(right)
        && unnamed_alternatives(left) + unnamed_alternatives(right) <= 1;

pub let named_leaf(@A: Type, tree: Node(A)) -> Bool =
    match tree | flag(_) => true | option(_, _, _) => true | _ => false end;

--- Structural invariants about this exact tree, with preservation evidence for every child.
pub let Sound(@A: Type, tree: Node(A)) -> Prop =
    match tree
    | pure(_) => True
    | flag(names) => Holds(valid_named(names))
    | option(names, _, _) => Holds(valid_named(names))
    | positional(names, _) => Holds(valid_positional(names.name))
    | rest(names, _) => Holds(valid_positional(names.name))
    | map(inner, _) => Sound(inner)
    | validate(inner, _) => Sound(inner)
    | product(left, right) =>
        {
            Sound(left),
            Sound(right),
            Holds(disjoint(aliases(left), aliases(right))),
            Holds(ordered_positions(left, right))}
    | choice(left, right) =>
        {
            Sound(left),
            Sound(right),
            Holds(disjoint(aliases(left), aliases(right))),
            Holds(distinguishable(left, right))}
    | optional(inner) => {Sound(inner), Holds(required_block(inner))}
    | default(inner, _) => {Sound(inner), Holds(required_block(inner))}
    | repeat(inner) => {Sound(inner), Holds(named_leaf(inner))}
    end;

--- A transparent grammar: the evidence certifies the tree actually interpreted.
pub struct Grammar(A: Type): pub Type {
    tree: Node(A),
    @sound: Sound(tree),
}

induct Certificate(P: Prop): Type
| valid(P)
| invalid(SpecError)
end

let certify_named(names: Named) -> Certificate(Holds(valid_named(names))) =
    match valid_long(names.long)
    | false => Certificate/invalid(SpecError/invalid_long(names.long))
    | true =>
        match names.short
        | none() => Certificate/valid(True/qed())
        | some(c) =>
            match valid_short(names.short)
            | true => Certificate/valid(True/qed())
            | false => Certificate/invalid(SpecError/invalid_short(c))
            end
        end
    end;

let certify_positional(names: Positional) -> Certificate(Holds(valid_positional(names.name))) =
    match valid_positional(names.name)
    | true => Certificate/valid(True/qed())
    | false => Certificate/invalid(SpecError/invalid_positional(names.name))
    end;

let overlaps(left: List(Alias), right: List(Alias)) -> SpecError =
    SpecError/duplicate_options(
        List/map(List/filter(left, (name) => List/contains(right, name)), alias_text));

let certify(@A: Type, tree: Node(A)) -> Certificate(Sound(tree)) =
    match tree
    | pure(_) => Certificate/valid(True/qed())
    | flag(names) => certify_named(names)
    | option(names, _, _) => certify_named(names)
    | positional(names, _) => certify_positional(names)
    | rest(names, _) => certify_positional(names)
    | map(inner, _) => certify(inner)
    | validate(inner, _) => certify(inner)
    | product(left, right) =>
        match certify(left)
        | invalid(error) => Certificate/invalid(error)
        | valid(first) =>
            match certify(right)
            | invalid(error) => Certificate/invalid(error)
            | valid(second) =>
                match disjoint(aliases(left), aliases(right))
                | false => Certificate/invalid(overlaps(aliases(left), aliases(right)))
                | true =>
                    match ordered_positions(left, right)
                    | false => Certificate/invalid(SpecError/positional_order())
                    | true => Certificate/valid((first, second, True/qed(), True/qed()))
                    end
                end
            end
        end
    | choice(left, right) =>
        match certify(left)
        | invalid(error) => Certificate/invalid(error)
        | valid(first) =>
            match certify(right)
            | invalid(error) => Certificate/invalid(error)
            | valid(second) =>
                match disjoint(aliases(left), aliases(right))
                | false => Certificate/invalid(overlaps(aliases(left), aliases(right)))
                | true =>
                    match distinguishable(left, right)
                    | true => Certificate/valid((first, second, True/qed(), True/qed()))
                    | false =>
                        choose
                        | Bool/not(required_block(left) && required_block(right)) =>
                            Certificate/invalid(SpecError/nonfixed_choice())
                        | Bool/not(owns_input(left) && owns_input(right)) =>
                            Certificate/invalid(SpecError/unselectable_choice())
                        | _ => Certificate/invalid(SpecError/ambiguous_choice())
                        end
                    end
                end
            end
        end
    | optional(inner) =>
        match certify(inner)
        | invalid(error) => Certificate/invalid(error)
        | valid(child) =>
            match required_block(inner)
            | true => Certificate/valid((child, True/qed()))
            | false => Certificate/invalid(SpecError/nonfixed_optional())
            end
        end
    | default(inner, _) =>
        match certify(inner)
        | invalid(error) => Certificate/invalid(error)
        | valid(child) =>
            match required_block(inner)
            | true => Certificate/valid((child, True/qed()))
            | false => Certificate/invalid(SpecError/nonfixed_optional())
            end
        end
    | repeat(inner) =>
        match certify(inner)
        | invalid(error) => Certificate/invalid(error)
        | valid(child) =>
            match named_leaf(inner)
            | true => Certificate/valid((child, True/qed()))
            | false => Certificate/invalid(SpecError/repeated_group())
            end
        end
    end;

--- Certify a dynamically constructed tree without changing it.
pub let checked(@A: Type, tree: Node(A)) -> Result(SpecError, Grammar(A)) =
    match certify(tree)
    | valid(proof) => Result/success(Grammar { tree = tree, @sound = proof })
    | invalid(error) => Result/failure(error)
    end;

let accepted(@P: Prop, certificate: Certificate(P)) -> Bool =
    match certificate | valid(_) => true | invalid(_) => false end;

--- The guard for a fixed declaration; `Sound` remains the actual evidence carried by the grammar.
pub let Declared(@A: Type, tree: Node(A)) -> Prop =
    Holds(accepted(certify(tree)));

--- Declare a fixed tree whose certification succeeds by reduction. Use `checked` when its shape is only known at run time.
pub let declare(@A: Type, tree: Node(A), @valid: Declared(tree)) -> Grammar(A) =
    match certify(tree): (certificate) => (held: Holds(accepted(certificate))) -> Grammar(A)
    | valid(proof) => (_) => Grammar { tree = tree, @sound = proof }
    | invalid(_) => (impossible) => match impossible end
    end(valid);

pub let reader(v: Value) -> Reader(v.A) =
    Reader { metavar = v.metavar, read = v.read };

pub let pure(@A: Type, a: A) -> Grammar(A) =
    Grammar { tree = Node/pure(a), @sound = True/qed() };

--- A required named selector, producing unit when present.
pub let flag(names: Named, @valid: Holds(valid_named(names))) -> Grammar({}) =
    Grammar { tree = Node/flag(names), @sound = valid };

--- A required named value, rejecting repeated occurrences.
pub let option(names: Named, v: Value, @valid: Holds(valid_named(names))) -> Grammar(v.A) =
    Grammar { tree = Node/option(names, reader(v), Multiplicity/reject()), @sound = valid };

pub let positional(
    names: Positional,
    v: Value,
    @valid: Holds(valid_positional(names.name)),
) -> Grammar(v.A) =
    Grammar { tree = Node/positional(names, reader(v)), @sound = valid };

pub let rest(
    names: Positional,
    v: Value,
    @valid: Holds(valid_positional(names.name)),
) -> Grammar(List(v.A)) =
    Grammar { tree = Node/rest(names, reader(v)), @sound = valid };

pub let map(@A: Type, @B: Type, grammar: Grammar(A), f: (A) -> B) -> Grammar(B) =
    Grammar { tree = Node/map(grammar.tree, f), @sound = grammar.sound };

pub let validate(@A: Type, @B: Type, grammar: Grammar(A), f: (A) -> Result(Str, B)) -> Grammar(B) =
    Grammar { tree = Node/validate(grammar.tree, f), @sound = grammar.sound };

pub let product(
    @A: Type,
    @B: Type,
    left: Grammar(A),
    right: Grammar(B),
    @apart: Holds(disjoint(aliases(left.tree), aliases(right.tree))),
    @ordered: Holds(ordered_positions(left.tree, right.tree)),
) -> Grammar({A, B}) =
    Grammar {
        tree = Node/product(left.tree, right.tree),
        @sound = (left.sound, right.sound, apart, ordered) };

pub let choice(
    @A: Type,
    left: Grammar(A),
    right: Grammar(A),
    @apart: Holds(disjoint(aliases(left.tree), aliases(right.tree))),
    @selected: Holds(distinguishable(left.tree, right.tree)),
) -> Grammar(A) =
    Grammar {
        tree = Node/choice(left.tree, right.tree),
        @sound = (left.sound, right.sound, apart, selected) };

pub let optional(
    @A: Type,
    grammar: Grammar(A),
    @block: Holds(required_block(grammar.tree)),
) -> Grammar(Option(A)) =
    Grammar { tree = Node/optional(grammar.tree), @sound = (grammar.sound, block) };

pub let default(
    @A: Type,
    grammar: Grammar(A),
    fallback: A,
    @block: Holds(required_block(grammar.tree)),
) -> Grammar(A) =
    Grammar { tree = Node/default(grammar.tree, fallback), @sound = (grammar.sound, block) };

pub let repeat(
    @A: Type,
    grammar: Grammar(A),
    @leaf: Holds(named_leaf(grammar.tree)),
) -> Grammar(List(A)) =
    Grammar { tree = Node/repeat(grammar.tree), @sound = (grammar.sound, leaf) };

--- An idempotent switch: absent is false, any explicit occurrence is true.
pub let switch(names: Named, @valid: Holds(valid_named(names))) -> Grammar(Bool) =
    default(map(flag(names), (_) => true), false);

--- Change a singular option's repetition policy before mapping or grouping it.
pub let on_repeat(
    @A: Type,
    grammar: Grammar(A),
    policy: Multiplicity,
    @single: Holds(match grammar.tree | option(_, _, _) => true | _ => false end),
) -> Grammar(A) =
    match grammar.tree
    | option(names, read, _) =>
        Grammar { tree = Node/option(names, read, policy), @sound = grammar.sound }
    | pure(_) => match single end
    | flag(_) => match single end
    | positional(_, _) => match single end
    | rest(_, _) => match single end
    | map(_, _) => match single end
    | validate(_, _) => match single end
    | product(_, _) => match single end
    | choice(_, _) => match single end
    | optional(_) => match single end
    | default(_, _) => match single end
    | repeat(_) => match single end
    end;
