mod scan;
use scan/{Raw};
use /std/{Str, Nat, Bool, List, Option, Result, Map};
use /std/Bool/{Holds, True};
use /std/Cli/Error/{Certificate};
use /std/Cli/{Failure, Error, Prepared, Reading};
use /std/Cli/Grammar/{Node, Sound, Reader, Multiplicity, Alias};
use /std/Cli/{Grammar};

--- The declared aliases leave each active built-in spelling available. Preparation separately proves that the scanner's lookup corresponds to this grammar.
pub let Available(names: List(Alias), version: Option(Str)) -> Prop =
    {
        Holds(Grammar/disjoint([Alias/long("help")], names)),
        Holds(Grammar/disjoint([Alias/short('h')], names)),
        Holds(
            match version
            | none() => true
            | some(_) => Grammar/disjoint([Alias/long("version")], names)
            end)};

pub let certify_builtins(
    names: List(Alias),
    version: Option(Str),
) -> Certificate(Available(names, version)) =
    match Grammar/disjoint([Alias/long("help")], names)
    | false => Certificate/invalid(Error/builtin_collision("--help"))
    | true =>
        match Grammar/disjoint([Alias/short('h')], names)
        | false => Certificate/invalid(Error/builtin_collision("-h"))
        | true =>
            match version
            | none() => Certificate/valid((True/qed(), True/qed(), True/qed()))
            | some(_) =>
                match Grammar/disjoint([Alias/long("version")], names)
                | false => Certificate/invalid(Error/builtin_collision("--version"))
                | true => Certificate/valid((True/qed(), True/qed(), True/qed()))
                end
            end
        end
    end;

struct Assigned(limit: Nat): Type {
    raw: Raw(limit),
    choices: Map(Nat, Bool),
}

let occurred(@limit: Nat, raw: Raw(limit), id: Nat) -> Bool =
    Map/has(raw.present, id);

let activate(@limit: Nat, assigned: Assigned(limit), id: Nat) -> Assigned(limit) =
    Assigned {
        ..assigned,
        raw = Raw { ..assigned.raw, present = Map/insert(assigned.raw.present, id, ()) } };

let labels(@A: Type, tree: Node(A)) -> List(Str) =
    match tree
    | positional(names, _) => [names.name]
    | rest(names, _) => [names.name]
    | map(inner, _) => labels(inner)
    | validate(inner, _) => labels(inner)
    | product(left, right) => [..labels(left), ..labels(right)]
    | choice(left, right) => [..labels(left), ..labels(right)]
    | optional(inner) => labels(inner)
    | default(inner, _) => labels(inner)
    | repeat(inner) => labels(inner)
    | _ => List/map(Grammar/aliases(tree), Grammar/alias_text)
    end;

--- Allocation uses explicit ownership and the remaining positional suffix; it never calls a value reader.
let allocate(
    @A: Type,
    @limit: Nat,
    tree: Node(A),
    start: Nat,
    assigned: Assigned(limit),
) -> Result(Failure, Assigned(limit)) =
    match tree
    | pure(_) => Result/success(assigned)
    | flag(_) => Result/success(assigned)
    | option(_, _, _) => Result/success(assigned)
    | positional(names, _) =>
        match assigned.raw.positional
        | [] => Result/failure(Failure/missing_required(names.name))
        | [value, ..rest] =>
            Result/success(
                Assigned {
                    ..assigned,
                    raw =
                        Raw {
                            ..assigned.raw,
                            occurrences = Map/insert(assigned.raw.occurrences, start, [value]),
                            positional = rest } })
        end
    | rest(_, _) =>
        Result/success(
            Assigned {
                ..assigned,
                raw =
                    Raw {
                        ..assigned.raw,
                        occurrences =
                            Map/insert(
                                assigned.raw.occurrences,
                                start,
                                List/reverse(assigned.raw.positional)),
                        positional = [] } })
    | map(inner, _) => allocate(inner, start + 1, assigned)
    | validate(inner, _) => allocate(inner, start + 1, assigned)
    | product(left, right) =>
        let first = allocate(left, start + 1, assigned)!;
        allocate(right, start + 1 + Prepared/size(left), first)
    | choice(left, right) =>
        let first = start + 1;
        let second = start + 1 + Prepared/size(left);
        let from_left = occurred(assigned.raw, first);
        let from_right = occurred(assigned.raw, second);
        let select(take_left: Bool) -> Result(Failure, Assigned(limit)) =
            let next =
                Assigned { ..assigned, choices = Map/insert(assigned.choices, start, take_left) };
            match take_left
            | true => allocate(left, first, next)
            | false => allocate(right, second, next)
            end;
        choose
        | from_left && from_right =>
            Result/failure(Failure/conflict([..labels(left), ..labels(right)]))
        | from_left => select(true)
        | from_right => select(false)
        | 0 < List/len(assigned.raw.positional) && Bool/not(Grammar/requires_named(left))
            && Grammar/has_positions(left) => select(true)
        | 0 < List/len(assigned.raw.positional) && Bool/not(Grammar/requires_named(right))
            && Grammar/has_positions(right) => select(false)
        | _ => Result/failure(Failure/missing_alternative([..labels(left), ..labels(right)]))
        end
    | optional(inner) =>
        match occurred(assigned.raw, start)
            || Grammar/has_positions(inner) && 0 < List/len(assigned.raw.positional)
        | false => Result/success(assigned)
        | true => allocate(inner, start + 1, activate(assigned, start))
        end
    | default(inner, _) =>
        match occurred(assigned.raw, start)
            || Grammar/has_positions(inner) && 0 < List/len(assigned.raw.positional)
        | false => Result/success(assigned)
        | true => allocate(inner, start + 1, activate(assigned, start))
        end
    | repeat(_) => Result/success(assigned)
    end;

let occurrences(@limit: Nat, raw: Raw(limit), at: Nat) -> List(Str) =
    List/reverse(Map/get_or(raw.occurrences, at, []));

let read(@A: Type, name: Str, reader: Reader(A), value: Str) -> Result(Failure, A) =
    Result/map_failure(reader.read(value), (reason) => Failure/bad_value(name, reason));

let single(
    @A: Type,
    name: Str,
    reader: Reader(A),
    policy: Multiplicity,
    found: List(Str),
) -> Result(Failure, A) =
    match found
    | [] => Result/failure(Failure/missing_required(name))
    | [value, ..more] =>
        match more
        | [] => read(name, reader, value)
        | [_, .._] =>
            match policy
            | reject() => Result/failure(Failure/repeated(name))
            | last() => read(name, reader, List/fold(more, value, (next, _) => next))
            end
        end
    end;

let repeated(
    @A: Type,
    @limit: Nat,
    tree: Node(A),
    start: Nat,
    raw: Raw(limit),
    @leaf: Holds(Grammar/named_leaf(tree)),
) -> Result(Failure, List(A)) =
    match tree
    | flag(_) => Result/success(List/map(occurrences(raw, start), (_) => ()))
    | option(names, reader, _) =>
        List/traverse(occurrences(raw, start), (value) => read(names.long, reader, value))
    | pure(_) => match leaf end
    | positional(_, _) => match leaf end
    | rest(_, _) => match leaf end
    | map(_, _) => match leaf end
    | validate(_, _) => match leaf end
    | product(_, _) => match leaf end
    | choice(_, _) => match leaf end
    | optional(_) => match leaf end
    | default(_, _) => match leaf end
    | repeat(_) => match leaf end
    end;

--- The fixed typed interpreter constructs values from this tree's actual leaves and mapping functions.
let decode(
    @A: Type,
    @limit: Nat,
    tree: Node(A),
    start: Nat,
    assigned: Assigned(limit),
    @sound: Sound(tree),
) -> Result(Failure, A) =
    match tree
    | pure(a) => Result/success(a)
    | flag(names) =>
        match occurred(assigned.raw, start)
        | true => Result/success(())
        | false => Result/failure(Failure/missing_required(names.long))
        end
    | option(names, reader, policy) =>
        single(names.long, reader, policy, occurrences(assigned.raw, start))
    | positional(names, reader) =>
        single(names.name, reader, Multiplicity/reject(), occurrences(assigned.raw, start))
    | rest(names, reader) =>
        List/traverse(occurrences(assigned.raw, start), (value) => read(names.name, reader, value))
    | map(inner, f) => Result/map_success(decode(inner, start + 1, assigned, @sound), f)
    | validate(inner, f) =>
        let value = decode(inner, start + 1, assigned, @sound)!;
        Result/map_failure(f(value), Failure/validation)
    | product(left, right) =>
        let first = decode(left, start + 1, assigned, @sound.0)!;
        let second = decode(right, start + 1 + Prepared/size(left), assigned, @sound.1)!;
        Result/success((first, second))
    | choice(left, right) =>
        match Map/get(assigned.choices, start)
        | some(true) => decode(left, start + 1, assigned, @sound.0)
        | some(false) => decode(right, start + 1 + Prepared/size(left), assigned, @sound.1)
        | none() => Result/failure(Failure/missing_alternative([..labels(left), ..labels(right)]))
        end
    | optional(inner) =>
        match occurred(assigned.raw, start)
        | false => Result/success(Option/none())
        | true => Result/map_success(decode(inner, start + 1, assigned, @sound.0), Option/some)
        end
    | default(inner, fallback) =>
        match occurred(assigned.raw, start)
        | false => Result/success(fallback)
        | true => decode(inner, start + 1, assigned, @sound.0)
        end
    | repeat(inner) => repeated(inner, start + 1, assigned.raw, @sound.1)
    end;

--- Own tokens once, allocate structurally, and decode only selected leaves. The caller supplies compatibility with active built-ins.
pub let certified(
    @A: Type,
    prepared: Prepared(A),
    argv: List(Str),
    version: Option(Str),
    @_: Available(Grammar/aliases(prepared.grammar.tree), version),
) -> Reading(A) =
    let raw = scan/scan(prepared.lookup, argv, Option/is_some(version));
    choose
    | raw.help => Reading/help()
    | some(text) = Option/filter(version, (_) => raw.version) => Reading/version(text)
    | some(failure) = raw.failure => Reading/failure(failure)
    | _ =>
        let parsed() -> Result(Failure, A) =
            let assigned =
                allocate(prepared.grammar.tree, 0, Assigned { raw = raw, choices = Map/empty() })!;
            match assigned.raw.positional
            | [value, .._] => Result/failure(Failure/unexpected(value))
            | [] => decode(prepared.grammar.tree, 0, assigned, @prepared.grammar.sound)
            end;
        match parsed() | failure(f) => Reading/failure(f) | success(a) => Reading/parsed(a) end
    end;

--- Check dynamic built-in compatibility before interpreting a standalone grammar.
pub let interpret(
    @A: Type,
    prepared: Prepared(A),
    argv: List(Str),
    version: Option(Str),
) -> Result(Error, Reading(A)) =
    match certify_builtins(Grammar/aliases(prepared.grammar.tree), version)
    | invalid(error) => Result/failure(error)
    | valid(available) => Result/success(certified(prepared, argv, version, @available))
    end;
