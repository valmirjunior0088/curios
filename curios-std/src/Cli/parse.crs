use /std/{Str, Nat, Bool, List, Option, Result, Map};
use /std/Cli/{Value, nat, Field, Presence, Positional, Positionals, Command, Failure, Reading,
    Carrier, Values, Parsed, Chosen, option_slots, slots, shouted, scan};
use /std/Cli/Parsed/{presented, required_slots, optional_slots, rest_slots, appended};
use /std/Cli/scan/{Seen, Raw};

let lifted(@A: Type, @B: Type, r: Reading(A), f: (A) -> B) -> Reading(B) =
    match r
    | parsed(a) => Reading/parsed(f(a))
    | help(path) => Reading/help(path)
    | version(text) => Reading/version(text)
    | refused(path, failure) => Reading/refused(path, failure)
    end;

let reading(v: Value, name: Str, text: Str) -> Result(Failure, v.A) =
    match v.read(text)
    | success(a) => Result/success(a)
    | failure(reason) => Result/failure(Failure/bad_value(name, reason))
    end;

let readings(v: Value, name: Str, texts: List(Str)) -> Result(Failure, List(v.A)) =
    match texts
    | [] => Result/success([])
    | [t, ..more] =>
        let a = reading(v, name, t)!;
        let rest = readings(v, name, more)!;
        Result/success([a, ..rest])
    end;

-- What an environment variable says of a flag: anything but nothing, `0` and `false` sets it.
let truthy(text: Str) -> Bool =
    Bool/not(text == "" || text == "0" || text == "false");

let given(seen: List(Seen)) -> Nat =
    List/len(List/filter(seen, (s) => match s | given() => true | _ => false end));

let texts(seen: List(Seen)) -> List(Str) =
    List/concat_map(seen, (s) => match s | value(t) => [t] | _ => [] end);

let switched(seen: List(Seen)) -> Option(Bool) =
    List/fold(
        seen,
        Option/none(),
        (s, held) =>
            match s
            | given() => Option/some(true)
            | negated() => Option/some(false)
            | _ => held
            end);

let picks(seen: List(Seen)) -> List(Nat) =
    List/fold(
        List/reverse(seen),
        [],
        (s, held) =>
            match s
            | picked(k) => match List/contains(held, k) | true => held | false => [k, ..held] end
            | _ => held
            end);

let present(@A: Type, presence: Presence(A), a: A) -> presented(A, presence) =
    match presence | required() => a | optional() => Option/some(a) | default(_) => a end;

let absent(@A: Type, presence: Presence(A), name: Str) -> Result(Failure, presented(A, presence)) =
    match presence
    | required() => Result/failure(Failure/missing_required(name))
    | optional() => Result/success(Option/none())
    | default(a) => Result/success(a)
    end;

let read_field(f: Field, seen: List(Seen), env: Map(Str, Str)) -> Result(Failure, Carrier(f.kind)) =
    let name = Str/concat("--", f.long);
    let set = Option/bind(f.env, (variable) => Map/try_get(env, variable));
    match f.kind
    | flag() =>
        Result/success(given(seen) > 0 || match set | some(t) => truthy(t) | none() => false end)
    | count() =>
        match given(seen) == 0
        | true => match set | some(t) => reading(nat, name, t) | none() => Result/success(0) end
        | false => Result/success(given(seen))
        end
    | toggle(fallback) =>
        match switched(seen)
        | some(b) => Result/success(b)
        | none() => Result/success(match set | some(t) => truthy(t) | none() => fallback end)
        end
    | option(v, presence) =>
        match Option/or(List/last(texts(seen)), set)
        | some(t) => Result/map(reading(v, name, t), (a) => present(presence, a))
        | none() => absent(presence, name)
        end
    | many(v) =>
        match texts(seen)
        | [] => match set | some(t) => readings(v, name, [t]) | none() => Result/success([]) end
        | _ => readings(v, name, texts(seen))
        end
    | choice(_, alternatives, presence) =>
        let spelled = List/map(alternatives, (a) => Str/concat("--", a.long));
        match picks(seen)
        | [] =>
            match Option/bind(set, (t) => List/find(alternatives, (a) => a.long == t))
            | some(a) => Result/success(present(presence, a.value))
            | none() => absent(presence, Str/join(" | ", spelled))
            end
        | [k, ..more] =>
            match more
            | [] =>
                match List/try_get(alternatives, k)
                | some(a) => Result/success(present(presence, a.value))
                | none() => absent(presence, Str/join(" | ", spelled))
                end
            | [_, .._] =>
                Result/failure(
                    Failure/conflict(
                        List/concat_map(
                            picks(seen),
                            (i) =>
                                match List/try_get(spelled, i)
                                | some(s) => [s]
                                | none() => []
                                end)))
            end
        end
    end;

let read_options(
    fields: List(Field),
    at: Nat,
    seen: Map(Nat, List(Seen)),
    env: Map(Str, Str),
) -> Result(Failure, Values(option_slots(fields))) =
    match fields
    | [] => Result/success(Values/nil())
    | [f, ..more] =>
        let head = read_field(f, List/reverse(Option/unwrap_or(Map/try_get(seen, at), [])), env)!;
        let tail = read_options(more, at + 1, seen, env)!;
        Result/success(Values/cons(head, tail))
    end;

let read_required(
    ps: List(Positional),
    tokens: List(Str),
) -> Result(Failure, {Values(required_slots(ps)), List(Str)}) =
    match ps
    | [] => Result/success((Values/nil(), tokens))
    | [p, ..more] =>
        match tokens
        | [] => Result/failure(Failure/missing_required(shouted(p.name)))
        | [t, ..rest] =>
            let a = reading(p.v, shouted(p.name), t)!;
            let (tail, left) = read_required(more, rest)!;
            Result/success((Values/cons(a, tail), left))
        end
    end;

let read_optional(
    ps: List(Positional),
    tokens: List(Str),
) -> Result(Failure, {Values(optional_slots(ps)), List(Str)}) =
    match ps
    | [] => Result/success((Values/nil(), tokens))
    | [p, ..more] =>
        match tokens
        | [] =>
            let (tail, left) = read_optional(more, [])!;
            Result/success((Values/cons(Option/none(), tail), left))
        | [t, ..rest] =>
            let a = reading(p.v, shouted(p.name), t)!;
            let (tail, left) = read_optional(more, rest)!;
            Result/success((Values/cons(Option/some(a), tail), left))
        end
    end;

let read_rest(p: Option(Positional), tokens: List(Str)) -> Result(Failure, Values(rest_slots(p))) =
    match p
    | none() =>
        match tokens
        | [] => Result/success(Values/nil())
        | [t, .._] => Result/failure(Failure/unexpected(t))
        end
    | some(r) =>
        let all = readings(r.v, shouted(r.name), tokens)!;
        Result/success(Values/cons(all, Values/nil()))
    end;

let leaf_values(
    options: List(Field),
    ps: Positionals,
    raw: Raw,
    env: Map(Str, Str),
) -> Result(Failure, Values(slots(options, ps))) =
    let o = read_options(options, 0, raw.seen, env)!;
    let (r, after_required) = read_required(ps.required, raw.positionals)!;
    let (q, after_optional) = read_optional(ps.optional, after_required)!;
    let t = read_rest(ps.rest, after_optional)!;
    Result/success(appended(o, appended(r, appended(q, t))));

-- What `raw` asks before the line is read further: help, then the version, then the first refusal.
let asked(@A: Type, raw: Raw, path: List(Str), version: Option(Str)) -> Option(Reading(A)) =
    choose
    | raw.help => Option/some(Reading/help(path))
    | some(text) = Option/filter(version, (_) => raw.version) => Option/some(Reading/version(text))
    | some(f) = raw.failure => Option/some(Reading/refused(path, f))
    | _ => Option/none()
    end;

pub let command(
    c: Command,
    tokens: List(Str),
    path: List(Str),
    version: Option(Str),
    env: Map(Str, Str),
) -> Reading(Parsed(c)) =
    match c
    | leaf(name, _, options, ps) =>
        let here = [..path, name];
        let raw = scan/line(options, version, tokens, false);
        match asked(raw, here, version)
        | some(early) => early
        | none() =>
            match leaf_values(options, ps, raw, env)
            | success(v) => Reading/parsed(Parsed/leaf(v))
            | failure(f) => Reading/refused(here, f)
            end
        end
    | group(name, _, options, commands) =>
        let here = [..path, name];
        let raw = scan/line(options, version, tokens, true);
        let known = List/map(commands, /std/Cli/name);
        match asked(raw, here, version)
        | some(early) => early
        | none() =>
            match raw.rest
            | [] => Reading/refused(here, Failure/missing_command(known))
            | [word, ..more] =>
                match read_options(options, 0, raw.seen, env)
                | failure(f) => Reading/refused(here, f)
                | success(v) =>
                    match chosen(commands, word, more, here, version, env)
                    | some(r) => lifted(r, (ch) => Parsed/group(v, ch))
                    | none() =>
                        Reading/refused(
                            here,
                            Failure/unknown_command(word, scan/closest(word, known), known))
                    end
                end
            end
        end
    end
and chosen(
    commands: List(Command),
    word: Str,
    tokens: List(Str),
    path: List(Str),
    version: Option(Str),
    env: Map(Str, Str),
) -> Option(Reading(Chosen(commands))) =
    match commands
    | [] => Option/none()
    | [c, ..rest] =>
        match /std/Cli/name(c) == word
        | true => Option/some(lifted(command(c, tokens, path, version, env), Chosen/here))
        | false =>
            Option/map(
                chosen(rest, word, tokens, path, version, env),
                (r) => lifted(r, Chosen/there))
        end
    end;
