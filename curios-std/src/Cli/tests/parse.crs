-- The token grammar, row by row: one declaration, many lines, each read to one string whichever way it went.
use /std/{Cli, Str, Nat, Bool, Option, List, Map, Test};

let serve: Cli =
    Cli/declare(
        Cli/leaf(
            "serve",
            "Serve a directory over HTTP",
            [
                Cli/Field { ..Cli/flag("verbose", "Log every request"), short = Option/some('v') },
                Cli/Field {
                    ..Cli/default("port", Cli/nat, 8080, "Port to listen on"),
                    short = Option/some('p') },
                Cli/many("header", Cli/str, "Repeatable")],
            Cli/positionals([Cli/positional("root", Cli/str, "Directory to serve")])),
        Option/some("1.0.0"));

let why(f: Cli/Failure) -> Str =
    match f
    | unknown_option(t, near) =>
        Str/flatten([
            "unknown ", t,
            match near | some(n) => Str/concat(" near ", n) | none() => "" end])
    | missing_value(n) => Str/concat("missing value for ", n)
    | missing_required(n) => Str/concat("missing ", n)
    | unexpected(t) => Str/concat("unexpected ", t)
    | bad_value(n, r) => Str/flatten(["bad ", n, ": ", r])
    | _ => "not this command's"
    end;

let read(argv: List(Str)) -> Str =
    match Cli/parse(serve, argv, Map/empty())
    | parsed(p) =>
        Str/join(" ", [
            Bool/to_str(Cli/get(p, "verbose")),
            Nat/to_str(Cli/get(p, "port")),
            Str/join(",", Cli/get(p, "header")),
            Cli/get(p, "root")])
    | help(_) => "help"
    | version(text) => Str/concat("version ", text)
    | refused(_, f) => why(f)
    end;

test an_option_takes_the_next_token_or_the_one_glued_to_it =
    Test/all([
        Test/equal(read(["--port", "9090", "/srv"]), "false 9090  /srv"),
        Test/equal(read(["--port=9090", "/srv"]), "false 9090  /srv"),
        Test/equal(read(["-p9090", "/srv"]), "false 9090  /srv"),
        Test/equal(read(["-vp", "9090", "/srv"]), "true 9090  /srv")]);

-- A value-taking option owns its next token, whatever it looks like.
test an_option_owns_its_next_token_whatever_it_looks_like =
    Test/equal(read(["--header", "--port", "/srv"]), "false 8080 --port /srv");

-- `--` ends the options, so a token that looks like one fills the positional instead; a dash and a digit is a value, as a negative number is, since no short name is a digit.
test a_double_dash_and_a_negative_number_are_positionals =
    Test/all([
        Test/equal(read(["--", "-weird"]), "false 8080  -weird"),
        Test/equal(read(["-5"]), "false 8080  -5")]);

-- Help is decided before the line is understood, so it answers over a line that would otherwise parse and over one that would otherwise fail; the version comes next.
test help_and_the_version_answer_before_any_other_reading =
    Test/all([
        Test/equal(read(["--port", "1", "--help"]), "help"),
        Test/equal(read(["--prot", "-h"]), "help"),
        Test/equal(read(["--version", "--prot"]), "version 1.0.0")]);

test each_refusal_names_what_the_line_got_wrong =
    Test/all([
        Test/equal(read(["--prot", "/srv"]), "unknown --prot near --port"),
        Test/equal(read(["--zzzzz", "/srv"]), "unknown --zzzzz"),
        Test/equal(read(["-x", "/srv"]), "unknown -x"),
        Test/equal(read(["/srv", "--port"]), "missing value for --port"),
        Test/equal(read(["--verbose=yes", "/srv"]), "bad --verbose: this flag takes no value"),
        Test/equal(read([]), "missing ROOT"),
        Test/equal(read(["a", "b"]), "unexpected b")]);

-- A reader refusing a value reports its own reason, named against the option that asked for it.
test a_reader_that_refuses_a_value_reports_its_own_reason =
    Test/equal(
        read(["--port", "http", "/srv"]),
        "bad --port: expected a natural number, found 'http'");
