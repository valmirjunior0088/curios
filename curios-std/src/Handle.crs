pub use /sys/{Handle};
pub use /sys/Handle/{stdin, stdout, stderr, ready};
use /std/{Bool, Byte, Bytes, Nat, Int, List, Option, Result, Io};
use /std/Bool/{Holds};

--- Close this handle.
foreign handle_close(Handle) -> {};

--- Close `h`. Closing a handle that names nothing does nothing.
pub let close(h: Handle) -> Io({}) =
    handle_close(h);

--- What a wait asks to be woken for.
pub mod Interest;
pub use Interest/{let Interest};

--- What a poll reports for one handle.
pub mod Readiness;
pub use Readiness/{let Readiness};

let flagged(report: Byte, flag: Byte) -> Bool =
    Byte/to_nat(report && flag) > 0;

--- The handles of `waits` that are waited on to read, in their order.
let readers(waits: List({Handle, Interest})) -> List(Handle) =
    match waits
    | [] => []
    | [w, ..rest] =>
        match w.1.readable | true => [w.0, ..readers(rest)] | false => readers(rest) end
    end;

--- The handles of `waits` that are waited on to write, in their order.
let writers(waits: List({Handle, Interest})) -> List(Handle) =
    match waits
    | [] => []
    | [w, ..rest] =>
        match w.1.writable | true => [w.0, ..writers(rest)] | false => writers(rest) end
    end;

--- The next report of a list for a wait that stands in it, beside the reports after it; a wait that does not stand there takes none, and a list that has run out reports nothing.
let taken(stands: Bool, reports: Bytes) -> {Byte, Bytes} =
    match stands
    | false => (0, reports)
    | true => match reports | x[] => (0, x[]) | x[r, ..rest] => (r, rest) end
    end;

--- What a poll reports of one wait: each direction fired where that list's report says ready, and the handle failed or hung up where either list's says so.
let of_reports(read: Byte, wrote: Byte) -> Readiness =
    Readiness {
        fired =
            Interest {
                readable = flagged(read, /sys/event/ready),
                writable = flagged(wrote, /sys/event/ready) },
        failed = flagged(read || wrote, /sys/event/err),
        hung_up = flagged(read || wrote, /sys/event/hup) };

--- One report for each wait, in the waits' order: a wait takes the next report of each list it stands in.
let reports(waits: List({Handle, Interest}), readable: Bytes, writable: Bytes) -> List(Readiness) =
    match waits
    | [] => []
    | [w, ..rest] =>
        let read = taken(w.1.readable, readable);
        let wrote = taken(w.1.writable, writable);
        [of_reports(read.0, wrote.0), ..reports(rest, read.1, wrote.1)]
    end;

--- Wait for so many milliseconds on the first handles to read and the second to write: a byte of what is reported for each handle of each list, in the list's order.
foreign handle_poll(List(Handle), List(Handle), Int) -> {readable: Bytes, writable: Bytes};

--- Wait until a handle is ready for the interest beside it, or until `timeout` milliseconds pass; a negative timeout waits forever and zero answers at once. One report answers each wait, in the waits' order.
pub let poll(waits: List({Handle, Interest}), timeout: Int) -> Io(List(Readiness)) =
    let polled = handle_poll(readers(waits), writers(waits), timeout)!;
    Io/pure(reports(waits, polled.readable, polled.writable));

--- A handle ready once the handle is ready to read where the first flag asks, to write where the second does, or has failed or hung up.
foreign handle_watch(Handle, Bool, Bool) -> Handle;

--- A handle ready once `h` is ready for what `interest` asks, or has failed or hung up: what a description suspends on to wait for `h`. Closing it leaves `h` as it is.
pub let watch(h: Handle, interest: Interest) -> Io(Handle) =
    handle_watch(h, interest.readable, interest.writable);

--- A byte for each handle, in the list's order: `event/ready` where it is ready now.
foreign handle_ready(List(Handle)) -> Bytes;

--- Whether each report says ready, in their order.
let each_ready(reports: Bytes) -> List(Bool) =
    match reports
    | x[] => []
    | x[r, ..rest] => [flagged(r, /sys/event/ready), ..each_ready(rest)]
    end;

--- Whether each handle of `on` is ready now, in its order, without waiting: a watch as its handle is, a timer once its instant has passed, and any other handle at once.
pub let ready_now(on: List(Handle)) -> Io(List(Bool)) =
    let reports = handle_ready(on)!;
    Io/pure(each_ready(reports));

--- A successful read's bytes as the chunk they are, or the end of the stream where there are none: a read of a positive count that answers nothing is the end, as a zero-byte `read(2)` is.
let answered(b: Bytes) -> Io/Chunk =
    match b | x[] => Io/Chunk/eof() | x[_, .._] => Io/Chunk/chunk(b) end;

--- Read up to so many bytes: `ok` beside them, `eof` at the end of the stream, or the status of the failure.
foreign handle_read(Handle, Nat) -> {status: Nat, bytes: Bytes};

--- A read's reply as its outcome: `ok` beside its bytes, `eof` the end of the stream, and any other status the failure it names.
let reading(h: Handle, n: Nat) -> Io(Result(Nat, Option(Bytes))) =
    let reply = handle_read(h, n)!;
    Io/pure(
        choose
        | reply.status == /sys/status/ok => Result/success(Option/some(reply.bytes))
        | reply.status == /sys/status/eof => Result/success(Option/none())
        | _ => Result/failure(reply.status)
        end);

--- A write's reply as its outcome. One that accepted nothing of the `offered` bytes, where there were some, is the failure no errno names: a loop that resends what is left would resend it for ever.
let accepted(offered: Nat, status: Nat, written: Nat) -> Result(Nat, Nat) =
    choose
    | status != /sys/status/ok => Result/failure(status)
    | written == 0 && 0 < offered => Result/failure(/sys/status/other_base)
    | _ => Result/success(written)
    end;

--- Write these bytes: `ok` beside how many were accepted, or the status of the failure.
foreign handle_write(Handle, Bytes) -> {status: Nat, written: Nat};

let writing(h: Handle, b: Bytes) -> Io(Result(Nat, Nat)) =
    let reply = handle_write(h, b)!;
    Io/pure(accepted(Bytes/len(b), reply.status, reply.written));

--- Hand on what is still held of this handle's writes: `ok`, or the status of the failure.
foreign handle_flush(Handle) -> Nat;

let flushing(h: Handle) -> Io(Result(Nat, {})) =
    let status = handle_flush(h)!;
    Io/pure(
        match status == /sys/status/ok
        | true => Result/success(())
        | false => Result/failure(status)
        end);

--- End this handle's sending half: `ok`, or the status of the failure.
foreign handle_finish(Handle) -> Nat;

let finishing(h: Handle) -> Io(Result(Nat, {})) =
    let status = handle_finish(h)!;
    Io/pure(
        match status == /sys/status/ok
        | true => Result/success(())
        | false => Result/failure(status)
        end);

--- Until `h` is ready for `interest`, or has failed or hung up: a suspension on a watch of it, closed whether the wait ends or is cancelled. Readiness is advisory, so what waits retries the operation it waited for, and waits again where it would still block.
pub let wait(h: Handle, interest: Interest) -> Io({}) =
    Io/wait_minted(watch(h, interest));

--- Up to `n` bytes, waiting while the host would block.
let read_waiting(h: Handle, n: Nat, @positive: Holds(0 < n)) -> Io(Io/Chunk) =
    let r = reading(h, n)!;
    match r
    | success(some(b)) => Io/pure(answered(b))
    | success(none()) => Io/pure(Io/Chunk/eof())
    | failure(s) =>
        choose
        | s == /sys/status/would_block =>
            let _ = wait(h, Interest/readable)!;
            read_waiting(h, n, @positive)
        | _ => Io/pure(Io/Chunk/error(Io/Error/of(s)))
        end
    end;

--- The whole of `b`, waiting while the host would block and resending a short write; the first failure is the answer.
let write_waiting(h: Handle, b: Bytes) -> Io(Result(Io/Error, {})) =
    let r = writing(h, b)!;
    match r
    | success(written) =>
        choose
        | written < Bytes/len(b) => write_waiting(h, Bytes/drop(b, written))
        | _ => Io/pure(Result/success(()))
        end
    | failure(s) =>
        choose
        | s == /sys/status/would_block =>
            let _ = wait(h, Interest/writable)!;
            write_waiting(h, b)
        | _ => Io/pure(Result/failure(Io/Error/of(s)))
        end
    end;

--- What `h` holds of the writes it accepted, handed on, waiting while the host would block.
let flush_waiting(h: Handle) -> Io(Result(Io/Error, {})) =
    let r = flushing(h)!;
    match r
    | success(_) => Io/pure(Result/success(()))
    | failure(s) =>
        choose
        | s == /sys/status/would_block =>
            let _ = wait(h, Interest/writable)!;
            flush_waiting(h)
        | _ => Io/pure(Result/failure(Io/Error/of(s)))
        end
    end;

--- `h`'s sending half ended and its receiving half left as it is, waiting while the host would block: the peer reads the end of the stream, a TLS stream's closure alert ahead of it, and `h` still reads what the peer sends. Only a connected socket has a sending half of its own to end, and any other handle is `not_found`.
pub let finish(h: Handle) -> Io(Result(Io/Error, {})) =
    let r = finishing(h)!;
    match r
    | success(_) => Io/pure(Result/success(()))
    | failure(s) =>
        choose
        | s == /sys/status/would_block =>
            let _ = wait(h, Interest/writable)!;
            finish(h)
        | _ => Io/pure(Result/failure(Io/Error/of(s)))
        end
    end;

satisfy Io/Read(Handle) {
    read(h, n, @positive) = read_waiting(h, n, @positive),
}

satisfy Io/Write(Handle) {
    write(h, b) = write_waiting(h, b),
    flush(h) = flush_waiting(h),
}
