mod tests;

use /std/{Io};

--- What may close a program: a type whose value is executed as one.
---
--- The compiler writes `execute` around the term a program closes with, so that term is of any type with a witness here. One witness may occupy a head, so a type closes a program in one way: `Io` at `{}` and no other payload, `Try` over `Io` and no other base.
pub concept Program(T: Type): pub Type {
    --- The value executed as a whole program. Where it does not succeed it says why and ends the process with a status that is not `0`.
    execute(T) -> Io({}),
}

pub use Program/*;

--- A program that closes with `()` has done what it does by its last `!`.
satisfy Program({}) {
    execute(_) = Io/pure(()),
}
