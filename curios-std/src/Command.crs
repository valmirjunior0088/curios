use /std/{Bool, Bytes, Nat, Str, List, Option, Result, Path, Try, Io, Async};

--- How a child's standard stream is wired: shared with this process, piped to the parent, or attached to the null device.
pub induct Stdio: pub Type
--- The child shares this process's own stream.
| inherit()
--- The parent gets a pipe to it.
| piped()
--- It goes to the null device.
| null()
end

--- How a child ended: with an exit code, or by a signal.
pub mod Exit;
pub use Exit/{let Exit};

--- A pipe to one of a child's streams: reading it, writing it and closing it.
pub mod Pipe;
pub use Pipe/{let Pipe};

--- A running child: its pipes, waiting for it and ending it.
pub mod Child;
pub use Child/{let Child};

--- A program to run, and how to run it.
pub struct Command: pub Type {
    program: Str,
    args: List(Str),
    --- The working directory, or the parent's.
    cwd: Option(Path),
    --- Entries laid over the inherited environment.
    env: List({Str, Str}),
    stdin: Stdio,
    stdout: Stdio,
    stderr: Stdio,
}

--- `program` with `args`, inheriting the working directory, the environment and every stream.
pub let new(program: Str, args: List(Str)) -> Command =
    Command {
        program = program,
        args = args,
        cwd = Option/none(),
        env = [],
        stdin = Stdio/inherit(),
        stdout = Stdio/inherit(),
        stderr = Stdio/inherit(),
    };

let stdio_of(s: Stdio) -> Nat =
    match s
    | inherit() => /sys/stdio_mode/inherit
    | piped() => /sys/stdio_mode/pipe
    | null() => /sys/stdio_mode/null
    end;

let env_entry(entry: {Str, Str}) -> Bytes =
    x[..Str/to_bytes(entry.0), '=', ..Str/to_bytes(entry.1)];

--- Whether `key` can name an environment variable: something, and no `=`, which would end the name early in the `NAME=VALUE` entry it crosses as.
let names_a_variable(key: Str) -> Bool =
    match Str/is_empty(key) | true => false | false => Bool/not(Str/contains(key, '=')) end;

--- Nothing, or `EINVAL` for an entry whose key names no variable.
let env_checked(env: List({Str, Str})) -> Result(Io/Error, {}) =
    match List/all(env, (entry) => names_a_variable(entry.0))
    | true => Result/success(())
    | false => Result/failure(Io/Error/other(/sys/errno/inval))
    end;

--- Start `cmd`. Nothing guards the child: `Child/with` is the bracket that kills it when the task around it ends. The child arrives with a pipe for each stream `cmd` piped, in the one call that starts it. An environment key that is empty or holds `=` names no variable, and is refused with `EINVAL` before anything starts.
pub let spawn(cmd: Command) -> Try(Io, Io/Error, Child) =
    let _ = env_checked(cmd.env)!;
    let spawned =
        Io/Error/of_result(
            /sys/proc/spawn(
                [Str/to_bytes(cmd.program), ..List/map(cmd.args, Str/to_bytes)],
                match cmd.cwd | some(p) => Path/to_bytes(p) | none() => x[] end,
                List/map(cmd.env, env_entry),
                stdio_of(cmd.stdin),
                stdio_of(cmd.stdout),
                stdio_of(cmd.stderr))!)!;
    Try/pure(
        Child/of_handle(
            spawned.child,
            Option/map(spawned.stdin, Pipe/of_handle),
            Option/map(spawned.stdout, Pipe/of_handle),
            Option/map(spawned.stderr, Pipe/of_handle)));

let drain(p: Option(Pipe)) -> Async(Result(Io/Error, Bytes)) =
    match p | some(p) => Async/read_all(p) | none() => Async/pure(Result/success(x[])) end;

let capture(child: Child) -> Try(Async, Io/Error, {exit: Exit, stdout: Bytes, stderr: Bytes}) =
    let out = Async/spawn(drain(Child/stdout(child)))!;
    let err = Async/spawn(drain(Child/stderr(child)))!;
    let o = Async/join(out)!;
    let e = Async/join(err)!;
    let stdout = o!;
    let stderr = e!;
    let exit = Child/wait(child)!;
    Try/pure((exit = exit, stdout = stdout, stderr = stderr));

--- `cmd` run to its end with both outputs captured, and how it ended.
pub let run(cmd: Command) -> Try(Async, Io/Error, {exit: Exit, stdout: Bytes, stderr: Bytes}) =
    let child = spawn(Command { ..cmd, stdout = Stdio/piped(), stderr = Stdio/piped() })!;
    Child/with(child, capture(child));

--- `cmd` run with its streams as wired, and how it ended.
pub let status(cmd: Command) -> Try(Async, Io/Error, Exit) =
    let child = spawn(cmd)!;
    Child/with(child, Child/wait(child));
