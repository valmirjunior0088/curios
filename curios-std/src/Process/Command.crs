use /std/{Str, List, Option, Path};
use /std/Process/{Stdio};

--- A program to run, and how to run it.
pub struct Command: pub Type {
    program: Str,
    args: List(Str),
    --- The working directory, or the parent's.
    cwd: Option(Path),
    --- Entries laid over the inherited environment.
    env: List({Str, Str}),
    stdin: Stdio,
    stdout: Stdio,
    stderr: Stdio,
}

--- `program` with `args`, inheriting the working directory, the environment and every stream.
pub let new(program: Str, args: List(Str)) -> Command =
    Command {
        program = program,
        args = args,
        cwd = Option/none(),
        env = [],
        stdin = Stdio/inherit(),
        stdout = Stdio/inherit(),
        stderr = Stdio/inherit() };
