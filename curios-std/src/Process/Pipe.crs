use /std/{Io, Process};
use /std/internal/{Handle};

--- Close this end.
pub let close(p: Process/Pipe) -> Io({}) =
    Handle/close(p.0);

satisfy Io/Read(Process/Pipe) {
    read(p, n, @positive) = Io/read(@Handle, p.0, n, @positive),
}

satisfy Io/Write(Process/Pipe) {
    write(p, b) = Io/write(p.0, b),
    flush(p) = Io/flush(p.0),
}
