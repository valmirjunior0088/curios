pub use /sys/{Int};
pub use /sys/Int/{eql, neq, add, sub, div, rem, gt, ge, and, or, xor, shr, to_nat, to_flt};
use /std/{Nat, Bool, Str, Option, Show, Spell, Ord, Eq};
use /std/Bool/{True, Holds};
use /std/ops/{Eql, Cmp, Add, Sub, Mul, Div, Rem};

--- The laws of `a < b`, and its crossings with `a <= b`.
---
--- Each law names the difference a hypothesis makes non-negative as a natural, with `to_nat`, and concludes from `Nat`'s own floor read through the widening — the order on `Int` is `Nat`'s, carried along the embedding.
pub mod lt;
pub use lt/{let lt};

--- The laws of `a <= b`.
pub mod le;
pub use le/{let le};

--- The smaller of two integers, and the laws a hypothesis decides it by.
---
--- Conversion decides `min` from its operands as terms and reads no hypothesis, as `Nat`'s does, so under a guard on `a <= b` these laws are the step.
pub mod min;
pub use min/{let min};

--- The larger of two integers, and the laws a hypothesis decides it by.
pub mod max;
pub use max/{let max};

--- The magnitude of an integer, as a `Nat`, and what it widens back to under a hypothesis on the integer's sign.
---
--- Conversion decides `abs` from its operand as a term: a negation and a literal factor leave it, and a non-negative combination of widened naturals is its own preimage. It reads no hypothesis, so under a guard on `+0 <= a` these laws are the step.
pub mod abs;
pub use abs/{let abs};

--- `-1`, `+0` or `+1` by the sign of an integer, and the laws a hypothesis decides it by.
pub mod sign;
pub use sign/{let sign};

--- A product, and the cancellation of a nonzero factor.
---
--- Conversion decides a product as a polynomial of its factors and cancels none: without the premise that a factor is not zero, `a * k = b * k` says nothing of `a` and `b`.
pub mod mul;
pub use mul/{let mul};

--- A left shift, the split of its count, and the one odd mantissa a value has at one count.
pub mod shl;
pub use shl/{let shl};

--- The order of two integers as an `Ordering`, and the laws that tie each answer to the comparison it stands for.
pub mod ord;
pub use ord/{let ord};

--- That `a` is not zero, decided — what `/` and `%` on `Int` ask of a divisor.
pub let NonZero(a: Int) -> Prop =
    Holds(a != +0);

--- That `a` is zero or above, decided.
pub let NonNeg(a: Int) -> Prop =
    Holds(a >= +0);

--- An integer is a natural widened, or one below the negation of one: the two canonical forms, as the family's indices.
---
--- Matching on [`view`] refines `i` to its form in each arm, which is how a proof takes an integer apart — `Int` has no constructors of its own, and this is the case split it would have. Nothing here is primitive: the view is built from `Int/to_nat`, and the order laws in `lt` and `le` go through it and through `Nat`.
pub induct Sign: (Int) -> pub Type
--- `i` is the natural `n`, widened.
| nonneg(n: Nat): (Nat/to_int(n))
--- `i` is `-1 - n` for the natural `n`.
| neg(n: Nat): (-1 - Nat/to_int(n))
end

--- `i`'s form: the natural it is, or the natural one below its negation is.
pub let view(i: Int) -> Sign(i) =
    match i >= +0: (s) => (Eq()(i >= +0, s)) -> Sign(i)
    | true =>
        (c) =>
            let ok: NonNeg(i) = Bool/holds_of_eq(i >= +0, c);
            Sign/nonneg(to_nat(i, @ok))
    | false =>
        (c) =>
            let ok: NonNeg(-1 - i) = Bool/holds_of_eq(i < +0, Eq/cong(Bool/not, c));
            Sign/neg(to_nat(-1 - i, @ok))
    end(Eq/refl());

let absurd_succ(@P: Sort, x: Nat, h: Holds(+0 == Nat/to_int(x) + 1)) -> P =
    match h: (_) => P end;

--- Where `a` stands against `b`, with the evidence.
pub induct Trichotomy(a: Int, b: Int): pub Type
--- `a` is below `b`.
| lt(p: Holds(a < b))
--- They are one number.
| eq(e: Eq()(a, b))
--- `a` is above `b`.
| gt(p: Holds(b < a))
end

--- `a` against `b`: below, equal, or above, one of them with its proof.
pub let trichotomy(a: Int, b: Int) -> Trichotomy(a, b) =
    match a < b: (r) => (Eq()(a < b, r)) -> Trichotomy(a, b)
    | true => (c) => Trichotomy/lt(Bool/holds_of_eq(a < b, c))
    | false =>
        (c) =>
            let ge: Holds(b <= a) = Bool/holds_of_eq(Bool/not(a < b), Eq/cong(Bool/not, c));
            match b < a: (s) => (Eq()(b < a, s)) -> Trichotomy(a, b)
            | true => (d) => Trichotomy/gt(Bool/holds_of_eq(b < a, d))
            | false =>
                (d) =>
                    let le: Holds(a <= b) = Bool/holds_of_eq(Bool/not(b < a), Eq/cong(Bool/not, d));
                    Trichotomy/eq(le/antisym(a, b, le, ge))
            end(Eq/refl())
    end(Eq/refl());

--- A decided equality is an equation: `a == b` gives `Eq()(a, b)`.
pub let eq_of_eql(a: Int, b: Int, h: Holds(a == b)) -> Eq()(a, b) =
    match trichotomy(a, b)
    | lt(p) => absurd_succ(to_nat(b - a - 1, @p), h)
    | eq(e) => e
    | gt(p) => absurd_succ(to_nat(a - b - 1, @p), h)
    end;

--- The value with its sign written, `+3` or `-3`, so the text re-parses as an `Int` without context.
pub let to_str(n: Int) -> Str =
    let mag = Nat/to_str(abs(n));
    match n >= +0 | true => Str/concat("+", mag) | false => Str/concat("-", mag) end;

--- The bitwise complement.
pub let not(x: Int) -> Int =
    xor(x, -1);

--- The number an optional sign and a nonempty run of decimal digits spell, or `none` for any other text.
pub let of_str(s: Str) -> Option(Int) =
    let (negative, digits): {Bool, Str} =
        match Str/strip_prefix(s, "-")
        | some(rest) => (true, rest)
        | none() =>
            match Str/strip_prefix(s, "+") | some(rest) => (false, rest) | none() => (false, s) end
        end;
    let n = Nat/of_str(digits)!;
    match negative
    | true => Option/some(+0 - Nat/to_int(n))
    | false => Option/some(Nat/to_int(n))
    end;

--- The procedure that decides `0 <= n`: the evidence when it holds, `none` otherwise.
pub let non_neg(n: Int) -> Option(NonNeg(n)) =
    match n >= +0: (r) => Option(Holds(r))
    | true => Option/some(True/qed())
    | false => Option/none()
    end;

satisfy Eql(Int) {
    eql = eql,
    neq = neq,
}

satisfy Cmp(Int) {
    lt = lt,
    le = le,
    gt = gt,
    ge = ge,
}

satisfy Add(Int) {
    add = add,
}

satisfy Sub(Int) {
    sub = sub,
}

satisfy Mul(Int) {
    mul = mul,
}

--- The divisor must be nonzero.
satisfy Div(Int) {
    Ok(b) = NonZero(b),
    div = div,
}

--- The divisor must be nonzero.
satisfy Rem(Int) {
    Ok(b) = NonZero(b),
    rem = rem,
}

satisfy Show(Int) {
    show = to_str,
}

satisfy Spell(Int) {
    spell = to_str,
}

satisfy Ord(Int) {
    ord = ord,
}
