use /std/{Nat, Bool, List, Option, Path, Try, Io, Show};
use /std/ops/{Eql};
use /std/time/{Timestamp};

--- What is at a path.
pub induct Kind: pub Type
--- A regular file.
| file()
--- A directory.
| directory()
--- A symbolic link.
| symlink()
--- Anything else the host holds at a path.
| other()
end

satisfy Eql(Kind) {
    ..
}

satisfy Show(Kind) {
    show(k) =
        match k
        | file() => "file"
        | directory() => "directory"
        | symlink() => "symlink"
        | other() => "other"
        end,
}

--- What is at this path: `ok` beside its kind, one of `/sys/file_kind`'s codes, its size in bytes and when its contents last changed, or the status of the failure.
foreign file_stat: (Bytes) -> {
    status: Nat,
    kind: Nat,
    size: Nat,
    mtime_secs: Nat,
    mtime_nanos: Nat};

--- Remove the file at this path: `ok`, or the status of the failure.
foreign file_remove: (Bytes) -> Nat;

--- Rename what is at the first path to the second: `ok`, or the status of the failure.
foreign file_rename: (Bytes, Bytes) -> Nat;

--- The names in the directory at this path: `ok` beside them, or the status of the failure.
foreign dir_list: (Bytes) -> {status: Nat, names: List(Bytes)};

--- Create the directory at this path: `ok`, or the status of the failure.
foreign dir_create: (Bytes) -> Nat;

--- Remove the directory at this path: `ok`, or the status of the failure.
foreign dir_remove: (Bytes) -> Nat;

--- The process's working directory: `ok` beside its path, or the status of the failure.
foreign proc_cwd: {status: Nat, path: Bytes};

--- The kind a code of `file_stat`'s names, where it names one.
let kind_of(code: Nat) -> Option(Kind) =
    choose
    | code == /sys/file_kind/file => Option/some(Kind/file())
    | code == /sys/file_kind/directory => Option/some(Kind/directory())
    | code == /sys/file_kind/symlink => Option/some(Kind/symlink())
    | code == /sys/file_kind/other => Option/some(Kind/other())
    | _ => Option/none()
    end;

--- What `stat` reports.
pub struct Metadata: pub Type {
    kind: Kind,
    --- The size in bytes.
    size: Nat,
    --- When the contents last changed.
    mtime: Timestamp,
}

--- The outcome a row's bare status names.
let outcome(status: Nat) -> Try(Io, Io/Error, {}) =
    match status == /sys/status/ok
    | true => Try/pure(())
    | false => Try/raise(Io/Error/of(status))
    end;

--- What is at `path`. A kind the host names by no code this library knows is a failure no errno names.
pub let stat(path: Path) -> Try(Io, Io/Error, Metadata) =
    let reply = file_stat(Path/to_bytes(path))!;
    match reply.status == /sys/status/ok
    | true =>
        match kind_of(reply.kind)
        | some(kind) =>
            Try/pure(
                Metadata {
                    kind = kind,
                    size = reply.size,
                    mtime = Timestamp/of_unix(reply.mtime_secs, reply.mtime_nanos) })
        | none() => Try/raise(Io/Error/other(0))
        end
    | false => Try/raise(Io/Error/of(reply.status))
    end;

let kind_is(path: Path, want: (Kind) -> Bool) -> Try(Io, Io/Error, Bool) =
    let r = Try/run(stat(path))!;
    match r
    | success(m) => Try/pure(want(m.kind))
    | failure(e) => match e | not_found() => Try/pure(false) | _ => Try/raise(e) end
    end;

--- Whether anything is at `path`.
pub let exists(path: Path) -> Try(Io, Io/Error, Bool) =
    kind_is(path, (_) => true);

--- Whether a regular file is at `path`.
pub let is_file(path: Path) -> Try(Io, Io/Error, Bool) =
    kind_is(path, (k) => k == Kind/file());

--- Whether a directory is at `path`.
pub let is_dir(path: Path) -> Try(Io, Io/Error, Bool) =
    kind_is(path, (k) => k == Kind/directory());

--- The entries' names, each a `Path` that `Path/join` puts back under `path`.
pub let list(path: Path) -> Try(Io, Io/Error, List(Path)) =
    let reply = dir_list(Path/to_bytes(path))!;
    match reply.status == /sys/status/ok
    | true => Try/pure(List/map(reply.names, Path/of_bytes))
    | false => Try/raise(Io/Error/of(reply.status))
    end;

--- A directory at `path`, whose parent must exist.
pub let create_dir(path: Path) -> Try(Io, Io/Error, {}) =
    let status = dir_create(Path/to_bytes(path))!;
    outcome(status);

--- Remove the empty directory at `path`.
pub let remove_dir(path: Path) -> Try(Io, Io/Error, {}) =
    let status = dir_remove(Path/to_bytes(path))!;
    outcome(status);

--- Remove the file at `path`.
pub let remove_file(path: Path) -> Try(Io, Io/Error, {}) =
    let status = file_remove(Path/to_bytes(path))!;
    outcome(status);

--- Move what is at `from` to `to`.
pub let rename(from: Path, to: Path) -> Try(Io, Io/Error, {}) =
    let status = file_rename(Path/to_bytes(from), Path/to_bytes(to))!;
    outcome(status);

--- The working directory.
pub let cwd: Try(Io, Io/Error, Path) =
    let reply = proc_cwd!;
    match reply.status == /sys/status/ok
    | true => Try/pure(Path/of_bytes(reply.path))
    | false => Try/raise(Io/Error/of(reply.status))
    end;

--- A directory at `path` and every missing parent; one that already exists is left as it is.
pub let create_dir_all(path: Path) -> Try(Io, Io/Error, {}) =
    let r = Try/run(create_dir(path))!;
    match r
    | success(_) => Try/pure(())
    | failure(e) =>
        match e
        | exists() => Try/pure(())
        | not_found() =>
            match Path/parent(path)
            | some(parent) =>
                let _ = create_dir_all(parent)!;
                create_dir(path)
            | none() => Try/raise(e)
            end
        | _ => Try/raise(e)
        end
    end;

--- Remove what is at `path`, a directory's entries first.
pub let remove_all(path: Path) -> Try(Io, Io/Error, {}) =
    let m = stat(path)!;
    match m.kind
    | directory() =>
        let entries = list(path)!;
        let _ = remove_each(path, entries)!;
        remove_dir(path)
    | _ => remove_file(path)
    end
and remove_each(dir: Path, entries: List(Path)) -> Try(Io, Io/Error, {}) =
    match entries
    | [] => Try/pure(())
    | [entry, ..rest] =>
        let _ = remove_all(Path/join(dir, entry))!;
        remove_each(dir, rest)
    end;
