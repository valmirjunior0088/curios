pub use /sys/{List};
pub use /sys/List/{get, len, slice, map, fold};
use /std/{Nat, Bool, Option, Str, Show, Spell, Monad, Ordering, Ord};
use /std/Bool/{True, Holds};
use /std/ops/{Eql, Cmp};

--- That a value is an element of a list, as a proposition, with its laws.
pub mod Member;
pub use Member/{let Member};

--- That one list is another rearranged, with its laws.
pub mod Permutation;
pub use Permutation/{let Permutation};

--- Whether each element of a list stands in a relation to the one after it, with what builds that at a cons and what a cons gives back.
pub mod ordered;
pub use ordered/{let ordered};

--- That each element of a list stands in a relation to every one after it.
pub mod Pairwise;
pub use Pairwise/{let Pairwise};

--- A stable sort by a comparator, with its theorem: the answer is the input rearranged, and in order under the comparator's flip.
pub mod sort_by;
pub use sort_by/{let sort_by};

--- A stable sort by a type's own order, and `sort_by`'s theorem read at it.
pub mod sort;
pub use sort/{let sort};

--- The element at `i`, or `none` past the end.
pub let try_get(@T: Type, a: List(T), i: Nat) -> Option(T) =
    match i < len(a) | true => Option/some(get(a, i)) | false => Option/none() end;

--- Everything from `k` on, under the evidence that `k` is within the length.
pub let drop(@T: Type, a: List(T), k: Nat, @ok: Holds(k <= len(a))) -> List(T) =
    slice(@T, a, k, len(a) - k);

--- The concatenation, in order.
pub let flatten(@T: Type, parts: List(List(T))) -> List(T) =
    fold(parts, [], (a, acc) => [..acc, ..a]);

--- The first element `pred` accepts, or `none`.
pub let find(@T: Type, l: List(T), pred: (T) -> Bool) -> Option(T) =
    match l
    | [] => Option/none()
    | [h, ..t] => match pred(h) | true => Option/some(h) | false => find(t, pred) end
    end;

--- The index of the first element `pred` accepts, or `none`.
pub let find_index(@T: Type, l: List(T), pred: (T) -> Bool) -> Option(Nat) =
    let go(i: Nat, rest: List(T)) -> Option(Nat) =
        match rest
        | [] => Option/none()
        | [h, ..t] => match pred(h) | true => Option/some(i) | false => go(i + 1, t) end
        end;
    go(0, l);

--- Whether `pred` accepts some element.
pub let any(@T: Type, l: List(T), pred: (T) -> Bool) -> Bool =
    match l
    | [] => false
    | [h, ..t] => match pred(h) | true => true | false => any(t, pred) end
    end;

--- Whether `pred` accepts every element.
pub let all(@T: Type, l: List(T), pred: (T) -> Bool) -> Bool =
    match l
    | [] => true
    | [h, ..t] => match pred(h) | true => all(t, pred) | false => false end
    end;

--- Whether `x` is an element.
pub let contains(@T: Type, use Eql(T), l: List(T), x: T) -> Bool =
    any(l, (y) => y == x);

--- The index of the first `x`, or `none`.
pub let index_of(@T: Type, use Eql(T), l: List(T), x: T) -> Option(Nat) =
    find_index(l, (y) => y == x);

--- The last element, or `none` of an empty list.
pub let last(@T: Type, l: List(T)) -> Option(T) =
    match l
    | [] => Option/none()
    | [h, ..t] => match t | [] => Option/some(h) | _ => last(t) end
    end;

--- The longest prefix `pred` accepts.
pub let take_while(@T: Type, l: List(T), pred: (T) -> Bool) -> List(T) =
    match l
    | [] => []
    | [h, ..t] => match pred(h) | true => [h, ..take_while(t, pred)] | false => [] end
    end;

--- Everything after the longest prefix `pred` accepts.
pub let drop_while(@T: Type, l: List(T), pred: (T) -> Bool) -> List(T) =
    match l
    | [] => []
    | [h, ..t] => match pred(h) | true => drop_while(t, pred) | false => l end
    end;

--- The first `n` elements, or all of them when there are fewer.
pub let take(@T: Type, l: List(T), n: Nat) -> List(T) =
    match n
    | 0 => []
    | k + 1 => match l | [] => [] | [h, ..t] => [h, ..take(t, k)] end
    end;

--- Pairs, position by position, as long as the shorter list.
pub let zip(@A: Type, @B: Type, a: List(A), b: List(B)) -> List({A, B}) =
    match a
    | [] => []
    | [x, ..xs] => match b | [] => [] | [y, ..ys] => [(x, y), ..zip(xs, ys)] end
    end;

--- The elements in reverse order.
pub let reverse(@T: Type, l: List(T)) -> List(T) =
    fold(l, [], (x, acc) => [x, ..acc]);

--- The elements `pred` accepts.
pub let filter(@T: Type, l: List(T), pred: (T) -> Bool) -> List(T) =
    fold(l, [], (x, acc) => match pred(x) | true => [..acc, x] | false => acc end);

--- `f` on every element, keeping the values it answers.
pub let filter_map(@T: Type, @B: Type, l: List(T), f: (T) -> Option(B)) -> List(B) =
    fold(l, [], (x, acc) => match f(x) | some(y) => [..acc, y] | none() => acc end);

--- The elements `pred` accepts, and the rest.
pub let partition(@T: Type, l: List(T), pred: (T) -> Bool) -> {List(T), List(T)} =
    let empty: {List(T), List(T)} = ([], []);
    fold(l, empty, (x, (yes, no)) =>
        match pred(x) | true => ([..yes, x], no) | false => (yes, [..no, x]) end);

--- The firsts and the seconds.
pub let unzip(@A: Type, @B: Type, l: List({A, B})) -> {List(A), List(B)} =
    let empty: {List(A), List(B)} = ([], []);
    fold(l, empty, ((x, y), (xs, ys)) => ([..xs, x], [..ys, y]));

--- `lo` up to and excluding `hi`; empty when `hi` is not above `lo`.
pub let range(lo: Nat, hi: Nat) -> List(Nat) =
    let go(k: Nat, i: Nat) -> List(Nat) = match k | 0 => [] | kp + 1 => [i, ..go(kp, i + 1)] end;
    go(hi - lo, lo);

--- `n` copies of `x`.
pub let replicate(@T: Type, n: Nat, x: T) -> List(T) =
    match n | 0 => [] | _ + 1; acc => [x, ..acc] end;

--- `f` on every element, the results concatenated.
pub let concat_map(@T: Type, @B: Type, l: List(T), f: (T) -> List(B)) -> List(B) =
    fold(l, [], (x, acc) => [..acc, ..f(x)]);

--- `sep` between each pair of elements.
pub let intersperse(@T: Type, l: List(T), sep: T) -> List(T) =
    match l | [] => [] | [h, ..t] => [h, ..fold(t, [], (x, acc) => [..acc, sep, x])] end;

--- `f` on every element in order under the monad, the results collected.
pub let traverse(
    @M: (Type) -> Type,
    @T: Type,
    @B: Type,
    use Monad(M),
    l: List(T),
    f: (T) -> M(B),
) -> M(List(B)) =
    match l
    | [] => Monad/pure([])
    | [h, ..t] =>
        let b = f(h)!;
        let bs = traverse(t, f)!;
        Monad/pure([b, ..bs])
    end;

--- `f` on every element in order under the monad, for its effect.
pub let each(@M: (Type) -> Type, @T: Type, use Monad(M), l: List(T), f: (T) -> M({})) -> M({}) =
    match l
    | [] => Monad/pure(())
    | [h, ..t] =>
        let _ = f(h)!;
        each(t, f)
    end;

--- `n` singles combined as a balanced tree, so `combine` nests to a depth logarithmic in `n` rather than `n`. Each single is asked for with the proof that its index is below `n`, so a caller indexing `n` elements reads them without a default.
---
--- A span of two or more is its two halves, each half its length rounded down, around the single between them where the halves leave one over. So every call is on a quotient by two, a descent the termination check reads, which is what lets the function stand in a type with no count beside it. A span stays within `n`, since its halves and the single between them lie inside it.
pub let balanced(
    @A: Type,
    n: Nat,
    empty: A,
    single: (i: Nat, Holds(i < n)) -> A,
    combine: (A, A) -> A,
) -> A =
    let go(lo: Nat, count: Nat, @bounded: Holds(lo + count <= n)) -> A =
        choose
        | 1 < count =>
            let half = count / 2;
            match half + half < count
            | false => combine(go(lo, half), go(lo + half, half))
            | true =>
                combine(
                    go(lo, half),
                    combine(single(lo + half, True/proved()), go(lo + half + 1, half)))
            end
        | 0 < count => single(lo, True/proved())
        | _ => empty
        end;
    go(0, n);

--- Whether the two hold equal elements in the same order.
pub let eql(@A: Type, use Eql(A), a: List(A), b: List(A)) -> Bool =
    match a
    | [] => match b | [] => true | _ => false end
    | [x, ..xs] => match b | [] => false | [y, ..ys] => x == y && eql(xs, ys) end
    end;

satisfy (@A: Type, use Eql(A)) => Eql(List(A)) {
    eql = eql,
    neq(a, b) = Bool/not(eql(a, b)),
}

satisfy (@A: Type, use Show(A)) => Show(List(A)) {
    show(l) = Str/concat("[", Str/concat(Str/join(", ", map(l, (x) => Show/show(x))), "]")),
}

satisfy (@A: Type, use Spell(A)) => Spell(List(A)) {
    spell(l) = Str/concat("[", Str/concat(Str/join(", ", map(l, (x) => Spell/spell(x))), "]")),
}

satisfy Monad(List) {
    pure(x) = [x],
    bind(m, f) = fold(m, [], (x, acc) => [..acc, ..f(x)]),
}

--- Lexicographic, a proper prefix first.
pub let ord(@T: Type, use Ord(T), a: List(T), b: List(T)) -> Ordering =
    match a
    | [] => match b | [] => Ordering/eq() | _ => Ordering/lt() end
    | [x, ..xs] =>
        match b
        | [] => Ordering/gt()
        | [y, ..ys] =>
            match Ord/ord(x, y)
            | eq() => ord(xs, ys)
            | lt() => Ordering/lt()
            | gt() => Ordering/gt()
            end
        end
    end;

satisfy (@T: Type, use Ord(T)) => Cmp(List(T)) {
    lt(a, b) = Ordering/is_lt(ord(a, b)),
    le(a, b) = Ordering/is_le(ord(a, b)),
    gt(a, b) = Ordering/is_gt(ord(a, b)),
    ge(a, b) = Ordering/is_ge(ord(a, b)),
}

satisfy (@T: Type, use Ord(T)) => Ord(List(T)) {
    ord = ord,
}
