use /std/{Nat, Str, List, Show};
use /std/Bool/{True, Holds};

--- Why a host operation failed: a named status, or `other` with the errno it carries.
pub induct Error: pub Type
--- Nothing is there.
| not_found()
--- The host refused the access.
| permission_denied()
--- Something is there already.
| already_exists()
--- The peer refused the connection.
| connection_refused()
--- The secure channel failed.
| tls()
--- The directory still holds entries.
| not_empty()
--- A directory was given where a file was wanted.
| is_directory()
--- A file was given where a directory was wanted.
| not_directory()
--- The peer reset the connection.
| connection_reset()
--- The reader has gone: a write to a pipe or socket nobody reads.
| broken_pipe()
--- What was read is past the bound its reader states.
| too_long()
--- What was read is not text: the length of its longest prefix that is.
| not_text(Nat)
--- Anything else, carrying the host's own code.
| other(Nat)
end

pub use Error/*;

let errors: List({Nat, Error}) =
    [
        (/sys/status/not_found, Error/not_found()),
        (/sys/status/permission_denied, Error/permission_denied()),
        (/sys/status/exists, Error/already_exists()),
        (/sys/status/refused, Error/connection_refused()),
        (/sys/status/tls, Error/tls()),
        (/sys/status/not_empty, Error/not_empty()),
        (/sys/status/is_directory, Error/is_directory()),
        (/sys/status/not_directory, Error/not_directory()),
        (/sys/status/reset, Error/connection_reset()),
        (/sys/status/broken_pipe, Error/broken_pipe())];

satisfy Show(Error) {
    show(e) =
        match e
        | not_found() => "not_found"
        | permission_denied() => "permission_denied"
        | already_exists() => "already_exists"
        | connection_refused() => "connection_refused"
        | tls() => "tls"
        | not_empty() => "not_empty"
        | is_directory() => "is_directory"
        | not_directory() => "not_directory"
        | connection_reset() => "connection_reset"
        | broken_pipe() => "broken_pipe"
        | too_long() => "too_long"
        | not_text(valid) => Str/flatten(["not_text(", Nat/to_str(valid), ")"])
        | other(n) => Str/flatten(["other(", Nat/to_str(n), ")"])
        end,
}

--- The failure `status` names: one of the named statuses, or `other` with the errno the host passed through.
pub let of(status: Nat) -> Error =
    List/fold(
        errors,
        Error/other(status - /sys/status/other_base),
        (entry, acc) => match status == entry.0 | true => entry.1 | false => acc end);

-- Every failure the wire names is a case here, but `would_block`, which every reading retries on and so never reaches a program: a status the wire's list gains is refused until `errors` names it.
let _every_failure_the_wire_names_is_a_case: Holds(
    List/all(/sys/status/failures, (status: Nat) =>
        status == /sys/status/would_block
            || match of(status) | other(_) => false | _ => true end)) =
    True/qed();
