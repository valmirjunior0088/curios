use /std/{Nat, List, Channel, Io};
use /std/Io/{Ended, Future, Signal, Branch, drive, into, answered, using};

-- How many children of a scope have not ended, kept in a capacity-one channel, and the signal raised as each ends: what `join_all` waits on, a count rather than the tasks, so a scope that spawns without end holds nothing of the children that have ended.
struct Live: Type {
    count: {Channel/Sender(Nat), Channel/Receiver(Nat)},
    ended: Signal,
}

-- `change` applied to the count of `live`.
let counted(live: Live, change: (Nat) -> Nat) -> Io({}) =
    let held = Channel/try_receive(live.count.1)!;
    let n = match held | item(n) => n | _ => 0 end;
    let _ = Channel/try_send(live.count.0, change(n))!;
    Io/pure(());

-- One child of `live` ended.
let ended(live: Live) -> Io({}) =
    let _ = counted(live, (n) => match n | 0 => 0 | m + 1 => m end)!;
    Signal/notify(live.ended);

--- What a scope's body spawns its children into and defers its releases to.
pub struct Scope: Type {
    children: Channel/Sender(Io({})),
    live: Live,
    releases: {Channel/Sender(List((Ended) -> Io({}))), Channel/Receiver(List((Ended) -> Io({})))},
}

-- `Task` is declared here and not in its module, so that `spawn` builds it and nothing outside this subtree does.
--- A child a scope runs: its answer once it has one.
pub struct Task(A: Type): Type {
    Future(A),
}

--- Waiting for a task's answer.
pub mod Task;

--- `child` run beside the body of the scope `s`, answering at once with the task `Task/join` waits on. A child still running when the body of its scope answers is cancelled where it waits, and one spawned once the scope has answered never runs.
pub let spawn(@A: Type, s: Scope, child: Io(A)) -> Io(Task(A)) =
    let f = Future/new()!;
    let _ = counted(s.live, (n) => n + 1)!;
    let finished = Io/bind(child, (a) => Io/bind(Future/fill(f, a), (_) => ended(s.live)));
    let _ = Channel/send(s.children, finished)!;
    Io/pure(Task { f });

--- Until every child spawned into `s` has ended, those spawned meanwhile among them: what a body that needs all of its children finished asks before it answers.
pub let join_all(s: Scope) -> Io({}) =
    let held = Channel/try_receive(s.live.count.1)!;
    let n = match held | item(n) => n | _ => 0 end;
    let _ = Channel/try_send(s.live.count.0, n)!;
    match n
    | 0 => Io/pure(())
    | _ =>
        let _ = Signal/wait(s.live.ended)!;
        join_all(s)
    end;

--- `release` run when `s` ends, told how it ended: after its children are cancelled, and before every release deferred to it earlier. What a scope's resources are closed by, so nothing opened into a scope outlives it.
pub let defer(s: Scope, release: (Ended) -> Io({})) -> Io({}) =
    let held = Channel/try_receive(s.releases.1)!;
    let earlier = match held | item(rs) => rs | _ => [] end;
    let _ = Channel/try_send(s.releases.0, [release, ..earlier])!;
    Io/pure(());

-- Each of `releases` told `how`, in its order.
let each(releases: List((Ended) -> Io({})), how: Ended) -> Io({}) =
    match releases | [] => Io/pure(()) | [r, ..more] => Io/bind(r(how), (_) => each(more, how)) end;

-- Every release deferred to `s`, the latest first, told `how` it ended.
let released(s: Scope, how: Ended) -> Io({}) =
    let held = Channel/try_receive(s.releases.1)!;
    match held | item(rs) => each(rs, how) | _ => Io/pure(()) end;

-- Every child spawned into `r` since the last time it was asked.
let spawned(r: Channel/Receiver(Io({}))) -> Io(List(Branch)) =
    let taken = Channel/try_receive(r)!;
    match taken
    | item(child) => Io/bind(spawned(r), (more) => Io/pure([Branch/fresh(child), ..more]))
    | _ => Io/pure([])
    end;

--- `body` run with a scope it spawns children into and opens resources into, and its answer once it has one. The children run beside the body, and those still running when the body answers are cancelled where they wait: a description's answer is all it yields, so a child the body needs is joined before it answers. Then every release deferred to the scope runs, the latest first, told whether the scope `finished` or was `cancelled` where it waited — however it ends, its children are cancelled before its resources are released.
pub let run(@A: Type, body: (Scope) -> Io(A)) -> Io(A) =
    let ends = Channel/new(@Io({}), 64)!;
    let count = Channel/new(@Nat, 1)!;
    let ended = Signal/new()!;
    let releases = Channel/new(@List((Ended) -> Io({})), 1)!;
    let s =
        Scope {
            children = ends.0,
            live = Live { count = count, ended = ended },
            releases = releases };
    let answer: Future(A) = Future/new()!;
    let driven() -> Io(A) =
        let _ = drive([into(body(s), answer)], spawned(ends.1), answered(answer))!;
        let _ = Channel/finish(ends.0)!;
        Future/wait(answer);
    using((how) => released(s, how), driven());
