--- Why a document did not decode.
pub mod Error;
pub use Error/{let Error};

mod build;

mod scan;

mod strings;

mod keys;

mod numbers;

mod date_time;

mod values;

mod decode;
pub use decode/{let decode};

mod encode;
pub use encode/{let encode};

use /std/{Int, Flt, Bool, Str, List, Map};
use /std/time/{Date, Time, DateTime, OffsetDateTime};
use /std/time/rfc3339/{FourDigits, WholeMinutes};

--- A TOML value.
pub induct Toml: pub Type
--- A string.
| str(Str)
--- An integer.
| int(Int)
--- A float.
| flt(Flt)
--- `true` or `false`.
| bool(Bool)
--- A date and time with an offset from UTC. Its year has the four digits and its offset the whole minutes RFC 3339 writes, the only ones TOML reads, so that a value encodes to a document that decodes.
| offset_date_time(
    value: OffsetDateTime,
    @four_digits: FourDigits(value.date_time.date),
    @whole_minutes: WholeMinutes(value.offset))
--- A date and time with no offset.
| local_date_time(value: DateTime, @four_digits: FourDigits(value.date))
--- A date alone.
| local_date(value: Date, @four_digits: FourDigits(value))
--- A time of day alone.
| local_time(Time)
--- An array, in order.
| arr(List(Toml))
--- A table, by key.
| table(Map(Str, Toml))
end

pub use Toml/*;
