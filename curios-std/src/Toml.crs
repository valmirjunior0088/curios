use /std/{Int, Flt, Bool, Str, List, Map};
use /std/Bool/{Holds};
use /std/time/{Date, Time, OffsetDateTime};

--- That a date's year has the four digits RFC 3339 writes, the only years TOML reads: what every date a value holds carries, so that a value encodes to a document that decodes.
pub let FourDigits(d: Date) -> Prop =
    Holds(d.year <= 9999);

--- A date and time with no offset.
pub struct LocalDateTime: pub Type {
    date: Date,
    time: Time,
}

--- A TOML value.
pub induct Toml: pub Type
--- A string.
| str(Str)
--- An integer.
| int(Int)
--- A float.
| flt(Flt)
--- `true` or `false`.
| bool(Bool)
--- A date and time with an offset from UTC.
| offset_date_time(value: OffsetDateTime, @four_digits: FourDigits(value.date))
--- A date and time with no offset.
| local_date_time(value: LocalDateTime, @four_digits: FourDigits(value.date))
--- A date alone.
| local_date(value: Date, @four_digits: FourDigits(value))
--- A time of day alone.
| local_time(Time)
--- An array, in order.
| arr(List(Toml))
--- A table, by key.
| table(Map(Str, Toml))
end

pub use Toml/*;

--- Why a document did not decode.
pub mod Error;
pub use Error/{let Error};

mod build;

mod scan;

mod strings;

mod keys;

mod numbers;

mod date_time;

mod values;

mod decode;
pub use decode/{let decode};

mod encode;
pub use encode/{let encode};
