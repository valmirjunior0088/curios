use /std/{Byte, Bytes, List, Str, Option, Io};

--- The process's arguments.
foreign proc_args() -> List(Bytes);

--- The arguments this process was started with, each as the bytes it arrived as.
pub let args() -> Io(List(Bytes)) =
    proc_args();

--- The environment variable of this name: `ok` beside its value, or another status where it has none.
foreign proc_env(Bytes) -> {status: Nat, value: Bytes};

--- End the instance with this code. The call does not return.
foreign proc_exit(Byte) -> Never;

--- The environment variable `name`, or `none` when it is unset.
pub let env(name: Str) -> Io(Option(Bytes)) =
    let reply = proc_env(Str/to_bytes(name))!;
    Io/pure(
        match reply.status == /sys/status/ok
        | true => Option/some(reply.value)
        | false => Option/none()
        end);

--- End the process with `code`, a byte because that is the status every host hands its parent whole. The description yields whatever the region wanted, so an exiting arm can end a region of any type.
pub let exit(@A: Type, code: Byte) -> Io(A) =
    proc_exit(code);
