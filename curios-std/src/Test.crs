use /std/{Nat, Bool, Str, Bytes, List, Option, Result, Try, Io, Monad, Spell, Show, Fmt, Program,
    print, Process};
use /std/ops/{Eql};
use /std/time/{Duration};

--- How a terminal test came out.
pub induct Verdict: pub Type
--- It held.
| passed()
--- It did not, with what went wrong.
| failed(Str)
end

struct Failure: Type {
    message: Str,
    contexts: List(Str),
}

--- A computation that succeeds with an `A` or ends the current test with a diagnostic.
--- Its private representation keeps interpretation inside the test runner and resource combinators.
pub induct Test(A: Type): Type
| success(A)
| failed(Failure)
| action(Io(Test(A)))
end

--- Succeed with `a` without performing an effect.
pub let pure(@A: Type, a: A) -> Test(A) =
    Test/success(a);

--- End the current test with `message`, skipping its remaining continuations.
pub let fail(@A: Type, message: Str) -> Test(A) =
    Test/failed(Failure { message = message, contexts = [] });

--- Continue a successful computation; a failure skips `next`.
pub let bind(@A: Type, @B: Type, test: Test(A), next: (A) -> Test(B)) -> Test(B) =
    match test
    | success(a) => next(a)
    | failed(failure) => Test/failed(failure)
    | action(io) => Test/action(Io/bind(io, (inner) => Io/pure(bind(inner, next))))
    end;

satisfy Monad(Test) {
    pure(@_, a) = pure(a),
    bind(@_, @_, test, next) = bind(test, next),
}

satisfy Monad/Lift(Io, Test) {
    lift(@_, action) = Test/action(Io/bind(action, (a) => Io/pure(pure(a)))),
}

satisfy Monad/Lift(Test, Test) {
    lift(@_, test) = test,
}

satisfy (
    @M: (Type) -> Type,
    @E: Type,
    use Monad(M),
    use Monad/Lift(M, Test),
    use Show(E),
) => Monad/Lift((A: Type) => Try(M, E, A), Test) {
    lift(@_, action) =
        bind(
            Monad/lift(Try/run(action)),
            (result) =>
                match result | success(a) => pure(a) | failure(e) => fail(Show/show(e)) end),
}

--- The test that holds when `condition` is true.
pub let assert(condition: Bool) -> Test({}) =
    match condition | true => pure(()) | false => fail("the condition was false") end;

--- The test that holds when the two are equal, reporting both when they are not.
pub let equal(@A: Type, use Eql(A), use Spell(A), actual: A, expected: A) -> Test({}) =
    match actual == expected
    | true => pure(())
    | false => fail(Fmt/render("expected # but got #")(expected)(actual))
    end;

--- Flatten an effectful thunk returning a test. A function returning `Test(A)` can instead sequence its `Io` actions directly.
pub let perform(@A: Type, thunk: () -> Io(Test(A))) -> Test(A) =
    Test/action(thunk());

--- Flatten a fallible thunk returning a test, reporting its error when it fails.
pub let try(@E: Type, @A: Type, use Show(E), thunk: () -> Try(Io, E, Test(A))) -> Test(A) =
    bind(Monad/lift(thunk()), (inner) => inner);

let context(@A: Type, label: Str, test: Test(A)) -> Test(A) =
    match test
    | success(_) => test
    | failed(failure) => Test/failed(Failure { ..failure, contexts = [label, ..failure.contexts] })
    | action(io) => Test/action(Io/bind(io, (inner) => Io/pure(context(label, inner))))
    end;

--- Check each test in order, stopping at the first failure and naming its zero-based case index.
pub let all(tests: List(Test({}))) -> Test({}) =
    List/fold(
        tests,
        (test = pure(()), index = 0),
        (next, state: {test: Test({}), index: Nat}) =>
            (
                test =
                    bind(state.test, (_) =>
                        context(Str/concat("case ", Nat/to_str(state.index)), next)),
                index = state.index + 1)).test;

-- Keeping an outcome inside Io lets a scope release before the failure resumes propagating through Test.
let finish(@A: Type, test: Test(A)) -> Io(Result(Failure, A)) =
    match test
    | success(a) => Io/pure(Result/success(a))
    | failed(failure) => Io/pure(Result/failure(failure))
    | action(io) => Io/bind(io, (inner) => finish(inner))
    end;

let from_result(@A: Type, result: Result(Failure, A)) -> Test(A) =
    match result | success(a) => pure(a) | failure(failure) => Test/failed(failure) end;

--- `body` run with a scope, as `Io/Scope/run` runs one: its children cancelled and its releases run after a success or an assertion failure, and when a suspended body is cancelled.
pub let scope(@A: Type, body: (Io/Scope) -> Test(A)) -> Test(A) =
    let result = Io/Scope/run((s) => finish(body(s)))!;
    from_result(result);

--- Fail if the deadline wins, after cancelling the suspended body and running its releases.
pub let timeout(@A: Type, d: Duration, body: () -> Test(A)) -> Test(A) =
    let result = Io/timeout(d, finish(body()))!;
    match result | some(outcome) => from_result(outcome) | none() => fail("the test timed out") end;

let message(failure: Failure) -> Str =
    Str/join(": ", [..failure.contexts, failure.message]);

let report(name: Str, test: Test({})) -> Io(Bool) =
    let result = finish(test)!;
    match result
    | success(_) =>
        let _ = print(Str/concat(name, ": passed\n"))!;
        Io/pure(true)
    | failure(failure) =>
        let _ = Fmt/print("%: failed\n  %\n")(name)(message(failure))!;
        Io/pure(false)
    end;

satisfy Program(Test({})) {
    execute(test) =
        let held = report("program", test)!;
        match held | true => Io/pure(()) | false => Process/exit(1) end,
}

let parse_index(raw: Bytes) -> Option(Nat) =
    match Str/of_bytes(raw) | success(s) => Nat/of_str(s) | failure(_) => Option/none() end;

let run_all(tests: List({Str, () -> Test({})})) -> Io(Bool) =
    List/fold(
        tests,
        Io/pure(true),
        ((name, body), acc) =>
            let earlier = acc!;
            let here = report(name, body())!;
            Io/pure(earlier && here));

--- Run the selected test, or every named test in order, and answer whether each one held.
pub let main(tests: List({Str, () -> Test({})})) -> Io(Bool) =
    let arguments = Process/args()!;
    match List/try_get(arguments, 1)
    | some(raw) =>
        match parse_index(raw)
        | some(index) =>
            match List/try_get(tests, index)
            | some((name, body)) => report(name, body())
            | none() => Io/pure(false)
            end
        | none() => Io/pure(false)
        end
    | none() => run_all(tests)
    end;
