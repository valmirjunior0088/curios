pub use /sys/{Io};
pub use /sys/Io/{pure, bind};
use /std/{Monad, Bytes, Byte, Nat, Option, Result, Async, Handle};
use /std/Bool/{Holds};

--- The failure every host operation reports.
pub mod Error;
pub use Error/{let Error};

satisfy Monad(Io) {
    pure = pure,
    bind = bind,
}

--- The identity edge, for a witness whose premise is `Monad/Lift(Io, M)` at `M = Io`.
satisfy Monad/Lift(Io, Io) {
    lift(@_, m) = m,
}

--- One read's answer: bytes, the end of the stream, or a failure.
---
--- A chunk holds at least one byte, and says so: a read asks for a positive count, and a stream with nothing more to give has ended, which is `eof`. So a reader takes a chunk's first byte by its proof rather than by a default, and a loop over chunks advances with every one.
pub induct Chunk: pub Type
--- Bytes were read: at least one.
| chunk(bytes: Bytes, @some: Holds(0 < Bytes/len(bytes)))
--- The stream is finished.
| eof()
--- The read failed.
| error(Error)
end

--- An input stream of this process.
pub struct Input: Type {
    Handle,
}

--- An output stream of this process.
pub struct Output: Type {
    Handle,
}

--- Standard input.
pub let stdin: Input =
    Input { Handle/stdin };

--- Standard output.
pub let stdout: Output =
    Output { Handle/stdout };

--- Standard error.
pub let stderr: Output =
    Output { Handle/stderr };

--- Up to `n` bytes, and at least one until the input ends, waited for on this program's own behalf. Inside a fiber, `Async/Read`'s `read` parks instead.
pub let read(i: Input, n: Nat, @positive: Holds(0 < n)) -> Io(Chunk) =
    Async/Read/read(@Io, @Handle, i.0, n, @positive);

--- One line without its newline, `none` at the end of the input. An error ends the input as the end does, and what was read before it is still the line. It reads a byte at a time, so it consumes nothing past the newline.
pub let read_line(i: Input) -> Io(Option(Bytes)) =
    let go(acc: Bytes) -> Io(Option(Bytes)) =
        let c = read(i, 1)!;
        match c
        | chunk(b, @some) =>
            match Byte/to_nat(Bytes/get(b, 0, @some)) == '\n'
            | true => Io/pure(Option/some(acc))
            | false => go(x[..acc, ..b])
            end
        | _ =>
            Io/pure(
                match Bytes/len(acc) == 0 | true => Option/none() | false => Option/some(acc) end)
        end;
    go(x[]);

--- The whole of `b`, a short write resent; the first failure is the answer.
let written(o: Output, b: Bytes) -> Io(Result(Error, {})) =
    Async/Write/write(o.0, b);

--- The whole of `b`, a short write resent and a failure dropped.
pub let write(o: Output, b: Bytes) -> Io({}) =
    Io/bind(written(o, b), (_) => Io/pure(()));

satisfy Async/Read(Io, Input) {
    read(i, n, @positive) = read(i, n, @positive),
}

satisfy Async/Read(Async, Input) {
    read(i, n, @positive) = Async/Read/read(@Async, @Handle, i.0, n, @positive),
}

satisfy Async/Write(Io, Output) {
    write(o, b) = written(o, b),
    flush(o) = Async/Write/flush(o.0),
}

satisfy Async/Write(Async, Output) {
    write(o, b) = Async/Write/write(o.0, b),
    flush(o) = Async/Write/flush(o.0),
}
