pub use /sys/{Io};
pub use /sys/Io/{pure, bind};
use /std/{Monad, Bytes, Nat, Bool, List, Option, Cell, Handle, Program, Try};
use /std/Handle/{let Handle};
use /std/Bool/{Holds};
use /std/time/{Duration};

--- The failure every host operation reports.
pub mod Error;
pub use Error/{let Error};

-- `Waiting` is declared here and not in `Offer`, so that `select` reads it and an offer builds it, and nothing outside `Io` does: the handles it names are the library's.
--- What an offer waits on while it declines: handles a host makes ready and cells the program fills, and what releases the handles the wait made for itself, whether the wait ends or is cancelled. A program's offer waits on cells, through `Offer/on_filled`.
pub struct Waiting: Type {
    on: List(Handle),
    filled: List(Cell({})),
    release: Io({}),
}

--- What a selection is written against: a non-committing attempt at a value and what to wait on while it declines.
pub mod Offer;
pub use Offer/{let Offer};

--- A value filled once, which whatever waits on it waits for until it is.
pub mod Future;
pub use Future/{let Future};

--- A flag one branch raises and another waits on: a wait on no handle and no timer.
pub mod Signal;
pub use Signal/{let Signal};

--- A stream with the bytes read ahead of what was asked of it, and the reads that cut a piece from them.
pub mod Reader;
pub use Reader/{let Reader};

--- What a body runs its children in and opens its resources into: everything spawned into a scope is cancelled, and everything deferred to it released, before the scope answers.
pub mod Scope;
pub use Scope/{let Scope};

satisfy Monad(Io) {
    pure = pure,
    bind = bind,
}

--- The identity edge, for a witness whose premise is `Monad/Lift(Io, M)` at `M = Io`.
satisfy Monad/Lift(Io, Io) {
    lift(@_, m) = m,
}

--- A description that yields nothing is the program it describes.
satisfy Program(Io({})) {
    execute(program) = program,
}

--- Until a cell of `cells` is filled: a suspension that cancels nothing and goes on with nothing. Only the program fills a cell, so what waits on cells alone at the top of a program is a deadlock the host reports, and so is a wait on none.
pub let wait_filled(cells: List(Cell({}))) -> Io({}) =
    /sys/Io/suspend([], cells, pure(()), pure(()));

--- Until `d` has passed, on a timer of its own.
pub let sleep(d: Duration) -> Io({}) =
    let start = Handle/monotonic()!;
    Handle/wait_minted(Handle/timer(Duration/add(start, d)));

-- A cell filled already: what a suspension that may go on at once waits on. Private to the subtree, which is where every such suspension is made.
let ready() -> Io(Cell({})) =
    let cell = Cell/new()!;
    let _ = Cell/fill(cell, ())!;
    pure(cell);

--- Let what waits beside this run, and go on: a suspension on a cell filled already, which whatever advances it may go on from at once, and which the top of a program goes on from without waiting.
pub let yield() -> Io({}) =
    let cell = ready()!;
    wait_filled([cell]);

--- How a scope ended, as each release deferred to it is told.
pub induct Ended: pub Type
--- It ran to its end.
| finished()
--- What advanced it dropped it while it waited.
| cancelled()
end

-- `body`, and then `release` told how it ended: `finished` where it ran to its end, and `cancelled` where whatever advances it drops it while it waits, which `release` hears as the cancel of every suspension the body passes out. The scope's machinery: a program defers a release to a scope instead.
let using(@A: Type, release: (Ended) -> Io({}), body: Io(A)) -> Io(A) =
    /sys/Io/advance(
        body,
        (a) => bind(release(Ended/finished()), (_) => pure(a)),
        (on, filled, cancel, rest) =>
            /sys/Io/suspend(
                on,
                filled,
                bind(cancel, (_) => release(Ended/cancelled())),
                using(release, rest)));

--- One read's answer: bytes, or the end of the stream. A read that fails says so in its `Try`.
---
--- A chunk holds at least one byte, and says so: a read asks for a positive count, and a stream with nothing more to give has ended. So a reader takes a chunk's first byte by its proof rather than by a default, and a loop over chunks advances with every one.
pub induct Chunk: pub Type
--- Bytes were read: at least one.
| bytes(bytes: Bytes, @some: Holds(0 < Bytes/len(bytes)))
--- The stream is finished.
| ended()
end

--- What a stream is read through. A read asks for a positive count and answers a chunk of between one byte and that count or the end of the stream, or fails; a read the host cannot answer yet waits until it can, by suspending, so it holds only the branch that reads.
---
--- The lower bound is the chunk's own, stated in its type, so a witness for a stream of its own proves every chunk it hands out holds a byte — `Nat/lt/try` decides it of a length the witness cannot see. The upper bound is the witness's promise, which the host's rows hold `Handle` to.
pub concept Read(S: Type): pub Type {
    read(s: S, n: Nat, @positive: Holds(0 < n)) -> Try(Io, Error, Chunk),
}

pub use Read/*;

--- What a stream is written through: the whole of the bytes, a short write resent, and what the stream holds of the writes it accepted handed on.
pub concept Write(S: Type): pub Type {
    write(S, Bytes) -> Try(Io, Error, {}),
    --- Hand on what the stream holds of the writes it accepted: a TLS stream's records, which a write can accept before the socket takes them. Every other stream holds nothing.
    flush(S) -> Try(Io, Error, {}),
}

pub use Write/*;

-- Everything `read` yields up to the end of the stream; a failure before the end drops what was read. Every chunk holds a byte, so every read short of the end is progress.
let drain(
    read: (n: Nat, @positive: Holds(0 < n)) -> Try(Io, Error, Chunk),
) -> Try(Io, Error, Bytes) =
    let go(acc: Bytes) -> Try(Io, Error, Bytes) =
        let r = read(4096)!;
        match r | bytes(b) => go(x[..acc, ..b]) | ended() => Try/pure(acc) end;
    go(x[]);

--- Everything up to the end of the stream; a failure before the end drops what was read.
pub let read_all(@S: Type, use Read(S), s: S) -> Try(Io, Error, Bytes) =
    drain((n, @positive) => Read/read(@S, s, n, @positive));

--- Every chunk of `from` written to `to` until `from` ends; the first failure on either side is the answer.
pub let copy(@S: Type, @T: Type, use Read(S), use Write(T), from: S, to: T) -> Try(Io, Error, {}) =
    let go() -> Try(Io, Error, {}) =
        let c = Read/read(from, 4096)!;
        match c
        | bytes(b) =>
            let _ = Write/write(to, b)!;
            go()
        | ended() => Try/pure(())
        end;
    go();

-- The first offer of `offers` to yield, trying each in its order.
let attempt(@A: Type, offers: List(Offer(A))) -> Io(Option(A)) =
    match offers
    | [] => pure(Option/none())
    | [o, ..more] =>
        let got = o.try!;
        match got | some(a) => pure(Option/some(a)) | none() => attempt(more) end
    end;

-- What every offer of `offers` waits on, in their order.
let waits(@A: Type, offers: List(Offer(A))) -> Io(List(Waiting)) =
    match offers
    | [] => pure([])
    | [o, ..more] =>
        let w = o.wait!;
        let ws = waits(more)!;
        pure([w, ..ws])
    end;

-- Every release of `ws`, in their order.
let released(ws: List(Waiting)) -> Io({}) =
    match ws | [] => pure(()) | [w, ..more] => bind(w.release, (_) => released(more)) end;

--- The value of the first offer to yield one, waiting on what all of them wait on while every one declines. Offers are tried in list order, so a selection is not fair, and nothing leaves a source until it is the answer, so an offer that loses has consumed nothing. Which offer answered is the value's to say, through `Offer/map`.
---
--- This is the one place a wait on the program's own state checks and then suspends, with nothing run between the two, so no change is missed: a future, a channel and a signal each wait as an offer through it.
pub let select(@A: Type, offers: List(Offer(A))) -> Io(A) =
    let taken = attempt(offers)!;
    match taken
    | some(a) => pure(a)
    | none() =>
        let ws = waits(offers)!;
        let release = released(ws);
        /sys/Io/suspend(
            List/flatten(List/map(ws, (w: Waiting) => w.on)),
            List/flatten(List/map(ws, (w: Waiting) => w.filled)),
            release,
            bind(release, (_) => select(offers)))
    end;

-- Descriptions run side by side under one: each runs until it suspends, and the one that holds them waits on what all of them wait on. A branch no longer needed — a loser, a timed-out action, a child of a scope whose body has answered — is cancelled where it waits.
-- A branch the driver holds: one still to start, or one suspended on what its suspension named, with what cancels it and the rest of it. A branch that ran to its end is dropped, its answer in whatever it wrote to.
induct Branch: Type
| fresh(Io({}))
| waiting(on: List(Handle), filled: List(Cell({})), cancel: Io({}), rest: Io({}))
end

-- `b` advanced until it ends or suspends: nothing where it ended, or the branch it suspended as.
let step(b: Io({})) -> Io(Option(Branch)) =
    /sys/Io/advance(
        b,
        (_) => pure(Option/none()),
        (on, filled, cancel, rest) => pure(Option/some(Branch/waiting(on, filled, cancel, rest))));

-- Whether a cell of `cells` is filled.
let any_filled(cells: List(Cell({}))) -> Io(Bool) =
    match cells
    | [] => pure(false)
    | [cell, ..more] =>
        let held = Cell/poll(cell)!;
        match held | some(_) => pure(true) | none() => any_filled(more) end
    end;

-- Whether any of the first `n` of `flags` holds, and the flags after them.
let split(flags: List(Bool), n: Nat) -> {Bool, List(Bool)} =
    match n
    | 0 => (false, flags)
    | m + 1 =>
        match flags
        | [] => (false, [])
        | [f, ..more] =>
            let (any, rest) = split(more, m);
            (f || any, rest)
        end
    end;

-- The handles the waiting branches of `branches` wait on, in their order.
let handles(branches: List(Branch)) -> List(Handle) =
    List/concat_map(branches, (b: Branch) =>
        match b | waiting(on, _, _, _) => on | fresh(_) => [] end);

-- The cells the waiting branches of `branches` wait on, in their order.
let cells(branches: List(Branch)) -> List(Cell({})) =
    List/concat_map(branches, (b: Branch) =>
        match b | waiting(_, filled, _, _) => filled | fresh(_) => [] end);

-- Every waiting branch's cancel, in their order. A branch that never started has nothing to cancel.
let cancel_all(branches: List(Branch)) -> Io({}) =
    match branches
    | [] => pure(())
    | [b, ..more] =>
        let _ = match b | waiting(_, _, cancel, _) => cancel | fresh(_) => pure(()) end!;
        cancel_all(more)
    end;

let kept(stepped: Option(Branch), after: List(Branch)) -> List(Branch) =
    match stepped | some(b) => [b, ..after] | none() => after end;

-- One pass over `branches`, `flags` saying which of their handles are ready, in their order: a fresh branch is started, a waiting one whose handle is ready or whose cell is filled advanced, and any other kept as it waits. A pass advances nothing more once `settled` holds. Answers the branches after the pass, and whether any moved.
let pass(branches: List(Branch), flags: List(Bool), settled: Io(Bool)) -> Io({List(Branch), Bool}) =
    match branches
    | [] => pure(([], false))
    | [b, ..more] =>
        let done = settled!;
        match done
        | true => pure((branches, false))
        | false =>
            match b
            | fresh(start) =>
                let stepped = step(start)!;
                let (after, _) = pass(more, flags, settled)!;
                pure((kept(stepped, after), true))
            | waiting(on, filled, _, rest) =>
                let (ready, later) = split(flags, List/len(on));
                let woken = any_filled(filled)!;
                match ready || woken
                | true =>
                    let stepped = step(rest)!;
                    let (after, _) = pass(more, later, settled)!;
                    pure((kept(stepped, after), true))
                | false =>
                    let (after, moved) = pass(more, later, settled)!;
                    pure(([b, ..after], moved))
                end
            end
        end
    end;

-- `branches`, with whatever `intake` hands over before each pass, advanced pass after pass until `settled` holds or none is left: the one place `/std` holds a branch's rest and performs a dropped branch's cancel, under every combinator. A pass that moved something yields outward on a cell filled already, so whatever advances this description runs its own branches between passes; a pass that moved nothing suspends outward on every handle and cell its branches wait on, and on nothing where they wait on nothing. The branches still waiting when it ends are cancelled, each once, and so is every one of them where whatever advances it cancels it.
let drive(held: List(Branch), intake: Io(List(Branch)), settled: Io(Bool)) -> Io({}) =
    let incoming = intake!;
    let branches = [..held, ..incoming];
    let done = settled!;
    match done
    | true => cancel_all(branches)
    | false =>
        match branches
        | [] => pure(())
        | _ =>
            let on = handles(branches);
            let flags = match on | [] => pure([]) | _ => Handle/ready_now(on) end!;
            let (next, moved) = pass(branches, flags, settled)!;
            let ended = settled!;
            match ended
            | true => cancel_all(next)
            | false =>
                match next
                | [] => drive([], intake, settled)
                | _ =>
                    let rest = drive(next, intake, settled);
                    match moved
                    | true =>
                        let cell = ready()!;
                        /sys/Io/suspend([], [cell], cancel_all(next), rest)
                    | false => /sys/Io/suspend(handles(next), cells(next), cancel_all(next), rest)
                    end
                end
            end
        end
    end;

-- A driver over a fixed set of branches.
let nothing_more: Io(List(Branch)) =
    pure([]);

-- Whether `f` has been filled.
let answered(@A: Type, f: Future(A)) -> Io(Bool) =
    bind(Future/poll(f), (held) => pure(Option/is_some(held)));

-- `a` as a branch that fills `f` with its answer.
let into(@A: Type, a: Io(A), f: Future(A)) -> Branch =
    Branch/fresh(bind(a, (x) => Future/fill(f, x)));

--- `a` and `b` side by side, and both answers once both have them.
pub let both(@A: Type, @B: Type, a: Io(A), b: Io(B)) -> Io({A, B}) =
    let fa = Future/new()!;
    let fb = Future/new()!;
    let _ = drive([into(a, fa), into(b, fb)], nothing_more, pure(false))!;
    let x = Future/wait(fa)!;
    let y = Future/wait(fb)!;
    pure((x, y));

-- A future for each action of `actions`, beside it.
let promised(@A: Type, actions: List(Io(A))) -> Io(List({Io(A), Future(A)})) =
    match actions
    | [] => pure([])
    | [a, ..more] =>
        let f = Future/new()!;
        let rest = promised(more)!;
        pure([(a, f), ..rest])
    end;

-- The answer of each future of `fs`, in their order.
let awaited(@A: Type, fs: List(Future(A))) -> Io(List(A)) =
    match fs
    | [] => pure([])
    | [f, ..more] =>
        let a = Future/wait(f)!;
        let rest = awaited(more)!;
        pure([a, ..rest])
    end;

--- Every action of `actions` side by side, and their answers in their order once all have them.
pub let all(@A: Type, actions: List(Io(A))) -> Io(List(A)) =
    let pairs = promised(actions)!;
    let _ =
        drive(
            List/map(pairs, (p: {Io(A), Future(A)}) => into(p.0, p.1)),
            nothing_more,
            pure(false))!;
    awaited(List/map(pairs, (p: {Io(A), Future(A)}) => p.1));

--- The first of `actions` to answer; every other one is cancelled where it waits. An action dropped part-way loses whatever it had taken and not yet answered with, which is what abandoning a running computation costs — a selection over offers takes nothing until it keeps it, and is the way to choose without paying that. Which action answered is its answer's to say. With no action, nothing answers.
pub let race(@A: Type, actions: List(Io(A))) -> Io(A) =
    let won: Future(A) = Future/new()!;
    let _ = drive(List/map(actions, (a: Io(A)) => into(a, won)), nothing_more, answered(won))!;
    Future/wait(won);

--- `a`'s answer, or `none` where `d` passes first, `a` then cancelled where it waits. An answer that lands after `d` is dropped, which is what a timeout means.
pub let timeout(@A: Type, d: Duration, a: Io(A)) -> Io(Option(A)) =
    race([bind(a, (x) => pure(Option/some(x))), bind(sleep(d), (_) => pure(Option/none()))]);
