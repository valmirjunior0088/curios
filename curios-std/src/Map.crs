use /std/{Bytes, Bits, Byte, Nat, Int, Bool, Str, List, Option, Eq, Hash, Show, Spell};
use /std/Bool/{True, False, Holds};
use /std/ops/{Eql};

-- **`Flt` is deliberately not a key, and the reason is not the proof.** Injectivity holds and is cheap — `Flt/of_le_bytes` inverts `Flt/to_le_bytes`, so the witness is one congruence through a guarded decoder. What stops it is that this concept promises injectivity on *propositional* equality while `/std/ops/Eql`'s `Flt` witness is IEEE `==`, and the two disagree at both ends: `+0.0` and `-0.0` are distinct values with distinct encodings that `==` calls equal, so a map would hold them as two entries; a `NaN` is found by lookup though `==` calls it equal to nothing. Nothing here forbids that, because a key's law says nothing about `Eql` — which is exactly why the witness is withheld until what a map means for such a carrier is decided rather than discovered.
--- How a key type encodes to the byte string that identifies it, with the proof that distinct keys encode distinctly.
---
--- The encoding is `/std/Hash`'s by the edge rather than by convention: there is no second field to disagree with it, so a type has one identity as bytes by construction. What this concept adds is the proof `Hash` does not carry — that the encoding is injective, so the trie cannot silently merge two keys into one entry.
pub concept Key(K: Type): pub Type {
    use Hash(K),
    --- Distinct keys encode distinctly.
    injective(a: K, b: K, same: Eq()(Hash/hash(a), Hash/hash(b))) -> Eq()(a, b),
}

--- The identity encoding.
satisfy Key(Bytes) {
    injective(_, _, same) = same,
}

--- The UTF-8 bytes.
satisfy Key(Str) {
    injective(a, b, same) = Str/eq_of_bytes(a, b, same),
}

--- The code in the order of the numbers, whose injectivity is that order's.
satisfy Key(Nat) {
    injective = Hash/nat/injective,
}

--- The one byte itself, a cons onto no bytes, which is injective in its head.
satisfy Key(Byte) {
    injective(a, b, same) = Bytes/cons_inj_head(@a, @x[], @b, @x[], same),
}

-- Which of the two one-byte encodings a run is, as a total function of any `Bytes`.
let bool_of(z: Bytes) -> Bool =
    z == x[0x1];

-- The encoding round-trips through it at both values, which is the whole of the injectivity below: two values encoding alike decode alike, and decoding is the identity.
let bool_round(b: Bool) -> Eq()(bool_of(Hash/hash(b)), b) =
    match b | true => Eq/refl() | false => Eq/refl() end;

--- One byte per value, distinct.
satisfy Key(Bool) {
    injective(a, b, same) =
        Eq/trans(Eq/sym(bool_round(a)), Eq/trans(Eq/cong(bool_of, same), bool_round(b))),
}

-- The byte one bit encodes as, named so a run's head and its encoding's head cannot be confused for each other.
let byte_of_bit(h: Bool) -> Byte =
    match h | true => 0x1 | false => 0x0 end;

-- The bit a one-byte encoding stands for, read back. Total, so congruence can take an encoding apart.
let bit_of(k: Byte) -> Bool =
    k == 0x1;

-- One bit's byte round-trips through it, which is the head half of the induction below.
let bit_round(h: Bool) -> Eq()(bit_of(byte_of_bit(h)), h) =
    match h | true => Eq/refl() | false => Eq/refl() end;

-- An encoding of no bits is no encoding of a cons: the lengths differ, and zero against a successor is refuted by the comparison deciding it.
let no_empty(k: Byte, r: Bytes, e: Eq()(x[], x[k, ..r])) -> False =
    Eq/subst((m) => Holds(0 == m), Eq/cong(Bytes/len, e), True/qed());

-- Distinct bit runs encode distinctly.
--
-- Structural induction on the left run, carrying the claim for every right run: `Hash(Bits)` states its encoding through the packed eliminator, so `hash(b[h, ..t])` *is* `x[<h>, ..hash(t)]`, and the two sides come apart with `/std/Bytes`'s cons injections. A run against a run of another length is refuted on the encoding's own length, which the byte-per-bit reading makes the run's.
let bits_injective(a: Bits, b: Bits, same: Eq()(Hash/hash(a), Hash/hash(b))) -> Eq()(a, b) =
    match a: (m) => (y: Bits, e: Eq()(Hash/hash(m), Hash/hash(y))) -> Eq()(m, y)
    | b[] =>
        (y, e) =>
            match y
            | b[] => Eq/refl()
            | b[k, ..r] => match no_empty(byte_of_bit(k), Hash/hash(r), e) end
            end
    | b[h, ..t]; ih =>
        (y, e) =>
            match y
            | b[] => match no_empty(byte_of_bit(h), Hash/hash(t), Eq/sym(e)) end
            | b[k, ..r] =>
                Bits/cong_cons2(
                    Eq/trans(
                        Eq/sym(bit_round(h)),
                        Eq/trans(Eq/cong(bit_of, Bytes/cons_inj_head(e)), bit_round(k))),
                    ih(r, Bytes/cons_inj_tail(e)))
            end
    end(b, same);

--- One byte per bit, so a run's length is its encoding's and no two runs share one.
satisfy Key(Bits) {
    injective = bits_injective,
}

--- The code in the order of the numbers, whose injectivity is that order's.
satisfy Key(Int) {
    injective = Hash/int/injective,
}

induct Node(K: Type, V: Type): Type
| leaf(key: K, value: V)
| fork(crit: Nat, zero: Node(K, V), one: Node(K, V))
end

--- A map from keys of type `K` to values, built and read under one `Key(K)` dictionary, which its type names.
---
--- A leaf holds the key itself and its encoding is derived where a comparison needs it, so the keys come back as they went in. The shape of the trie is a function of the encoding, which is why the dictionary is a parameter: a map built under another is a value of another type, and every operation walks under the dictionary its map's type names.
pub struct Map(K: Type, use Key(K), V: Type): Type {
    size: Nat,
    root: Option(Node(K, V)),
}

let bit(k: Bytes, j: Nat) -> Bool =
    let g = j / 9;
    let o = j % 9;
    match g < Bytes/len(k)
    | false => false
    | true =>
        match o == 0
        | true => true
        | false => Nat/and(Nat/shr(Byte/to_nat(Bytes/get(k, g)), 8 - o), 1) != 0
        end
    end;

let crit(a: Bytes, b: Bytes) -> Nat =
    let bits(x: Nat, y: Nat, g: Nat, o: Nat) -> Nat =
        match Nat/and(Nat/shr(x, 8 - o), 1) == Nat/and(Nat/shr(y, 8 - o), 1)
        | true => bits(x, y, g, o + 1)
        | false => g * 9 + o
        end;
    let bytes(g: Nat) -> Nat =
        match g < Bytes/len(a)
        | false => g * 9
        | true =>
            match g < Bytes/len(b)
            | false => g * 9
            | true =>
                let x = Byte/to_nat(Bytes/get(a, g));
                let y = Byte/to_nat(Bytes/get(b, g));
                match x == y | true => bytes(g + 1) | false => bits(x, y, g, 1) end
            end
        end;
    bytes(0);

-- The leaf a walk by `k`'s bits ends at. Its key is the one to compare: a fork tests one bit, so only the whole encoding says whether the walk was a hit.
let lookup(@K: Type, @V: Type, t: Node(K, V), k: Bytes) -> {K, V} =
    match t
    | leaf(k0, v0) => (k0, v0)
    | fork(c, z, o) => match bit(k, c) | false => lookup(z, k) | true => lookup(o, k) end
    end;

let wedge(@K: Type, @V: Type, c: Nat, b: Bool, key: K, v: V, t: Node(K, V)) -> Node(K, V) =
    match b
    | false => Node/fork(c, Node/leaf(key, v), t)
    | true => Node/fork(c, t, Node/leaf(key, v))
    end;

-- How an insertion under a node ended: the node with the key's leaf added, the node with the value of a leaf it held replaced, or the node as it was beside the bit the key first parts from its keys at, where its leaf is still to be wedged in above.
induct Inserted(K: Type, V: Type): Type
| added(Node(K, V))
| replaced(Node(K, V))
| parted(Node(K, V), Nat)
end

-- `key` is the key and `k` its encoding, computed once by the caller; a leaf's is derived here, where it is compared.
let insert1(
    @K: Type,
    use Key(K),
    @V: Type,
    t: Node(K, V),
    key: K,
    k: Bytes,
    v: V,
) -> Inserted(K, V) =
    match t
    | leaf(k0, _) =>
        let e0 = Hash/hash(k0);
        match e0 == k
        | true => Inserted/replaced(Node/leaf(key, v))
        | false => Inserted/parted(t, crit(k, e0))
        end
    | fork(tc, z, o) =>
        match bit(k, tc)
        | false =>
            match insert1(z, key, k, v)
            | added(z2) => Inserted/added(Node/fork(tc, z2, o))
            | replaced(z2) => Inserted/replaced(Node/fork(tc, z2, o))
            | parted(z2, c) =>
                match tc < c
                | true => Inserted/added(Node/fork(tc, wedge(c, bit(k, c), key, v, z2), o))
                | false => Inserted/parted(t, c)
                end
            end
        | true =>
            match insert1(o, key, k, v)
            | added(o2) => Inserted/added(Node/fork(tc, z, o2))
            | replaced(o2) => Inserted/replaced(Node/fork(tc, z, o2))
            | parted(o2, c) =>
                match tc < c
                | true => Inserted/added(Node/fork(tc, z, wedge(c, bit(k, c), key, v, o2)))
                | false => Inserted/parted(t, c)
                end
            end
        end
    end;

-- How a removal under a node ended: the key was not there, the node was its leaf and nothing is left of it, or what is left of the node.
induct Removed(K: Type, V: Type): Type
| absent()
| gone()
| kept(Node(K, V))
end

let remove1(@K: Type, use Key(K), @V: Type, t: Node(K, V), k: Bytes) -> Removed(K, V) =
    match t
    | leaf(k0, _) =>
        match Hash/hash(k0) == k | true => Removed/gone() | false => Removed/absent() end
    | fork(c, z, o) =>
        match bit(k, c)
        | false =>
            match remove1(z, k)
            | absent() => Removed/absent()
            | gone() => Removed/kept(o)
            | kept(z2) => Removed/kept(Node/fork(c, z2, o))
            end
        | true =>
            match remove1(o, k)
            | absent() => Removed/absent()
            | gone() => Removed/kept(z)
            | kept(o2) => Removed/kept(Node/fork(c, z, o2))
            end
        end
    end;

--- The empty map.
pub let empty(@K: Type, use Key(K), @V: Type) -> Map(K, V) =
    Map { size = 0, root = Option/none() };

--- How many entries.
pub let len(@K: Type, use Key(K), @V: Type, m: Map(K, V)) -> Nat =
    m.size;

--- The value at `key`, or `none`.
pub let get(@K: Type, use Key(K), @V: Type, m: Map(K, V), key: K) -> Option(V) =
    let k = Hash/hash(key);
    match m.root
    | none() => Option/none()
    | some(n) =>
        let (k0, v0) = lookup(n, k);
        match Hash/hash(k0) == k | true => Option/some(v0) | false => Option/none() end
    end;

--- Whether `key` has an entry.
pub let has(@K: Type, use Key(K), @V: Type, m: Map(K, V), key: K) -> Bool =
    Option/is_some(get(m, key));

--- `m` with `key` at `v`, replacing an entry under the same key.
pub let insert(@K: Type, use Key(K), @V: Type, m: Map(K, V), key: K, v: V) -> Map(K, V) =
    let k = Hash/hash(key);
    match m.root
    | none() => Map { size = 1, root = Option/some(Node/leaf(key, v)) }
    | some(n) =>
        match insert1(n, key, k, v)
        | replaced(n2) => Map { size = m.size, root = Option/some(n2) }
        | parted(n2, c) =>
            Map { size = m.size + 1, root = Option/some(wedge(c, bit(k, c), key, v, n2)) }
        | added(n2) => Map { size = m.size + 1, root = Option/some(n2) }
        end
    end;

--- `m` without `key`; unchanged when absent.
pub let remove(@K: Type, use Key(K), @V: Type, m: Map(K, V), key: K) -> Map(K, V) =
    let k = Hash/hash(key);
    match m.root
    | none() => m
    | some(n) =>
        match remove1(n, k)
        | gone() => Map { size = m.size - 1, root = Option/none() }
        | kept(n2) => Map { size = m.size - 1, root = Option/some(n2) }
        | absent() => m
        end
    end;

--- Over the entries in the order of their encoded keys, with `f(key, value, acc)`.
pub let fold(
    @K: Type,
    use Key(K),
    @V: Type,
    @A: Type,
    m: Map(K, V),
    init: A,
    f: (K, V, A) -> A,
) -> A =
    match m.root
    | none() => init
    | some(n) =>
        let go(t: Node(K, V), acc: A) -> A =
            match t | leaf(k, v) => f(k, v, acc) | fork(_, z, o) => go(o, go(z, acc)) end;
        go(n, init)
    end;

--- The entries, in the order of their encoded keys.
pub let entries(@K: Type, use Key(K), @V: Type, m: Map(K, V)) -> List({K, V}) =
    fold(m, [], (k, v, acc) => [..acc, (k, v)]);

--- The keys, in the order of their encodings.
pub let keys(@K: Type, use Key(K), @V: Type, m: Map(K, V)) -> List(K) =
    fold(m, [], (k, _, acc) => [..acc, k]);

--- The values, in the order of their keys' encodings.
pub let values(@K: Type, use Key(K), @V: Type, m: Map(K, V)) -> List(V) =
    fold(m, [], (_, v, acc) => [..acc, v]);

--- The map of the pairs, a later pair replacing an earlier one under the same key.
pub let of(@K: Type, use Key(K), @V: Type, l: List({K, V})) -> Map(K, V) =
    List/fold(l, empty(), ((k, v), acc) => insert(acc, k, v));

--- The value at `key`, or `default`.
pub let get_or(@K: Type, use Key(K), @V: Type, m: Map(K, V), key: K, default: V) -> V =
    Option/unwrap_or(get(m, key), default);

--- The entry at `key` rewritten by `f`, which sees the current value or `none` and answers the value to keep or `none` to remove.
pub let update(
    @K: Type,
    use Key(K),
    @V: Type,
    m: Map(K, V),
    key: K,
    f: (Option(V)) -> Option(V),
) -> Map(K, V) =
    match f(get(m, key)) | some(v) => insert(m, key, v) | none() => remove(m, key) end;

let map_node(@K: Type, @V: Type, @W: Type, t: Node(K, V), f: (V) -> W) -> Node(K, W) =
    match t
    | leaf(k, v) => Node/leaf(k, f(v))
    | fork(c, z, o) => Node/fork(c, map_node(z, f), map_node(o, f))
    end;

--- `f` on every value. The keys and their dictionary stay, so the trie keeps its shape.
pub let map(@K: Type, use Key(K), @V: Type, @W: Type, m: Map(K, V), f: (V) -> W) -> Map(K, W) =
    Map { size = m.size, root = Option/map(m.root, (n: Node(K, V)) => map_node(n, f)) };

--- The entries `pred` accepts.
pub let filter(@K: Type, use Key(K), @V: Type, m: Map(K, V), pred: (K, V) -> Bool) -> Map(K, V) =
    fold(
        m,
        empty(),
        (k, v, acc) => match pred(k, v) | true => insert(acc, k, v) | false => acc end);

--- Every entry of either, `b`'s winning under a shared key. Both are maps of one type, so of one dictionary.
pub let union(@K: Type, use Key(K), @V: Type, a: Map(K, V), b: Map(K, V)) -> Map(K, V) =
    fold(b, a, (k, v, acc) => insert(acc, k, v));

--- `m`, built under the dictionary `from`, as a map under the one in scope. Every entry is inserted again, since the shape of a trie is its dictionary's.
pub let rekey(@K: Type, @from: Key(K), use Key(K), @V: Type, m: Map(K, use from, V)) -> Map(K, V) =
    fold(@K, use from, m, empty(), (k, v, acc) => insert(acc, k, v));

-- Keys are compared by their encodings, which `Key`'s law makes equality, so a map's own dictionary is all that equality of maps asks of its keys.
let same_entries(
    @K: Type,
    use Key(K),
    @V: Type,
    use Eql(V),
    xs: List({K, V}),
    ys: List({K, V}),
) -> Bool =
    match xs
    | [] => match ys | [] => true | _ => false end
    | [x, ..xt] =>
        match ys
        | [] => false
        | [y, ..yt] => Hash/hash(x.0) == Hash/hash(y.0) && x.1 == y.1 && same_entries(xt, yt)
        end
    end;

--- Entry by entry.
satisfy (@K: Type, use Key(K), @V: Type, use Eql(V)) => Eql(Map(K, V)) {
    eql(a, b) = same_entries(entries(a), entries(b)),
    neq(a, b) = Bool/not(same_entries(entries(a), entries(b))),
}

satisfy (@K: Type, use Key(K), @V: Type, use Show(K), use Show(V)) => Show(Map(K, V)) {
    show(m) =
        Str/flatten([
            "{",
            Str/join(
                ", ",
                List/map(entries(m), ((k, v)) => Str/flatten([Show/show(k), ": ", Show/show(v)]))),
            "}"]),
}

--- As `Map/of` over the entries.
satisfy (@K: Type, use Key(K), @V: Type, use Spell(K), use Spell(V)) => Spell(Map(K, V)) {
    spell(m) =
        Str/flatten([
            "Map/of([",
            Str/join(
                ", ",
                List/map(
                    entries(m),
                    ((k, v)) => Str/flatten(["(", Spell/spell(k), ", ", Spell/spell(v), ")"]))),
            "])"]),
}
