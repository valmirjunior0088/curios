mod tests;

--- How a key type encodes to the byte string that identifies it, in its own order: the concept, a witness for each key type the library has, and the laws every key has from it.
pub mod Key;
pub use Key/{let Key};

--- A key's encoding read a bit at a time, nine to a byte, and where two encodings first differ.
mod bits;

--- What `Map`'s own modules share and no program sees: a `pub` inside it reaches all of `Map` and no further.
mod internal;
use internal/{Node};

--- The value at a key, with the theorems of what each operation leaves there and that two maps alike at every key are one.
pub mod try_get;
pub use try_get/{let try_get};

--- A map's keys, with the theorem that they are in their type's own order.
pub mod keys;
pub use keys/{let keys};

--- A map's least entry, with the theorems that its key is the map's and that no key of the map is below it.
pub mod least;
pub use least/{let least};

--- A map's greatest entry, with the theorems that its key is the map's and that no key of the map is above it.
pub mod greatest;
pub use greatest/{let greatest};

use /std/{Nat, Bool, Bytes, Str, List, Option, Eq, Hash, Show, Spell, Fmt};
use /std/ops/{Eql};

-- That a root's trie is sound, in the form a map holds: a family over the root that applies no function to it.
induct Rooted(K: Type, use Key(K), V: Type): (Option(Node(K, V))) -> Prop
| none(): (Option/none())
| some(@n: Node(K, V), @a: Bytes, @p: Option(Nat), shaped: Node/Shaped(K, V)(n, a, p)): (
    Option/some(n))
end

-- A root is sound where its trie is.
let Grounded(@K: Type, use Key(K), @V: Type, root: Option(Node(K, V))) -> Prop =
    match root | none() => Bool/True | some(n) => Node/Sound(n) end;

-- What a map holds of its root, read as the root's soundness.
let grounded(
    @K: Type,
    use Key(K),
    @V: Type,
    @root: Option(Node(K, V)),
    held: Rooted(K, V)(root),
) -> Grounded(root) =
    match held: (r, _) => Grounded(r)
    | none() => Bool/True/qed()
    | some(shaped) => Node/read(shaped).sound
    end;

-- A sound node as a root's proof.
let rooted(
    @K: Type,
    use Key(K),
    @V: Type,
    n: Node(K, V),
    sound: Node/Sound(n),
) -> Rooted(K, V)(Option/some(n)) =
    Rooted/some(Node/shaped(n, sound));

--- A map from keys of type `K` to values, built and read under one `Key(K)` dictionary, which its type names.
---
--- A map holds, hidden, the proof that its trie is sound: at every fork, the fork's bit is the first at which the keys of its two sides differ, clear in those of the zero side and set in those of the one side. Every operation that builds a map builds the proof, and it erases.
---
--- A leaf holds the key itself and its encoding is derived where a comparison needs it, so the keys come back as they went in. The shape of the trie is a function of the encoding, which is why the dictionary is a parameter: a map built under another is a value of another type, and every operation walks under the dictionary its map's type names.
pub struct Map(K: Type, use Key(K), V: Type): Type {
    root: Option(Node(K, V)),
    @rooted: Rooted(K, V)(root),
}

--- The empty map.
pub let empty(@K: Type, use Key(K), @V: Type) -> Map(K, V) =
    Map { root = Option/none(), @rooted = Rooted/none() };

--- How many entries, counted: the trie holds its entries and nothing beside them, so the count is a walk over every one.
pub let len(@K: Type, use Key(K), @V: Type, m: Map(K, V)) -> Nat =
    fold(m, 0, (_, _, n) => n + 1);

--- Whether `key` has an entry.
pub let has(@K: Type, use Key(K), @V: Type, m: Map(K, V), key: K) -> Bool =
    Option/is_some(try_get(m, key));

--- The value at `key`, under the evidence that it has an entry.
pub let get(
    @K: Type,
    use Key(K),
    @V: Type,
    m: Map(K, V),
    key: K,
    @ok: Bool/Holds(has(m, key)),
) -> V =
    match try_get(m, key)
    | some(v) => v
    | none() => match ok end
    end;

--- `m` with `key` at `v`, replacing an entry under the same key.
pub let insert(@K: Type, use Key(K), @V: Type, m: Map(K, V), key: K, v: V) -> Map(K, V) =
    let k = Hash/hash(key);
    match m.root
    | none() =>
        Map {
            root = Option/some(Node/leaf(key, v)),
            @rooted = rooted(Node/leaf(key, v), Bool/True/qed()) }
    | some(n) =>
        match Node/insert(n, key, k, v, @Eq/refl(), @grounded(m.rooted))
        | replaced(n2, @stands) =>
            Map { root = Option/some(n2), @rooted = rooted(n2, stands.sound) }
        | parted(n2, c, @back, @apart, @past) =>
            Map {
                root = Option/some(Node/wedge(c, bits/bit(k, c), key, v, n2)),
                @rooted =
                    rooted(
                        Node/wedge(c, bits/bit(k, c), key, v, n2),
                        Eq/subst(
                            (t: Node(K, V)) => Node/Sound(Node/wedge(c, bits/bit(k, c), key, v, t)),
                            Eq/sym(back),
                            Node/wedged(
                                c,
                                key,
                                k,
                                v,
                                n,
                                Eq/refl(),
                                grounded(m.rooted),
                                apart,
                                past))) }
        | added(n2, @stands) => Map { root = Option/some(n2), @rooted = rooted(n2, stands.sound) }
        end
    end;

--- `m` without `key`; unchanged when absent.
pub let remove(@K: Type, use Key(K), @V: Type, m: Map(K, V), key: K) -> Map(K, V) =
    let k = Hash/hash(key);
    match m.root
    | none() => m
    | some(n) =>
        match Node/remove(n, k, @grounded(m.rooted))
        | gone(_) => Map { root = Option/none(), @rooted = Rooted/none() }
        | kept(n2, @stands) => Map { root = Option/some(n2), @rooted = rooted(n2, stands.sound) }
        | absent(_) => m
        end
    end;

--- Over the entries in the order of their keys, with `f(key, value, acc)`.
pub let fold(
    @K: Type,
    use Key(K),
    @V: Type,
    @A: Type,
    m: Map(K, V),
    init: A,
    f: (K, V, A) -> A,
) -> A =
    match m.root | none() => init | some(n) => Node/fold(n, init, f) end;

--- The entries, in the order of their keys.
pub let to_list(@K: Type, use Key(K), @V: Type, m: Map(K, V)) -> List({K, V}) =
    fold(m, [], (k, v, acc) => [..acc, (k, v)]);

--- The values, in the order of their keys.
pub let values(@K: Type, use Key(K), @V: Type, m: Map(K, V)) -> List(V) =
    fold(m, [], (_, v, acc) => [..acc, v]);

--- The map of the pairs, a later pair replacing an earlier one under the same key.
pub let of_list(@K: Type, use Key(K), @V: Type, l: List({K, V})) -> Map(K, V) =
    List/fold(l, empty(), ((k, v), acc) => insert(acc, k, v));

--- The value at `key`, or `default`.
pub let get_or(@K: Type, use Key(K), @V: Type, m: Map(K, V), key: K, default: V) -> V =
    Option/unwrap_or(try_get(m, key), default);

--- The entry at `key` rewritten by `f`, which sees the current value or `none` and answers the value to keep or `none` to remove.
pub let update(
    @K: Type,
    use Key(K),
    @V: Type,
    m: Map(K, V),
    key: K,
    f: (Option(V)) -> Option(V),
) -> Map(K, V) =
    match f(try_get(m, key)) | some(v) => insert(m, key, v) | none() => remove(m, key) end;

--- `f` on every value. The keys and their dictionary stay, so the trie keeps its shape.
pub let map(@K: Type, use Key(K), @V: Type, @W: Type, m: Map(K, V), f: (V) -> W) -> Map(K, W) =
    Map {
        root = Option/map(m.root, (n: Node(K, V)) => Node/map(n, f)),
        @rooted =
            match m.root: (r) =>
                (ground: Grounded(r)) -> Rooted(K, W)(
                    Option/map(r, (n: Node(K, V)) => Node/map(n, f)))
            | none() => (_) => Rooted/none()
            | some(n) => (ground) => rooted(Node/map(n, f), Node/mapped(n, f, ground))
            end(grounded(m.rooted)) };

--- The entries `pred` accepts.
pub let filter(@K: Type, use Key(K), @V: Type, m: Map(K, V), pred: (K, V) -> Bool) -> Map(K, V) =
    fold(
        m,
        empty(),
        (k, v, acc) => match pred(k, v) | true => insert(acc, k, v) | false => acc end);

--- Every entry of either, `b`'s winning under a shared key. Both are maps of one type, so of one dictionary.
pub let union(@K: Type, use Key(K), @V: Type, a: Map(K, V), b: Map(K, V)) -> Map(K, V) =
    fold(b, a, (k, v, acc) => insert(acc, k, v));

--- `m`, built under the dictionary `from`, as a map under the one in scope. Every entry is inserted again, since the shape of a trie is its dictionary's.
pub let rekey(@K: Type, @from: Key(K), use Key(K), @V: Type, m: Map(K, use from, V)) -> Map(K, V) =
    fold(@K, use from, m, empty(), (k, v, acc) => insert(acc, k, v));

-- Keys are compared by their encodings, which `Key`'s law makes equality, so a map's own dictionary is all that equality of maps asks of its keys.
let same_entries(
    @K: Type,
    use Key(K),
    @V: Type,
    use Eql(V),
    xs: List({K, V}),
    ys: List({K, V}),
) -> Bool =
    match xs
    | [] => match ys | [] => true | _ => false end
    | [x, ..xt] =>
        match ys
        | [] => false
        | [y, ..yt] => Hash/hash(x.0) == Hash/hash(y.0) && x.1 == y.1 && same_entries(xt, yt)
        end
    end;

--- Entry by entry.
satisfy (@K: Type, use Key(K), @V: Type, use Eql(V)) => Eql(Map(K, V)) {
    eql(a, b) = same_entries(to_list(a), to_list(b)),
    neq(a, b) = Bool/not(same_entries(to_list(a), to_list(b))),
}

satisfy (@K: Type, use Key(K), @V: Type, use Show(K), use Show(V)) => Show(Map(K, V)) {
    show(m) =
        Fmt/render("{%}")(
            Str/join(", ", List/map(to_list(m), ((k, v)) => Fmt/render("%: %")(k)(v)))),
}

--- As `Map/of_list` over the entries.
satisfy (@K: Type, use Key(K), @V: Type, use Spell(K), use Spell(V)) => Spell(Map(K, V)) {
    spell(m) =
        Fmt/render("Map/of_list([%])")(
            Str/join(", ", List/map(to_list(m), ((k, v)) => Fmt/render("(#, #)")(k)(v)))),
}
