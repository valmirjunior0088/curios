--- How a child ended: with an exit code, or by a signal.
pub mod Exit;
pub use Exit/{let Exit};

--- A child this process started: starting it, the pipes to its streams, waiting for it, and ending it.
pub mod Child;
pub use Child/{let Child};

use /std/{Byte, Bytes, Str, List, Option, Result, Path, Try, Io};
use /std/internal/{Handle, Status};

--- How a child's standard stream is wired: shared with this process, piped to the parent, or attached to the null device.
pub induct Stdio: pub Type
--- The child shares this process's own stream.
| inherit()
--- The parent gets a pipe to it.
| piped()
--- It goes to the null device.
| null()
end

--- A program to run, and how to run it: what a child is started from.
pub struct Process: pub Type {
    program: Str,
    args: List(Str),
    --- The working directory, or the parent's.
    cwd: Option(Path),
    --- Entries laid over the inherited environment.
    env: List({Str, Str}),
    stdin: Stdio,
    stdout: Stdio,
    stderr: Stdio,
}

--- `program` with `args`, inheriting the working directory, the environment and every stream.
pub let new(program: Str, args: List(Str)) -> Process =
    Process {
        program = program,
        args = args,
        cwd = Option/none(),
        env = [],
        stdin = Stdio/inherit(),
        stdout = Stdio/inherit(),
        stderr = Stdio/inherit() };

let drain(o: Option(Input)) -> Io(Result(Io/Error, Bytes)) =
    match o | some(o) => Try/run(Io/read_all(o)) | none() => Io/pure(Result/success(x[])) end;

let fed(i: Output, input: Bytes) -> Try(Io, Io/Error, {}) =
    let _ = Io/write(i, input)!;
    Io/finish(i);

-- A child that stops reading before its input is all written leaves the rest unread, which is its own to answer for: the broken pipe is no failure of the run.
let feed(i: Option(Output), input: Bytes) -> Io(Result(Io/Error, {})) =
    match i
    | some(i) =>
        Io/bind(
            Try/run(fed(i, input)),
            (r) => Io/pure(match r | failure(broken_pipe()) => Result/success(()) | _ => r end))
    | none() => Io/pure(Result/success(()))
    end;

let exchange(
    c: Child,
    input: Bytes,
) -> Try(Io, Io/Error, {exit: Exit, stdout: Bytes, stderr: Bytes}) =
    let (fed, outputs) =
        Io/both(
            feed(Child/stdin(c), input),
            Io/both(drain(Child/stdout(c)), drain(Child/stderr(c))))!;
    let (o, e) = outputs;
    let _ = fed!;
    let stdout = o!;
    let stderr = e!;
    let exit = Child/wait(c)!;
    Try/pure((exit = exit, stdout = stdout, stderr = stderr));

--- `p` run to its end with `input` written to its standard input, which then ends, and both outputs captured, and how it ended. The input is written while the outputs are read, so neither stalls the other.
pub let run(
    p: Process,
    input: Bytes,
) -> Try(Io, Io/Error, {exit: Exit, stdout: Bytes, stderr: Bytes}) =
    Try/scope((s) =>
        Try/bind(
            Child/spawn(
                s,
                Process {
                    ..p,
                    stdin = Stdio/piped(),
                    stdout = Stdio/piped(),
                    stderr = Stdio/piped() }),
            (c) => exchange(c, input)));

--- `p` run with its streams as wired, and how it ended.
pub let status(p: Process) -> Try(Io, Io/Error, Exit) =
    Try/scope((s) => Try/bind(Child/spawn(s, p), Child/wait));

--- The process's arguments.
foreign proc_args() -> List(Bytes);

--- The arguments this process was started with, each as the bytes it arrived as.
pub let args() -> Io(List(Bytes)) =
    proc_args();

--- The environment variable of this name: `ok` beside its value, or another status where it has none.
foreign proc_env(Bytes) -> {status: Nat, value: Bytes};

--- The environment variable `name` of this process, or `none` when it is unset.
pub let env(name: Str) -> Io(Option(Bytes)) =
    let reply = proc_env(Str/to_bytes(name))!;
    Io/pure(
        match Status/of_code(reply.status)
        | ok() => Option/some(reply.value)
        | _ => Option/none()
        end);

--- End the instance with this code. The call does not return.
foreign proc_exit(Byte) -> Never;

--- End this process with `code`, a byte because that is the status every host hands its parent whole. The description yields whatever the region wanted, so an exiting arm can end a region of any type.
pub let exit(@A: Type, code: Byte) -> Io(A) =
    proc_exit(code);

--- A stream this process reads: its own standard input, or the output of a child it started, piped to it.
pub struct Input: Type {
    Handle,
}

--- A stream this process writes: its own standard output or error, or the input of a child it started, piped from it.
pub struct Output: Type {
    Handle,
}

--- This process's standard input.
pub let stdin: Input =
    Input { Handle/stdin };

--- This process's standard output.
pub let stdout: Output =
    Output { Handle/stdout };

--- This process's standard error.
pub let stderr: Output =
    Output { Handle/stderr };

satisfy Io/Read(Input) {
    read(i, n, @positive) = Io/read(@Handle, i.0, n, @positive),
}

satisfy Io/Write(Output) {
    write(o, b) = Io/write(o.0, b),
    flush(o) = Io/flush(o.0),
}

--- Close this input before its scope or the process's end does.
satisfy Io/Close(Input) {
    close(i) = Io/close(i.0),
}

--- Close this output before its scope or the process's end does: its reader reads the end of the stream.
satisfy Io/Close(Output) {
    close(o) = Io/close(o.0),
}

let ended(o: Output) -> Try(Io, Io/Error, {}) =
    let _ = Io/close(o)!;
    Try/pure(());

--- The reader at the other end reads the end of the stream: the stream is closed, which is the one way a pipe or a standard stream tells its reader it has ended. Writing it after answers `not_found`, as a closed handle does.
satisfy Io/Finish(Output) {
    finish(o) = ended(o),
}
