use /std/{Bool, Byte, Bytes, Nat, Str, List, Option, Result, Path, Try, Io, Handle};
use /std/Handle/{let Handle, Interest};

--- How a child's standard stream is wired: shared with this process, piped to the parent, or attached to the null device.
pub induct Stdio: pub Type
--- The child shares this process's own stream.
| inherit()
--- The parent gets a pipe to it.
| piped()
--- It goes to the null device.
| null()
end

--- How a child ended: with an exit code, or by a signal.
pub mod Exit;
pub use Exit/{let Exit};

--- A program to run, and how to run it.
pub mod Command;
pub use Command/{let Command};

-- `Pipe` is declared here and not in its module, so that `spawn` builds it and nothing outside this subtree does.
--- One end of a pipe to a child, read and written as a stream.
pub struct Pipe: Type {
    Handle,
}

--- A pipe to one of a child's streams: reading it, writing it and closing it.
pub mod Pipe;

--- A running child, and whichever of its streams were piped.
pub struct Process: Type {
    handle: Handle,
    stdin: Option(Pipe),
    stdout: Option(Pipe),
    stderr: Option(Pipe),
}

--- The pipe to the child's standard input, when it was piped.
pub let piped_stdin(p: Process) -> Option(Pipe) =
    p.stdin;

--- The pipe from the child's standard output, when it was piped.
pub let piped_stdout(p: Process) -> Option(Pipe) =
    p.stdout;

--- The pipe from the child's standard error, when it was piped.
pub let piped_stderr(p: Process) -> Option(Pipe) =
    p.stderr;

let stdio_of(s: Stdio) -> Nat =
    match s
    | inherit() => /sys/stdio_mode/inherit
    | piped() => /sys/stdio_mode/pipe
    | null() => /sys/stdio_mode/null
    end;

let env_entry(entry: {Str, Str}) -> Bytes =
    x[..Str/to_bytes(entry.0), '=', ..Str/to_bytes(entry.1)];

--- Whether `key` can name an environment variable: something, and no `=`, which would end the name early in the `NAME=VALUE` entry it crosses as.
let names_a_variable(key: Str) -> Bool =
    match Str/is_empty(key) | true => false | false => Bool/not(Str/contains(key, '=')) end;

--- Nothing, or `EINVAL` for an entry whose key names no variable.
let env_checked(env: List({Str, Str})) -> Result(Io/Error, {}) =
    match List/all(env, (entry) => names_a_variable(entry.0))
    | true => Result/success(())
    | false => Result/failure(Io/Error/other(/sys/errno/inval))
    end;

--- The parent's end of a stream wired as `s`: the pipe the host answered where the stream was piped, and none where it was not, whose slot names nothing.
let end_of(s: Stdio, handle: Handle) -> Option(Pipe) =
    match s | piped() => Option/some(Pipe { handle }) | _ => Option/none() end;

--- Start a program from its arguments, a working directory, environment entries and a `/sys/stdio_mode` code for each standard stream: `ok` beside the child's handle and a handle for each stream, or the status of the failure.
foreign proc_spawn(List(Bytes), Bytes, List(Bytes), Nat, Nat, Nat) -> {
    status: Nat,
    child: Handle,
    stdin: Handle,
    stdout: Handle,
    stderr: Handle};

--- Start `cmd` into `s`: when `s` ends the child is killed if it still runs, and its handle and pipes are closed, so no child outlives the scope it was started in. The child arrives with a pipe for each stream `cmd` piped, in the one call that starts it. An environment key that is empty or holds `=` names no variable, and is refused with `EINVAL` before anything starts.
pub let spawn(s: Io/Scope, cmd: Command) -> Try(Io, Io/Error, Process) =
    let _ = env_checked(cmd.env)!;
    let reply =
        proc_spawn(
            [Str/to_bytes(cmd.program), ..List/map(cmd.args, Str/to_bytes)],
            match cmd.cwd | some(p) => Path/to_bytes(p) | none() => x[] end,
            List/map(cmd.env, env_entry),
            stdio_of(cmd.stdin),
            stdio_of(cmd.stdout),
            stdio_of(cmd.stderr))!;
    let spawned =
        match reply.status == /sys/status/ok
        | true => Result/success(reply)
        | false => Result/failure(Handle/error(reply.status))
        end!;
    let p =
        Process {
            handle = spawned.child,
            stdin = end_of(cmd.stdin, spawned.stdin),
            stdout = end_of(cmd.stdout, spawned.stdout),
            stderr = end_of(cmd.stderr, spawned.stderr) };
    let _ = Io/Scope/defer(s, (_) => release(p))!;
    Try/pure(p);

let close_pipe(p: Option(Pipe)) -> Io({}) =
    match p | some(p) => Pipe/close(p) | none() => Io/pure(()) end;

let close_pipes(p: Process) -> Io({}) =
    let _ = close_pipe(p.stdin)!;
    let _ = close_pipe(p.stdout)!;
    close_pipe(p.stderr);

--- End this child: `ok`, or the status of the failure.
foreign proc_kill(Handle) -> Nat;

--- The child ended if it still runs. A child the host could not signal is left as it is.
let killed(p: Process) -> Io({}) =
    let _ = proc_kill(p.handle)!;
    Io/pure(());

-- End the child if it still runs, then close its handle and its pipes. The kill is the last use of the handle, and the host reaps the process whether or not anything waits for it.
let release(p: Process) -> Io({}) =
    let _ = killed(p)!;
    let _ = Handle/close(p.handle)!;
    close_pipes(p);

--- End the child if it still runs, and close its pipes.
pub let kill(p: Process) -> Io({}) =
    let _ = killed(p)!;
    close_pipes(p);

--- How this child ended: `ok` beside its exit code and the signal that ended it, or the status of the failure.
foreign proc_wait(Handle) -> {status: Nat, code: Nat, signal: Nat};

--- How the child ended, waiting until it does. The pipes are closed with it, so read what it wrote before waiting for it.
pub let wait(p: Process) -> Try(Io, Io/Error, Exit) =
    let _ = Handle/wait(p.handle, Interest/readable)!;
    let reply = proc_wait(p.handle)!;
    let _ = close_pipes(p)!;
    match reply.status == /sys/status/ok
    | true =>
        Try/pure(
            match reply.signal == 0
            | true => Exit/exited(reply.code)
            | false => Exit/signaled(reply.signal)
            end)
    | false => Try/raise(Handle/error(reply.status))
    end;

let drain(p: Option(Pipe)) -> Io(Result(Io/Error, Bytes)) =
    match p | some(p) => Try/run(Io/read_all(p)) | none() => Io/pure(Result/success(x[])) end;

let capture(p: Process) -> Try(Io, Io/Error, {exit: Exit, stdout: Bytes, stderr: Bytes}) =
    let (o, e) = Io/both(drain(p.stdout), drain(p.stderr))!;
    let stdout = o!;
    let stderr = e!;
    let exit = wait(p)!;
    Try/pure((exit = exit, stdout = stdout, stderr = stderr));

--- `cmd` run to its end with both outputs captured, and how it ended.
pub let run(cmd: Command) -> Try(Io, Io/Error, {exit: Exit, stdout: Bytes, stderr: Bytes}) =
    Try/scope((s) =>
        Try/bind(
            spawn(s, Command { ..cmd, stdout = Stdio/piped(), stderr = Stdio/piped() }),
            capture));

--- `cmd` run with its streams as wired, and how it ended.
pub let status(cmd: Command) -> Try(Io, Io/Error, Exit) =
    Try/scope((s) => Try/bind(spawn(s, cmd), wait));

--- The process's arguments.
foreign proc_args() -> List(Bytes);

--- The arguments this process was started with, each as the bytes it arrived as.
pub let args() -> Io(List(Bytes)) =
    proc_args();

--- The environment variable of this name: `ok` beside its value, or another status where it has none.
foreign proc_env(Bytes) -> {status: Nat, value: Bytes};

--- The environment variable `name` of this process, or `none` when it is unset.
pub let env(name: Str) -> Io(Option(Bytes)) =
    let reply = proc_env(Str/to_bytes(name))!;
    Io/pure(
        match reply.status == /sys/status/ok
        | true => Option/some(reply.value)
        | false => Option/none()
        end);

--- End the instance with this code. The call does not return.
foreign proc_exit(Byte) -> Never;

--- End this process with `code`, a byte because that is the status every host hands its parent whole. The description yields whatever the region wanted, so an exiting arm can end a region of any type.
pub let exit(@A: Type, code: Byte) -> Io(A) =
    proc_exit(code);

--- An input stream of this process.
pub struct Input: Type {
    Handle,
}

--- An output stream of this process.
pub struct Output: Type {
    Handle,
}

--- This process's standard input.
pub let stdin: Input =
    Input { Handle/stdin };

--- This process's standard output.
pub let stdout: Output =
    Output { Handle/stdout };

--- This process's standard error.
pub let stderr: Output =
    Output { Handle/stderr };

satisfy Io/Read(Input) {
    read(i, n, @positive) = Io/read(@Handle, i.0, n, @positive),
}

satisfy Io/Write(Output) {
    write(o, b) = Io/write(o.0, b),
    flush(o) = Io/flush(o.0),
}
