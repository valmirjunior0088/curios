use /std/{Bool, Option, Eq, Map};
use /std/Bool/{False};
use /std/Map/{Key};
use /std/Set/{Set, empty, insert, remove, union};

--- Whether `k` is an element.
pub let has(@K: Type, use Key(K), s: Set(K), k: K) -> Bool =
    Map/has(s.map, k);

-- Whether an option holds a value, carried across an equation between two options.
let held(
    @A: Type,
    @x: Option(A),
    @y: Option(A),
    e: Eq()(x, y),
) -> Eq()(Option/is_some(x), Option/is_some(y)) =
    Eq/cong((m: Option(A)) => Option/is_some(m), e);

--- The empty set has no element.
pub let of_empty(@K: Type, use Key(K), k: K) -> Eq()(has(empty(), k), false) =
    Eq/refl();

--- `insert` makes its key an element.
pub let of_insert(@K: Type, use Key(K), s: Set(K), k: K) -> Eq()(has(insert(s, k), k), true) =
    held(Map/try_get/of_insert(s.map, k, ()));

--- `insert` leaves every other key as it was.
pub let of_insert_other(
    @K: Type,
    use Key(K),
    s: Set(K),
    k: K,
    other: K,
    apart: (Eq()(other, k)) -> False,
) -> Eq()(has(insert(s, k), other), has(s, other)) =
    held(Map/try_get/of_insert_other(s.map, k, (), other, apart));

--- `remove` makes its key no element.
pub let of_remove(@K: Type, use Key(K), s: Set(K), k: K) -> Eq()(has(remove(s, k), k), false) =
    held(Map/try_get/of_remove(s.map, k));

--- `remove` leaves every other key as it was.
pub let of_remove_other(
    @K: Type,
    use Key(K),
    s: Set(K),
    k: K,
    other: K,
    apart: (Eq()(other, k)) -> False,
) -> Eq()(has(remove(s, k), other), has(s, other)) =
    held(Map/try_get/of_remove_other(s.map, k, other, apart));

-- Whether the first of two options holding a value answers holds one: whether either does.
let either(
    @A: Type,
    x: Option(A),
    y: Option(A),
) -> Eq()(Option/is_some(Option/or(y, x)), Option/is_some(x) || Option/is_some(y)) =
    match y | some(_) => Eq/refl() | none() => Eq/refl() end;

--- An element of `union` is an element of either.
pub let of_union(
    @K: Type,
    use Key(K),
    a: Set(K),
    b: Set(K),
    k: K,
) -> Eq()(has(union(a, b), k), has(a, k) || has(b, k)) =
    Eq/trans(
        held(Map/try_get/of_union(a.map, b.map, k)),
        either(Map/try_get(a.map, k), Map/try_get(b.map, k)));

-- Two options of the unit type that agree on whether they hold a value are one option: the value each holds is `()`.
let held_once(
    x: Option({}),
    y: Option({}),
    e: Eq()(Option/is_some(x), Option/is_some(y)),
) -> Eq()(x, y) =
    match x: (a) => (Eq()(Option/is_some(a), Option/is_some(y))) -> Eq()(a, y)
    | none() =>
        match y: (b) => (Eq()(false, Option/is_some(b))) -> Eq()(Option/none(), b)
        | none() => (_) => Eq/refl()
        | some(_) => (apart) => match Bool/false_neq_true(apart) end
        end
    | some(u) =>
        match y: (b) => (Eq()(true, Option/is_some(b))) -> Eq()(Option/some(u), b)
        | none() => (apart) => match Bool/false_neq_true(Eq/sym(apart)) end
        | some(_) => (_) => Eq/refl()
        end
    end(e);

--- Two sets with the same elements are one set.
pub let extensional(
    @K: Type,
    use Key(K),
    a: Set(K),
    b: Set(K),
    same: (k: K) -> Eq()(has(a, k), has(b, k)),
) -> Eq()(a, b) =
    Eq/cong(
        (m: Map(K, {})) => Set { map = m },
        Map/try_get/injective(a.map, b.map, (k: K) =>
            held_once(Map/try_get(a.map, k), Map/try_get(b.map, k), same(k))));
