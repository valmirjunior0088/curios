use /std/{Io};

--- A host resource the library holds for a program behind a type of its own: a stream, a lookup, a child, a configuration.
pub mod Handle;
pub use Handle/{let Handle};

--- What a host operation answers beside its payload.
pub mod Status;
pub use Status/{let Status};

--- The failure no errno names: what a reply its row rules out is read as, and a write that accepted nothing, as the host names the errno-less failure.
pub let unnamed: Io/Error =
    Io/Error/other(0);

--- An argument refused before any host call, by the errno `/sys/errno` names for it.
pub let invalid: Io/Error =
    Io/Error/other(/sys/errno/inval);
