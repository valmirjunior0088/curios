pub use /sys/{Bytes};
pub use /sys/Bytes/{get, len, eql, slice, replicate, and, or, xor, to_bits};
use /std/{List, Nat, Byte, Bool, Option, Eq, Char, Str, Show, Spell, Ordering, Ord};
use /std/Bool/{True, False, Holds};
use /std/ops/{Eql, Cmp};

--- The byte at `i`, or `none` past the end.
pub let try_get(b: Bytes, i: Nat) -> Option(Byte) =
    match i < len(b) | true => Option/some(get(b, i)) | false => Option/none() end;

--- The minimal encoding of `n`, least-significant byte first as the carrier reads: empty for zero, no trailing zero otherwise, so distinct numbers encode distinctly.
---
--- A direct cons, which is the shape `x[h, ..t]` builds and the shape `to_nat` folds back, so taking one apart is the eliminator's own seam rather than the window at the far one a big-endian snoc would need.
pub let of_nat(n: Nat) -> Bytes =
    match n == 0 | true => x[] | false => x[Nat/to_byte(n % 256), ..of_nat(n / 256)] end;

--- The number a minimal encoding denotes, which is `of_nat`'s inverse.
---
--- One structural fold, because the least significant byte arrives first and carries a weight the fold already knows. Reading a big-endian run back would need the length before it could weigh its first byte.
pub let to_nat(b: Bytes) -> Nat =
    match b | x[] => 0 | x[h, .._]; ih => Byte/to_nat(h) + 256 * ih end;

--- The number a run denotes is below `256` to the run's length.
---
--- What makes [`to_nat`] a bounded reading, so a fixed-width pattern has a fixed range: a float's eight bytes denote a number below `2^64`.
pub let to_nat_below(b: Bytes) -> Holds(to_nat(b) < Nat/pow(256, len(b))) =
    match b: (z) => Holds(to_nat(z) < Nat/pow(256, len(z)))
    | x[] => True/qed()
    | x[h, ..t]; ih =>
        let top: Holds(Byte/to_nat(h) <= 255) = True/qed();
        let _ = ih;
        True/proved()
    end;

-- A cons has no length of zero: the comparison that decides the two lengths refutes the equation.
let no_cons(k: Byte, p: Bytes, e: Eq()(0, len(x[k, ..p]))) -> False =
    Eq/subst((m: Nat) => Holds(0 == m), e, True/qed());

--- Two runs of one length that denote one number are one run: [`to_nat`] is injective at a fixed width.
---
--- Across lengths it is not, a trailing zero byte adding nothing, which is why [`of_nat`] is the minimal encoding. By induction on both runs: the tails' numbers are the quotients by `256` and the heads the remainders, each of which conversion reads off a byte beside a multiple.
pub let to_nat_injective(
    a: Bytes,
    b: Bytes,
    same: Eq()(len(a), len(b)),
    e: Eq()(to_nat(a), to_nat(b)),
) -> Eq()(a, b) =
    match a: (z) =>
        (w: Bytes, same: Eq()(len(z), len(w)), e: Eq()(to_nat(z), to_nat(w))) -> Eq()(z, w)
    | x[] =>
        (w, same, _) =>
            match w
            | x[] => Eq/refl()
            | x[k, ..p] => match no_cons(k, p, same) end
            end
    | x[h, ..t]; ih =>
        (w, same, e) =>
            match w
            | x[] => match no_cons(h, t, Eq/sym(same)) end
            | x[k, ..p] =>
                let tails: Eq()(to_nat(t), to_nat(p)) = Eq/cong((n: Nat) => n / 256, e);
                let heads: Eq()(h, k) = Eq/cong((n: Nat) => Nat/to_byte(n % 256), e);
                let lens: Eq()(len(t), len(p)) = Eq/cong((n: Nat) => n - 1, same);
                let rest: Eq()(t, p) = ih(p, lens, tails);
                Eq/trans(
                    Eq/cong((y: Byte) => x[y, ..t], heads),
                    Eq/cong((q: Bytes) => x[k, ..q], rest))
            end
    end(b, same, e);

-- The recursion `of_nat` performs terminates, which is what lets injectivity recurse the same way.
let high_below(n: Nat, positive: Holds(0 < n)) -> Holds(n / 256 < n) =
    True/proved();

-- A cons taken apart, or `none` for no bytes: one function of the whole value, which congruence needs, and no half invented for the run that has none.
let uncons(z: Bytes) -> Option({Byte, Bytes}) =
    match z | x[] => Option/none() | x[k, ..p] => Option/some((k, p)) end;

--- A cons is injective in its head.
---
--- Read through the cons taken apart above — the byte-grain twin of `/std/Bits`'s own pair, and what lets an encoding built by consing be taken apart again. `/std/Map`'s `Key` witnesses are where that is needed, which is outside this module's subtree.
pub let cons_inj_head(
    @k1: Byte,
    @p1: Bytes,
    @k2: Byte,
    @p2: Bytes,
    e: Eq()(x[k1, ..p1], x[k2, ..p2]),
) -> Eq()(k1, k2) =
    Eq/cong((halves: {Byte, Bytes}) => halves.0, Option/some_injective(Eq/cong(uncons, e)));

--- A cons is injective in its tail.
pub let cons_inj_tail(
    @k1: Byte,
    @p1: Bytes,
    @k2: Byte,
    @p2: Bytes,
    e: Eq()(x[k1, ..p1], x[k2, ..p2]),
) -> Eq()(p1, p2) =
    Eq/cong((halves: {Byte, Bytes}) => halves.1, Option/some_injective(Eq/cong(uncons, e)));

-- An empty encoding is no encoding of a positive number: the lengths differ, and a length of zero against a successor is refuted by the comparison that decides it.
let no_empty(k: Byte, p: Bytes, e: Eq()(x[], x[k, ..p])) -> False =
    Eq/subst((m) => Holds(0 == m), Eq/cong(len, e), True/qed());

--- Distinct numbers encode distinctly.
---
--- Course-of-values induction, because the recursion divides rather than decrements. Each step takes the encoding apart at its first byte, the digit and the rest by the cons's two injections, recovers the two numbers' high parts from the induction hypothesis and their low digits from the byte round trip, and rejoins both by Euclid's recombination.
pub let of_nat_injective(a: Nat, b: Nat, same: Eq()(of_nat(a), of_nat(b))) -> Eq()(a, b) =
    Nat/descend(
        (m: Nat) => m,
        (m) => (d: Nat, e: Eq()(of_nat(m), of_nat(d))) -> Eq()(m, d),
        (n, ih) =>
            (d, e) =>
                match n
                | 0 =>
                    match d
                    | 0 => Eq/refl()
                    | dp + 1 =>
                        match no_empty(Nat/to_byte((dp + 1) % 256), of_nat((dp + 1) / 256), e) end
                    end
                | np + 1 =>
                    match d
                    | 0 =>
                        match no_empty(
                            Nat/to_byte((np + 1) % 256),
                            of_nat((np + 1) / 256),
                            Eq/sym(e))
                        end
                    | dq + 1 =>
                        let heads: Eq()(of_nat((np + 1) / 256), of_nat((dq + 1) / 256)) =
                            cons_inj_tail(e);
                        let digits: Eq()((np + 1) % 256, (dq + 1) % 256) =
                            Eq/cong(Byte/to_nat, cons_inj_head(e));
                        let highs: Eq()((np + 1) / 256, (dq + 1) / 256) =
                            ih((np + 1) / 256, high_below(np + 1, True/qed()))(
                                (dq + 1) / 256,
                                heads);
                        let rejoined: Eq()(
                            256 * ((np + 1) / 256) + (np + 1) % 256,
                            256 * ((dq + 1) / 256) + (dq + 1) % 256) =
                            Eq/subst(
                                (y) =>
                                    Eq()(
                                        256 * ((np + 1) / 256) + (np + 1) % 256,
                                        256 * ((dq + 1) / 256) + y),
                                digits,
                                Eq/subst(
                                    (x) =>
                                        Eq()(
                                            256 * ((np + 1) / 256) + (np + 1) % 256,
                                            256 * x + (np + 1) % 256),
                                    highs,
                                    Eq/refl()));
                        rejoined
                    end
                end,
        a)(b, same);

--- Everything from `k` on, under the evidence that `k` is within the length.
pub let drop(b: Bytes, k: Nat, @ok: Holds(k <= len(b))) -> Bytes =
    slice(b, k, len(b) - k);

--- Every bit of every byte flipped.
---
--- An `xor` against a run of all-ones bytes as long as this one, so the width is a fact about the operand rather than a number written here. `Bytes/len` reduces a fill to its own count, so the equal-length bound the `xor` states discharges without a guard.
pub let not(b: Bytes) -> Bytes =
    xor(b, replicate(len(b), 0xFF));

--- `b` moved `count` bytes toward the high end, zero bytes entering at the low end and whatever passes the top discarded.
---
--- Under the carrier's reading — least significant first, which is what `of_nat` writes — that is multiplication by 256 to the `count`, at the run's own width. A count past the length answers all zeros rather than a shorter run: the width belongs to the value.
---
--- Whole bytes, not bits. A byte string has no finer position to move by, and the bit-granular question is `Bits`'s to answer — `to_bits` is the way across.
pub let shl(b: Bytes, count: Nat) -> Bytes =
    match count <= len(b)
    | true => x[..replicate(count, 0x00), ..slice(b, 0, len(b) - count)]
    | false => replicate(len(b), 0x00)
    end;

--- `b` moved `count` bytes toward the low end, zero bytes entering at the high end.
pub let shr(b: Bytes, count: Nat) -> Bytes =
    match count <= len(b)
    | true => x[..drop(b, count), ..replicate(count, 0x00)]
    | false => replicate(len(b), 0x00)
    end;

--- `b` rotated `count` bytes toward the high end, what passes the top re-entering at the bottom.
---
--- The count is taken modulo the width, which is what makes this total without a guard on the count itself; the empty run is the one case with no width to take it modulo, and rotating it is the identity.
pub let rotl(b: Bytes, count: Nat) -> Bytes =
    match 0 < len(b)
    | true =>
        let keep = len(b) - count % len(b);
        x[..drop(b, keep), ..slice(b, 0, keep)]
    | false => b
    end;

--- `b` rotated `count` bytes toward the low end.
pub let rotr(b: Bytes, count: Nat) -> Bytes =
    match 0 < len(b)
    | true =>
        let places = count % len(b);
        x[..drop(b, places), ..slice(b, 0, places)]
    | false => b
    end;

--- The concatenation, in order.
pub let flatten(parts: List(Bytes)) -> Bytes =
    List/fold(parts, x[], (b, acc) => x[..acc, ..b]);

--- Left to right with `f(byte, acc)`.
pub let fold(@A: Type, b: Bytes, init: A, f: (Byte, A) -> A) -> A =
    let go(z: Bytes, acc: A) -> A = match z | x[] => acc | x[h, ..t] => go(t, f(h, acc)) end;
    go(b, init);

--- The index of the first byte `pred` accepts, or `none`.
pub let find_index(b: Bytes, pred: (Byte) -> Bool) -> Option(Nat) =
    let (_, found): {Nat, Option(Nat)} =
        fold(
            b,
            (0, Option/none()),
            (byte, (i, found)) =>
                match found
                | some(_) => (i, found)
                | none() =>
                    (i + 1, match pred(byte) | true => Option/some(i) | false => Option/none() end)
                end);
    found;

--- The index of the first byte equal to `x`, or `none`.
pub let index_of(b: Bytes, x: Byte) -> Option(Nat) =
    find_index(b, (y) => y == x);

--- Whether `x` occurs in `b`.
pub let contains(b: Bytes, x: Byte) -> Bool =
    Option/is_some(index_of(b, x));

--- Whether `pred` accepts every byte of `b`, which it does of none. It is the fold over `b` itself, so over a byte and the bytes after it it reduces to the byte's answer and the rest's: what a proof about a byte put in front reads.
pub let all(b: Bytes, pred: (Byte) -> Bool) -> Bool =
    match b | x[] => true | x[h, .._]; rest => pred(h) && rest end;

--- `parts` with `sep` between each pair.
pub let join(sep: Bytes, parts: List(Bytes)) -> Bytes =
    List/balanced(
        List/len(parts),
        x[],
        (i, ok) => List/get(@Bytes, parts, i, @ok),
        (l, r) => x[..l, ..sep, ..r]);

--- The order of two byte strings, bytewise with a proper prefix first, and its laws.
pub mod ord;
pub use ord/{let ord};

satisfy Eql(Bytes) {
    eql = eql,
    neq(a, b) = Bool/not(eql(a, b)),
}

satisfy Cmp(Bytes) {
    lt(a, b) = Ordering/is_lt(ord(a, b)),
    le(a, b) = Ordering/is_le(ord(a, b)),
    gt(a, b) = Ordering/is_gt(ord(a, b)),
    ge(a, b) = Ordering/is_ge(ord(a, b)),
}

satisfy Ord(Bytes) {
    ord = ord,
}

--- Hexadecimal, two digits per byte.
satisfy Show(Bytes) {
    show(b) =
        Str/flatten(
            fold(
                b,
                [],
                (byte, acc) =>
                    let n = Byte/to_nat(byte);
                    [
                        ..acc,
                        Str/of_char(Char/hex_digit(n / 0x10)),
                        Str/of_char(Char/hex_digit(n % 0x10))])),
}

satisfy Spell(Bytes) {
    spell(b) =
        let parts = fold(b, [], (byte, acc) => [..acc, Nat/to_str(Byte/to_nat(byte))]);
        Str/concat("x[", Str/concat(Str/join(", ", parts), "]")),
}
