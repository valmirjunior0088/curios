use /std/{Nat, Bool, Option};
use /std/Bool/{True, Holds};

--- Whether `code` is a Unicode scalar value: a code point up to `U+10FFFF` outside the surrogate range.
let of(code: Nat) -> Bool =
    code < 0xD800 || code >= 0xE000 && code <= 0x10FFFF;

--- That `code` is a Unicode scalar value, which is what `Char` carries.
---
--- Decided, so a literal or a guard already taken discharges it by reduction.
pub let Valid(code: Nat) -> Prop =
    Holds(of(code));

--- A code below the surrogates is a scalar value.
pub let below_surrogates(code: Nat, p: Holds(code < 0xD800)) -> Valid(code) =
    match code < 0xD800
    | true => True/qed()
    | false => match p end
    end;

--- A code past the surrogates and at most `U+10FFFF` is a scalar value.
pub let above_surrogates(
    code: Nat,
    low: Holds(0xE000 <= code),
    high: Holds(code <= 0x10FFFF),
) -> Valid(code) =
    match code < 0xD800
    | true => True/qed()
    | false =>
        match code >= 0xE000
        | true => high
        | false => match low end
        end
    end;

--- A scalar value is at most `U+10FFFF`.
pub let at_most(code: Nat, valid: Valid(code)) -> Holds(code <= 0x10FFFF) =
    match code < 0xD800
    | true => True/proved()
    | false =>
        match code >= 0xE000
        | true => valid
        | false => match valid end
        end
    end;

--- A scalar value below the end of the surrogates is below their start.
pub let below_surrogates_of(
    code: Nat,
    valid: Valid(code),
    below_end: Holds(code < 0xE000),
) -> Holds(code < 0xD800) =
    match code < 0xD800
    | true => True/qed()
    | false =>
        match code >= 0xE000
        | true => match below_end end
        | false => match valid end
        end
    end;

--- The evidence that `code` is a Unicode scalar value, or `none`.
pub let try(code: Nat) -> Option(Valid(code)) =
    match of(code): (r) => Option(Holds(r))
    | true => Option/some(True/qed())
    | false => Option/none()
    end;
