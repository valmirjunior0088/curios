use /std/{Nat, Bool, Option, List, Eq, Hash, Bytes};
use /std/Bool/{True, False, Holds};
use /std/List/{Member};
use /std/Map/{Map, Key, Rooted, Grounded, grounded, empty, insert, remove, map, union, filter,
    update, to_list};
use /std/Map/internal/{Node};
use /std/Map/bits/{bit, Apart};

--- The value at `key`, or `none`.
pub let try_get(@K: Type, use Key(K), @V: Type, m: Map(K, V), key: K) -> Option(V) =
    match m.root | none() => Option/none() | some(n) => Node/find(n, Hash/hash(key)) end;

-- Two keys the one is not the other of encode apart.
let apart_codes(
    @K: Type,
    use Key(K),
    key: K,
    other: K,
    apart: (Eq()(other, key)) -> False,
) -> Eq()(Hash/hash(key) == Hash/hash(other), false) =
    match Hash/hash(key) == Hash/hash(other)
    | false => Eq/refl()
    | true =>
        match apart(
            Eq/sym(
                Key/injective(
                    key,
                    other,
                    Bytes/eq_of_eql(Hash/hash(key), Hash/hash(other), True/qed()))))
        end
    end;

-- What a node answering `x` at `key`'s encoding in place of `n` answers at another key's: what `n` does.
let elsewhere(
    @K: Type,
    use Key(K),
    @V: Type,
    n: Node(K, V),
    n2: Node(K, V),
    key: K,
    x: Option(V),
    other: K,
    codes: Eq()(Hash/hash(key) == Hash/hash(other), false),
    answers: Node/Answers(n2, n, Hash/hash(key), x),
) -> Eq()(Node/find(n2, Hash/hash(other)), Node/find(n, Hash/hash(other))) =
    Eq/trans(
        answers(Hash/hash(other)),
        Eq/subst(
            (b: Bool) =>
                Eq()(
                    match b | true => x | false => Node/find(n, Hash/hash(other)) end,
                    Node/find(n, Hash/hash(other))),
            Eq/sym(codes),
            Eq/refl()));

-- The leaf an insertion wedges in above the node it parted from answers its value at its key in that node's place.
let parted_answers(
    @K: Type,
    use Key(K),
    @V: Type,
    n: Node(K, V),
    n2: Node(K, V),
    key: K,
    v: V,
    c: Nat,
    back: Eq()(n2, n),
    sound: Node/Sound(n),
    apart: Apart(Hash/hash(key), Node/first(n), c),
    past: Holds(Node/deeper(n, c)),
) -> Node/Answers(
    Node/wedge(c, bit(Hash/hash(key), c), key, v, n2),
    n,
    Hash/hash(key),
    Option/some(v)) =
    Eq/subst(
        (t: Node(K, V)) =>
            Node/Answers(
                Node/wedge(c, bit(Hash/hash(key), c), key, v, t),
                n,
                Hash/hash(key),
                Option/some(v)),
        Eq/sym(back),
        Node/wedge_answers(c, key, Hash/hash(key), v, n, Eq/refl(), sound, apart, past));

--- The empty map has no value at any key.
pub let of_empty(
    @K: Type,
    use Key(K),
    @V: Type,
    key: K,
) -> Eq()(try_get(empty(), key), Option/none(@V)) =
    Eq/refl();

--- `insert` sets the value at its key.
pub let of_insert(
    @K: Type,
    use Key(K),
    @V: Type,
    m: Map(K, V),
    key: K,
    v: V,
) -> Eq()(try_get(insert(m, key, v), key), Option/some(v)) =
    match m.root
    | none() => Eq/refl()
    | some(n) =>
        match Node/insert(n, key, Hash/hash(key), v, @Eq/refl(), @grounded(m.rooted))
        | added(_, @_, @answers) => answers(Hash/hash(key))
        | replaced(_, @_, @answers) => answers(Hash/hash(key))
        | parted(n2, c, @back, @apart, @past) =>
            parted_answers(n, n2, key, v, c, back, grounded(m.rooted), apart, past)(Hash/hash(key))
        end
    end;

--- `insert` leaves the value at every other key as it was.
pub let of_insert_other(
    @K: Type,
    use Key(K),
    @V: Type,
    m: Map(K, V),
    key: K,
    v: V,
    other: K,
    apart: (Eq()(other, key)) -> False,
) -> Eq()(try_get(insert(m, key, v), other), try_get(m, other)) =
    let codes = apart_codes(key, other, apart);
    match m.root
    | none() =>
        Eq/subst(
            (b: Bool) =>
                Eq()(
                    match b | true => Option/some(v) | false => Option/none() end,
                    Option/none(@V)),
            Eq/sym(codes),
            Eq/refl())
    | some(n) =>
        match Node/insert(n, key, Hash/hash(key), v, @Eq/refl(), @grounded(m.rooted))
        | added(n2, @_, @answers) => elsewhere(n, n2, key, Option/some(v), other, codes, answers)
        | replaced(n2, @_, @answers) => elsewhere(n, n2, key, Option/some(v), other, codes, answers)
        | parted(n2, c, @back, @apart, @past) =>
            elsewhere(
                n,
                Node/wedge(c, bit(Hash/hash(key), c), key, v, n2),
                key,
                Option/some(v),
                other,
                codes,
                parted_answers(n, n2, key, v, c, back, grounded(m.rooted), apart, past))
        end
    end;

--- `remove` leaves no value at its key.
pub let of_remove(
    @K: Type,
    use Key(K),
    @V: Type,
    m: Map(K, V),
    key: K,
) -> Eq()(try_get(remove(m, key), key), Option/none(@V)) =
    match m.root
    | none() => Eq/refl()
    | some(n) =>
        match Node/remove(n, Hash/hash(key), @grounded(m.rooted))
        | gone(_) => Eq/refl()
        | kept(_, @_, @answers) => answers(Hash/hash(key))
        | absent(answers) => answers(Hash/hash(key))
        end
    end;

--- `remove` leaves the value at every other key as it was.
pub let of_remove_other(
    @K: Type,
    use Key(K),
    @V: Type,
    m: Map(K, V),
    key: K,
    other: K,
    apart: (Eq()(other, key)) -> False,
) -> Eq()(try_get(remove(m, key), other), try_get(m, other)) =
    let codes = apart_codes(key, other, apart);
    match m.root
    | none() => Eq/refl()
    | some(n) =>
        match Node/remove(n, Hash/hash(key), @grounded(m.rooted))
        | gone(empty) =>
            Eq/sym(
                Eq/subst(
                    (b: Bool) =>
                        Eq()(
                            match b
                            | true => Option/none()
                            | false => Node/find(n, Hash/hash(other))
                            end,
                            Option/none(@V)),
                    codes,
                    empty(Hash/hash(other))))
        | kept(n2, @_, @answers) => elsewhere(n, n2, key, Option/none(), other, codes, answers)
        | absent(_) => Eq/refl()
        end
    end;

--- `map` rewrites the value at every key.
pub let of_map(
    @K: Type,
    use Key(K),
    @V: Type,
    @W: Type,
    m: Map(K, V),
    f: (V) -> W,
    key: K,
) -> Eq()(try_get(map(m, f), key), Option/map(try_get(m, key), f)) =
    match m.root | none() => Eq/refl() | some(n) => Node/mapped_find(n, f, Hash/hash(key)) end;

-- What a root finds at a key.
let found_in(@K: Type, use Key(K), @V: Type, r: Option(Node(K, V)), x: K) -> Option(V) =
    match r | none() => Option/none() | some(n) => Node/find(n, Hash/hash(x)) end;

-- A sound root holding a node finds a value at its least key, which no empty root does.
let held(
    @K: Type,
    use Key(K),
    @V: Type,
    n: Node(K, V),
    sound: Node/Sound(n),
    same: Eq()(Option/none(@V), Node/find(n, Hash/hash(Node/least(n).0))),
) -> False =
    match Eq/subst(
        (o: Option(V)) => Holds(Option/is_none(o)),
        Eq/trans(same, Node/found(n, sound, Node/least(n).0, Node/least_among(n))),
        True/qed())
    end;

-- Two sound roots that find alike at every key are one root.
let roots(
    @K: Type,
    use Key(K),
    @V: Type,
    r1: Option(Node(K, V)),
    r2: Option(Node(K, V)),
    g1: Grounded(r1),
    g2: Grounded(r2),
    same: (x: K) -> Eq()(found_in(r1, x), found_in(r2, x)),
) -> Eq()(r1, r2) =
    match r1
    | none() =>
        match r2
        | none() => Eq/refl()
        | some(n) => match held(n, g2, same(Node/least(n).0)) end
        end
    | some(n1) =>
        match r2
        | none() => match held(n1, g1, Eq/sym(same(Node/least(n1).0))) end
        | some(n2) =>
            Eq/cong((n: Node(K, V)) => Option/some(n), Node/canonical(n1, n2, g1, g2, same))
        end
    end;

-- Two maps with one root are one map: what else a map holds is the proof about its root.
let of_root(
    @K: Type,
    use Key(K),
    @V: Type,
    a: Map(K, V),
    b: Map(K, V),
    e: Eq()(a.root, b.root),
) -> Eq()(a, b) =
    Eq/subst(
        (r: Option(Node(K, V))) => (w: Rooted(K, V)(r)) -> Eq()(a, Map { root = r, @rooted = w }),
        e,
        (_) => Eq/refl())(
        b.rooted);

--- Two maps with the same value at every key are one map.
---
--- A map's trie is a function of its entries: the bit a sound fork tests is the first its keys differ at, and which side holds a key is that key's bit there. So a proof about a map binds to what it holds, and two maps built in different orders, or by different operations, are equal where they agree at every key.
pub let injective(
    @K: Type,
    use Key(K),
    @V: Type,
    a: Map(K, V),
    b: Map(K, V),
    same: (key: K) -> Eq()(try_get(a, key), try_get(b, key)),
) -> Eq()(a, b) =
    of_root(a, b, roots(a.root, b.root, grounded(a.rooted), grounded(b.rooted), same));

-- Two keys whose encodings compare equal, as an equation, are one key.
let same_key(
    @K: Type,
    use Key(K),
    a: K,
    b: K,
    e: Eq()(Hash/hash(a) == Hash/hash(b), true),
) -> Eq()(a, b) =
    Key/same(a, b, Bool/holds_of_eq(Hash/hash(a) == Hash/hash(b), e));

-- Two keys whose encodings compare unequal, as an equation, are two keys.
let other_key(
    @K: Type,
    use Key(K),
    a: K,
    b: K,
    e: Eq()(Hash/hash(a) == Hash/hash(b), false),
) -> (Eq()(b, a)) -> False =
    Key/apart(a, b, Eq/subst((c: Bool) => Holds(Bool/not(c)), Eq/sym(e), True/qed()));

-- Inserting a sound node's entries into a map one by one leaves at a key the node's value there, and the map's where the node has none.
let inserted_all(
    @K: Type,
    use Key(K),
    @V: Type,
    n: Node(K, V),
    sound: Node/Sound(n),
    acc: Map(K, V),
    key: K,
) -> Eq()(
    try_get(Node/fold(n, acc, (k: K, v: V, m: Map(K, V)) => insert(m, k, v)), key),
    Option/or(Node/find(n, Hash/hash(key)), try_get(acc, key))) =
    match n
    | leaf(k0, v0) =>
        let cases(
            b: Bool,
            e: Eq()(Hash/hash(k0) == Hash/hash(key), b),
        ) -> Eq()(
            try_get(insert(acc, k0, v0), key),
            Option/or(
                match b | true => Option/some(v0) | false => Option/none() end,
                try_get(acc, key))) =
            match b
            | true =>
                Eq/subst(
                    (y: K) => Eq()(try_get(insert(acc, k0, v0), y), Option/some(v0)),
                    same_key(k0, key, e),
                    of_insert(acc, k0, v0))
            | false => of_insert_other(acc, k0, v0, key, other_key(k0, key, e))
            end;
        cases(Hash/hash(k0) == Hash/hash(key), Eq/refl())
    | fork(c, z, o) =>
        Eq/trans(
            inserted_all(
                o,
                sound.one,
                Node/fold(z, acc, (k: K, v: V, m: Map(K, V)) => insert(m, k, v)),
                key),
            Eq/trans(
                Eq/cong(
                    (x: Option(V)) => Option/or(Node/find(o, Hash/hash(key)), x),
                    inserted_all(z, sound.zero, acc, key)),
                Node/either_side(
                    c,
                    z,
                    o,
                    sound,
                    Hash/hash(key),
                    (x: Option(V), r: Option(V)) => Option/or(x, r),
                    (_) => Eq/refl(),
                    try_get(acc, key))))
    end;

--- `union` has at every key the second map's value, and the first's where the second has none.
pub let of_union(
    @K: Type,
    use Key(K),
    @V: Type,
    a: Map(K, V),
    b: Map(K, V),
    key: K,
) -> Eq()(try_get(union(a, b), key), Option/or(try_get(b, key), try_get(a, key))) =
    match b.root | none() => Eq/refl() | some(n) => inserted_all(n, grounded(b.rooted), a, key) end;

-- What `filter`'s step keeps of a value found at `key`, over what the map it began with has there.
let kept(
    @V: Type,
    @K: Type,
    pred: (K, V) -> Bool,
    key: K,
    found: Option(V),
    rest: Option(V),
) -> Option(V) =
    match found
    | some(v) => match pred(key, v) | true => Option/some(v) | false => rest end
    | none() => rest
    end;

-- Inserting the entries of a sound node `pred` accepts into a map one by one leaves at a key the node's value there where `pred` accepts it, and the map's otherwise.
let kept_all(
    @K: Type,
    use Key(K),
    @V: Type,
    n: Node(K, V),
    sound: Node/Sound(n),
    pred: (K, V) -> Bool,
    acc: Map(K, V),
    key: K,
) -> Eq()(
    try_get(
        Node/fold(n, acc, (k: K, v: V, m: Map(K, V)) =>
            match pred(k, v) | true => insert(m, k, v) | false => m end),
        key),
    kept(pred, key, Node/find(n, Hash/hash(key)), try_get(acc, key))) =
    match n
    | leaf(k0, v0) =>
        let cases(
            b: Bool,
            e: Eq()(Hash/hash(k0) == Hash/hash(key), b),
        ) -> Eq()(
            try_get(match pred(k0, v0) | true => insert(acc, k0, v0) | false => acc end, key),
            kept(
                pred,
                key,
                match b | true => Option/some(v0) | false => Option/none() end,
                try_get(acc, key))) =
            match b
            | true =>
                let at_key: Eq()(
                    try_get(
                        match pred(key, v0) | true => insert(acc, key, v0) | false => acc end,
                        key),
                    kept(pred, key, Option/some(v0), try_get(acc, key))) =
                    match pred(key, v0) | true => of_insert(acc, key, v0) | false => Eq/refl() end;
                Eq/subst(
                    (y: K) =>
                        Eq()(
                            try_get(
                                match pred(y, v0) | true => insert(acc, y, v0) | false => acc end,
                                key),
                            kept(pred, key, Option/some(v0), try_get(acc, key))),
                    Eq/sym(same_key(k0, key, e)),
                    at_key)
            | false =>
                match pred(k0, v0)
                | true => of_insert_other(acc, k0, v0, key, other_key(k0, key, e))
                | false => Eq/refl()
                end
            end;
        cases(Hash/hash(k0) == Hash/hash(key), Eq/refl())
    | fork(c, z, o) =>
        Eq/trans(
            kept_all(
                o,
                sound.one,
                pred,
                Node/fold(z, acc, (k: K, v: V, m: Map(K, V)) =>
                    match pred(k, v) | true => insert(m, k, v) | false => m end),
                key),
            Eq/trans(
                Eq/cong(
                    (x: Option(V)) => kept(pred, key, Node/find(o, Hash/hash(key)), x),
                    kept_all(z, sound.zero, pred, acc, key)),
                Node/either_side(
                    c,
                    z,
                    o,
                    sound,
                    Hash/hash(key),
                    (x: Option(V), r: Option(V)) => kept(pred, key, x, r),
                    (_) => Eq/refl(),
                    try_get(acc, key))))
    end;

--- `filter` has at every key the value there where `pred` accepts it, and none otherwise.
pub let of_filter(
    @K: Type,
    use Key(K),
    @V: Type,
    m: Map(K, V),
    pred: (K, V) -> Bool,
    key: K,
) -> Eq()(try_get(filter(m, pred), key), Option/filter(try_get(m, key), (v: V) => pred(key, v))) =
    match m.root
    | none() => Eq/refl()
    | some(n) => kept_all(n, grounded(m.rooted), pred, empty(), key)
    end;

--- `update` sets the value at its key to what `f` answers of the value there.
pub let of_update(
    @K: Type,
    use Key(K),
    @V: Type,
    m: Map(K, V),
    key: K,
    f: (Option(V)) -> Option(V),
) -> Eq()(try_get(update(m, key, f), key), f(try_get(m, key))) =
    match f(try_get(m, key)) | some(v) => of_insert(m, key, v) | none() => of_remove(m, key) end;

--- `update` leaves the value at every other key as it was.
pub let of_update_other(
    @K: Type,
    use Key(K),
    @V: Type,
    m: Map(K, V),
    key: K,
    f: (Option(V)) -> Option(V),
    other: K,
    apart: (Eq()(other, key)) -> False,
) -> Eq()(try_get(update(m, key, f), other), try_get(m, other)) =
    match f(try_get(m, key))
    | some(v) => of_insert_other(m, key, v, other, apart)
    | none() => of_remove_other(m, key, other, apart)
    end;

-- A map's entries in order are its root's.
let entries_of(
    @K: Type,
    use Key(K),
    @V: Type,
    m: Map(K, V),
) -> Eq()(to_list(m), match m.root | none() => [] | some(n) => Node/entries(n) end) =
    match m.root | none() => Eq/refl() | some(n) => Node/listed(n, []) end;

--- An entry `to_list` holds is the value at its key.
pub let of_listed(
    @K: Type,
    use Key(K),
    @V: Type,
    m: Map(K, V),
    key: K,
    v: V,
    listed: Member()((key, v), to_list(m)),
) -> Eq()(try_get(m, key), Option/some(v)) =
    let held = Eq/subst((l: List({K, V})) => Member()((key, v), l), entries_of(m), listed);
    match m.root
    | none() => match Member/absent(held) end
    | some(n) => Node/entry_found(n, grounded(m.rooted), (key, v), held)
    end;

--- The value at a key is an entry `to_list` holds.
pub let listed(
    @K: Type,
    use Key(K),
    @V: Type,
    m: Map(K, V),
    key: K,
    v: V,
    found: Eq()(try_get(m, key), Option/some(v)),
) -> Member()((key, v), to_list(m)) =
    Eq/subst(
        (l: List({K, V})) => Member()((key, v), l),
        Eq/sym(entries_of(m)),
        match m.root
        | none() =>
            match Eq/subst((o: Option(V)) => Holds(Option/is_none(o)), found, True/qed()) end
        | some(n) => Node/found_entry(n, key, v, found)
        end);
