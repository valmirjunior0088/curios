use /std/{Nat, Byte, Bytes, Bool, Eq, Ordering, proved};

--- The bit of `k` in its byte `g` at place `o` of nine: place zero says the byte is there, and the eight after it are the byte's own from its top. A byte the run does not have has every place clear, so a run that ends is below every run that goes on.
pub let at_place(k: Bytes, g: Nat, o: Nat) -> Bool =
    match g < Bytes/len(k)
    | false => false
    | true =>
        match o == 0
        | true => true
        | false => Nat/and(Nat/shr(Byte/to_nat(Bytes/get(k, g)), 8 - o), 1) != 0
        end
    end;

--- The bit of `k` at `j`, nine to a byte.
pub let bit(k: Bytes, j: Nat) -> Bool =
    at_place(k, j / 9, j % 9);

--- Where two runs part: nowhere, or at a bit.
pub induct Parted: pub Type
| same()
| at(Nat)
end

-- The place, of a byte's eight from its top, at which two bytes that differ first do: a ladder of shifts, each by a literal.
let place(x: Nat, y: Nat) -> Nat =
    choose
    | Nat/shr(x, 7) != Nat/shr(y, 7) => 1
    | Nat/shr(x, 6) != Nat/shr(y, 6) => 2
    | Nat/shr(x, 5) != Nat/shr(y, 5) => 3
    | Nat/shr(x, 4) != Nat/shr(y, 4) => 4
    | Nat/shr(x, 3) != Nat/shr(y, 3) => 5
    | Nat/shr(x, 2) != Nat/shr(y, 2) => 6
    | Nat/shr(x, 1) != Nat/shr(y, 1) => 7
    | _ => 8
    end;

-- Where `a` and `b` first differ, their bytes counted from `g`.
let parts(a: Bytes, b: Bytes, g: Nat) -> Parted =
    match a
    | x[] => match b | x[] => Parted/same() | x[_, .._] => Parted/at(9 * g) end
    | x[h, ..t] =>
        match b
        | x[] => Parted/at(9 * g)
        | x[k, ..r] =>
            match h == k
            | true => parts(t, r, g + 1)
            | false => Parted/at(9 * g + place(Byte/to_nat(h), Byte/to_nat(k)))
            end
        end
    end;

--- The first bit two runs differ at, or that they are one run: the place a byte is there in one and not in the other, or the place two bytes first differ at.
---
--- A walk on the two runs' structure, so a type may name it.
pub let crit(a: Bytes, b: Bytes) -> Parted =
    parts(a, b, 0);

-- The low bit of `x` shifted right `k` places.
let low(x: Nat, k: Nat) -> Nat =
    Nat/and(Nat/shr(x, k), 1);

-- A shift is twice the next and its low bit, which is at most one.
let halves(x: Nat) -> (Nat) -> Bool =
    (k) => Nat/shr(x, k) == 2 * Nat/shr(x, k + 1) + low(x, k) && low(x, k) <= 1;

let every(x: Nat) -> Bool =
    Nat/all_below(8, halves(x)) && Nat/shr(x, 8) == 0;

-- Of every byte, at each of its eight places, decided by running it.
let table: Bool/Holds(Nat/all_below(256, every)) =
    Bool/True/qed();

let halved(
    x: Nat,
    k: Nat,
    small: Bool/Holds(x < 256),
    place: Bool/Holds(k < 8),
) -> Bool/Holds(halves(x)(k)) =
    Nat/all_below/at(
        8,
        halves(x),
        k,
        Bool/and/first(
            Nat/all_below(8, halves(x)),
            Nat/shr(x, 8) == 0,
            Nat/all_below/at(256, every, x, table, small)),
        place);

-- A byte's shift is twice the next and its low bit.
let split(
    x: Nat,
    k: Nat,
    small: Bool/Holds(x < 256),
    place: Bool/Holds(k < 8),
) -> Bool/Holds(Nat/shr(x, k) == 2 * Nat/shr(x, k + 1) + low(x, k)) =
    Bool/and/first(
        Nat/shr(x, k) == 2 * Nat/shr(x, k + 1) + low(x, k),
        low(x, k) <= 1,
        halved(x, k, small, place));

-- A low bit is at most one.
let single(
    x: Nat,
    k: Nat,
    small: Bool/Holds(x < 256),
    place: Bool/Holds(k < 8),
) -> Bool/Holds(low(x, k) <= 1) =
    Bool/and/second(
        Nat/shr(x, k) == 2 * Nat/shr(x, k + 1) + low(x, k),
        low(x, k) <= 1,
        halved(x, k, small, place));

-- A byte shifted eight places is nothing.
let spent(x: Nat, small: Bool/Holds(x < 256)) -> Bool/Holds(Nat/shr(x, 8) == 0) =
    Bool/and/second(
        Nat/all_below(8, halves(x)),
        Nat/shr(x, 8) == 0,
        Nat/all_below/at(256, every, x, table, small));

-- The shift below `k` at which two bytes first differ from the top, zero where none does: what a proof reads `place` as, a recursion where the ladder is eight literals.
let seek(x: Nat, y: Nat, k: Nat) -> Nat =
    match k
    | 0 => 0
    | j + 1 => match Nat/shr(x, j) != Nat/shr(y, j) | true => j | false => seek(x, y, j) end
    end;

-- The ladder answers the place of the shift `seek` finds, rung by rung.
let rungs(x: Nat, y: Nat) -> Eq()(place(x, y), 7 - seek(x, y, 8) + 1) =
    match Nat/shr(x, 7) != Nat/shr(y, 7)
    | true => Eq/refl()
    | false =>
        match Nat/shr(x, 6) != Nat/shr(y, 6)
        | true => Eq/refl()
        | false =>
            match Nat/shr(x, 5) != Nat/shr(y, 5)
            | true => Eq/refl()
            | false =>
                match Nat/shr(x, 4) != Nat/shr(y, 4)
                | true => Eq/refl()
                | false =>
                    match Nat/shr(x, 3) != Nat/shr(y, 3)
                    | true => Eq/refl()
                    | false =>
                        match Nat/shr(x, 2) != Nat/shr(y, 2)
                        | true => Eq/refl()
                        | false =>
                            match Nat/shr(x, 1) != Nat/shr(y, 1)
                            | true => Eq/refl()
                            | false =>
                                match Nat/shr(x, 0) != Nat/shr(y, 0)
                                | true => Eq/refl()
                                | false => Eq/refl()
                                end
                            end
                        end
                    end
                end
            end
        end
    end;

-- What `seek` finds of two bytes that differ: a shift below eight at which their low bits differ, with every shift above it the same in both.
struct Sought(x: Nat, y: Nat, j: Nat): Prop {
    within: Bool/Holds(j < 8),
    above: (m: Nat, over: Bool/Holds(j < m), within: Bool/Holds(m <= 8)) -> Eq()(
        Nat/shr(x, m),
        Nat/shr(y, m)),
    differs: Bool/Holds(low(x, j) != low(y, j)),
}

let sought(
    x: Nat,
    y: Nat,
    k: Nat,
    small_x: Bool/Holds(x < 256),
    small_y: Bool/Holds(y < 256),
    bound: Bool/Holds(k <= 8),
    above: (m: Nat, over: Bool/Holds(k <= m), within: Bool/Holds(m <= 8)) -> Eq()(
        Nat/shr(x, m),
        Nat/shr(y, m)),
    apart: Bool/Holds(x != y),
) -> Sought(x, y, seek(x, y, k)) =
    match k: (n) =>
        (
            bound: Bool/Holds(n <= 8),
            above: (m: Nat, over: Bool/Holds(n <= m), within: Bool/Holds(m <= 8)) -> Eq()(
                Nat/shr(x, m),
                Nat/shr(y, m))) -> Sought(x, y, seek(x, y, n))
    | 0 =>
        (_, above) =>
            match Eq/subst(
                (v: Nat) => Bool/Holds(x != v),
                Eq/sym(above(0, Bool/True/qed(), Bool/True/qed())),
                apart)
            end
    | j + 1; ih =>
        (bound, above) =>
            match Nat/shr(x, j) != Nat/shr(y, j)
            | true =>
                Sought {
                    within = proved(),
                    above = (m, over, within) => above(m, proved(), within),
                    differs =
                        match low(x, j) != low(y, j)
                        | true => Bool/True/qed()
                        | false =>
                            let same_low: Bool/Holds(low(x, j) == low(y, j)) = Bool/True/qed();
                            let same_next: Bool/Holds(Nat/shr(x, j + 1) == Nat/shr(y, j + 1)) =
                                Eq/subst(
                                    (v: Nat) => Bool/Holds(Nat/shr(x, j + 1) == v),
                                    above(j + 1, Bool/True/qed(), proved()),
                                    Bool/True/qed());
                            let left = split(x, j, small_x, proved());
                            let right = split(y, j, small_y, proved());
                            match Eq/subst(
                                (v: Nat) => Bool/Holds(Nat/shr(x, j) != v),
                                Nat/le/antisym(Nat/shr(y, j), Nat/shr(x, j), proved(), proved()),
                                Bool/True/qed())
                            end
                        end }
            | false =>
                ih(
                    proved(),
                    (m, over, within) =>
                        match j < m
                        | true => above(m, Bool/True/qed(), within)
                        | false =>
                            Eq/subst(
                                (v: Nat) => Eq()(Nat/shr(x, v), Nat/shr(y, v)),
                                Nat/le/antisym(j, m, over, proved()),
                                Nat/eq_of_eql(Nat/shr(x, j), Nat/shr(y, j), Bool/True/qed()))
                        end)
            end
    end(bound, above);

-- A bit nine places on or more is a bit of the run past its first byte.
let onward(
    h: Byte,
    t: Bytes,
    j: Nat,
    over: Bool/Holds(9 <= j),
) -> Eq()(bit(x[h, ..t], j), bit(t, j - 9)) =
    Eq/subst(
        (v: Nat) => Eq()(bit(x[h, ..t], v), bit(t, j - 9)),
        Nat/le/add_sub_cancel(9, j, over),
        Eq/refl());

-- A bit below nine is its place in the first byte.
let inward(k: Bytes, j: Nat, under: Bool/Holds(j < 9)) -> Eq()(bit(k, j), at_place(k, 0, j)) =
    let first: Bool/Holds(j / 9 < 1) = Nat/DivMod/div_lt_of_lt_mul(1, j, 9, proved());
    Eq/subst(
        (v: Nat) => Eq()(at_place(k, j / 9, v), at_place(k, 0, j)),
        Nat/le/antisym(j, j % 9, proved(), proved()),
        Eq/subst(
            (v: Nat) => Eq()(at_place(k, v, j), at_place(k, 0, j)),
            Nat/le/antisym(0, j / 9, Bool/True/qed(), proved()),
            Eq/refl()));

--- Two runs apart at the bit `c`: the first bit they differ at.
pub struct Apart(a: Bytes, b: Bytes, c: Nat): pub Prop {
    --- They agree at every bit below it.
    below: (j: Nat, under: Bool/Holds(j < c)) -> Eq()(bit(a, j), bit(b, j)),
    --- They differ at it.
    differs: Bool/Holds(bit(a, c) != bit(b, c)),
}

-- What a walk that began at byte `g` found at `c`: a bit at or past the walk's start, the runs apart at it counted from there.
struct Shifted(a: Bytes, b: Bytes, g: Nat, c: Nat): Prop {
    over: Bool/Holds(9 * g <= c),
    apart: Apart(a, b, c - 9 * g),
}

-- What `parts` answers is true of the runs: nowhere says they are one run, and a bit that they are apart at it.
let Found(a: Bytes, b: Bytes, g: Nat, found: Parted) -> Prop =
    match found | same() => Eq()(a, b) | at(c) => Shifted(a, b, g, c) end;

-- Two runs led by one byte agree at every bit of it.
let led(
    h: Byte,
    t: Bytes,
    r: Bytes,
    j: Nat,
    under: Bool/Holds(j < 9),
) -> Eq()(bit(x[h, ..t], j), bit(x[h, ..r], j)) =
    Eq/trans(inward(x[h, ..t], j, under), Eq/sym(inward(x[h, ..r], j, under)));

-- Two runs apart past a shared first byte are apart nine bits on.
let lifted(
    h: Byte,
    t: Bytes,
    r: Bytes,
    p: Nat,
    apart: Apart(t, r, p),
) -> Apart(x[h, ..t], x[h, ..r], p + 9) =
    Apart {
        below =
            (j, under) =>
                match j < 9
                | true => led(h, t, r, j, Bool/True/qed())
                | false =>
                    Eq/trans(
                        onward(h, t, j, proved()),
                        Eq/trans(apart.below(j - 9, proved()), Eq/sym(onward(h, r, j, proved()))))
                end,
        differs = apart.differs };

-- A number that is not zero is above it.
let positive(x: Nat, apart: Bool/Holds(x != 0)) -> Bool/Holds(0 < x) =
    match x
    | 0 => match apart end
    | _ + 1 => Bool/True/qed()
    end;

-- Two bytes whose shifts agree at a place and at the next have one low bit there.
let lows(
    x: Nat,
    y: Nat,
    m: Nat,
    small_x: Bool/Holds(x < 256),
    small_y: Bool/Holds(y < 256),
    place: Bool/Holds(m < 8),
    here: Eq()(Nat/shr(x, m), Nat/shr(y, m)),
    next: Eq()(Nat/shr(x, m + 1), Nat/shr(y, m + 1)),
) -> Eq()(low(x, m), low(y, m)) =
    let left = split(x, m, small_x, place);
    let right = split(y, m, small_y, place);
    Nat/le/antisym(low(x, m), low(y, m), proved(), proved());

-- Two low bits that differ answer the bit test differently.
let tested(
    x: Nat,
    y: Nat,
    m: Nat,
    small_x: Bool/Holds(x < 256),
    small_y: Bool/Holds(y < 256),
    place: Bool/Holds(m < 8),
    differs: Bool/Holds(low(x, m) != low(y, m)),
) -> Bool/Holds(low(x, m) != 0 != (low(y, m) != 0)) =
    let one_x = single(x, m, small_x, place);
    let one_y = single(y, m, small_y, place);
    match low(x, m) != 0
    | true =>
        match low(y, m) != 0
        | true =>
            let up_x = positive(low(x, m), Bool/True/qed());
            let up_y = positive(low(y, m), Bool/True/qed());
            match Eq/subst(
                (v: Nat) => Bool/Holds(low(x, m) != v),
                Nat/le/antisym(low(y, m), low(x, m), proved(), proved()),
                differs)
            end
        | false => Bool/True/qed()
        end
    | false =>
        match low(y, m) != 0
        | true => Bool/True/qed()
        | false =>
            match Eq/subst(
                (v: Nat) => Bool/Holds(low(x, m) != v),
                Eq/trans(
                    Nat/eq_of_eql(low(y, m), 0, Bool/True/qed()),
                    Eq/sym(Nat/eq_of_eql(low(x, m), 0, Bool/True/qed()))),
                differs)
            end
        end
    end;

-- Two runs whose first bytes differ are apart at the place those bytes first differ.
let within(
    h: Byte,
    k: Byte,
    t: Bytes,
    r: Bytes,
    s: Nat,
    found: Sought(Byte/to_nat(h), Byte/to_nat(k), s),
) -> Apart(x[h, ..t], x[k, ..r], 7 - s + 1) =
    let (hn, kn) = (Byte/to_nat(h), Byte/to_nat(k));
    let bound: Bool/Holds(s < 8) = found.within;
    let (a, b) = (x[h, ..t], x[k, ..r]);
    Apart {
        below =
            (j, under) =>
                Eq/trans(
                    inward(a, j, proved()),
                    Eq/trans(
                        match j: (n) =>
                            (under: Bool/Holds(n < 7 - s + 1)) -> Eq()(
                                at_place(a, 0, n),
                                at_place(b, 0, n))
                        | 0 => (_) => Eq/refl()
                        | i + 1 =>
                            (_) =>
                                Eq/cong(
                                    (v: Nat) => v != 0,
                                    lows(
                                        hn,
                                        kn,
                                        7 - i,
                                        proved(),
                                        proved(),
                                        proved(),
                                        found.above(7 - i, proved(), proved()),
                                        found.above(7 - i + 1, proved(), proved())))
                        end(under),
                        Eq/sym(inward(b, j, proved())))),
        differs =
            Eq/subst(
                (v: Bool) => Bool/Holds(v != bit(b, 7 - s + 1)),
                Eq/sym(inward(a, 7 - s + 1, proved())),
                Eq/subst(
                    (v: Bool) => Bool/Holds(at_place(a, 0, 7 - s + 1) != v),
                    Eq/sym(inward(b, 7 - s + 1, proved())),
                    Eq/subst(
                        (v: Nat) => Bool/Holds(low(hn, v) != 0 != (low(kn, v) != 0)),
                        Nat/le/antisym(s, 7 - (7 - s), proved(), proved()),
                        tested(hn, kn, s, proved(), proved(), bound, found.differs)))) };

-- A run that ends where another has a byte is apart from it at that byte's first bit.
let ended(k: Byte, r: Bytes) -> Apart(x[], x[k, ..r], 0) =
    Apart { below = (_, under) => match under end, differs = Bool/True/qed() };

let outlasted(h: Byte, t: Bytes) -> Apart(x[h, ..t], x[], 0) =
    Apart { below = (_, under) => match under end, differs = Bool/True/qed() };

-- What `parts` answers is true of the two runs.
let spec(a: Bytes, b: Bytes, g: Nat) -> Found(a, b, g, parts(a, b, g)) =
    match a: (m) => (b: Bytes, g: Nat) -> Found(m, b, g, parts(m, b, g))
    | x[] =>
        (b, _) =>
            match b
            | x[] => Eq/refl()
            | x[k, ..r] => Shifted { over = proved(), apart = ended(k, r) }
            end
    | x[h, ..t]; ih =>
        (b, g) =>
            match b
            | x[] => Shifted { over = proved(), apart = outlasted(h, t) }
            | x[k, ..r] =>
                match h == k
                | true =>
                    Eq/subst(
                        (y: Byte) => Found(x[h, ..t], x[y, ..r], g, parts(t, r, g + 1)),
                        Byte/eq_of_eql(h, k, Bool/True/qed()),
                        match parts(t, r, g + 1): (found) =>
                            (inner: Found(t, r, g + 1, found)) -> Found(
                                x[h, ..t],
                                x[h, ..r],
                                g,
                                found)
                        | same() => (inner) => Eq/cong((z: Bytes) => x[h, ..z], inner)
                        | at(c) =>
                            (inner) =>
                                Shifted {
                                    over = proved(),
                                    apart =
                                        Eq/subst(
                                            (p: Nat) => Apart(x[h, ..t], x[h, ..r], p),
                                            Nat/le/antisym(
                                                c - 9 * (g + 1) + 9,
                                                c - 9 * g,
                                                proved(),
                                                proved()),
                                            lifted(h, t, r, c - 9 * (g + 1), inner.apart)) }
                        end(ih(r, g + 1)))
                | false =>
                    let (hn, kn) = (Byte/to_nat(h), Byte/to_nat(k));
                    let found: Sought(hn, kn, seek(hn, kn, 8)) =
                        sought(
                            hn,
                            kn,
                            8,
                            proved(),
                            proved(),
                            Bool/True/qed(),
                            (m, over, within) =>
                                Eq/subst(
                                    (v: Nat) => Eq()(Nat/shr(hn, v), Nat/shr(kn, v)),
                                    Nat/le/antisym(8, m, over, within),
                                    Eq/trans(
                                        Nat/eq_of_eql(Nat/shr(hn, 8), 0, spent(hn, proved())),
                                        Eq/sym(
                                            Nat/eq_of_eql(
                                                Nat/shr(kn, 8),
                                                0,
                                                spent(kn, proved()))))),
                            Bool/True/qed());
                    Shifted {
                        over = proved(),
                        apart =
                            Eq/subst(
                                (p: Nat) => Apart(x[h, ..t], x[k, ..r], p),
                                Eq/trans(
                                    Eq/sym(rungs(hn, kn)),
                                    Nat/le/antisym(
                                        place(hn, kn),
                                        9 * g + place(hn, kn) - 9 * g,
                                        proved(),
                                        proved())),
                                within(h, k, t, r, seek(hn, kn, 8), found)) }
                end
            end
    end(b, g);

--- What an answer of `crit` says of two runs: that they are one run, or that they are apart at a bit.
pub let Parting(a: Bytes, b: Bytes, found: Parted) -> Prop =
    match found | same() => Eq()(a, b) | at(c) => Apart(a, b, c) end;

--- What `crit` answers is true of the two runs.
pub let parting(a: Bytes, b: Bytes) -> Parting(a, b, crit(a, b)) =
    match parts(a, b, 0): (found) => (inner: Found(a, b, 0, found)) -> Parting(a, b, found)
    | same() => (inner) => inner
    | at(c) =>
        (inner) =>
            Eq/subst(
                (p: Nat) => Apart(a, b, p),
                Nat/le/antisym(c - 9 * 0, c, proved(), proved()),
                inner.apart)
    end(spec(a, b, 0));

--- Two runs apart at a bit are apart at it either way round.
pub let turned(a: Bytes, b: Bytes, c: Nat, apart: Apart(a, b, c)) -> Apart(b, a, c) =
    Apart { below = (j, under) => Eq/sym(apart.below(j, under)), differs = apart.differs };

--- A run apart from a second at a bit is apart at it from any third the second parts from later.
pub let carried(
    a: Bytes,
    b: Bytes,
    d: Bytes,
    c: Nat,
    e: Nat,
    first: Apart(a, b, c),
    second: Apart(b, d, e),
    earlier: Bool/Holds(c < e),
) -> Apart(a, d, c) =
    Apart {
        below = (j, under) => Eq/trans(first.below(j, under), second.below(j, proved())),
        differs =
            Eq/subst(
                (v: Bool) => Bool/Holds(bit(a, c) != v),
                second.below(c, earlier),
                first.differs) };

--- A run that agrees with another through a bit is apart at that bit from whatever the other is.
pub let reheaded(
    a: Bytes,
    n: Bytes,
    b: Bytes,
    c: Nat,
    apart: Apart(a, b, c),
    agree: (j: Nat, within: Bool/Holds(j <= c)) -> Eq()(bit(n, j), bit(a, j)),
) -> Apart(n, b, c) =
    Apart {
        below = (j, under) => Eq/trans(agree(j, proved()), apart.below(j, under)),
        differs =
            Eq/subst(
                (v: Bool) => Bool/Holds(v != bit(b, c)),
                Eq/sym(agree(c, Bool/True/qed())),
                apart.differs) };

-- Two bits that differ, the first set, leave the second clear.
let clear_of(
    a: Bool,
    b: Bool,
    differs: Bool/Holds(a != b),
    set: Bool/Holds(a),
) -> Bool/Holds(Bool/not(b)) =
    match a
    | true =>
        match b
        | true => match differs end
        | false => Bool/True/qed()
        end
    | false => match set end
    end;

-- Two bits that differ, the first clear, leave the second set.
let set_of(
    a: Bool,
    b: Bool,
    differs: Bool/Holds(a != b),
    clear: Bool/Holds(Bool/not(a)),
) -> Bool/Holds(b) =
    match a
    | true => match clear end
    | false =>
        match b
        | true => Bool/True/qed()
        | false => match differs end
        end
    end;

-- Two bits that differ are not both clear.
let not_both_clear(
    a: Bool,
    b: Bool,
    differs: Bool/Holds(a != b),
    clear_a: Bool/Holds(Bool/not(a)),
    clear_b: Bool/Holds(Bool/not(b)),
) -> Bool/False =
    match a
    | true => match clear_a end
    | false =>
        match b
        | true => match clear_b end
        | false => match differs end
        end
    end;

-- Two bits that differ are not both set.
let not_both_set(
    a: Bool,
    b: Bool,
    differs: Bool/Holds(a != b),
    set_a: Bool/Holds(a),
    set_b: Bool/Holds(b),
) -> Bool/False =
    match a
    | true =>
        match b
        | true => match differs end
        | false => match set_b end
        end
    | false => match set_a end
    end;

--- Of two runs apart at a bit the first has set, the second has it clear.
pub let other_clear(
    a: Bytes,
    b: Bytes,
    c: Nat,
    apart: Apart(a, b, c),
    set: Bool/Holds(bit(a, c)),
) -> Bool/Holds(Bool/not(bit(b, c))) =
    clear_of(bit(a, c), bit(b, c), apart.differs, set);

--- Of two runs apart at a bit the first has clear, the second has it set.
pub let other_set(
    a: Bytes,
    b: Bytes,
    c: Nat,
    apart: Apart(a, b, c),
    clear: Bool/Holds(Bool/not(bit(a, c))),
) -> Bool/Holds(bit(b, c)) =
    set_of(bit(a, c), bit(b, c), apart.differs, clear);

--- Two runs both clear at a bit, apart at a bit the first is not past, are apart before it.
pub let below_clear(
    a: Bytes,
    b: Bytes,
    c: Nat,
    d: Nat,
    apart: Apart(a, b, c),
    clear_a: Bool/Holds(Bool/not(bit(a, d))),
    clear_b: Bool/Holds(Bool/not(bit(b, d))),
    not_past: Bool/Holds(Bool/not(d < c)),
) -> Bool/Holds(c < d) =
    match c < d
    | true => Bool/True/qed()
    | false =>
        match not_both_clear(
            bit(a, d),
            bit(b, d),
            Eq/subst(
                (m: Nat) => Bool/Holds(bit(a, m) != bit(b, m)),
                Nat/le/antisym(c, d, proved(), proved()),
                apart.differs),
            clear_a,
            clear_b)
        end
    end;

--- Two runs both set at a bit, apart at a bit the first is not past, are apart before it.
pub let below_set(
    a: Bytes,
    b: Bytes,
    c: Nat,
    d: Nat,
    apart: Apart(a, b, c),
    set_a: Bool/Holds(bit(a, d)),
    set_b: Bool/Holds(bit(b, d)),
    not_past: Bool/Holds(Bool/not(d < c)),
) -> Bool/Holds(c < d) =
    match c < d
    | true => Bool/True/qed()
    | false =>
        match not_both_set(
            bit(a, d),
            bit(b, d),
            Eq/subst(
                (m: Nat) => Bool/Holds(bit(a, m) != bit(b, m)),
                Nat/le/antisym(c, d, proved(), proved()),
                apart.differs),
            set_a,
            set_b)
        end
    end;

-- Two bytes with one low bit at every shift from `m` up have one shift at `m`.
let shifts(
    x: Nat,
    y: Nat,
    n: Nat,
    m: Nat,
    small_x: Bool/Holds(x < 256),
    small_y: Bool/Holds(y < 256),
    le: Bool/Holds(m + n <= 8),
    ge: Bool/Holds(8 <= m + n),
    lows: (i: Nat, over: Bool/Holds(m <= i), under: Bool/Holds(i < 8)) -> Eq()(
        low(x, i),
        low(y, i)),
) -> Eq()(Nat/shr(x, m), Nat/shr(y, m)) =
    match n: (count) =>
        (
            m: Nat,
            le: Bool/Holds(m + count <= 8),
            ge: Bool/Holds(8 <= m + count),
            lows: (i: Nat, over: Bool/Holds(m <= i), under: Bool/Holds(i < 8)) -> Eq()(
                low(x, i),
                low(y, i))) -> Eq()(Nat/shr(x, m), Nat/shr(y, m))
    | 0 =>
        (m, le, ge, _) =>
            Eq/subst(
                (v: Nat) => Eq()(Nat/shr(x, v), Nat/shr(y, v)),
                Nat/le/antisym(8, m, ge, le),
                Eq/trans(
                    Nat/eq_of_eql(Nat/shr(x, 8), 0, spent(x, small_x)),
                    Eq/sym(Nat/eq_of_eql(Nat/shr(y, 8), 0, spent(y, small_y)))))
    | i + 1; ih =>
        (m, le, ge, lows) =>
            let same_next: Bool/Holds(Nat/shr(x, m + 1) == Nat/shr(y, m + 1)) =
                Eq/subst(
                    (v: Nat) => Bool/Holds(Nat/shr(x, m + 1) == v),
                    ih(m + 1, proved(), proved(), (at, over, under) => lows(at, proved(), under)),
                    Bool/True/qed());
            let same_low: Bool/Holds(low(x, m) == low(y, m)) =
                Eq/subst(
                    (v: Nat) => Bool/Holds(low(x, m) == v),
                    lows(m, proved(), proved()),
                    Bool/True/qed());
            let left = split(x, m, small_x, proved());
            let right = split(y, m, small_y, proved());
            Nat/le/antisym(Nat/shr(x, m), Nat/shr(y, m), proved(), proved())
    end(m, le, ge, lows);

-- A byte below another at a shift is below it.
let lesser(
    x: Nat,
    y: Nat,
    m: Nat,
    small_x: Bool/Holds(x < 256),
    small_y: Bool/Holds(y < 256),
    bound: Bool/Holds(m <= 8),
    under: Bool/Holds(Nat/shr(x, m) < Nat/shr(y, m)),
) -> Bool/Holds(x < y) =
    match m: (n) =>
        (bound: Bool/Holds(n <= 8), under: Bool/Holds(Nat/shr(x, n) < Nat/shr(y, n))) -> Bool/Holds(
            x < y)
    | 0 => (_, under) => under
    | i + 1; ih =>
        (bound, under) =>
            let left = split(x, i, small_x, proved());
            let right = split(y, i, small_y, proved());
            let one = single(x, i, small_x, proved());
            ih(proved(), proved())
    end(bound, under);

-- Two low bits the bit test answers alike are one.
let untested(
    x: Nat,
    y: Nat,
    m: Nat,
    small_x: Bool/Holds(x < 256),
    small_y: Bool/Holds(y < 256),
    place: Bool/Holds(m < 8),
    same: Eq()(low(x, m) != 0, low(y, m) != 0),
) -> Eq()(low(x, m), low(y, m)) =
    let one_x = single(x, m, small_x, place);
    let one_y = single(y, m, small_y, place);
    match low(x, m) != 0
    | true =>
        match low(y, m) != 0
        | true =>
            let up_x = positive(low(x, m), Bool/True/qed());
            let up_y = positive(low(y, m), Bool/True/qed());
            Nat/le/antisym(low(x, m), low(y, m), proved(), proved())
        | false => match Bool/false_neq_true(Eq/sym(same)) end
        end
    | false =>
        match low(y, m) != 0
        | true => match Bool/false_neq_true(same) end
        | false =>
            Eq/trans(
                Nat/eq_of_eql(low(x, m), 0, Bool/True/qed()),
                Eq/sym(Nat/eq_of_eql(low(y, m), 0, Bool/True/qed())))
        end
    end;

-- Two runs that agree at a place of their first bytes have one low bit at that place's shift.
let agreed(
    h: Byte,
    k: Byte,
    t: Bytes,
    r: Bytes,
    m: Nat,
    place: Bool/Holds(m < 8),
    same: Eq()(bit(x[h, ..t], 7 - m + 1), bit(x[k, ..r], 7 - m + 1)),
) -> Eq()(low(Byte/to_nat(h), m), low(Byte/to_nat(k), m)) =
    let (hn, kn) = (Byte/to_nat(h), Byte/to_nat(k));
    untested(
        hn,
        kn,
        m,
        proved(),
        proved(),
        place,
        Eq/subst(
            (v: Nat) => Eq()(low(hn, v) != 0, low(kn, v) != 0),
            Nat/le/antisym(7 - (7 - m), m, proved(), proved()),
            Eq/trans(
                Eq/sym(inward(x[h, ..t], 7 - m + 1, proved())),
                Eq/trans(same, inward(x[k, ..r], 7 - m + 1, proved())))));

-- Two runs apart nine bits on or more past one first byte are apart past it.
let lowered(
    h: Byte,
    t: Bytes,
    r: Bytes,
    c: Nat,
    apart: Apart(x[h, ..t], x[h, ..r], c),
    over: Bool/Holds(9 <= c),
) -> Apart(t, r, c - 9) =
    Apart {
        below = (j, under) => apart.below(j + 9, proved()),
        differs =
            Eq/subst(
                (v: Nat) => Bool/Holds(bit(x[h, ..t], v) != bit(x[h, ..r], v)),
                Eq/sym(Nat/le/add_sub_cancel(9, c, over)),
                apart.differs) };

--- A run apart from another at a bit it has clear is before it in the order of bytes: the bits are the bytes' own from their tops, behind a bit that says a byte is there, so the first bit two runs differ at is where `Bytes/ord` decides.
pub let before(
    a: Bytes,
    b: Bytes,
    c: Nat,
    apart: Apart(a, b, c),
    clear: Bool/Holds(Bool/not(bit(a, c))),
) -> Eq()(Bytes/ord(a, b), Ordering/lt()) =
    match a: (m) =>
        (b: Bytes, c: Nat, apart: Apart(m, b, c), clear: Bool/Holds(Bool/not(bit(m, c)))) -> Eq()(
            Bytes/ord(m, b),
            Ordering/lt())
    | x[] =>
        (b, _, apart, _) =>
            match b
            | x[] => match apart.differs end
            | x[_, .._] => Eq/refl()
            end
    | x[h, ..t]; ih =>
        (b, c, apart, clear) =>
            match b
            | x[] =>
                match c: (n) =>
                    (
                        apart: Apart(x[h, ..t], x[], n),
                        clear: Bool/Holds(Bool/not(bit(x[h, ..t], n)))) -> Eq()(
                        Ordering/gt(),
                        Ordering/lt())
                | 0 => (_, clear) => match clear end
                | _ + 1 =>
                    (apart, _) =>
                        match Bool/false_neq_true(Eq/sym(apart.below(0, Bool/True/qed()))) end
                end(apart, clear)
            | x[k, ..r] =>
                let (hn, kn) = (Byte/to_nat(h), Byte/to_nat(k));
                match c < 9
                | false =>
                    let same: Eq()(h, k) =
                        Eq/cong(
                            (n: Nat) => Nat/to_byte(n % 256),
                            shifts(
                                hn,
                                kn,
                                8,
                                0,
                                proved(),
                                proved(),
                                Bool/True/qed(),
                                Bool/True/qed(),
                                (m, _, under) =>
                                    agreed(
                                        h,
                                        k,
                                        t,
                                        r,
                                        m,
                                        under,
                                        apart.below(7 - m + 1, proved()))));
                    Eq/subst(
                        (y: Byte) =>
                            (apart: Apart(x[h, ..t], x[y, ..r], c)) -> Eq()(
                                Bytes/ord(x[h, ..t], x[y, ..r]),
                                Ordering/lt()),
                        same,
                        (apart) =>
                            ih(
                                r,
                                c - 9,
                                lowered(h, t, r, c, apart, proved()),
                                Eq/subst(
                                    (v: Bool) => Bool/Holds(Bool/not(v)),
                                    onward(h, t, c, proved()),
                                    clear)))(
                        apart)
                | true =>
                    match c: (n) =>
                        (
                            apart: Apart(x[h, ..t], x[k, ..r], n),
                            clear: Bool/Holds(Bool/not(bit(x[h, ..t], n))),
                            under: Bool/Holds(n < 9)) -> Eq()(
                            Bytes/ord(x[h, ..t], x[k, ..r]),
                            Ordering/lt())
                    | 0 => (_, clear, _) => match clear end
                    | i + 1 =>
                        (apart, clear, under) =>
                            let next: Eq()(Nat/shr(hn, 7 - i + 1), Nat/shr(kn, 7 - i + 1)) =
                                shifts(
                                    hn,
                                    kn,
                                    i,
                                    7 - i + 1,
                                    proved(),
                                    proved(),
                                    proved(),
                                    proved(),
                                    (m, over, within) =>
                                        agreed(
                                            h,
                                            k,
                                            t,
                                            r,
                                            m,
                                            within,
                                            apart.below(7 - m + 1, proved())));
                            let off: Bool/Holds(Bool/not(low(hn, 7 - i) != 0)) =
                                Eq/subst(
                                    (v: Bool) => Bool/Holds(Bool/not(v)),
                                    inward(x[h, ..t], i + 1, under),
                                    clear);
                            let parted: Bool/Holds(low(hn, 7 - i) != 0 != (low(kn, 7 - i) != 0)) =
                                Eq/subst(
                                    (v: Bool) => Bool/Holds(v != at_place(x[k, ..r], 0, i + 1)),
                                    inward(x[h, ..t], i + 1, under),
                                    Eq/subst(
                                        (v: Bool) => Bool/Holds(bit(x[h, ..t], i + 1) != v),
                                        inward(x[k, ..r], i + 1, under),
                                        apart.differs));
                            match low(hn, 7 - i) != 0
                            | true => match off end
                            | false =>
                                match low(kn, 7 - i) != 0
                                | false => match parted end
                                | true =>
                                    let zero: Bool/Holds(low(hn, 7 - i) == 0) = Bool/True/qed();
                                    let up = positive(low(kn, 7 - i), Bool/True/qed());
                                    let left = split(hn, 7 - i, proved(), proved());
                                    let right = split(kn, 7 - i, proved(), proved());
                                    let lower: Bool/Holds(hn < kn) =
                                        lesser(
                                            hn,
                                            kn,
                                            7 - i,
                                            proved(),
                                            proved(),
                                            proved(),
                                            proved());
                                    Eq/subst(
                                        (o: Ordering) =>
                                            Eq()(
                                                match o
                                                | eq() => Bytes/ord(t, r)
                                                | lt() => Ordering/lt()
                                                | gt() => Ordering/gt()
                                                end,
                                                Ordering/lt()),
                                        Eq/sym(Nat/ord/of_lt(hn, kn, lower)),
                                        Eq/refl())
                                end
                            end
                    end(apart, clear, Bool/True/qed())
                end
            end
    end(b, c, apart, clear);
