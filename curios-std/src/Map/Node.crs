use /std/{Bytes, Nat, Bool, Hash};
use /std/Map/{Key};
use /std/Map/bits/{bit, crit};

--- A trie's node: a key with its value, or a fork at the bit its two sides first differ at, the keys clear at it on the zero side.
pub induct Node(K: Type, V: Type): pub Type
| leaf(key: K, value: V)
| fork(crit: Nat, zero: Node(K, V), one: Node(K, V))
end

pub use Node/*;

--- The leaf a walk by `k`'s bits ends at. Its key is the one to compare: a fork tests one bit, so only the whole encoding says whether the walk was a hit.
pub let lookup(@K: Type, @V: Type, t: Node(K, V), k: Bytes) -> {K, V} =
    match t
    | leaf(k0, v0) => (k0, v0)
    | fork(c, z, o) => match bit(k, c) | false => lookup(z, k) | true => lookup(o, k) end
    end;

--- A leaf of `key` above `t` at the bit `c`, on the side `b`.
pub let wedge(@K: Type, @V: Type, c: Nat, b: Bool, key: K, v: V, t: Node(K, V)) -> Node(K, V) =
    match b
    | false => Node/fork(c, Node/leaf(key, v), t)
    | true => Node/fork(c, t, Node/leaf(key, v))
    end;

--- How an insertion under a node ended: the node with the key's leaf added, the node with the value of a leaf it held replaced, or the node as it was beside the bit the key first parts from its keys at, where its leaf is still to be wedged in above.
pub induct Inserted(K: Type, V: Type): pub Type
| added(Node(K, V))
| replaced(Node(K, V))
| parted(Node(K, V), Nat)
end

--- `key` under `t` at `v`, where `k` is `key`'s encoding, computed once by the caller; a leaf's is derived here, where it is compared.
---
--- A leaf whose encoding is `k` keeps its own key, which is `key` by `Key/injective`. The node comes back through the answer where its leaf is still to be wedged, so no caller holds it across the call.
pub let insert(
    @K: Type,
    use Key(K),
    @V: Type,
    t: Node(K, V),
    key: K,
    k: Bytes,
    v: V,
) -> Inserted(K, V) =
    match t
    | leaf(k0, _) =>
        let e0 = Hash/hash(k0);
        match e0 == k
        | true => Inserted/replaced(Node/leaf(k0, v))
        | false =>
            match crit(k, e0)
            | same() => Inserted/replaced(Node/leaf(k0, v))
            | at(c) => Inserted/parted(t, c)
            end
        end
    | fork(tc, z, o) =>
        match bit(k, tc)
        | false =>
            match insert(z, key, k, v)
            | added(z2) => Inserted/added(Node/fork(tc, z2, o))
            | replaced(z2) => Inserted/replaced(Node/fork(tc, z2, o))
            | parted(z2, c) =>
                match tc < c
                | true => Inserted/added(Node/fork(tc, wedge(c, bit(k, c), key, v, z2), o))
                | false => Inserted/parted(t, c)
                end
            end
        | true =>
            match insert(o, key, k, v)
            | added(o2) => Inserted/added(Node/fork(tc, z, o2))
            | replaced(o2) => Inserted/replaced(Node/fork(tc, z, o2))
            | parted(o2, c) =>
                match tc < c
                | true => Inserted/added(Node/fork(tc, z, wedge(c, bit(k, c), key, v, o2)))
                | false => Inserted/parted(t, c)
                end
            end
        end
    end;

--- How a removal under a node ended: the key was not there, the node was its leaf and nothing is left of it, or what is left of the node.
pub induct Removed(K: Type, V: Type): pub Type
| absent()
| gone()
| kept(Node(K, V))
end

--- `t` without the key whose encoding is `k`.
pub let remove(@K: Type, use Key(K), @V: Type, t: Node(K, V), k: Bytes) -> Removed(K, V) =
    match t
    | leaf(k0, _) =>
        match Hash/hash(k0) == k | true => Removed/gone() | false => Removed/absent() end
    | fork(c, z, o) =>
        match bit(k, c)
        | false =>
            match remove(z, k)
            | absent() => Removed/absent()
            | gone() => Removed/kept(o)
            | kept(z2) => Removed/kept(Node/fork(c, z2, o))
            end
        | true =>
            match remove(o, k)
            | absent() => Removed/absent()
            | gone() => Removed/kept(z)
            | kept(o2) => Removed/kept(Node/fork(c, z, o2))
            end
        end
    end;

--- `f` on every value, the keys and the forks as they were.
pub let map(@K: Type, @V: Type, @W: Type, t: Node(K, V), f: (V) -> W) -> Node(K, W) =
    match t
    | leaf(k, v) => Node/leaf(k, f(v))
    | fork(c, z, o) => Node/fork(c, map(z, f), map(o, f))
    end;
