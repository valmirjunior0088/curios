use /std/{Bytes, Nat, Bool, Option, List, Eq, Hash, Ord, Ordering};
use /std/Bool/{True, Holds};
use /std/List/{Member, Pairwise};
use /std/Map/{Key};
use /std/Map/bits/{bit, crit, Apart, Parting, parting, turned, carried, reheaded, other_clear,
    other_set, below_clear, below_set, before};

--- A trie's node: a key with its value, or a fork at the bit its two sides first differ at, the keys clear at it on the zero side.
pub induct Node(K: Type, V: Type): pub Type
| leaf(key: K, value: V)
| fork(crit: Nat, zero: Node(K, V), one: Node(K, V))
end

pub use Node/*;

--- The encoding of a node's first key, the one a walk down the zero sides ends at.
pub let first(@K: Type, use Key(K), @V: Type, t: Node(K, V)) -> Bytes =
    match t | leaf(k, _) => Hash/hash(k) | fork(_, z, _) => first(z) end;

--- A node's own bit, where it has one.
pub let top(@K: Type, @V: Type, t: Node(K, V)) -> Option(Nat) =
    match t | leaf(_, _) => Option/none() | fork(d, _, _) => Option/some(d) end;

--- Whether a bit, where there is one, is past `c`.
pub let past(p: Option(Nat), c: Nat) -> Bool =
    match p | none() => true | some(d) => c < d end;

--- Whether a node's own bit, where it has one, is past `c`.
pub let deeper(@K: Type, @V: Type, t: Node(K, V), c: Nat) -> Bool =
    past(top(t), c);

--- A node that forks past a bit forks past every bit before it.
pub let deeper_down(
    @K: Type,
    @V: Type,
    t: Node(K, V),
    c: Nat,
    d: Nat,
    past: Holds(deeper(t, c)),
    le: Holds(d <= c),
) -> Holds(deeper(t, d)) =
    match t | leaf(_, _) => True/qed() | fork(_, _, _) => True/proved() end;

--- What a fork states of its two sides: each sound and forking past its bit, and their first keys apart at that bit, which the zero side's has clear.
---
--- Stated of the two first keys alone. A side's every key agrees with its first through any bit the side forks past, so the fork's bit is clear in every key of the zero side and set in every key of the one side, and all of them agree below it.
pub struct Forked(
    Zero: Prop,
    One: Prop,
    a: Bytes,
    b: Bytes,
    c: Nat,
    past_zero: Bool,
    past_one: Bool,
): pub Prop {
    zero: Zero,
    one: One,
    under_zero: Holds(past_zero),
    under_one: Holds(past_one),
    apart: Apart(a, b, c),
    clear: Holds(Bool/not(bit(a, c))),
}

--- A trie is sound where every fork of it is: a leaf as it stands, and a fork by [`Forked`] of its sides.
pub let Sound(@K: Type, use Key(K), @V: Type, t: Node(K, V)) -> Prop =
    match t
    | leaf(_, _) => True
    | fork(c, z, o) => Forked(Sound(z), Sound(o), first(z), first(o), c, deeper(z, c), deeper(o, c))
    end;

--- Soundness as a family over the node, the encoding of its first key and its own bit, which is the form a map holds.
---
--- It says what [`Sound`] says and applies no function to the node: a proposition that did would hide how it uses the value type, and a type that holds itself through a map, as `/std/Toml` does, would be refused as not strictly positive. [`shaped`] builds it from the working form and [`read`] reads it back.
pub induct Shaped(K: Type, use Key(K), V: Type): (Node(K, V), Bytes, Option(Nat)) -> pub Prop
| leaf(@key: K, @value: V): (Node/leaf(key, value), Hash/hash(key), Option/none())
| fork(
    @c: Nat,
    @z: Node(K, V),
    @o: Node(K, V),
    @a: Bytes,
    @b: Bytes,
    @top_zero: Option(Nat),
    @top_one: Option(Nat),
    zero: Shaped(K, V)(z, a, top_zero),
    one: Shaped(K, V)(o, b, top_one),
    under_zero: Holds(past(top_zero, c)),
    under_one: Holds(past(top_one, c)),
    apart: Apart(a, b, c),
    clear: Holds(Bool/not(bit(a, c)))): (Node/fork(c, z, o), a, Option/some(c))
end

--- A sound node in the form a map holds.
pub let shaped(
    @K: Type,
    use Key(K),
    @V: Type,
    t: Node(K, V),
    sound: Sound(t),
) -> Shaped(K, V)(t, first(t), top(t)) =
    match t
    | leaf(_, _) => Shaped/leaf()
    | fork(_, z, o) =>
        Shaped/fork(
            shaped(z, sound.zero),
            shaped(o, sound.one),
            sound.under_zero,
            sound.under_one,
            sound.apart,
            sound.clear)
    end;

--- What the form a map holds says of a node: that it is sound, and which first key and which bit it was stated of.
pub struct Read(@K: Type, use Key(K), @V: Type, t: Node(K, V), a: Bytes, p: Option(Nat)): pub Prop {
    sound: Sound(t),
    first: Eq()(first(t), a),
    top: Eq()(top(t), p),
}

--- The form a map holds, read back.
pub let read(
    @K: Type,
    use Key(K),
    @V: Type,
    @t: Node(K, V),
    @a: Bytes,
    @p: Option(Nat),
    w: Shaped(K, V)(t, a, p),
) -> Read(t, a, p) =
    match w: (t, a, p, _) => Read(t, a, p)
    | leaf() => Read { sound = True/qed(), first = Eq/refl(), top = Eq/refl() }
    | fork(@c, @_, @o, @a, @_, @_, @_, zero, one, under_zero, under_one, apart, clear) =>
        let rz = read(zero);
        let ro = read(one);
        Read {
            sound =
                Forked {
                    zero = rz.sound,
                    one = ro.sound,
                    under_zero =
                        Eq/subst((q: Option(Nat)) => Holds(past(q, c)), Eq/sym(rz.top), under_zero),
                    under_one =
                        Eq/subst((q: Option(Nat)) => Holds(past(q, c)), Eq/sym(ro.top), under_one),
                    apart =
                        Eq/subst(
                            (e: Bytes) => Apart(e, first(o), c),
                            Eq/sym(rz.first),
                            Eq/subst((e: Bytes) => Apart(a, e, c), Eq/sym(ro.first), apart)),
                    clear =
                        Eq/subst(
                            (e: Bytes) => Holds(Bool/not(bit(e, c))),
                            Eq/sym(rz.first),
                            clear) },
            first = rz.first,
            top = Eq/refl() }
    end;

--- What a node keeps of the one it stands in for, at a bit the old one forked past: it forks past it too, and its first key agrees with the old one's through it.
pub struct Held(a: Bytes, b: Bytes, c: Nat, past: Bool): pub Prop {
    under: Holds(past),
    agree: (j: Nat, within: Holds(j <= c)) -> Eq()(bit(a, j), bit(b, j)),
}

--- A node that may stand where another did: sound, and keeping the other's place under every fork above it.
pub struct Stands(@K: Type, use Key(K), @V: Type, n: Node(K, V), t: Node(K, V)): pub Prop {
    sound: Sound(n),
    kept: (c: Nat, past: Holds(deeper(t, c))) -> Held(first(n), first(t), c, deeper(n, c)),
}

-- A fork whose zero side gave way to a sound node that keeps its place under the fork may stand where the fork did.
let zero_side(
    @K: Type,
    use Key(K),
    @V: Type,
    c: Nat,
    z: Node(K, V),
    o: Node(K, V),
    n: Node(K, V),
    sound: Sound(Node/fork(c, z, o)),
    sound_n: Sound(n),
    held: Held(first(n), first(z), c, deeper(n, c)),
) -> Stands(Node/fork(c, n, o), Node/fork(c, z, o)) =
    Stands {
        sound =
            Forked {
                zero = sound_n,
                one = sound.one,
                under_zero = held.under,
                under_one = sound.under_one,
                apart = reheaded(first(z), first(n), first(o), c, sound.apart, held.agree),
                clear =
                    Eq/subst(
                        (v: Bool) => Holds(Bool/not(v)),
                        Eq/sym(held.agree(c, True/qed())),
                        sound.clear) },
        kept = (_, past) => Held { under = past, agree = (j, _) => held.agree(j, True/proved()) } };

-- A fork whose one side gave way to a sound node that keeps its place under the fork may stand where the fork did.
let one_side(
    @K: Type,
    use Key(K),
    @V: Type,
    c: Nat,
    z: Node(K, V),
    o: Node(K, V),
    n: Node(K, V),
    sound: Sound(Node/fork(c, z, o)),
    sound_n: Sound(n),
    held: Held(first(n), first(o), c, deeper(n, c)),
) -> Stands(Node/fork(c, z, n), Node/fork(c, z, o)) =
    Stands {
        sound =
            Forked {
                zero = sound.zero,
                one = sound_n,
                under_zero = sound.under_zero,
                under_one = held.under,
                apart =
                    turned(
                        first(n),
                        first(z),
                        c,
                        reheaded(
                            first(o),
                            first(n),
                            first(z),
                            c,
                            turned(first(z), first(o), c, sound.apart),
                            held.agree)),
                clear = sound.clear },
        kept = (_, past) => Held { under = past, agree = (_, _) => Eq/refl() } };

--- The leaf a walk by `k`'s bits ends at. Its key is the one to compare: a fork tests one bit, so only the whole encoding says whether the walk was a hit.
pub let lookup(@K: Type, @V: Type, t: Node(K, V), k: Bytes) -> {K, V} =
    match t
    | leaf(k0, v0) => (k0, v0)
    | fork(c, z, o) => match bit(k, c) | false => lookup(z, k) | true => lookup(o, k) end
    end;

--- A leaf of `key` above `t` at the bit `c`, on the side `b`.
pub let wedge(@K: Type, @V: Type, c: Nat, b: Bool, key: K, v: V, t: Node(K, V)) -> Node(K, V) =
    match b
    | false => Node/fork(c, Node/leaf(key, v), t)
    | true => Node/fork(c, t, Node/leaf(key, v))
    end;

-- A leaf wedged in above a node forks at the bit it was wedged at.
let wedge_deeper(
    @K: Type,
    @V: Type,
    c: Nat,
    b: Bool,
    key: K,
    v: V,
    t: Node(K, V),
    d: Nat,
    under: Holds(d < c),
) -> Holds(deeper(wedge(c, b, key, v, t), d)) =
    match b | false => under | true => under end;

-- A leaf wedged in above a node it parts from at a bit leaves the node's first key as it was below that bit.
let wedge_agree(
    @K: Type,
    use Key(K),
    @V: Type,
    c: Nat,
    b: Bool,
    key: K,
    k: Bytes,
    v: V,
    t: Node(K, V),
    same: Eq()(Hash/hash(key), k),
    apart: Apart(k, first(t), c),
    j: Nat,
    under: Holds(j < c),
) -> Eq()(bit(first(wedge(c, b, key, v, t)), j), bit(first(t), j)) =
    match b
    | false =>
        Eq/subst(
            (e: Bytes) => Eq()(bit(e, j), bit(first(t), j)),
            Eq/sym(same),
            apart.below(j, under))
    | true => Eq/refl()
    end;

-- What a leaf wedged in above a node keeps of the node under a fork before the bit it was wedged at.
let wedge_held(
    @K: Type,
    use Key(K),
    @V: Type,
    c: Nat,
    b: Bool,
    key: K,
    k: Bytes,
    v: V,
    t: Node(K, V),
    same: Eq()(Hash/hash(key), k),
    apart: Apart(k, first(t), c),
    d: Nat,
    under: Holds(d < c),
) -> Held(first(wedge(c, b, key, v, t)), first(t), d, deeper(wedge(c, b, key, v, t), d)) =
    Held {
        under = wedge_deeper(c, b, key, v, t, d, under),
        agree = (j, _) => wedge_agree(c, b, key, k, v, t, same, apart, j, True/proved()) };

-- A leaf wedged in above a sound node on the side `b`, its key's bit at `c`, where the key parts from the node's first at `c` and the node forks past it, is sound.
let wedged_at(
    @K: Type,
    use Key(K),
    @V: Type,
    c: Nat,
    b: Bool,
    key: K,
    v: V,
    t: Node(K, V),
    sound: Sound(t),
    apart: Apart(Hash/hash(key), first(t), c),
    past: Holds(deeper(t, c)),
    is: Eq()(bit(Hash/hash(key), c), b),
) -> Sound(wedge(c, b, key, v, t)) =
    match b: (m) => (is: Eq()(bit(Hash/hash(key), c), m)) -> Sound(wedge(c, m, key, v, t))
    | false =>
        (is) =>
            Forked {
                zero = True/qed(),
                one = sound,
                under_zero = True/qed(),
                under_one = past,
                apart = apart,
                clear = Eq/subst((x: Bool) => Holds(Bool/not(x)), Eq/sym(is), True/qed()) }
    | true =>
        (is) =>
            Forked {
                zero = sound,
                one = True/qed(),
                under_zero = past,
                under_one = True/qed(),
                apart = turned(Hash/hash(key), first(t), c, apart),
                clear =
                    other_clear(
                        Hash/hash(key),
                        first(t),
                        c,
                        apart,
                        Eq/subst((x: Bool) => Holds(x), Eq/sym(is), True/qed())) }
    end(is);

--- A leaf of `key`, whose encoding is `k`, wedged in above a sound node on the side `k`'s bit at `c` says, where `k` parts from the node's first key at `c` and the node forks past it, is sound.
pub let wedged(
    @K: Type,
    use Key(K),
    @V: Type,
    c: Nat,
    key: K,
    k: Bytes,
    v: V,
    t: Node(K, V),
    same: Eq()(Hash/hash(key), k),
    sound: Sound(t),
    apart: Apart(k, first(t), c),
    past: Holds(deeper(t, c)),
) -> Sound(wedge(c, bit(k, c), key, v, t)) =
    Eq/subst(
        (e: Bytes) => (apart: Apart(e, first(t), c)) -> Sound(wedge(c, bit(e, c), key, v, t)),
        same,
        (apart) => wedged_at(c, bit(Hash/hash(key), c), key, v, t, sound, apart, past, Eq/refl()))(
        apart);

--- How an insertion under the node `t` of the key whose encoding is `k` ended: a node with the key's leaf added, or one with the value of a leaf it held replaced, either of which may stand where `t` did; or `t` as it was beside the bit the key first parts from its keys at, where its leaf is still to be wedged in above.
pub induct Inserted(K: Type, use Key(K), V: Type, t: Node(K, V), k: Bytes): pub Type
| added(n: Node(K, V), @stands: Stands(n, t))
| replaced(n: Node(K, V), @stands: Stands(n, t))
| parted(
    n: Node(K, V),
    c: Nat,
    @back: Eq()(n, t),
    @apart: Apart(k, first(t), c),
    @past: Holds(deeper(t, c)))
end

--- `key` under the sound node `t` at `v`, where `k` is `key`'s encoding, computed once by the caller; a leaf's is derived here, where it is compared.
---
--- A leaf whose encoding is `k` keeps its own key, which is `key` by `Key/injective`. The node comes back through the answer where its leaf is still to be wedged, so no caller holds it across the call. The answer carries what is true of it, built in this recursion, and the proofs erase.
pub let insert(
    @K: Type,
    use Key(K),
    @V: Type,
    t: Node(K, V),
    key: K,
    k: Bytes,
    v: V,
    @same: Eq()(Hash/hash(key), k),
    @sound: Sound(t),
) -> Inserted(K, V, t, k) =
    match t
    | leaf(k0, _) =>
        let e0 = Hash/hash(k0);
        let kept: Stands(Node/leaf(k0, v), t) =
            Stands {
                sound = True/qed(),
                kept = (_, _) => Held { under = True/qed(), agree = (_, _) => Eq/refl() } };
        match e0 == k
        | true => Inserted/replaced(Node/leaf(k0, v), @kept)
        | false =>
            let found: Parting(k, e0, crit(k, e0)) = parting(k, e0);
            match crit(k, e0)
            | same() => Inserted/replaced(Node/leaf(k0, v), @kept)
            | at(c) => Inserted/parted(t, c, @Eq/refl(), @found, @True/qed())
            end
        end
    | fork(tc, z, o) =>
        match bit(k, tc)
        | false =>
            match insert(z, key, k, v, @same, @sound.zero)
            | added(z2, @stands) =>
                Inserted/added(
                    Node/fork(tc, z2, o),
                    @zero_side(
                        tc,
                        z,
                        o,
                        z2,
                        sound,
                        stands.sound,
                        stands.kept(tc, sound.under_zero)))
            | replaced(z2, @stands) =>
                Inserted/replaced(
                    Node/fork(tc, z2, o),
                    @zero_side(
                        tc,
                        z,
                        o,
                        z2,
                        sound,
                        stands.sound,
                        stands.kept(tc, sound.under_zero)))
            | parted(z2, c, @back, @apart, @past) =>
                match tc < c
                | true =>
                    Inserted/added(
                        Node/fork(tc, wedge(c, bit(k, c), key, v, z2), o),
                        @Eq/subst(
                            (m: Node(K, V)) =>
                                Stands(
                                    Node/fork(tc, wedge(c, bit(k, c), key, v, m), o),
                                    Node/fork(tc, z, o)),
                            Eq/sym(back),
                            zero_side(
                                tc,
                                z,
                                o,
                                wedge(c, bit(k, c), key, v, z),
                                sound,
                                wedged(c, key, k, v, z, same, sound.zero, apart, past),
                                wedge_held(
                                    c,
                                    bit(k, c),
                                    key,
                                    k,
                                    v,
                                    z,
                                    same,
                                    apart,
                                    tc,
                                    True/qed()))))
                | false =>
                    let here: Apart(k, first(t), c) = apart;
                    let under: Holds(c < tc) =
                        below_clear(k, first(z), c, tc, apart, True/qed(), sound.clear, True/qed());
                    Inserted/parted(t, c, @Eq/refl(), @here, @under)
                end
            end
        | true =>
            match insert(o, key, k, v, @same, @sound.one)
            | added(o2, @stands) =>
                Inserted/added(
                    Node/fork(tc, z, o2),
                    @one_side(tc, z, o, o2, sound, stands.sound, stands.kept(tc, sound.under_one)))
            | replaced(o2, @stands) =>
                Inserted/replaced(
                    Node/fork(tc, z, o2),
                    @one_side(tc, z, o, o2, sound, stands.sound, stands.kept(tc, sound.under_one)))
            | parted(o2, c, @back, @apart, @past) =>
                match tc < c
                | true =>
                    Inserted/added(
                        Node/fork(tc, z, wedge(c, bit(k, c), key, v, o2)),
                        @Eq/subst(
                            (m: Node(K, V)) =>
                                Stands(
                                    Node/fork(tc, z, wedge(c, bit(k, c), key, v, m)),
                                    Node/fork(tc, z, o)),
                            Eq/sym(back),
                            one_side(
                                tc,
                                z,
                                o,
                                wedge(c, bit(k, c), key, v, o),
                                sound,
                                wedged(c, key, k, v, o, same, sound.one, apart, past),
                                wedge_held(
                                    c,
                                    bit(k, c),
                                    key,
                                    k,
                                    v,
                                    o,
                                    same,
                                    apart,
                                    tc,
                                    True/qed()))))
                | false =>
                    let under: Holds(c < tc) =
                        below_set(
                            k,
                            first(o),
                            c,
                            tc,
                            apart,
                            True/qed(),
                            other_set(first(z), first(o), tc, sound.apart, sound.clear),
                            True/qed());
                    let here: Apart(k, first(t), c) =
                        carried(
                            k,
                            first(o),
                            first(z),
                            c,
                            tc,
                            apart,
                            turned(first(z), first(o), tc, sound.apart),
                            under);
                    Inserted/parted(t, c, @Eq/refl(), @here, @under)
                end
            end
        end
    end;

-- The one side of a fork may stand where the fork did, its zero side gone.
let one_left(
    @K: Type,
    use Key(K),
    @V: Type,
    c: Nat,
    z: Node(K, V),
    o: Node(K, V),
    sound: Sound(Node/fork(c, z, o)),
) -> Stands(o, Node/fork(c, z, o)) =
    Stands {
        sound = sound.one,
        kept =
            (d, _) =>
                Held {
                    under = deeper_down(o, c, d, sound.under_one, True/proved()),
                    agree = (j, _) => Eq/sym(sound.apart.below(j, True/proved())) } };

-- The zero side of a fork may stand where the fork did, its one side gone.
let zero_left(
    @K: Type,
    use Key(K),
    @V: Type,
    c: Nat,
    z: Node(K, V),
    o: Node(K, V),
    sound: Sound(Node/fork(c, z, o)),
) -> Stands(z, Node/fork(c, z, o)) =
    Stands {
        sound = sound.zero,
        kept =
            (d, _) =>
                Held {
                    under = deeper_down(z, c, d, sound.under_zero, True/proved()),
                    agree = (_, _) => Eq/refl() } };

--- How a removal under the node `t` ended: the key was not there, the node was its leaf and nothing is left of it, or what is left of the node, which may stand where `t` did.
pub induct Removed(K: Type, use Key(K), V: Type, t: Node(K, V)): pub Type
| absent()
| gone()
| kept(n: Node(K, V), @stands: Stands(n, t))
end

--- The sound node `t` without the key whose encoding is `k`.
pub let remove(
    @K: Type,
    use Key(K),
    @V: Type,
    t: Node(K, V),
    k: Bytes,
    @sound: Sound(t),
) -> Removed(K, V, t) =
    match t
    | leaf(k0, _) =>
        match Hash/hash(k0) == k | true => Removed/gone() | false => Removed/absent() end
    | fork(c, z, o) =>
        match bit(k, c)
        | false =>
            match remove(z, k, @sound.zero)
            | absent() => Removed/absent()
            | gone() => Removed/kept(o, @one_left(c, z, o, sound))
            | kept(z2, @stands) =>
                Removed/kept(
                    Node/fork(c, z2, o),
                    @zero_side(c, z, o, z2, sound, stands.sound, stands.kept(c, sound.under_zero)))
            end
        | true =>
            match remove(o, k, @sound.one)
            | absent() => Removed/absent()
            | gone() => Removed/kept(z, @zero_left(c, z, o, sound))
            | kept(o2, @stands) =>
                Removed/kept(
                    Node/fork(c, z, o2),
                    @one_side(c, z, o, o2, sound, stands.sound, stands.kept(c, sound.under_one)))
            end
        end
    end;

--- `f` on every value, the keys and the forks as they were.
pub let map(@K: Type, @V: Type, @W: Type, t: Node(K, V), f: (V) -> W) -> Node(K, W) =
    match t
    | leaf(k, v) => Node/leaf(k, f(v))
    | fork(c, z, o) => Node/fork(c, map(z, f), map(o, f))
    end;

-- A node with its values rewritten has the first key it had.
let map_first(
    @K: Type,
    use Key(K),
    @V: Type,
    @W: Type,
    t: Node(K, V),
    f: (V) -> W,
) -> Eq()(first(map(t, f)), first(t)) =
    match t | leaf(_, _) => Eq/refl() | fork(_, z, _) => map_first(z, f) end;

-- A node with its values rewritten forks where it did.
let map_deeper(
    @K: Type,
    @V: Type,
    @W: Type,
    t: Node(K, V),
    f: (V) -> W,
    c: Nat,
    past: Holds(deeper(t, c)),
) -> Holds(deeper(map(t, f), c)) =
    match t | leaf(_, _) => True/qed() | fork(_, _, _) => past end;

--- A sound node with its values rewritten is sound.
pub let mapped(
    @K: Type,
    use Key(K),
    @V: Type,
    @W: Type,
    t: Node(K, V),
    f: (V) -> W,
    sound: Sound(t),
) -> Sound(map(t, f)) =
    match t
    | leaf(_, _) => True/qed()
    | fork(c, z, o) =>
        Forked {
            zero = mapped(z, f, sound.zero),
            one = mapped(o, f, sound.one),
            under_zero = map_deeper(z, f, c, sound.under_zero),
            under_one = map_deeper(o, f, c, sound.under_one),
            apart =
                Eq/subst(
                    (e: Bytes) => Apart(e, first(map(o, f)), c),
                    Eq/sym(map_first(z, f)),
                    Eq/subst(
                        (e: Bytes) => Apart(first(z), e, c),
                        Eq/sym(map_first(o, f)),
                        sound.apart)),
            clear =
                Eq/subst(
                    (e: Bytes) => Holds(Bool/not(bit(e, c))),
                    Eq/sym(map_first(z, f)),
                    sound.clear) }
    end;

--- The keys under a node, the zero side's first.
pub let keys(@K: Type, @V: Type, t: Node(K, V)) -> List(K) =
    match t | leaf(k, _) => [k] | fork(_, z, o) => [..keys(z), ..keys(o)] end;

--- The keys under a node appended to `acc`, the zero side's first: [`keys`] by one walk that builds its answer from the back.
pub let collect(@K: Type, @V: Type, t: Node(K, V), acc: List(K)) -> List(K) =
    match t | leaf(k, _) => [..acc, k] | fork(_, z, o) => collect(o, collect(z, acc)) end;

--- The walk leaves the node's keys behind what it began with.
pub let collected(
    @K: Type,
    @V: Type,
    t: Node(K, V),
    acc: List(K),
) -> Eq()(collect(t, acc), [..acc, ..keys(t)]) =
    match t
    | leaf(_, _) => Eq/refl()
    | fork(_, z, o) =>
        Eq/trans(
            Eq/cong((s: List(K)) => collect(o, s), collected(z, acc)),
            collected(o, [..acc, ..keys(z)]))
    end;

-- Every key under a sound node agrees with the node's first key through any bit the node forks past.
let within(
    @K: Type,
    use Key(K),
    @V: Type,
    t: Node(K, V),
    sound: Sound(t),
    c: Nat,
    past: Holds(deeper(t, c)),
    x: K,
    i: Member()(x, keys(t)),
    j: Nat,
    le: Holds(j <= c),
) -> Eq()(bit(Hash/hash(x), j), bit(first(t), j)) =
    match t
    | leaf(_, _) =>
        Member/uncons(
            i,
            (e) => Eq/cong((y: K) => bit(Hash/hash(y), j), e),
            (rest) => match Member/absent(rest) end)
    | fork(d, z, o) =>
        Member/split(
            keys(z),
            i,
            (in_zero) =>
                within(
                    z,
                    sound.zero,
                    c,
                    deeper_down(z, d, c, sound.under_zero, True/proved()),
                    x,
                    in_zero,
                    j,
                    le),
            (in_one) =>
                Eq/trans(
                    within(
                        o,
                        sound.one,
                        c,
                        deeper_down(o, d, c, sound.under_one, True/proved()),
                        x,
                        in_one,
                        j,
                        le),
                    Eq/sym(sound.apart.below(j, True/proved()))))
    end;

--- A key under the zero side of a sound fork is before every key under its one side, as `Bytes/ord` reads their encodings: the two are apart at the fork's bit, which the first has clear.
pub let across(
    @K: Type,
    use Key(K),
    @V: Type,
    c: Nat,
    z: Node(K, V),
    o: Node(K, V),
    sound: Sound(Node/fork(c, z, o)),
    x: K,
    y: K,
    in_zero: Member()(x, keys(z)),
    in_one: Member()(y, keys(o)),
) -> Eq()(Bytes/ord(Hash/hash(x), Hash/hash(y)), Ordering/lt()) =
    let from_zero: Apart(Hash/hash(x), first(o), c) =
        reheaded(
            first(z),
            Hash/hash(x),
            first(o),
            c,
            sound.apart,
            (j, le) => within(z, sound.zero, c, sound.under_zero, x, in_zero, j, le));
    before(
        Hash/hash(x),
        Hash/hash(y),
        c,
        turned(
            Hash/hash(y),
            Hash/hash(x),
            c,
            reheaded(
                first(o),
                Hash/hash(y),
                Hash/hash(x),
                c,
                turned(Hash/hash(x), first(o), c, from_zero),
                (j, le) => within(o, sound.one, c, sound.under_one, y, in_one, j, le))),
        Eq/subst(
            (v: Bool) => Holds(Bool/not(v)),
            Eq/sym(within(z, sound.zero, c, sound.under_zero, x, in_zero, c, True/qed())),
            sound.clear));

--- The keys under a sound node are in strict order, each before every one after it.
pub let ascending(
    @K: Type,
    use Key(K),
    @V: Type,
    t: Node(K, V),
    sound: Sound(t),
) -> Pairwise(Ord/lt((a: K, b: K) => Ord/ord(a, b)))(keys(t)) =
    match t
    | leaf(_, _) => Pairwise/cons((_, i) => match Member/absent(i) end, Pairwise/empty())
    | fork(c, z, o) =>
        Pairwise/joined(
            keys(z),
            ascending(z, sound.zero),
            ascending(o, sound.one),
            (x, y, i, j) =>
                Eq/subst(
                    (r: Ordering) => Holds(Ordering/is_lt(r)),
                    Eq/sym(Eq/trans(Key/monotone(x, y), across(c, z, o, sound, x, y, i, j))),
                    True/qed()))
    end;
