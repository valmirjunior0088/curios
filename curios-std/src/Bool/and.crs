pub use /sys/Bool/{and};

use /std/{Bool};

--- Two decisions that hold, as one: `a && b` holds where `a` does and `b` does. By cases on `a`, since `&&` reduces at each.
pub let both(a: Bool, b: Bool, p: Bool/Holds(a), q: Bool/Holds(b)) -> Bool/Holds(a && b) =
    match a
    | true => q
    | false => match p end
    end;

--- The first of two decisions that hold as one: `a` holds where `a && b` does. By cases on `a`, as [`both`] is.
pub let first(a: Bool, b: Bool, p: Bool/Holds(a && b)) -> Bool/Holds(a) =
    match a: (s) => (Bool/Holds(s && b)) -> Bool/Holds(s)
    | true => (_) => Bool/True/qed()
    | false => (h) => h
    end(p);

--- The second of them: `b` holds where `a && b` does.
pub let second(a: Bool, b: Bool, p: Bool/Holds(a && b)) -> Bool/Holds(b) =
    match a: (s) => (Bool/Holds(s && b)) -> Bool/Holds(b)
    | true => (h) => h
    | false => (h) => match h end
    end(p);
