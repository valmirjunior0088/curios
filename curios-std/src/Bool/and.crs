pub use /sys/Bool/{and};
use /std/{Bool};
use /std/Bool/{True, Holds};

--- Two decisions that hold, as one: `a && b` holds where `a` does and `b` does. By cases on `a`, since `&&` reduces at each.
pub let both(a: Bool, b: Bool, p: Holds(a), q: Holds(b)) -> Holds(a && b) =
    match a
    | true => q
    | false => match p end
    end;

--- The first of two decisions that hold as one: `a` holds where `a && b` does. By cases on `a`, as [`both`] is.
pub let first(a: Bool, b: Bool, p: Holds(a && b)) -> Holds(a) =
    match a: (s) => (Holds(s && b)) -> Holds(s)
    | true => (_) => True/qed()
    | false => (h) => h
    end(p);

--- The second of them: `b` holds where `a && b` does.
pub let second(a: Bool, b: Bool, p: Holds(a && b)) -> Holds(b) =
    match a: (s) => (Holds(s && b)) -> Holds(b)
    | true => (h) => h
    | false => (h) => match h end
    end(p);
