pub use /sys/Bool/{True};
pub use /sys/Bool/True/{qed};

--- `P`, a fact a term needs that no bound demands: the elaborator proves it from the facts in scope, or the program is refused naming them.
---
--- The proposition is written — `True/proved(@Holds(i < n))` — or pinned by the expectation, where the bound waits until it is and is proved then, from the facts the expression's own scope holds.
pub let proved(@P: Prop, @p: P) -> P =
    p;
