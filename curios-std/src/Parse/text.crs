use /std/{Str, Char, Nat, Bool, Bytes, Result, Option, Parse};
use /std/Bool/{Holds};
use /std/Parse/{Of, At, Pos, Input, Error};

--- What a text parser's positions know: that the input is valid text and that a character may begin at the position — a `Str/At`'s own facts, so a text primitive reads its string and its position back out of one.
pub struct Boundary(input: Bytes, offset: Nat): Prop {
    @valid: Str/Valid(input),
    @within: Holds(offset <= Bytes/len(input)),
    @boundary: Holds(Str/At/starts(Bytes/drop(input, offset, @within))),
}

--- A text parser walks its string's bytes, and its positions are the string's own.
satisfy Input(Str) {
    Admits(input, offset) = Boundary(input, offset),
    bytes(s) = s.bytes,
    start(s) =
        let first = Str/At/start(s);
        Boundary {},
}

--- The string a text parser's input is, read back out of a position in it.
let text(@input: Bytes, at: Pos(Str, input)) -> Str =
    Str { bytes = input, @valid = at.holds.valid };

--- Where a text parser stands, as a position of that string.
let position(@input: Bytes, at: Pos(Str, input)) -> Str/At(text(at)) =
    Str/At { offset = at.offset, @within = at.holds.within, @boundary = at.holds.boundary };

--- A position of the string, as one a text parser may stand at.
let back(@input: Bytes, at: Pos(Str, input), p: Str/At(text(at))) -> Pos(Str, input) =
    At { offset = p.offset, holds = Boundary { @valid = at.holds.valid } };

--- The next character; declines at the end of the input.
pub let char: Parse(Str, Char) =
    Of {
        run(_, at) =
            match Str/At/try_next(text(at), position(at))
            | none() => Result/failure(Error/declined("unexpected end of input", at.offset))
            | some(n) => Result/success((back(at, n.past), n.char))
            end,
    };

--- The next character when `pred` accepts it; declines otherwise, consuming nothing.
pub let char_if(pred: (Char) -> Bool) -> Parse(Str, Char) =
    Parse/bind(char, (c) =>
        match pred(c) | true => Parse/pure(c) | false => Parse/fail("unexpected character") end);

--- The character `expected`; declines on any other.
pub let expect(expected: Char) -> Parse(Str, Char) =
    let message = Str/flatten(["expected '", Str/of_char(expected), "'"]);
    Of {
        run(_, at) =
            match Str/At/try_next(text(at), position(at))
            | none() => Result/failure(Error/declined("unexpected end of input", at.offset))
            | some(n) =>
                match n.char == expected
                | true => Result/success((back(at, n.past), n.char))
                | false => Result/failure(Error/declined(message, at.offset))
                end
            end,
    };

--- The characters of `lit`, exactly; declines on anything else.
pub let literal(lit: Str) -> Parse(Str, {}) =
    let message = Str/flatten(["expected \"", lit, "\""]);
    Of {
        run(_, at) =
            match Str/follows(text(at), position(at), lit)
            | some(met) => Result/success((back(at, met.past), ()))
            | none() => Result/failure(Error/declined(message, at.offset))
            end,
    };

--- The longest run of characters `pred` accepts, possibly empty, as the piece of the input it is.
pub let take_while(pred: (Char) -> Bool) -> Parse(Str, Str) =
    Of {
        run(_, at) =
            let taken = Str/span(text(at), position(at), pred);
            Result/success((
                back(at, taken.past),
                Str/between(text(at), position(at), taken.past, @taken.reach))),
    };

--- The next character without consuming it, or `none` at the end of the input.
pub let peek: Parse(Str, Option(Char)) =
    Of {
        run(_, at) =
            Result/success((
                at,
                Option/map(Str/At/try_next(text(at), position(at)), (n) => n.char))),
    };

--- Everything from the current position to the end of the input.
pub let rest: Parse(Str, Str) =
    Of {
        run(_, at) =
            Result/success((back(at, Str/At/finish(text(at))), Str/after(text(at), position(at)))),
    };
