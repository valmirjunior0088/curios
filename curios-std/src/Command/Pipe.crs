use /std/{Io, Async, Handle};
use /std/Command/{Pipe};

--- Close this end.
pub let close(p: Pipe) -> Io({}) =
    Handle/close(p.0);

satisfy Async/Read(Async, Pipe) {
    read(p, n, @positive) = Async/Read/read(@Async, @Handle, p.0, n, @positive),
}

satisfy Async/Write(Async, Pipe) {
    write(p, b) = Async/Write/write(p.0, b),
    flush(p) = Async/Write/flush(p.0),
}
