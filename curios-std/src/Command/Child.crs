use /std/{Option, Try, Async, Io, Handle};
use /std/Command/{Pipe, Exit, Child};
use /std/Handle/{Interest};

--- The pipe to the child's standard input, when it was piped.
pub let stdin(c: Child) -> Option(Pipe) =
    c.stdin;

--- The pipe from the child's standard output, when it was piped.
pub let stdout(c: Child) -> Option(Pipe) =
    c.stdout;

--- The pipe from the child's standard error, when it was piped.
pub let stderr(c: Child) -> Option(Pipe) =
    c.stderr;

let close_pipe(p: Option(Pipe)) -> Io({}) =
    match p | some(p) => Pipe/close(p) | none() => Io/pure(()) end;

let close_pipes(c: Child) -> Io({}) =
    let _ = close_pipe(c.stdin)!;
    let _ = close_pipe(c.stdout)!;
    close_pipe(c.stderr);

--- End this child: `ok`, or the status of the failure.
foreign proc_kill(Handle) -> Nat;

--- The child ended if it still runs. A child the host could not signal is left as it is.
let killed(c: Child) -> Io({}) =
    let _ = proc_kill(c.handle)!;
    Io/pure(());

--- End the child if it still runs, and close its pipes.
pub let kill(c: Child) -> Io({}) =
    let _ = killed(c)!;
    close_pipes(c);

--- How this child ended: `ok` beside its exit code and the signal that ended it, or the status of the failure.
foreign proc_wait(Handle) -> {status: Nat, code: Nat, signal: Nat};

--- How the child ended, parking until it does. The pipes are closed with it, so read what it wrote before waiting for it.
pub let wait(c: Child) -> Try(Async, Io/Error, Exit) =
    let _ = Async/park([Async/Wait/ready(c.handle, Interest/readable)])!;
    let reply = proc_wait(c.handle)!;
    let _ = close_pipes(c)!;
    match reply.status == /sys/status/ok
    | true =>
        Try/pure(
            match reply.signal == 0
            | true => Exit/exited(reply.code)
            | false => Exit/signaled(reply.signal)
            end)
    | false => Try/raise(Io/Error/of(reply.status))
    end;

-- End the child if it still runs, then close its handle and its pipes. The kill is the last use of the handle, and the host reaps the process whether or not anything waits for it.
let release(c: Child) -> Io({}) =
    let _ = killed(c)!;
    let _ = Handle/close(c.handle)!;
    close_pipes(c);

--- `body` with the child killed and its handle released whichever way the task ends, so a child never outlives the bracket it was started in, and nothing it was filed under does either.
pub let with(@A: Type, c: Child, body: Try(Async, Io/Error, A)) -> Try(Async, Io/Error, A) =
    let outcome = Async/using(release(c), Try/run(body))!;
    let a = outcome!;
    Try/pure(a);
