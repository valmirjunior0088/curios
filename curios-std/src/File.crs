use /std/{Bytes, Nat, Str, Path, Try, Io};
use /std/internal/{Handle, error};

--- An open file.
pub struct File: Type {
    Handle,
}

--- How a file is opened: to read, to write from the start, or to append.
pub induct Mode: pub Type
--- Opened to read.
| read()
--- Opened to write from the start.
| write()
--- Opened to write after what is there.
| append()
end

--- The host's code for `mode`.
pub let of_mode(mode: Mode) -> Nat =
    match mode
    | read() => /sys/open_mode/read
    | write() => /sys/open_mode/write
    | append() => /sys/open_mode/append
    end;

--- Open the file at this path in this mode, one of `/sys/open_mode`'s codes: `ok` beside its handle, or the status of the failure.
foreign file_open(Bytes, Nat) -> {status: Nat, handle: Handle};

--- The file at `path`, opened in `mode` into `s`, which closes it when it ends.
pub let open(s: Io/Scope, path: Path, mode: Mode) -> Try(Io, Io/Error, File) =
    let reply = file_open(Path/to_bytes(path), of_mode(mode))!;
    match reply.status == /sys/status/ok
    | true =>
        let f = File { reply.handle };
        let _ = Io/Scope/defer(s, (_) => Io/close(f))!;
        Try/pure(f)
    | false => Try/raise(error(reply.status))
    end;

--- Close `f` before its scope ends. The scope's own close then finds nothing to close.
satisfy Io/Close(File) {
    close(f) = Io/close(f.0),
}

satisfy Io/Read(File) {
    read(f, n, @positive) = Io/read(@Handle, f.0, n, @positive),
}

satisfy Io/Write(File) {
    write(f, b) = Io/write(f.0, b),
    flush(f) = Io/flush(f.0),
}

let read_to_end(f: File) -> Try(Io, Io/Error, Bytes) =
    let go(acc: Bytes) -> Try(Io, Io/Error, Bytes) =
        let c = Io/read(f, 4096)!;
        match c | bytes(b) => go(x[..acc, ..b]) | ended() => Try/pure(acc) end;
    go(x[]);

--- The whole file at `path`.
pub let read_all(path: Path) -> Try(Io, Io/Error, Bytes) =
    Try/scope((s) => Try/bind(open(s, path, Mode/read()), read_to_end));

--- The whole file at `path` as text: `read_all`, its bytes read as UTF-8. Bytes that are not text are `not_text` with the length of their longest prefix that is.
pub let read_all_text(path: Path) -> Try(Io, Io/Error, Str) =
    let bytes = read_all(path)!;
    match Str/of_bytes(bytes)
    | success(text) => Try/pure(text)
    | failure(valid) => Try/raise(Io/Error/not_text(valid))
    end;

--- `b` as the whole file at `path`: created if absent, replaced if present.
pub let write_all(path: Path, b: Bytes) -> Try(Io, Io/Error, {}) =
    Try/scope((s) => Try/bind(open(s, path, Mode/write()), (f) => Io/write(f, b)));
