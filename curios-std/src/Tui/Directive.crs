use /std/{List, Io};

--- What an `update` asks the loop to do beside the new model.
pub induct Directive(E: Type): pub Type
--- Nothing.
| none()
--- Run this beside the loop, and hand its answer back as `Event/custom`.
| perform(Io(E))
--- Every one of these, in order.
| batch(List(Directive(E)))
--- Draw the next frame whole, whatever the terminal is known to show.
| redraw()
--- Run this with the terminal given back, and take it again once it answers: what a program hands its terminal to another program by. Its answer is handed back as `Event/custom`.
| release(Io(E))
--- End the program once the work this update asked for has answered. Work an earlier update asked for and still running is cancelled where it waits.
| quit()
end

pub use Directive/*;
