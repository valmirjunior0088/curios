use /std/{Nat, Bool, Str, Bytes, List, Byte};
use /std/Tui/{Color, Style, Mode};

--- `ESC [` and `body`.
pub let csi(body: Str) -> Bytes =
    x[0x1B, '[', ..Str/to_bytes(body)];

--- The cursor to column `x` of row `y`, both from zero.
pub let move_to(x: Nat, y: Nat) -> Bytes =
    csi(Str/flatten([Nat/to_str(y + 1), ";", Nat/to_str(x + 1), "H"]));

--- Clear the screen.
pub let clear: Bytes =
    csi("2J");

-- `m`'s number between `?` and `final`, as a DEC private mode's sequences are written.
let private(m: Mode, final: Str) -> Bytes =
    csi(Str/flatten(["?", Nat/to_str(Mode/number(m)), final]));

--- Set `m`.
pub let on(m: Mode) -> Bytes =
    private(m, "h");

--- Reset `m`.
pub let off(m: Mode) -> Bytes =
    private(m, "l");

--- Ask whether the terminal supports `m`, which it answers with a report of the mode.
pub let ask(m: Mode) -> Bytes =
    private(m, "$p");

--- Show the cursor.
pub let cursor_show: Bytes =
    csi("?25h");

--- Hide the cursor.
pub let cursor_hide: Bytes =
    csi("?25l");

--- Push the kitty keyboard protocol's enhancements, disambiguated keys alone: a key the legacy encoding cannot tell from another is sent in the protocol's form, and text stays text.
pub let keyboard_push: Bytes =
    csi(">1u");

--- Pop the enhancements `keyboard_push` pushed.
pub let keyboard_pop: Bytes =
    csi("<u");

--- Ask which enhancements of the kitty keyboard protocol are in force, which a terminal that speaks it answers.
pub let keyboard_ask: Bytes =
    csi("?u");

--- Ask for the terminal's primary device attributes, which every terminal answers.
pub let attributes_ask: Bytes =
    csi("c");

--- Every attribute off.
pub let reset: Bytes =
    csi("0m");

let color_params(c: Color, base: Nat) -> List(Str) =
    match c
    | default() => []
    | ansi(n) =>
        match n < 8
        | true => [Nat/to_str(base + n)]
        | false => [Nat/to_str(base + 60 + (n - 8))]
        end
    | indexed(b) => [Nat/to_str(base + 8), "5", Nat/to_str(Byte/to_nat(b))]
    | rgb(r, g, b) =>
        [
            Nat/to_str(base + 8),
            "2",
            Nat/to_str(Byte/to_nat(r)),
            Nat/to_str(Byte/to_nat(g)),
            Nat/to_str(Byte/to_nat(b))]
    end;

--- The whole of `s` as one attribute sequence, from a reset.
pub let sgr(s: Style) -> Bytes =
    let flag(on: Bool, code: Str) -> List(Str) = match on | true => [code] | false => [] end;
    csi(
        Str/concat(
            Str/join(
                ";",
                List/flatten([
                    ["0"],
                    color_params(s.fg, 30),
                    color_params(s.bg, 40),
                    flag(s.bold, "1"),
                    flag(s.dim, "2"),
                    flag(s.italic, "3"),
                    flag(s.underline, "4"),
                    flag(s.reverse, "7"),
                    flag(s.strike, "9")])),
            "m"));
