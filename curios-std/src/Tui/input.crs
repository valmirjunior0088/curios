use /std/{Nat, Str, Char, Byte, Bytes, List, Option};
use /std/Tui/{Key, Event};
use /std/Bool/{Holds};

let at(b: Bytes, i: Nat) -> Option(Nat) =
    Option/map(Bytes/try_get(b, i), Byte/to_nat);

let modified(code: Key/Code, m: Nat) -> Key =
    let bits = m - 1;
    Key {
        code = code,
        shift = Nat/and(bits, 1) > 0,
        alt = Nat/and(bits, 2) > 0,
        ctrl = Nat/and(bits, 4) > 0 };

-- The character of a code below the surrogates, which every code this decoder builds one from is.
let low(code: Nat, @below: Holds(code < 0xD800)) -> Char =
    Char { code = code, @valid = Char/Valid/below_surrogates(code, below) };

-- The key a control byte is. It is a byte's, which is what puts the letter or the sign it stands beside below the surrogates.
let control(n: Nat, @byte: Holds(n <= 255)) -> Key =
    choose
    | n == 0x0D => Key/plain(Key/Code/enter())
    | n == 0x09 => Key/plain(Key/Code/tab())
    | n == 0x7F => Key/plain(Key/Code/backspace())
    | n == 0x08 => Key/plain(Key/Code/backspace())
    | n == 0x1B => Key/plain(Key/Code/escape())
    | n == 0x00 => Key/with_ctrl(Key/Code/char(' '))
    | n <= 0x1A => Key/with_ctrl(Key/Code/char(low(n + 0x60)))
    | _ => Key/with_ctrl(Key/Code/char(low(n + 0x40)))
    end;

let tilde(n: Nat) -> Option(Key/Code) =
    match n
    | 1 => Option/some(Key/Code/home())
    | 2 => Option/some(Key/Code/insert())
    | 3 => Option/some(Key/Code/delete())
    | 4 => Option/some(Key/Code/end_key())
    | 5 => Option/some(Key/Code/page_up())
    | 6 => Option/some(Key/Code/page_down())
    | 7 => Option/some(Key/Code/home())
    | 8 => Option/some(Key/Code/end_key())
    | 11 => Option/some(Key/Code/f(1))
    | 12 => Option/some(Key/Code/f(2))
    | 13 => Option/some(Key/Code/f(3))
    | 14 => Option/some(Key/Code/f(4))
    | 15 => Option/some(Key/Code/f(5))
    | 17 => Option/some(Key/Code/f(6))
    | 18 => Option/some(Key/Code/f(7))
    | 19 => Option/some(Key/Code/f(8))
    | 20 => Option/some(Key/Code/f(9))
    | 21 => Option/some(Key/Code/f(10))
    | 23 => Option/some(Key/Code/f(11))
    | 24 => Option/some(Key/Code/f(12))
    | _ => Option/none()
    end;

let final_code(n: Nat) -> Option(Key/Code) =
    match n
    | 'A' => Option/some(Key/Code/up())
    | 'B' => Option/some(Key/Code/down())
    | 'C' => Option/some(Key/Code/right())
    | 'D' => Option/some(Key/Code/left())
    | 'H' => Option/some(Key/Code/home())
    | 'F' => Option/some(Key/Code/end_key())
    | 'P' => Option/some(Key/Code/f(1))
    | 'Q' => Option/some(Key/Code/f(2))
    | 'R' => Option/some(Key/Code/f(3))
    | 'S' => Option/some(Key/Code/f(4))
    | _ => Option/none()
    end;

let kitty(code: Nat) -> Option(Key/Code) =
    match code
    | 13 => Option/some(Key/Code/enter())
    | 27 => Option/some(Key/Code/escape())
    | 9 => Option/some(Key/Code/tab())
    | 127 => Option/some(Key/Code/backspace())
    | 8 => Option/some(Key/Code/backspace())
    | _ => Option/map(Char/of_nat(code), Key/Code/char)
    end;

--- The parameters of the control sequence whose parameter bytes begin at `i`, its final byte and where it ends, or `none` when the chunk ends first. Parameters read as ECMA-48 reads them: digits accumulate from zero, and an empty one is `none`, its default being each control function's to state. An empty last one is left out.
let parameters(b: Bytes, i: Nat) -> Option({nums: List(Option(Nat)), final: Nat, next: Nat}) =
    let go(
        j: Nat,
        current: Option(Nat),
        nums: List(Option(Nat)),
    ) -> Option({nums: List(Option(Nat)), final: Nat, next: Nat}) =
        match at(b, j)
        | none() => Option/none()
        | some(n) =>
            choose
            | Nat/in_range(n, '0', '9') =>
                go(j + 1, Option/some(Option/unwrap_or(current, 0) * 10 + (n - '0')), nums)
            | n == ';' || n == ':' => go(j + 1, Option/none(), [current, ..nums])
            | Nat/in_range(n, 0x20, 0x3F) => go(j + 1, current, nums)
            | Nat/in_range(n, 0x40, 0x7E) =>
                let all = match current | some(_) => [current, ..nums] | none() => nums end;
                Option/some((nums = List/reverse(all), final = n, next = j + 1))
            | _ => Option/none()
            end
        end;
    go(i, Option/none(), []);

induct Step(E: Type): Type
| emit(Option(Event(E)), Nat)
| cut()
end

let paste_end: Bytes =
    x[0x1B, '[', '2', '0', '1', '~'];

--- `input` as the events it encodes, up to the first sequence the chunk ends inside; that tail is `rest`, for the next chunk to complete.
pub let decode(@E: Type, input: Bytes) -> {events: List(Event(E)), rest: Bytes} =
    let key(k: Key) -> Option(Event(E)) = Option/some(Event/key(k));
    -- The character the byte at `i` begins and `more` bytes continue. The bytes are decided text as the bytes they are, so the text is known to hold them and has a first character.
    let scalar(i: Nat, more: Nat) -> Step(E) =
        match Nat/le/try(i + (more + 1), Bytes/len(input))
        | none() => Step/cut()
        | some(within) =>
            let piece = Bytes/slice(input, i, more + 1, @within);
            match Str/Valid/try(Str/Scan/lead(), piece)
            | none() => Step/emit(Option/none(), i + 1)
            | some(valid) =>
                let s = Str { bytes = piece, @valid = valid };
                let first = Str/At/next(s, Str/At/start(s));
                Step/emit(key(Key/plain(Key/Code/char(first.char))), i + (more + 1))
            end
        end;
    let paste(_: Nat, start: Nat) -> Step(E) =
        -- Where the end marker begins, at or after `start`, with room for all six of its bytes: past the last place that has room, the chunk ends inside the paste.
        let find(
            j: Nat,
            @onward: Holds(start <= j),
        ) -> Option(
            {at: Nat, onward: Holds(start <= at), room: Holds(at + 6 <= Bytes/len(input))}) =
            match Nat/le/try(j + 6, Bytes/len(input))
            | none() => Option/none()
            | some(room) =>
                match Bytes/slice(input, j, 6, @room) == paste_end
                | true => Option/some((at = j, onward = onward, room = room))
                | false => find(j + 1)
                end
            end;
        match find(start, @Nat/le/refl(start))
        | none() => Step/cut()
        | some(marker) =>
            let before = Bytes/slice(input, 0, marker.at);
            match Str/of_bytes(Bytes/drop(before, start, @marker.onward))
            | success(s) => Step/emit(Option/some(Event/paste(s)), marker.at + 6)
            | failure(_) => Step/emit(Option/none(), marker.at + 6)
            end
        end;
    let csi(i: Nat, j: Nat) -> Step(E) =
        match parameters(input, j)
        | none() => Step/cut()
        -- An omitted modifier is 1, no modifiers; the key a `~` or a `u` names has no default, both being private finals.
        | some(p) =>
            let parameter(k: Nat) -> Option(Nat) = Option/flatten(List/try_get(p.nums, k));
            let m = Option/unwrap_or(parameter(1), 1);
            choose
            | p.final == '~' =>
                match parameter(0)
                | none() => Step/emit(Option/none(), p.next)
                | some(n) =>
                    choose
                    | n == 200 => paste(i, p.next)
                    | some(code) = tilde(n) => Step/emit(key(modified(code, m)), p.next)
                    | _ => Step/emit(Option/none(), p.next)
                    end
                end
            | p.final == 'u' =>
                match Option/bind(parameter(0), kitty)
                | some(code) => Step/emit(key(modified(code, m)), p.next)
                | none() => Step/emit(Option/none(), p.next)
                end
            | some(code) = final_code(p.final) => Step/emit(key(modified(code, m)), p.next)
            | _ => Step/emit(Option/none(), p.next)
            end
        end;
    let ss3(j: Nat) -> Step(E) =
        match at(input, j)
        | none() => Step/cut()
        | some(n) =>
            match final_code(n)
            | some(code) => Step/emit(key(Key/plain(code)), j + 1)
            | none() => Step/emit(Option/none(), j + 1)
            end
        end;
    let escape(i: Nat) -> Step(E) =
        match Bytes/try_get(input, i + 1)
        | none() => Step/cut()
        | some(byte) =>
            let second = Byte/to_nat(byte);
            choose
            | second == '[' => csi(i, i + 2)
            | second == 'O' => ss3(i + 2)
            | second == 0x1B => Step/emit(key(Key/plain(Key/Code/escape())), i + 1)
            | Nat/in_range(second, 0x20, 0x7E) =>
                Step/emit(key(Key/with_alt(Key/Code/char(low(second)))), i + 2)
            | second < 0x20 || second == 0x7F =>
                Step/emit(key(Key { ..control(second), alt = true }), i + 2)
            | _ => Step/emit(key(Key/plain(Key/Code/escape())), i + 1)
            end
        end;
    let go(i: Nat, acc: List(Event(E))) -> {events: List(Event(E)), rest: Bytes} =
        match Nat/lt/try(i, Bytes/len(input))
        | none() => (events = List/reverse(acc), rest = x[])
        | some(inside) =>
            let head = Bytes/get(input, i, @inside);
            let n = Byte/to_nat(head);
            let step =
                choose
                | n == 0x1B => escape(i)
                | n < 0x20 || n == 0x7F => Step/emit(key(control(n)), i + 1)
                | _ =>
                    match Str/classify(head)
                    | ascii() => scalar(i, 0)
                    | lead(more, _, _, _) => scalar(i, more)
                    | bad() => Step/emit(Option/none(), i + 1)
                    end
                end;
            match step
            | cut() => (events = List/reverse(acc), rest = Bytes/drop(input, i))
            | emit(event, next) =>
                match event | some(e) => go(next, [e, ..acc]) | none() => go(next, acc) end
            end
        end;
    go(0, []);

--- `rest` once nothing more came: a leading Escape is the Escape key, and what follows is read again on its own.
pub let flush(@E: Type, rest: Bytes) -> List(Event(E)) =
    match rest
    | x[] => []
    | x[head, ..tail] =>
        let first: List(Event(E)) =
            match Byte/to_nat(head) == 0x1B
            | true => [Event/key(Key/plain(Key/Code/escape()))]
            | false => []
            end;
        let d = decode(tail);
        [..first, ..d.events, ..flush(d.rest)]
    end;
