use /std/{Nat, Str, List, Vec, Eq, Option};
use /std/Bool/{Holds};
use /std/Tui/{Style, Glyph, Line, Tile, View};

--- `h` rows of `w` tiles: what a view is drawn as, and what the renderer compares from one frame to the next.
pub let Frame(w: Nat, h: Nat) -> Type =
    Vec(Vec(Tile, w), h);

-- Pad with `fill` or cut, whichever the count calls for: fitting a frame into a box is this at both axes.
let padded(@T: Type, fill: T, m: Nat) -> (List(T)) -> List(T) =
    match m
    | 0 => (_) => []
    | _ + 1; ih => (l) => match l | [] => [fill, ..ih([])] | [h, ..t] => [h, ..ih(t)] end
    end;

-- Either arm adds exactly one element to a run the hypothesis already counted, so the count is the one asked for whatever the input was.
let padded_len(@T: Type, fill: T, m: Nat) -> (l: List(T)) -> Vec/Counted(padded(fill, m)(l), m) =
    match m
    | 0 => (_) => Eq/refl()
    | _ + 1; ih =>
        (l) =>
            match l
            | [] => Eq/cong((w: Nat) => w + 1, ih([]))
            | [_, ..t] => Eq/cong((w: Nat) => w + 1, ih(t))
            end
    end;

-- The elements at exactly `m`, which is where a frame's index is re-established after a list has carried it.
let resize(@T: Type, fill: T, m: Nat, l: List(T)) -> Vec(T, m) =
    Vec { list = padded(fill, m)(l), counted = padded_len(fill, m)(l) };

let drop_upto(@T: Type, l: List(T), k: Nat) -> List(T) =
    match k
    | 0 => l
    | _ + 1; ih => match ih | [] => [] | [_, ..rest] => rest end
    end;

-- What a run of tiles keeps of its wide glyphs: a wide glyph keeps its second column and that column its glyph, and a cut that parted the two shows a blank where either stood. Every tile answers one, so the run keeps its length.
let mended(row: List(Tile)) -> List(Tile) =
    let blank: Tile = Tile/blank;
    let start: {done: List(Tile), waiting: Option(Tile)} = (done = [], waiting = Option/none());
    let settled =
        List/fold(row, start, (tile, acc) =>
            let done = match acc.waiting | some(_) => [blank, ..acc.done] | none() => acc.done end;
            match tile
            | continuation() =>
                match acc.waiting
                | some(wide) => (done = [tile, wide, ..acc.done], waiting = Option/none())
                | none() => (done = [blank, ..acc.done], waiting = Option/none())
                end
            | glyph(g, _) =>
                match Glyph/width(g) == 2
                | true => (done = done, waiting = Option/some(tile))
                | false => (done = [tile, ..done], waiting = Option/none())
                end
            end);
    List/reverse(
        match settled.waiting | some(_) => [blank, ..settled.done] | none() => settled.done end);

-- A row of exactly `w` tiles from `tiles`, cut or padded with blanks, its wide glyphs mended where the cut parted one.
let row_of(w: Nat, tiles: List(Tile)) -> Vec(Tile, w) =
    resize(Tile/blank, w, mended(padded(Tile/blank, w)(tiles)));

let filled(g: Glyph, style: Style, w: Nat, h: Nat) -> Frame(w, h) =
    Vec/replicate(h, row_of(w, List/flatten(List/replicate(w, Tile/of_glyph(g, style)))));

let line(style: Style, l: Line) -> Frame(Line/width(l), 1) =
    let tiles = List/flatten(List/map(l.glyphs, (g) => Tile/of_glyph(g, style)));
    Vec/cons(row_of(Line/width(l), tiles), Vec/nil());

let beside(@w1: Nat, @w2: Nat, @h: Nat, a: Frame(w1, h), b: Frame(w2, h)) -> Frame(w1 + w2, h) =
    Vec/map(Vec/zip(a, b), (r) => Vec/append(r.0, r.1));

let above(@w: Nat, @h1: Nat, @h2: Nat, a: Frame(w, h1), b: Frame(w, h2)) -> Frame(w, h1 + h2) =
    Vec/append(a, b);

let fit(@w0: Nat, @h0: Nat, frame: Frame(w0, h0), w: Nat, h: Nat) -> Frame(w, h) =
    resize(row_of(w, []), h, List/map(Vec/to_list(frame), (r) => row_of(w, Vec/to_list(r))));

let crop(@w: Nat, @h: Nat, frame: Frame(w, h), x: Nat, y: Nat) -> Frame(w - x, h - y) =
    resize(
        row_of(w - x, []),
        h - y,
        List/map(
            drop_upto(Vec/to_list(frame), y),
            (r) => row_of(w - x, drop_upto(Vec/to_list(r), x))));

let overlay(
    @w: Nat,
    @h: Nat,
    @w1: Nat,
    @h1: Nat,
    base: Frame(w, h),
    top: Frame(w1, h1),
    x: Nat,
    y: Nat,
) -> Frame(w, h) =
    let patches = List/map(Vec/to_list(top), Vec/to_list);
    let splice(index: Nat, under: List(Tile)) -> List(Tile) =
        match List/try_get(patches, index - y)
        | none() => under
        | some(patch) =>
            match y <= index
            | false => under
            | true =>
                List/flatten([List/take(under, x), patch, drop_upto(under, x + List/len(patch))])
            end
        end;
    resize(
        row_of(w, []),
        h,
        List/map(
            List/zip(List/range(0, h), Vec/to_list(base)),
            (r: {Nat, Vec(Tile, w)}) => row_of(w, splice(r.0, Vec/to_list(r.1)))));

let restyle(@w: Nat, @h: Nat, f: (Style) -> Style, frame: Frame(w, h)) -> Frame(w, h) =
    Vec/map(frame, (row) =>
        Vec/map(row, (tile) =>
            match tile | glyph(g, s) => Tile/glyph(g, f(s)) | continuation() => tile end));

--- `v` drawn: the tiles every reading of a view agrees on.
pub let of_view(@w: Nat, @h: Nat, v: View(w, h)) -> Frame(w, h) =
    match v
    | filled(g, style, fw, fh) => filled(g, style, fw, fh)
    | line(style, l) => line(style, l)
    | beside(left, right) => beside(of_view(left), of_view(right))
    | above(top, bottom) => above(of_view(top), of_view(bottom))
    | fit(inner, fw, fh) => fit(of_view(inner), fw, fh)
    | crop(inner, x, y) => crop(of_view(inner), x, y)
    | over(base, top, x, y) => overlay(of_view(base), of_view(top), x, y)
    | styled(f, inner) => restyle(f, of_view(inner))
    | with_cursor(inner, _) => of_view(inner)
    end;

--- `w` by `h` of blanks.
pub let blank(w: Nat, h: Nat) -> Frame(w, h) =
    filled(Glyph/space, Style/plain, w, h);

--- The frame as text, one string per row. A continuation contributes nothing, so a wide glyph reads back as itself.
pub let to_lines(@w: Nat, @h: Nat, frame: Frame(w, h)) -> List(Str) =
    List/map(
        Vec/to_list(frame),
        (r) =>
            Str/flatten(
                List/map(
                    Vec/to_list(r),
                    (tile) =>
                        match tile | glyph(g, _) => Glyph/text(g) | continuation() => "" end)));

--- The tile at `x`, `y`, under the evidence that both are within the frame.
pub let get(
    @w: Nat,
    @h: Nat,
    frame: Frame(w, h),
    x: Nat,
    y: Nat,
    @ok_x: Holds(x < w),
    @ok_y: Holds(y < h),
) -> Tile =
    Vec/get(@Tile, @w, Vec/get(@Vec(Tile, w), @h, frame, y, @ok_y), x, @ok_x);
