use /std/{Nat, Char, Spell, Bool};
use /std/ops/{Eql};

--- A character, or a named key, as the kitty keyboard protocol names them. The End key is `end_key`, since `end` is a reserved word.
pub induct Code: pub Type
--- A character key.
| char(Char)
| enter()
| escape()
| backspace()
| tab()
| delete()
| insert()
| up()
| down()
| left()
| right()
| home()
| end_key()
| page_up()
| page_down()
--- A function key, by its number: F1 to F35, the keys the protocol names.
| f(n: Nat, @from: Bool/Holds(1 <= n), @to: Bool/Holds(n <= 35))
end

pub use Code/*;

satisfy Eql(Code) {
    ..
}

satisfy Spell(Code) {
    ..
}
