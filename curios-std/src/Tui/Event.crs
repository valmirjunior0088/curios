use /std/{Spell};
use /std/ops/{Eql};
use /std/Tui/{Input};

--- What reaches a program's `update`: what its terminal sent, or a value of its own `E`, the answer a `Directive/perform` came back with.
pub induct Event(E: Type): pub Type
--- What the terminal sent.
| input(Input)
--- What a `Directive/perform` came back with.
| custom(E)
end

pub use Event/*;

satisfy (@E: Type, use Eql(E)) => Eql(Event(E)) {
    ..
}

satisfy (@E: Type, use Spell(E)) => Spell(Event(E)) {
    ..
}
