use /std/{Nat, Bool, Str, Char};
use /std/Tui/{Style, Line, View, Pane, Key};

--- A line of text and a cursor within it, at a position of the text rather than a count of its characters, and always where an extended grapheme cluster begins: the cursor moves, and the text is cut, a cluster at a time.
pub struct Field: pub Type {
    text: Str,
    cursor: Str/At(text),
}

--- No text.
pub let empty: Field =
    Field { text = "", cursor = Str/At/start("") };

--- `s` with the cursor at its end.
pub let of_str(s: Str) -> Field =
    Field { text = s, cursor = Str/At/finish(s) };

-- `left` and `right` joined, with the cursor between them.
let joined(left: Str, right: Str) -> Field =
    Field {
        text = Str/concat(left, right),
        cursor = Str/At/of_left(left, right, Str/At/finish(left)) };

--- `s` put in at the cursor, the cursor after it: what a typed character and a paste are.
pub let insert(i: Field, s: Str) -> Field =
    joined(Str/concat(Str/before(i.text, i.cursor), s), Str/after(i.text, i.cursor));

-- The field with its cursor at `at`.
let moved(i: Field, at: Str/At(i.text)) -> Field =
    Field { text = i.text, cursor = at };

-- Where the cluster before `at` begins, or `at` where none is before it.
let back(s: Str, at: Str/At(s)) -> Str/At(s) =
    match Str/At/try_prev_grapheme(s, at) | some(b) => b.past | none() => at end;

-- Where the cluster at `at` ends, or `at` where none begins there.
let forth(s: Str, at: Str/At(s)) -> Str/At(s) =
    match Str/At/try_next_grapheme(s, at) | some(f) => f.past | none() => at end;

-- Whether the cluster that begins at `at` is a space between words.
let spaced(s: Str, at: Str/At(s)) -> Bool =
    match Str/At/try_next(s, at) | some(n) => Char/is_whitespace(n.char) | none() => false end;

-- Where the word before `at` begins: back over the spaces before it, then over the word.
let word_back(s: Str, at: Str/At(s)) -> Str/At(s) =
    Str/At/backward(
        (_) => (Bool) -> Str/At(s),
        (here, again) =>
            (in_word) =>
                match Str/At/try_prev_grapheme(s, here)
                | none() => here
                | some(b) =>
                    let blank = spaced(s, b.past);
                    match in_word && blank
                    | true => here
                    | false => again(b.past, b.progress)(in_word || Bool/not(blank))
                    end
                end,
        at)(false);

-- Where the word at or after `at` ends: on over the spaces before it, then over the word.
let word_forth(s: Str, at: Str/At(s)) -> Str/At(s) =
    Str/At/forward(
        (_) => (Bool) -> Str/At(s),
        (here, again) =>
            (in_word) =>
                match Str/At/try_next_grapheme(s, here)
                | none() => here
                | some(f) =>
                    let blank = spaced(s, here);
                    match in_word && blank
                    | true => here
                    | false => again(f.past, f.progress)(in_word || Bool/not(blank))
                    end
                end,
        at)(false);

-- What a key with Ctrl does, as readline has it: A and E to either end, B and F a cluster back and on, K and U the text cut to either end, and W the word before the cursor cut.
let controlled(i: Field, c: Char) -> Field =
    choose
    | c == 'a' => moved(i, Str/At/start(i.text))
    | c == 'e' => moved(i, Str/At/finish(i.text))
    | c == 'b' => moved(i, back(i.text, i.cursor))
    | c == 'f' => moved(i, forth(i.text, i.cursor))
    | c == 'k' => of_str(Str/before(i.text, i.cursor))
    | c == 'u' => joined("", Str/after(i.text, i.cursor))
    | c == 'w' =>
        joined(Str/before(i.text, word_back(i.text, i.cursor)), Str/after(i.text, i.cursor))
    | _ => i
    end;

-- What a key with Alt does, as readline has it: B and F a word back and on.
let alternate(i: Field, c: Char) -> Field =
    choose
    | c == 'b' => moved(i, word_back(i.text, i.cursor))
    | c == 'f' => moved(i, word_forth(i.text, i.cursor))
    | _ => i
    end;

--- What `k` does to the field: a character put in, a cluster cut before or after the cursor, the cursor moved a cluster or to either end, and the keys readline gives Ctrl and Alt. A key with Super, and any other, leaves the field.
pub let handle(i: Field, k: Key) -> Field =
    choose
    | k.super => i
    | k.ctrl => match k.code | char(c) => controlled(i, c) | _ => i end
    | k.alt => match k.code | char(c) => alternate(i, c) | _ => i end
    | _ =>
        match k.code
        | char(c) => insert(i, Str/of_char(c))
        | backspace() =>
            joined(Str/before(i.text, back(i.text, i.cursor)), Str/after(i.text, i.cursor))
        | delete() =>
            joined(Str/before(i.text, i.cursor), Str/after(i.text, forth(i.text, i.cursor)))
        | left() => moved(i, back(i.text, i.cursor))
        | right() => moved(i, forth(i.text, i.cursor))
        | home() => moved(i, Str/At/start(i.text))
        | end_key() => moved(i, Str/At/finish(i.text))
        | _ => i
        end
    end;

-- How many columns `s` takes, as a view shows it.
let columns(s: Str) -> Nat =
    Line/width(Line/of_str(s));

--- The leftmost position of `s` a view of `room` columns may start at and still hold everything from there to `at`: walking back from `at`, a cluster joins the view while the view has room for it.
let scrolled(s: Str, at: Str/At(s), room: Nat) -> Str/At(s) =
    Str/At/backward(
        (_) => (Nat) -> Str/At(s),
        (here, again) =>
            (used) =>
                match Str/At/try_prev_grapheme(s, here)
                | none() => here
                | some(b) =>
                    let wider = used + columns(Str/between(s, b.past, here));
                    match wider <= room
                    | true => again(b.past, b.progress)(wider)
                    | false => here
                    end
                end,
        at)(0);

--- The text in `style` on the first row, scrolled so the cursor is in view, and the terminal's cursor asked for where the field's stands.
pub let view(i: Field, style: Style) -> Pane =
    (w, h) =>
        let first = scrolled(i.text, i.cursor, w - 1);
        let shown = View/fit(View/text(style, Str/after(i.text, first)), w, h);
        let x = columns(Str/before(i.text, i.cursor)) - columns(Str/before(i.text, first));
        match x < w && 0 < h
        | true => View/with_cursor(shown, View/Point(w, h) { x = x, y = 0 })
        | false => shown
        end;
