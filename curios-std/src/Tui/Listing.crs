use /std/{Nat, Str, List, Option};
use /std/Tui/{Style, View, Pane, Key};
use /std/Bool/{Holds};

--- Items with one selected, or none when there are no items.
pub struct Listing: pub Type {
    items: List(Str),
    cursor: Option({i: Nat, ok: Holds(i < List/len(items))}),
}

let at(items: List(Str), i: Nat) -> Option({i: Nat, ok: Holds(i < List/len(items))}) =
    match Nat/lt/try(i, List/len(items))
    | none() => Option/none()
    | some(ok) => Option/some((i = i, ok = ok))
    end;

--- `items` with the first selected.
pub let new(items: List(Str)) -> Listing =
    Listing { items = items, cursor = at(items, 0) };

--- The selected index, or `none`.
pub let index(l: Listing) -> Option(Nat) =
    Option/map(l.cursor, (c) => c.i);

--- The selected item, or `none`.
pub let selected(l: Listing) -> Option(Str) =
    Option/map(l.cursor, (c) => List/get(@Str, l.items, c.i, @c.ok));

--- Up, down, home and end move the selection; any other key leaves it. A move past either end is not taken.
pub let move(l: Listing, code: Key/Code) -> Listing =
    match l.cursor
    | none() => l
    | some(c) =>
        let to(i: Nat) -> Listing =
            match at(l.items, i)
            | none() => l
            | some(next) => Listing { ..l, cursor = Option/some(next) }
            end;
        match code
        | up() => match c.i | 0 => l | p + 1 => to(p) end
        | down() => to(c.i + 1)
        | home() => to(0)
        | end_key() => to(List/len(l.items) - 1)
        | _ => l
        end
    end;

--- The items as rows, the selected one in `highlight`, scrolled so the selection is in view. A listing with nothing selected highlights no row and draws from the top.
pub let view(l: Listing, style: Style, highlight: Style) -> Pane =
    (w, h) =>
        let chosen = index(l);
        let first =
            match chosen
            | some(i) => match i < h | true => 0 | false => i + 1 - h end
            | none() => 0
            end;
        let shown =
            List/take(
                List/drop_while(
                    List/zip(List/range(0, List/len(l.items)), l.items),
                    (e) => e.0 < first),
                h);
        let row(entry: {Nat, Str}) -> View(w, 1) =
            let s = match chosen == Option/some(entry.0) | true => highlight | false => style end;
            View/fit(View/text(s, entry.1), w, 1);
        let none: {h: Nat, view: View(w, h)} = (h = 0, view = View/blank(w, 0));
        let stacked =
            List/fold(
                List/reverse(List/map(shown, row)),
                none,
                (r, acc) => (h = 1 + acc.h, view = View/above(r, acc.view)));
        View/fit(stacked.view, w, h);
