use /std/{Nat, Bytes, Bool, List, Option, Result, Eq, Io, Try, Tty};
use /std/Bool/{True};
use /std/Io/{Reader};
use /std/time/{Duration};
use /std/Tui/{Frame, View, Input, Mode, render, ansi};

struct Held: Type {
    w: Nat,
    h: Nat,
    frame: Frame(w, h),
}

--- A terminal taken: what it remembers between draws and reads.
pub struct Session: Type {
    tty: Tty,
    input: Reader(Tty),
    previous: Option(Held),
    size: Tty/Size,
}

let entering: Bytes =
    x[
        ..ansi/on(Mode/alternate_screen()),
        ..ansi/cursor_hide,
        ..ansi/on(Mode/bracketed_paste()),
        ..ansi/keyboard_push];

-- The modes `entering` sets, undone in reverse: the host writes these when the terminal is given back, however the program ends.
let leaving: Bytes =
    x[
        ..ansi/keyboard_pop,
        ..ansi/off(Mode/bracketed_paste()),
        ..ansi/cursor_show,
        ..ansi/off(Mode/alternate_screen())];

--- The controlling terminal taken for the rest of `s`: raw mode, the alternate screen, the hidden cursor, bracketed paste and the kitty keyboard flag, each undone in reverse when `s` ends, however it ends.
pub let enter(s: Io/Scope) -> Try(Io, Io/Error, Session) =
    let t = Tty/open(s)!;
    let _ = Tty/raw(s, t, leaving)!;
    let first = Tty/size(t)!;
    let input = Reader/new(t)!;
    let _ = Io/write(t, entering)!;
    Try/pure(Session { tty = t, input = input, previous = Option/none(), size = first });

--- The terminal's size now, together with the session remembering it.
pub let size(s: Session) -> Try(Io, Io/Error, {Session, Tty/Size}) =
    let now = Tty/size(s.tty)!;
    Try/pure((resized(s, now), now));

--- Remember a size received through a resize event.
pub let resized(s: Session, now: Tty/Size) -> Session =
    Session { ..s, size = now };

--- The size last read.
pub let last_size(s: Session) -> Io(Tty/Size) =
    Io/pure(s.size);

--- `v` written as the difference from the previous frame where the size is unchanged and whole where it is not, the terminal's cursor where `v` asks for it or hidden.
pub let draw(@w: Nat, @h: Nat, s: Session, v: View(w, h)) -> Io(Session) =
    let frame = Frame/of_view(v);
    let before: Option(Frame(w, h)) =
        match s.previous
        | none() => Option/none()
        | some(p) =>
            match p.w == w && p.h == h
            | true =>
                let as_wide =
                    Eq/subst(
                        (n: Nat) => Frame(n, p.h),
                        Nat/eq_of_eql(p.w, w, True/proved()),
                        p.frame);
                Option/some(
                    Eq/subst(
                        (n: Nat) => Frame(w, n),
                        Nat/eq_of_eql(p.h, h, True/proved()),
                        as_wide))
            | false => Option/none()
            end
        end;
    let _ = Try/run(Io/write(s.tty, render(before, frame, View/cursor(v))))!;
    Io/pure(Session { ..s, previous = Option/some(Held { w = w, h = h, frame = frame }) });

-- One arrival of input and the inputs it completes, what it leaves undecoded staying held: the state is whether the arrival has come.
let burst(arrived: Bool, held: Bytes) -> Reader/Step(Bool, {}, List(Input)) =
    match arrived
    | false => Reader/Step/more(true, held)
    | true =>
        let decoded = Input/decode(held);
        Reader/Step/took(decoded.inputs, decoded.rest)
    end;

--- The next burst of input, waiting until one arrives; `none` once standard input has ended. A read that fails is raised, the one a burst opens with and the one it waits on for the rest of a key alike.
pub let read(s: Session) -> Try(Io, Io/Error, Option(List(Input))) =
    -- A take of the reader is an `Io` action by its declaration, which is what a `Try` region embeds it by.
    let arrival: Io(Result(Reader/Stop(Bool, {}), List(Input))) =
        Reader/take(s.input, burst, false);
    let got = arrival!;
    match got
    | failure(stop) =>
        match stop | failed(_, why) => Try/raise(why) | _ => Try/pure(Option/none()) end
    | success(inputs) =>
        let rest = Reader/held(s.input)!;
        match Bytes/len(rest) == 0: (_) => Try(Io, Io/Error, Option(List(Input)))
        | true => Try/pure(Option/some(inputs))
        | false =>
            let more = Io/timeout(Duration/of_millis(30), arrival)!;
            match more
            | some(success(settled)) => Try/pure(Option/some([..inputs, ..settled]))
            | some(failure(failed(_, why))) => Try/raise(why)
            | _ =>
                -- Nothing more came: what is held is read as it stands, and taken.
                let flushing: Io(Result(Reader/Stop({}, {}), List(Input))) =
                    Reader/take(
                        s.input,
                        (_: {}, held: Bytes) => Reader/Step/took(Input/flush(held).inputs, x[]),
                        ());
                let flushed = flushing!;
                Try/pure(
                    Option/some([
                        ..inputs,
                        ..match flushed | success(last) => last | failure(_) => [] end]))
            end
        end
    end;
