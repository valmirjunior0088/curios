use /std/{Nat, Bytes, Bool, List, Option, Result, Io, Try, Tty};
use /std/Io/{Reader};
use /std/Io/Reader/{Step, Stop};
use /std/time/{Duration};
use /std/Tui/{Frame, Event, input, render, ansi};

struct Held: Type {
    w: Nat,
    h: Nat,
    frame: Frame(w, h),
}

--- A terminal taken: what it remembers between draws and reads.
pub struct Session: Type {
    tty: Tty,
    input: Reader(Io/Input),
    previous: Option(Held),
    size: Tty/Size,
}

let enter: Io({}) =
    Io/write(Io/stdout, x[
        ..ansi/alternate_on,
        ..ansi/cursor_hide,
        ..ansi/paste_on,
        ..ansi/kitty_push]);

let leave: Io({}) =
    Io/write(Io/stdout, x[
        ..ansi/kitty_pop,
        ..ansi/paste_off,
        ..ansi/cursor_show,
        ..ansi/alternate_off]);

--- The bracket: raw mode, the alternate screen, the hidden cursor, bracketed paste and the kitty keyboard flag, each undone in reverse whichever way `body` ends.
pub let with(@A: Type, body: (Session) -> Try(Io, Io/Error, A)) -> Try(Io, Io/Error, A) =
    let t = Tty/stdin;
    Tty/with_raw(
        t,
        let first = Tty/size(t)!;
        let input = Reader/new(Io/stdin)!;
        let s = Session { tty = t, input = input, previous = Option/none(), size = first };
        let _ = enter!;
        let outcome = Io/using((_) => leave, Try/run(body(s)))!;
        let a = outcome!;
        Try/pure(a));

--- The terminal's size now, together with the session remembering it.
pub let size(s: Session) -> Try(Io, Io/Error, {Session, Tty/Size}) =
    let now = Tty/size(s.tty)!;
    Try/pure((resized(s, now), now));

--- Remember a size received through a resize event.
pub let resized(s: Session, now: Tty/Size) -> Session =
    Session { ..s, size = now };

--- The size last read.
pub let last_size(s: Session) -> Io(Tty/Size) =
    Io/pure(s.size);

--- `frame` written as the difference from the previous one where the size is unchanged, and whole where it is not.
pub let draw(
    @w: Nat,
    @h: Nat,
    s: Session,
    frame: Frame(w, h),
    cursor: Option({x: Nat, y: Nat}),
) -> Io(Session) =
    let before: Option(Frame(w, h)) =
        match s.previous
        | none() => Option/none()
        | some(p) =>
            match p.w == w && p.h == h
            | true => Option/some(Frame/fit(p.frame, w, h))
            | false => Option/none()
            end
        end;
    let _ = Io/write(Io/stdout, render(before, frame, cursor))!;
    Io/pure(Session { ..s, previous = Option/some(Held { w = w, h = h, frame = frame }) });

-- One arrival of input and the events it completes, what it leaves undecoded staying held: the state is whether the arrival has come.
let burst(@E: Type, arrived: Bool, held: Bytes) -> Step(Bool, {}, List(Event(E))) =
    match arrived
    | false => Step/more(true, held)
    | true =>
        let decoded = input/decode(@E, held);
        Step/took(decoded.events, decoded.rest)
    end;

--- The next burst of input as events, waiting until one arrives; `none` once standard input has ended. A read that fails is raised, the one a burst opens with and the one it waits on for the rest of a key alike.
pub let read(@E: Type, s: Session) -> Try(Io, Io/Error, Option(List(Event(E)))) =
    -- A take of the reader is an `Io` action by its declaration, which is what a `Try` region embeds it by.
    let arrival: Io(Result(Stop(Bool, {}), List(Event(E)))) =
        Reader/take(s.input, (arrived: Bool, held: Bytes) => burst(@E, arrived, held), false);
    let got = arrival!;
    match got
    | failure(stop) =>
        match stop | failed(_, why) => Try/raise(why) | _ => Try/pure(Option/none()) end
    | success(events) =>
        let rest = Reader/held(s.input)!;
        match Bytes/len(rest) == 0: (_) => Try(Io, Io/Error, Option(List(Event(E))))
        | true => Try/pure(Option/some(events))
        | false =>
            let more = Io/timeout(Duration/of_millis(30), arrival)!;
            match more
            | some(success(settled)) => Try/pure(Option/some([..events, ..settled]))
            | some(failure(failed(_, why))) => Try/raise(why)
            | _ =>
                -- Nothing more came: what is held is read as it stands, and taken.
                let flushing: Io(Result(Stop({}, {}), List(Event(E)))) =
                    Reader/take(
                        s.input,
                        (_: {}, held: Bytes) => Step/took(input/flush(@E, held), x[]),
                        ());
                let flushed = flushing!;
                Try/pure(
                    Option/some([
                        ..events,
                        ..match flushed | success(last) => last | failure(_) => [] end]))
            end
        end
    end;
