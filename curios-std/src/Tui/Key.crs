--- A character, or a named key.
pub mod Code;
pub use Code/{let Code};

use /std/{Bool, Spell};
use /std/ops/{Eql};

--- A code and the modifiers held with it — Shift, Alt, Ctrl and Super — as the kitty keyboard protocol reports them, the lock keys left out.
pub struct Key: pub Type {
    code: Code,
    shift: Bool,
    alt: Bool,
    ctrl: Bool,
    super: Bool,
}

satisfy Eql(Key) {
    ..
}

satisfy Spell(Key) {
    ..
}

--- `code` with no modifier.
pub let plain(code: Code) -> Key =
    Key { code = code, shift = false, alt = false, ctrl = false, super = false };

--- `code` with Ctrl.
pub let with_ctrl(code: Code) -> Key =
    Key { ..plain(code), ctrl = true };

--- `code` with Alt.
pub let with_alt(code: Code) -> Key =
    Key { ..plain(code), alt = true };
