use /sys/{Bool};

pub concept Add(A : Type) : Type {
    add(A, A) -> A
}

pub concept Sub(A : Type) : Type {
    sub(A, A) -> A
}

pub concept Mul(A : Type) : Type {
    mul(A, A) -> A
}

pub concept Div(A : Type) : Type {
    div(A, A) -> A
}

pub concept Rem(A : Type) : Type {
    rem(A, A) -> A
}

pub concept And(A : Type) : Type {
    and(A, A) -> A
}

pub concept Or(A : Type) : Type {
    or(A, A) -> A
}

pub concept Eql(A : Type) : Type {
    eql(A, A) -> Bool
}

pub concept Cmp(A : Type) : Type {
    lt(A, A) -> Bool,
    lte(A, A) -> Bool,
    gt(A, A) -> Bool,
    gte(A, A) -> Bool
}

pub concept Monad(M : (Type) -> Type) : Type {
    pure(@A : Type, A) -> M(A),
    bind(@A : Type, @B : Type, M(A), (A) -> M(B)) -> M(B)
}

pub mod True;
pub use True/{let True};

pub mod False;
pub use False/{let False};

pub mod Char;
pub use Char/{let Char};

pub mod Str;
pub use Str/{let Str};
