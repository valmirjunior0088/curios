use /std/{Nat, Byte, Bytes, Bln};

pub induct Class : pub Type
| ascii()
| lead(Nat, Nat, Nat, Nat)
| bad()
end

pub let classify(c : Byte) -> Class =
    let n = Byte/to_nat(c);
    match
    | Nat/in_range(n, 0x00, 0x7F) => Class/ascii()
    | Nat/in_range(n, 0xC2, 0xDF) => Class/lead(1, 0x80, 0xBF, n - 0xC0)
    | Nat/in_range(n, 0xE0, 0xEF) =>
        let lo = match | n == 0xE0 => 0xA0 | _ => 0x80 end;
        let hi = match | n == 0xED => 0x9F | _ => 0xBF end;
        Class/lead(2, lo, hi, n - 0xE0)
    | Nat/in_range(n, 0xF0, 0xF4) =>
        let lo = match | n == 0xF0 => 0x90 | _ => 0x80 end;
        let hi = match | n == 0xF4 => 0x8F | _ => 0xBF end;
        Class/lead(3, lo, hi, n - 0xF0)
    | _ => Class/bad()
    end;

pub induct Scan : pub Type
| lead()
| cont(Nat, Nat, Nat)
| bad()
end

pub let step(c : Byte, s : Scan) -> Scan =
    let n = Byte/to_nat(c);
    match s
    | bad() => Scan/bad()
    | cont(rem, lo, hi) =>
        match
        | Bln/not(Nat/in_range(n, lo, hi)) => Scan/bad()
        | rem == 1 => Scan/lead()
        | _ => Scan/cont(rem - 1, 0x80, 0xBF)
        end
    | lead() =>
        match classify(c)
        | ascii() => Scan/lead()
        | lead(cont, lo, hi, _) => Scan/cont(cont, lo, hi)
        | bad() => Scan/bad()
        end
    end;

pub induct Utf8 : (s : Scan, b : Bytes) -> pub Prop
| stop() : (Scan/lead(), x\)
| more(c : Byte, st : Scan, t : Bytes, rest : Utf8(step(c, st), t))
    : (st, Bytes/cons(c, t))
end

pub let Valid(b : Bytes) -> Prop =
    Utf8(Scan/lead(), b);

pub struct Str : pub Type {
    bytes : Bytes,
    valid : Valid(bytes)
}
