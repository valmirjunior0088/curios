use /std/{Bytes, Str, Nat, Handle, Result, Async, Io};
use /std/tcp/{resolve, Socket};

pub struct Listener: Type {
    Handle,
}

let bind_listen(addr: Bytes) -> Io(Result(Listener, Handle/Error)) =
    let s = /sys/socket(addr)!;
    match s.status == /sys/Status/ok
    | true =>
        let _ = /sys/set_reuseaddr(s.handle, true)!;
        let bound = /sys/bind(s.handle, addr)!;
        match bound == /sys/Status/ok
        | true =>
            let status = /sys/listen(s.handle, 128)!;
            match status == /sys/Status/ok
            | true =>
                let nb = Async/nonblocking(s.handle)!;
                match nb
                | failure(e) =>
                    let _ = /sys/close(s.handle)!;
                    Io/pure(Result/failure(e))
                | success(_) => Io/pure(Result/success(Listener { s.handle }))
                end
            | false =>
                let _ = /sys/close(s.handle)!;
                Io/pure(Result/failure(Handle/error_of(status)))
            end
        | false =>
            let _ = /sys/close(s.handle)!;
            Io/pure(Result/failure(Handle/error_of(bound)))
        end
    | false => Io/pure(Result/failure(Handle/error_of(s.status)))
    end;

let listen(host: Str, port: Nat) -> Async(Result(Listener, Handle/Error)) =
    let resolved = resolve(host, port)!;
    match resolved
    | failure(e) => Async/pure(Result/failure(e))
    | success(addr) => Async/lift(bind_listen(addr))
    end;

-- A body of its own, so its sequencing does not hoist into `listen_loop`'s region ahead of the
-- `using` that owns the listener's lifetime.
let accept_loop(l: Listener, on_conn: (Handle) -> Async({})) -> Async({}) =
    rec go() -> Async({}) =
        let r = Async/accept(l.0)!;
        match r
        | failure(_) => Async/pure(())
        | success(h) =>
            let _ = on_conn(h)!;
            go()
        end;
    go();

let listen_loop(
    host: Str,
    port: Nat,
    on_conn: (Handle) -> Async({}),
) -> Async(Result({}, Handle/Error)) =
    let opened = listen(host, port)!;
    match opened
    | failure(e) => Async/pure(Result/failure(e))
    | success(l) =>
        let _ = Async/using(l.0, /sys/close(l.0), accept_loop(l, on_conn))!;
        Async/pure(Result/success(()))
    end;

let serve_conn(h: Handle, handler: (Socket) -> Async({})) -> Async({}) =
    let nb = Async/lift(Async/nonblocking(h))!;
    match nb
    | failure(_) =>
        -- The connection cannot be served without non-blocking mode; drop it rather than stalling the scheduler on it.
        Async/lift(/sys/close(h))
    | success(_) => Async/go(Async/using(h, /sys/close(h), handler(Socket/new(h))))
    end;

pub let serve(
    host: Str,
    port: Nat,
    handler: (Socket) -> Async({}),
) -> Async(Result({}, Handle/Error)) =
    listen_loop(host, port, (h) => serve_conn(h, handler));

let serve_tls_conn(h: Handle, cfg: Handle, handler: (Socket) -> Async({})) -> Async({}) =
    let status = Async/lift(/sys/start_tls_server(h, cfg))!;
    match status == /sys/Status/ok
    | true => Async/using(h, /sys/close(h), handler(Socket/new(h)))
    | false => Async/lift(/sys/close(h))
    end;

pub let serve_tls(
    host: Str,
    port: Nat,
    cert: Bytes,
    key: Bytes,
    handler: (Socket) -> Async({}),
) -> Async(Result({}, Handle/Error)) =
    let cfg = Async/lift(/sys/tls_server_config(cert, key))!;
    match cfg.status == /sys/Status/ok
    | true =>
        Async/using(
            cfg.handle,
            /sys/close(cfg.handle),
            listen_loop(host, port, (h) => serve_tls_conn(h, cfg.handle, handler)))
    | false => Async/pure(Result/failure(Handle/error_of(cfg.status)))
    end;
