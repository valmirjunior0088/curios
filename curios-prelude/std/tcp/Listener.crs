use /std/{Bytes, Str, Nat, Io, Result, Async};
use /std/tcp/{resolve, Socket};

pub struct Listener : Type { Io }

let bind_listen(addr : Bytes) -> Result(Listener, Io/Error) =
    let s = /sys/Io/socket(addr);
    match s.status == /sys/Io/Status/ok : Result(Listener, Io/Error)
    | false => Result/failure(Io/error_of(s.status))
    | true =>
        let _ = /sys/Io/set_reuseaddr(s.handle, true);
        let bound = /sys/Io/bind(s.handle, addr);
        match bound == /sys/Io/Status/ok : Result(Listener, Io/Error)
        | false =>
            let _ = /sys/Io/close(s.handle);
            Result/failure(Io/error_of(bound))
        | true =>
            let status = /sys/Io/listen(s.handle, 128);
            match status == /sys/Io/Status/ok : Result(Listener, Io/Error)
            | false =>
                let _ = /sys/Io/close(s.handle);
                Result/failure(Io/error_of(status))
            | true =>
                let _ = Async/nonblocking(s.handle);
                Result/success(Listener { s.handle })
            end
        end
    end;

let listen(host : Str, port : Nat) -> Async(Result(Listener, Io/Error)) =
    Async/bind(resolve(host, port), (resolved) =>
        match resolved : Async(Result(Listener, Io/Error))
        | failure(e) => Async/pure(Result/failure(e))
        | success(addr) => Async/pure(bind_listen(addr))
        end);

let listen_loop(host : Str, port : Nat, on_conn : (Io) -> Async({})) -> Async(Result({}, Io/Error)) =
    Async/bind(listen(host, port), (opened) =>
        match opened : Async(Result({}, Io/Error))
        | failure(e) => Async/pure(Result/failure(e))
        | success(l) =>
            Async/bind(
                Async/using(l.0, () => /sys/Io/close(l.0),
                    rec go() -> Async({}) =
                        Async/bind(Async/accept(l.0), (r) =>
                            match r : Async({})
                            | failure(_) => Async/pure(())
                            | success(h) => Async/bind(on_conn(h), (_) => go())
                            end);
                    go()),
                (_) => Async/pure(Result/success(())))
        end);

pub let serve(host : Str, port : Nat, handler : (Socket) -> Async({})) -> Async(Result({}, Io/Error)) =
    Async/defer(() =>
        listen_loop(host, port, (h) =>
            let _ = Async/nonblocking(h);
            Async/go(() => Async/using(h, () => /sys/Io/close(h), handler(Socket/of(h))))));

pub let serve_tls(host : Str, port : Nat, cert : Bytes, key : Bytes, handler : (Socket) -> Async({})) -> Async(Result({}, Io/Error)) =
    Async/defer(() =>
        let cfg = /sys/Io/tls_server_config(cert, key);
        match cfg.status == /sys/Io/Status/ok : Async(Result({}, Io/Error))
        | false => Async/pure(Result/failure(Io/error_of(cfg.status)))
        | true =>
            Async/using(cfg.handle, () => let _ = /sys/Io/close(cfg.handle); (),
                listen_loop(host, port, (h) =>
                    let status = /sys/Io/start_tls_server(h, cfg.handle);
                    match status == /sys/Io/Status/ok : Async({})
                    | true => Async/using(h, () => /sys/Io/close(h), handler(Socket/of(h)))
                    | false =>
                        let _ = /sys/Io/close(h);
                        Async/pure(())
                    end))
        end);
