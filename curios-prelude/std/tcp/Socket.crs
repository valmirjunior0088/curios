use /std/{Bytes, Str, Nat, Bool, Io, Result, Option, Async};
use /std/tcp/{Settings, resolve};
use /std/time/{Duration};

pub struct Socket : Type { Io }

pub let of(h : Io) -> Socket =
    Socket { h };

pub let read(c : Socket, n : Nat) -> Async(Io/Read) =
    Async/read(c.0, n);

pub let write(c : Socket, b : Bytes) -> Async(Result({}, Io/Error)) =
    Async/write(c.0, b);

let configure(h : Io, settings : Settings) -> {} =
    let _ = /sys/Io/set_recv_timeout(h, Option/unwrap_or(Option/map(settings.read_timeout, Duration/to_millis), 0));
    let _ = /sys/Io/set_send_timeout(h, Option/unwrap_or(Option/map(settings.write_timeout, Duration/to_millis), 0));
    ();

let upgrade(h : Io, host : Str, tls : Bool) -> Nat =
    match tls : Nat
    | false => /sys/Io/Status/ok
    | true => /sys/Io/start_tls(h, Str/to_bytes(host))
    end;

let connect_addr(settings : Settings, host : Str, addr : Bytes) -> Result(Socket, Io/Error) =
    let s = /sys/Io/socket(addr);
    match s.status == /sys/Io/Status/ok : Result(Socket, Io/Error)
    | false => Result/failure(Io/error_of(s.status))
    | true =>
        let _ = configure(s.handle, settings);
        let status = /sys/Io/connect(s.handle, addr);
        match status == /sys/Io/Status/ok : Result(Socket, Io/Error)
        | false =>
            let _ = /sys/Io/close(s.handle);
            Result/failure(Io/error_of(status))
        | true =>
            let upgraded = upgrade(s.handle, host, settings.tls);
            match upgraded == /sys/Io/Status/ok : Result(Socket, Io/Error)
            | false =>
                let _ = /sys/Io/close(s.handle);
                Result/failure(Io/error_of(upgraded))
            | true =>
                let _ =
                    match settings.tls : {}
                    | false => Async/nonblocking(s.handle)
                    | true => ()
                    end;
                Result/success(Socket { s.handle })
            end
        end
    end;

let connect_socket(settings : Settings, host : Str, port : Nat) -> Async(Result(Socket, Io/Error)) =
    Async/bind(resolve(host, port), (resolved) =>
        match resolved : Async(Result(Socket, Io/Error))
        | failure(e) => Async/pure(Result/failure(e))
        | success(addr) => Async/pure(connect_addr(settings, host, addr))
        end);

pub let connect(settings : Settings, host : Str, port : Nat) -> Async(Result(Socket, Io/Error)) =
    Async/defer(() =>
        Async/bind(connect_socket(settings, host, port), (opened) =>
            match opened : Async(Result(Socket, Io/Error))
            | failure(e) => Async/pure(Result/failure(e))
            | success(c) =>
                Async/bind(Async/acquire(c.0, () => /sys/Io/close(c.0)), (_) => Async/pure(Result/success(c)))
            end));

pub let close(c : Socket) -> Async({}) =
    Async/release(c.0);

pub let with(@A : Type, settings : Settings, host : Str, port : Nat, f : (Socket) -> Async(A)) -> Async(Result(A, Io/Error)) =
    Async/bind(connect(settings, host, port), (opened) =>
        match opened : Async(Result(A, Io/Error))
        | failure(e) => Async/pure(Result/failure(e))
        | success(c) =>
            Async/bind(f(c), (a) =>
                Async/bind(close(c), (_) => Async/pure(Result/success(a))))
        end);

let drain(c : Socket) -> Async(Bytes) =
    Async/drain((n) => read(c, n));

pub let call(settings : Settings, host : Str, port : Nat, request : Bytes) -> Async(Result(Bytes, Io/Error)) =
    with(settings, host, port, (c) =>
        Async/bind(write(c, request), (_) => drain(c)));
