use /std/{Bytes, Str, Nat, Bool, Handle, Result, Option, Async, Io};
use /std/tcp/{Settings, resolve};
use /std/time/{Duration};

pub struct Socket: Type {
    Handle,
}

-- `Listener` is a sibling, so it cannot reach this representation; the constructor is the public seam through which it wraps an accepted handle.
pub let new(h: Handle) -> Socket =
    Socket { h };

pub let read(c: Socket, n: Nat) -> Async(Handle/Read) =
    Async/read(c.0, n);

pub let write(c: Socket, b: Bytes) -> Async(Result({}, Handle/Error)) =
    Async/write(c.0, b);

let configure(h: Handle, settings: Settings) -> Io({}) =
    let _ =
        /sys/socket/set_recv_timeout(
            h,
            Option/unwrap_or(Option/map(settings.read_timeout, Duration/to_millis), 0))!;
    let _ =
        /sys/socket/set_send_timeout(
            h,
            Option/unwrap_or(Option/map(settings.write_timeout, Duration/to_millis), 0))!;
    Io/pure(());

let upgrade(h: Handle, host: Str, tls: Bool) -> Io(Nat) =
    match tls
    | true => /sys/tls/start(h, Str/to_bytes(host))
    | false => Io/pure(/sys/status/ok)
    end;

-- Every step here is a syscall and none of them suspends, so this is an `Io` chain the caller lifts
-- into a single `Async` step rather than a fiber that could yield partway through connecting.
let connect_addr(settings: Settings, host: Str, addr: Bytes) -> Io(Result(Socket, Handle/Error)) =
    let s = /sys/socket/open(addr)!;
    match s.status == /sys/status/ok
    | true =>
        let _ = configure(s.handle, settings)!;
        let status = /sys/socket/connect(s.handle, addr)!;
        match status == /sys/status/ok
        | true =>
            let upgraded = upgrade(s.handle, host, settings.tls)!;
            match upgraded == /sys/status/ok
            | true =>
                -- A TLS stream is driven by rustls, not polled at the socket layer, so it is left blocking on purpose.
                match settings.tls
                | true => Io/pure(Result/success(Socket { s.handle }))
                | false =>
                    let nb = Async/nonblocking(s.handle)!;
                    match nb
                    | failure(e) =>
                        let _ = /sys/Handle/close(s.handle)!;
                        Io/pure(Result/failure(e))
                    | success(_) => Io/pure(Result/success(Socket { s.handle }))
                    end
                end
            | false =>
                let _ = /sys/Handle/close(s.handle)!;
                Io/pure(Result/failure(Handle/error_of(upgraded)))
            end
        | false =>
            let _ = /sys/Handle/close(s.handle)!;
            Io/pure(Result/failure(Handle/error_of(status)))
        end
    | false => Io/pure(Result/failure(Handle/error_of(s.status)))
    end;

let connect_socket(
    settings: Settings,
    host: Str,
    port: Nat,
) -> Async(Result(Socket, Handle/Error)) =
    let resolved = resolve(host, port)!;
    match resolved
    | failure(e) => Async/pure(Result/failure(e))
    | success(addr) => Async/lift(connect_addr(settings, host, addr))
    end;

pub let connect(settings: Settings, host: Str, port: Nat) -> Async(Result(Socket, Handle/Error)) =
    let opened = connect_socket(settings, host, port)!;
    match opened
    | failure(e) => Async/pure(Result/failure(e))
    | success(c) =>
        let _ = Async/acquire(c.0, /sys/Handle/close(c.0))!;
        Async/pure(Result/success(c))
    end;

pub let close(c: Socket) -> Async({}) =
    Async/release(c.0);

pub let with(
    @A: Type,
    settings: Settings,
    host: Str,
    port: Nat,
    f: (Socket) -> Async(A),
) -> Async(Result(A, Handle/Error)) =
    let opened = connect(settings, host, port)!;
    match opened
    | failure(e) => Async/pure(Result/failure(e))
    | success(c) =>
        let a = f(c)!;
        let _ = close(c)!;
        Async/pure(Result/success(a))
    end;

let drain(c: Socket) -> Async(Result(Bytes, Handle/Error)) =
    Async/drain((n) => read(c, n));

-- `with` wraps the body's own failure channel in its connect/close one; flatten collapses the two so a caller sees one channel whichever stage failed.
pub let call(
    settings: Settings,
    host: Str,
    port: Nat,
    request: Bytes,
) -> Async(Result(Bytes, Handle/Error)) =
    Async/map(
        with(
            settings,
            host,
            port,
            (c) =>
                let w = write(c, request)!;
                match w | success(_) => drain(c) | failure(e) => Async/pure(Result/failure(e)) end),
        (r) => Result/flatten(r));
