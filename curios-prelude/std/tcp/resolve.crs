use /std/{Str, Nat, Bytes, Io, Result, Option, Lst, Async};

pub let resolve(host : Str, port : Nat) -> Async(Result(Bytes, Io/Error)) =
    let r = /sys/Io/lookup(Str/to_bytes(host), port);
    match r.status == /sys/Io/Status/ok : Async(Result(Bytes, Io/Error))
    | false => Async/pure(Result/failure(Io/error_of(r.status)))
    | true =>
        Async/using(r.handle, () => /sys/Io/close(r.handle),
            Async/bind(Async/wait(r.handle, /sys/Io/Poll/read), (_) =>
                let a = /sys/Io/resolve(r.handle);
                match a.status == /sys/Io/Status/ok : Async(Result(Bytes, Io/Error))
                | false => Async/pure(Result/failure(Io/error_of(a.status)))
                | true => Async/pure(Result/success(Option/unwrap_or(Lst/get(a.addresses, 0), x\)))
                end))
    end;
