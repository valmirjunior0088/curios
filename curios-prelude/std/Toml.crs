-- TOML 1.0.0 codec over native `Int` and binary32 `Flt`.
--
-- Public contract:
--   decode : (Str) -> Result(Map(Toml), Str) — consumes exactly one complete TOML 1.0.0 document (trailing non-trivia input is rejected) and builds the root table, enforcing table-construction semantics: duplicate keys, table redefinition, sealed inline tables, table/value and table/array conflicts, appending to static arrays, invalid parent selection through arrays of tables, and dotted-key redefinitions are all errors.
--   encode : (Map(Toml)) -> Result(Str, Str) — emits one deterministic document in the map's structural order (root key/value lines first, then table sections; tables inside arrays as inline tables). It fails, rather than emitting invalid TOML, on a non-UTF-8 map key or an invalid calendar/clock/offset value. Every emitted document decodes back to the same value, modulo the implementation-defined NaN encoding.
--
-- Numeric policy — all conversion is codec-owned; `Nat/of_str` and `Flt/of_str` are never used, so no accepted lexeme can silently wrap:
--   Integers live in the boxed-i31 envelope, exactly -1073741824 through 1073741823 in every radix. Each accumulation step first compares the accumulator against a per-radix wrap-safety ceiling (floor((2^32 - 1 - maxdigit) / radix), a source-time constant), so the u32 carrier computes the next magnitude exactly; the magnitude is then compared exactly against the sign-specific bound.
--   Finite floats honor at most nine significant decimal digits, accumulated exactly in `Nat`; further fraction digits are discarded and further integer digits shift the decimal exponent. Decimal exponents saturate at +/-2000 (binary32 overflows to infinity / underflows to zero well before that bound), and the significand is scaled by repeated binary32 multiplication — deterministic, not correctly rounded. `inf`, `nan`, and signed zero use explicit `Flt/of_le_bytes` bit patterns, never arithmetic; `-nan` maps to the single implementation-defined NaN encoding.
--
-- Product limits: integer range is the i31 envelope (narrower than TOML's recommended 64-bit support); finite floats are binary32 with the nine-digit, not-correctly-rounded conversion above; NaN payload and sign are implementation-defined. Calendar types are owned here because `/std/time` is monotonic-only; `offset_minutes` covers RFC 3339's -23:59 through +23:59, and `nanosecond` truncates (never rounds) past nine fractional digits.

use /std/{Nat, Int, Flt, Bool, Byte, Bytes, Char, Str, Lst, Map, Option, Result, Parse};

-- ===================== data model =====================

pub struct Date : pub Type {
    year : Nat,
    month : Nat,
    day : Nat
}

pub struct Time : pub Type {
    hour : Nat,
    minute : Nat,
    second : Nat,
    nanosecond : Nat
}

pub struct OffsetDateTime : pub Type {
    date : Date,
    time : Time,
    offset_minutes : Int
}

pub struct LocalDateTime : pub Type {
    date : Date,
    time : Time
}

pub induct Toml : pub Type
| str(Str)
| int(Int)
| flt(Flt)
| bool(Bool)
| offset_date_time(OffsetDateTime)
| local_date_time(LocalDateTime)
| local_date(Date)
| local_time(Time)
| arr(Lst(Toml))
| table(Map(Toml))
end

pub use Toml/*;


-- Construction state for the semantic fold. Declared here, not in `Build`, because `Decode` folds statements into a `Build` and reads its root map: the representation has to be transparent across this subtree, and nowhere else. A resolved path segment: `at` carries the array-of-tables element index the segment addresses, so repeated `[[a]]` elements have distinct side-table keys.
induct Seg : Type
| plain(Str)
| at(name : Str, index : Nat)
end

-- Construction metadata for a path in the side table. Plain values and static arrays get no entry: their presence in the root rejects duplicates, and the absence of `many()` is what seals a static array.
induct State : Type
| header()
| implicit()
| dotted()
| inline()
| many()
end

struct Build : Type {
    root : Map(Toml),
    side : Map(State),
    scope : Lst(Seg)
}

-- Every stage below is private: the scanners, escape tables, numeric ladders and table-construction rules are implementation, visible throughout this subtree and nowhere else. Only the two entry points are re-exported.
mod calendar;
mod build;
mod scan;
mod strings;
mod keys;
mod numbers;
mod datetime;
mod values;

mod decode;
pub use decode/{decode};

mod encode;
pub use encode/{encode};
