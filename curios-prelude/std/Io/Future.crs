use /std/{Option, Cell, Io};
use /std/Io/{Offer};

--- A value filled once and read as often as asked, beside the cell its filling fills for whatever waits on it.
pub struct Future(A: Type): Type {
    value: Cell(A),
    filled: Cell({}),
}

--- A future nothing has filled yet.
pub let new(@A: Type) -> Io(Future(A)) =
    let value = Cell/new()!;
    let filled = Cell/new()!;
    Io/pure(Future { value = value, filled = filled });

--- The value, once there is one.
pub let poll(@A: Type, f: Future(A)) -> Io(Option(A)) =
    Cell/poll(f.value);

--- Fill `f` with `a`, and wake whatever waits on it. A second filling is dropped, so the first value stands.
pub let fill(@A: Type, f: Future(A), a: A) -> Io({}) =
    let taken = Cell/fill(f.value, a)!;
    match taken
    | true => Io/bind(Cell/fill(f.filled, ()), (_) => Io/pure(()))
    | false => Io/pure(())
    end;

--- An offer that yields the value once there is one.
pub let offer(@A: Type, f: Future(A)) -> Offer(A) =
    Offer/new(poll(f), Io/pure(Offer/on_filled([f.filled])));

--- The value, waiting until there is one.
pub let wait(@A: Type, f: Future(A)) -> Io(A) =
    Io/select([offer(f)]);
