-- Strictly-positive naturals, as a `BigNat` paired with a proof that its packed
-- representation is nonempty (`is_cons(magnitude.rep)`). The record is transparent:
-- the accompanying proof, not an opaque wrapper, is what enforces the invariant, so
-- `.magnitude` is directly usable by consumers (e.g. `BigInt`). Operations delegate
-- to `BigNat` over the magnitude and transport the nonzero certificate through the
-- same raw ripple-carry the `BigNat` op runs, so the algebraic lemma corpus is a
-- one-line delegation each.

use /std/{Bool, Bits, Order, Eq, False, True, Show};
use /std/Bool/{false_neq_true};
use /std/Bits/{cons};
use /std/Order/{cong_flip};
use /std/BigNat/{BigNat, of_bits, of_trimmed_bits, is_trimmed, is_trimmed_of_canonical,
    trim, trim_of_trimmed, view, add, add_raw, add_raw_trimmed, succ, succ_raw, succ_raw_trimmed,
    mul, mul_raw, cmp, combine, xor3, maj3,
    add_comm, add_assoc, mul_comm, mul_assoc, distrib_l, cmp_refl, cmp_eq, cmp_flip, cmp_trans};

-- nonzero certificate: the (canonical) rep is nonempty. A plain match (no fold),
-- so it reduces on any cons-headed rep, even one with an opaque tail.
pub let is_cons(rep : Bits) -> Prop =
    match rep | b\ => False | b\_\.._ => True end;

pub struct NonZero : pub Type {
    magnitude : BigNat,
    non_zero  : is_cons(magnitude.rep),
}

pub let non_zero_eq(a : NonZero, b : NonZero, p : Eq(a.magnitude, b.magnitude)) -> Eq(a, b) =
    Eq/subst((m : BigNat) => (nz : is_cons(m.rep)) -> Eq(a, NonZero { magnitude = m, non_zero = nz }),
             p,
             (nz : is_cons(a.magnitude.rep)) => Eq/refl())(b.non_zero);

pub let nz_trimmed(t : NonZero) -> Eq(is_trimmed(t.magnitude.rep), true) =
    is_trimmed_of_canonical(t.magnitude.rep, t.magnitude.canonical);

let cons_low_trimmed(low : Bool, rep : Bits, tr : Eq(is_trimmed(rep), true), ne : is_cons(rep))
    -> Eq(is_trimmed(cons(low, rep)), true) =
    match rep | b\ => False/absurd(ne) | b\_\.._ => tr end;

-- is_cons transports along the of_bits trim, given the raw is trimmed and cons-headed
pub let raw_non_zero(rep : Bits, tr : Eq(is_trimmed(rep), true), ne : is_cons(rep))
    -> is_cons(of_bits(rep).rep) =
    Eq/subst((w : Bits) => is_cons(w), Eq/sym(trim_of_trimmed(rep, tr)), ne);

-- add_raw of a cons-headed left operand is cons-headed
let add_raw_cons(x : Bits, y : Bits, c : Bool, ne : is_cons(x)) -> is_cons(add_raw(x, y, c)) =
    match x : (r) => is_cons(add_raw(r, y, c))
    | b\ => False/absurd(ne)
    | b\xh\..xt =>
        match y : (yy) => is_cons(add_raw(cons(xh, xt), yy, c))
        | b\ => True/qed()
        | b\_\.._ => True/qed()
        end
    end;

-- succ_raw is always cons-headed (succ_raw(b\) = cons(true, b\))
let succ_raw_cons(x : Bits) -> is_cons(succ_raw(x)) =
    match x : (r) => is_cons(succ_raw(r))
    | b\ => True/qed()
    | b\xh\..xt => match xh | true => True/qed() | false => True/qed() end
    end;

-- combine / trim-head helpers for the mul-nonzero proof
let combine_non_zero(h : Bool, w : Bits, ne : is_cons(w)) -> is_cons(combine(h, w)) =
    match w | b\ => False/absurd(ne) | b\_\.._ => True/qed() end;

let combine_true_non_zero(w : Bits) -> is_cons(combine(true, w)) =
    match w | b\ => True/qed() | b\_\.._ => True/qed() end;

let trim_head_non_zero(h : Bool, r : Bits, ne : is_cons(trim(r))) -> is_cons(trim(cons(h, r))) =
    combine_non_zero(h, trim(r), ne);

let trim_head_true(r : Bits) -> is_cons(trim(cons(true, r))) =
    combine_true_non_zero(trim(r));

rec carry_non_zero(x : Bits) -> is_cons(trim(add_raw(b\, x, true))) =
    match x
    | b\ => True/qed()
    | b\xh\..xt =>
        match xh
        | false => trim_head_true(add_raw(b\, xt, false))
        | true => trim_head_non_zero(false, add_raw(b\, xt, true), carry_non_zero(xt))
        end
    end;

rec add_trim_non_zero(a : Bits, b : Bits, c : Bool,
    tr : Eq(is_trimmed(a), true), ne : is_cons(a)) -> is_cons(trim(add_raw(a, b, c))) =
    match a
    | b\ => False/absurd(ne)
    | b\ah\..at =>
        match at
        | b\ =>
            match ah
            | false => False/absurd(false_neq_true(tr))
            | true =>
                match b
                | b\ => match c | false => True/qed() | true => True/qed() end
                | b\bh\..bt =>
                    match bh
                    | false =>
                        match c
                        | false => trim_head_true(add_raw(b\, bt, false))
                        | true => trim_head_non_zero(false, add_raw(b\, bt, true), carry_non_zero(bt))
                        end
                    | true =>
                        match c
                        | false => trim_head_non_zero(false, add_raw(b\, bt, true), carry_non_zero(bt))
                        | true => trim_head_true(add_raw(b\, bt, true))
                        end
                    end
                end
            end
        | b\ath\..att =>
            match b
            | b\ => trim_head_non_zero(xor3(ah, false, c), add_raw(at, b\, maj3(ah, false, c)),
                add_trim_non_zero(at, b\, maj3(ah, false, c), tr, True/qed()))
            | b\bh\..bt => trim_head_non_zero(xor3(ah, bh, c), add_raw(at, bt, maj3(ah, bh, c)),
                add_trim_non_zero(at, bt, maj3(ah, bh, c), tr, True/qed()))
            end
        end
    end;

rec mul_raw_trim_cons(p : Bits, q : Bits,
    tp : Eq(is_trimmed(p), true), np : is_cons(p),
    tq : Eq(is_trimmed(q), true), nq : is_cons(q)) -> is_cons(trim(mul_raw(p, q))) =
    match p
    | b\ => False/absurd(np)
    | b\ph\..pt =>
        match ph
        | false =>
            match pt
            | b\ => False/absurd(false_neq_true(tp))
            | b\_\.._ => trim_head_non_zero(false, mul_raw(pt, q),
                mul_raw_trim_cons(pt, q, tp, True/qed(), tq, nq))
            end
        | true => add_trim_non_zero(q, cons(false, mul_raw(pt, q)), false, tq, nq)
        end
    end;

-- ===================== smart constructors =====================

pub let non_zero_one : NonZero =
    NonZero { magnitude = of_trimmed_bits(cons(true, b\), Eq/refl()), non_zero = True/qed() };

pub let non_zero_o(t : NonZero) -> NonZero =
    NonZero {
        magnitude = of_trimmed_bits(cons(false, t.magnitude.rep),
            cons_low_trimmed(false, t.magnitude.rep, nz_trimmed(t), t.non_zero)),
        non_zero = True/qed(),
    };

pub let non_zero_i(t : NonZero) -> NonZero =
    NonZero {
        magnitude = of_trimmed_bits(cons(true, t.magnitude.rep),
            cons_low_trimmed(true, t.magnitude.rep, nz_trimmed(t), t.non_zero)),
        non_zero = True/qed(),
    };

-- ===================== operations =====================

pub let non_zero_add(p : NonZero, q : NonZero) -> NonZero =
    NonZero { magnitude = add(p.magnitude, q.magnitude),
        non_zero = raw_non_zero(add_raw(p.magnitude.rep, q.magnitude.rep, false),
            add_raw_trimmed(p.magnitude.rep, q.magnitude.rep, false, nz_trimmed(p), nz_trimmed(q)),
            add_raw_cons(p.magnitude.rep, q.magnitude.rep, false, p.non_zero)) };

pub let non_zero_succ(p : NonZero) -> NonZero =
    NonZero { magnitude = succ(p.magnitude),
        non_zero = raw_non_zero(succ_raw(p.magnitude.rep),
            succ_raw_trimmed(p.magnitude.rep, nz_trimmed(p)), succ_raw_cons(p.magnitude.rep)) };

pub let non_zero_mul(p : NonZero, q : NonZero) -> NonZero =
    NonZero { magnitude = mul(p.magnitude, q.magnitude),
        non_zero = mul_raw_trim_cons(p.magnitude.rep, q.magnitude.rep,
            nz_trimmed(p), p.non_zero, nz_trimmed(q), q.non_zero) };

pub let non_zero_cmp(p : NonZero, q : NonZero) -> Order =
    cmp(p.magnitude, q.magnitude);

-- ===================== BigNat bridge =====================

-- reflect a BigNat as zero-or-nonzero, rebuilding the NonZero certificate bit by
-- bit through the smart constructors (recursion over BigNat's view, as in bit_len).
pub induct Split : pub Type
| zero()
| pos(NonZero)
end

pub rec of_big_nat(a : BigNat) -> Split =
    match view(a)
    | zero() => Split/zero()
    | succ(low, tail) =>
        match of_big_nat(tail)
        | zero() => Split/pos(non_zero_one)
        | pos(t) =>
            match low
            | true => Split/pos(non_zero_i(t))
            | false => Split/pos(non_zero_o(t))
            end
        end
    end;

-- ===================== ring / order lemma corpus (delegation) =====================

pub let non_zero_add_comm(p : NonZero, q : NonZero) -> Eq(non_zero_add(p, q), non_zero_add(q, p)) =
    non_zero_eq(non_zero_add(p, q), non_zero_add(q, p), add_comm(p.magnitude, q.magnitude));

pub let non_zero_add_assoc(p : NonZero, q : NonZero, r : NonZero)
    -> Eq(non_zero_add(non_zero_add(p, q), r), non_zero_add(p, non_zero_add(q, r))) =
    non_zero_eq(non_zero_add(non_zero_add(p, q), r), non_zero_add(p, non_zero_add(q, r)),
        add_assoc(p.magnitude, q.magnitude, r.magnitude));

pub let non_zero_mul_comm(p : NonZero, q : NonZero) -> Eq(non_zero_mul(p, q), non_zero_mul(q, p)) =
    non_zero_eq(non_zero_mul(p, q), non_zero_mul(q, p), mul_comm(p.magnitude, q.magnitude));

pub let non_zero_mul_assoc(p : NonZero, q : NonZero, r : NonZero)
    -> Eq(non_zero_mul(non_zero_mul(p, q), r), non_zero_mul(p, non_zero_mul(q, r))) =
    non_zero_eq(non_zero_mul(non_zero_mul(p, q), r), non_zero_mul(p, non_zero_mul(q, r)),
        mul_assoc(p.magnitude, q.magnitude, r.magnitude));

pub let non_zero_distrib_l(p : NonZero, q : NonZero, r : NonZero)
    -> Eq(non_zero_mul(p, non_zero_add(q, r)), non_zero_add(non_zero_mul(p, q), non_zero_mul(p, r))) =
    non_zero_eq(non_zero_mul(p, non_zero_add(q, r)),
        non_zero_add(non_zero_mul(p, q), non_zero_mul(p, r)),
        distrib_l(p.magnitude, q.magnitude, r.magnitude));

pub let non_zero_cmp_refl(p : NonZero) -> Eq(non_zero_cmp(p, p), Order/eq()) =
    cmp_refl(p.magnitude);

pub let non_zero_cmp_eq(p : NonZero, q : NonZero, w : Eq(non_zero_cmp(p, q), Order/eq())) -> Eq(p, q) =
    non_zero_eq(p, q, cmp_eq(p.magnitude, q.magnitude, w));

pub let non_zero_cmp_flip(p : NonZero, q : NonZero)
    -> Eq(non_zero_cmp(q, p), Order/flip(non_zero_cmp(p, q))) =
    cmp_flip(p.magnitude, q.magnitude);

pub let non_zero_cmp_trans(p : NonZero, q : NonZero, r : NonZero,
    u : Eq(non_zero_cmp(p, q), Order/lt()), v : Eq(non_zero_cmp(q, r), Order/lt()))
    -> Eq(non_zero_cmp(p, r), Order/lt()) =
    cmp_trans(p.magnitude, q.magnitude, r.magnitude, u, v);

pub let non_zero_cmp_gt_to_lt(p : NonZero, q : NonZero, w : Eq(non_zero_cmp(p, q), Order/gt()))
    -> Eq(non_zero_cmp(q, p), Order/lt()) =
    Eq/trans(non_zero_cmp_flip(p, q), cong_flip(w));

satisfy Show(NonZero) {
    show(n) = /std/BigNat/to_str(n.magnitude)
}
