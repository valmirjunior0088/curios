use /std/{Monad, Result};

-- Short-circuiting failure: a `Throw(E, A)` either yields an `A` or stops with an `E`, and `!` propagates the stop — `raise` and `!` together are the checked reading of early return over `Result`. The parameter order is deliberate: the result parameter sits last so the family partially applies as a monad, `(A: Type) => Throw(E, A)` — which is also why `Result(A, E)`, value first, stays the data type and this is its monadic face. Deliberately *no* `Lift(Io, Throw(E))` edge exists — a `Throw` region provably performs nothing.
pub struct Throw(E: Type, A: Type): Type {
    Result(A, E),
}

pub let pure(@E: Type, @A: Type, a: A) -> Throw(E, A) =
    Throw { Result/success(a) };

pub let raise(@E: Type, @A: Type, e: E) -> Throw(E, A) =
    Throw { Result/failure(e) };

pub let bind(@E: Type, @A: Type, @B: Type, m: Throw(E, A), f: (A) -> Throw(E, B)) -> Throw(E, B) =
    match m.0
    | success(a) => f(a)
    | failure(e) => Throw { Result/failure(e) }
    end;

pub let rescue(@E: Type, @A: Type, m: Throw(E, A), handler: (E) -> Throw(E, A)) -> Throw(E, A) =
    match m.0
    | success(_) => m
    | failure(e) => handler(e)
    end;

pub let of(@E: Type, @A: Type, r: Result(A, E)) -> Throw(E, A) =
    Throw { r };

pub let run(@E: Type, @A: Type, m: Throw(E, A)) -> Result(A, E) =
    m.0;

satisfy (@E: Type) => Monad((A: Type) => Throw(E, A)) {
    pure(@A, a) = pure(a),
    bind(@A, @B, m, f) = bind(m, f),
}
