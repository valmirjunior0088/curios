use /std/{Lst, Option, Cell};
use /std/Async/{Waker};

induct State(A: Type): Type
| pending(Lst(Waker))
| ready(A)
end

pub struct Future(A: Type): Type {
    Cell(State(A)),
}

pub let new(@A: Type) -> Future(A) =
    Future { Cell/new(State/pending([])) };

pub let poll(@A: Type, f: Future(A)) -> Option(A) =
    match Cell/get(f.0) | ready(a) => Option/some(a) | pending(_) => Option/none() end;

let wake_all(ws: Lst(Waker)) -> {} =
    Lst/each(ws, Waker/wake);

pub let register(@A: Type, f: Future(A), w: Waker) -> {} =
    match Cell/get(f.0)
    | ready(_) => Waker/wake(w)
    | pending(ws) => Cell/set(f.0, State/pending([w, ..ws]))
    end;

pub let fulfill(@A: Type, f: Future(A), a: A) -> {} =
    match Cell/get(f.0)
    | ready(_) => ()
    | pending(ws) =>
        let _ = Cell/set(f.0, State/ready(a));
        wake_all(ws)
    end;
