use /std/{Lst, Option, Cell, Io};
use /std/Async/{Waker};

induct State(A: Type): Type
| pending(Lst(Waker))
| ready(A)
end

pub struct Future(A: Type): Type {
    Cell(State(A)),
}

-- The result type is explicit rather than implicit: there are no arguments to infer it from, so an implicit would leave a metavariable for the caller's continuation to pin, and the caller now reaches it through two layers of `bind`.
pub let new(A: Type) -> Io(Future(A)) =
    let cell = Cell/new(State/pending(@A, []))!;
    Io/pure(Future { cell });

pub let poll(@A: Type, f: Future(A)) -> Io(Option(A)) =
    let state = Cell/get(f.0)!;
    Io/pure(match state | ready(a) => Option/some(a) | pending(_) => Option/none() end);

rec wake_all(ws: Lst(Waker)) -> Io({}) =
    match ws
    | [] => Io/pure(())
    | [w, ..more] =>
        let _ = Waker/wake(w)!;
        wake_all(more)
    end;

pub let register(@A: Type, f: Future(A), w: Waker) -> Io({}) =
    let state = Cell/get(f.0)!;
    match state
    | ready(_) => Waker/wake(w)
    | pending(ws) => Cell/set(f.0, State/pending([w, ..ws]))
    end;

pub let fulfill(@A: Type, f: Future(A), a: A) -> Io({}) =
    let state = Cell/get(f.0)!;
    match state
    | ready(_) => Io/pure(())
    | pending(ws) =>
        let _ = Cell/set(f.0, State/ready(a))!;
        wake_all(ws)
    end;
