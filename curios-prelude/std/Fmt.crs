use /std/{Bytes, Byte, Str, Nat, Show};

pub induct Fmt : pub Type
| nil()
| lit(Str, Fmt)
| show(Fmt)
end

pub rec format_type_with(T : Type, f : Fmt) -> Type =
    match f
    | nil() => T
    | lit(_, rest) => format_type_with(T, rest)
    | show(rest) => (@A : Type, use Show(A), a : A) -> format_type_with(T, rest)
    end;

let flush(bytes : Bytes, start : Nat, stop : Nat, rest : Fmt) -> Fmt =
    match Str/of_bytes(Bytes/slice(bytes, start, stop))
    | some(piece) => Fmt/lit(piece, rest)
    | none() => Fmt/nil()
    end;

rec parse_at(bytes : Bytes, pos : Nat) -> Fmt =
    match Nat/try_lt(pos, Bytes/len(bytes))
    | none() => Fmt/nil()
    | some(ok) =>
        match Byte/to_nat(Bytes/at(bytes, pos, ok))
        | 0x25 => Fmt/show(parse_at(bytes, pos + 1))
        | _ => parse_lit_at(bytes, pos, pos)
        end
    end
and parse_lit_at(bytes : Bytes, start : Nat, pos : Nat) -> Fmt =
    match Nat/try_lt(pos, Bytes/len(bytes))
    | none() => flush(bytes, start, pos, Fmt/nil())
    | some(ok) =>
        match Byte/to_nat(Bytes/at(bytes, pos, ok))
        | 0x25 => flush(bytes, start, pos, Fmt/show(parse_at(bytes, pos + 1)))
        | 0x5c => parse_esc_at(bytes, start, pos)
        | _ => parse_lit_at(bytes, start, pos + 1)
        end
    end
and parse_esc_at(bytes : Bytes, start : Nat, pos : Nat) -> Fmt =
    match Nat/try_lt(pos + 1, Bytes/len(bytes))
    | none() => parse_lit_at(bytes, start, pos + 1)
    | some(ok) =>
        match Byte/to_nat(Bytes/at(bytes, pos + 1, ok))
        | 0x25 => flush(bytes, start, pos, Fmt/lit("%", parse_at(bytes, pos + 2)))
        | _ => parse_lit_at(bytes, start, pos + 1)
        end
    end;

pub let parse(s : Str) -> Fmt =
    parse_at(Str/to_bytes(s), 0);

rec go_with(T : Type, finish : (Str) -> T, f : Fmt, acc : Str) -> format_type_with(T, f) =
    match f : (f) => format_type_with(T, f)
    | nil() => finish(acc)
    | lit(piece, rest) => go_with(T, finish, rest, Str/concat(acc, piece))
    | show(rest) => (use w, a) => go_with(T, finish, rest, Str/concat(acc, Show/show(a)))
    end;

pub let render(s : Str) -> format_type_with(Str, parse(s)) =
    go_with(Str, (x) => x, parse(s), "");

pub let print(s : Str) -> format_type_with({}, parse(s)) =
    go_with({}, (x) => /std/print(x), parse(s), "");

pub let print_err(s : Str) -> format_type_with({}, parse(s)) =
    go_with({}, (x) => /std/print_err(x), parse(s), "");
