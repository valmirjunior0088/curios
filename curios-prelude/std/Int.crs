pub use /sys/{Int};
pub use /sys/Int/{eql, neq, add, sub, mul, div, rem, lt, gt, lte, gte, and, or, xor, shl, shr, rotl, rotr, clz, ctz, popcnt, to_nat, to_flt};
use /std/{Nat, Str, Option, Order, Eql, Cmp, Add, Sub, Mul, Div, Rem, Show, Ord};

pub let to_str(n : Int) -> Str =
    let mag = Nat/to_str(abs(n));
    match n >= +0
    | true => Str/concat("+", mag)
    | false => Str/concat("-", mag)
    end;

pub let not(x : Int) -> Int =
    xor(x, -1);

pub let of_str(s : Str) -> Option(Int) =
    match Str/len(s) == 0
    | true => Option/none()
    | false =>
        let first = Str/get(s, 0)!;
        let digits =
            match first == '+' || first == '-'
            | true => Str/slice(s, 1, Str/len(s))
            | false => s
            end;
        let negative = first == '-';
        let n = Nat/of_str(digits)!;
        match negative
        | true => Option/some(+0 - Nat/to_int(n))
        | false => Option/some(Nat/to_int(n))
        end
    end;

pub let abs(n : Int) -> Nat =
    match n >= +0
    | true => to_nat(n)
    | false => to_nat(+0 - n)
    end;

pub let cmp(x : Int, y : Int) -> Order =
    choose
    | x < y => Order/lt()
    | x == y => Order/eq()
    | _ => Order/gt()
    end;

satisfy Eql(Int) {
    eql(a, b) = eql(a, b)
}

satisfy Cmp(Int) {
    lt(a, b) = lt(a, b),
    lte(a, b) = lte(a, b),
    gt(a, b) = gt(a, b),
    gte(a, b) = gte(a, b)
}

satisfy Add(Int) {
    add(a, b) = add(a, b)
}

satisfy Sub(Int) {
    sub(a, b) = sub(a, b)
}

satisfy Mul(Int) {
    mul(a, b) = mul(a, b)
}

satisfy Div(Int) {
    div(a, b) = div(a, b)
}

satisfy Rem(Int) {
    rem(a, b) = rem(a, b)
}

satisfy Show(Int) {
    show(n) = to_str(n)
}

satisfy Ord(Int) {
    cmp(a, b) = cmp(a, b)
}
