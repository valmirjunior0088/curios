-- Arbitrary-precision naturals over the packed `Bits` substrate. A `BigNat` is a
-- transparent record pairing an LSB-first `Bits` rep with a `Canonical` proof that
-- the rep is trimmed (no redundant high zero bit), so equality is decided at the
-- `.rep` level and the certificate erases away. `View` (zero / succ low tail) is the
-- structural accessor consumers and single-operand recursions go through; two-operand
-- ops match `.rep` directly, build a raw untrimmed result, and route it through
-- `of_bits` — a single `trim` — at the public boundary.

use /std/{Nat, Bool, Bits, Str, Order, Eq, False, True, Eql, Cmp, Add, Sub, Mul, Show, Ord};
use /std/Order/{lt_neq_eq, gt_neq_eq, eq_neq_lt, gt_neq_lt, eq_neq_gt, lt_neq_gt};
use /std/Bits/{cons};

pub rec is_trimmed(rep : Bits) -> Bool =
    match rep
    | b\ => true
    | b\head\..tail; ih =>
        match tail
        | b\ => head
        | b\_\.._ => ih
        end
    end;

pub let Canonical(rep : Bits) -> Prop =
    match is_trimmed(rep) : Prop
    | true => True
    | false => False
    end;

pub let combine(head : Bool, t : Bits) -> Bits =
    match t
    | b\ =>
        match head
        | true => cons(head, b\)
        | false => b\
        end
    | b\_\.._ => cons(head, t)
    end;

pub rec trim(rep : Bits) -> Bits =
    match rep
    | b\ => b\
    | b\head\..tail; ih => combine(head, ih)
    end;

rec combine_is_trimmed(head : Bool, t : Bits, p : Eq(is_trimmed(t), true)) -> Eq(is_trimmed(combine(head, t)), true) =
    match t : (u) => Eq(is_trimmed(combine(head, u)), true)
    | b\ =>
        match head : (h) => Eq(is_trimmed(combine(h, b\)), true)
        | true => Eq/refl()
        | false => Eq/refl()
        end
    | b\_\.._ => p
    end;

pub rec trim_is_trimmed(rep : Bits) -> Eq(is_trimmed(trim(rep)), true) =
    match rep : (r) => Eq(is_trimmed(trim(r)), true)
    | b\ => Eq/refl()
    | b\head\..tail; ih => combine_is_trimmed(head, trim(tail), ih)
    end;

let canonical_of_is_trimmed(rep : Bits, p : Eq(is_trimmed(rep), true)) -> Canonical(rep) =
    Eq/subst((b : Bool) => match b : Prop | true => True | false => False end, Eq/sym(p), True/qed());

let canonical_of_trim(rep : Bits) -> Canonical(trim(rep)) =
    canonical_of_is_trimmed(trim(rep), trim_is_trimmed(rep));

pub struct BigNat : pub Type {
    rep       : Bits,
    canonical : Canonical(rep),
}

pub let of_bits(rep : Bits) -> BigNat =
    BigNat { rep = trim(rep), canonical = canonical_of_trim(rep) };

pub induct View : pub Type
| zero()
| succ(low : Bool, tail : BigNat)
end

let tail_is_trimmed(head : Bool, tail : Bits, p : Eq(is_trimmed(cons(head, tail)), true))
    -> Eq(is_trimmed(tail), true) =
    match tail : (t) => Eq(is_trimmed(t), true)
    | b\ => Eq/refl()
    | b\_\.._ => p
    end;

let is_trimmed_of_canonical(rep : Bits, c : Canonical(rep)) -> Eq(is_trimmed(rep), true) =
    match is_trimmed(rep) : (r) => Eq(r, true)
    | true => Eq/refl()
    | false => False/absurd(c)
    end;

let of_trimmed_bits(rep : Bits, p : Eq(is_trimmed(rep), true)) -> BigNat =
    BigNat { rep = rep, canonical = canonical_of_is_trimmed(rep, p) };

pub let view(a : BigNat) -> View =
    match a.rep
    | b\ => View/zero()
    | b\head\..tail =>
        View/succ(head, of_trimmed_bits(tail,
            tail_is_trimmed(head, tail, is_trimmed_of_canonical(a.rep, a.canonical))))
    end;

let qed(@A : Type, x : A) -> Eq(x, x) =
    Eq/refl();

pub let zero : BigNat = of_bits(b\);

pub let is_zero(a : BigNat) -> Bool =
    match view(a)
    | zero() => true
    | succ(_, _) => false
    end;

let dbl_raw(x : Bits) -> Bits =
    cons(false, x);

let dbl_succ_raw(x : Bits) -> Bits =
    cons(true, x);

let dbl(a : BigNat) -> BigNat =
    of_bits(dbl_raw(a.rep));

let dbl_succ(a : BigNat) -> BigNat =
    of_bits(dbl_succ_raw(a.rep));

pub rec succ_raw(x : Bits) -> Bits =
    match x
    | b\ => cons(true, b\)
    | b\h\..t =>
        match h
        | true => cons(false, succ_raw(t))
        | false => cons(true, t)
        end
    end;

pub let succ(a : BigNat) -> BigNat =
    of_bits(succ_raw(a.rep));

pub let xor3(a : Bool, b : Bool, c : Bool) -> Bool =
    match a
    | true => match b | true => c | false => match c | true => false | false => true end end
    | false => match b | true => match c | true => false | false => true end | false => c end
    end;

pub let maj3(a : Bool, b : Bool, c : Bool) -> Bool =
    match a
    | true => match b | true => true | false => c end
    | false => match b | true => c | false => false end
    end;

pub rec add_raw(x : Bits, y : Bits, carry : Bool) -> Bits =
    match x
    | b\ =>
        match y
        | b\ => match carry | true => cons(true, b\) | false => b\ end
        | b\yh\..yt => cons(xor3(false, yh, carry), add_raw(b\, yt, maj3(false, yh, carry)))
        end
    | b\xh\..xt =>
        match y
        | b\ => cons(xor3(xh, false, carry), add_raw(xt, b\, maj3(xh, false, carry)))
        | b\yh\..yt => cons(xor3(xh, yh, carry), add_raw(xt, yt, maj3(xh, yh, carry)))
        end
    end;

pub let add(a : BigNat, b : BigNat) -> BigNat =
    of_bits(add_raw(a.rep, b.rep, false));

let cong_cons2(@h1 : Bool, @h2 : Bool, ph : Eq(h1, h2), @t1 : Bits, @t2 : Bits, pt : Eq(t1, t2))
    -> Eq(cons(h1, t1), cons(h2, t2)) =
    match ph : (q : Eq(Bool, a, b)) => Eq(cons(a, t1), cons(b, t2))
    | refl(@z) =>
        match pt : (q2 : Eq(Bits, a2, b2)) => Eq(cons(h1, a2), cons(h1, b2))
        | refl(@z2) => Eq/refl()
        end
    end;

let cong_add_raw_c(x : Bits, y : Bits, @c1 : Bool, @c2 : Bool, p : Eq(c1, c2))
    -> Eq(add_raw(x, y, c1), add_raw(x, y, c2)) =
    match p : (q : Eq(Bool, a, b)) => Eq(add_raw(x, y, a), add_raw(x, y, b))
    | refl(@z) => Eq/refl()
    end;

let cong_of_bits(@s : Bits, @t : Bits, p : Eq(s, t)) -> Eq(of_bits(s), of_bits(t)) =
    match p : (q : Eq(Bits, a, b)) => Eq(of_bits(a), of_bits(b))
    | refl(@z) => Eq/refl()
    end;

let xor3_comm(a : Bool, b : Bool, c : Bool) -> Eq(xor3(a, b, c), xor3(b, a, c)) =
    match a
    | true => match b | true => qed(xor3(true, true, c)) | false => qed(xor3(true, false, c)) end
    | false => match b | true => qed(xor3(false, true, c)) | false => qed(xor3(false, false, c)) end
    end;

let maj3_comm(a : Bool, b : Bool, c : Bool) -> Eq(maj3(a, b, c), maj3(b, a, c)) =
    match a
    | true => match b | true => qed(maj3(true, true, c)) | false => qed(maj3(true, false, c)) end
    | false => match b | true => qed(maj3(false, true, c)) | false => qed(maj3(false, false, c)) end
    end;

pub rec add_comm_raw(x : Bits, y : Bits, c : Bool) -> Eq(add_raw(x, y, c), add_raw(y, x, c)) =
    match x : (a) => Eq(add_raw(a, y, c), add_raw(y, a, c))
    | b\ =>
        match y : (b) => Eq(add_raw(b\, b, c), add_raw(b, b\, c))
        | b\ => qed(add_raw(b\, b\, c))
        | b\yh\..yt => add_raw_swap_step(b\, yt, false, yh, c)
        end
    | b\xh\..xt =>
        match y : (b) => Eq(add_raw(cons(xh, xt), b, c), add_raw(b, cons(xh, xt), c))
        | b\ => add_raw_swap_step(xt, b\, xh, false, c)
        | b\yh\..yt => add_raw_swap_step(xt, yt, xh, yh, c)
        end
    end
and add_raw_swap_step(x : Bits, y : Bits, h1 : Bool, h2 : Bool, c : Bool)
    -> Eq(cons(xor3(h1, h2, c), add_raw(x, y, maj3(h1, h2, c))),
          cons(xor3(h2, h1, c), add_raw(y, x, maj3(h2, h1, c)))) =
    cong_cons2(xor3_comm(h1, h2, c),
        Eq/trans(add_comm_raw(x, y, maj3(h1, h2, c)), cong_add_raw_c(y, x, maj3_comm(h1, h2, c))));

let cong_succ_raw(@s : Bits, @t : Bits, p : Eq(s, t)) -> Eq(succ_raw(s), succ_raw(t)) =
    match p : (q : Eq(Bits, a, b)) => Eq(succ_raw(a), succ_raw(b))
    | refl(@z) => Eq/refl()
    end;

let cong_add_raw_l(@s : Bits, @t : Bits, p : Eq(s, t), y : Bits, c : Bool)
    -> Eq(add_raw(s, y, c), add_raw(t, y, c)) =
    match p : (q : Eq(Bits, a, b)) => Eq(add_raw(a, y, c), add_raw(b, y, c))
    | refl(@z) => Eq/refl()
    end;

let cong_add_raw_r(x : Bits, @s : Bits, @t : Bits, p : Eq(s, t), c : Bool)
    -> Eq(add_raw(x, s, c), add_raw(x, t, c)) =
    match p : (q : Eq(Bits, a, b)) => Eq(add_raw(x, a, c), add_raw(x, b, c))
    | refl(@z) => Eq/refl()
    end;

rec add_raw_zero_r(x : Bits) -> Eq(add_raw(x, b\, false), x) =
    match x : (a) => Eq(add_raw(a, b\, false), a)
    | b\ => Eq/refl()
    | b\h\..t =>
        match h
        | true => cong_cons2(qed(true), add_raw_zero_r(t))
        | false => cong_cons2(qed(false), add_raw_zero_r(t))
        end
    end;

rec add_raw_zero_l(y : Bits) -> Eq(add_raw(b\, y, false), y) =
    match y : (b) => Eq(add_raw(b\, b, false), b)
    | b\ => Eq/refl()
    | b\h\..t =>
        match h
        | true => cong_cons2(qed(true), add_raw_zero_l(t))
        | false => cong_cons2(qed(false), add_raw_zero_l(t))
        end
    end;

rec add_raw_succ_r(x : Bits) -> Eq(add_raw(x, b\, true), succ_raw(x)) =
    match x : (a) => Eq(add_raw(a, b\, true), succ_raw(a))
    | b\ => Eq/refl()
    | b\h\..t =>
        match h
        | true => cong_cons2(qed(false), add_raw_succ_r(t))
        | false => cong_cons2(qed(true), add_raw_zero_r(t))
        end
    end;

rec add_raw_succ_l(y : Bits) -> Eq(add_raw(b\, y, true), succ_raw(y)) =
    match y : (b) => Eq(add_raw(b\, b, true), succ_raw(b))
    | b\ => Eq/refl()
    | b\h\..t =>
        match h
        | true => cong_cons2(qed(false), add_raw_succ_l(t))
        | false => cong_cons2(qed(true), add_raw_zero_l(t))
        end
    end;

pub rec add_raw_carry_spec(x : Bits, y : Bits) -> Eq(add_raw(x, y, true), succ_raw(add_raw(x, y, false))) =
    match x : (a) => Eq(add_raw(a, y, true), succ_raw(add_raw(a, y, false)))
    | b\ =>
        match y : (b) => Eq(add_raw(b\, b, true), succ_raw(add_raw(b\, b, false)))
        | b\ => Eq/refl()
        | b\yh\..yt =>
            match yh
            | true => cong_cons2(qed(false), add_raw_carry_spec(b\, yt))
            | false => Eq/refl()
            end
        end
    | b\xh\..xt =>
        match y : (b) => Eq(add_raw(cons(xh, xt), b, true), succ_raw(add_raw(cons(xh, xt), b, false)))
        | b\ =>
            match xh
            | true => cong_cons2(qed(false), add_raw_carry_spec(xt, b\))
            | false => Eq/refl()
            end
        | b\yh\..yt =>
            match xh
            | true =>
                match yh
                | true => Eq/refl()
                | false => cong_cons2(qed(false), add_raw_carry_spec(xt, yt))
                end
            | false =>
                match yh
                | true => cong_cons2(qed(false), add_raw_carry_spec(xt, yt))
                | false => Eq/refl()
                end
            end
        end
    end;

pub rec add_raw_succ_out_l(u : Bits, v : Bits, c : Bool)
    -> Eq(add_raw(succ_raw(u), v, c), succ_raw(add_raw(u, v, c))) =
    match u : (a) => Eq(add_raw(succ_raw(a), v, c), succ_raw(add_raw(a, v, c)))
    | b\ =>
        match v : (b) => Eq(add_raw(succ_raw(b\), b, c), succ_raw(add_raw(b\, b, c)))
        | b\ =>
            match c
            | true => Eq/refl()
            | false => Eq/refl()
            end
        | b\vh\..vt =>
            match vh
            | true =>
                match c
                | true => Eq/refl()
                | false => cong_cons2(qed(false), add_raw_carry_spec(b\, vt))
                end
            | false =>
                match c
                | true => cong_cons2(qed(false), add_raw_carry_spec(b\, vt))
                | false => Eq/refl()
                end
            end
        end
    | b\uh\..ut =>
        match uh
        | true =>
            match v : (b) => Eq(add_raw(succ_raw(cons(true, ut)), b, c), succ_raw(add_raw(cons(true, ut), b, c)))
            | b\ =>
                match c
                | true => cong_cons2(qed(true), Eq/trans(add_raw_succ_out_l(ut, b\, false), Eq/sym(add_raw_carry_spec(ut, b\))))
                | false => cong_cons2(qed(false), add_raw_succ_out_l(ut, b\, false))
                end
            | b\vh\..vt =>
                match vh
                | true =>
                    match c
                    | true => cong_cons2(qed(false), add_raw_succ_out_l(ut, vt, true))
                    | false => cong_cons2(qed(true), Eq/trans(add_raw_succ_out_l(ut, vt, false), Eq/sym(add_raw_carry_spec(ut, vt))))
                    end
                | false =>
                    match c
                    | true => cong_cons2(qed(true), Eq/trans(add_raw_succ_out_l(ut, vt, false), Eq/sym(add_raw_carry_spec(ut, vt))))
                    | false => cong_cons2(qed(false), add_raw_succ_out_l(ut, vt, false))
                    end
                end
            end
        | false =>
            match v : (b) => Eq(add_raw(succ_raw(cons(false, ut)), b, c), succ_raw(add_raw(cons(false, ut), b, c)))
            | b\ =>
                match c
                | true => cong_cons2(qed(false), add_raw_carry_spec(ut, b\))
                | false => Eq/refl()
                end
            | b\vh\..vt =>
                match vh
                | true =>
                    match c
                    | true => Eq/refl()
                    | false => cong_cons2(qed(false), add_raw_carry_spec(ut, vt))
                    end
                | false =>
                    match c
                    | true => cong_cons2(qed(false), add_raw_carry_spec(ut, vt))
                    | false => Eq/refl()
                    end
                end
            end
        end
    end;

pub rec add_raw_succ_out_r(u : Bits, v : Bits, c : Bool)
    -> Eq(add_raw(u, succ_raw(v), c), succ_raw(add_raw(u, v, c))) =
    match v : (b) => Eq(add_raw(u, succ_raw(b), c), succ_raw(add_raw(u, b, c)))
    | b\ =>
        match u : (a) => Eq(add_raw(a, succ_raw(b\), c), succ_raw(add_raw(a, b\, c)))
        | b\ =>
            match c
            | true => Eq/refl()
            | false => Eq/refl()
            end
        | b\uh\..ut =>
            match uh
            | true =>
                match c
                | true => Eq/refl()
                | false => cong_cons2(qed(false), add_raw_carry_spec(ut, b\))
                end
            | false =>
                match c
                | true => cong_cons2(qed(false), add_raw_carry_spec(ut, b\))
                | false => Eq/refl()
                end
            end
        end
    | b\vh\..vt =>
        match vh
        | true =>
            match u : (a) => Eq(add_raw(a, succ_raw(cons(true, vt)), c), succ_raw(add_raw(a, cons(true, vt), c)))
            | b\ =>
                match c
                | true => cong_cons2(qed(true), Eq/trans(add_raw_succ_out_r(b\, vt, false), Eq/sym(add_raw_carry_spec(b\, vt))))
                | false => cong_cons2(qed(false), add_raw_succ_out_r(b\, vt, false))
                end
            | b\uh\..ut =>
                match uh
                | true =>
                    match c
                    | true => cong_cons2(qed(false), add_raw_succ_out_r(ut, vt, true))
                    | false => cong_cons2(qed(true), Eq/trans(add_raw_succ_out_r(ut, vt, false), Eq/sym(add_raw_carry_spec(ut, vt))))
                    end
                | false =>
                    match c
                    | true => cong_cons2(qed(true), Eq/trans(add_raw_succ_out_r(ut, vt, false), Eq/sym(add_raw_carry_spec(ut, vt))))
                    | false => cong_cons2(qed(false), add_raw_succ_out_r(ut, vt, false))
                    end
                end
            end
        | false =>
            match u : (a) => Eq(add_raw(a, succ_raw(cons(false, vt)), c), succ_raw(add_raw(a, cons(false, vt), c)))
            | b\ =>
                match c
                | true => cong_cons2(qed(false), add_raw_carry_spec(b\, vt))
                | false => Eq/refl()
                end
            | b\uh\..ut =>
                match uh
                | true =>
                    match c
                    | true => Eq/refl()
                    | false => cong_cons2(qed(false), add_raw_carry_spec(ut, vt))
                    end
                | false =>
                    match c
                    | true => cong_cons2(qed(false), add_raw_carry_spec(ut, vt))
                    | false => Eq/refl()
                    end
                end
            end
        end
    end;

pub rec add_assoc_raw(x : Bits, y : Bits, z : Bits, c1 : Bool, c2 : Bool)
    -> Eq(add_raw(add_raw(x, y, c1), z, c2), add_raw(x, add_raw(y, z, c1), c2)) =
    match x : (xv) => Eq(add_raw(add_raw(xv, y, c1), z, c2), add_raw(xv, add_raw(y, z, c1), c2))
    | b\ =>
        match y : (yv) => Eq(add_raw(add_raw(b\, yv, c1), z, c2), add_raw(b\, add_raw(yv, z, c1), c2))
        | b\ =>
            match z : (zv) => Eq(add_raw(add_raw(b\, b\, c1), zv, c2), add_raw(b\, add_raw(b\, zv, c1), c2))
            | b\ =>
                match c1
                | true =>
                    match c2
                    | true =>
                        Eq/refl()
                    | false =>
                        Eq/refl()
                    end
                | false =>
                    match c2
                    | true =>
                        Eq/refl()
                    | false =>
                        Eq/refl()
                    end
                end
            | b\zh\..zt =>
                match c1
                | false => Eq/sym(cong_add_raw_r(b\, add_raw_zero_l(cons(zh, zt)), c2))
                | true => Eq/trans(add_raw_succ_out_l(b\, cons(zh, zt), c2), Eq/sym(Eq/trans(cong_add_raw_r(b\, add_raw_carry_spec(b\, cons(zh, zt)), c2), Eq/trans(add_raw_succ_out_r(b\, add_raw(b\, cons(zh, zt), false), c2), cong_succ_raw(cong_add_raw_r(b\, add_raw_zero_l(cons(zh, zt)), c2))))))
                end
            end
        | b\yh\..yt =>
            match z : (zv) => Eq(add_raw(add_raw(b\, cons(yh, yt), c1), zv, c2), add_raw(b\, add_raw(cons(yh, yt), zv, c1), c2))
            | b\ =>
                match yh
                | true =>
                    match c1
                    | true =>
                        match c2
                        | true =>
                            cong_cons2(qed(true), add_assoc_raw(b\, yt, b\, true, false))
                        | false =>
                            cong_cons2(qed(false), add_assoc_raw(b\, yt, b\, true, false))
                        end
                    | false =>
                        match c2
                        | true =>
                            cong_cons2(qed(false), add_assoc_raw(b\, yt, b\, false, true))
                        | false =>
                            cong_cons2(qed(true), add_assoc_raw(b\, yt, b\, false, false))
                        end
                    end
                | false =>
                    match c1
                    | true =>
                        match c2
                        | true =>
                            cong_cons2(qed(false), add_assoc_raw(b\, yt, b\, false, true))
                        | false =>
                            cong_cons2(qed(true), add_assoc_raw(b\, yt, b\, false, false))
                        end
                    | false =>
                        match c2
                        | true =>
                            cong_cons2(qed(true), add_assoc_raw(b\, yt, b\, false, false))
                        | false =>
                            cong_cons2(qed(false), add_assoc_raw(b\, yt, b\, false, false))
                        end
                    end
                end
            | b\zh\..zt =>
                match yh
                | true =>
                    match zh
                    | true =>
                        match c1
                        | true =>
                            match c2
                            | true =>
                                cong_cons2(qed(false), add_assoc_raw(b\, yt, zt, true, true))
                            | false =>
                                cong_cons2(qed(true), add_assoc_raw(b\, yt, zt, true, false))
                            end
                        | false =>
                            match c2
                            | true =>
                                cong_cons2(qed(true), Eq/trans(add_assoc_raw(b\, yt, zt, false, true), Eq/trans(add_raw_carry_spec(b\, add_raw(yt, zt, false)), Eq/trans(Eq/sym(add_raw_succ_out_r(b\, add_raw(yt, zt, false), false)), cong_add_raw_r(b\, Eq/sym(add_raw_carry_spec(yt, zt)), false)))))
                            | false =>
                                cong_cons2(qed(false), Eq/trans(add_assoc_raw(b\, yt, zt, false, true), Eq/trans(add_raw_carry_spec(b\, add_raw(yt, zt, false)), Eq/trans(Eq/sym(add_raw_succ_out_r(b\, add_raw(yt, zt, false), false)), cong_add_raw_r(b\, Eq/sym(add_raw_carry_spec(yt, zt)), false)))))
                            end
                        end
                    | false =>
                        match c1
                        | true =>
