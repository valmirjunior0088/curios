pub rec add_raw_one_r(x : Bits) -> Eq(add_raw(x, cons(true, b\), false), succ_raw(x)) =
    match x : (a) => Eq(add_raw(a, cons(true, b\), false), succ_raw(a))
    | b\ => Eq/refl()
    | b\h\..t =>
        match h
        | true => cong_cons2(qed(false), add_raw_succ_r(t))
        | false => cong_cons2(qed(true), add_raw_zero_r(t))
        end
    end;

let false_neq_true(p : Eq(false, true)) -> False =
    Eq/subst((b : Bool) => match b : Prop | false => True | true => False end, p, True/qed());

let nonempty(x : Bits) -> Bool =
    match x
    | b\ => false
    | b\_\.._ => true
    end;

let cong_combine(h : Bool, @s : Bits, @t : Bits, p : Eq(s, t)) -> Eq(combine(h, s), combine(h, t)) =
    match p : (q : Eq(Bits, a, b)) => Eq(combine(h, a), combine(h, b))
    | refl(@z) => Eq/refl()
    end;

let cong_is_trimmed(@s : Bits, @t : Bits, p : Eq(s, t)) -> Eq(is_trimmed(s), is_trimmed(t)) =
    match p : (q : Eq(Bits, a, b)) => Eq(is_trimmed(a), is_trimmed(b))
    | refl(@z) => Eq/refl()
    end;

pub rec trim_of_trimmed(x : Bits, p : Eq(is_trimmed(x), true)) -> Eq(trim(x), x) =
    match x : (a) => Eq(trim(a), a)
    | b\ => Eq/refl()
    | b\h\..t =>
        match t : (u) => Eq(trim(cons(h, u)), cons(h, u))
        | b\ =>
            match h : (g) => Eq(trim(cons(g, b\)), cons(g, b\))
            | true => Eq/refl()
            | false => False/absurd(false_neq_true(p))
            end
        | b\th\..tt => cong_combine(h, trim_of_trimmed(cons(th, tt), p))
        end
    end;

let is_trimmed_cons(head : Bool, u : Bits, pt : Eq(is_trimmed(u), true), pn : Eq(nonempty(u), true))
    -> Eq(is_trimmed(cons(head, u)), true) =
    match u : (v) => Eq(is_trimmed(cons(head, v)), true)
    | b\ => False/absurd(false_neq_true(pn))
    | b\_\.._ => pt
    end;

let succ_raw_nonempty(x : Bits) -> Eq(nonempty(succ_raw(x)), true) =
    match x : (a) => Eq(nonempty(succ_raw(a)), true)
    | b\ => Eq/refl()
    | b\h\..t =>
        match h
        | true => Eq/refl()
        | false => Eq/refl()
        end
    end;

pub rec succ_raw_trimmed(x : Bits, p : Eq(is_trimmed(x), true)) -> Eq(is_trimmed(succ_raw(x)), true) =
    match x : (a) => Eq(is_trimmed(succ_raw(a)), true)
    | b\ => Eq/refl()
    | b\h\..t =>
        match h
        | true =>
            match t : (u) => Eq(is_trimmed(succ_raw(cons(true, u))), true)
            | b\ => Eq/refl()
            | b\th\..tt => is_trimmed_cons(false, succ_raw(cons(th, tt)),
                succ_raw_trimmed(cons(th, tt), p), succ_raw_nonempty(cons(th, tt)))
            end
        | false =>
            match t : (u) => Eq(is_trimmed(succ_raw(cons(false, u))), true)
            | b\ => Eq/refl()
            | b\_\.._ => p
            end
        end
    end;

let add_raw_nonempty_l(xh : Bool, xt : Bits, y : Bits, c : Bool)
    -> Eq(nonempty(add_raw(cons(xh, xt), y, c)), true) =
    match y : (b) => Eq(nonempty(add_raw(cons(xh, xt), b, c)), true)
    | b\ => Eq/refl()
    | b\_\.._ => Eq/refl()
    end;

let add_raw_nonempty_r(x : Bits, yh : Bool, yt : Bits, c : Bool)
    -> Eq(nonempty(add_raw(x, cons(yh, yt), c)), true) =
    match x : (a) => Eq(nonempty(add_raw(a, cons(yh, yt), c)), true)
    | b\ => Eq/refl()
    | b\_\.._ => Eq/refl()
    end;

pub rec add_raw_trimmed(x : Bits, y : Bits, c : Bool,
    px : Eq(is_trimmed(x), true), py : Eq(is_trimmed(y), true))
    -> Eq(is_trimmed(add_raw(x, y, c)), true) =
    match x : (a) => Eq(is_trimmed(add_raw(a, y, c)), true)
    | b\ =>
        match c
        | false => Eq/trans(cong_is_trimmed(add_raw_zero_l(y)), py)
        | true => Eq/trans(cong_is_trimmed(add_raw_succ_l(y)), succ_raw_trimmed(y, py))
        end
    | b\xh\..xt =>
        match y : (b) => Eq(is_trimmed(add_raw(cons(xh, xt), b, c)), true)
        | b\ =>
            match c
            | false => Eq/trans(cong_is_trimmed(add_raw_zero_r(cons(xh, xt))), px)
            | true => Eq/trans(cong_is_trimmed(add_raw_succ_r(cons(xh, xt))),
                succ_raw_trimmed(cons(xh, xt), px))
            end
        | b\yh\..yt =>
            match xt : (u) => Eq(is_trimmed(add_raw(cons(xh, u), cons(yh, yt), c)), true)
            | b\ =>
                match yt : (v) => Eq(is_trimmed(add_raw(cons(xh, b\), cons(yh, v), c)), true)
                | b\ =>
                    match xh
                    | false => False/absurd(false_neq_true(px))
                    | true =>
                        match yh
                        | false => False/absurd(false_neq_true(py))
                        | true => Eq/refl()
                        end
                    end
                | b\a2\..b2 => is_trimmed_cons(xor3(xh, yh, c), add_raw(b\, cons(a2, b2), maj3(xh, yh, c)),
                    add_raw_trimmed(b\, cons(a2, b2), maj3(xh, yh, c), qed(true), py),
                    add_raw_nonempty_r(b\, a2, b2, maj3(xh, yh, c)))
                end
            | b\a2\..b2 =>
                match yt : (v) => Eq(is_trimmed(add_raw(cons(xh, cons(a2, b2)), cons(yh, v), c)), true)
                | b\ => is_trimmed_cons(xor3(xh, yh, c), add_raw(cons(a2, b2), b\, maj3(xh, yh, c)),
                    add_raw_trimmed(cons(a2, b2), b\, maj3(xh, yh, c), px, qed(true)),
                    add_raw_nonempty_l(a2, b2, b\, maj3(xh, yh, c)))
                | b\d2\..e2 => is_trimmed_cons(xor3(xh, yh, c), add_raw(cons(a2, b2), cons(d2, e2), maj3(xh, yh, c)),
                    add_raw_trimmed(cons(a2, b2), cons(d2, e2), maj3(xh, yh, c), px, py),
                    add_raw_nonempty_l(a2, b2, cons(d2, e2), maj3(xh, yh, c)))
                end
            end
        end
    end;

pub let big_nat_eq(a : BigNat, b : BigNat, p : Eq(a.rep, b.rep)) -> Eq(a, b) =
    Eq/subst((r : Bits) => (c : Canonical(r)) -> Eq(a, BigNat { rep = r, canonical = c }),
             p,
             (c : Canonical(a.rep)) => Eq/refl())(b.canonical);

pub let add_comm(a : BigNat, b : BigNat) -> Eq(add(a, b), add(b, a)) =
    cong_of_bits(add_comm_raw(a.rep, b.rep, false));

pub let add_assoc(a : BigNat, b : BigNat, c : BigNat) -> Eq(add(add(a, b), c), add(a, add(b, c))) =
    cong_of_bits(
        Eq/trans(
            cong_add_raw_l(
                trim_of_trimmed(add_raw(a.rep, b.rep, false),
                    add_raw_trimmed(a.rep, b.rep, false,
                        is_trimmed_of_canonical(a.rep, a.canonical),
                        is_trimmed_of_canonical(b.rep, b.canonical))),
                c.rep, false),
            Eq/trans(
                add_assoc_raw(a.rep, b.rep, c.rep, false, false),
                cong_add_raw_r(a.rep,
                    Eq/sym(trim_of_trimmed(add_raw(b.rep, c.rep, false),
                        add_raw_trimmed(b.rep, c.rep, false,
                            is_trimmed_of_canonical(b.rep, b.canonical),
                            is_trimmed_of_canonical(c.rep, c.canonical)))),
                    false))));

let head_of(x : Bits) -> Bool =
    match x
    | b\ => false
    | b\h\.._ => h
    end;

let tail_of(x : Bits) -> Bits =
    match x
    | b\ => b\
    | b\_\..t => t
    end;

let cons_inj_head(@h1 : Bool, @t1 : Bits, @h2 : Bool, @t2 : Bits, p : Eq(cons(h1, t1), cons(h2, t2)))
    -> Eq(h1, h2) =
    match p : (q : Eq(Bits, s, t)) => Eq(head_of(s), head_of(t))
    | refl(@z) => Eq/refl()
    end;

let cons_inj_tail(@h1 : Bool, @t1 : Bits, @h2 : Bool, @t2 : Bits, p : Eq(cons(h1, t1), cons(h2, t2)))
    -> Eq(t1, t2) =
    match p : (q : Eq(Bits, s, t)) => Eq(tail_of(s), tail_of(t))
    | refl(@z) => Eq/refl()
    end;

let xor3_inj_mid(a : Bool, @b1 : Bool, @b2 : Bool, c : Bool, p : Eq(xor3(a, b1, c), xor3(a, b2, c)))
    -> Eq(b1, b2) =
    match a
    | true =>
        match c
        | true =>
            match b1
            | true => match b2 | true => qed(true) | false => False/absurd(false_neq_true(Eq/sym(p))) end
            | false => match b2 | true => False/absurd(false_neq_true(p)) | false => qed(false) end
            end
        | false =>
            match b1
            | true => match b2 | true => qed(true) | false => False/absurd(false_neq_true(p)) end
            | false => match b2 | true => False/absurd(false_neq_true(Eq/sym(p))) | false => qed(false) end
            end
        end
    | false =>
        match c
        | true =>
            match b1
            | true => match b2 | true => qed(true) | false => False/absurd(false_neq_true(p)) end
            | false => match b2 | true => False/absurd(false_neq_true(Eq/sym(p))) | false => qed(false) end
            end
        | false =>
            match b1
            | true => match b2 | true => qed(true) | false => False/absurd(false_neq_true(Eq/sym(p))) end
            | false => match b2 | true => False/absurd(false_neq_true(p)) | false => qed(false) end
            end
        end
    end;

let cong_maj3_mid(a : Bool, @b1 : Bool, @b2 : Bool, p : Eq(b1, b2), c : Bool)
    -> Eq(maj3(a, b1, c), maj3(a, b2, c)) =
    match p : (q : Eq(Bool, s, t)) => Eq(maj3(a, s, c), maj3(a, t, c))
    | refl(@z) => Eq/refl()
    end;

let succ_raw_inj_absurd(zh : Bool, zt : Bits, pz : Eq(is_trimmed(cons(zh, zt)), true),
    p : Eq(succ_raw(b\), succ_raw(cons(zh, zt)))) -> False =
    match zh
    | true => false_neq_true(Eq/sym(cons_inj_head(@true, @(b\), @false, @(succ_raw(zt)), p)))
    | false =>
        let shifted : Eq(is_trimmed(cons(false, b\)), true) =
            Eq/subst((w : Bits) => Eq(is_trimmed(w), true),
                cong_cons2(qed(false), Eq/sym(cons_inj_tail(@true, @(b\), @true, @zt, p))),
                pz);
        false_neq_true(shifted)
    end;

rec succ_raw_inj(y : Bits, z : Bits,
    py : Eq(is_trimmed(y), true), pz : Eq(is_trimmed(z), true),
    p : Eq(succ_raw(y), succ_raw(z))) -> Eq(y, z) =
    match y : (b) => Eq(b, z)
    | b\ =>
        match z : (d) => Eq(b\, d)
        | b\ => Eq/refl()
        | b\zh\..zt => False/absurd(succ_raw_inj_absurd(zh, zt, pz, p))
        end
    | b\yh\..yt =>
        match z : (d) => Eq(cons(yh, yt), d)
        | b\ => False/absurd(succ_raw_inj_absurd(yh, yt, py, Eq/sym(p)))
        | b\zh\..zt =>
            match yh
            | true =>
                match zh
                | true => cong_cons2(qed(true), succ_raw_inj(yt, zt,
                    tail_is_trimmed(true, yt, py), tail_is_trimmed(true, zt, pz),
                    cons_inj_tail(@false, @(succ_raw(yt)), @false, @(succ_raw(zt)), p)))
                | false => False/absurd(false_neq_true(
                    cons_inj_head(@false, @(succ_raw(yt)), @true, @zt, p)))
                end
            | false =>
                match zh
                | true => False/absurd(false_neq_true(Eq/sym(
                    cons_inj_head(@true, @yt, @false, @(succ_raw(zt)), p))))
                | false => cong_cons2(qed(false), cons_inj_tail(@true, @yt, @true, @zt, p))
                end
            end
        end
    end;

pub rec add_raw_cancel_l(x : Bits, y : Bits, z : Bits, c : Bool,
    py : Eq(is_trimmed(y), true), pz : Eq(is_trimmed(z), true),
    p : Eq(add_raw(x, y, c), add_raw(x, z, c))) -> Eq(y, z) =
    match x
    | b\ =>
        match c
        | false => Eq/trans(Eq/sym(add_raw_zero_l(y)), Eq/trans(p, add_raw_zero_l(z)))
        | true => succ_raw_inj(y, z, py, pz,
            Eq/trans(Eq/sym(add_raw_succ_l(y)), Eq/trans(p, add_raw_succ_l(z))))
        end
    | b\xh\..xt =>
        match y : (b) => Eq(b, z)
        | b\ =>
            match z : (d) => Eq(b\, d)
            | b\ => Eq/refl()
            | b\zh\..zt => False/absurd(add_raw_cancel_absurd(xh, xt, zh, zt, c, pz, p))
            end
        | b\yh\..yt =>
            match z : (d) => Eq(cons(yh, yt), d)
            | b\ => False/absurd(add_raw_cancel_absurd(xh, xt, yh, yt, c, py, Eq/sym(p)))
            | b\zh\..zt =>
                cong_cons2(xor3_inj_mid(xh, c, cons_inj_head(p)),
                    add_raw_cancel_l(xt, yt, zt, maj3(xh, zh, c),
                        tail_is_trimmed(yh, yt, py), tail_is_trimmed(zh, zt, pz),
                        Eq/trans(
                            Eq/sym(cong_add_raw_c(xt, yt,
                                cong_maj3_mid(xh, xor3_inj_mid(xh, c, cons_inj_head(p)), c))),
                            cons_inj_tail(p))))
            end
        end
    end
and add_raw_cancel_absurd(xh : Bool, xt : Bits, zh : Bool, zt : Bits, c : Bool,
    pz : Eq(is_trimmed(cons(zh, zt)), true),
    p : Eq(add_raw(cons(xh, xt), b\, c), add_raw(cons(xh, xt), cons(zh, zt), c))) -> False =
    let shifted : Eq(is_trimmed(cons(false, b\)), true) =
        Eq/subst((w : Bits) => Eq(is_trimmed(w), true),
            cong_cons2(
                Eq/sym(xor3_inj_mid(xh, @false, @zh, c, cons_inj_head(p))),
                Eq/sym(add_raw_cancel_l(xt, b\, zt, maj3(xh, zh, c),
                    qed(true), tail_is_trimmed(zh, zt, pz),
                    Eq/trans(
                        Eq/sym(cong_add_raw_c(xt, b\,
                            cong_maj3_mid(xh, xor3_inj_mid(xh, @false, @zh, c, cons_inj_head(p)), c))),
                        cons_inj_tail(p))))),
            pz);
    false_neq_true(shifted);

pub let add_raw_cancel_r(x : Bits, y : Bits, z : Bits, c : Bool,
    py : Eq(is_trimmed(y), true), pz : Eq(is_trimmed(z), true),
    p : Eq(add_raw(y, x, c), add_raw(z, x, c))) -> Eq(y, z) =
    add_raw_cancel_l(x, y, z, c, py, pz,
        Eq/trans(add_comm_raw(x, y, c), Eq/trans(p, add_comm_raw(z, x, c))));

let cong_rep(@s : BigNat, @t : BigNat, p : Eq(s, t)) -> Eq(s.rep, t.rep) =
    match p : (q : Eq(BigNat, a, b)) => Eq(a.rep, b.rep)
    | refl(@z) => Eq/refl()
    end;

pub let add_cancel_l(a : BigNat, b : BigNat, c : BigNat, p : Eq(add(a, b), add(a, c))) -> Eq(b, c) =
    big_nat_eq(b, c,
        add_raw_cancel_l(a.rep, b.rep, c.rep, false,
            is_trimmed_of_canonical(b.rep, b.canonical),
            is_trimmed_of_canonical(c.rep, c.canonical),
            Eq/trans(
                Eq/sym(trim_of_trimmed(add_raw(a.rep, b.rep, false),
                    add_raw_trimmed(a.rep, b.rep, false,
                        is_trimmed_of_canonical(a.rep, a.canonical),
                        is_trimmed_of_canonical(b.rep, b.canonical)))),
                Eq/trans(cong_rep(p),
                    trim_of_trimmed(add_raw(a.rep, c.rep, false),
                        add_raw_trimmed(a.rep, c.rep, false,
                            is_trimmed_of_canonical(a.rep, a.canonical),
                            is_trimmed_of_canonical(c.rep, c.canonical)))))));

pub let add_cancel_r(a : BigNat, b : BigNat, c : BigNat, p : Eq(add(b, a), add(c, a))) -> Eq(b, c) =
    add_cancel_l(a, b, c, Eq/trans(add_comm(a, b), Eq/trans(p, add_comm(c, a))));

pub rec cmp_raw(x : Bits, y : Bits) -> Order =
    match x
    | b\ =>
        match y
        | b\ => Order/eq()
        | b\_\.._ => Order/lt()
        end
    | b\xh\..xt =>
        match y
        | b\ => Order/gt()
        | b\yh\..yt =>
            match cmp_raw(xt, yt)
            | eq() =>
                match xh
                | true => match yh | true => Order/eq() | false => Order/gt() end
                | false => match yh | true => Order/lt() | false => Order/eq() end
                end
            | lt() => Order/lt()
            | gt() => Order/gt()
            end
        end
    end;

pub let cmp(a : BigNat, b : BigNat) -> Order =
    cmp_raw(a.rep, b.rep);

pub let eql(a : BigNat, b : BigNat) -> Bool =
    match cmp(a, b) | eq() => true | _ => false end;

pub let lt(a : BigNat, b : BigNat) -> Bool =
    match cmp(a, b) | lt() => true | _ => false end;

pub let lte(a : BigNat, b : BigNat) -> Bool =
    match cmp(a, b) | gt() => false | _ => true end;

pub let gt(a : BigNat, b : BigNat) -> Bool =
    match cmp(a, b) | gt() => true | _ => false end;

pub let gte(a : BigNat, b : BigNat) -> Bool =
    match cmp(a, b) | lt() => false | _ => true end;

let absorb_eq(o : Order, p : Eq(o, Order/eq()))
    -> Eq(match o : Order | eq() => Order/eq() | lt() => Order/lt() | gt() => Order/gt() end, Order/eq()) =
    Eq/subst((v : Order) => Eq(match v : Order | eq() => Order/eq() | lt() => Order/lt() | gt() => Order/gt() end, Order/eq()), Eq/sym(p), Eq/refl());

pub rec cmp_raw_refl(x : Bits) -> Eq(cmp_raw(x, x), Order/eq()) =
    match x : (a) => Eq(cmp_raw(a, a), Order/eq())
    | b\ => Eq/refl()
    | b\h\..t =>
        match h
        | true => absorb_eq(cmp_raw(t, t), cmp_raw_refl(t))
        | false => absorb_eq(cmp_raw(t, t), cmp_raw_refl(t))
        end
    end;

let sub_split(s : Order, @E : Order,
    p : Eq(match s : Order | eq() => E | lt() => Order/lt() | gt() => Order/gt() end, Order/eq()))
    -> Eq(s, Order/eq()) =
    match s : (r) => Eq(r, Order/eq())
    | eq() => Eq/refl()
    | lt() => False/absurd(lt_neq_eq(p))
    | gt() => False/absurd(gt_neq_eq(p))
    end;

let cong_cmp_match(@s : Order, @t : Order, p : Eq(s, t), @E : Order)
    -> Eq(match s : Order | eq() => E | lt() => Order/lt() | gt() => Order/gt() end,
          match t : Order | eq() => E | lt() => Order/lt() | gt() => Order/gt() end) =
    match p : (q : Eq(Order, u, v)) => Eq(match u : Order | eq() => E | lt() => Order/lt() | gt() => Order/gt() end, match v : Order | eq() => E | lt() => Order/lt() | gt() => Order/gt() end)
    | refl(@z) => Eq/refl()
    end;

pub rec cmp_raw_eq(x : Bits, y : Bits, p : Eq(cmp_raw(x, y), Order/eq())) -> Eq(x, y) =
    match x
    | b\ =>
        match y
        | b\ => Eq/refl()
        | b\_\.._ => False/absurd(lt_neq_eq(p))
        end
    | b\xh\..xt =>
        match y
        | b\ => False/absurd(gt_neq_eq(p))
        | b\yh\..yt =>
            cong_cons2(
                cmp_head_eq(xh, yh, Eq/trans(Eq/sym(cong_cmp_match(sub_split(cmp_raw(xt, yt), p))), p)),
                cmp_raw_eq(xt, yt, sub_split(cmp_raw(xt, yt), p)))
        end
    end
and cmp_head_eq(xh : Bool, yh : Bool,
    p : Eq(match xh : Order | true => match yh | true => Order/eq() | false => Order/gt() end | false => match yh | true => Order/lt() | false => Order/eq() end end, Order/eq()))
    -> Eq(xh, yh) =
    match xh
    | true => match yh | true => Eq/refl() | false => False/absurd(gt_neq_eq(p)) end
    | false => match yh | true => False/absurd(lt_neq_eq(p)) | false => Eq/refl() end
    end;

let flip_heads(xh : Bool, yh : Bool)
    -> Eq(match yh : Order | true => match xh | true => Order/eq() | false => Order/gt() end | false => match xh | true => Order/lt() | false => Order/eq() end end,
          Order/flip(match xh : Order | true => match yh | true => Order/eq() | false => Order/gt() end | false => match yh | true => Order/lt() | false => Order/eq() end end)) =
    match xh
    | true => match yh | true => Eq/refl() | false => Eq/refl() end
    | false => match yh | true => Eq/refl() | false => Eq/refl() end
    end;

pub rec cmp_raw_flip(x : Bits, y : Bits) -> Eq(cmp_raw(y, x), Order/flip(cmp_raw(x, y))) =
    match x : (a) => Eq(cmp_raw(y, a), Order/flip(cmp_raw(a, y)))
    | b\ =>
        match y : (b) => Eq(cmp_raw(b, b\), Order/flip(cmp_raw(b\, b)))
        | b\ => Eq/refl()
        | b\_\.._ => Eq/refl()
        end
    | b\xh\..xt =>
        match y : (b) => Eq(cmp_raw(b, cons(xh, xt)), Order/flip(cmp_raw(cons(xh, xt), b)))
        | b\ => Eq/refl()
        | b\yh\..yt =>
            Eq/trans(
                cong_cmp_match(cmp_raw_flip(xt, yt)),
                match cmp_raw(xt, yt) : (r) => Eq(
                    match Order/flip(r) : Order | eq() => match yh : Order | true => match xh | true => Order/eq() | false => Order/gt() end | false => match xh | true => Order/lt() | false => Order/eq() end end | lt() => Order/lt() | gt() => Order/gt() end,
                    Order/flip(match r : Order | eq() => match xh : Order | true => match yh | true => Order/eq() | false => Order/gt() end | false => match yh | true => Order/lt() | false => Order/eq() end end | lt() => Order/lt() | gt() => Order/gt() end))
                | eq() => flip_heads(xh, yh)
                | lt() => Eq/refl()
                | gt() => Eq/refl()
                end)
        end
    end;

let force_lt(@s : Order, @E : Order, p : Eq(s, Order/lt()))
    -> Eq(match s : Order | eq() => E | lt() => Order/lt() | gt() => Order/gt() end, Order/lt()) =
    Eq/subst((v : Order) => Eq(match v : Order | eq() => E | lt() => Order/lt() | gt() => Order/gt() end, Order/lt()), Eq/sym(p), Eq/refl());

let head_lt_yh(xh : Bool, yh : Bool,
    p : Eq(match xh : Order | true => match yh | true => Order/eq() | false => Order/gt() end | false => match yh | true => Order/lt() | false => Order/eq() end end, Order/lt()))
    -> Eq(yh, true) =
    match xh
    | true => match yh | true => False/absurd(eq_neq_lt(p)) | false => False/absurd(gt_neq_lt(p)) end
    | false => match yh | true => Eq/refl() | false => False/absurd(eq_neq_lt(p)) end
    end;

let head_lt_xh(xh : Bool, yh : Bool,
    p : Eq(match xh : Order | true => match yh | true => Order/eq() | false => Order/gt() end | false => match yh | true => Order/lt() | false => Order/eq() end end, Order/lt()))
    -> Eq(xh, false) =
    match xh
    | true => match yh | true => False/absurd(eq_neq_lt(p)) | false => False/absurd(gt_neq_lt(p)) end
    | false => Eq/refl()
    end;

let reduce_whole(@a : Bits, @b : Bits, @s : Order, e : Eq(cmp_raw(a, b), s), @E : Order,
    p : Eq(match cmp_raw(a, b) : Order | eq() => E | lt() => Order/lt() | gt() => Order/gt() end, Order/lt()))
    -> Eq(match s : Order | eq() => E | lt() => Order/lt() | gt() => Order/gt() end, Order/lt()) =
    Eq/subst((r : Order) => Eq(match r : Order | eq() => E | lt() => Order/lt() | gt() => Order/gt() end, Order/lt()), e, p);

let cons_lt(xh : Bool, zh : Bool, @xt : Bits, @zt : Bits, tail_lt : Eq(cmp_raw(xt, zt), Order/lt()))
    -> Eq(cmp_raw(cons(xh, xt), cons(zh, zt)), Order/lt()) =
    match xh
    | true => match zh | true => force_lt(tail_lt) | false => force_lt(tail_lt) end
    | false => match zh | true => force_lt(tail_lt) | false => force_lt(tail_lt) end
    end;

let trans_cons(@xh : Bool, @xt : Bits, @yh : Bool, @yt : Bits, @zh : Bool, @zt : Bits,
    s1 : Order, e1 : Eq(cmp_raw(xt, yt), s1),
    s2 : Order, e2 : Eq(cmp_raw(yt, zt), s2),
    p : Eq(cmp_raw(cons(xh, xt), cons(yh, yt)), Order/lt()),
    q : Eq(cmp_raw(cons(yh, yt), cons(zh, zt)), Order/lt()),
    ih : (pl : Eq(cmp_raw(xt, yt), Order/lt())) -> (ql : Eq(cmp_raw(yt, zt), Order/lt())) -> Eq(cmp_raw(xt, zt), Order/lt()))
    -> Eq(cmp_raw(cons(xh, xt), cons(zh, zt)), Order/lt()) =
    match s1 : (r1) => Eq(cmp_raw(cons(xh, xt), cons(zh, zt)), Order/lt())
    | gt() => False/absurd(gt_neq_lt(reduce_whole(e1, p)))
    | lt() =>
        match s2 : (r2) => Eq(cmp_raw(cons(xh, xt), cons(zh, zt)), Order/lt())
        | gt() => False/absurd(gt_neq_lt(reduce_whole(e2, q)))
        | lt() => cons_lt(xh, zh, ih(e1)(e2))
        | eq() => cons_lt(xh, zh, Eq/subst((w : Bits) => Eq(cmp_raw(xt, w), Order/lt()), cmp_raw_eq(yt, zt, e2), e1))
        end
    | eq() =>
        match s2 : (r3) => Eq(cmp_raw(cons(xh, xt), cons(zh, zt)), Order/lt())
        | gt() => False/absurd(gt_neq_lt(reduce_whole(e2, q)))
        | lt() => cons_lt(xh, zh, Eq/subst((w : Bits) => Eq(cmp_raw(w, zt), Order/lt()), Eq/sym(cmp_raw_eq(xt, yt, e1)), e2))
        | eq() => False/absurd(false_neq_true(Eq/trans(
            Eq/sym(head_lt_xh(yh, zh, reduce_whole(e2, q))),
            head_lt_yh(xh, yh, reduce_whole(e1, p)))))
        end
    end;

pub rec cmp_raw_trans(x : Bits, y : Bits, z : Bits,
    p : Eq(cmp_raw(x, y), Order/lt()), q : Eq(cmp_raw(y, z), Order/lt()))
    -> Eq(cmp_raw(x, z), Order/lt()) =
    match x
    | b\ =>
        match y
        | b\ => False/absurd(eq_neq_lt(p))
        | b\yh\..yt =>
            match z
            | b\ => False/absurd(gt_neq_lt(q))
            | b\_\.._ => Eq/refl()
            end
        end
    | b\xh\..xt =>
        match y
        | b\ => False/absurd(gt_neq_lt(p))
        | b\yh\..yt =>
            match z
            | b\ => False/absurd(gt_neq_lt(q))
            | b\zh\..zt =>
                trans_cons(cmp_raw(xt, yt), Eq/refl(), cmp_raw(yt, zt), Eq/refl(), p, q,
                    (pl) => (ql) => cmp_raw_trans(xt, yt, zt, pl, ql))
            end
        end
    end;

pub let cmp_refl(a : BigNat) -> Eq(cmp(a, a), Order/eq()) =
    cmp_raw_refl(a.rep);

pub let cmp_eq(a : BigNat, b : BigNat, p : Eq(cmp(a, b), Order/eq())) -> Eq(a, b) =
    big_nat_eq(a, b, cmp_raw_eq(a.rep, b.rep, p));

pub let cmp_flip(a : BigNat, b : BigNat) -> Eq(cmp(b, a), Order/flip(cmp(a, b))) =
    cmp_raw_flip(a.rep, b.rep);

pub let cmp_trans(a : BigNat, b : BigNat, c : BigNat,
    p : Eq(cmp(a, b), Order/lt()), q : Eq(cmp(b, c), Order/lt())) -> Eq(cmp(a, c), Order/lt()) =
    cmp_raw_trans(a.rep, b.rep, c.rep, p, q);

let sub_borrow(a : Bool, b : Bool, bw : Bool) -> Bool =
    match a
    | true => match b | true => bw | false => false end
    | false => match b | true => true | false => bw end
    end;

pub rec sub_raw(x : Bits, y : Bits, borrow : Bool) -> {Bits, Bool} =
    match x
    | b\ =>
        match y
        | b\ => (b\, borrow)
        | b\yh\..yt =>
            let (rest, bw) = sub_raw(b\, yt, sub_borrow(false, yh, borrow));
            (cons(xor3(false, yh, borrow), rest), bw)
        end
    | b\xh\..xt =>
        match y
        | b\ =>
            let (rest, bw) = sub_raw(xt, b\, sub_borrow(xh, false, borrow));
            (cons(xor3(xh, false, borrow), rest), bw)
        | b\yh\..yt =>
            let (rest, bw) = sub_raw(xt, yt, sub_borrow(xh, yh, borrow));
            (cons(xor3(xh, yh, borrow), rest), bw)
        end
    end;

pub let sub(a : BigNat, b : BigNat) -> BigNat =
    let (raw, borrow) = sub_raw(a.rep, b.rep, false);
    match borrow
    | true => zero
    | false => of_bits(raw)
    end;

pub rec of_nat(n : Nat) -> BigNat =
    match n == 0
    | true => zero
    | false => of_bits(combine(n % 2 == 1, of_nat(n / 2).rep))
    end;

pub rec mul_raw(x : Bits, y : Bits) -> Bits =
    match x
    | b\ => b\
    | b\xh\..xt =>
        match xh
        | false => cons(false, mul_raw(xt, y))
        | true => add_raw(y, cons(false, mul_raw(xt, y)), false)
        end
    end;

pub let mul(a : BigNat, b : BigNat) -> BigNat =
    of_bits(mul_raw(a.rep, b.rep));

pub rec mul_pow2(a : BigNat, k : Nat) -> BigNat =
    match k
    | 0 => a
    | kp + 1; ih => dbl(ih)
    end;

pub let mul_small(a : BigNat, c : Nat) -> BigNat =
    mul(a, of_nat(c));

let cong_trim(@s : Bits, @t : Bits, p : Eq(s, t)) -> Eq(trim(s), trim(t)) =
    match p : (q : Eq(Bits, a, b)) => Eq(trim(a), trim(b))
    | refl(@z) => Eq/refl()
    end;

let trim_idem(w : Bits) -> Eq(trim(trim(w)), trim(w)) =
    trim_of_trimmed(trim(w), trim_is_trimmed(w));

let of_bits_eq(u : Bits, v : Bits, p : Eq(trim(u), trim(v))) -> Eq(of_bits(u), of_bits(v)) =
    big_nat_eq(of_bits(u), of_bits(v), p);

let add_combine_l(h : Bool, w : Bits, v : Bits, c : Bool)
    -> Eq(trim(add_raw(combine(h, w), v, c)), trim(add_raw(cons(h, w), v, c))) =
    match w : (a) => Eq(trim(add_raw(combine(h, a), v, c)), trim(add_raw(cons(h, a), v, c)))
    | b\ =>
        match h
        | true => Eq/refl()
        | false =>
            match v : (b) => Eq(trim(add_raw(b\, b, c)), trim(add_raw(cons(false, b\), b, c)))
            | b\ => match c | true => Eq/refl() | false => Eq/refl() end
            | b\_\.._ => Eq/refl()
            end
        end
    | b\_\.._ => Eq/refl()
    end;

rec trim_add_raw_trim_l(u : Bits, v : Bits, c : Bool)
    -> Eq(trim(add_raw(trim(u), v, c)), trim(add_raw(u, v, c))) =
    match u : (a) => Eq(trim(add_raw(trim(a), v, c)), trim(add_raw(a, v, c)))
    | b\ => Eq/refl()
    | b\uh\..ut =>
        match v : (b) => Eq(trim(add_raw(trim(cons(uh, ut)), b, c)), trim(add_raw(cons(uh, ut), b, c)))
        | b\ => Eq/trans(add_combine_l(uh, trim(ut), b\, c),
            cong_combine(xor3(uh, false, c),
                trim_add_raw_trim_l(ut, b\, maj3(uh, false, c))))
        | b\vh\..vt => Eq/trans(add_combine_l(uh, trim(ut), cons(vh, vt), c),
            cong_combine(xor3(uh, vh, c),
                trim_add_raw_trim_l(ut, vt, maj3(uh, vh, c))))
        end
    end;

let trim_add_raw_trim_r(u : Bits, v : Bits, c : Bool)
    -> Eq(trim(add_raw(u, trim(v), c)), trim(add_raw(u, v, c))) =
    Eq/trans(cong_trim(add_comm_raw(u, trim(v), c)),
        Eq/trans(trim_add_raw_trim_l(v, u, c), cong_trim(add_comm_raw(v, u, c))));

let mul_combine_l(h : Bool, w : Bits, v : Bits)
    -> Eq(trim(mul_raw(combine(h, w), v)), trim(mul_raw(cons(h, w), v))) =
    match w : (a) => Eq(trim(mul_raw(combine(h, a), v)), trim(mul_raw(cons(h, a), v)))
    | b\ =>
        match h
        | true => Eq/refl()
        | false => Eq/refl()
        end
    | b\_\.._ => Eq/refl()
    end;

rec trim_mul_raw_trim_l(u : Bits, v : Bits)
    -> Eq(trim(mul_raw(trim(u), v)), trim(mul_raw(u, v))) =
    match u : (a) => Eq(trim(mul_raw(trim(a), v)), trim(mul_raw(a, v)))
    | b\ => Eq/refl()
    | b\uh\..ut =>
        match uh
        | false => Eq/trans(mul_combine_l(false, trim(ut), v),
            cong_combine(false, trim_mul_raw_trim_l(ut, v)))
        | true => Eq/trans(mul_combine_l(true, trim(ut), v),
            Eq/trans(Eq/sym(trim_add_raw_trim_r(v, cons(false, mul_raw(trim(ut), v)), false)),
                Eq/trans(cong_trim(cong_add_raw_r(v, cong_combine(false, trim_mul_raw_trim_l(ut, v)), false)),
                    trim_add_raw_trim_r(v, cons(false, mul_raw(ut, v)), false))))
        end
    end;

rec trim_mul_raw_trim_r(u : Bits, v : Bits)
    -> Eq(trim(mul_raw(u, trim(v))), trim(mul_raw(u, v))) =
    match u : (a) => Eq(trim(mul_raw(a, trim(v))), trim(mul_raw(a, v)))
    | b\ => Eq/refl()
    | b\uh\..ut =>
        match uh
        | false => cong_combine(false, trim_mul_raw_trim_r(ut, v))
        | true => Eq/trans(trim_add_raw_trim_l(v, cons(false, mul_raw(ut, trim(v))), false),
            Eq/trans(Eq/sym(trim_add_raw_trim_r(v, cons(false, mul_raw(ut, trim(v))), false)),
                Eq/trans(cong_trim(cong_add_raw_r(v, cong_combine(false, trim_mul_raw_trim_r(ut, v)), false)),
                    trim_add_raw_trim_r(v, cons(false, mul_raw(ut, v)), false))))
        end
    end;

let trim_cons_cong(h : Bool, @s : Bits, @t : Bits, p : Eq(trim(s), trim(t)))
    -> Eq(trim(cons(h, s)), trim(cons(h, t))) =
    cong_combine(h, p);

let trim_add_raw_l_cong(@s : Bits, @t : Bits, p : Eq(trim(s), trim(t)), v : Bits, c : Bool)
    -> Eq(trim(add_raw(s, v, c)), trim(add_raw(t, v, c))) =
    Eq/trans(Eq/sym(trim_add_raw_trim_l(s, v, c)),
        Eq/trans(cong_trim(cong_add_raw_l(p, v, c)), trim_add_raw_trim_l(t, v, c)));

let trim_add_raw_r_cong(u : Bits, @s : Bits, @t : Bits, p : Eq(trim(s), trim(t)), c : Bool)
    -> Eq(trim(add_raw(u, s, c)), trim(add_raw(u, t, c))) =
    Eq/trans(Eq/sym(trim_add_raw_trim_r(u, s, c)),
        Eq/trans(cong_trim(cong_add_raw_r(u, p, c)), trim_add_raw_trim_r(u, t, c)));

rec trim_mul_zero_r(y : Bits) -> Eq(trim(mul_raw(y, b\)), b\) =
    match y : (a) => Eq(trim(mul_raw(a, b\)), b\)
    | b\ => Eq/refl()
    | b\yh\..yt =>
        match yh
        | false => cong_combine(false, trim_mul_zero_r(yt))
        | true => Eq/trans(cong_trim(add_raw_zero_l(cons(false, mul_raw(yt, b\)))),
            cong_combine(false, trim_mul_zero_r(yt)))
        end
    end;

pub rec trim_mul_one_r(x : Bits) -> Eq(trim(mul_raw(x, cons(true, b\))), trim(x)) =
    match x : (a) => Eq(trim(mul_raw(a, cons(true, b\))), trim(a))
    | b\ => Eq/refl()
    | b\xh\..xt =>
        match xh
        | false => cong_combine(false, trim_mul_one_r(xt))
        | true => cong_combine(true, Eq/trans(
            cong_trim(add_raw_zero_l(mul_raw(xt, cons(true, b\)))),
            trim_mul_one_r(xt)))
        end
    end;

pub rec trim_mul_o_r(x : Bits, y : Bits)
    -> Eq(trim(mul_raw(x, cons(false, y))), trim(cons(false, mul_raw(x, y)))) =
    match x : (a) => Eq(trim(mul_raw(a, cons(false, y))), trim(cons(false, mul_raw(a, y))))
    | b\ => Eq/refl()
    | b\xh\..xt =>
        match xh
        | false => cong_combine(false, trim_mul_o_r(xt, y))
        | true => cong_combine(false, trim_add_raw_r_cong(y, trim_mul_o_r(xt, y), false))
        end
    end;

pub rec trim_mul_i_r(x : Bits, y : Bits)
    -> Eq(trim(mul_raw(x, cons(true, y))), trim(add_raw(x, cons(false, mul_raw(x, y)), false))) =
    match x : (a) => Eq(trim(mul_raw(a, cons(true, y))), trim(add_raw(a, cons(false, mul_raw(a, y)), false)))
    | b\ => Eq/sym(cong_trim(add_raw_zero_l(cons(false, b\))))
    | b\xh\..xt =>
        match xh
        | false => cong_combine(false, trim_mul_i_r(xt, y))
        | true => cong_combine(true, Eq/trans(
            trim_add_raw_r_cong(y, trim_mul_i_r(xt, y), false),
            cong_trim(Eq/trans(
                Eq/sym(add_assoc_raw(y, xt, cons(false, mul_raw(xt, y)), false, false)),
                Eq/trans(
                    cong_add_raw_l(add_comm_raw(y, xt, false), cons(false, mul_raw(xt, y)), false),
                    add_assoc_raw(xt, y, cons(false, mul_raw(xt, y)), false, false))))))
        end
    end;

pub rec trim_mul_comm(x : Bits, y : Bits) -> Eq(trim(mul_raw(x, y)), trim(mul_raw(y, x))) =
    match x : (a) => Eq(trim(mul_raw(a, y)), trim(mul_raw(y, a)))
    | b\ => Eq/sym(trim_mul_zero_r(y))
    | b\xh\..xt =>
        match xh
        | false => Eq/trans(cong_combine(false, trim_mul_comm(xt, y)), Eq/sym(trim_mul_o_r(y, xt)))
        | true => Eq/trans(
            trim_add_raw_r_cong(y, trim_cons_cong(false, trim_mul_comm(xt, y)), false),
            Eq/sym(trim_mul_i_r(y, xt)))
        end
    end;

let add_raw_medial(a : Bits, b : Bits, c : Bits, d : Bits)
    -> Eq(add_raw(add_raw(a, b, false), add_raw(c, d, false), false),
          add_raw(add_raw(a, c, false), add_raw(b, d, false), false)) =
    Eq/trans(add_assoc_raw(a, b, add_raw(c, d, false), false, false),
    Eq/trans(cong_add_raw_r(a, Eq/sym(add_assoc_raw(b, c, d, false, false)), false),
    Eq/trans(cong_add_raw_r(a, cong_add_raw_l(add_comm_raw(b, c, false), d, false), false),
    Eq/trans(cong_add_raw_r(a, add_assoc_raw(c, b, d, false, false), false),
    Eq/sym(add_assoc_raw(a, c, add_raw(b, d, false), false, false))))));

pub rec trim_distrib_l(x : Bits, y : Bits, z : Bits)
    -> Eq(trim(mul_raw(x, add_raw(y, z, false))), trim(add_raw(mul_raw(x, y), mul_raw(x, z), false))) =
    match x : (a) => Eq(trim(mul_raw(a, add_raw(y, z, false))), trim(add_raw(mul_raw(a, y), mul_raw(a, z), false)))
    | b\ => Eq/refl()
    | b\xh\..xt =>
        match xh
        | false => cong_combine(false, trim_distrib_l(xt, y, z))
        | true => Eq/trans(
            trim_add_raw_r_cong(add_raw(y, z, false), trim_cons_cong(false, trim_distrib_l(xt, y, z)), false),
            Eq/sym(cong_trim(add_raw_medial(y, cons(false, mul_raw(xt, y)), z, cons(false, mul_raw(xt, z))))))
        end
    end;

pub let trim_distrib_r(x : Bits, y : Bits, z : Bits)
    -> Eq(trim(mul_raw(add_raw(y, z, false), x)), trim(add_raw(mul_raw(y, x), mul_raw(z, x), false))) =
    Eq/trans(trim_mul_comm(add_raw(y, z, false), x),
    Eq/trans(trim_distrib_l(x, y, z),
    Eq/trans(trim_add_raw_l_cong(trim_mul_comm(x, y), mul_raw(x, z), false),
        trim_add_raw_r_cong(mul_raw(y, x), trim_mul_comm(x, z), false))));

pub rec trim_mul_assoc(x : Bits, y : Bits, z : Bits)
    -> Eq(trim(mul_raw(mul_raw(x, y), z)), trim(mul_raw(x, mul_raw(y, z)))) =
    match x : (a) => Eq(trim(mul_raw(mul_raw(a, y), z)), trim(mul_raw(a, mul_raw(y, z))))
    | b\ => Eq/refl()
    | b\xh\..xt =>
        match xh
        | false => cong_combine(false, trim_mul_assoc(xt, y, z))
        | true => Eq/trans(trim_distrib_r(z, y, cons(false, mul_raw(xt, y))),
            trim_add_raw_r_cong(mul_raw(y, z), trim_cons_cong(false, trim_mul_assoc(xt, y, z)), false))
        end
    end;

pub let mul_comm(a : BigNat, b : BigNat) -> Eq(mul(a, b), mul(b, a)) =
    of_bits_eq(mul_raw(a.rep, b.rep), mul_raw(b.rep, a.rep), trim_mul_comm(a.rep, b.rep));

pub let mul_assoc(a : BigNat, b : BigNat, c : BigNat) -> Eq(mul(mul(a, b), c), mul(a, mul(b, c))) =
    of_bits_eq(mul_raw(trim(mul_raw(a.rep, b.rep)), c.rep),
        mul_raw(a.rep, trim(mul_raw(b.rep, c.rep))),
        Eq/trans(trim_mul_raw_trim_l(mul_raw(a.rep, b.rep), c.rep),
        Eq/trans(trim_mul_assoc(a.rep, b.rep, c.rep),
            Eq/sym(trim_mul_raw_trim_r(a.rep, mul_raw(b.rep, c.rep))))));

pub let distrib_l(a : BigNat, b : BigNat, c : BigNat) -> Eq(mul(a, add(b, c)), add(mul(a, b), mul(a, c))) =
    of_bits_eq(mul_raw(a.rep, trim(add_raw(b.rep, c.rep, false))),
        add_raw(trim(mul_raw(a.rep, b.rep)), trim(mul_raw(a.rep, c.rep)), false),
        Eq/trans(trim_mul_raw_trim_r(a.rep, add_raw(b.rep, c.rep, false)),
        Eq/trans(trim_distrib_l(a.rep, b.rep, c.rep),
        Eq/trans(Eq/sym(trim_add_raw_trim_l(mul_raw(a.rep, b.rep), mul_raw(a.rep, c.rep), false)),
            Eq/sym(trim_add_raw_trim_r(trim(mul_raw(a.rep, b.rep)), mul_raw(a.rep, c.rep), false))))));

pub let distrib_r(a : BigNat, b : BigNat, c : BigNat) -> Eq(mul(add(b, c), a), add(mul(b, a), mul(c, a))) =
    of_bits_eq(mul_raw(trim(add_raw(b.rep, c.rep, false)), a.rep),
        add_raw(trim(mul_raw(b.rep, a.rep)), trim(mul_raw(c.rep, a.rep)), false),
        Eq/trans(trim_mul_raw_trim_l(add_raw(b.rep, c.rep, false), a.rep),
        Eq/trans(trim_distrib_r(a.rep, b.rep, c.rep),
        Eq/trans(Eq/sym(trim_add_raw_trim_l(mul_raw(b.rep, a.rep), mul_raw(c.rep, a.rep), false)),
            Eq/sym(trim_add_raw_trim_r(trim(mul_raw(b.rep, a.rep)), mul_raw(c.rep, a.rep), false))))));

let cong_dbl(@s : BigNat, @t : BigNat, p : Eq(s, t)) -> Eq(dbl(s), dbl(t)) =
    match p : (q : Eq(BigNat, a, b)) => Eq(dbl(a), dbl(b))
    | refl(@z) => Eq/refl()
    end;

let dbl_add(a : BigNat, b : BigNat) -> Eq(dbl(add(a, b)), add(dbl(a), dbl(b))) =
    of_bits_eq(dbl_raw(trim(add_raw(a.rep, b.rep, false))),
        add_raw(trim(dbl_raw(a.rep)), trim(dbl_raw(b.rep)), false),
        Eq/trans(cong_combine(false, trim_idem(add_raw(a.rep, b.rep, false))),
        Eq/trans(Eq/sym(trim_add_raw_trim_l(dbl_raw(a.rep), dbl_raw(b.rep), false)),
            Eq/sym(trim_add_raw_trim_r(trim(dbl_raw(a.rep)), dbl_raw(b.rep), false)))));

let dbl_mul_l(a : BigNat, b : BigNat) -> Eq(dbl(mul(a, b)), mul(dbl(a), b)) =
    of_bits_eq(dbl_raw(trim(mul_raw(a.rep, b.rep))),
        mul_raw(trim(dbl_raw(a.rep)), b.rep),
        Eq/trans(cong_combine(false, trim_idem(mul_raw(a.rep, b.rep))),
            Eq/sym(trim_mul_raw_trim_l(dbl_raw(a.rep), b.rep))));

pub let mul_pow2_add(a : BigNat, b : BigNat, k : Nat)
    -> Eq(mul_pow2(add(a, b), k), add(mul_pow2(a, k), mul_pow2(b, k))) =
    match k : (n) => Eq(mul_pow2(add(a, b), n), add(mul_pow2(a, n), mul_pow2(b, n)))
    | 0 => qed(add(a, b))
    | pred + 1; ih =>
        Eq/trans(cong_dbl(ih), dbl_add(mul_pow2(a, pred), mul_pow2(b, pred)))
    end;

pub let mul_pow2_mul_l(a : BigNat, b : BigNat, k : Nat)
    -> Eq(mul_pow2(mul(a, b), k), mul(mul_pow2(a, k), b)) =
    match k : (n) => Eq(mul_pow2(mul(a, b), n), mul(mul_pow2(a, n), b))
    | 0 => qed(mul(a, b))
    | pred + 1; ih =>
        Eq/trans(cong_dbl(ih), dbl_mul_l(mul_pow2(a, pred), b))
    end;

pub let mul_pow2_compose(a : BigNat, j : Nat, k : Nat)
    -> Eq(mul_pow2(mul_pow2(a, j), k), mul_pow2(a, j + k)) =
    match k : (n) => Eq(mul_pow2(mul_pow2(a, j), n), mul_pow2(a, j + n))
    | 0 => qed(mul_pow2(a, j))
    | pred + 1; ih => cong_dbl(ih)
    end;

pub rec is_even(a : BigNat) -> Bool =
    match view(a)
    | zero() => true
    | succ(low, _) => match low | true => false | false => true end
    end;

pub let div2(a : BigNat) -> BigNat =
    match view(a)
    | zero() => zero
    | succ(_, tail) => tail
    end;

pub rec bit_len(a : BigNat) -> Nat =
    match view(a)
    | zero() => 0
    | succ(_, tail) => bit_len(tail) + 1
    end;

rec div10(a : BigNat) -> {BigNat, Nat} =
    match view(a)
    | zero() => (zero, 0)
    | succ(low, tail) =>
        let (q, r) = div10(tail);
        let rr = match low | true => r * 2 + 1 | false => r * 2 end;
        match rr < 10
        | true => (dbl(q), rr)
        | false => (dbl_succ(q), rr - 10)
        end
    end;

rec to_str_go(a : BigNat, acc : Str) -> Str =
    match is_zero(a)
    | true => acc
    | false =>
        let (q, r) = div10(a);
        to_str_go(q, Str/concat(Nat/to_str(r), acc))
    end;

pub let to_str(a : BigNat) -> Str =
    match is_zero(a)
    | true => "0"
    | false => to_str_go(a, "")
    end;

satisfy Eql(BigNat) {
    eql(a, b) = eql(a, b)
}

satisfy Cmp(BigNat) {
    lt(a, b) = lt(a, b),
    lte(a, b) = lte(a, b),
    gt(a, b) = gt(a, b),
    gte(a, b) = gte(a, b)
}

satisfy Add(BigNat) {
    add(a, b) = add(a, b)
}

satisfy Sub(BigNat) {
    sub(a, b) = sub(a, b)
}

satisfy Mul(BigNat) {
    mul(a, b) = mul(a, b)
}

satisfy Show(BigNat) {
    show(n) = to_str(n)
}

satisfy Ord(BigNat) {
    cmp(a, b) = cmp(a, b)
}
