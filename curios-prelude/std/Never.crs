-- The empty *computational* type: the result of an operation that does not
-- return. `False` is its proof-irrelevant twin, and the difference is what
-- erasure does with them. A `False`-typed result is a proof, so erasure deletes
-- it — and deletes the never-returning call with it, which is how an `exit`
-- behind a proposition silently fails to fire. `Never` is `Type`-sorted, so the
-- call is retained wherever it is written.
--
-- Elimination goes to any `A`, which is what lets a branch that cannot produce
-- a value say so: `Never/absurd(@Nat, proc/exit(1))`. Eliminating into a
-- proposition is the one thing that reopens the hole, and the totality gate on
-- proof positions is what rejects it.

pub induct Never : pub Type
end

pub let absurd(@A : Type, impossible : Never) -> A =
    match impossible
    end;
