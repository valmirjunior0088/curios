use /std/{Bool, Eq, False, True};

pub induct Order : pub Type
| lt()
| eq()
| gt()
end

pub use Order/*;

pub let flip(r : Order) -> Order =
    match r
    | lt() => Order/gt()
    | eq() => Order/eq()
    | gt() => Order/lt()
    end;

pub let cong_flip(@s : Order, @t : Order, p : Eq(s, t)) -> Eq(flip(s), flip(t)) =
    match p : (q : Eq(Order, a, b)) => Eq(flip(a), flip(b))
    | refl(z) => Eq/refl()
    end;

let is_lt(r : Order) -> Bool =
    match r
    | lt() => true
    | eq() => false
    | gt() => false
    end;

let is_eq(r : Order) -> Bool =
    match r
    | lt() => false
    | eq() => true
    | gt() => false
    end;

let is_gt(r : Order) -> Bool =
    match r
    | lt() => false
    | eq() => false
    | gt() => true
    end;

let bool_clash(p : Eq(false, true)) -> False =
    Eq/subst((b : Bool) => match b : Prop | false => True | true => False end, p, True/qed());

pub let lt_neq_eq(p : Eq(Order/lt(), Order/eq())) -> False =
    bool_clash(match p : (q : Eq(Order, s, t)) => Eq(is_eq(s), is_eq(t))
        | refl(z) => Eq/refl()
        end);

pub let gt_neq_eq(p : Eq(Order/gt(), Order/eq())) -> False =
    bool_clash(match p : (q : Eq(Order, s, t)) => Eq(is_eq(s), is_eq(t))
        | refl(z) => Eq/refl()
        end);

pub let eq_neq_lt(p : Eq(Order/eq(), Order/lt())) -> False =
    bool_clash(match p : (q : Eq(Order, s, t)) => Eq(is_lt(s), is_lt(t))
        | refl(z) => Eq/refl()
        end);

pub let gt_neq_lt(p : Eq(Order/gt(), Order/lt())) -> False =
    bool_clash(match p : (q : Eq(Order, s, t)) => Eq(is_lt(s), is_lt(t))
        | refl(z) => Eq/refl()
        end);

pub let eq_neq_gt(p : Eq(Order/eq(), Order/gt())) -> False =
    bool_clash(match p : (q : Eq(Order, s, t)) => Eq(is_gt(s), is_gt(t))
        | refl(z) => Eq/refl()
        end);

pub let lt_neq_gt(p : Eq(Order/lt(), Order/gt())) -> False =
    bool_clash(match p : (q : Eq(Order, s, t)) => Eq(is_gt(s), is_gt(t))
        | refl(z) => Eq/refl()
        end);
