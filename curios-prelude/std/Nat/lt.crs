pub use /sys/Nat/{lt};

use /std/{Nat, Bool, Eq};

--- A comparison that came back `false` is the other one: `a <= b` failing gives `b < a`.
---
--- The dual of `Nat/le/of_not_lt`: the bridge from a refuted `<=` held as a hypothesis.
pub let of_not_le(a: Nat, b: Nat, p: Bool/Holds(Bool/not(a <= b))) -> Bool/Holds(b < a) =
    match b
    | 0 =>
        match a
        | 0 => match p end
        | _ + 1 => Bool/True/qed()
        end
    | bp + 1 =>
        match a
        | 0 => match p end
        | ap + 1 => of_not_le(ap, bp, p)
        end
    end;

--- A bound whose two sides differ is strict: `a <= b` and `a == b` failing give `a < b`.
---
--- The case of a disequality its loose bound holds in, as `of_not_le` is the case it fails in.
pub let of_le_ne(
    a: Nat,
    b: Nat,
    p: Bool/Holds(a <= b),
    q: Bool/Holds(Bool/not(a == b)),
) -> Bool/Holds(a < b) =
    match a < b
    | true => Bool/True/qed()
    | false =>
        let back: Bool/Holds(b <= a) = Nat/le/of_not_lt(a, b, Bool/True/qed());
        let same: Eq()(a, b) = Nat/le/antisym(a, b, p, back);
        let absurd: Bool/Holds(Bool/not(a == a)) =
            Eq/subst((x: Nat) => Bool/Holds(Bool/not(a == x)), Eq/sym(same), q);
        match absurd end
    end;

--- A strict bound composed with a loose one stays strict.
pub let of_lt_le(
    a: Nat,
    b: Nat,
    c: Nat,
    p: Bool/Holds(a < b),
    q: Bool/Holds(b <= c),
) -> Bool/Holds(a < c) =
    Nat/le/trans(p, q);

--- Two bounded digits in adjacent places stay under the product of their radices: `a < m` and `b < n` give `a * n + b < m * n`.
---
--- The bound every positional encoding wants, and the step a proof the elaborator writes from the facts in scope states a quotient's upper bound with: `x < (x / d + 1) * d`, read as the remainder beside its quotient's multiple. `a * n + b < a * n + n` *is* `b < n` after cancellation, so the hypothesis inhabits the first step unchanged; what the second step needs is that `a + 1 <= m` scales, which is [`Nat/le/mul_mono_r`].
pub let add_mul_lt(
    a: Nat,
    b: Nat,
    m: Nat,
    n: Nat,
    pa: Bool/Holds(a < m),
    pb: Bool/Holds(b < n),
) -> Bool/Holds(a * n + b < m * n) =
    of_lt_le(a * n + b, a * n + n, m * n, pb, Nat/le/mul_mono_r(n, pa));
