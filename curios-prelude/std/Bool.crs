pub use /sys/{Bool};
pub use /sys/Bool/{and, or, xor, eql};
use /std/{Str, Option, Eq, False, True, Eql, Or, And, Show};

pub let not(b : Bool) -> Bool =
    xor(b, true);

pub let to_str(b : Bool) -> Str =
    match b
    | true => "true"
    | false => "false"
    end;

pub let of_str(s : Str) -> Option(Bool) =
    choose
    | s == "true" => Option/some(true)
    | s == "false" => Option/some(false)
    | _ => Option/none()
    end;

-- The two boolean constructors are distinct: a proof otherwise is absurd. Every `match b : Prop` decision procedure discharges its impossible branch through this.
pub let false_neq_true(p : Eq(false, true)) -> False =
    Eq/subst((b : Bool) => match b | true => False | false => True end, p, True/qed());

satisfy Eql(Bool) {
    eql = eql
}

satisfy Or(Bool) {
    or = or
}

satisfy And(Bool) {
    and = and
}

satisfy Show(Bool) {
    show = to_str
}
