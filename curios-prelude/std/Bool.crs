pub use /sys/{Bool};
pub use /sys/Bool/{and, or, xor, eql};
use /std/{Str, Option, Eql, Or, And};

pub let not(b : Bool) -> Bool =
    xor(b, true);

pub let to_str(b : Bool) -> Str =
    match b
    | true => "true"
    | false => "false"
    end;

pub let of_str(s : Str) -> Option(Bool) =
    choose
    | s == "true" => Option/some(true)
    | s == "false" => Option/some(false)
    | _ => Option/none()
    end;

satisfy Eql(Bool) {
    eql(a, b) = eql(a, b)
}

satisfy Or(Bool) {
    or(a, b) = or(a, b)
}

satisfy And(Bool) {
    and(a, b) = and(a, b)
}
