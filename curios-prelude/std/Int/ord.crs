use /std/{Int, Bool, Eq, Ordering, Ord, proved};

--- The order of the two.
pub let ord(x: Int, y: Int) -> Ordering =
    match
    | x < y => Ordering/lt()
    | x == y => Ordering/eq()
    | _ => Ordering/gt()
    end;

-- Of two integers that differ, the one that is at most the other is below it.
let below(
    a: Int,
    b: Int,
    le: Bool/Holds(b <= a),
    ne: Bool/Holds(Bool/not(a == b)),
) -> Bool/Holds(b < a) =
    match b < a
    | true => Bool/True/qed()
    | false =>
        let same: Eq()(a, b) = Int/le/antisym(a, b, proved(), le);
        match Eq/subst((x: Int) => Bool/Holds(Bool/not(a == x)), Eq/sym(same), ne)
        end
    end;

--- An integer is `eq` to itself.
pub let refl(a: Int) -> Eq()(ord(a, a), Ordering/eq()) =
    Eq/refl();

--- `a < b` gives `ord(a, b)` as `lt`.
pub let of_lt(a: Int, b: Int, p: Bool/Holds(a < b)) -> Eq()(ord(a, b), Ordering/lt()) =
    match a < b
    | true => Eq/refl()
    | false => match proved(@Bool/False) end
    end;

--- An equation gives `ord(a, b)` as `eq`.
pub let of_eq(a: Int, b: Int, e: Eq()(a, b)) -> Eq()(ord(a, b), Ordering/eq()) =
    Eq/subst((x: Int) => Eq()(ord(a, x), Ordering/eq()), e, refl(a));

--- `b < a` gives `ord(a, b)` as `gt`.
pub let of_gt(a: Int, b: Int, p: Bool/Holds(b < a)) -> Eq()(ord(a, b), Ordering/gt()) =
    match
    | a < b => match proved(@Bool/False) end
    | a == b => match proved(@Bool/False) end
    | _ => Eq/refl()
    end;

--- `ord(a, b)` is `lt` only where `a < b`.
pub let lt(a: Int, b: Int, h: Eq()(ord(a, b), Ordering/lt())) -> Bool/Holds(a < b) =
    match
    | a < b => Bool/True/qed()
    | a == b => match Ordering/eq_neq_lt(h) end
    | _ => match Ordering/gt_neq_lt(h) end
    end;

--- `ord(a, b)` is `eq` only where `a` is `b`: the order agrees with equality.
pub let eq(a: Int, b: Int, h: Eq()(ord(a, b), Ordering/eq())) -> Eq()(a, b) =
    match
    | a < b => match Ordering/eq_neq_lt(Eq/sym(h)) end
    | a == b => Int/eq_of_eql(a, b, Bool/True/qed())
    | _ => match Ordering/gt_neq_eq(h) end
    end;

--- `ord(a, b)` is `gt` only where `b < a`.
pub let gt(a: Int, b: Int, h: Eq()(ord(a, b), Ordering/gt())) -> Bool/Holds(b < a) =
    match
    | a < b => match Ordering/gt_neq_lt(Eq/sym(h)) end
    | a == b => match Ordering/gt_neq_eq(Eq/sym(h)) end
    | _ => below(a, b, proved(), Bool/True/qed())
    end;

--- `ord(a, b)` is not `gt` only where `a <= b`.
pub let le(a: Int, b: Int, h: Bool/Holds(Ordering/is_le(ord(a, b)))) -> Bool/Holds(a <= b) =
    match
    | a < b => proved()
    | a == b => Int/le/of_eq(Int/eq_of_eql(a, b, Bool/True/qed()))
    | _ => match h end
    end;

--- `a <= b` gives `ord(a, b)` as `lt` or `eq`.
pub let of_le(a: Int, b: Int, p: Bool/Holds(a <= b)) -> Bool/Holds(Ordering/is_le(ord(a, b))) =
    match
    | a < b => Bool/True/qed()
    | a == b => Bool/True/qed()
    | _ =>
        let strict: Bool/Holds(b < a) = below(a, b, proved(), Bool/True/qed());
        match proved(@Bool/False) end
    end;

--- `ord` answers the flipped answer with its operands swapped.
pub let flips: Ord/Flips(ord) =
    (a, b) =>
        match
        | a < b => of_gt(b, a, Bool/True/qed())
        | a == b => of_eq(b, a, Eq/sym(Int/eq_of_eql(a, b, Bool/True/qed())))
        | _ => of_lt(b, a, below(a, b, proved(), Bool/True/qed()))
        end;

--- `ord` as a relation carries across a middle element.
pub let transitive: Ord/Transitive(Ord/le(ord)) =
    (a, b, c, p, q) => of_le(a, c, Int/le/trans(le(a, b, p), le(b, c, q)));
