pub use /sys/Int/{lt};

use /std/{Int, Bool, Eq};

--- `a < b` gives `n + a < n + b`: a dividend is below its quotient's multiple raised by its divisor's magnitude, as the elaborator's proofs read an `Int` quotient's bound from above.
pub let add_mono_l(n: Int, @a: Int, @b: Int, p: Bool/Holds(a < b)) -> Bool/Holds(n + a < n + b) =
    p;

--- A bound whose two sides differ is strict: `a <= b` and `a == b` failing give `a < b`.
---
--- The case of a disequality its loose bound holds in.
pub let of_le_ne(
    a: Int,
    b: Int,
    p: Bool/Holds(a <= b),
    q: Bool/Holds(Bool/not(a == b)),
) -> Bool/Holds(a < b) =
    match a < b
    | true => Bool/True/qed()
    | false =>
        let back: Bool/Holds(b <= a) = Bool/True/qed();
        let same: Eq()(a, b) = Int/le/antisym(a, b, p, back);
        let absurd: Bool/Holds(Bool/not(a == a)) =
            Eq/subst((x: Int) => Bool/Holds(Bool/not(a == x)), Eq/sym(same), q);
        match absurd end
    end;
