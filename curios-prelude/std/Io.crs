pub use /sys/{Io};
pub use /sys/Io/{stdin, stdout, stderr};
use /std/{Bytes, Byte, Str, Nat, Option, Result, Lst};

pub induct Error : pub Type
| not_found()
| permission_denied()
| exists()
| refused()
| tls()
| would_block()
| other(Nat)
end

let errors : Lst({Nat, Error}) =
    [
        (/sys/Io/Status/not_found, Error/not_found()),
        (/sys/Io/Status/permission_denied, Error/permission_denied()),
        (/sys/Io/Status/exists, Error/exists()),
        (/sys/Io/Status/refused, Error/refused()),
        (/sys/Io/Status/tls, Error/tls()),
        (/sys/Io/Status/would_block, Error/would_block())
    ];

pub let error_of(status : Nat) -> Error =
    Lst/fold(errors, Error/other(status), (entry, acc) =>
        match status == entry.0 : Error
        | true => entry.1
        | false => acc
        end);

pub induct Mode : pub Type
| read()
| write()
| append()
end

pub let of_mode(mode : Mode) -> Nat =
    match mode : Nat
    | read() => /sys/Io/Mode/read
    | write() => /sys/Io/Mode/write
    | append() => /sys/Io/Mode/append
    end;

pub induct Read : pub Type
| chunk(Bytes)
| eof()
| error(Error)
end

pub let read(h : Io, n : Nat) -> Read =
    let r = /sys/Io/read(h, n);
    choose
    | r.status == /sys/Io/Status/ok => Read/chunk(r.bytes)
    | r.status == /sys/Io/Status/eof => Read/eof()
    | _ => Read/error(error_of(r.status))
    end;

pub rec write(h : Io, b : Bytes) -> Result({}, Error) =
    let r = /sys/Io/write(h, b);
    choose
    | r.status != /sys/Io/Status/ok => Result/failure(error_of(r.status))
    | r.written < Bytes/len(b) => write(h, Bytes/slice(b, r.written, Bytes/len(b)))
    | _ => Result/success(())
    end;

pub let print(s : Str) -> {} =
    let _ = write(stdout, Str/to_bytes(s));
    ();

pub let print_err(s : Str) -> {} =
    let _ = write(stderr, Str/to_bytes(s));
    ();

pub let input() -> Option(Bytes) =
    rec go(acc : Bytes) -> Option(Bytes) =
        let r = /sys/Io/read(stdin, 1);
        choose
        | r.status != /sys/Io/Status/ok && Bytes/len(acc) == 0 => Option/none()
        | r.status != /sys/Io/Status/ok => Option/some(acc)
        | Byte/to_nat(Option/unwrap_or(Bytes/get(r.bytes, 0), 0)) == 0x0A => Option/some(acc)
        | _ => go(x\..acc\..r.bytes)
        end;
    go(x\);
