use /std/{List};
use /std/ops/{Eql};
use /std/Tui/{Glyph, Style};

--- One column of a row of the screen: a glyph in its style, or the second column of the wide glyph before it.
pub induct Tile: pub Type
--- A glyph, drawn from this column.
| glyph(Glyph, Style)
--- The second column of the wide glyph before it: it writes nothing of its own.
| continuation()
end

pub use Tile/*;

satisfy Eql(Tile) {
    ..
}

--- A space in the plain style.
pub let blank: Tile =
    Tile/glyph(Glyph/space, Style/plain);

--- The tiles `g` takes in `style`: itself, and a continuation where it is wide.
pub let of_glyph(g: Glyph, style: Style) -> List(Tile) =
    match Glyph/width(g) == 2
    | true => [Tile/glyph(g, style), Tile/continuation()]
    | false => [Tile/glyph(g, style)]
    end;
