use /std/{Nat, Bool, Bits, Str, Order, Eq, False, True, Eql, Cmp, Add, Sub, Mul, Show, Ord};
use /std/Bool/{false_neq_true};
use /std/Order/{lt_neq_eq, gt_neq_eq, eq_neq_lt, gt_neq_lt};
use /std/Bits/{cons};
use /std/BigNat/{BigNat, of_bits, zero};
use /std/BigNat/add/{xor3};

let sub_borrow(a : Bool, b : Bool, bw : Bool) -> Bool =
    match a
    | true => match b | true => bw | false => false end
    | false => match b | true => true | false => bw end
    end;

pub rec sub_raw(x : Bits, y : Bits, borrow : Bool) -> {Bits, Bool} =
    match x
    | b\ =>
        match y
        | b\ => (b\, borrow)
        | b\yh\..yt =>
            let (rest, bw) = sub_raw(b\, yt, sub_borrow(false, yh, borrow));
            (cons(xor3(false, yh, borrow), rest), bw)
        end
    | b\xh\..xt =>
        match y
        | b\ =>
            let (rest, bw) = sub_raw(xt, b\, sub_borrow(xh, false, borrow));
            (cons(xor3(xh, false, borrow), rest), bw)
        | b\yh\..yt =>
            let (rest, bw) = sub_raw(xt, yt, sub_borrow(xh, yh, borrow));
            (cons(xor3(xh, yh, borrow), rest), bw)
        end
    end;

pub let sub(a : BigNat, b : BigNat) -> BigNat =
    let (raw, borrow) = sub_raw(a.rep, b.rep, false);
    match borrow
    | true => zero
    | false => of_bits(raw)
    end;

