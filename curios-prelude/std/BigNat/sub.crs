use /std/{Nat, Bool, Bits, Str, Order, Eq, False, True, Eql, Cmp, Add, Sub, Mul, Show, Ord};
use /std/Bool/{false_neq_true};
use /std/Order/{lt_neq_eq, gt_neq_eq, eq_neq_lt, gt_neq_lt};
use /std/BigNat/{BigNat, of_bits, xor3, zero};

let borrow_out(a: Bool, b: Bool, bw: Bool) -> Bool =
    match a
    | true => match b | true => bw | false => false end
    | false => match b | true => true | false => bw end
    end;

pub rec raw(x: Bits, y: Bits, borrow: Bool) -> {Bits, Bool} =
    match x
    | b[] =>
        match y
        | b[] => (b[], borrow)
        | b[yh, ..yt] =>
            let (rest, bw) = raw(b[], yt, borrow_out(false, yh, borrow));
            (b[xor3(false, yh, borrow), ..rest], bw)
        end
    | b[xh, ..xt] =>
        match y
        | b[] =>
            let (rest, bw) = raw(xt, b[], borrow_out(xh, false, borrow));
            (b[xor3(xh, false, borrow), ..rest], bw)
        | b[yh, ..yt] =>
            let (rest, bw) = raw(xt, yt, borrow_out(xh, yh, borrow));
            (b[xor3(xh, yh, borrow), ..rest], bw)
        end
    end;

pub let sub(a: BigNat, b: BigNat) -> BigNat =
    let (bits, borrow) = raw(a.rep, b.rep, false);
    match borrow | true => zero | false => of_bits(bits) end;
