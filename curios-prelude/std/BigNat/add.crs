use /std/{Nat, Bool, Bits, Str, Order, Eq, False, True, Eql, Cmp, Add, Sub, Mul, Show, Ord};
use /std/Bool/{false_neq_true};
use /std/Order/{lt_neq_eq, gt_neq_eq, eq_neq_lt, gt_neq_lt};
use /std/Bits/{cons};
use /std/BigNat/{BigNat, Canonical, combine, is_trimmed, is_trimmed_of_canonical, of_bits, refl_at, tail_is_trimmed, trim};

pub rec succ_raw(x : Bits) -> Bits =
    match x
    | b\ => cons(true, b\)
    | b\h\..t =>
        match h
        | true => cons(false, succ_raw(t))
        | false => cons(true, t)
        end
    end;

pub let succ(a : BigNat) -> BigNat =
    of_bits(succ_raw(a.rep));

pub let xor3(a : Bool, b : Bool, c : Bool) -> Bool =
    match a
    | true => match b | true => c | false => match c | true => false | false => true end end
    | false => match b | true => match c | true => false | false => true end | false => c end
    end;

pub let maj3(a : Bool, b : Bool, c : Bool) -> Bool =
    match a
    | true => match b | true => true | false => c end
    | false => match b | true => c | false => false end
    end;

pub rec add_raw(x : Bits, y : Bits, carry : Bool) -> Bits =
    match x
    | b\ =>
        match y
        | b\ => match carry | true => cons(true, b\) | false => b\ end
        | b\yh\..yt => cons(xor3(false, yh, carry), add_raw(b\, yt, maj3(false, yh, carry)))
        end
    | b\xh\..xt =>
        match y
        | b\ => cons(xor3(xh, false, carry), add_raw(xt, b\, maj3(xh, false, carry)))
        | b\yh\..yt => cons(xor3(xh, yh, carry), add_raw(xt, yt, maj3(xh, yh, carry)))
        end
    end;

pub let add(a : BigNat, b : BigNat) -> BigNat =
    of_bits(add_raw(a.rep, b.rep, false));

pub let cong_cons2(@h1 : Bool, @h2 : Bool, ph : Eq(h1, h2), @t1 : Bits, @t2 : Bits, pt : Eq(t1, t2))
    -> Eq(cons(h1, t1), cons(h2, t2)) =
    match ph : (a, b, q) => Eq(cons(a, t1), cons(b, t2))
    | refl(@z) =>
        match pt : (a2, b2, q2) => Eq(cons(h1, a2), cons(h1, b2))
        | refl(@z2) => Eq/refl()
        end
    end;

let cong_add_raw_c(x : Bits, y : Bits, @c1 : Bool, @c2 : Bool, p : Eq(c1, c2))
    -> Eq(add_raw(x, y, c1), add_raw(x, y, c2)) =
    Eq/cong((c) => add_raw(x, y, c), p);

let cong_of_bits(@s : Bits, @t : Bits, p : Eq(s, t)) -> Eq(of_bits(s), of_bits(t)) =
    Eq/cong(of_bits, p);

let xor3_comm(a : Bool, b : Bool, c : Bool) -> Eq(xor3(a, b, c), xor3(b, a, c)) =
    match a
    | true => match b | true => refl_at(xor3(true, true, c)) | false => refl_at(xor3(true, false, c)) end
    | false => match b | true => refl_at(xor3(false, true, c)) | false => refl_at(xor3(false, false, c)) end
    end;

let maj3_comm(a : Bool, b : Bool, c : Bool) -> Eq(maj3(a, b, c), maj3(b, a, c)) =
    match a
    | true => match b | true => refl_at(maj3(true, true, c)) | false => refl_at(maj3(true, false, c)) end
    | false => match b | true => refl_at(maj3(false, true, c)) | false => refl_at(maj3(false, false, c)) end
    end;

pub rec add_comm_raw(x : Bits, y : Bits, c : Bool) -> Eq(add_raw(x, y, c), add_raw(y, x, c)) =
    match x : (a) => Eq(add_raw(a, y, c), add_raw(y, a, c))
    | b\ =>
        match y : (b) => Eq(add_raw(b\, b, c), add_raw(b, b\, c))
        | b\ => refl_at(add_raw(b\, b\, c))
        | b\yh\..yt => add_raw_swap_step(b\, yt, false, yh, c)
        end
    | b\xh\..xt =>
        match y : (b) => Eq(add_raw(cons(xh, xt), b, c), add_raw(b, cons(xh, xt), c))
        | b\ => add_raw_swap_step(xt, b\, xh, false, c)
        | b\yh\..yt => add_raw_swap_step(xt, yt, xh, yh, c)
        end
    end
and add_raw_swap_step(x : Bits, y : Bits, h1 : Bool, h2 : Bool, c : Bool)
    -> Eq(cons(xor3(h1, h2, c), add_raw(x, y, maj3(h1, h2, c))),
          cons(xor3(h2, h1, c), add_raw(y, x, maj3(h2, h1, c)))) =
    cong_cons2(xor3_comm(h1, h2, c),
        Eq/trans(add_comm_raw(x, y, maj3(h1, h2, c)), cong_add_raw_c(y, x, maj3_comm(h1, h2, c))));

let cong_succ_raw(@s : Bits, @t : Bits, p : Eq(s, t)) -> Eq(succ_raw(s), succ_raw(t)) =
    Eq/cong(succ_raw, p);

pub let cong_add_raw_l(@s : Bits, @t : Bits, p : Eq(s, t), y : Bits, c : Bool)
    -> Eq(add_raw(s, y, c), add_raw(t, y, c)) =
    Eq/cong((w) => add_raw(w, y, c), p);

pub let cong_add_raw_r(x : Bits, @s : Bits, @t : Bits, p : Eq(s, t), c : Bool)
    -> Eq(add_raw(x, s, c), add_raw(x, t, c)) =
    Eq/cong((w) => add_raw(x, w, c), p);

rec add_raw_zero_r(x : Bits) -> Eq(add_raw(x, b\, false), x) =
    match x : (a) => Eq(add_raw(a, b\, false), a)
    | b\ => Eq/refl()
    | b\h\..t =>
        match h
        | true => cong_cons2(refl_at(true), add_raw_zero_r(t))
        | false => cong_cons2(refl_at(false), add_raw_zero_r(t))
        end
    end;

pub rec add_raw_zero_l(y : Bits) -> Eq(add_raw(b\, y, false), y) =
    match y : (b) => Eq(add_raw(b\, b, false), b)
    | b\ => Eq/refl()
    | b\h\..t =>
        match h
        | true => cong_cons2(refl_at(true), add_raw_zero_l(t))
        | false => cong_cons2(refl_at(false), add_raw_zero_l(t))
        end
    end;

rec add_raw_succ_r(x : Bits) -> Eq(add_raw(x, b\, true), succ_raw(x)) =
    match x : (a) => Eq(add_raw(a, b\, true), succ_raw(a))
    | b\ => Eq/refl()
    | b\h\..t =>
        match h
        | true => cong_cons2(refl_at(false), add_raw_succ_r(t))
        | false => cong_cons2(refl_at(true), add_raw_zero_r(t))
        end
    end;

rec add_raw_succ_l(y : Bits) -> Eq(add_raw(b\, y, true), succ_raw(y)) =
    match y : (b) => Eq(add_raw(b\, b, true), succ_raw(b))
    | b\ => Eq/refl()
    | b\h\..t =>
        match h
        | true => cong_cons2(refl_at(false), add_raw_succ_l(t))
        | false => cong_cons2(refl_at(true), add_raw_zero_l(t))
        end
    end;

pub rec add_raw_carry_spec(x : Bits, y : Bits) -> Eq(add_raw(x, y, true), succ_raw(add_raw(x, y, false))) =
    match x : (a) => Eq(add_raw(a, y, true), succ_raw(add_raw(a, y, false)))
    | b\ =>
        match y : (b) => Eq(add_raw(b\, b, true), succ_raw(add_raw(b\, b, false)))
        | b\ => Eq/refl()
        | b\yh\..yt =>
            match yh
            | true => cong_cons2(refl_at(false), add_raw_carry_spec(b\, yt))
            | false => Eq/refl()
            end
        end
    | b\xh\..xt =>
        match y : (b) => Eq(add_raw(cons(xh, xt), b, true), succ_raw(add_raw(cons(xh, xt), b, false)))
        | b\ =>
            match xh
            | true => cong_cons2(refl_at(false), add_raw_carry_spec(xt, b\))
            | false => Eq/refl()
            end
        | b\yh\..yt =>
            match xh
            | true =>
                match yh
                | true => Eq/refl()
                | false => cong_cons2(refl_at(false), add_raw_carry_spec(xt, yt))
                end
            | false =>
                match yh
                | true => cong_cons2(refl_at(false), add_raw_carry_spec(xt, yt))
                | false => Eq/refl()
                end
            end
        end
    end;

pub rec add_raw_succ_out_l(u : Bits, v : Bits, c : Bool)
    -> Eq(add_raw(succ_raw(u), v, c), succ_raw(add_raw(u, v, c))) =
    match u : (a) => Eq(add_raw(succ_raw(a), v, c), succ_raw(add_raw(a, v, c)))
    | b\ =>
        match v : (b) => Eq(add_raw(succ_raw(b\), b, c), succ_raw(add_raw(b\, b, c)))
        | b\ =>
            match c
            | true => Eq/refl()
            | false => Eq/refl()
            end
        | b\vh\..vt =>
            match vh
            | true =>
                match c
                | true => Eq/refl()
                | false => cong_cons2(refl_at(false), add_raw_carry_spec(b\, vt))
                end
            | false =>
                match c
                | true => cong_cons2(refl_at(false), add_raw_carry_spec(b\, vt))
                | false => Eq/refl()
                end
            end
        end
    | b\uh\..ut =>
        match uh
        | true =>
            match v : (b) => Eq(add_raw(succ_raw(cons(true, ut)), b, c), succ_raw(add_raw(cons(true, ut), b, c)))
            | b\ =>
                match c
                | true => cong_cons2(refl_at(true), Eq/trans(add_raw_succ_out_l(ut, b\, false), Eq/sym(add_raw_carry_spec(ut, b\))))
                | false => cong_cons2(refl_at(false), add_raw_succ_out_l(ut, b\, false))
                end
            | b\vh\..vt =>
                match vh
                | true =>
                    match c
                    | true => cong_cons2(refl_at(false), add_raw_succ_out_l(ut, vt, true))
                    | false => cong_cons2(refl_at(true), Eq/trans(add_raw_succ_out_l(ut, vt, false), Eq/sym(add_raw_carry_spec(ut, vt))))
                    end
                | false =>
                    match c
                    | true => cong_cons2(refl_at(true), Eq/trans(add_raw_succ_out_l(ut, vt, false), Eq/sym(add_raw_carry_spec(ut, vt))))
                    | false => cong_cons2(refl_at(false), add_raw_succ_out_l(ut, vt, false))
                    end
                end
            end
        | false =>
            match v : (b) => Eq(add_raw(succ_raw(cons(false, ut)), b, c), succ_raw(add_raw(cons(false, ut), b, c)))
            | b\ =>
                match c
                | true => cong_cons2(refl_at(false), add_raw_carry_spec(ut, b\))
                | false => Eq/refl()
                end
            | b\vh\..vt =>
                match vh
                | true =>
                    match c
                    | true => Eq/refl()
                    | false => cong_cons2(refl_at(false), add_raw_carry_spec(ut, vt))
                    end
                | false =>
                    match c
                    | true => cong_cons2(refl_at(false), add_raw_carry_spec(ut, vt))
                    | false => Eq/refl()
                    end
                end
            end
        end
    end;

pub rec add_raw_succ_out_r(u : Bits, v : Bits, c : Bool)
    -> Eq(add_raw(u, succ_raw(v), c), succ_raw(add_raw(u, v, c))) =
    match v : (b) => Eq(add_raw(u, succ_raw(b), c), succ_raw(add_raw(u, b, c)))
    | b\ =>
        match u : (a) => Eq(add_raw(a, succ_raw(b\), c), succ_raw(add_raw(a, b\, c)))
        | b\ =>
            match c
            | true => Eq/refl()
            | false => Eq/refl()
            end
        | b\uh\..ut =>
            match uh
            | true =>
                match c
                | true => Eq/refl()
                | false => cong_cons2(refl_at(false), add_raw_carry_spec(ut, b\))
                end
            | false =>
                match c
                | true => cong_cons2(refl_at(false), add_raw_carry_spec(ut, b\))
                | false => Eq/refl()
                end
            end
        end
    | b\vh\..vt =>
        match vh
        | true =>
            match u : (a) => Eq(add_raw(a, succ_raw(cons(true, vt)), c), succ_raw(add_raw(a, cons(true, vt), c)))
            | b\ =>
                match c
                | true => cong_cons2(refl_at(true), Eq/trans(add_raw_succ_out_r(b\, vt, false), Eq/sym(add_raw_carry_spec(b\, vt))))
                | false => cong_cons2(refl_at(false), add_raw_succ_out_r(b\, vt, false))
                end
            | b\uh\..ut =>
                match uh
                | true =>
                    match c
                    | true => cong_cons2(refl_at(false), add_raw_succ_out_r(ut, vt, true))
                    | false => cong_cons2(refl_at(true), Eq/trans(add_raw_succ_out_r(ut, vt, false), Eq/sym(add_raw_carry_spec(ut, vt))))
                    end
                | false =>
                    match c
                    | true => cong_cons2(refl_at(true), Eq/trans(add_raw_succ_out_r(ut, vt, false), Eq/sym(add_raw_carry_spec(ut, vt))))
                    | false => cong_cons2(refl_at(false), add_raw_succ_out_r(ut, vt, false))
                    end
                end
            end
        | false =>
            match u : (a) => Eq(add_raw(a, succ_raw(cons(false, vt)), c), succ_raw(add_raw(a, cons(false, vt), c)))
            | b\ =>
                match c
                | true => cong_cons2(refl_at(false), add_raw_carry_spec(b\, vt))
                | false => Eq/refl()
                end
            | b\uh\..ut =>
                match uh
                | true =>
                    match c
                    | true => Eq/refl()
                    | false => cong_cons2(refl_at(false), add_raw_carry_spec(ut, vt))
                    end
                | false =>
                    match c
                    | true => cong_cons2(refl_at(false), add_raw_carry_spec(ut, vt))
                    | false => Eq/refl()
                    end
                end
            end
        end
    end;

pub rec add_assoc_raw(x : Bits, y : Bits, z : Bits, c1 : Bool, c2 : Bool)
    -> Eq(add_raw(add_raw(x, y, c1), z, c2), add_raw(x, add_raw(y, z, c1), c2)) =
    match x : (xv) => Eq(add_raw(add_raw(xv, y, c1), z, c2), add_raw(xv, add_raw(y, z, c1), c2))
    | b\ =>
        match y : (yv) => Eq(add_raw(add_raw(b\, yv, c1), z, c2), add_raw(b\, add_raw(yv, z, c1), c2))
        | b\ =>
            match z : (zv) => Eq(add_raw(add_raw(b\, b\, c1), zv, c2), add_raw(b\, add_raw(b\, zv, c1), c2))
            | b\ =>
                match c1
                | true =>
                    match c2
                    | true =>
                        Eq/refl()
                    | false =>
                        Eq/refl()
                    end
                | false =>
                    match c2
                    | true =>
                        Eq/refl()
                    | false =>
                        Eq/refl()
                    end
                end
            | b\zh\..zt =>
                match c1
                | true => Eq/trans(add_raw_succ_out_l(b\, cons(zh, zt), c2), Eq/sym(Eq/trans(cong_add_raw_r(b\, add_raw_carry_spec(b\, cons(zh, zt)), c2), Eq/trans(add_raw_succ_out_r(b\, add_raw(b\, cons(zh, zt), false), c2), cong_succ_raw(cong_add_raw_r(b\, add_raw_zero_l(cons(zh, zt)), c2))))))
                | false => Eq/sym(cong_add_raw_r(b\, add_raw_zero_l(cons(zh, zt)), c2))
                end
            end
        | b\yh\..yt =>
            match z : (zv) => Eq(add_raw(add_raw(b\, cons(yh, yt), c1), zv, c2), add_raw(b\, add_raw(cons(yh, yt), zv, c1), c2))
            | b\ =>
                match yh
                | true =>
                    match c1
                    | true =>
                        match c2
                        | true =>
                            cong_cons2(refl_at(true), add_assoc_raw(b\, yt, b\, true, false))
                        | false =>
                            cong_cons2(refl_at(false), add_assoc_raw(b\, yt, b\, true, false))
                        end
                    | false =>
                        match c2
                        | true =>
                            cong_cons2(refl_at(false), add_assoc_raw(b\, yt, b\, false, true))
                        | false =>
                            cong_cons2(refl_at(true), add_assoc_raw(b\, yt, b\, false, false))
                        end
                    end
                | false =>
                    match c1
                    | true =>
                        match c2
                        | true =>
                            cong_cons2(refl_at(false), add_assoc_raw(b\, yt, b\, false, true))
                        | false =>
                            cong_cons2(refl_at(true), add_assoc_raw(b\, yt, b\, false, false))
                        end
                    | false =>
                        match c2
                        | true =>
                            cong_cons2(refl_at(true), add_assoc_raw(b\, yt, b\, false, false))
                        | false =>
                            cong_cons2(refl_at(false), add_assoc_raw(b\, yt, b\, false, false))
                        end
                    end
                end
            | b\zh\..zt =>
                match yh
                | true =>
                    match zh
                    | true =>
                        match c1
                        | true =>
                            match c2
                            | true =>
                                cong_cons2(refl_at(false), add_assoc_raw(b\, yt, zt, true, true))
                            | false =>
                                cong_cons2(refl_at(true), add_assoc_raw(b\, yt, zt, true, false))
                            end
                        | false =>
                            match c2
                            | true =>
                                cong_cons2(refl_at(true), Eq/trans(add_assoc_raw(b\, yt, zt, false, true), Eq/trans(add_raw_carry_spec(b\, add_raw(yt, zt, false)), Eq/trans(Eq/sym(add_raw_succ_out_r(b\, add_raw(yt, zt, false), false)), cong_add_raw_r(b\, Eq/sym(add_raw_carry_spec(yt, zt)), false)))))
                            | false =>
                                cong_cons2(refl_at(false), Eq/trans(add_assoc_raw(b\, yt, zt, false, true), Eq/trans(add_raw_carry_spec(b\, add_raw(yt, zt, false)), Eq/trans(Eq/sym(add_raw_succ_out_r(b\, add_raw(yt, zt, false), false)), cong_add_raw_r(b\, Eq/sym(add_raw_carry_spec(yt, zt)), false)))))
                            end
                        end
                    | false =>
                        match c1
                        | true =>
                            match c2
                            | true =>
                                cong_cons2(refl_at(true), add_assoc_raw(b\, yt, zt, true, false))
                            | false =>
                                cong_cons2(refl_at(false), add_assoc_raw(b\, yt, zt, true, false))
                            end
                        | false =>
                            match c2
                            | true =>
                                cong_cons2(refl_at(false), add_assoc_raw(b\, yt, zt, false, true))
                            | false =>
                                cong_cons2(refl_at(true), add_assoc_raw(b\, yt, zt, false, false))
                            end
                        end
                    end
                | false =>
                    match zh
                    | true =>
                        match c1
                        | true =>
                            match c2
                            | true =>
                                cong_cons2(refl_at(true), Eq/trans(add_assoc_raw(b\, yt, zt, false, true), Eq/trans(add_raw_carry_spec(b\, add_raw(yt, zt, false)), Eq/trans(Eq/sym(add_raw_succ_out_r(b\, add_raw(yt, zt, false), false)), cong_add_raw_r(b\, Eq/sym(add_raw_carry_spec(yt, zt)), false)))))
                            | false =>
                                cong_cons2(refl_at(false), Eq/trans(add_assoc_raw(b\, yt, zt, false, true), Eq/trans(add_raw_carry_spec(b\, add_raw(yt, zt, false)), Eq/trans(Eq/sym(add_raw_succ_out_r(b\, add_raw(yt, zt, false), false)), cong_add_raw_r(b\, Eq/sym(add_raw_carry_spec(yt, zt)), false)))))
                            end
                        | false =>
                            match c2
                            | true =>
                                cong_cons2(refl_at(false), add_assoc_raw(b\, yt, zt, false, true))
                            | false =>
                                cong_cons2(refl_at(true), add_assoc_raw(b\, yt, zt, false, false))
                            end
                        end
                    | false =>
                        match c1
                        | true =>
                            match c2
                            | true =>
                                cong_cons2(refl_at(false), add_assoc_raw(b\, yt, zt, false, true))
                            | false =>
                                cong_cons2(refl_at(true), add_assoc_raw(b\, yt, zt, false, false))
                            end
                        | false =>
                            match c2
                            | true =>
                                cong_cons2(refl_at(true), add_assoc_raw(b\, yt, zt, false, false))
                            | false =>
                                cong_cons2(refl_at(false), add_assoc_raw(b\, yt, zt, false, false))
                            end
                        end
                    end
                end
            end
        end
    | b\xh\..xt =>
        match y : (yv) => Eq(add_raw(add_raw(cons(xh, xt), yv, c1), z, c2), add_raw(cons(xh, xt), add_raw(yv, z, c1), c2))
        | b\ =>
            match z : (zv) => Eq(add_raw(add_raw(cons(xh, xt), b\, c1), zv, c2), add_raw(cons(xh, xt), add_raw(b\, zv, c1), c2))
            | b\ =>
                match c1
                | true => Eq/trans(cong_add_raw_l(add_raw_succ_r(cons(xh, xt)), b\, c2), Eq/trans(add_raw_succ_out_l(cons(xh, xt), b\, c2), Eq/sym(add_raw_succ_out_r(cons(xh, xt), b\, c2))))
                | false => cong_add_raw_l(add_raw_zero_r(cons(xh, xt)), b\, c2)
                end
            | b\zh\..zt =>
                match xh
                | true =>
                    match zh
                    | true =>
                        match c1
                        | true =>
                            match c2
                            | true =>
                                cong_cons2(refl_at(false), add_assoc_raw(xt, b\, zt, true, true))
                            | false =>
                                cong_cons2(refl_at(true), add_assoc_raw(xt, b\, zt, true, false))
                            end
                        | false =>
                            match c2
                            | true =>
                                cong_cons2(refl_at(true), add_assoc_raw(xt, b\, zt, false, true))
                            | false =>
                                cong_cons2(refl_at(false), add_assoc_raw(xt, b\, zt, false, true))
                            end
                        end
                    | false =>
                        match c1
                        | true =>
                            match c2
                            | true =>
