                                            raw_assoc(xt, yt, zt, false, true),
                                            Eq/trans(
                                                raw_carry_spec(xt, raw(yt, zt, false)),
                                                Eq/trans(
                                                    Eq/sym(
                                                        raw_succ_out_r(
                                                            xt,
                                                            raw(yt, zt, false),
                                                            false)),
                                                    cong_raw_r(
                                                        xt,
                                                        Eq/sym(raw_carry_spec(yt, zt)),
                                                        false)))))
                                | false =>
                                    cong_cons2(
                                        refl_at(false),
                                        Eq/trans(
                                            raw_assoc(xt, yt, zt, false, true),
                                            Eq/trans(
                                                raw_carry_spec(xt, raw(yt, zt, false)),
                                                Eq/trans(
                                                    Eq/sym(
                                                        raw_succ_out_r(
                                                            xt,
                                                            raw(yt, zt, false),
                                                            false)),
                                                    cong_raw_r(
                                                        xt,
                                                        Eq/sym(raw_carry_spec(yt, zt)),
                                                        false)))))
                                end
                            | false =>
                                match c2
                                | true =>
                                    cong_cons2(refl_at(false), raw_assoc(xt, yt, zt, false, true))
                                | false =>
                                    cong_cons2(refl_at(true), raw_assoc(xt, yt, zt, false, false))
                                end
                            end
                        | false =>
                            match c1
                            | true =>
                                match c2
                                | true =>
