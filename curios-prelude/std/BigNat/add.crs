                                        refl_at(true),
                                        Eq/trans(
                                            Eq/trans(
                                                cong_raw_l(raw_carry_spec(xt, yt), zt, false),
                                                Eq/trans(
                                                    raw_succ_out_l(raw(xt, yt, false), zt, false),
                                                    Eq/sym(
                                                        raw_carry_spec(raw(xt, yt, false), zt)))),
                                            raw_assoc(xt, yt, zt, false, true)))
                                | false =>
                                    cong_cons2(
                                        refl_at(false),
                                        Eq/trans(
                                            Eq/trans(
                                                cong_raw_l(raw_carry_spec(xt, yt), zt, false),
                                                Eq/trans(
                                                    raw_succ_out_l(raw(xt, yt, false), zt, false),
                                                    Eq/sym(
                                                        raw_carry_spec(raw(xt, yt, false), zt)))),
                                            raw_assoc(xt, yt, zt, false, true)))
                                end
                            end
                        end
                    | false =>
                        match zh
                        | true =>
                            match c1
                            | true =>
                                match c2
                                | true =>
                                    cong_cons2(refl_at(false), raw_assoc(xt, yt, zt, true, true))
                                | false =>
                                    cong_cons2(refl_at(true), raw_assoc(xt, yt, zt, true, false))
                                end
                            | false =>
                                match c2
                                | true =>
                                    cong_cons2(refl_at(true), raw_assoc(xt, yt, zt, false, true))
                                | false =>
                                    cong_cons2(refl_at(false), raw_assoc(xt, yt, zt, false, true))
                                end
                            end
                        | false =>
                            match c1
                            | true =>
                                match c2
                                | true =>
                                    cong_cons2(
                                        refl_at(true),
                                        Eq/trans(
                                            Eq/trans(
                                                cong_raw_l(raw_carry_spec(xt, yt), zt, false),
                                                Eq/trans(
                                                    raw_succ_out_l(raw(xt, yt, false), zt, false),
                                                    Eq/sym(
                                                        raw_carry_spec(raw(xt, yt, false), zt)))),
                                            raw_assoc(xt, yt, zt, false, true)))
                                | false =>
                                    cong_cons2(
                                        refl_at(false),
                                        Eq/trans(
                                            Eq/trans(
                                                cong_raw_l(raw_carry_spec(xt, yt), zt, false),
                                                Eq/trans(
                                                    raw_succ_out_l(raw(xt, yt, false), zt, false),
                                                    Eq/sym(
                                                        raw_carry_spec(raw(xt, yt, false), zt)))),
                                            raw_assoc(xt, yt, zt, false, true)))
                                end
                            | false =>
                                match c2
                                | true =>
                                    cong_cons2(refl_at(false), raw_assoc(xt, yt, zt, false, true))
                                | false =>
                                    cong_cons2(refl_at(true), raw_assoc(xt, yt, zt, false, false))
                                end
                            end
                        end
                    end
                | false =>
                    match yh
                    | true =>
                        match zh
                        | true =>
                            match c1
                            | true =>
                                match c2
                                | true =>
                                    cong_cons2(refl_at(false), raw_assoc(xt, yt, zt, true, true))
                                | false =>
                                    cong_cons2(refl_at(true), raw_assoc(xt, yt, zt, true, false))
                                end
                            | false =>
                                match c2
                                | true =>
                                    cong_cons2(
                                        refl_at(true),
                                        Eq/trans(
                                            raw_assoc(xt, yt, zt, false, true),
                                            Eq/trans(
                                                raw_carry_spec(xt, raw(yt, zt, false)),
                                                Eq/trans(
                                                    Eq/sym(
                                                        raw_succ_out_r(
                                                            xt,
                                                            raw(yt, zt, false),
                                                            false)),
                                                    cong_raw_r(
                                                        xt,
                                                        Eq/sym(raw_carry_spec(yt, zt)),
                                                        false)))))
                                | false =>
                                    cong_cons2(
                                        refl_at(false),
                                        Eq/trans(
                                            raw_assoc(xt, yt, zt, false, true),
                                            Eq/trans(
                                                raw_carry_spec(xt, raw(yt, zt, false)),
                                                Eq/trans(
                                                    Eq/sym(
                                                        raw_succ_out_r(
                                                            xt,
                                                            raw(yt, zt, false),
                                                            false)),
                                                    cong_raw_r(
                                                        xt,
                                                        Eq/sym(raw_carry_spec(yt, zt)),
                                                        false)))))
                                end
                            end
                        | false =>
                            match c1
                            | true =>
                                match c2
                                | true =>
                                    cong_cons2(refl_at(true), raw_assoc(xt, yt, zt, true, false))
                                | false =>
                                    cong_cons2(refl_at(false), raw_assoc(xt, yt, zt, true, false))
                                end
                            | false =>
                                match c2
                                | true =>
                                    cong_cons2(refl_at(false), raw_assoc(xt, yt, zt, false, true))
                                | false =>
                                    cong_cons2(refl_at(true), raw_assoc(xt, yt, zt, false, false))
                                end
