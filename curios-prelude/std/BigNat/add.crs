use /std/{Nat, Bool, Bits, Str, Order, Eq, False, True, Eql, Cmp, Add, Sub, Mul, Show, Ord};
use /std/Bool/{false_neq_true};
use /std/Order/{lt_neq_eq, gt_neq_eq, eq_neq_lt, gt_neq_lt};
use /std/BigNat/{
    BigNat, cong_cons2, cong_is_trimmed, cong_of_bits, cong_rep, cons_inj_head, cons_inj_tail, eq,
    is_trimmed, is_trimmed_cons, is_trimmed_of_canonical, maj3, nonempty, of_bits, refl_at,
    tail_is_trimmed, trim_of_trimmed, xor3, mod succ};

pub rec raw(x: Bits, y: Bits, carry: Bool) -> Bits =
    match x
    | b[] =>
        match y
        | b[] => match carry | true => b[\1] | false => b[] end
        | b[yh, ..yt] => b[xor3(false, yh, carry), ..raw(b[], yt, maj3(false, yh, carry))]
        end
    | b[xh, ..xt] =>
        match y
        | b[] => b[xor3(xh, false, carry), ..raw(xt, b[], maj3(xh, false, carry))]
        | b[yh, ..yt] => b[xor3(xh, yh, carry), ..raw(xt, yt, maj3(xh, yh, carry))]
        end
    end;

pub let add(a: BigNat, b: BigNat) -> BigNat =
    of_bits(raw(a.rep, b.rep, false));

-- Facts about the full-adder bit functions above. They exist only to justify this ladder's commutativity and cancellation, so they live with the adder rather than with `xor3`/`maj3` themselves, which `sub` and `mul` share.
let xor3_comm(a: Bool, b: Bool, c: Bool) -> Eq(xor3(a, b, c), xor3(b, a, c)) =
    match a
    | true =>
        match b | true => refl_at(xor3(true, true, c)) | false => refl_at(xor3(true, false, c)) end
    | false =>
        match b
        | true => refl_at(xor3(false, true, c))
        | false => refl_at(xor3(false, false, c))
        end
    end;

let maj3_comm(a: Bool, b: Bool, c: Bool) -> Eq(maj3(a, b, c), maj3(b, a, c)) =
    match a
    | true =>
        match b | true => refl_at(maj3(true, true, c)) | false => refl_at(maj3(true, false, c)) end
    | false =>
        match b
        | true => refl_at(maj3(false, true, c))
        | false => refl_at(maj3(false, false, c))
        end
    end;

let xor3_inj_mid(
    a: Bool,
    @b1: Bool,
    @b2: Bool,
    c: Bool,
    p: Eq(xor3(a, b1, c), xor3(a, b2, c)),
) -> Eq(b1, b2) =
    match a
    | true =>
        match c
        | true =>
            match b1
            | true =>
                match b2
                | true => refl_at(true)
                | false => match false_neq_true(Eq/sym(p)) end
                end
            | false =>
                match b2 | true => match false_neq_true(p) end | false => refl_at(false) end
            end
        | false =>
            match b1
            | true =>
                match b2 | true => refl_at(true) | false => match false_neq_true(p) end end
            | false =>
                match b2
                | true => match false_neq_true(Eq/sym(p)) end
                | false => refl_at(false)
                end
            end
        end
    | false =>
        match c
        | true =>
            match b1
            | true =>
                match b2 | true => refl_at(true) | false => match false_neq_true(p) end end
            | false =>
                match b2
                | true => match false_neq_true(Eq/sym(p)) end
                | false => refl_at(false)
                end
            end
        | false =>
            match b1
            | true =>
                match b2
                | true => refl_at(true)
                | false => match false_neq_true(Eq/sym(p)) end
                end
            | false =>
                match b2 | true => match false_neq_true(p) end | false => refl_at(false) end
            end
        end
    end;

let cong_maj3_mid(
    a: Bool,
    @b1: Bool,
    @b2: Bool,
    p: Eq(b1, b2),
    c: Bool,
) -> Eq(maj3(a, b1, c), maj3(a, b2, c)) =
    Eq/cong((w) => maj3(a, w, c), p);

let cong_raw_c(
    x: Bits,
    y: Bits,
    @c1: Bool,
    @c2: Bool,
    p: Eq(c1, c2),
) -> Eq(raw(x, y, c1), raw(x, y, c2)) =
    Eq/cong((c) => raw(x, y, c), p);

pub rec raw_comm(x: Bits, y: Bits, c: Bool) -> Eq(raw(x, y, c), raw(y, x, c)) =
    match x: (a) => Eq(raw(a, y, c), raw(y, a, c))
    | b[] =>
        match y: (b) => Eq(raw(b[], b, c), raw(b, b[], c))
        | b[] => refl_at(raw(b[], b[], c))
        | b[yh, ..yt] => raw_swap_step(b[], yt, false, yh, c)
        end
    | b[xh, ..xt] =>
        match y: (b) => Eq(raw(b[xh, ..xt], b, c), raw(b, b[xh, ..xt], c))
        | b[] => raw_swap_step(xt, b[], xh, false, c)
        | b[yh, ..yt] => raw_swap_step(xt, yt, xh, yh, c)
        end
    end
and raw_swap_step(
    x: Bits,
    y: Bits,
    h1: Bool,
    h2: Bool,
    c: Bool,
) -> Eq(
    b[xor3(h1, h2, c), ..raw(x, y, maj3(h1, h2, c))],
    b[xor3(h2, h1, c), ..raw(y, x, maj3(h2, h1, c))]) =
    cong_cons2(
        xor3_comm(h1, h2, c),
        Eq/trans(raw_comm(x, y, maj3(h1, h2, c)), cong_raw_c(y, x, maj3_comm(h1, h2, c))));

pub let cong_raw_l(
    @s: Bits,
    @t: Bits,
    p: Eq(s, t),
    y: Bits,
    c: Bool,
) -> Eq(raw(s, y, c), raw(t, y, c)) =
    Eq/cong((w) => raw(w, y, c), p);

pub let cong_raw_r(
    x: Bits,
    @s: Bits,
    @t: Bits,
    p: Eq(s, t),
    c: Bool,
) -> Eq(raw(x, s, c), raw(x, t, c)) =
    Eq/cong((w) => raw(x, w, c), p);

rec raw_zero_r(x: Bits) -> Eq(raw(x, b[], false), x) =
    match x: (a) => Eq(raw(a, b[], false), a)
    | b[] => Eq/refl()
    | b[h, ..t] =>
        match h
        | true => cong_cons2(refl_at(true), raw_zero_r(t))
        | false => cong_cons2(refl_at(false), raw_zero_r(t))
        end
    end;

pub rec raw_zero_l(y: Bits) -> Eq(raw(b[], y, false), y) =
    match y: (b) => Eq(raw(b[], b, false), b)
    | b[] => Eq/refl()
    | b[h, ..t] =>
        match h
        | true => cong_cons2(refl_at(true), raw_zero_l(t))
        | false => cong_cons2(refl_at(false), raw_zero_l(t))
        end
    end;

rec raw_succ_r(x: Bits) -> Eq(raw(x, b[], true), succ/raw(x)) =
    match x: (a) => Eq(raw(a, b[], true), succ/raw(a))
    | b[] => Eq/refl()
    | b[h, ..t] =>
        match h
        | true => cong_cons2(refl_at(false), raw_succ_r(t))
        | false => cong_cons2(refl_at(true), raw_zero_r(t))
        end
    end;

rec raw_succ_l(y: Bits) -> Eq(raw(b[], y, true), succ/raw(y)) =
    match y: (b) => Eq(raw(b[], b, true), succ/raw(b))
    | b[] => Eq/refl()
    | b[h, ..t] =>
        match h
        | true => cong_cons2(refl_at(false), raw_succ_l(t))
        | false => cong_cons2(refl_at(true), raw_zero_l(t))
        end
    end;

pub rec raw_carry_spec(x: Bits, y: Bits) -> Eq(raw(x, y, true), succ/raw(raw(x, y, false))) =
    match x: (a) => Eq(raw(a, y, true), succ/raw(raw(a, y, false)))
    | b[] =>
        match y: (b) => Eq(raw(b[], b, true), succ/raw(raw(b[], b, false)))
        | b[] => Eq/refl()
        | b[yh, ..yt] =>
            match yh
            | true => cong_cons2(refl_at(false), raw_carry_spec(b[], yt))
            | false => Eq/refl()
            end
        end
    | b[xh, ..xt] =>
        match y: (b) => Eq(raw(b[xh, ..xt], b, true), succ/raw(raw(b[xh, ..xt], b, false)))
        | b[] =>
            match xh
            | true => cong_cons2(refl_at(false), raw_carry_spec(xt, b[]))
            | false => Eq/refl()
            end
        | b[yh, ..yt] =>
            match xh
            | true =>
                match yh
                | true => Eq/refl()
                | false => cong_cons2(refl_at(false), raw_carry_spec(xt, yt))
                end
            | false =>
                match yh
                | true => cong_cons2(refl_at(false), raw_carry_spec(xt, yt))
                | false => Eq/refl()
                end
            end
        end
    end;

pub rec raw_succ_out_l(
    u: Bits,
    v: Bits,
    c: Bool,
) -> Eq(raw(succ/raw(u), v, c), succ/raw(raw(u, v, c))) =
    match u: (a) => Eq(raw(succ/raw(a), v, c), succ/raw(raw(a, v, c)))
    | b[] =>
        match v: (b) => Eq(raw(succ/raw(b[]), b, c), succ/raw(raw(b[], b, c)))
        | b[] => match c | true => Eq/refl() | false => Eq/refl() end
        | b[vh, ..vt] =>
            match vh
            | true =>
                match c
                | true => Eq/refl()
                | false => cong_cons2(refl_at(false), raw_carry_spec(b[], vt))
                end
            | false =>
                match c
                | true => cong_cons2(refl_at(false), raw_carry_spec(b[], vt))
                | false => Eq/refl()
                end
            end
        end
    | b[uh, ..ut] =>
        match uh
        | true =>
            match v: (b) => Eq(raw(succ/raw(b[\1, ..ut]), b, c), succ/raw(raw(b[\1, ..ut], b, c)))
            | b[] =>
                match c
                | true =>
                    cong_cons2(
                        refl_at(true),
                        Eq/trans(raw_succ_out_l(ut, b[], false), Eq/sym(raw_carry_spec(ut, b[]))))
                | false => cong_cons2(refl_at(false), raw_succ_out_l(ut, b[], false))
                end
            | b[vh, ..vt] =>
                match vh
                | true =>
                    match c
                    | true => cong_cons2(refl_at(false), raw_succ_out_l(ut, vt, true))
                    | false =>
                        cong_cons2(
                            refl_at(true),
                            Eq/trans(raw_succ_out_l(ut, vt, false), Eq/sym(raw_carry_spec(ut, vt))))
                    end
                | false =>
                    match c
                    | true =>
                        cong_cons2(
                            refl_at(true),
                            Eq/trans(raw_succ_out_l(ut, vt, false), Eq/sym(raw_carry_spec(ut, vt))))
                    | false => cong_cons2(refl_at(false), raw_succ_out_l(ut, vt, false))
                    end
                end
            end
        | false =>
            match v: (b) => Eq(raw(succ/raw(b[\0, ..ut]), b, c), succ/raw(raw(b[\0, ..ut], b, c)))
            | b[] =>
                match c
                | true => cong_cons2(refl_at(false), raw_carry_spec(ut, b[]))
                | false => Eq/refl()
                end
            | b[vh, ..vt] =>
                match vh
                | true =>
                    match c
                    | true => Eq/refl()
                    | false => cong_cons2(refl_at(false), raw_carry_spec(ut, vt))
                    end
                | false =>
                    match c
                    | true => cong_cons2(refl_at(false), raw_carry_spec(ut, vt))
                    | false => Eq/refl()
                    end
                end
            end
        end
    end;

pub rec raw_succ_out_r(
    u: Bits,
    v: Bits,
    c: Bool,
) -> Eq(raw(u, succ/raw(v), c), succ/raw(raw(u, v, c))) =
    match v: (b) => Eq(raw(u, succ/raw(b), c), succ/raw(raw(u, b, c)))
    | b[] =>
        match u: (a) => Eq(raw(a, succ/raw(b[]), c), succ/raw(raw(a, b[], c)))
        | b[] => match c | true => Eq/refl() | false => Eq/refl() end
        | b[uh, ..ut] =>
            match uh
            | true =>
                match c
                | true => Eq/refl()
                | false => cong_cons2(refl_at(false), raw_carry_spec(ut, b[]))
                end
            | false =>
                match c
                | true => cong_cons2(refl_at(false), raw_carry_spec(ut, b[]))
                | false => Eq/refl()
                end
            end
        end
    | b[vh, ..vt] =>
        match vh
        | true =>
            match u: (a) => Eq(raw(a, succ/raw(b[\1, ..vt]), c), succ/raw(raw(a, b[\1, ..vt], c)))
            | b[] =>
                match c
                | true =>
                    cong_cons2(
                        refl_at(true),
                        Eq/trans(raw_succ_out_r(b[], vt, false), Eq/sym(raw_carry_spec(b[], vt))))
                | false => cong_cons2(refl_at(false), raw_succ_out_r(b[], vt, false))
                end
            | b[uh, ..ut] =>
                match uh
                | true =>
                    match c
                    | true => cong_cons2(refl_at(false), raw_succ_out_r(ut, vt, true))
                    | false =>
                        cong_cons2(
                            refl_at(true),
                            Eq/trans(raw_succ_out_r(ut, vt, false), Eq/sym(raw_carry_spec(ut, vt))))
                    end
                | false =>
                    match c
                    | true =>
                        cong_cons2(
                            refl_at(true),
                            Eq/trans(raw_succ_out_r(ut, vt, false), Eq/sym(raw_carry_spec(ut, vt))))
                    | false => cong_cons2(refl_at(false), raw_succ_out_r(ut, vt, false))
                    end
                end
            end
        | false =>
            match u: (a) => Eq(raw(a, succ/raw(b[\0, ..vt]), c), succ/raw(raw(a, b[\0, ..vt], c)))
            | b[] =>
                match c
                | true => cong_cons2(refl_at(false), raw_carry_spec(b[], vt))
                | false => Eq/refl()
                end
            | b[uh, ..ut] =>
                match uh
                | true =>
                    match c
                    | true => Eq/refl()
                    | false => cong_cons2(refl_at(false), raw_carry_spec(ut, vt))
                    end
                | false =>
                    match c
                    | true => cong_cons2(refl_at(false), raw_carry_spec(ut, vt))
                    | false => Eq/refl()
                    end
                end
            end
        end
    end;

pub rec raw_assoc(
    x: Bits,
    y: Bits,
    z: Bits,
    c1: Bool,
    c2: Bool,
) -> Eq(raw(raw(x, y, c1), z, c2), raw(x, raw(y, z, c1), c2)) =
    match x: (xv) => Eq(raw(raw(xv, y, c1), z, c2), raw(xv, raw(y, z, c1), c2))
    | b[] =>
        match y: (yv) => Eq(raw(raw(b[], yv, c1), z, c2), raw(b[], raw(yv, z, c1), c2))
        | b[] =>
            match z: (zv) => Eq(raw(raw(b[], b[], c1), zv, c2), raw(b[], raw(b[], zv, c1), c2))
            | b[] =>
                match c1
                | true => match c2 | true => Eq/refl() | false => Eq/refl() end
                | false => match c2 | true => Eq/refl() | false => Eq/refl() end
                end
            | b[zh, ..zt] =>
                match c1
                | true =>
                    Eq/trans(
                        raw_succ_out_l(b[], b[zh, ..zt], c2),
                        Eq/sym(
                            Eq/trans(
                                cong_raw_r(b[], raw_carry_spec(b[], b[zh, ..zt]), c2),
                                Eq/trans(
                                    raw_succ_out_r(b[], raw(b[], b[zh, ..zt], false), c2),
                                    succ/cong_raw(cong_raw_r(b[], raw_zero_l(b[zh, ..zt]), c2))))))
                | false => Eq/sym(cong_raw_r(b[], raw_zero_l(b[zh, ..zt]), c2))
                end
            end
        | b[yh, ..yt] =>
            match z: (zv) =>
                Eq(raw(raw(b[], b[yh, ..yt], c1), zv, c2), raw(b[], raw(b[yh, ..yt], zv, c1), c2))
            | b[] =>
                match yh
                | true =>
                    match c1
                    | true =>
                        match c2
                        | true => cong_cons2(refl_at(true), raw_assoc(b[], yt, b[], true, false))
                        | false => cong_cons2(refl_at(false), raw_assoc(b[], yt, b[], true, false))
                        end
                    | false =>
                        match c2
                        | true => cong_cons2(refl_at(false), raw_assoc(b[], yt, b[], false, true))
                        | false => cong_cons2(refl_at(true), raw_assoc(b[], yt, b[], false, false))
                        end
                    end
                | false =>
                    match c1
                    | true =>
                        match c2
                        | true => cong_cons2(refl_at(false), raw_assoc(b[], yt, b[], false, true))
                        | false => cong_cons2(refl_at(true), raw_assoc(b[], yt, b[], false, false))
                        end
                    | false =>
                        match c2
                        | true => cong_cons2(refl_at(true), raw_assoc(b[], yt, b[], false, false))
                        | false => cong_cons2(refl_at(false), raw_assoc(b[], yt, b[], false, false))
                        end
                    end
                end
            | b[zh, ..zt] =>
                match yh
                | true =>
                    match zh
                    | true =>
                        match c1
                        | true =>
                            match c2
                            | true => cong_cons2(refl_at(false), raw_assoc(b[], yt, zt, true, true))
                            | false =>
                                cong_cons2(refl_at(true), raw_assoc(b[], yt, zt, true, false))
                            end
                        | false =>
                            match c2
                            | true =>
                                cong_cons2(
                                    refl_at(true),
                                    Eq/trans(
                                        raw_assoc(b[], yt, zt, false, true),
                                        Eq/trans(
                                            raw_carry_spec(b[], raw(yt, zt, false)),
                                            Eq/trans(
                                                Eq/sym(
                                                    raw_succ_out_r(b[], raw(yt, zt, false), false)),
                                                cong_raw_r(
                                                    b[],
                                                    Eq/sym(raw_carry_spec(yt, zt)),
                                                    false)))))
                            | false =>
                                cong_cons2(
                                    refl_at(false),
                                    Eq/trans(
                                        raw_assoc(b[], yt, zt, false, true),
                                        Eq/trans(
                                            raw_carry_spec(b[], raw(yt, zt, false)),
                                            Eq/trans(
                                                Eq/sym(
                                                    raw_succ_out_r(b[], raw(yt, zt, false), false)),
                                                cong_raw_r(
                                                    b[],
                                                    Eq/sym(raw_carry_spec(yt, zt)),
                                                    false)))))
                            end
                        end
                    | false =>
                        match c1
                        | true =>
                            match c2
                            | true => cong_cons2(refl_at(true), raw_assoc(b[], yt, zt, true, false))
                            | false =>
                                cong_cons2(refl_at(false), raw_assoc(b[], yt, zt, true, false))
                            end
                        | false =>
                            match c2
                            | true =>
                                cong_cons2(refl_at(false), raw_assoc(b[], yt, zt, false, true))
                            | false =>
                                cong_cons2(refl_at(true), raw_assoc(b[], yt, zt, false, false))
                            end
                        end
                    end
                | false =>
                    match zh
                    | true =>
                        match c1
                        | true =>
                            match c2
                            | true =>
                                cong_cons2(
                                    refl_at(true),
                                    Eq/trans(
                                        raw_assoc(b[], yt, zt, false, true),
                                        Eq/trans(
                                            raw_carry_spec(b[], raw(yt, zt, false)),
                                            Eq/trans(
                                                Eq/sym(
                                                    raw_succ_out_r(b[], raw(yt, zt, false), false)),
                                                cong_raw_r(
                                                    b[],
                                                    Eq/sym(raw_carry_spec(yt, zt)),
                                                    false)))))
                            | false =>
                                cong_cons2(
                                    refl_at(false),
                                    Eq/trans(
                                        raw_assoc(b[], yt, zt, false, true),
                                        Eq/trans(
                                            raw_carry_spec(b[], raw(yt, zt, false)),
                                            Eq/trans(
                                                Eq/sym(
                                                    raw_succ_out_r(b[], raw(yt, zt, false), false)),
                                                cong_raw_r(
                                                    b[],
                                                    Eq/sym(raw_carry_spec(yt, zt)),
                                                    false)))))
                            end
                        | false =>
                            match c2
                            | true =>
                                cong_cons2(refl_at(false), raw_assoc(b[], yt, zt, false, true))
                            | false =>
                                cong_cons2(refl_at(true), raw_assoc(b[], yt, zt, false, false))
                            end
                        end
                    | false =>
                        match c1
                        | true =>
                            match c2
                            | true =>
                                cong_cons2(refl_at(false), raw_assoc(b[], yt, zt, false, true))
                            | false =>
                                cong_cons2(refl_at(true), raw_assoc(b[], yt, zt, false, false))
                            end
                        | false =>
                            match c2
                            | true =>
                                cong_cons2(refl_at(true), raw_assoc(b[], yt, zt, false, false))
                            | false =>
                                cong_cons2(refl_at(false), raw_assoc(b[], yt, zt, false, false))
                            end
                        end
                    end
                end
            end
        end
    | b[xh, ..xt] =>
        match y: (yv) =>
            Eq(raw(raw(b[xh, ..xt], yv, c1), z, c2), raw(b[xh, ..xt], raw(yv, z, c1), c2))
        | b[] =>
            match z: (zv) =>
                Eq(raw(raw(b[xh, ..xt], b[], c1), zv, c2), raw(b[xh, ..xt], raw(b[], zv, c1), c2))
            | b[] =>
                match c1
                | true =>
                    Eq/trans(
                        cong_raw_l(raw_succ_r(b[xh, ..xt]), b[], c2),
                        Eq/trans(
                            raw_succ_out_l(b[xh, ..xt], b[], c2),
                            Eq/sym(raw_succ_out_r(b[xh, ..xt], b[], c2))))
                | false => cong_raw_l(raw_zero_r(b[xh, ..xt]), b[], c2)
                end
            | b[zh, ..zt] =>
                match xh
                | true =>
                    match zh
                    | true =>
                        match c1
                        | true =>
                            match c2
                            | true => cong_cons2(refl_at(false), raw_assoc(xt, b[], zt, true, true))
                            | false =>
                                cong_cons2(refl_at(true), raw_assoc(xt, b[], zt, true, false))
                            end
                        | false =>
                            match c2
                            | true => cong_cons2(refl_at(true), raw_assoc(xt, b[], zt, false, true))
                            | false =>
                                cong_cons2(refl_at(false), raw_assoc(xt, b[], zt, false, true))
                            end
                        end
                    | false =>
                        match c1
                        | true =>
                            match c2
                            | true =>
                                cong_cons2(
                                    refl_at(true),
                                    Eq/trans(
                                        Eq/trans(
                                            cong_raw_l(raw_carry_spec(xt, b[]), zt, false),
                                            Eq/trans(
                                                raw_succ_out_l(raw(xt, b[], false), zt, false),
                                                Eq/sym(raw_carry_spec(raw(xt, b[], false), zt)))),
                                        raw_assoc(xt, b[], zt, false, true)))
                            | false =>
                                cong_cons2(
                                    refl_at(false),
                                    Eq/trans(
                                        Eq/trans(
                                            cong_raw_l(raw_carry_spec(xt, b[]), zt, false),
                                            Eq/trans(
                                                raw_succ_out_l(raw(xt, b[], false), zt, false),
                                                Eq/sym(raw_carry_spec(raw(xt, b[], false), zt)))),
                                        raw_assoc(xt, b[], zt, false, true)))
                            end
                        | false =>
                            match c2
                            | true =>
                                cong_cons2(refl_at(false), raw_assoc(xt, b[], zt, false, true))
                            | false =>
                                cong_cons2(refl_at(true), raw_assoc(xt, b[], zt, false, false))
                            end
                        end
                    end
                | false =>
                    match zh
                    | true =>
                        match c1
                        | true =>
                            match c2
                            | true =>
                                cong_cons2(
                                    refl_at(true),
                                    Eq/trans(
                                        raw_assoc(xt, b[], zt, false, true),
                                        Eq/trans(
                                            raw_carry_spec(xt, raw(b[], zt, false)),
                                            Eq/trans(
                                                Eq/sym(
                                                    raw_succ_out_r(xt, raw(b[], zt, false), false)),
                                                cong_raw_r(
                                                    xt,
                                                    Eq/sym(raw_carry_spec(b[], zt)),
                                                    false)))))
                            | false =>
