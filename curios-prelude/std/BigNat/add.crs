                                | false =>
                                    cong_cons2(refl_at(true), raw_assoc(xt, yt, zt, false, false))
                                end
                            | false =>
                                match c2
                                | true =>
                                    cong_cons2(refl_at(true), raw_assoc(xt, yt, zt, false, false))
                                | false =>
                                    cong_cons2(refl_at(false), raw_assoc(xt, yt, zt, false, false))
                                end
                            end
                        end
                    end
                end
            end
        end
    end;

pub rec raw_one_r(x: Bits) -> Eq(raw(x, b[\1], false), succ/raw(x)) =
    match x: (a) => Eq(raw(a, b[\1], false), succ/raw(a))
    | b[] => Eq/refl()
    | b[h, ..t] =>
        match h
        | true => cong_cons2(refl_at(false), raw_succ_r(t))
        | false => cong_cons2(refl_at(true), raw_zero_r(t))
        end
    end;

let raw_nonempty_l(
    xh: Bool,
    xt: Bits,
    y: Bits,
    c: Bool,
) -> Eq(nonempty(raw(b[xh, ..xt], y, c)), true) =
    match y: (b) => Eq(nonempty(raw(b[xh, ..xt], b, c)), true)
    | b[] => Eq/refl()
    | b[_, .._] => Eq/refl()
    end;

let raw_nonempty_r(
    x: Bits,
    yh: Bool,
    yt: Bits,
    c: Bool,
) -> Eq(nonempty(raw(x, b[yh, ..yt], c)), true) =
    match x: (a) => Eq(nonempty(raw(a, b[yh, ..yt], c)), true)
    | b[] => Eq/refl()
    | b[_, .._] => Eq/refl()
    end;

pub rec raw_trimmed(
    x: Bits,
    y: Bits,
    c: Bool,
    px: Eq(is_trimmed(x), true),
    py: Eq(is_trimmed(y), true),
) -> Eq(is_trimmed(raw(x, y, c)), true) =
    match x: (a) => Eq(is_trimmed(raw(a, y, c)), true)
    | b[] =>
        match c
        | true => Eq/trans(cong_is_trimmed(raw_succ_l(y)), succ/raw_trimmed(y, py))
        | false => Eq/trans(cong_is_trimmed(raw_zero_l(y)), py)
        end
    | b[xh, ..xt] =>
        match y: (b) => Eq(is_trimmed(raw(b[xh, ..xt], b, c)), true)
        | b[] =>
            match c
            | true =>
                Eq/trans(
                    cong_is_trimmed(raw_succ_r(b[xh, ..xt])),
                    succ/raw_trimmed(b[xh, ..xt], px))
            | false => Eq/trans(cong_is_trimmed(raw_zero_r(b[xh, ..xt])), px)
            end
        | b[yh, ..yt] =>
            match xt: (u) => Eq(is_trimmed(raw(b[xh, ..u], b[yh, ..yt], c)), true)
            | b[] =>
                match yt: (v) => Eq(is_trimmed(raw(b[xh], b[yh, ..v], c)), true)
                | b[] =>
                    match xh
                    | true =>
                        match yh | true => Eq/refl() | false => match false_neq_true(py) end end
                    | false => match false_neq_true(px) end
                    end
                | b[a2, ..b2] =>
                    is_trimmed_cons(
                        xor3(xh, yh, c),
                        raw(b[], b[a2, ..b2], maj3(xh, yh, c)),
                        raw_trimmed(b[], b[a2, ..b2], maj3(xh, yh, c), refl_at(true), py),
                        raw_nonempty_r(b[], a2, b2, maj3(xh, yh, c)))
                end
            | b[a2, ..b2] =>
                match yt: (v) => Eq(is_trimmed(raw(b[xh, a2, ..b2], b[yh, ..v], c)), true)
                | b[] =>
                    is_trimmed_cons(
                        xor3(xh, yh, c),
                        raw(b[a2, ..b2], b[], maj3(xh, yh, c)),
                        raw_trimmed(b[a2, ..b2], b[], maj3(xh, yh, c), px, refl_at(true)),
                        raw_nonempty_l(a2, b2, b[], maj3(xh, yh, c)))
                | b[d2, ..e2] =>
                    is_trimmed_cons(
                        xor3(xh, yh, c),
                        raw(b[a2, ..b2], b[d2, ..e2], maj3(xh, yh, c)),
                        raw_trimmed(b[a2, ..b2], b[d2, ..e2], maj3(xh, yh, c), px, py),
                        raw_nonempty_l(a2, b2, b[d2, ..e2], maj3(xh, yh, c)))
                end
            end
        end
    end;

pub let comm(a: BigNat, b: BigNat) -> Eq(add(a, b), add(b, a)) =
    cong_of_bits(raw_comm(a.rep, b.rep, false));

pub let assoc(a: BigNat, b: BigNat, c: BigNat) -> Eq(add(add(a, b), c), add(a, add(b, c))) =
    cong_of_bits(
        Eq/trans(
            cong_raw_l(
                trim_of_trimmed(
                    raw(a.rep, b.rep, false),
                    raw_trimmed(
                        a.rep,
                        b.rep,
                        false,
                        is_trimmed_of_canonical(a.rep, a.canonical),
                        is_trimmed_of_canonical(b.rep, b.canonical))),
                c.rep,
                false),
            Eq/trans(
                raw_assoc(a.rep, b.rep, c.rep, false, false),
                cong_raw_r(
                    a.rep,
                    Eq/sym(
                        trim_of_trimmed(
                            raw(b.rep, c.rep, false),
                            raw_trimmed(
                                b.rep,
                                c.rep,
                                false,
                                is_trimmed_of_canonical(b.rep, b.canonical),
                                is_trimmed_of_canonical(c.rep, c.canonical)))),
                    false))));

pub rec raw_cancel_l(
    x: Bits,
    y: Bits,
    z: Bits,
    c: Bool,
    py: Eq(is_trimmed(y), true),
    pz: Eq(is_trimmed(z), true),
    p: Eq(raw(x, y, c), raw(x, z, c)),
) -> Eq(y, z) =
    match x
    | b[] =>
        match c
        | true =>
            succ/raw_inj(y, z, py, pz, Eq/trans(Eq/sym(raw_succ_l(y)), Eq/trans(p, raw_succ_l(z))))
        | false => Eq/trans(Eq/sym(raw_zero_l(y)), Eq/trans(p, raw_zero_l(z)))
        end
    | b[xh, ..xt] =>
        match y: (b) => Eq(b, z)
        | b[] =>
            match z: (d) => Eq(b[], d)
            | b[] => Eq/refl()
            | b[zh, ..zt] => match raw_cancel_absurd(xh, xt, zh, zt, c, pz, p) end
            end
        | b[yh, ..yt] =>
            match z: (d) => Eq(b[yh, ..yt], d)
            | b[] => match raw_cancel_absurd(xh, xt, yh, yt, c, py, Eq/sym(p)) end
            | b[zh, ..zt] =>
                cong_cons2(
                    xor3_inj_mid(xh, c, cons_inj_head(p)),
                    raw_cancel_l(
                        xt,
                        yt,
                        zt,
                        maj3(xh, zh, c),
                        tail_is_trimmed(yh, yt, py),
                        tail_is_trimmed(zh, zt, pz),
                        Eq/trans(
                            Eq/sym(
                                cong_raw_c(
                                    xt,
                                    yt,
                                    cong_maj3_mid(xh, xor3_inj_mid(xh, c, cons_inj_head(p)), c))),
                            cons_inj_tail(p))))
            end
        end
    end
and raw_cancel_absurd(
    xh: Bool,
    xt: Bits,
    zh: Bool,
    zt: Bits,
    c: Bool,
    pz: Eq(is_trimmed(b[zh, ..zt]), true),
    p: Eq(raw(b[xh, ..xt], b[], c), raw(b[xh, ..xt], b[zh, ..zt], c)),
) -> False =
    let shifted =
        Eq/subst(
            (w: Bits) => Eq(is_trimmed(w), true),
            cong_cons2(
                Eq/sym(xor3_inj_mid(xh, @false, @zh, c, cons_inj_head(p))),
                Eq/sym(
                    raw_cancel_l(
                        xt,
                        b[],
                        zt,
                        maj3(xh, zh, c),
                        refl_at(true),
                        tail_is_trimmed(zh, zt, pz),
                        Eq/trans(
                            Eq/sym(
                                cong_raw_c(
                                    xt,
                                    b[],
                                    cong_maj3_mid(
                                        xh,
                                        xor3_inj_mid(xh, @false, @zh, c, cons_inj_head(p)),
                                        c))),
                            cons_inj_tail(p))))),
            pz);
    false_neq_true(shifted);

pub let raw_cancel_r(
    x: Bits,
    y: Bits,
    z: Bits,
    c: Bool,
    py: Eq(is_trimmed(y), true),
    pz: Eq(is_trimmed(z), true),
    p: Eq(raw(y, x, c), raw(z, x, c)),
) -> Eq(y, z) =
    raw_cancel_l(x, y, z, c, py, pz, Eq/trans(raw_comm(x, y, c), Eq/trans(p, raw_comm(z, x, c))));

pub let cancel_l(a: BigNat, b: BigNat, c: BigNat, p: Eq(add(a, b), add(a, c))) -> Eq(b, c) =
    eq(
        b,
        c,
        raw_cancel_l(
            a.rep,
            b.rep,
            c.rep,
            false,
            is_trimmed_of_canonical(b.rep, b.canonical),
            is_trimmed_of_canonical(c.rep, c.canonical),
            Eq/trans(
                Eq/sym(
                    trim_of_trimmed(
                        raw(a.rep, b.rep, false),
                        raw_trimmed(
                            a.rep,
                            b.rep,
                            false,
                            is_trimmed_of_canonical(a.rep, a.canonical),
                            is_trimmed_of_canonical(b.rep, b.canonical)))),
                Eq/trans(
                    cong_rep(p),
                    trim_of_trimmed(
                        raw(a.rep, c.rep, false),
                        raw_trimmed(
                            a.rep,
                            c.rep,
                            false,
                            is_trimmed_of_canonical(a.rep, a.canonical),
                            is_trimmed_of_canonical(c.rep, c.canonical)))))));

pub let cancel_r(a: BigNat, b: BigNat, c: BigNat, p: Eq(add(b, a), add(c, a))) -> Eq(b, c) =
    cancel_l(a, b, c, Eq/trans(comm(a, b), Eq/trans(p, comm(c, a))));
