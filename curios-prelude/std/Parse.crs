use /std/{Result, Nat, Byte, Bytes, Str, Bool, Lst, Option, Monad};

pub struct Parse(A : Type) : pub Type {
    run(input : Bytes, pos : Nat) -> Result({Nat, A}, Str)
}

pub let run(@A : Type, p : Parse(A), input : Bytes) -> Result(A, Str) =
    match p.run(input, 0)
    | success((_, a)) => Result/success(a)
    | failure(msg) => Result/failure(msg)
    end;

pub let pure(@A : Type, a : A) -> Parse(A) =
    Parse { run(input, pos) = Result/success((pos, a)) };

pub let fail(@A : Type, msg : Str) -> Parse(A) =
    Parse { run(input, pos) = Result/failure(msg) };

pub let map(@A : Type, @B : Type, p : Parse(A), f : (A) -> B) -> Parse(B) =
    Parse {
        run(input, pos) =
            match p.run(input, pos)
            | success((next, a)) => Result/success((next, f(a)))
            | failure(msg) => Result/failure(msg)
            end
    };

pub let bind(@A : Type, @B : Type, p : Parse(A), f : (A) -> Parse(B)) -> Parse(B) =
    Parse {
        run(input, pos) =
            match p.run(input, pos)
            | success((next, a)) => f(a).run(input, next)
            | failure(msg) => Result/failure(msg)
            end
    };

pub let or(@A : Type, p : Parse(A), q : Parse(A)) -> Parse(A) =
    Parse {
        run(input, pos) =
            match p.run(input, pos)
            | success(pair) => Result/success(pair)
            | failure(_) => q.run(input, pos)
            end
    };

pub let and(@A : Type, @B : Type, p : Parse(A), q : Parse(B)) -> Parse({A, B}) =
    Parse {
        run(input, pos) =
            match p.run(input, pos)
            | success((mid, a)) =>
                match q.run(input, mid)
                | success((next, b)) => Result/success((next, (a, b)))
                | failure(msg) => Result/failure(msg)
                end
            | failure(msg) => Result/failure(msg)
            end
    };

pub let any_byte : Parse(Byte) =
    Parse {
        run(input, pos) =
            match Nat/Lt/try(pos, Bytes/len(input))
            | none() => Result/failure("unexpected end of input")
            | some(ok) => Result/success((pos + 1, Bytes/at(input, pos, ok)))
            end
    };

pub let peek_byte : Parse(Byte) =
    Parse {
        run(input, pos) =
            match Nat/Lt/try(pos, Bytes/len(input))
            | none() => Result/failure("unexpected end of input")
            | some(ok) => Result/success((pos, Bytes/at(input, pos, ok)))
            end
    };

pub let take_byte(expected : Byte) -> Parse(Byte) =
    Parse {
        run(input, pos) =
            match Nat/Lt/try(pos, Bytes/len(input))
            | none() => Result/failure("unexpected end of input")
            | some(ok) =>
                let byte = Bytes/at(input, pos, ok);
                match byte == expected
                | true => Result/success((pos + 1, byte))
                | false => Result/failure("unexpected byte")
                end
            end
    };

pub let take_literal(literal : Str) -> Parse({}) =
    Parse {
        run(input, pos) =
            let lit = Str/to_bytes(literal);
            let (stop, matched) =
                match Bytes/len(lit) : (_) => {Nat, Bool}
                | 0 => (pos, true)
                | step + 1; ih =>
                    let (cur, live) = ih;
                    match live
                    | true =>
                        match Nat/Lt/try(cur, Bytes/len(input))
                        | none() => (cur, false)
                        | some(ok) =>
                            match Option/unwrap_or(Bytes/get(lit, step), 0) == Bytes/at(input, cur, ok)
                            | true => (cur + 1, true)
                            | false => (cur, false)
                            end
                        end
                    | false => ih
                    end
                end;
            match matched
            | true => Result/success((stop, ()))
            | false => Result/failure("unexpected literal")
            end
    };

pub let eof : Parse({}) =
    Parse {
        run(input, pos) =
            match pos < Bytes/len(input)
            | true => Result/failure("expected end of input")
            | false => Result/success((pos, ()))
            end
    };

pub let take_while(pred : (Byte) -> Bool) -> Parse(Bytes) =
    Parse {
        run(input, pos) =
            let (stop, _) =
                match Bytes/len(input) - pos : (_) => {Nat, Bool}
                | 0 => (pos, false)
                | step + 1; ih =>
                    let (cur, stopped) = ih;
                    match stopped
                    | true => ih
                    | false =>
                        match Nat/Lt/try(cur, Bytes/len(input))
                        | none() => (cur, true)
                        | some(ok) =>
                            match pred(Bytes/at(input, cur, ok))
                            | true => (cur + 1, false)
                            | false => (cur, true)
                            end
                        end
                    end
                end;
            Result/success((stop, Bytes/slice(input, pos, stop)))
    };

pub let many0(@A : Type, p : Parse(A)) -> Parse(Lst(A)) =
    Parse {
        run(input, pos) =
            rec go(acc : Lst(A), cur : Nat) -> Result({Nat, Lst(A)}, Str) =
                match p.run(input, cur)
                | failure(_) => Result/success((cur, acc))
                | success((next, a)) =>
                    match next == cur
                    | true => Result/success((cur, acc))
                    | false => go(Lst/append(acc, a), next)
                    end
                end;
            go([], pos)
    };

pub let sep_by0(@A : Type, @S : Type, elem : Parse(A), sep : Parse(S)) -> Parse(Lst(A)) =
    Parse {
        run(input, pos) =
            match elem.run(input, pos)
            | failure(_) => Result/success((pos, []))
            | success((first_end, first)) =>
                rec go(acc : Lst(A), cur : Nat) -> Result({Nat, Lst(A)}, Str) =
                    match sep.run(input, cur)
                    | failure(_) => Result/success((cur, acc))
                    | success((sep_end, _)) =>
                        match elem.run(input, sep_end)
                        | failure(_) => Result/success((cur, acc))
                        | success((next, x)) =>
                            match next == cur
                            | true => Result/success((cur, acc))
                            | false => go(Lst/append(acc, x), next)
                            end
                        end
                    end;
                go([first], first_end)
            end
    };

satisfy Monad(Parse) {
    pure(x) = pure(x),
    bind(m, f) = bind(m, f)
}
