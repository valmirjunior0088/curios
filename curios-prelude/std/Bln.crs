pub use /sys/{Bln};
pub use /sys/Bln/{and, or, xor, eql};
use /std/{Str, Option};

pub let not(b : Bln) -> Bln =
    xor(b, true);

pub let to_str(b : Bln) -> Str =
    match b
    | true => "true"
    | false => "false"
    end;

pub let of_str(s : Str) -> Option(Bln) =
    match
    | s == "true" => Option/some(true)
    | s == "false" => Option/some(false)
    | _ => Option/none()
    end;
