pub use /sys/{Byte};
pub use /sys/Byte/{to_nat, eql, lt, lte, gt, gte};
use /std/{Order, Eql, Cmp, Nat, Show};

pub let cmp(a : Byte, b : Byte) -> Order =
    choose
    | Byte/lt(a, b) => Order/lt()
    | Byte/eql(a, b) => Order/eq()
    | _ => Order/gt()
    end;

satisfy Eql(Byte) {
    eql(a, b) = eql(a, b)
}

satisfy Cmp(Byte) {
    lt(a, b) = lt(a, b),
    lte(a, b) = lte(a, b),
    gt(a, b) = gt(a, b),
    gte(a, b) = gte(a, b)
}

satisfy Show(Byte) {
    show(b) = Nat/to_str(to_nat(b))
}
