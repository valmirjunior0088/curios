pub use /sys/{Byte};
pub use /sys/Byte/{to_nat, eql, lt, lte, gt, gte};
use /std/{Order, Eql, Cmp, Nat, Bool, Show, Ord};

pub let cmp(a: Byte, b: Byte) -> Order =
    choose | lt(a, b) => Order/lt() | eql(a, b) => Order/eq() | _ => Order/gt() end;

satisfy Eql(Byte) {
    eql = eql,
    neq(a, b) = Bool/not(eql(a, b)),
}

satisfy Cmp(Byte) {
    lt = lt,
    lte = lte,
    gt = gt,
    gte = gte,
}

satisfy Show(Byte) {
    show(b) = Nat/to_str(to_nat(b)),
}

satisfy Ord(Byte) {
    cmp = cmp,
}
