use /std/{List, Option, Eq, Ord, Bool};
use /std/List/{Member};
use /std/Map/{Map, Key, keys};
use /std/Map/internal/{Node};
use /std/Map/least/{Among};

--- The entry of the greatest key, or `none` of the empty map: the one of the last twig that holds any, at every branch down.
pub let greatest(@K: Type, use Key(K), @V: Type, m: Map(K, V)) -> Option({K, V}) =
    Node/greatest(m.root);

--- That `found` is an entry whose key is at or above `x` in the keys' order.
pub let Above(@K: Type, use Key(K), @V: Type, found: Option({K, V}), x: K) -> Prop =
    match found
    | none() => Bool/False
    | some(entry) => Bool/Holds(Ord/le((a: K, b: K) => Ord/ord(a, b))(x, entry.0))
    end;

--- A map's greatest key is one of its keys.
pub let among(@K: Type, use Key(K), @V: Type, m: Map(K, V)) -> Among(greatest(m), keys(m)) =
    Eq/subst(
        (l: List(K)) => Among(Node/greatest(m.root), l),
        Eq/sym(Node/collected(m.root, [])),
        Node/greatest_among(m.root));

--- No key of a map is above its greatest: a map that has a key has a greatest entry, whose key is at or above it.
pub let above(
    @K: Type,
    use Key(K),
    @V: Type,
    m: Map(K, V),
    x: K,
    i: Member()(x, keys(m)),
) -> Above(greatest(m), x) =
    Node/greatest_above(
        m.root,
        m.sound,
        x,
        Eq/subst((l: List(K)) => Member()(x, l), Node/collected(m.root, []), i));
