use /std/{Str, Nat, Bool, List, Option, Cli, Fmt};
use /std/Cli/{Command, Field, Positional, Positionals, Failure, shouted};

let words(parts: List(Str)) -> Str =
    Str/join(" ", List/filter(parts, (part) => part != ""));

let bracket(s: Str) -> Str =
    match s == "" | true => "" | false => Fmt/render("[%]")(s) end;

-- The command `path` names, the root's own name first: the deepest one the path reaches.
let at(c: Command, path: List(Str)) -> Command =
    let descend(c: Command, path: List(Str)) -> Command =
        match path
        | [] => c
        | [next, ..more] =>
            match c
            | group(_, _, _, commands) =>
                match List/find(commands, (child) => Cli/name(child) == next)
                | some(child) => descend(child, more)
                | none() => c
                end
            | leaf(_, _, _, _) => c
            end
        end;
    match path | [_, ..beneath] => descend(c, beneath) | [] => c end;

let visible(options: List(Field)) -> List(Field) =
    List/filter(options, (f) => Bool/not(f.hidden));

let field_synopsis(f: Field) -> Str =
    let long = Str/concat("--", f.long);
    match f.kind
    | flag() => bracket(long)
    | count() => Str/concat(bracket(long), "...")
    | toggle(_) => bracket(Str/concat("--[no-]", f.long))
    | option(v, presence) =>
        let given = Fmt/render("% <%>")(long)(v.metavar);
        match presence | required() => given | _ => bracket(given) end
    | many(v) => Str/concat(bracket(Fmt/render("% <%>")(long)(v.metavar)), "...")
    | choice(_, alternatives, presence) =>
        let spelled = Str/join(" | ", List/map(alternatives, (a) => Str/concat("--", a.long)));
        match presence | required() => Fmt/render("(%)")(spelled) | _ => bracket(spelled) end
    end;

let required_synopsis(p: Positional) -> Str =
    Fmt/render("<%>")(shouted(p.name));

let optional_synopsis(p: Positional) -> Str =
    bracket(shouted(p.name));

let rest_synopsis(p: Positional) -> Str =
    Str/concat(bracket(shouted(p.name)), "...");

let synopsis(c: Command) -> List(Str) =
    match c
    | leaf(_, _, options, ps) =>
        [
            ..List/map(visible(options), field_synopsis),
            ..List/map(ps.required, required_synopsis),
            ..List/map(ps.optional, optional_synopsis),
            ..match ps.rest | none() => [] | some(p) => [rest_synopsis(p)] end]
    | group(_, _, options, _) => [..List/map(visible(options), field_synopsis), "<COMMAND>"]
    end;

--- The usage line of the command `path` names.
pub let usage(c: Command, path: List(Str)) -> Str =
    Str/concat("Usage: ", words([Str/join(" ", path), ..synopsis(at(c, path))]));

let section(heading: Str, rows: List({Str, Str})) -> Str =
    match rows
    | [] => ""
    | [_, .._] =>
        let width = List/fold(rows, 0, ((left, _), held) => Nat/max(Str/len(left), held));
        Str/flatten([
            heading, "\n",
            ..List/map(rows, ((left, right)) =>
                Fmt/render("  %  %\n")(Str/pad_end(left, width, ' '))(right)),
            "\n"])
    end;

-- What help adds after an option's own: its default, the values it takes, the variable that stands for it, and its other names.
let notes(f: Field) -> List(Str) =
    [
        ..match f.kind
        | option(v, presence) =>
            [
                ..match presence
                | default(a) => [Fmt/render("[default: %]")(v.show(a))]
                | _ => []
                end,
                ..match v.choices
                | [] => []
                | _ => [Fmt/render("[possible values: %]")(Str/join(", ", v.choices))]
                end]
        | many(v) =>
            match v.choices
            | [] => []
            | _ => [Fmt/render("[possible values: %]")(Str/join(", ", v.choices))]
            end
        | _ => []
        end,
        ..match f.env | none() => [] | some(n) => [Fmt/render("[env: %]")(n)] end,
        ..match f.aliases
        | [] => []
        | _ =>
            [
                Fmt/render("[aliases: %]")(
                    Str/join(", ", List/map(f.aliases, (n) => Str/concat("--", n))))]
        end];

let field_rows(f: Field) -> List({Str, Str}) =
    let short = match f.short | none() => "    " | some(c) => Fmt/render("-%, ")(c) end;
    let described = words([f.help, ..notes(f)]);
    match f.kind
    | option(v, _) => [(Fmt/render("%--% <%>")(short)(f.long)(v.metavar), described)]
    | many(v) => [(Fmt/render("%--% <%>")(short)(f.long)(v.metavar), described)]
    | toggle(_) => [(Fmt/render("%--[no-]%")(short)(f.long), described)]
    | choice(_, alternatives, _) =>
        List/map(alternatives, (a) => (Str/concat("    --", a.long), a.help))
    | _ => [(Fmt/render("%--%")(short)(f.long), described)]
    end;

let builtin_rows(version: Option(Str)) -> List({Str, Str}) =
    [
        ("-h, --help", "Print help"),
        ..match version | none() => [] | some(_) => [("    --version", "Print version")] end];

let positional_rows(ps: Positionals) -> List({Str, Str}) =
    [
        ..List/map(ps.required, (p) => (required_synopsis(p), p.help)),
        ..List/map(ps.optional, (p) => (optional_synopsis(p), p.help)),
        ..match ps.rest | none() => [] | some(p) => [(rest_synopsis(p), p.help)] end];

--- The help of the command `path` names: what it does, its usage line, and its arguments, its options and its commands.
pub let help(c: Command, version: Option(Str), path: List(Str)) -> Str =
    let target = at(c, path);
    let options(fields: List(Field)) -> Str =
        section("Options:", [
            ..List/concat_map(visible(fields), field_rows),
            ..builtin_rows(version)]);
    let sections =
        match target
        | leaf(_, _, fields, ps) =>
            Str/concat(section("Arguments:", positional_rows(ps)), options(fields))
        | group(_, _, fields, commands) =>
            Str/concat(
                options(fields),
                section(
                    "Commands:",
                    List/map(commands, (child) =>
                        (
                            Cli/name(child),
                            match child | leaf(_, a, _, _) => a | group(_, a, _, _) => a end))))
        end;
    let about = match target | leaf(_, a, _, _) => a | group(_, a, _, _) => a end;
    Fmt/render("%\n\n%\n\n%")(about)(usage(c, path))(sections);

let tip(near: Option(Str), what: Str) -> Str =
    match near
    | none() => ""
    | some(n) => Fmt/render("\n\n  tip: a similar % exists: '%'")(what)(n)
    end;

let complaint(f: Failure) -> Str =
    match f
    | unknown_option(t, near) => Fmt/render("unexpected argument '%'%")(t)(tip(near, "argument"))
    | missing_value(n) => Fmt/render("a value is required for '%'")(n)
    | missing_required(n) => Fmt/render("the argument '%' is required")(n)
    | unexpected(t) => Fmt/render("unexpected argument '%'")(t)
    | bad_value(n, r) => Fmt/render("invalid value for '%': %")(n)(r)
    | conflict(names) => Str/concat("conflicting arguments: ", Str/join(", ", names))
    | unknown_command(n, near, known) =>
        Fmt/render("unrecognized subcommand '%'%\n  available: %")(
            n)(
            tip(near, "subcommand"))(
            Str/join(", ", known))
    | missing_command(known) =>
        Str/flatten(["a subcommand is required\n  available: ", Str/join(", ", known)])
    end;

--- A refusal: what the line got wrong, the usage line of the command `path` names, and where help is.
pub let report(c: Command, path: List(Str), f: Failure) -> Str =
    Fmt/render("error: %\n\n%\n\nFor more information, try '--help'.\n")(
        complaint(f))(
        usage(c, path));
