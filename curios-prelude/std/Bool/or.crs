pub use /sys/Bool/{or};

use /std/{Bool};

--- A disjunction from its first decision: `a || b` holds where `a` does. By cases on `a`, since `||` reduces at each.
pub let of_first(a: Bool, b: Bool, p: Bool/Holds(a)) -> Bool/Holds(a || b) =
    match a
    | true => Bool/True/qed()
    | false => match p end
    end;

--- A disjunction from its second decision: `a || b` holds where `b` does.
pub let of_second(a: Bool, b: Bool, q: Bool/Holds(b)) -> Bool/Holds(a || b) =
    match a | true => Bool/True/qed() | false => q end;
