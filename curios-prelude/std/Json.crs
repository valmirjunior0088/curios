use /std/{Bool, Flt, Str, Lst};

pub induct Json : pub Type
| null()
| bool(Bool)
| num(Flt)
| str(Str)
| arr(Lst(Json))
| obj(Lst({ Str, Json }))
end

pub use Json/*;

-- The two halves are private modules: their scanners, escape tables, and intermediate parsers are implementation, visible throughout this subtree and nowhere else. Only the two entry points are re-exported.
mod encode;
pub use encode/{encode};

mod decode;
pub use decode/{decode};
