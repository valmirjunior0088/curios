use /std/{Nat, Bool, Str, Bytes, List, Option, Result, Try, Io, Monad, Spell, Show, Proc};
use /std/ops/{Eql};
use /std/time/{Duration};

--- What a check that failed found, as the runner presents it: the steps that reached it, the outermost first, what it states, and the values it compared, each behind its label and spelled as Curios writes it.
struct Failure: Type {
    steps: List(Str),
    statement: Str,
    facts: List({Str, Str}),
}

-- What a test found crosses to its runner as the text this writes, which the runner reads back as Curios.
satisfy Spell(Failure) {
    ..
}

--- A computation that succeeds with an `A` or ends the current test with what it found: the checks that failed, one at least.
--- Its private representation keeps interpretation inside the test runner and resource combinators.
pub induct Test(A: Type): Type
| success(A)
| failed(List(Failure))
| action(Io(Test(A)))
end

--- Succeed with `a` without performing an effect.
pub let pure(@A: Type, a: A) -> Test(A) =
    Test/success(a);

-- End the current test with a check that failed, stating `statement` beside the values `facts` spell.
let failing(@A: Type, statement: Str, facts: List({Str, Str})) -> Test(A) =
    Test/failed([Failure { steps = [], statement = statement, facts = facts }]);

--- End the current test with `message`, skipping its remaining continuations.
pub let fail(@A: Type, message: Str) -> Test(A) =
    failing(message, []);

--- Continue a successful computation; a failure skips `next`.
pub let bind(@A: Type, @B: Type, test: Test(A), next: (A) -> Test(B)) -> Test(B) =
    match test
    | success(a) => next(a)
    | failed(failures) => Test/failed(failures)
    | action(io) => Test/action(Io/bind(io, (inner) => Io/pure(bind(inner, next))))
    end;

satisfy Monad(Test) {
    pure(@_, a) = pure(a),
    bind(@_, @_, test, next) = bind(test, next),
}

satisfy Monad/Lift(Io, Test) {
    lift(@_, action) = Test/action(Io/bind(action, (a) => Io/pure(pure(a)))),
}

satisfy Monad/Lift(Test, Test) {
    lift(@_, test) = test,
}

satisfy (
    @M: (Type) -> Type,
    @E: Type,
    use Monad(M),
    use Monad/Lift(M, Test),
    use Show(E),
) => Monad/Lift((A: Type) => Try(M, E, A), Test) {
    lift(@_, action) =
        bind(
            Monad/lift(Try/run(action)),
            (result) =>
                match result
                | success(a) => pure(a)
                | failure(e) => fail(Show/show(e))
                end),
}

--- The test that holds when `condition` is true.
pub let assert(condition: Bool) -> Test({}) =
    match condition
    | true => pure(())
    | false => fail("the condition was false")
    end;

--- The test that holds when the two are equal, reporting both when they are not.
pub let equal(@A: Type, use Eql(A), use Spell(A), actual: A, expected: A) -> Test({}) =
    match actual == expected
    | true => pure(())
    | false =>
        failing("not equal", [
            ("expected", Spell/spell(expected)),
            ("obtained", Spell/spell(actual))])
    end;

--- Flatten a fallible thunk returning a test, reporting its error when it fails.
pub let try(@E: Type, @A: Type, use Show(E), thunk: () -> Try(Io, E, Test(A))) -> Test(A) =
    bind(Monad/lift(thunk()), (inner) => inner);

let context(@A: Type, label: Str, test: Test(A)) -> Test(A) =
    match test
    | success(_) => test
    | failed(failures) =>
        Test/failed(
            List/map(failures, (failure) =>
                Failure { ..failure, steps = [label, ..failure.steps] }))
    | action(io) => Test/action(Io/bind(io, (inner) => Io/pure(context(label, inner))))
    end;

-- The failures `found` holds, then those `next` ends with: `next` runs whatever `found` held, after its actions.
let gathered(found: Test(List(Failure)), next: Test({})) -> Test(List(Failure)) =
    match found
    | success(failures) =>
        match next
        | success(()) => found
        | failed(more) => Test/success([..failures, ..more])
        | action(io) => Test/action(Io/bind(io, (inner) => Io/pure(gathered(found, inner))))
        end
    | failed(_) => found
    | action(io) => Test/action(Io/bind(io, (inner) => Io/pure(gathered(inner, next))))
    end;

--- Check each test in order, reporting every one that fails under its zero-based case index: the cases are independent, so each runs whatever the others found, where `bind` stops at the first failure of steps that depend on one another.
pub let all(tests: List(Test({}))) -> Test({}) =
    let found =
        List/fold(
            tests,
            (found = pure([]), index = 0),
            (next, state: {found: Test(List(Failure)), index: Nat}) =>
                (
                    found =
                        gathered(
                            state.found,
                            context(Str/concat("case ", Nat/to_str(state.index)), next)),
                    index = state.index + 1)).found;
    bind(found, (failures) => match failures | [] => pure(()) | _ => Test/failed(failures) end);

-- Keeping an outcome inside Io lets a scope release before the failure resumes propagating through Test.
let finish(@A: Type, test: Test(A)) -> Io(Result(List(Failure), A)) =
    match test
    | success(a) => Io/pure(Result/success(a))
    | failed(failures) => Io/pure(Result/failure(failures))
    | action(io) => Io/bind(io, (inner) => finish(inner))
    end;

let from_result(@A: Type, result: Result(List(Failure), A)) -> Test(A) =
    match result
    | success(a) => pure(a)
    | failure(failures) => Test/failed(failures)
    end;

--- `body` run with a scope, as `Io/Scope/run` runs one: its children cancelled and its releases run after a success or an assertion failure, and when a suspended body is cancelled.
pub let scope(@A: Type, body: (Io/Scope) -> Test(A)) -> Test(A) =
    let result = Io/Scope/run((s) => finish(body(s)))!;
    from_result(result);

--- Fail if the deadline wins, after cancelling the suspended body and running its releases.
pub let timeout(@A: Type, d: Duration, body: () -> Test(A)) -> Test(A) =
    let result = Io/timeout(d, finish(body()))!;
    match result
    | some(outcome) => from_result(outcome)
    | none() => failing("timed out", [("after", Spell/spell(d))])
    end;

-- What a test found, spelled for its runner to read back and present: the checks that failed, none where it held.
let verdict(failures: List(Failure)) -> Bytes =
    Str/to_bytes(Spell/spell(failures));

-- The one test a runner selected is named by the runner, which says how it ended and presents what it found: the test writes nothing of its own.
let answer(test: Test({})) -> Io(Bytes) =
    let result = finish(test)!;
    match result
    | success(()) => Io/pure(verdict([]))
    | failure(failures) => Io/pure(verdict(failures))
    end;

let parse_index(raw: Bytes) -> Option(Nat) =
    match Str/of_bytes(raw)
    | success(s) => Nat/of_str(s)
    | failure(_) => Option/none()
    end;

--- Run the test the runner selected, its index in `tests` the program's first argument, and answer what it found, for the runner to present: the checks that failed, spelled, and none where it held. An index the program does not hold answers no verdict, which the runner reports as its own fault.
pub let main(tests: List(() -> Test({}))) -> Io(Bytes) =
    let arguments = Proc/args()!;
    match List/try_get(arguments, 1)
    | some(raw) =>
        match parse_index(raw)
        | some(index) =>
            match List/try_get(tests, index)
            | some(body) => answer(body())
            | none() => Io/pure(x[])
            end
        | none() => Io/pure(x[])
        end
    | none() => Io/pure(x[])
    end;
