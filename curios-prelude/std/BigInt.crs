-- Arbitrary-precision integers: a sign tag over a strictly-positive `NonZero`
-- magnitude (or the distinguished `zero`). Every operation dispatches on the sign
-- constructors and delegates the magnitude arithmetic to `NonZero`/`BigNat`.
-- Signed subtraction (`pos_sub`) reads the sign straight off `non_zero_cmp` and
-- takes the truncating `BigNat/sub` of the larger minus the smaller magnitude, so
-- no borrow/compare bridge is needed. The algebraic lemma corpus is deferred until
-- a consumer needs it (see documentation/REPRESENTATION_SPEC_PT4_BIGFLT.md).

use /std/{Nat, Int, Bool, Str, Order, BigNat, NonZero, Eql, Cmp, Add, Sub, Mul};
use /std/NonZero/{non_zero_add, non_zero_mul, non_zero_cmp, Split};

pub induct BigInt : pub Type
| neg(NonZero)
| zero()
| pos(NonZero)
end

pub let zero : BigInt =
    BigInt/zero();

pub let is_zero(a : BigInt) -> Bool =
    match a
    | neg(_) => false
    | zero() => true
    | pos(_) => false
    end;

-- attach a sign to a BigNat magnitude, collapsing a zero magnitude to BigInt/zero
let signed(negative : Bool, a : BigNat) -> BigInt =
    match NonZero/of_big_nat(a)
    | zero() => BigInt/zero()
    | pos(t) =>
        match negative
        | true => BigInt/neg(t)
        | false => BigInt/pos(t)
        end
    end;

pub let of_big_nat(a : BigNat) -> BigInt =
    signed(false, a);

-- x - y for positive x, y: the sign is non_zero_cmp, the magnitude is the
-- truncating BigNat difference of the larger minus the smaller.
pub let pos_sub(x : NonZero, y : NonZero) -> BigInt =
    match non_zero_cmp(x, y)
    | lt() => signed(true, BigNat/sub(y.magnitude, x.magnitude))
    | eq() => BigInt/zero()
    | gt() => signed(false, BigNat/sub(x.magnitude, y.magnitude))
    end;

pub let add(a : BigInt, b : BigInt) -> BigInt =
    match (a, b)
    | (neg(p), neg(q)) => BigInt/neg(non_zero_add(p, q))
    | (neg(p), zero()) => BigInt/neg(p)
    | (neg(p), pos(q)) => pos_sub(q, p)
    | (zero(), y) => y
    | (pos(p), neg(q)) => pos_sub(p, q)
    | (pos(p), zero()) => BigInt/pos(p)
    | (pos(p), pos(q)) => BigInt/pos(non_zero_add(p, q))
    end;

pub let neg(a : BigInt) -> BigInt =
    match a
    | neg(p) => BigInt/pos(p)
    | zero() => BigInt/zero()
    | pos(p) => BigInt/neg(p)
    end;

pub let sub(a : BigInt, b : BigInt) -> BigInt =
    add(a, neg(b));

pub let abs(a : BigInt) -> BigInt =
    match a
    | neg(p) => BigInt/pos(p)
    | zero() => BigInt/zero()
    | pos(p) => BigInt/pos(p)
    end;

pub let magnitude(a : BigInt) -> BigNat =
    match a
    | neg(p) => p.magnitude
    | zero() => BigNat/zero
    | pos(p) => p.magnitude
    end;

pub let mul(a : BigInt, b : BigInt) -> BigInt =
    match (a, b)
    | (neg(p), neg(q)) => BigInt/pos(non_zero_mul(p, q))
    | (neg(_), zero()) => BigInt/zero()
    | (neg(p), pos(q)) => BigInt/neg(non_zero_mul(p, q))
    | (zero(), _) => BigInt/zero()
    | (pos(p), neg(q)) => BigInt/neg(non_zero_mul(p, q))
    | (pos(_), zero()) => BigInt/zero()
    | (pos(p), pos(q)) => BigInt/pos(non_zero_mul(p, q))
    end;

pub let cmp(a : BigInt, b : BigInt) -> Order =
    match (a, b)
    | (neg(p), neg(q)) => non_zero_cmp(q, p)
    | (neg(_), zero()) => Order/lt()
    | (neg(_), pos(_)) => Order/lt()
    | (zero(), neg(_)) => Order/gt()
    | (zero(), zero()) => Order/eq()
    | (zero(), pos(_)) => Order/lt()
    | (pos(_), neg(_)) => Order/gt()
    | (pos(_), zero()) => Order/gt()
    | (pos(p), pos(q)) => non_zero_cmp(p, q)
    end;

pub let eql(a : BigInt, b : BigInt) -> Bool =
    match cmp(a, b)
    | eq() => true
    | _ => false
    end;

pub let lt(a : BigInt, b : BigInt) -> Bool =
    match cmp(a, b)
    | lt() => true
    | _ => false
    end;

pub let lte(a : BigInt, b : BigInt) -> Bool =
    match cmp(a, b)
    | gt() => false
    | _ => true
    end;

pub let gt(a : BigInt, b : BigInt) -> Bool =
    match cmp(a, b)
    | gt() => true
    | _ => false
    end;

pub let gte(a : BigInt, b : BigInt) -> Bool =
    match cmp(a, b)
    | lt() => false
    | _ => true
    end;

pub let of_nat(n : Nat) -> BigInt =
    of_big_nat(BigNat/of_nat(n));

pub let of_int(n : Int) -> BigInt =
    let mag = of_big_nat(BigNat/of_nat(Int/abs(n)));
    match n < +0
    | true => neg(mag)
    | false => mag
    end;

pub let is_even(a : BigInt) -> Bool =
    BigNat/is_even(magnitude(a));

pub let div2(a : BigInt) -> BigInt =
    match a
    | neg(p) => neg(of_big_nat(BigNat/div2(p.magnitude)))
    | zero() => BigInt/zero()
    | pos(p) => of_big_nat(BigNat/div2(p.magnitude))
    end;

pub let to_str(a : BigInt) -> Str =
    match a
    | neg(p) => Str/concat("-", BigNat/to_str(p.magnitude))
    | zero() => "+0"
    | pos(p) => Str/concat("+", BigNat/to_str(p.magnitude))
    end;

satisfy Eql(BigInt) {
    eql(a, b) = eql(a, b)
}

satisfy Cmp(BigInt) {
    lt(a, b) = lt(a, b),
    lte(a, b) = lte(a, b),
    gt(a, b) = gt(a, b),
    gte(a, b) = gte(a, b)
}

satisfy Add(BigInt) {
    add(a, b) = add(a, b)
}

satisfy Sub(BigInt) {
    sub(a, b) = sub(a, b)
}

satisfy Mul(BigInt) {
    mul(a, b) = mul(a, b)
}
