use /std/{Nat, Int, Flt, Bool, Byte, Bytes, Char, Str, Lst, Map, Option, Result, Parse};
use /std/Toml/{Toml, let Build};
use /std/Toml/build/{apply_assign, apply_header, apply_aot, build_empty};
use /std/Toml/scan/{byte_at_is, line_end, trivia, ws};
use /std/Toml/keys/{key_part};
use /std/Toml/values/{value_scan};

induct Stmt : Type
| assign(path : Lst(Str), value : Toml)
| table_header(Lst(Str))
| array_header(Lst(Str))
end

-- The statement layer is written as recursive scanners over positions: a
-- recursive function applied to a symbolic input stays a residual application
-- under type-level reduction, where an equivalent combinator constant would
-- unfold its whole parser tree symbolically.
rec key_path_scan(input : Bytes, cur : Nat, acc : Lst(Str)) -> Result({Nat, Lst(Str)}, Str) =
    match key_part.run(input, cur)
    | failure(msg) => Result/failure(msg)
    | success((c1, k)) =>
        let acc2 = [..acc, k];
        match ws.run(input, c1)
        | failure(msg) => Result/failure(msg)
        | success((c2, _)) =>
            match byte_at_is(input, c2, (n) => n == 0x2E)
            | true =>
                match ws.run(input, c2 + 1)
                | failure(msg) => Result/failure(msg)
                | success((c3, _)) => key_path_scan(input, c3, acc2)
                end
            | false => Result/success((c2, acc2))
            end
        end
    end
and header_scan(input : Bytes, cur : Nat, double : Bool) -> Result({Nat, Lst(Str)}, Str) =
    match ws.run(input, cur)
    | failure(msg) => Result/failure(msg)
    | success((c1, _)) =>
        match key_path_scan(input, c1, [])
        | failure(msg) => Result/failure(msg)
        | success((c2, path)) =>
            match byte_at_is(input, c2, (n) => n == 0x5D)
            | true =>
                match double
                | true =>
                    match byte_at_is(input, c2 + 1, (n) => n == 0x5D)
                    | true => Result/success((c2 + 2, path))
                    | false => Result/failure("expected ']]' in table header")
                    end
                | false => Result/success((c2 + 1, path))
                end
            | false => Result/failure("expected ']' in table header")
            end
        end
    end
and stmt_scan(input : Bytes, cur : Nat) -> Result({Nat, Stmt}, Str) =
    match byte_at_is(input, cur, (n) => n == 0x5B)
    | true =>
        match byte_at_is(input, cur + 1, (n) => n == 0x5B)
        | true =>
            match header_scan(input, cur + 2, true)
            | success((c1, path)) => Result/success((c1, Stmt/array_header(path)))
            | failure(msg) => Result/failure(msg)
            end
        | false =>
            match header_scan(input, cur + 1, false)
            | success((c1, path)) => Result/success((c1, Stmt/table_header(path)))
            | failure(msg) => Result/failure(msg)
            end
        end
    | false =>
        match key_path_scan(input, cur, [])
        | failure(msg) => Result/failure(msg)
        | success((c1, path)) =>
            match byte_at_is(input, c1, (n) => n == 0x3D)
            | true =>
                match ws.run(input, c1 + 1)
                | failure(msg) => Result/failure(msg)
                | success((c2, _)) =>
                    match value_scan(input, c2)
                    | failure(msg) => Result/failure(msg)
                    | success((c3, v)) => Result/success((c3, Stmt/assign(path, v)))
                    end
                end
            | false => Result/failure("expected '=' after key")
            end
        end
    end
and stmts_scan(input : Bytes, cur : Nat, acc : Lst(Stmt)) -> Result(Lst(Stmt), Str) =
    match trivia.run(input, cur)
    | failure(msg) => Result/failure(msg)
    | success((c1, _)) =>
        match Parse/eof.run(input, c1)
        | success(_) => Result/success(acc)
        | failure(_) =>
            match stmt_scan(input, c1)
            | failure(msg) => Result/failure(msg)
            | success((c2, s)) =>
                match line_end.run(input, c2)
                | failure(msg) => Result/failure(msg)
                | success((c3, _)) => stmts_scan(input, c3, [..acc, s])
                end
            end
        end
    end;

pub let decode(source : Str) -> Result(Map(Toml), Str) =
    match stmts_scan(Str/to_bytes(source), 0, [])
    | failure(msg) => Result/failure(msg)
    | success(stmts) =>
        let start : Result(Build, Str) = Result/success(build_empty);
        match Lst/fold(stmts, start, (s, acc) =>
            Result/bind(acc, (b) =>
                match s
                | assign(path, v) => apply_assign(b, path, v)
                | table_header(path) => apply_header(b, path)
                | array_header(path) => apply_aot(b, path)
                end))
        | success(b) => Result/success(b.root)
        | failure(msg) => Result/failure(msg)
        end
    end;
