use /std/{Nat, Show, Spell, Fmt};
use /std/ops/{Eql};

--- The terminal's size in cells: `w` columns by `h` rows, as a view's size is.
pub struct Size: pub Type {
    w: Nat,
    h: Nat,
}

satisfy Eql(Size) {
    ..
}

satisfy Spell(Size) {
    ..
}

satisfy Show(Size) {
    show(s) = Fmt/render("%x%")(s.w)(s.h),
}
