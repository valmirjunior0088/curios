use /std/{Bytes, Nat, Str, Io, Result, Async};

pub struct File : Type { Io }

pub let read(f : File, n : Nat) -> Async(Io/Read) =
    Async/read(f.0, n);

pub let write(f : File, b : Bytes) -> Async(Result({}, Io/Error)) =
    Async/write(f.0, b);

pub let open(path : Str, mode : Io/Mode) -> Async(Result(File, Io/Error)) =
    Async/defer(() =>
        let r = /sys/Io/open(Str/to_bytes(path), Io/of_mode(mode));
        match r.status == /sys/Io/Status/ok : Async(Result(File, Io/Error))
        | true =>
            let _ = Async/nonblocking(r.handle);
            Async/bind(Async/acquire(r.handle, () => /sys/Io/close(r.handle)), (_) =>
                Async/pure(Result/success(File { r.handle })))
        | false => Async/pure(Result/failure(Io/error_of(r.status)))
        end);

pub let close(f : File) -> Async({}) =
    Async/release(f.0);

pub let with(@A : Type, path : Str, mode : Io/Mode, body : (File) -> Async(A)) -> Async(Result(A, Io/Error)) =
    Async/bind(open(path, mode), (opened) =>
        match opened : Async(Result(A, Io/Error))
        | success(f) =>
            Async/bind(body(f), (a) =>
                Async/bind(close(f), (_) => Async/pure(Result/success(a))))
        | failure(e) => Async/pure(Result/failure(e))
        end);

let drain(f : File) -> Async(Bytes) =
    Async/drain((n) => read(f, n));

pub let read_all(path : Str) -> Async(Result(Bytes, Io/Error)) =
    with(path, Io/Mode/read(), (f) => drain(f));
