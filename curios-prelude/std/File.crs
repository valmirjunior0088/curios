use /std/{Bytes, Nat, Str, Handle, Result, Async, Io};

pub struct File: Type {
    Handle,
}

pub induct Mode: pub Type
| read()
| write()
| append()
end

pub let of_mode(mode: Mode) -> Nat =
    match mode
    | read() => /sys/Mode/read
    | write() => /sys/Mode/write
    | append() => /sys/Mode/append
    end;

pub let read(f: File, n: Nat) -> Async(Handle/Read) =
    Async/read(f.0, n);

pub let write(f: File, b: Bytes) -> Async(Result({}, Handle/Error)) =
    Async/write(f.0, b);

pub let open(path: Str, mode: Mode) -> Async(Result(File, Handle/Error)) =
    let r = Async/lift(/sys/open(Str/to_bytes(path), of_mode(mode)))!;
    match r.status == /sys/Status/ok
    | true =>
        let nb = Async/lift(Async/nonblocking(r.handle))!;
        match nb
        | failure(e) =>
            let _ = Async/lift(/sys/close(r.handle))!;
            Async/pure(Result/failure(e))
        | success(_) =>
            let _ = Async/acquire(r.handle, /sys/close(r.handle))!;
            Async/pure(Result/success(File { r.handle }))
        end
    | false => Async/pure(Result/failure(Handle/error_of(r.status)))
    end;

pub let close(f: File) -> Async({}) =
    Async/release(f.0);

pub let with(
    @A: Type,
    path: Str,
    mode: Mode,
    body: (File) -> Async(A),
) -> Async(Result(A, Handle/Error)) =
    let opened = open(path, mode)!;
    match opened
    | success(f) =>
        let a = body(f)!;
        let _ = close(f)!;
        Async/pure(Result/success(a))
    | failure(e) => Async/pure(Result/failure(e))
    end;

let drain(f: File) -> Async(Result(Bytes, Handle/Error)) =
    Async/drain((n) => read(f, n));

pub let read_all(path: Str) -> Async(Result(Bytes, Handle/Error)) =
    Async/map(with(path, Mode/read(), (f) => drain(f)), (r) => Result/flatten(r));
