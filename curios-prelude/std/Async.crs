use /std/{Handle, Bytes, Nat, Int, Bool, Lst, Option, Result, Cell, Monad};
use /std/time/{Duration};

pub mod Waker;
pub use Waker/{let Waker};

pub mod Future;
pub use Future/{let Future};

struct Token : Type {
    Cell(Bool)
}

let cancel_token(t : Token) -> {} =
    Cell/set(t.0, true);

let is_cancelled(t : Token) -> Bool =
    Cell/get(t.0);

struct Guard : Type {
    handle : Handle,
    release : () -> {}
}

induct Pause : Type
| wait(Handle, Nat)
| sleep(Duration)
| fork(() -> Async({}), Token)
| park((Waker) -> {})
| acquire(Handle, () -> {})
| release(Handle)
| defer()
| yield_now()
pub and Async(A : Type) : Type
| done(A)
| step(Pause, () -> Async(A))
end

pub let Fiber : Type =
    () -> Async({});

pub let pure(@A : Type, a : A) -> Async(A) =
    Async/done(a);

pub rec bind(@A : Type, @B : Type, m : Async(A), f : (A) -> Async(B)) -> Async(B) =
    match m
    | done(a) => f(a)
    | step(p, k) => Async/step(p, () => bind(k(), f))
    end;

pub let map(@A : Type, @B : Type, m : Async(A), f : (A) -> B) -> Async(B) =
    bind(m, (a) => pure(f(a)));

let fork_with(child : Fiber, t : Token) -> Async({}) =
    Async/step(Pause/fork(child, t), () => pure(()));

pub let defer(@A : Type, body : () -> Async(A)) -> Async(A) =
    Async/step(Pause/defer(), body);

pub let wait(h : Handle, ev : Nat) -> Async({}) =
    Async/step(Pause/wait(h, ev), () => pure(()));

pub let sleep(d : Duration) -> Async({}) =
    Async/step(Pause/sleep(d), () => pure(()));

pub let park(register : (Waker) -> {}) -> Async({}) =
    Async/step(Pause/park(register), () => pure(()));

pub let yield_now : Async({}) =
    Async/step(Pause/yield_now(), () => pure(()));

pub let acquire(h : Handle, fin : () -> {}) -> Async({}) =
    Async/step(Pause/acquire(h, fin), () => pure(()));

pub let release(h : Handle) -> Async({}) =
    Async/step(Pause/release(h), () => pure(()));

pub let using(@A : Type, h : Handle, fin : () -> {}, body : Async(A)) -> Async(A) =
    bind(acquire(h, fin), (_) =>
        bind(body, (a) =>
            bind(release(h), (_) => pure(a))));

pub let go(body : Fiber) -> Async({}) =
    defer(() => fork_with(body, Token { Cell/new(false) }));

-- Failing to clear O_NONBLOCK is not cosmetic: the handle stays blocking and
-- the next read stalls the whole single-threaded scheduler, so the status is
-- reported rather than dropped.
pub let nonblocking(h : Handle) -> Result({}, Handle/Error) =
    let status = /sys/set_nonblocking(h, true);
    match status == /sys/Status/ok
    | true => Result/success(())
    | false => Result/failure(Handle/error_of(status))
    end;

pub let read(h : Handle, n : Nat) -> Async(Handle/Read) =
    match nonblocking(h)
    | failure(e) => pure(Handle/Read/error(e))
    | success(_) =>
    rec go() -> Async(Handle/Read) =
        defer(() =>
            let r = /sys/read(h, n);
            choose
            | r.status == /sys/Status/would_block => bind(wait(h, /sys/Poll/read), (_) => go())
            | r.status == /sys/Status/eof => pure(Handle/Read/eof())
            | r.status == /sys/Status/ok => pure(Handle/Read/chunk(r.bytes))
            | _ => pure(Handle/Read/error(Handle/error_of(r.status)))
            end);
    go()
    end;

pub let write(h : Handle, b : Bytes) -> Async(Result({}, Handle/Error)) =
    match nonblocking(h)
    | failure(e) => pure(Result/failure(e))
    | success(_) =>
    rec go(rest : Bytes) -> Async(Result({}, Handle/Error)) =
        defer(() =>
            let r = /sys/write(h, rest);
            choose
            | r.status == /sys/Status/would_block => bind(wait(h, /sys/Poll/write), (_) => go(rest))
            | r.status != /sys/Status/ok => pure(Result/failure(Handle/error_of(r.status)))
            | r.written < Bytes/len(rest) => bind(wait(h, /sys/Poll/write), (_) => go(Bytes/slice(rest, r.written, Bytes/len(rest))))
            | _ => pure(Result/success(()))
            end);
    go(b)
    end;

pub let accept(l : Handle) -> Async(Result(Handle, Handle/Error)) =
    match nonblocking(l)
    | failure(e) => pure(Result/failure(e))
    | success(_) =>
    rec go() -> Async(Result(Handle, Handle/Error)) =
        defer(() =>
            let r = /sys/accept(l);
            choose
            | r.status == /sys/Status/would_block => bind(wait(l, /sys/Poll/read), (_) => go())
            | r.status == /sys/Status/ok => pure(Result/success(r.handle))
            | _ => pure(Result/failure(Handle/error_of(r.status)))
            end);
    go()
    end;

pub let drain(read : (Nat) -> Async(Handle/Read)) -> Async(Bytes) =
    rec go(acc : Bytes) -> Async(Bytes) =
        bind(read(4096), (r) =>
            match r
            | chunk(bytes) => go(x\..acc\..bytes)
            | eof() => pure(acc)
            | error(_) => pure(acc)
            end);
    go(x\);

pub rec await(@A : Type, f : Future(A)) -> Async(A) =
    match Future/poll(f)
    | some(a) => pure(a)
    | none() => bind(park((w) => Future/register(f, w)), (_) => await(f))
    end;

struct Job : Type {
    resume : Fiber,
    token : Token,
    guards : Lst(Guard)
}

let Slot : Type =
    Cell(Option(Job));

struct Parked : Type {
    handle : Handle,
    interest : Nat,
    resume : Fiber,
    token : Token,
    guards : Lst(Guard)
}

struct Sleeper : Type {
    due : Duration,
    resume : Fiber,
    token : Token,
    guards : Lst(Guard)
}

let run_guards(gs : Lst(Guard)) -> {} =
    Lst/each(gs, (g) => g.release());

let release_guard(h : Handle, gs : Lst(Guard)) -> Lst(Guard) =
    rec each(rest : Lst(Guard)) -> Lst(Guard) =
        match rest
        | [] => Lst/nil()
        | [g, ..more] =>
            match /sys/Handle/eql(g.handle, h)
            | true => let _ = g.release(); more
            | false => Lst/cons(g, each(more))
            end
        end;
    each(gs);

let drain_jobs(js : Lst(Job)) -> {} =
    Lst/each(js, (j) => run_guards(j.guards));

let drain_parked(ps : Lst(Parked)) -> {} =
    Lst/each(ps, (p) => run_guards(p.guards));

let drain_sleeping(ss : Lst(Sleeper)) -> {} =
    Lst/each(ss, (s) => run_guards(s.guards));

let drain_slots(ss : Lst(Slot)) -> {} =
    rec each(rest : Lst(Slot)) -> {} =
        match rest
        | [] => ()
        | [s, ..more] =>
            match Cell/get(s)
            | none() => each(more)
            | some(j) => let _ = run_guards(j.guards); each(more)
            end
        end;
    each(ss);

let sweep_parked(ss : Lst(Slot)) -> Lst(Slot) =
    rec each(rest : Lst(Slot)) -> Lst(Slot) =
        match rest
        | [] => Lst/nil()
        | [s, ..more] =>
            match Cell/get(s)
            | none() => each(more)
            | some(j) =>
                match is_cancelled(j.token)
                | true => let _ = run_guards(j.guards); let _ = Cell/set(s, Option/none()); each(more)
                | false => Lst/cons(s, each(more))
                end
            end
        end;
    each(ss);

let is_ready(results : Nat, interest : Nat) -> Bool =
    Nat/and(results, Nat/or(Nat/or(interest, /sys/Poll/err), /sys/Poll/hup)) > 0;

let poll_ready(blocked : Lst(Parked), timeout : Int) -> {Lst(Job), Lst(Parked)} =
    let handles = Lst/map(blocked, (p : Parked) => p.handle);
    let events = Lst/map(blocked, (p : Parked) => p.interest);
    let results = /sys/poll(handles, events, timeout);
    rec walk(rest : Lst(Parked), i : Nat, woken : Lst(Job), still : Lst(Parked)) -> {Lst(Job), Lst(Parked)} =
        match rest
        | [] => (woken, still)
        | [p, ..tail] =>
            match is_cancelled(p.token)
            | true =>
                let _ = run_guards(p.guards);
                walk(tail, i + 1, woken, still)
            | false =>
                match is_ready(/sys/Lst/get(results, i), p.interest)
                | true => walk(tail, i + 1, Lst/cons(Job { resume = p.resume, token = p.token, guards = p.guards }, woken), still)
                | false => walk(tail, i + 1, woken, Lst/cons(p, still))
                end
            end
        end;
    walk(blocked, 0, Lst/nil(), Lst/nil());

let sleep_timeout(sleeping : Lst(Sleeper)) -> Int =
    rec earliest(rest : Lst(Sleeper), best : Option(Duration)) -> Option(Duration) =
        match rest
        | [] => best
        | [s, ..more] =>
            match best
            | none() => earliest(more, Option/some(s.due))
            | some(b) =>
                match Duration/before(s.due, b)
                | true => earliest(more, Option/some(s.due))
                | false => earliest(more, best)
                end
            end
        end;
    match earliest(sleeping, Option/none())
    | none() => -1
    | some(due) =>
        let remaining = Duration/sub(due, Duration/now());
        let whole = Duration/to_millis(remaining);
        match Duration/nanos(remaining) % 1000000 > 0
        | true => Nat/to_int(whole + 1)
        | false => Nat/to_int(whole)
        end
    end;

let expire_sleepers(sleeping : Lst(Sleeper)) -> {Lst(Job), Lst(Sleeper)} =
    let now = Duration/now();
    rec walk(rest : Lst(Sleeper), woken : Lst(Job), still : Lst(Sleeper)) -> {Lst(Job), Lst(Sleeper)} =
        match rest
        | [] => (woken, still)
        | [s, ..tail] =>
            match is_cancelled(s.token)
            | true =>
                let _ = run_guards(s.guards);
                walk(tail, woken, still)
            | false =>
                match Duration/before(now, s.due)
                | true => walk(tail, woken, Lst/cons(s, still))
                | false => walk(tail, Lst/cons(Job { resume = s.resume, token = s.token, guards = s.guards }, woken), still)
                end
            end
        end;
    walk(sleeping, Lst/nil(), Lst/nil());

-- No runnable job, nothing blocked on a handle, and no sleeper: the root can
-- never be fulfilled. Nominal and empty — it records that the fact occurred,
-- and leaves room to carry a diagnostic later without changing how callers match.
pub struct Deadlock : pub Type {}

pub let block_on(@A : Type, root : Async(A)) -> Result(A, Deadlock) =
    let runq = Cell/new(Lst/nil());
    let blocked = Cell/new(Lst/nil());
    let sleeping = Cell/new(Lst/nil());
    let parked = Cell/new(Lst/nil());
    let result = Cell/new(Option/none(@A));
    let enqueue(j : Job) -> {} =
        Cell/set(runq, Lst/cons(j, Cell/get(runq)));
    let _ = enqueue(Job {
        resume = () => bind(root, (a) =>
            let _ = Cell/set(result, Option/some(a));
            pure(())),
        token = Token { Cell/new(false) },
        guards = Lst/nil()
    });
    rec serve(job : Job) -> {} =
        match is_cancelled(job.token)
        | true => run_guards(job.guards)
        | false =>
            match job.resume()
            | done(_) => run_guards(job.guards)
            | step(p, k) =>
                match p
                | wait(h, ev) =>
                    Cell/set(blocked, Lst/cons(Parked { handle = h, interest = ev, resume = k, token = job.token, guards = job.guards }, Cell/get(blocked)))
                | sleep(d) =>
                    Cell/set(sleeping, Lst/cons(Sleeper { due = Duration/add(Duration/now(), d), resume = k, token = job.token, guards = job.guards }, Cell/get(sleeping)))
                | fork(child, ct) =>
                    let _ = enqueue(Job { ..job, resume = k });
                    enqueue(Job { resume = child, token = ct, guards = Lst/nil() })
                | park(reg) =>
                    let slot = Cell/new(Option/some(@Job, Job { ..job, resume = k }));
                    let _ = Cell/set(parked, Lst/cons(slot, Cell/get(parked)));
                    let waker() -> {} =
                        match Cell/get(slot)
                        | none() => ()
                        | some(j) =>
                            let _ = Cell/set(slot, Option/none());
                            enqueue(j)
                        end;
                    reg(Waker/new(waker))
                | acquire(h, fin) =>
                    serve(Job { ..job, resume = k, guards = Lst/cons(Guard { handle = h, release = fin }, job.guards) })
                | release(h) =>
                    serve(Job { ..job, resume = k, guards = release_guard(h, job.guards) })
                | defer() =>
                    serve(Job { ..job, resume = k })
                | yield_now() =>
                    enqueue(Job { ..job, resume = k })
                end
            end
        end;
    let drain_all() -> {} =
        let _ = drain_jobs(Cell/get(runq));
        let _ = drain_parked(Cell/get(blocked));
        let _ = drain_sleeping(Cell/get(sleeping));
        drain_slots(Cell/get(parked));
    rec drive() -> Result(A, Deadlock) =
        match Cell/get(result)
        | some(a) =>
            let _ = drain_all();
            Result/success(a)
        | none() =>
            match Cell/get(runq)
            | [] =>
                let _ = Cell/set(parked, sweep_parked(Cell/get(parked)));
                match Lst/len(Cell/get(blocked)) == 0 && Lst/len(Cell/get(sleeping)) == 0
                | false =>
                    let split = poll_ready(Cell/get(blocked), sleep_timeout(Cell/get(sleeping)));
                    let woken = expire_sleepers(Cell/get(sleeping));
                    let _ = Cell/set(runq, [..split.0, ..woken.0]);
                    let _ = Cell/set(blocked, split.1);
                    let _ = Cell/set(sleeping, woken.1);
                    drive()
                | true =>
                    -- Deadlock: no runnable job, nothing blocked on a handle, and
                    -- no sleeper — the root can never be fulfilled, so there is no
                    -- `A` to return. Reported to the caller; terminating the
                    -- process is `run`'s decision, not the scheduler's.
                    let _ = drain_all();
                    Result/failure(Deadlock {})
                end
            | [job, ..rest] =>
                let _ = Cell/set(runq, rest);
                let _ = serve(job);
                drive()
            end
        end;
    drive();

pub let run(main : Async({})) -> {} =
    match block_on(main)
    | success(_) => ()
    | failure(_) =>
        let _ = /std/print_err("async: deadlocked, no runnable work remains\n");
        /sys/exit(1)
    end;

pub struct Task(A : Type) : Type {
    result : Future(A),
    token : Token
}

pub let spawn(@A : Type, body : () -> Async(A)) -> Async(Task(A)) =
    defer(() =>
        let f = Future/new();
        let t = Token { Cell/new(false) };
        let task : Task(A) = Task { result = f, token = t };
        bind(fork_with(() => bind(body(), (a) => let _ = Future/fulfill(f, a); pure(())), t), (_) =>
            pure(task)));

pub let join(@A : Type, task : Task(A)) -> Async(A) =
    await(task.result);

pub let cancel(@A : Type, task : Task(A)) -> {} =
    cancel_token(task.token);

let cancel_all(ts : Lst(Token)) -> {} =
    Lst/each(ts, cancel_token);

pub let join_all(@A : Type, tasks : Lst(() -> Async(A))) -> Async(Lst(A)) =
    rec go(i : Nat) -> Async(Lst(A)) =
        match Nat/try_lt(i, Lst/len(tasks))
        | none() => pure(Lst/nil())
        | some(ok) =>
            let h = spawn(Lst/at(tasks, i, ok))!;
            let rest = go(i + 1)!;
            let a = join(h)!;
            pure(Lst/cons(a, rest))
        end;
    go(0);

pub let select(@A : Type, tasks : Lst(() -> Async(A))) -> Async({Nat, A}) =
    defer(() =>
        let winner = Future/new();
        rec arm(i : Nat) -> Async(Lst(Token)) =
            match Nat/try_lt(i, Lst/len(tasks))
            | none() => pure(Lst/nil())
            | some(ok) =>
                let t = Token { Cell/new(false) };
                let _ = fork_with(() => bind((Lst/at(tasks, i, ok))(), (a) => let _ = Future/fulfill(winner, (i, a)); pure(())), t)!;
                let rest = arm(i + 1)!;
                pure(Lst/cons(t, rest))
            end;
        let tokens = arm(0)!;
        let w = await(winner)!;
        let _ = cancel_all(tokens);
        pure(w));

pub let race(@A : Type, tasks : Lst(() -> Async(A))) -> Async(A) =
    bind(select(tasks), (w) => pure(w.1));

pub let timeout(@A : Type, d : Duration, body : () -> Async(A)) -> Async(Option(A)) =
    map(select(@Option(A), [
        () => map(body(), (a) => Option/some(a)),
        () => map(sleep(d), (_) => Option/none()),
    ]), (w) => w.1);

satisfy Monad(Async) {
    pure(x) = pure(x),
    bind(m, f) = bind(m, f)
}
