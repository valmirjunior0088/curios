-- The pure path algebra: bytes underneath, `/` as the one separator, and the functions a listing entry or a specification needs.
use /std/{Str, Option, Path, Test};

let p(s: Str) -> Path =
    Path/of_str(s);

-- A join never doubles the separator and never invents one, and an empty side is the other side.
test join_never_doubles_the_separator() =
    Test/all([
        Test/equal(Path/join(p("a/"), p("b")), p("a/b")),
        Test/equal(Path/join(p("a"), p("b")), p("a/b")),
        Test/equal(Path/join(p(""), p("b")), p("b"))]);

-- The name is the last component, and the parent is everything before the last separator: `none` for a bare name, and the root itself for a child of the root.
test name_and_parent_split_on_the_last_separator() =
    Test/all([
        Test/equal(Path/name(p("a/b/c.txt")), p("c.txt")),
        Test/equal(Path/parent(p("a/b/c")), Option/some(p("a/b"))),
        Test/equal(Path/parent(p("c")), Option/none()),
        Test/equal(Path/parent(p("/c")), Option/some(p("/")))]);

-- The extension is what follows the last `.` of a name that does not start with one.
test the_extension_follows_the_last_dot_of_a_name() =
    Test/all([
        Test/equal(Path/extension(p("archive.tar.gz")), Option/some(p("gz"))),
        Test/equal(Path/extension(p(".bashrc")), Option/none()),
        Test/equal(Path/extension(p("noext")), Option/none())]);

-- A path is bytes, so a name that is not UTF-8 is a path like any other: it joins, splits and compares, and only `to_str` refuses it.
test a_path_that_is_not_utf8_is_a_path_like_any_other() =
    let odd = Path/of_bytes(x[0xFF, 'a']);
    let full = Path/join(p("dir"), odd);
    let decodes = match Path/to_str(odd) | some(_) => "text" | none() => "bytes" end;
    Test/all([
        Test/equal(Path/name(full), odd),
        Test/equal(decodes, "bytes"),
        Test/equal(Path/parent(full), Option/some(p("dir")))]);
