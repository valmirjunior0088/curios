-- The binary naturals `/std/BigNat` was until `Nat` became unbounded at run time: a trimmed word of `Bits` beside its certificate, each operation a facade with its laws proved beneath it. Kept because its proofs are the heaviest the checkers meet — recursion that descends on either of two words, packed-literal views, a refinement over a packed carrier — and the tests at its end run the arithmetic those proofs are about.
use /std/{Nat, Bool, Bits, Eq, Str, Option, Ordering, Test};
use /std/Bits/{nonempty};
use /std/Bool/{false_neq_true};

--- Whether `bits` has no redundant high zero bit.
pub let is_trimmed(bits: Bits) -> Bool =
    match bits
    | b[] => true
    | b[head, ..tail]; ih => match tail | b[] => head | b[_, .._] => ih end
    end;

--- The proposition that `bits` is trimmed.
pub let Canonical(bits: Bits) -> Prop =
    Bool/Holds(is_trimmed(bits));

--- `t` with `head` as a new low bit, trimmed: `combine(false, b[])` is `b[]`.
pub let combine(head: Bool, t: Bits) -> Bits =
    match t
    | b[] => match head | true => b[head] | false => b[] end
    | b[_, .._] => b[head, ..t]
    end;

--- `bits` with its redundant high zero bits removed.
pub let trim(bits: Bits) -> Bits =
    match bits | b[] => b[] | b[head, .._]; ih => combine(head, ih) end;

let combine_is_trimmed(
    head: Bool,
    t: Bits,
    p: Eq(is_trimmed(t), true),
) -> Eq(is_trimmed(combine(head, t)), true) =
    match t
    | b[] => match head | true => Eq/refl() | false => Eq/refl() end
    | b[_, .._] => p
    end;

-- `combine` is a cons wherever its tail is nonempty, which is the only case a caller holding a length can be in.
--
-- **It decides on the tail's shape where a caller may know only its length.** A run built in one operation over a symbolic count — `mul/pow2`'s fill of zero bits — exposes no leading generator, so the match below stays stuck on it while `Bits/len` still answers: a length composes through a concatenation symbolically, a first generator does not. Proved once over an abstract tail, this applies to a tail no eliminator can take apart, which is what lets the flat fill meet the `dbl` spine it replaced. The same move `/std/Bytes`'s `head` and `tail` make, guarding on a length where a match would not serve.
let combine_cons(
    head: Bool,
    t: Bits,
    p: Nat/Lt(0, Bits/len(t)),
) -> Eq(combine(head, t), b[head, ..t]) =
    match t
    | b[] => match p end
    | b[_, .._] => Eq/refl()
    end;

--- `trim` answers a trimmed word.
pub let trim_is_trimmed(bits: Bits) -> Eq(is_trimmed(trim(bits)), true) =
    match bits
    | b[] => Eq/refl()
    | b[head, ..tail]; ih => combine_is_trimmed(head, trim(tail), ih)
    end;

let canonical_of_is_trimmed(bits: Bits, p: Eq(is_trimmed(bits), true)) -> Canonical(bits) =
    Eq/subst(Bool/Holds, Eq/sym(p), Bool/True/qed());

let canonical_of_trim(bits: Bits) -> Canonical(trim(bits)) =
    canonical_of_is_trimmed(trim(bits), trim_is_trimmed(bits));

--- A trimmed word beside its certificate.
pub struct BigNat: pub Type {
    bits: Bits,
    canonical: Canonical(bits),
}

--- The number a word denotes, trimmed on the way in.
pub let of_bits(bits: Bits) -> BigNat =
    BigNat { bits = trim(bits), canonical = canonical_of_trim(bits) };

--- A number as zero, or a low bit over the rest.
pub induct View: pub Type
--- Nothing left.
| zero()
--- A low bit, and the rest above it.
| succ(low: Bool, tail: BigNat)
end

let tail_is_trimmed(
    head: Bool,
    tail: Bits,
    p: Eq(is_trimmed(b[head, ..tail]), true),
) -> Eq(is_trimmed(tail), true) =
    match tail | b[] => Eq/refl() | b[_, .._] => p end;

--- The certificate as a decided equation.
pub let is_trimmed_of_canonical(bits: Bits, c: Canonical(bits)) -> Eq(is_trimmed(bits), true) =
    match is_trimmed(bits): (r) => Eq(r, true)
    | true => Eq/refl()
    | false => match c end
    end;

--- The number of a word already known to be trimmed, with no trim spent.
pub let of_trimmed_bits(bits: Bits, p: Eq(is_trimmed(bits), true)) -> BigNat =
    BigNat { bits = bits, canonical = canonical_of_is_trimmed(bits, p) };

--- `a` as zero, or its low bit over the rest.
pub let view(a: BigNat) -> View =
    match a.bits
    | b[] => View/zero()
    | b[head, ..tail] =>
        View/succ(
            head,
            of_trimmed_bits(
                tail,
                tail_is_trimmed(head, tail, is_trimmed_of_canonical(a.bits, a.canonical))))
    end;

let refl_at(@A: Type, x: A) -> Eq(x, x) =
    Eq/refl();

--- Zero.
pub let zero: BigNat =
    of_bits(b[]);

--- Whether `a` is zero.
pub let is_zero(a: BigNat) -> Bool =
    match view(a) | zero() => true | succ(_, _) => false end;

let dbl_raw(x: Bits) -> Bits =
    b[0, ..x];

let dbl(a: BigNat) -> BigNat =
    of_trimmed_bits(
        combine(false, a.bits),
        combine_is_trimmed(false, a.bits, is_trimmed_of_canonical(a.bits, a.canonical)));

let dbl_succ(a: BigNat) -> BigNat =
    of_trimmed_bits(
        combine(true, a.bits),
        combine_is_trimmed(true, a.bits, is_trimmed_of_canonical(a.bits, a.canonical)));

--- The number `n` denotes.
pub let of_nat(n: Nat) -> BigNat =
    match n == 0
    | true => zero
    | false =>
        let tail = of_nat(n / 2);
        of_trimmed_bits(
            combine(n % 2 == 1, tail.bits),
            combine_is_trimmed(
                n % 2 == 1,
                tail.bits,
                is_trimmed_of_canonical(tail.bits, tail.canonical)))
    end;

--- The sum bit of a full adder.
pub let xor3(a: Bool, b: Bool, c: Bool) -> Bool =
    match a
    | true =>
        match b
        | true => c
        | false => match c | true => false | false => true end
        end
    | false =>
        match b
        | true => match c | true => false | false => true end
        | false => c
        end
    end;

--- The carry bit of a full adder.
pub let maj3(a: Bool, b: Bool, c: Bool) -> Bool =
    match a
    | true => match b | true => true | false => c end
    | false => match b | true => c | false => false end
    end;

--- Eql words are equal numbers.
pub let eq(a: BigNat, b: BigNat, p: Eq(a.bits, b.bits)) -> Eq(a, b) =
    Eq/subst(
        (r: Bits) => (c: Canonical(r)) -> Eq(a, BigNat { bits = r, canonical = c }),
        p,
        (_: Canonical(a.bits)) => Eq/refl())(b.canonical);

--- Congruence of `combine` in its tail.
pub let cong_combine(h: Bool, @s: Bits, @t: Bits, p: Eq(s, t)) -> Eq(combine(h, s), combine(h, t)) =
    Eq/cong((w) => combine(h, w), p);

let cong_bits(@s: BigNat, @t: BigNat, p: Eq(s, t)) -> Eq(s.bits, t.bits) =
    Eq/cong((n: BigNat) => n.bits, p);

let cong_is_trimmed(@s: Bits, @t: Bits, p: Eq(s, t)) -> Eq(is_trimmed(s), is_trimmed(t)) =
    Eq/cong(is_trimmed, p);

let is_trimmed_cons(
    head: Bool,
    u: Bits,
    pt: Eq(is_trimmed(u), true),
    pn: Eq(nonempty(u), true),
) -> Eq(is_trimmed(b[head, ..u]), true) =
    match u
    | b[] => match false_neq_true(pn) end
    | b[_, .._] => pt
    end;

--- A trimmed word is its own trim.
pub let trim_of_trimmed(x: Bits, p: Eq(is_trimmed(x), true)) -> Eq(trim(x), x) =
    match x
    | b[] => Eq/refl()
    | b[h, ..t] =>
        match t
        | b[] =>
            match h
            | true => Eq/refl()
            | false => match false_neq_true(p) end
            end
        | b[th, ..tt] => cong_combine(h, trim_of_trimmed(b[th, ..tt], p))
        end
    end;

--- Addition, with its laws beneath.
pub mod add;
pub use add/{let add};

--- The successor, with its laws beneath.
pub mod succ;
pub use succ/{let succ};

--- Comparison, with its laws beneath.
pub mod ord;
pub use ord/{let ord};

--- Multiplication, with its laws beneath.
pub mod mul;
pub use mul/{let mul};

--- Subtraction, truncated at zero.
pub mod sub;
pub use sub/{let sub};

mod parity;
pub use parity/{is_even, div2, shr};

mod convert;
pub use convert/{to_str, bit_len, is_decimal, Decimal, of_decimal, of_str};

-- `add` propagates carry along the binary numeral: 99_999_999 ends in eight set bits, so adding 1 ripples the carry through all of them — the `pos_add`/`pos_add_c` twin recursion — before it lands.
test add_ripples_carry =
    Test/equal(add(of_decimal("99999999"), of_nat(1)), of_decimal("100000000"));

-- `sub` runs the mask-based borrow recursion: 100_000_000 ends in eight clear bits, so subtracting 1 borrows through all of them. The result is canonical by construction — no trailing-zero cleanup exists to get wrong.
test sub_borrows =
    Test/equal(sub(of_decimal("100000000"), of_nat(1)), of_decimal("99999999"));

-- `mul/small` is `mul` against a decoded native operand: 9999 * 99999 crosses well past both inputs' bit widths, so every carry of the shift-and-add recursion has to land.
test mul_small_propagates_carry =
    Test/equal(mul/small(of_nat(9999), 99999), of_decimal("999890001"));

-- Full big-by-big `mul`: the product needs 57 bits, so a correct result proves it lives in the numeral itself and never in a fixed-width intermediate.
test mul_crosses_word_width =
    Test/equal(mul(of_decimal("123456789"), of_decimal("987654321")), of_decimal("121932631112635269"));

-- `mul/pow2` doubles by prepending low bits to the numeral: 2^40 is a run of forty zeros under a one.
test mul_pow2_builds_large_powers =
    Test/equal(mul/pow2(of_nat(1), 40), of_decimal("1099511627776"));

-- `div2` drops the low bit in O(1) and `is_even` reads it: 101 is odd and floor-halves to 50, which is even.
test div2_and_parity =
    let n = of_nat(101);
    Test/all([
        Test/equal(div2(n), of_nat(50)),
        Test/assert(Bool/not(is_even(n))),
        Test/assert(is_even(div2(n)))]);

-- `bit_len` is the numeral's length: zero has no bits, 1 is a single bit, and the 255 → 256 step is where the count grows from 8 to 9.
test bit_len_counts_binary_digits =
    Test/equal(
        [bit_len(zero), bit_len(of_nat(1)), bit_len(of_nat(255)), bit_len(of_nat(256))],
        [0, 1, 8, 9]);

-- `ord` lets the high bits decide — the recursion on the numeral tails — breaking ties on the low bit only afterward, so two values differing only in the lowest bit still order correctly.
test ord_orders_by_magnitude =
    let a = of_nat(12345678);
    let b = of_nat(12345679);
    Test/equal([ord(a, b), ord(a, a), ord(b, a)], [Ordering/lt(), Ordering/eq(), Ordering/gt()]);

-- Zero is the empty word, which `to_str` renders as "0" and not the empty string, and a value with clear low bits round-trips through the binary long division that produces the decimal digits.
test zero_renders_and_roundtrips =
    Test/equal(Str/join("/", [to_str(zero), to_str(of_nat(70000))]), "0/70000");

-- The decimal parser is the inverse of the renderer on everything the renderer writes.
test of_str_inverts_to_str =
    let big = mul(of_decimal("123456789"), of_decimal("987654321"));
    Test/all([
        Test/equal(of_str(to_str(big)), Option/some(big)),
        Test/equal(of_str(to_str(zero)), Option/some(zero)),
        Test/equal(of_str(""), Option/none()),
        Test/equal(of_str("12x"), Option/none())]);
