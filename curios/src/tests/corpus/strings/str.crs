-- The `Str` surface: stepping, cutting and trimming at character boundaries.
use /std/{Str, Char, Nat, Bool, Option, Show, Test};

-- A position steps over one character of any width: `a€😀` is a 1-byte, a 3-byte and a 4-byte scalar, so `next` reads U+0061, U+20AC and U+1F600, lands at offset 8, and there is nothing past it. Each step's bound — that there is a character at the position — discharges by reduction at a literal.
test next_steps_over_codepoints_of_every_width =
    let s = "a€😀";
    let first = Str/At/next(s, Str/At/start(s));
    let second = Str/At/next(s, first.past);
    let third = Str/At/next(s, second.past);
    Test/equal(
        Str/join(",", [
            Nat/to_str(Str/len(s)),
            Nat/to_str(Char/to_nat(first.char)),
            Nat/to_str(Char/to_nat(second.char)),
            Nat/to_str(Char/to_nat(third.char)),
            Nat/to_str(Str/At/to_offset(third.past)),
            Bool/to_str(Option/is_none(Str/At/try_next(s, third.past)))]),
        "3,97,8364,128512,8,true");

-- A position steps back over one character of any width: from the end of `a€😀`, `prev` reads the same three scalars in reverse and lands on each one's first byte, and there is nothing before the start.
test prev_steps_back_over_codepoints_of_every_width =
    let s = "a€😀";
    let third = Str/At/prev(s, Str/At/finish(s));
    let second = Str/At/prev(s, third.past);
    let first = Str/At/prev(s, second.past);
    Test/equal(
        Str/join(",", [
            Nat/to_str(Char/to_nat(third.char)),
            Nat/to_str(Str/At/to_offset(third.past)),
            Nat/to_str(Char/to_nat(second.char)),
            Nat/to_str(Str/At/to_offset(second.past)),
            Nat/to_str(Char/to_nat(first.char)),
            Nat/to_str(Str/At/to_offset(first.past)),
            Bool/to_str(Option/is_none(Str/At/try_prev(s, first.past)))]),
        "128512,4,8364,1,97,0,true");

-- A braced escape names a scalar no keyboard types: `"e\u{301}"` is two scalars, the `e` and the combining acute accent, and reads back as the accented letter it composes. `\u` without a brace is the two characters it always was.
test a_braced_escape_names_a_scalar =
    let s = "é";
    let accent = Str/At/next(s, Str/At/next(s, Str/At/start(s)).past);
    Test/equal(
        Str/join(",", [
            Nat/to_str(Str/len(s)),
            Nat/to_str(Char/to_nat(accent.char)),
            "e\\u",
            Str/of_char('😀')]),
        "2,769,e\\u,😀");

-- A cut between two positions is whole characters, since a position is where one begins: offsets 1 and 4 of `a€😀` hold the whole 3-byte euro sign, and offset 2, inside it, is no position at all.
test between_cuts_on_codepoint_boundaries =
    let s = "a€😀";
    Test/equal(
        Str/join(",", [
            Str/between(s, Str/At/of_offset(s, 1), Str/At/of_offset(s, 4)),
            Bool/to_str(Option/is_none(Str/At/try_of_offset(s, 2)))]),
        "€,true");

-- An interior cut over a mixed-width string: past the leading `a` and before the trailing `b`, the three scalars of widths 2, 3 and 4 are one piece.
test between_spans_every_codepoint_width =
    let s = "aé€😀b";
    Test/equal(Str/between(s, Str/At/of_offset(s, 1), Str/At/of_offset(s, 10)), "é€😀");

-- `Str/trim` strips only leading and trailing ASCII whitespace, leaving an interior multibyte scalar intact.
test trim_keeps_interior_multibyte =
    Test/equal(Str/trim("  café  "), "café");

-- An all-whitespace string trims to empty: `trim_start` finds no character to keep, and what it answers then is the empty text.
test trim_all_whitespace_is_empty =
    Test/equal(Str/concat(Str/trim(" \t "), "!"), "!");

-- Folding, searching and case-folding all travel in certified `Char`s: the fold rebuilds the string scalar by scalar, a search answers the position a scalar begins at — read here as its byte offset — and ASCII case folding leaves a non-ASCII scalar alone.
test logical_operations_use_certified_chars =
    let s = "a€😀";
    Test/equal(
        Str/join("|", [
            Str/fold(s, "", (c, acc) => Str/concat(acc, Show/show(c))),
            Show/show(Str/At/next(s, Str/At/of_offset(s, 1)).char),
            Nat/to_str(
                Option/unwrap_or(
                    Option/map(Str/index_of(s, '€'), (at) => Str/At/to_offset(at)),
                    99)),
            Nat/to_str(
                Option/unwrap_or(
                    Option/map(
                        Str/find_index(s, (c) => Char/to_nat(c) > 0xFFFF),
                        (at) => Str/At/to_offset(at)),
                    99)),
            Show/show('😀'),
            Bool/to_str(Str/eql_ascii_ci("AbÉ", "aBÉ")),
            Bool/to_str(Str/eql_ascii_ci("É", "é")),
            Nat/to_str(Str/len(s)),
            Str/between(s, Str/At/of_offset(s, 1), Str/At/of_offset(s, 4))]),
        "a€😀|€|1|4|😀|true|false|3|€");
