-- Taking a `Str` apart: splitting, searching, replacing and escaping, trimming one end, padding, and the scalar list.
use /std/{Str, Char, Nat, Bool, List, Option, Eq, Test};

-- The separator is a two-byte scalar and two of them sit side by side, so the split has to advance by scalar and hand back the empty piece between them; joining the pieces on the separator is the identity.
test split_advances_by_scalar_and_keeps_empty_pieces =
    let parts = Str/split("a€€b€c", "€");
    Test/equal(
        Str/join(" ", [
            Str/join("|", parts),
            Bool/to_str(Str/join("€", parts) == "a€€b€c"),
            Str/join("|", Str/split("héj", "")),
            Str/join("|", Str/split("abc", "x"))]),
        "a||b|c true h|é|j abc");

test split_once_takes_the_first_occurrence_and_contains_reads_it =
    let first =
        match Str/split_once("key=value=x", "=")
        | some((k, v)) => Str/flatten(["(", k, ")(", v, ")"])
        | none() => "none"
        end;
    let missing = match Str/split_once("plain", "=") | some(_) => "some" | none() => "none" end;
    Test/equal(
        Str/join(" ", [
            first,
            missing,
            Bool/to_str(Str/has_substr("hello", "ell")),
            Bool/to_str(Str/has_substr("hello", "elo")),
            Bool/to_str(Str/has_substr("hello", ""))]),
        "(key)(value=x) none true false true");

-- `"a\r\nb\n"` is two lines: the carriage return is stripped and the final terminator closes `b` rather than opening a third, empty line. `""` has no lines at all.
test lines_drop_the_carriage_return_and_the_final_terminator =
    let render(ls: List(Str)) -> Str =
        Str/flatten(List/map(ls, (l: Str) => Str/flatten(["[", l, "]"])));
    Test/equal(
        Str/join(" ", [
            render(Str/lines("a\r\nb\n")),
            render(Str/lines("solo")),
            Nat/to_str(List/len(Str/lines("")))]),
        "[a][b] [solo] 0");

-- Both comparisons take scalar windows: `hé` is three bytes and two scalars. A suffix longer than the string is refused, and the empty string is a prefix and a suffix of everything.
test starts_with_and_ends_with_compare_scalar_windows =
    Test/equal(
        Str/join(" ", [
            Bool/to_str(Str/starts_with("héllo", "hé")),
            Bool/to_str(Str/starts_with("héllo", "hi")),
            Bool/to_str(Str/ends_with("héllo", "llo")),
            Bool/to_str(Str/ends_with("lo", "héllo")),
            Bool/to_str(Str/starts_with("", "")),
            Bool/to_str(Str/ends_with("x", ""))]),
        "true false true false true true");

-- `aaa` with `a` replaced by `aa` doubles once: the replacement is never rescanned, so the result is six characters rather than unbounded growth. An empty pattern occurs nowhere.
test replace_substitutes_every_occurrence_without_rescanning =
    Test/equal(
        Str/join(" ", [
            Str/replace("aaa", "a", "aa"),
            Str/replace("a-b-c", "-", "€"),
            Str/replace("abc", "", "x"),
            Str/replace("abc", "z", "x")]),
        "aaaaaa a€b€c abc abc");

test padding_widens_to_the_count_and_trimming_one_end_keeps_the_other =
    Test/equal(
        Str/join("|", [
            Str/pad_start("7", 3, '0'),
            Str/pad_end("ab", 4, '.'),
            Str/pad_start("long", 2, '-'),
            Str/pad_start("é", 3, 'é'),
            Str/trim_start("  x  "),
            Str/trim_end("  x  "),
            Str/trim_start("   ")]),
        "007|ab..|long|ééé|x  |  x|");

test to_list_yields_the_scalars_and_of_char_encodes_one =
    let chars = Str/to_list("a€😀");
    Test/equal(
        Str/join(" ", [
            Nat/to_str(List/len(chars)),
            Str/flatten(List/map(chars, Str/of_char)),
            Bool/to_str(Str/of_char('€') == "€")]),
        "3 a€😀 true");

-- An escape replaces only the characters its table answers for and copies the runs between as the pieces they are: a multi-byte character passes untouched, a replacement may open, close or follow another, and a table that answers for nothing gives the text back.
test escape_replaces_chosen_characters_and_copies_the_runs_between =
    let marked(c: Char) -> Option(Str) =
        match Char/to_nat(c)
        | '"' => Option/some("\\\"")
        | '€' => Option/some("EUR")
        | _ => Option/none()
        end;
    Test/equal(
        Str/join("|", [
            Str/escape("\"a€b😀\"", marked),
            Str/escape("€€", marked),
            Str/escape("", marked),
            Str/escape("héllo", (_) => Option/none())]),
        "\\\"aEURb😀\\\"|EUREUR||héllo");

-- Every walk here moves between positions through `Str/At/forward` or `backward`, each step handing over the proof that it moved, so every one is total and computes in a type: a claim about what they answer is a proof the kernel discharges, and one that stopped terminating would be refused where it is stated rather than tested.
let _splits_in_a_type: Eq()(Str/split("a€€b€c", "€"), ["a", "", "b", "c"]) =
    Eq/refl();

let _splits_once_in_a_type: Eq()(Str/split_once("key=value=x", "="), Option/some(("key", "value=x"))) =
    Eq/refl();

let _reads_lines_in_a_type: Eq()(Str/lines("a\r\nb\n"), ["a", "b"]) =
    Eq/refl();

let _replaces_in_a_type: Eq()(Str/replace("a€b€", "€", "-"), "a-b-") =
    Eq/refl();

let _trims_in_a_type: Eq()(Str/trim(" \té \n"), "é") =
    Eq/refl();

let _strips_in_a_type: Eq()(Str/strip_suffix("héllo", "llo"), Option/some("hé")) =
    Eq/refl();
