-- Choosing a subcommand by the first token, refusing a name that is not there, and the `Commands:` section a group's help grows. A group takes no arguments of its own, which is why it is a shape of its own rather than a leaf that happens to declare none.
use /std/{Cli, Str, Option, List, Test};

let add: Cli =
    Cli/leaf(
        "add",
        "Add a dependency",
        Option/none(),
        [Cli/positional("name", Cli/str, "What to add")],
        (_) => /std/print("never"));

let remove: Cli =
    Cli/leaf(
        "remove",
        "Remove a dependency",
        Option/none(),
        [Cli/positional("name", Cli/str, "What to remove")],
        (_) => /std/print("never"));

let app: Cli =
    Cli/group("deps", "Manage dependencies", Option/some("0.1.0"), [add, remove]);

let chose(argv: List(Str)) -> Str =
    match Cli/select(app, argv)
    | wanted_help() => "help"
    | wanted_version() => "version"
    | refused(f) => Cli/report([], app, f)
    | chose(sub, rest) => Str/flatten([Cli/name(sub), "(", Str/join(",", rest), ")"])
    end;

-- Either child, chosen by the first token, with everything after it left for that child to parse.
test the_first_token_chooses_the_subcommand_and_the_rest_is_its_line =
    Test/all([
        Test/equal(chose(["add", "curios"]), "add(curios)"),
        Test/equal(chose(["remove", "curios", "--force"]), "remove(curios,--force)")]);

-- A group owns exactly its first token. `--help` and `--version` are answered here only when they *are* that token; past a subcommand's name they are the subcommand's line, so `add --help` chooses `add` and hands the request to it rather than answering for the parent.
test a_group_answers_only_for_its_own_first_token =
    Test/all([
        Test/equal(chose(["--help"]), "help"),
        Test/equal(chose(["--version"]), "version"),
        Test/equal(chose(["add", "--help"]), "add(--help)")]);

-- Neither a name that is not there nor no name at all: both refuse, and both list what there is.
test an_unknown_or_absent_subcommand_lists_the_ones_there_are =
    Test/all([
        Test/assert(Str/has_substr(chose(["push"]), "unrecognized subcommand 'push'")),
        Test/assert(Str/has_substr(chose(["push"]), "available: add, remove")),
        Test/assert(Str/has_substr(chose([]), "a subcommand is required")),
        Test/assert(Str/has_substr(chose([]), "available: add, remove"))]);

-- A parent's usage names `<COMMAND>` rather than options it does not have, and its help grows the section its children fill.
test a_parents_help_lists_its_children =
    Test/all([
        Test/equal(Cli/usage([], app), "Usage: deps <COMMAND>"),
        Test/assert(Str/has_substr(Cli/help([], app), "Commands:\n  add     Add a dependency\n")),
        Test/assert(Str/has_substr(Cli/help([], app), "  remove  Remove a dependency\n"))]);

-- A subcommand's usage names the commands that lead to it, so the line it prints is the line that reaches it, and the command's own name comes from the command rather than from its caller.
test a_subcommands_usage_names_the_path_that_reaches_it =
    Test/all([
        Test/equal(Cli/usage(["deps"], add), "Usage: deps add <NAME>"),
        Test/assert(Str/has_substr(Cli/help(["deps"], add), "\n\nUsage: deps add <NAME>\n\n"))]);
