-- The two screens a command answers with: the help the specification renders into, and the refusal a bad line prints. Both are `Str`, so what they are is what a test can compare.
use /std/{Cli, Str, Nat, Option, List, Test};

let serve: Cli =
    Cli {
        name = "serve",
        about = "Serve a directory over HTTP",
        version = Option/some("0.1.0"),
        args =
            [
                Cli/Arg { ..Cli/flag("verbose", "Log every request"), short = Option/some('v') },
                Cli/default("port", Cli/nat, 8080, "Port to listen on"),
                Cli/positional("root", Cli/str, "Directory to serve")],
        run(_) = /std/print("never"),
        commands = [],
    };

-- The layout the specification fixes, to the space: one description, a usage line naming the options bundle and every positional, then the sections, each padded to its own widest left column. `-h` and `--version` are rows because the entry answers them, not because the program declared them.
test help_renders_the_layout_the_specification_fixes() =
    Test/equal(
        Cli/help(serve),
        Str/flatten(
            [
                "Serve a directory over HTTP\n\n",
                "Usage: serve [OPTIONS] <ROOT>\n\n",
                "Arguments:\n",
                "  <ROOT>  Directory to serve\n\n",
                "Options:\n",
                "  -v, --verbose   Log every request\n",
                "      --port <N>  Port to listen on\n",
                "  -h, --help      Print help\n",
                "      --version   Print version\n\n"]));

-- A refusal names what went wrong, repeats the usage line, and points at `--help`; it never prints the whole help, which is what separates a mistake from a request.
test a_refusal_names_the_offender_and_points_at_help() =
    Test/equal(
        Cli/report(serve, Cli/Failure/unknown_option("--prot")),
        Str/flatten(
            [
                "error: unexpected argument '--prot'\n\n",
                "Usage: serve [OPTIONS] <ROOT>\n\n",
                "For more information, try '--help'.\n"]));

-- A command declaring no options gets no `[OPTIONS]`, and a `rest` entry is bracketed to say it collects rather than requires.
test the_usage_line_says_only_what_the_specification_declares() =
    let bare: Cli =
        Cli {
            name = "cat",
            about = "Concatenate",
            version = Option/none(),
            args = [Cli/rest("files", Cli/str, "The files")],
            run(_) = /std/print("never"),
            commands = [],
        };
    Test/equal(Cli/usage(bare), "Usage: cat [FILES]...");
