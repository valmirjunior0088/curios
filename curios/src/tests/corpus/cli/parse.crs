-- The token grammar, row by row: one specification, many lines. What each token reads as is the table `/std/Cli`'s header states, and every row of it is a case here.
use /std/{Cli, Str, Nat, Bool, Option, List, Test};

let spec: List(Cli/Arg) =
    [
        Cli/Arg { ..Cli/flag("verbose", "Log every request"), short = Option/some('v') },
        Cli/default("port", Cli/nat, 8080, "Port to listen on"),
        Cli/many("header", Cli/str, "Repeatable"),
        Cli/positional("root", Cli/str, "Directory to serve")];

let why(f: Cli/Failure) -> Str =
    match f
    | unknown_option(t) => Str/flatten(["unknown ", t])
    | missing_value(n) => Str/flatten(["missing value for ", n])
    | missing_required(n) => Str/flatten(["missing ", n])
    | unexpected(t) => Str/flatten(["unexpected ", t])
    | bad_value(n, r) => Str/flatten(["bad ", n, ": ", r])
    -- The subcommand refusals are `select`'s, never `parse`'s: a specification with children declares no arguments of its own.
    | _ => "not this parser's"
    end;

-- One rendering for every outcome, so a row's expectation is one string whichever way the line went.
let read(argv: List(Str)) -> Str =
    match Cli/parse(spec, argv, true)
    | help() => "help"
    | version() => "version"
    | failure(f) => why(f)
    | parsed(v) =>
        Str/join(" ", [
            Bool/to_str(Cli/get(v, "verbose")),
            Nat/to_str(Cli/get(v, "port")),
            Str/join(",", Cli/get(v, "header")),
            Cli/get(v, "root")])
    end;

test an_option_takes_the_next_token_or_the_one_glued_to_it() =
    Test/all([
        Test/equal(read(["--port", "9090", "/srv"]), "false 9090  /srv"),
        Test/equal(read(["--port=9090", "/srv"]), "false 9090  /srv")]);

-- A short cluster sets its flags; a repeated option keeps its last value while `many` keeps every one; an absent defaulted option stands in for itself.
test a_cluster_sets_flags_and_repetition_reads_by_kind() =
    Test/all([
        Test/equal(read(["-v", "/srv"]), "true 8080  /srv"),
        Test/equal(read(["--port", "1", "--port", "2", "/srv"]), "false 2  /srv"),
        Test/equal(read(["--header", "a", "--header", "b", "/srv"]), "false 8080 a,b /srv"),
        Test/equal(read(["/srv"]), "false 8080  /srv")]);

-- `--` ends the options, so a token that looks like one fills the positional instead.
test a_double_dash_makes_every_later_token_a_positional() =
    Test/equal(read(["--", "-weird"]), "false 8080  -weird");

-- Help is decided before the line is understood, so it answers over a line that would otherwise parse and over one that would otherwise fail.
test help_and_version_answer_before_any_other_reading() =
    Test/all([
        Test/equal(read(["--port", "1", "--help"]), "help"),
        Test/equal(read(["--prot", "--help"]), "help"),
        Test/equal(read(["--version"]), "version")]);

test each_failure_names_what_the_line_got_wrong() =
    Test/all([
        Test/equal(read(["--prot", "/srv"]), "unknown --prot"),
        Test/equal(read(["/srv", "--port"]), "missing value for port"),
        Test/equal(read([]), "missing root"),
        Test/equal(read(["a", "b"]), "unexpected b")]);

-- A reader refusing a value reports the reader's own reason, named against the entry that asked for it rather than against the token.
test a_reader_that_refuses_a_value_reports_its_own_reason() =
    let ported: List(Cli/Arg) = [Cli/option("port", Cli/nat, "Port to listen on")];
    Test/equal(
        match Cli/parse(ported, ["--port", "http"], false)
        | failure(f) => match f | bad_value(n, r) => Str/flatten([n, ": ", r]) | _ => "other" end
        | _ => "not a failure"
        end,
        "port: expected a number, found 'http'");
