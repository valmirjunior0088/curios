use /std/{Bin, Str, Nat, Bln, Io, Result, Option, Time, Arr, Task};

pub record Settings : Type {
    connect_timeout : Option(Time/Duration),
    read_timeout : Option(Time/Duration),
    write_timeout : Option(Time/Duration),
    tls : Bln
}

pub let default : Settings = Settings {
    connect_timeout = Option/none(),
    read_timeout = Option/none(),
    write_timeout = Option/none(),
    tls = false
};

pub struct Socket : Type { Io }

pub let read(c : Socket, n : Nat) -> Task(Io/Read) =
    Task/read(c.0, n);

pub let write(c : Socket, b : Bin) -> Task(Result({}, Io/Error)) =
    Task/write(c.0, b);

let configure(h : Io, settings : Settings) -> {} =
    let _ = /sys/Io/set_recv_timeout(h, Option/unwrap_or(Option/map(Time/to_millis, settings.read_timeout), 0));
    let _ = /sys/Io/set_send_timeout(h, Option/unwrap_or(Option/map(Time/to_millis, settings.write_timeout), 0));
    ();

let upgrade(h : Io, host : Str, tls : Bln) -> Nat =
    match tls : Nat
    | false => /sys/Io/Status/ok
    | true => /sys/Io/start_tls(h, Str/to_bin(host))
    end;

let resolve_addr(host : Str, port : Nat) -> Task(Result(Bin, Io/Error)) =
    let r = /sys/Io/lookup(Str/to_bin(host), port);
    match r.status == /sys/Io/Status/ok : Task(Result(Bin, Io/Error))
    | false => Task/pure(Result/failure(Io/error_of(r.status)))
    | true =>
        Task/using(r.handle, () => /sys/Io/close(r.handle),
            Task/bind(Task/wait(r.handle, /sys/Io/Poll/read), (_) =>
                let a = /sys/Io/resolve(r.handle);
                match a.status == /sys/Io/Status/ok : Task(Result(Bin, Io/Error))
                | false => Task/pure(Result/failure(Io/error_of(a.status)))
                | true => Task/pure(Result/success(Option/unwrap_or(Arr/get(a.addresses, 0), \\)))
                end))
    end;

let connect_addr(settings : Settings, host : Str, addr : Bin) -> Result(Socket, Io/Error) =
    let s = /sys/Io/socket(addr);
    match s.status == /sys/Io/Status/ok : Result(Socket, Io/Error)
    | false => Result/failure(Io/error_of(s.status))
    | true =>
        let _ = configure(s.handle, settings);
        let status = /sys/Io/connect(s.handle, addr);
        match status == /sys/Io/Status/ok : Result(Socket, Io/Error)
        | false =>
            let _ = /sys/Io/close(s.handle);
            Result/failure(Io/error_of(status))
        | true =>
            let upgraded = upgrade(s.handle, host, settings.tls);
            match upgraded == /sys/Io/Status/ok : Result(Socket, Io/Error)
            | false =>
                let _ = /sys/Io/close(s.handle);
                Result/failure(Io/error_of(upgraded))
            | true =>
                let _ =
                    match settings.tls : {}
                    | false => Task/nonblocking(s.handle)
                    | true => ()
                    end;
                Result/success(Socket { s.handle })
            end
        end
    end;

let connect_socket(settings : Settings, host : Str, port : Nat) -> Task(Result(Socket, Io/Error)) =
    Task/bind(resolve_addr(host, port), (resolved) =>
        match resolved : Task(Result(Socket, Io/Error))
        | failure(e) => Task/pure(Result/failure(e))
        | success(addr) => Task/pure(connect_addr(settings, host, addr))
        end);

pub let connect(settings : Settings, host : Str, port : Nat) -> Task(Result(Socket, Io/Error)) =
    Task/defer(() =>
        Task/bind(connect_socket(settings, host, port), (opened) =>
            match opened : Task(Result(Socket, Io/Error))
            | failure(e) => Task/pure(Result/failure(e))
            | success(c) =>
                Task/bind(Task/acquire(c.0, () => /sys/Io/close(c.0)), (_) => Task/pure(Result/success(c)))
            end));

pub let close(c : Socket) -> Task({}) =
    Task/release(c.0);

pub let with(@A : Type, settings : Settings, host : Str, port : Nat, f : (Socket) -> Task(A)) -> Task(Result(A, Io/Error)) =
    Task/bind(connect(settings, host, port), (opened) =>
        match opened : Task(Result(A, Io/Error))
        | failure(e) => Task/pure(Result/failure(e))
        | success(c) =>
            Task/bind(f(c), (a) =>
                Task/bind(close(c), (_) => Task/pure(Result/success(a))))
        end);

let drain(c : Socket) -> Task(Bin) =
    Task/drain((n) => read(c, n));

pub let call(settings : Settings, host : Str, port : Nat, request : Bin) -> Task(Result(Bin, Io/Error)) =
    with(settings, host, port, (c) =>
        Task/bind(write(c, request), (_) => drain(c)));

struct Listener : Type { Io }

let bind_listen(addr : Bin) -> Result(Listener, Io/Error) =
    let s = /sys/Io/socket(addr);
    match s.status == /sys/Io/Status/ok : Result(Listener, Io/Error)
    | false => Result/failure(Io/error_of(s.status))
    | true =>
        let _ = /sys/Io/set_reuseaddr(s.handle, true);
        let bound = /sys/Io/bind(s.handle, addr);
        match bound == /sys/Io/Status/ok : Result(Listener, Io/Error)
        | false =>
            let _ = /sys/Io/close(s.handle);
            Result/failure(Io/error_of(bound))
        | true =>
            let status = /sys/Io/listen(s.handle, 128);
            match status == /sys/Io/Status/ok : Result(Listener, Io/Error)
            | false =>
                let _ = /sys/Io/close(s.handle);
                Result/failure(Io/error_of(status))
            | true =>
                let _ = Task/nonblocking(s.handle);
                Result/success(Listener { s.handle })
            end
        end
    end;

let listen(host : Str, port : Nat) -> Task(Result(Listener, Io/Error)) =
    Task/bind(resolve_addr(host, port), (resolved) =>
        match resolved : Task(Result(Listener, Io/Error))
        | failure(e) => Task/pure(Result/failure(e))
        | success(addr) => Task/pure(bind_listen(addr))
        end);

let listen_loop(host : Str, port : Nat, on_conn : (Io) -> Task({})) -> Task(Result({}, Io/Error)) =
    Task/bind(listen(host, port), (opened) =>
        match opened : Task(Result({}, Io/Error))
        | failure(e) => Task/pure(Result/failure(e))
        | success(l) =>
            Task/bind(
                Task/using(l.0, () => /sys/Io/close(l.0),
                    rec go() -> Task({}) =
                        Task/bind(Task/accept(l.0), (r) =>
                            match r : Task({})
                            | failure(_) => Task/pure(())
                            | success(h) => Task/bind(on_conn(h), (_) => go())
                            end);
                    go()),
                (_) => Task/pure(Result/success(())))
        end);

pub let serve(host : Str, port : Nat, handler : (Socket) -> Task({})) -> Task(Result({}, Io/Error)) =
    Task/defer(() =>
        listen_loop(host, port, (h) =>
            let _ = Task/nonblocking(h);
            Task/go(() => Task/using(h, () => /sys/Io/close(h), handler(Socket { h })))));

pub let serve_tls(host : Str, port : Nat, cert : Bin, key : Bin, handler : (Socket) -> Task({})) -> Task(Result({}, Io/Error)) =
    Task/defer(() =>
        let cfg = /sys/Io/tls_server_config(cert, key);
        match cfg.status == /sys/Io/Status/ok : Task(Result({}, Io/Error))
        | false => Task/pure(Result/failure(Io/error_of(cfg.status)))
        | true =>
            Task/using(cfg.handle, () => let _ = /sys/Io/close(cfg.handle); (),
                listen_loop(host, port, (h) =>
                    let status = /sys/Io/start_tls_server(h, cfg.handle);
                    match status == /sys/Io/Status/ok : Task({})
                    | true => Task/using(h, () => /sys/Io/close(h), handler(Socket { h }))
                    | false =>
                        let _ = /sys/Io/close(h);
                        Task/pure(())
                    end))
        end);
