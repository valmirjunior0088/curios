use /std/{Nat};
use /syn/{True, False};

-- | That `code` is below `bound`, decided.
pub let Below(code: Nat, bound: Nat) -> Prop =
    match code < bound | true => True | false => False end;

-- | That `code` lies between `lo` and `hi`, both ends included, decided.
pub let InRange(code: Nat, lo: Nat, hi: Nat) -> Prop =
    match code >= lo
    | true => match code <= hi | true => True | false => False end
    | false => False
    end;

-- | That `code` is a Unicode scalar value, which is every code point but the surrogates.
pub induct Scalar: (Nat) -> pub Prop
-- | Below the surrogate range.
| below(@code: Nat, proof: Below(code, 0xD800)): (code)
-- | Above the surrogate range, up to the last code point.
| above(@code: Nat, proof: InRange(code, 0xE000, 0x10FFFF)): (code)
end

-- | One Unicode scalar value.
pub struct Char: pub Type {
    -- | Its code point.
    code: Nat,
    -- | Why that code point is a scalar value rather than a surrogate.
    scalar: Scalar(code),
}
