use /std/{Nat, Bool};

-- | That `a` is below `b`.
-- |
-- | Decided rather than proved: over literals it reduces to the proposition that holds, which is how `/` and `%` on `Nat` discharge what they ask of a divisor.
pub let Lt(a: Nat, b: Nat) -> Prop =
    Bool/Holds(Nat/lt(a, b));

-- | That `a` is below `b` or equal to it, decided as `Lt` is.
pub let Le(a: Nat, b: Nat) -> Prop =
    Bool/Holds(Nat/le(a, b));
