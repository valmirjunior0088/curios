use /std/{Nat, Bool, Str, Bytes, List, Option, Result, Try, Io, Eq, Equal, Spell, Show, True, False,
    print, proc};

pub induct Verdict: pub Type
| passed()
| failed(Str)
end

pub induct Test: Type
| theorem()
| verdict(Verdict)
| action(Io(Test))
end

pub let prove(P: Prop, _proof: P) -> Test =
    Test/theorem();

pub let refl(@A: Type, a: A, b: A, _proof: Eq(a, b)) -> Test =
    Test/theorem();

pub let Settled(t: Test) -> Prop =
    match t | theorem() => True | verdict(_) => False | action(_) => False end;

pub let settled(@A: Type, prop: (A) -> Test, _evidence: (a: A) -> Settled(prop(a))) -> Test =
    Test/theorem();

pub let check(condition: Bool) -> Test =
    Test/verdict(
        match condition
        | true => Verdict/passed()
        | false => Verdict/failed("the condition was false")
        end);

pub let equal(@A: Type, use Equal(A), use Spell(A), actual: A, expected: A) -> Test =
    match actual == expected
    | true => Test/verdict(Verdict/passed())
    | false =>
        Test/verdict(
            Verdict/failed(
                Str/concat(
                    "expected ",
                    Str/concat(
                        Spell/spell(expected),
                        Str/concat(" but got ", Spell/spell(actual))))))
    end;

pub let perform(thunk: () -> Io(Test)) -> Test =
    Test/action(thunk());

pub let all(tests: List(Test)) -> Test =
    let (conjunction, _) =
        List/fold(
            tests,
            (Test/theorem(), 0),
            (t, state: {Test, Nat}) =>
                let (acc, index) = state;
                (conjoin(acc, case(index, t)), index + 1));
    conjunction;

let case(index: Nat, t: Test) -> Test =
    match t
    | theorem() => t
    | verdict(v) =>
        match v
        | passed() => t
        | failed(message) =>
            Test/verdict(
                Verdict/failed(
                    Str/concat("case ", Str/concat(Nat/to_str(index), Str/concat(": ", message)))))
        end
    | action(io) =>
        perform(
            () =>
                let inner = io!;
                Io/pure(case(index, inner)))
    end;

let conjoin(left: Test, right: Test) -> Test =
    match left
    | theorem() => right
    | verdict(v) =>
        match v
        | passed() => match right | theorem() => left | verdict(_) => right | action(_) => right end
        | failed(_) => left
        end
    | action(io) =>
        perform(
            () =>
                let inner = io!;
                Io/pure(conjoin(inner, right)))
    end;

let outcome(@E: Type, use Show(E), io: Io(Result(E, Test))) -> Io(Test) =
    let r = io!;
    Io/pure(
        match r | success(t) => t | failure(e) => Test/verdict(Verdict/failed(Show/show(e))) end);

pub let try(@E: Type, use Show(E), thunk: () -> Try(Io, E, Test)) -> Test =
    Test/action(outcome(Try/run(thunk())));

let report(name: Str, t: Test) -> Io(Bool) =
    match t
    | theorem() =>
        let _ = print(Str/concat(name, ": proved\n"))!;
        Io/pure(true)
    | verdict(v) =>
        match v
        | passed() =>
            let _ = print(Str/concat(name, ": passed\n"))!;
            Io/pure(true)
        | failed(message) =>
            let _ = print(Str/concat(name, Str/concat(": failed\n  ", Str/concat(message, "\n"))))!;
            Io/pure(false)
        end
    | action(io) =>
        let inner = io!;
        report(name, inner)
    end;

let parse_index(raw: Bytes) -> Option(Nat) =
    match Str/of_bytes(raw) | some(s) => Nat/of_str(s) | none() => Option/none() end;

let run_all(tests: List({Str, () -> Test})) -> Io(Bool) =
    List/fold(
        tests,
        Io/pure(true),
        ((name, body), acc) =>
            let earlier = acc!;
            let here = report(name, body())!;
            Io/pure(earlier && here));

pub let main(tests: List({Str, () -> Test})) -> Io({}) =
    let arguments = proc/args!;
    match List/try_get(arguments, 1)
    | some(raw) =>
        match parse_index(raw)
        | some(index) =>
            match List/try_get(tests, index)
            | some((name, body)) =>
                let ok = report(name, body())!;
                match ok | true => Io/pure(()) | false => proc/exit(1) end
            | none() => proc/exit(1)
            end
        | none() => proc/exit(1)
        end
    | none() =>
        let ok = run_all(tests)!;
        match ok | true => Io/pure(()) | false => proc/exit(1) end
    end;

let judge(t: Test) -> Verdict =
    match t
    | theorem() => Verdict/passed()
    | verdict(v) => v
    | action(_) => Verdict/failed("an action cannot be probed")
    end;

satisfy /std/Test/Property(Test) {
    probe(t, _seed, _size) = judge(t),
    extent() = Option/some(1),
    exhaust(t) = [judge(t)],
}

let default_seed: /std/Test/Seed =
    /std/Test/Seed/make(20260831);

let default_cases: Nat =
    100;

pub let property(@A: Type, use /std/Test/Property(A), prop: A) -> Test =
    Test/verdict(/std/Test/Property/run(prop, default_seed, default_cases));
