use /std/{Str, List};

pub concept Spell(A: Type): pub Type {
    spell(A) -> Str,
}

pub use Spell/*;

pub let call(head: Str, args: List(Str)) -> Str =
    Str/concat(head, Str/concat("(", Str/concat(Str/join(", ", args), ")")));

pub let record(head: Str, fields: List({Str, Str})) -> Str =
    let entries =
        List/map(fields, ((label, value)) =>
            match Str/len(label)
            | 0 => value
            | _ => Str/concat(label, Str/concat(" = ", value))
            end);
    match entries
    | [] => Str/concat(head, " {}")
    | _ => Str/concat(head, Str/concat(" { ", Str/concat(Str/join(", ", entries), " }")))
    end;
