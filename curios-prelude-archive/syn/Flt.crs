use /std/{Nat, Bytes, Flt};
use /syn/{True, False};

pub let FourBytes(b: Bytes) -> Prop =
    match Nat/eql(Bytes/len(b), 4) | true => True | false => False end;

let max: Flt =
    +340282350000000000000000000000000000000.0;

let min: Flt =
    -340282350000000000000000000000000000000.0;

pub let Finite(a: Flt) -> Prop =
    match Flt/le(min, a) && Flt/le(a, max) | true => True | false => False end;

pub let NonNeg(a: Flt) -> Prop =
    match Flt/ge(a, +0.0) && Flt/le(a, max) | true => True | false => False end;
