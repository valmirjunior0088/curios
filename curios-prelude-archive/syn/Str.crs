use /std/{Nat, Byte, Bytes, Bool, Eq};

-- | What a byte begins, as UTF-8 reads it.
pub induct Class: pub Type
-- | A character of one byte.
| ascii()
-- | The first of a character whose remaining `count` bytes must each lie between `lo` and `hi`.
| lead(count: Nat, lo: Nat, hi: Nat, payload: Nat)
-- | A byte no character may begin with.
| bad()
end

-- | What `c` begins.
pub let classify(c: Byte) -> Class =
    let n = Byte/to_nat(c);
    choose
    | Nat/in_range(n, 0x0, 0x7F) => Class/ascii()
    | Nat/in_range(n, 0xC2, 0xDF) => Class/lead(1, 0x80, 0xBF, n - 0xC0)
    | Nat/in_range(n, 0xE0, 0xEF) =>
        let lo = choose | n == 0xE0 => 0xA0 | _ => 0x80 end;
        let hi = choose | n == 0xED => 0x9F | _ => 0xBF end;
        Class/lead(2, lo, hi, n - 0xE0)
    | Nat/in_range(n, 0xF0, 0xF4) =>
        let lo = choose | n == 0xF0 => 0x90 | _ => 0x80 end;
        let hi = choose | n == 0xF4 => 0x8F | _ => 0xBF end;
        Class/lead(3, lo, hi, n - 0xF0)
    | _ => Class/bad()
    end;

-- | How far through a character a walk over bytes has come.
pub induct Scan: pub Type
-- | Between characters, where a new one may begin.
| lead()
-- | Inside a character, with `remaining` bytes still owed, each between `lo` and `hi`.
| cont(remaining: Nat, lo: Nat, hi: Nat)
-- | Past a byte the encoding does not admit, which nothing recovers from.
| bad()
end

-- | The state reading `c` leaves the scan in.
pub let step(c: Byte, s: Scan) -> Scan =
    let n = Byte/to_nat(c);
    match s
    | bad() => Scan/bad()
    | cont(rem, lo, hi) =>
        choose
        | Bool/not(Nat/in_range(n, lo, hi)) => Scan/bad()
        | rem == 1 => Scan/lead()
        | _ => Scan/cont(rem - 1, 0x80, 0xBF)
        end
    | lead() =>
        match classify(c)
        | ascii() => Scan/lead()
        | lead(cont, lo, hi, _) => Scan/cont(cont, lo, hi)
        | bad() => Scan/bad()
        end
    end;

-- | That `b` is well-formed UTF-8 read from the state `s`.
pub induct Utf8: (Scan, Bytes) -> pub Prop
-- | Nothing left to read, and no character left half-read.
| stop(): (Scan/lead(), x[])
-- | One byte, and then the rest under the state it leaves.
| more(c: Byte, st: Scan, t: Bytes, rest: Utf8(step(c, st), t)): (st, x[c, ..t])
end

-- | That `b` is well-formed UTF-8 read from its first byte, which is what `Str` carries.
pub let Valid(b: Bytes) -> Prop =
    Utf8(Scan/lead(), b);

-- | The state reading all of `b` leaves the scan in.
pub let scan_from(s: Scan, b: Bytes) -> Scan =
    match b | x[] => s | x[h, ..t] => scan_from(step(h, s), t) end;

-- | The proof that `b` is UTF-8 from `s`, out of the equation that reading it lands back between characters.
pub let of_scan_eq_from(s: Scan, b: Bytes, p: Eq(scan_from(s, b), Scan/lead())) -> Utf8(s, b) =
    match b
    | x[] => Eq/subst((q) => Utf8(q, x[]), Eq/sym(p), Utf8/stop())
    | x[h, ..t] => Utf8/more(h, s, t, of_scan_eq_from(step(h, s), t, p))
    end;

-- | The same from the first byte, which is what certifies a string literal.
pub let of_scan_eq(b: Bytes, p: Eq(scan_from(Scan/lead(), b), Scan/lead())) -> Valid(b) =
    of_scan_eq_from(Scan/lead(), b, p);

-- | That reading `b` from the start equals itself, which a literal discharges by reduction.
pub let refl_scan(b: Bytes) -> Eq(scan_from(Scan/lead(), b), scan_from(Scan/lead(), b)) =
    Eq/refl();

-- | Text: bytes certified as UTF-8.
pub struct Str: pub Type {
    -- | The bytes themselves.
    bytes: Bytes,
    -- | Why they are well-formed UTF-8.
    valid: Valid(bytes),
}
