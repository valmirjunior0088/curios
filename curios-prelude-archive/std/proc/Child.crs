-- A running child: its handle, which becomes readable when it exits, and whichever of its streams were piped. The representation is this module's; `new` is the seam `proc/spawn` builds one through, as `tcp/Socket/new` is for an accepted handle.
use /std/{Nat, Handle, Option, Result, Async, Io};
use /std/proc/{Exit};

pub struct Child: Type {
    handle: Handle,
    stdin: Option(Handle),
    stdout: Option(Handle),
    stderr: Option(Handle),
}

pub let new(
    handle: Handle,
    stdin: Option(Handle),
    stdout: Option(Handle),
    stderr: Option(Handle),
) -> Child =
    Child { handle = handle, stdin = stdin, stdout = stdout, stderr = stderr };

pub let stdin(c: Child) -> Option(Handle) =
    c.stdin;

pub let stdout(c: Child) -> Option(Handle) =
    c.stdout;

pub let stderr(c: Child) -> Option(Handle) =
    c.stderr;

-- Wait for the child to end. Its handle becomes readable when it does, so the fiber parks on it and reaps at once; the release then runs the `kill` finalizer on a child already reaped, which the host answers as not found and nothing minds.
pub let wait(c: Child) -> Async(Result(Exit, Handle/Error)) =
    let _ = Async/wait(c.handle, /sys/event/read)!;
    let r = /sys/proc/wait(c.handle)!;
    let _ = Async/release(c.handle)!;
    Async/pure(
        match Handle/error_of(r.status)
        | some(e) => Result/failure(e)
        | none() =>
            Result/success(
                match r.signal == 0
                | true => Exit/exited(r.code)
                | false => Exit/signaled(r.signal)
                end)
        end);
