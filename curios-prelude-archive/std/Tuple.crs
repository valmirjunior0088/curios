-- Show, Spell, Eql and Ord for the anonymous products programs write. A tuple type is keyed by its shape — the label at each position — so each shape is its own witness and its own table entry, and `{Nat, Bool}`, `{a: Nat, b: Bool}` and `{x: Nat, y: Bool}` are three of them because they are three types.
--
-- Only positional shapes are written. Labels are open-ended, and the labeled product with an owner is a `struct`, which is where a program wanting these on `{x: Nat, y: Bool}` is pointed.
--
-- The ceiling is eight, past which a labeled `struct` is the readable type. Because a tuple shape is owned by no module, the orphan rule leaves `/std` the only root that may key a witness on one for a `/std` concept, so the ceiling is a promise rather than a default and was chosen with room: raising it is adding lines and nothing else. `Spell` stops at three for now — a derived witness reaches it through a tuple payload, and no consumer has asked past that — and raising it is the same kind of edit.
use /std/{Show, Spell, Eql, Ord, Order, Str, Bool, List};

-- A tuple shows as its literal is written, so the rendering is source text as the carriers' renderings are. The one-field literal keeps the trailing comma that separates it from a parenthesized term, so it is written out rather than joined.
let parens(parts: List(Str)) -> Str =
    Str/concat("(", Str/concat(Str/join(", ", parts), ")"));

-- The first component that is not `eq` decides, so the rest of the comparison is a thunk rather than a value: at the ceiling a strict fold would compare all eight fields on every call.
let then(first: Order, rest: ({}) -> Order) -> Order =
    match first | eq() => rest(()) | _ => first end;

satisfy Show({}) {
    show(t) = "()",
}

satisfy (@A: Type, use Show(A)) => Show({A}) {
    show(t) = Str/concat("(", Str/concat(Show/show(t.0), ",)")),
}

satisfy (@A: Type, @B: Type, use Show(A), use Show(B)) => Show({A, B}) {
    show(t) = parens([Show/show(t.0), Show/show(t.1)]),
}

satisfy (@A: Type, @B: Type, @C: Type, use Show(A), use Show(B), use Show(C)) => Show({A, B, C}) {
    show(t) = parens([Show/show(t.0), Show/show(t.1), Show/show(t.2)]),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    use Show(A),
    use Show(B),
    use Show(C),
    use Show(D)) => Show({A, B, C, D}) {
    show(t) = parens([Show/show(t.0), Show/show(t.1), Show/show(t.2), Show/show(t.3)]),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    use Show(A),
    use Show(B),
    use Show(C),
    use Show(D),
    use Show(E)) => Show({A, B, C, D, E}) {
    show(t) =
        parens([Show/show(t.0), Show/show(t.1), Show/show(t.2), Show/show(t.3), Show/show(t.4)]),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    @F: Type,
    use Show(A),
    use Show(B),
    use Show(C),
    use Show(D),
    use Show(E),
    use Show(F)) => Show({A, B, C, D, E, F}) {
    show(t) =
        parens(
            [
                Show/show(t.0),
                Show/show(t.1),
                Show/show(t.2),
                Show/show(t.3),
                Show/show(t.4),
                Show/show(t.5)]),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    @F: Type,
    @G: Type,
    use Show(A),
    use Show(B),
    use Show(C),
    use Show(D),
    use Show(E),
    use Show(F),
    use Show(G)) => Show({A, B, C, D, E, F, G}) {
    show(t) =
        parens(
            [
                Show/show(t.0),
                Show/show(t.1),
                Show/show(t.2),
                Show/show(t.3),
                Show/show(t.4),
                Show/show(t.5),
                Show/show(t.6)]),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    @F: Type,
    @G: Type,
    @H: Type,
    use Show(A),
    use Show(B),
    use Show(C),
    use Show(D),
    use Show(E),
    use Show(F),
    use Show(G),
    use Show(H)) => Show({A, B, C, D, E, F, G, H}) {
    show(t) =
        parens(
            [
                Show/show(t.0),
                Show/show(t.1),
                Show/show(t.2),
                Show/show(t.3),
                Show/show(t.4),
                Show/show(t.5),
                Show/show(t.6),
                Show/show(t.7)]),
}

-- A tuple spells as its literal, which is how it shows, with the fields spelled instead of shown: the same text re-parses at the same shape wherever the fields' names are visible.
satisfy Spell({}) {
    spell(t) = "()",
}

satisfy (@A: Type, use Spell(A)) => Spell({A}) {
    spell(t) = Str/concat("(", Str/concat(Spell/spell(t.0), ",)")),
}

satisfy (@A: Type, @B: Type, use Spell(A), use Spell(B)) => Spell({A, B}) {
    spell(t) = parens([Spell/spell(t.0), Spell/spell(t.1)]),
}

satisfy (@A: Type, @B: Type, @C: Type, use Spell(A), use Spell(B), use Spell(C)) => Spell({A, B, C}) {
    spell(t) = parens([Spell/spell(t.0), Spell/spell(t.1), Spell/spell(t.2)]),
}

satisfy Eql({}) {
    eql(a, b) = true,
    neq(a, b) = false,
}

satisfy (@A: Type, use Eql(A)) => Eql({A}) {
    eql(a, b) = a.0 == b.0,
    neq(a, b) = Bool/not(a == b),
}

satisfy (@A: Type, @B: Type, use Eql(A), use Eql(B)) => Eql({A, B}) {
    eql(a, b) = a.0 == b.0 && a.1 == b.1,
    neq(a, b) = Bool/not(a == b),
}

satisfy (@A: Type, @B: Type, @C: Type, use Eql(A), use Eql(B), use Eql(C)) => Eql({A, B, C}) {
    eql(a, b) = a.0 == b.0 && a.1 == b.1 && a.2 == b.2,
    neq(a, b) = Bool/not(a == b),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    use Eql(A),
    use Eql(B),
    use Eql(C),
    use Eql(D)) => Eql({A, B, C, D}) {
    eql(a, b) = a.0 == b.0 && a.1 == b.1 && a.2 == b.2 && a.3 == b.3,
    neq(a, b) = Bool/not(a == b),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    use Eql(A),
    use Eql(B),
    use Eql(C),
    use Eql(D),
    use Eql(E)) => Eql({A, B, C, D, E}) {
    eql(a, b) = a.0 == b.0 && a.1 == b.1 && a.2 == b.2 && a.3 == b.3 && a.4 == b.4,
    neq(a, b) = Bool/not(a == b),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    @F: Type,
    use Eql(A),
    use Eql(B),
    use Eql(C),
    use Eql(D),
    use Eql(E),
    use Eql(F)) => Eql({A, B, C, D, E, F}) {
    eql(a, b) = a.0 == b.0 && a.1 == b.1 && a.2 == b.2 && a.3 == b.3 && a.4 == b.4 && a.5 == b.5,
    neq(a, b) = Bool/not(a == b),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    @F: Type,
    @G: Type,
    use Eql(A),
    use Eql(B),
    use Eql(C),
    use Eql(D),
    use Eql(E),
    use Eql(F),
    use Eql(G)) => Eql({A, B, C, D, E, F, G}) {
    eql(a, b) =
        a.0 == b.0 && a.1 == b.1 && a.2 == b.2 && a.3 == b.3 && a.4 == b.4 && a.5 == b.5
            && a.6 == b.6,
    neq(a, b) = Bool/not(a == b),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    @F: Type,
    @G: Type,
    @H: Type,
    use Eql(A),
    use Eql(B),
    use Eql(C),
    use Eql(D),
    use Eql(E),
    use Eql(F),
    use Eql(G),
    use Eql(H)) => Eql({A, B, C, D, E, F, G, H}) {
    eql(a, b) =
        a.0 == b.0 && a.1 == b.1 && a.2 == b.2 && a.3 == b.3 && a.4 == b.4 && a.5 == b.5
            && a.6 == b.6
            && a.7 == b.7,
    neq(a, b) = Bool/not(a == b),
}

satisfy Ord({}) {
    cmp(a, b) = Order/eq(),
}

satisfy (@A: Type, use Ord(A)) => Ord({A}) {
    cmp(a, b) = Ord/cmp(a.0, b.0),
}

satisfy (@A: Type, @B: Type, use Ord(A), use Ord(B)) => Ord({A, B}) {
    cmp(a, b) = then(Ord/cmp(a.0, b.0), (u) => Ord/cmp(a.1, b.1)),
}

satisfy (@A: Type, @B: Type, @C: Type, use Ord(A), use Ord(B), use Ord(C)) => Ord({A, B, C}) {
    cmp(a, b) = then(Ord/cmp(a.0, b.0), (u) => then(Ord/cmp(a.1, b.1), (u) => Ord/cmp(a.2, b.2))),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    use Ord(A),
    use Ord(B),
    use Ord(C),
    use Ord(D)) => Ord({A, B, C, D}) {
    cmp(a, b) =
        then(
            Ord/cmp(a.0, b.0),
            (u) =>
                then(Ord/cmp(a.1, b.1), (u) => then(Ord/cmp(a.2, b.2), (u) => Ord/cmp(a.3, b.3)))),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    use Ord(A),
    use Ord(B),
    use Ord(C),
    use Ord(D),
    use Ord(E)) => Ord({A, B, C, D, E}) {
    cmp(a, b) =
        then(
            Ord/cmp(a.0, b.0),
            (u) =>
                then(
                    Ord/cmp(a.1, b.1),
                    (u) =>
                        then(
                            Ord/cmp(a.2, b.2),
                            (u) => then(Ord/cmp(a.3, b.3), (u) => Ord/cmp(a.4, b.4))))),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    @F: Type,
    use Ord(A),
    use Ord(B),
    use Ord(C),
    use Ord(D),
    use Ord(E),
    use Ord(F)) => Ord({A, B, C, D, E, F}) {
    cmp(a, b) =
        then(
            Ord/cmp(a.0, b.0),
            (u) =>
                then(
                    Ord/cmp(a.1, b.1),
                    (u) =>
                        then(
                            Ord/cmp(a.2, b.2),
                            (u) =>
                                then(
                                    Ord/cmp(a.3, b.3),
                                    (u) => then(Ord/cmp(a.4, b.4), (u) => Ord/cmp(a.5, b.5)))))),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    @F: Type,
    @G: Type,
    use Ord(A),
    use Ord(B),
    use Ord(C),
    use Ord(D),
    use Ord(E),
    use Ord(F),
    use Ord(G)) => Ord({A, B, C, D, E, F, G}) {
    cmp(a, b) =
        then(
            Ord/cmp(a.0, b.0),
            (u) =>
                then(
                    Ord/cmp(a.1, b.1),
                    (u) =>
                        then(
                            Ord/cmp(a.2, b.2),
                            (u) =>
                                then(
                                    Ord/cmp(a.3, b.3),
                                    (u) =>
                                        then(
                                            Ord/cmp(a.4, b.4),
                                            (u) =>
                                                then(
                                                    Ord/cmp(a.5, b.5),
                                                    (u) => Ord/cmp(a.6, b.6))))))),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    @F: Type,
    @G: Type,
    @H: Type,
    use Ord(A),
    use Ord(B),
    use Ord(C),
    use Ord(D),
    use Ord(E),
    use Ord(F),
    use Ord(G),
    use Ord(H)) => Ord({A, B, C, D, E, F, G, H}) {
    cmp(a, b) =
        then(
            Ord/cmp(a.0, b.0),
            (u) =>
                then(
                    Ord/cmp(a.1, b.1),
                    (u) =>
                        then(
                            Ord/cmp(a.2, b.2),
                            (u) =>
                                then(
                                    Ord/cmp(a.3, b.3),
                                    (u) =>
                                        then(
                                            Ord/cmp(a.4, b.4),
                                            (u) =>
                                                then(
                                                    Ord/cmp(a.5, b.5),
                                                    (u) =>
                                                        then(
                                                            Ord/cmp(a.6, b.6),
                                                            (u) => Ord/cmp(a.7, b.7)))))))),
}
