use /std/{Show, Spell, Equal, Ordered, Ordering, Str, Bool, List, Option, Test};

let parens(parts: List(Str)) -> Str =
    Str/concat("(", Str/concat(Str/join(", ", parts), ")"));

let then(first: Ordering, rest: ({}) -> Ordering) -> Ordering =
    match first | eq() => rest(()) | _ => first end;

satisfy Show({}) {
    show(_t) = "()",
}

satisfy (@A: Type, use Show(A)) => Show({A}) {
    show(t) = Str/concat("(", Str/concat(Show/show(t.0), ",)")),
}

satisfy (@A: Type, @B: Type, use Show(A), use Show(B)) => Show({A, B}) {
    show(t) = parens([Show/show(t.0), Show/show(t.1)]),
}

satisfy (@A: Type, @B: Type, @C: Type, use Show(A), use Show(B), use Show(C)) => Show({A, B, C}) {
    show(t) = parens([Show/show(t.0), Show/show(t.1), Show/show(t.2)]),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    use Show(A),
    use Show(B),
    use Show(C),
    use Show(D),
) => Show({A, B, C, D}) {
    show(t) = parens([Show/show(t.0), Show/show(t.1), Show/show(t.2), Show/show(t.3)]),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    use Show(A),
    use Show(B),
    use Show(C),
    use Show(D),
    use Show(E),
) => Show({A, B, C, D, E}) {
    show(t) =
        parens([Show/show(t.0), Show/show(t.1), Show/show(t.2), Show/show(t.3), Show/show(t.4)]),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    @F: Type,
    use Show(A),
    use Show(B),
    use Show(C),
    use Show(D),
    use Show(E),
    use Show(F),
) => Show({A, B, C, D, E, F}) {
    show(t) =
        parens(
            [
                Show/show(t.0),
                Show/show(t.1),
                Show/show(t.2),
                Show/show(t.3),
                Show/show(t.4),
                Show/show(t.5)]),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    @F: Type,
    @G: Type,
    use Show(A),
    use Show(B),
    use Show(C),
    use Show(D),
    use Show(E),
    use Show(F),
    use Show(G),
) => Show({A, B, C, D, E, F, G}) {
    show(t) =
        parens(
            [
                Show/show(t.0),
                Show/show(t.1),
                Show/show(t.2),
                Show/show(t.3),
                Show/show(t.4),
                Show/show(t.5),
                Show/show(t.6)]),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    @F: Type,
    @G: Type,
    @H: Type,
    use Show(A),
    use Show(B),
    use Show(C),
    use Show(D),
    use Show(E),
    use Show(F),
    use Show(G),
    use Show(H),
) => Show({A, B, C, D, E, F, G, H}) {
    show(t) =
        parens(
            [
                Show/show(t.0),
                Show/show(t.1),
                Show/show(t.2),
                Show/show(t.3),
                Show/show(t.4),
                Show/show(t.5),
                Show/show(t.6),
                Show/show(t.7)]),
}

satisfy Spell({}) {
    spell(_t) = "()",
}

satisfy (@A: Type, use Spell(A)) => Spell({A}) {
    spell(t) = Str/concat("(", Str/concat(Spell/spell(t.0), ",)")),
}

satisfy (@A: Type, @B: Type, use Spell(A), use Spell(B)) => Spell({A, B}) {
    spell(t) = parens([Spell/spell(t.0), Spell/spell(t.1)]),
}

satisfy (@A: Type, @B: Type, @C: Type, use Spell(A), use Spell(B), use Spell(C)) => Spell(
    {A, B, C}) {
    spell(t) = parens([Spell/spell(t.0), Spell/spell(t.1), Spell/spell(t.2)]),
}

satisfy Equal({}) {
    eql(_a, _b) = true,
    neq(_a, _b) = false,
}

satisfy (@A: Type, use Equal(A)) => Equal({A}) {
    eql(a, b) = a.0 == b.0,
    neq(a, b) = Bool/not(a == b),
}

satisfy (@A: Type, @B: Type, use Equal(A), use Equal(B)) => Equal({A, B}) {
    eql(a, b) = a.0 == b.0 && a.1 == b.1,
    neq(a, b) = Bool/not(a == b),
}

satisfy (@A: Type, @B: Type, @C: Type, use Equal(A), use Equal(B), use Equal(C)) => Equal(
    {A, B, C}) {
    eql(a, b) = a.0 == b.0 && a.1 == b.1 && a.2 == b.2,
    neq(a, b) = Bool/not(a == b),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    use Equal(A),
    use Equal(B),
    use Equal(C),
    use Equal(D),
) => Equal({A, B, C, D}) {
    eql(a, b) = a.0 == b.0 && a.1 == b.1 && a.2 == b.2 && a.3 == b.3,
    neq(a, b) = Bool/not(a == b),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    use Equal(A),
    use Equal(B),
    use Equal(C),
    use Equal(D),
    use Equal(E),
) => Equal({A, B, C, D, E}) {
    eql(a, b) = a.0 == b.0 && a.1 == b.1 && a.2 == b.2 && a.3 == b.3 && a.4 == b.4,
    neq(a, b) = Bool/not(a == b),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    @F: Type,
    use Equal(A),
    use Equal(B),
    use Equal(C),
    use Equal(D),
    use Equal(E),
    use Equal(F),
) => Equal({A, B, C, D, E, F}) {
    eql(a, b) = a.0 == b.0 && a.1 == b.1 && a.2 == b.2 && a.3 == b.3 && a.4 == b.4 && a.5 == b.5,
    neq(a, b) = Bool/not(a == b),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    @F: Type,
    @G: Type,
    use Equal(A),
    use Equal(B),
    use Equal(C),
    use Equal(D),
    use Equal(E),
    use Equal(F),
    use Equal(G),
) => Equal({A, B, C, D, E, F, G}) {
    eql(a, b) =
        a.0 == b.0 && a.1 == b.1 && a.2 == b.2 && a.3 == b.3 && a.4 == b.4 && a.5 == b.5
            && a.6 == b.6,
    neq(a, b) = Bool/not(a == b),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    @F: Type,
    @G: Type,
    @H: Type,
    use Equal(A),
    use Equal(B),
    use Equal(C),
    use Equal(D),
    use Equal(E),
    use Equal(F),
    use Equal(G),
    use Equal(H),
) => Equal({A, B, C, D, E, F, G, H}) {
    eql(a, b) =
        a.0 == b.0 && a.1 == b.1 && a.2 == b.2 && a.3 == b.3 && a.4 == b.4 && a.5 == b.5
            && a.6 == b.6
            && a.7 == b.7,
    neq(a, b) = Bool/not(a == b),
}

satisfy Ordered({}) {
    cmp(_a, _b) = Ordering/eq(),
}

satisfy (@A: Type, use Ordered(A)) => Ordered({A}) {
    cmp(a, b) = Ordered/cmp(a.0, b.0),
}

satisfy (@A: Type, @B: Type, use Ordered(A), use Ordered(B)) => Ordered({A, B}) {
    cmp(a, b) = then(Ordered/cmp(a.0, b.0), (_u) => Ordered/cmp(a.1, b.1)),
}

satisfy (@A: Type, @B: Type, @C: Type, use Ordered(A), use Ordered(B), use Ordered(C)) => Ordered(
    {A, B, C}) {
    cmp(a, b) =
        then(
            Ordered/cmp(a.0, b.0),
            (_u) => then(Ordered/cmp(a.1, b.1), (_u) => Ordered/cmp(a.2, b.2))),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    use Ordered(A),
    use Ordered(B),
    use Ordered(C),
    use Ordered(D),
) => Ordered({A, B, C, D}) {
    cmp(a, b) =
        then(
            Ordered/cmp(a.0, b.0),
            (_u) =>
                then(
                    Ordered/cmp(a.1, b.1),
                    (_u) => then(Ordered/cmp(a.2, b.2), (_u) => Ordered/cmp(a.3, b.3)))),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    use Ordered(A),
    use Ordered(B),
    use Ordered(C),
    use Ordered(D),
    use Ordered(E),
) => Ordered({A, B, C, D, E}) {
    cmp(a, b) =
        then(
            Ordered/cmp(a.0, b.0),
            (_u) =>
                then(
                    Ordered/cmp(a.1, b.1),
                    (_u) =>
                        then(
                            Ordered/cmp(a.2, b.2),
                            (_u) => then(Ordered/cmp(a.3, b.3), (_u) => Ordered/cmp(a.4, b.4))))),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    @F: Type,
    use Ordered(A),
    use Ordered(B),
    use Ordered(C),
    use Ordered(D),
    use Ordered(E),
    use Ordered(F),
) => Ordered({A, B, C, D, E, F}) {
    cmp(a, b) =
        then(
            Ordered/cmp(a.0, b.0),
            (_u) =>
                then(
                    Ordered/cmp(a.1, b.1),
                    (_u) =>
                        then(
                            Ordered/cmp(a.2, b.2),
                            (_u) =>
                                then(
                                    Ordered/cmp(a.3, b.3),
                                    (_u) =>
                                        then(
                                            Ordered/cmp(a.4, b.4),
                                            (_u) => Ordered/cmp(a.5, b.5)))))),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    @F: Type,
    @G: Type,
    use Ordered(A),
    use Ordered(B),
    use Ordered(C),
    use Ordered(D),
    use Ordered(E),
    use Ordered(F),
    use Ordered(G),
) => Ordered({A, B, C, D, E, F, G}) {
    cmp(a, b) =
        then(
            Ordered/cmp(a.0, b.0),
            (_u) =>
                then(
                    Ordered/cmp(a.1, b.1),
                    (_u) =>
                        then(
                            Ordered/cmp(a.2, b.2),
                            (_u) =>
                                then(
                                    Ordered/cmp(a.3, b.3),
                                    (_u) =>
                                        then(
                                            Ordered/cmp(a.4, b.4),
                                            (_u) =>
                                                then(
                                                    Ordered/cmp(a.5, b.5),
                                                    (_u) => Ordered/cmp(a.6, b.6))))))),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    @F: Type,
    @G: Type,
    @H: Type,
    use Ordered(A),
    use Ordered(B),
    use Ordered(C),
    use Ordered(D),
    use Ordered(E),
    use Ordered(F),
    use Ordered(G),
    use Ordered(H),
) => Ordered({A, B, C, D, E, F, G, H}) {
    cmp(a, b) =
        then(
            Ordered/cmp(a.0, b.0),
            (_u) =>
                then(
                    Ordered/cmp(a.1, b.1),
                    (_u) =>
                        then(
                            Ordered/cmp(a.2, b.2),
                            (_u) =>
                                then(
                                    Ordered/cmp(a.3, b.3),
                                    (_u) =>
                                        then(
                                            Ordered/cmp(a.4, b.4),
                                            (_u) =>
                                                then(
                                                    Ordered/cmp(a.5, b.5),
                                                    (_u) =>
                                                        then(
                                                            Ordered/cmp(a.6, b.6),
                                                            (_u) => Ordered/cmp(a.7, b.7)))))))),
}

satisfy Test/Draw({}) {
    all() = Option/some([()]),
    draw(seed, _size) = ((), seed),
}

satisfy (@A: Type, use Test/Draw(A)) => Test/Draw({A}) {
    all() = Option/map(Test/Draw/all(@A)(), (xs) => List/map(xs, (a) => (a,))),
    draw(seed, size) =
        let (a, rest) = Test/Draw/draw(@A, seed, size);
        ((a,), rest),
}

satisfy (@A: Type, @B: Type, use Test/Draw(A), use Test/Draw(B)) => Test/Draw({A, B}) {
    all() =
        Option/bind(
            Test/Draw/all(@A)(),
            (xs) =>
                Option/map(
                    Test/Draw/all(@B)(),
                    (ys) => List/concat_map(xs, (a) => List/map(ys, (b) => (a, b))))),
    draw(seed, size) =
        let (a, after) = Test/Draw/draw(@A, seed, size);
        let (b, rest) = Test/Draw/draw(@B, after, size);
        ((a, b), rest),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    use Test/Draw(A),
    use Test/Draw(B),
    use Test/Draw(C),
) => Test/Draw({A, B, C}) {
    all() =
        Option/bind(
            Test/Draw/all(@A)(),
            (xs) =>
                Option/bind(
                    Test/Draw/all(@B)(),
                    (ys) =>
                        Option/map(
                            Test/Draw/all(@C)(),
                            (zs) =>
                                List/concat_map(
                                    xs,
                                    (a) =>
                                        List/concat_map(
                                            ys,
                                            (b) => List/map(zs, (c) => (a, b, c))))))),
    draw(seed, size) =
        let (a, first) = Test/Draw/draw(@A, seed, size);
        let (b, second) = Test/Draw/draw(@B, first, size);
        let (c, rest) = Test/Draw/draw(@C, second, size);
        ((a, b, c), rest),
}
