use /std/{Show, Spell, Equal, Ordered, Ordering, Str, Bool, List};

let parens(parts: List(Str)) -> Str =
    Str/concat("(", Str/concat(Str/join(", ", parts), ")"));

let then(first: Ordering, rest: ({}) -> Ordering) -> Ordering =
    match first | eq() => rest(()) | _ => first end;

satisfy Show({}) {
    show(_) = "()",
}

satisfy (@A: Type, use Show(A)) => Show({A}) {
    show(t) = Str/concat("(", Str/concat(Show/show(t.0), ",)")),
}

satisfy (@A: Type, @B: Type, use Show(A), use Show(B)) => Show({A, B}) {
    show(t) = parens([Show/show(t.0), Show/show(t.1)]),
}

satisfy (@A: Type, @B: Type, @C: Type, use Show(A), use Show(B), use Show(C)) => Show({A, B, C}) {
    show(t) = parens([Show/show(t.0), Show/show(t.1), Show/show(t.2)]),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    use Show(A),
    use Show(B),
    use Show(C),
    use Show(D),
) => Show({A, B, C, D}) {
    show(t) = parens([Show/show(t.0), Show/show(t.1), Show/show(t.2), Show/show(t.3)]),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    use Show(A),
    use Show(B),
    use Show(C),
    use Show(D),
    use Show(E),
) => Show({A, B, C, D, E}) {
    show(t) =
        parens([Show/show(t.0), Show/show(t.1), Show/show(t.2), Show/show(t.3), Show/show(t.4)]),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    @F: Type,
    use Show(A),
    use Show(B),
    use Show(C),
    use Show(D),
    use Show(E),
    use Show(F),
) => Show({A, B, C, D, E, F}) {
    show(t) =
        parens([
            Show/show(t.0),
            Show/show(t.1),
            Show/show(t.2),
            Show/show(t.3),
            Show/show(t.4),
            Show/show(t.5)]),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    @F: Type,
    @G: Type,
    use Show(A),
    use Show(B),
    use Show(C),
    use Show(D),
    use Show(E),
    use Show(F),
    use Show(G),
) => Show({A, B, C, D, E, F, G}) {
    show(t) =
        parens([
            Show/show(t.0),
            Show/show(t.1),
            Show/show(t.2),
            Show/show(t.3),
            Show/show(t.4),
            Show/show(t.5),
            Show/show(t.6)]),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    @F: Type,
    @G: Type,
    @H: Type,
    use Show(A),
    use Show(B),
    use Show(C),
    use Show(D),
    use Show(E),
    use Show(F),
    use Show(G),
    use Show(H),
) => Show({A, B, C, D, E, F, G, H}) {
    show(t) =
        parens([
            Show/show(t.0),
            Show/show(t.1),
            Show/show(t.2),
            Show/show(t.3),
            Show/show(t.4),
            Show/show(t.5),
            Show/show(t.6),
            Show/show(t.7)]),
}

satisfy Spell({}) {
    spell(_) = "()",
}

satisfy (@A: Type, use Spell(A)) => Spell({A}) {
    spell(t) = Str/concat("(", Str/concat(Spell/spell(t.0), ",)")),
}

satisfy (@A: Type, @B: Type, use Spell(A), use Spell(B)) => Spell({A, B}) {
    spell(t) = parens([Spell/spell(t.0), Spell/spell(t.1)]),
}

satisfy (@A: Type, @B: Type, @C: Type, use Spell(A), use Spell(B), use Spell(C)) => Spell(
    {A, B, C}) {
    spell(t) = parens([Spell/spell(t.0), Spell/spell(t.1), Spell/spell(t.2)]),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    use Spell(A),
    use Spell(B),
    use Spell(C),
    use Spell(D),
) => Spell({A, B, C, D}) {
    spell(t) = parens([Spell/spell(t.0), Spell/spell(t.1), Spell/spell(t.2), Spell/spell(t.3)]),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    use Spell(A),
    use Spell(B),
    use Spell(C),
    use Spell(D),
    use Spell(E),
) => Spell({A, B, C, D, E}) {
    spell(t) =
        parens([
            Spell/spell(t.0),
            Spell/spell(t.1),
            Spell/spell(t.2),
            Spell/spell(t.3),
            Spell/spell(t.4)]),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    @F: Type,
    use Spell(A),
    use Spell(B),
    use Spell(C),
    use Spell(D),
    use Spell(E),
    use Spell(F),
) => Spell({A, B, C, D, E, F}) {
    spell(t) =
        parens([
            Spell/spell(t.0),
            Spell/spell(t.1),
            Spell/spell(t.2),
            Spell/spell(t.3),
            Spell/spell(t.4),
            Spell/spell(t.5)]),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    @F: Type,
    @G: Type,
    use Spell(A),
    use Spell(B),
    use Spell(C),
    use Spell(D),
    use Spell(E),
    use Spell(F),
    use Spell(G),
) => Spell({A, B, C, D, E, F, G}) {
    spell(t) =
        parens([
            Spell/spell(t.0),
            Spell/spell(t.1),
            Spell/spell(t.2),
            Spell/spell(t.3),
            Spell/spell(t.4),
            Spell/spell(t.5),
            Spell/spell(t.6)]),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    @F: Type,
    @G: Type,
    @H: Type,
    use Spell(A),
    use Spell(B),
    use Spell(C),
    use Spell(D),
    use Spell(E),
    use Spell(F),
    use Spell(G),
    use Spell(H),
) => Spell({A, B, C, D, E, F, G, H}) {
    spell(t) =
        parens([
            Spell/spell(t.0),
            Spell/spell(t.1),
            Spell/spell(t.2),
            Spell/spell(t.3),
            Spell/spell(t.4),
            Spell/spell(t.5),
            Spell/spell(t.6),
            Spell/spell(t.7)]),
}

satisfy Equal({}) {
    eql(_, _) = true,
    neq(_, _) = false,
}

satisfy (@A: Type, use Equal(A)) => Equal({A}) {
    eql(a, b) = a.0 == b.0,
    neq(a, b) = Bool/not(a == b),
}

satisfy (@A: Type, @B: Type, use Equal(A), use Equal(B)) => Equal({A, B}) {
    eql(a, b) = a.0 == b.0 && a.1 == b.1,
    neq(a, b) = Bool/not(a == b),
}

satisfy (@A: Type, @B: Type, @C: Type, use Equal(A), use Equal(B), use Equal(C)) => Equal(
    {A, B, C}) {
    eql(a, b) = a.0 == b.0 && a.1 == b.1 && a.2 == b.2,
    neq(a, b) = Bool/not(a == b),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    use Equal(A),
    use Equal(B),
    use Equal(C),
    use Equal(D),
) => Equal({A, B, C, D}) {
    eql(a, b) = a.0 == b.0 && a.1 == b.1 && a.2 == b.2 && a.3 == b.3,
    neq(a, b) = Bool/not(a == b),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    use Equal(A),
    use Equal(B),
    use Equal(C),
    use Equal(D),
    use Equal(E),
) => Equal({A, B, C, D, E}) {
    eql(a, b) = a.0 == b.0 && a.1 == b.1 && a.2 == b.2 && a.3 == b.3 && a.4 == b.4,
    neq(a, b) = Bool/not(a == b),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    @F: Type,
    use Equal(A),
    use Equal(B),
    use Equal(C),
    use Equal(D),
    use Equal(E),
    use Equal(F),
) => Equal({A, B, C, D, E, F}) {
    eql(a, b) = a.0 == b.0 && a.1 == b.1 && a.2 == b.2 && a.3 == b.3 && a.4 == b.4 && a.5 == b.5,
    neq(a, b) = Bool/not(a == b),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    @F: Type,
    @G: Type,
    use Equal(A),
    use Equal(B),
    use Equal(C),
    use Equal(D),
    use Equal(E),
    use Equal(F),
    use Equal(G),
) => Equal({A, B, C, D, E, F, G}) {
    eql(a, b) =
        a.0 == b.0 && a.1 == b.1 && a.2 == b.2 && a.3 == b.3 && a.4 == b.4 && a.5 == b.5
            && a.6 == b.6,
    neq(a, b) = Bool/not(a == b),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    @F: Type,
    @G: Type,
    @H: Type,
    use Equal(A),
    use Equal(B),
    use Equal(C),
    use Equal(D),
    use Equal(E),
    use Equal(F),
    use Equal(G),
    use Equal(H),
) => Equal({A, B, C, D, E, F, G, H}) {
    eql(a, b) =
        a.0 == b.0 && a.1 == b.1 && a.2 == b.2 && a.3 == b.3 && a.4 == b.4 && a.5 == b.5
            && a.6 == b.6
            && a.7 == b.7,
    neq(a, b) = Bool/not(a == b),
}

satisfy Ordered({}) {
    cmp(_, _) = Ordering/eq(),
}

satisfy (@A: Type, use Ordered(A)) => Ordered({A}) {
    cmp(a, b) = Ordered/cmp(a.0, b.0),
}

satisfy (@A: Type, @B: Type, use Ordered(A), use Ordered(B)) => Ordered({A, B}) {
    cmp(a, b) = then(Ordered/cmp(a.0, b.0), (_) => Ordered/cmp(a.1, b.1)),
}

satisfy (@A: Type, @B: Type, @C: Type, use Ordered(A), use Ordered(B), use Ordered(C)) => Ordered(
    {A, B, C}) {
    cmp(a, b) =
        then(
            Ordered/cmp(a.0, b.0),
            (_) => then(Ordered/cmp(a.1, b.1), (_) => Ordered/cmp(a.2, b.2))),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    use Ordered(A),
    use Ordered(B),
    use Ordered(C),
    use Ordered(D),
) => Ordered({A, B, C, D}) {
    cmp(a, b) =
        then(
            Ordered/cmp(a.0, b.0),
            (_) =>
                then(
                    Ordered/cmp(a.1, b.1),
                    (_) => then(Ordered/cmp(a.2, b.2), (_) => Ordered/cmp(a.3, b.3)))),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    use Ordered(A),
    use Ordered(B),
    use Ordered(C),
    use Ordered(D),
    use Ordered(E),
) => Ordered({A, B, C, D, E}) {
    cmp(a, b) =
        then(
            Ordered/cmp(a.0, b.0),
            (_) =>
                then(
                    Ordered/cmp(a.1, b.1),
                    (_) =>
                        then(
                            Ordered/cmp(a.2, b.2),
                            (_) => then(Ordered/cmp(a.3, b.3), (_) => Ordered/cmp(a.4, b.4))))),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    @F: Type,
    use Ordered(A),
    use Ordered(B),
    use Ordered(C),
    use Ordered(D),
    use Ordered(E),
    use Ordered(F),
) => Ordered({A, B, C, D, E, F}) {
    cmp(a, b) =
        then(
            Ordered/cmp(a.0, b.0),
            (_) =>
                then(
                    Ordered/cmp(a.1, b.1),
                    (_) =>
                        then(
                            Ordered/cmp(a.2, b.2),
                            (_) =>
                                then(
                                    Ordered/cmp(a.3, b.3),
                                    (_) =>
                                        then(
                                            Ordered/cmp(a.4, b.4),
                                            (_) => Ordered/cmp(a.5, b.5)))))),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    @F: Type,
    @G: Type,
    use Ordered(A),
    use Ordered(B),
    use Ordered(C),
    use Ordered(D),
    use Ordered(E),
    use Ordered(F),
    use Ordered(G),
) => Ordered({A, B, C, D, E, F, G}) {
    cmp(a, b) =
        then(
            Ordered/cmp(a.0, b.0),
            (_) =>
                then(
                    Ordered/cmp(a.1, b.1),
                    (_) =>
                        then(
                            Ordered/cmp(a.2, b.2),
                            (_) =>
                                then(
                                    Ordered/cmp(a.3, b.3),
                                    (_) =>
                                        then(
                                            Ordered/cmp(a.4, b.4),
                                            (_) =>
                                                then(
                                                    Ordered/cmp(a.5, b.5),
                                                    (_) => Ordered/cmp(a.6, b.6))))))),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    @F: Type,
    @G: Type,
    @H: Type,
    use Ordered(A),
    use Ordered(B),
    use Ordered(C),
    use Ordered(D),
    use Ordered(E),
    use Ordered(F),
    use Ordered(G),
    use Ordered(H),
) => Ordered({A, B, C, D, E, F, G, H}) {
    cmp(a, b) =
        then(
            Ordered/cmp(a.0, b.0),
            (_) =>
                then(
                    Ordered/cmp(a.1, b.1),
                    (_) =>
                        then(
                            Ordered/cmp(a.2, b.2),
                            (_) =>
                                then(
                                    Ordered/cmp(a.3, b.3),
                                    (_) =>
                                        then(
                                            Ordered/cmp(a.4, b.4),
                                            (_) =>
                                                then(
                                                    Ordered/cmp(a.5, b.5),
                                                    (_) =>
                                                        then(
                                                            Ordered/cmp(a.6, b.6),
                                                            (_) => Ordered/cmp(a.7, b.7)))))))),
}
