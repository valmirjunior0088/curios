use /std/{Nat, Int, Flt, Bool, Str, List, Map};

-- | A calendar date.
pub struct Date: pub Type {
    year: Nat,
    month: Nat,
    day: Nat,
}

-- | A time of day, to the nanosecond.
pub struct Time: pub Type {
    hour: Nat,
    minute: Nat,
    second: Nat,
    nanosecond: Nat,
}

-- | A date and time at an offset from UTC, in minutes.
pub struct OffsetDateTime: pub Type {
    date: Date,
    time: Time,
    offset_minutes: Int,
}

-- | A date and time with no offset.
pub struct LocalDateTime: pub Type {
    date: Date,
    time: Time,
}

-- | A TOML value.
pub induct Toml: pub Type
| str(Str)
| int(Int)
| flt(Flt)
| bool(Bool)
| offset_date_time(OffsetDateTime)
| local_date_time(LocalDateTime)
| local_date(Date)
| local_time(Time)
| arr(List(Toml))
| table(Map(Toml))
end

pub use Toml/*;

induct Seg: Type
| plain(Str)
| at(name: Str, index: Nat)
end

induct Origin: Type
| header()
| implicit()
| dotted()
| inline()
| many()
end

struct Build: Type {
    root: Map(Toml),
    side: Map(Origin),
    scope: List(Seg),
}

-- | Why a document did not decode or a table did not encode.
pub mod Error;
pub use Error/{let Error};

mod calendar;

mod build;

mod scan;

mod strings;

mod keys;

mod numbers;

mod datetime;

mod values;

mod decode;
pub use decode/{decode};

mod encode;
pub use encode/{encode};
