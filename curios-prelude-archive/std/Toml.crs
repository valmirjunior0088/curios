use /std/{Nat, Int, Flt, Bool, Str, List, Map};

-- | A calendar date, and the bound its fields carry.
pub mod Date;
pub use Date/{let Date};

-- | A time of day, and the bound its fields carry.
pub mod Time;
pub use Time/{let Time};

-- | A moment at an offset from UTC, and the bound that offset carries.
pub mod OffsetDateTime;
pub use OffsetDateTime/{let OffsetDateTime};

-- | A date and time with no offset.
pub struct LocalDateTime: pub Type {
    date: Date,
    time: Time,
}

-- | A TOML value.
pub induct Toml: pub Type
-- | A string.
| str(Str)
-- | An integer.
| int(Int)
-- | A float.
| flt(Flt)
-- | `true` or `false`.
| bool(Bool)
-- | A date and time with an offset from UTC.
| offset_date_time(OffsetDateTime)
-- | A date and time with no offset.
| local_date_time(LocalDateTime)
-- | A date alone.
| local_date(Date)
-- | A time of day alone.
| local_time(Time)
-- | An array, in order.
| arr(List(Toml))
-- | A table, by key.
| table(Map(Toml))
end

pub use Toml/*;

induct Seg: Type
| plain(Str)
| at(name: Str, index: Nat)
end

induct Origin: Type
| header()
| implicit()
| dotted()
| inline()
| many()
end

struct Build: Type {
    root: Map(Toml),
    side: Map(Origin),
    scope: List(Seg),
}

-- | Why a document did not decode or a table did not encode.
pub mod Error;
pub use Error/{let Error};

mod build;

mod scan;

mod strings;

mod keys;

mod numbers;

mod datetime;

mod values;

mod decode;
pub use decode/{decode};

mod encode;
pub use encode/{encode};
