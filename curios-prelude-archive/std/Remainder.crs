-- | Remainder, which `%` dispatches through.
pub concept Remainder(A: Type): pub Type {
    -- | The precondition this carrier states for a divisor, as `Divide`'s is.
    Ok(A) -> Prop,
    -- | What is left of `a` once `b` has been taken from it as often as it goes.
    rem(a: A, b: A, @ok: Ok(b)) -> A,
}

pub use Remainder/{rem};
