use /std/{Nat, Bool, Str, Io, Show};
use /std/ops/{Eql};
use /std/time/{Duration};

--- A moment, as seconds since the Unix epoch.
pub struct Timestamp: Type {
    secs: Nat,
    nanos: Nat,
}

--- The moment `secs` seconds and `nanos` nanoseconds after the epoch, with nanoseconds past a second carried.
pub let of_unix(secs: Nat, nanos: Nat) -> Timestamp =
    Timestamp { secs = secs + nanos / 1000000000, nanos = nanos % 1000000000 };

--- The wall clock now.
pub let now() -> Io(Timestamp) =
    let r = /sys/clock/wall!;
    Io/pure(of_unix(r.secs, r.nanos));

--- The seconds since the epoch, and the nanoseconds within the second.
pub let to_unix(t: Timestamp) -> {secs: Nat, nanos: Nat} =
    (secs = t.secs, nanos = t.nanos);

--- Whether `a` is earlier than `b`.
pub let before(a: Timestamp, b: Timestamp) -> Bool =
    choose
    | a.secs < b.secs => true
    | a.secs > b.secs => false
    | _ => a.nanos < b.nanos
    end;

let total_nanos(t: Timestamp) -> Nat =
    t.secs * 1000000000 + t.nanos;

--- `a - b` as a duration, and zero when `a` is not after `b`.
pub let diff(a: Timestamp, b: Timestamp) -> Duration =
    Duration/of(0, total_nanos(a) - total_nanos(b));

satisfy Eql(Timestamp);

--- `secs.nanos`, the nanoseconds padded to nine digits.
satisfy Show(Timestamp) {
    show(t) = Str/flatten([Nat/to_str(t.secs), ".", Str/pad_start(Nat/to_str(t.nanos), 9, '0')]),
}
