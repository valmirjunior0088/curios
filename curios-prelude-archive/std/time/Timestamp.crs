use /std/{Nat, Bool, Str, Io, Equal, Show};
use /std/time/{Duration};

-- | A moment, as seconds since the Unix epoch.
pub struct Timestamp: Type {
    secs_hi: Nat,
    secs_lo: Nat,
    nanos: Nat,
}

-- | The moment at `secs_hi` billion plus `secs_lo` seconds and `nanos` nanoseconds since the epoch, with overflowing limbs carried.
pub let of_unix(secs_hi: Nat, secs_lo: Nat, nanos: Nat) -> Timestamp =
    let lo = secs_lo + nanos / 1000000000;
    Timestamp {
        secs_hi = secs_hi + lo / 1000000000,
        secs_lo = lo % 1000000000,
        nanos = nanos % 1000000000,
    };

-- | The wall clock now.
pub let now() -> Io(Timestamp) =
    let r = /sys/clock/wall!;
    Io/pure(of_unix(r.secs_hi, r.secs_lo, r.nanos));

-- | The seconds since the epoch, as two base-billion limbs, and the nanoseconds within the second.
pub let to_unix(t: Timestamp) -> {secs_hi: Nat, secs_lo: Nat, nanos: Nat} =
    (secs_hi = t.secs_hi, secs_lo = t.secs_lo, nanos = t.nanos);

-- | Whether `a` is earlier than `b`.
pub let before(a: Timestamp, b: Timestamp) -> Bool =
    choose
    | a.secs_hi < b.secs_hi => true
    | a.secs_hi > b.secs_hi => false
    | a.secs_lo < b.secs_lo => true
    | a.secs_lo > b.secs_lo => false
    | _ => a.nanos < b.nanos
    end;

let sub_digit(x: Nat, y: Nat) -> {digit: Nat, borrow: Nat} =
    match x < y
    | true => (digit = x + 1000000000 - y, borrow = 1)
    | false => (digit = x - y, borrow = 0)
    end;

-- | `a - b` as a duration, and zero when `a` is not after `b`.
pub let diff(a: Timestamp, b: Timestamp) -> Duration =
    match before(a, b)
    | true => Duration/zero
    | false =>
        let d_nanos = sub_digit(a.nanos, b.nanos);
        let d_lo = sub_digit(a.secs_lo, b.secs_lo + d_nanos.borrow);
        let r_hi = a.secs_hi - (b.secs_hi + d_lo.borrow);
        Duration/of(r_hi * 1000000000 + d_lo.digit, d_nanos.digit)
    end;

satisfy Equal(Timestamp);

-- | `secs.nanos`, the nanoseconds padded to nine digits.
satisfy Show(Timestamp) {
    show(t) =
        let secs =
            match t.secs_hi == 0
            | true => Nat/to_str(t.secs_lo)
            | false =>
                Str/concat(Nat/to_str(t.secs_hi), Str/pad_start(Nat/to_str(t.secs_lo), 9, '0'))
            end;
        Str/flatten([secs, ".", Str/pad_start(Nat/to_str(t.nanos), 9, '0')]),
}
