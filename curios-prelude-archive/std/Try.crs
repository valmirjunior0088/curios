-- The error channel over a monad: a `Try(M, E, A)` is an `M(Result(E, A))` sequenced so that a failure stops the region. `!` on a `Result` is early return inside any `M`, `raise` stops, `rescue` handles the stop, `attempt` admits an `M(Result(E, A))` and `run` hands one back at the boundary. The parameter order is deliberate: the base monad and the error are the context a region fixes, and the value sits last so the family partially applies as a monad, `(A: Type) => Try(M, E, A)`. The edges below are what make a `Try` region ergonomic — a bare `Result`, an action of the base, an `Io` action where the base admits one, and a `Try` over a base that embeds all sequence with `!` — and each is written once for every base, since a premise on the base is what a witness needs rather than a witness per base. See `documentation/design/language/a-fallible-operation-returns-try.md`.
use /std/{Monad, Lift, Result, Io, Async};

pub struct Try(M: (Type) -> Type, E: Type, A: Type): Type {
    M(Result(E, A)),
}

pub let pure(@M: (Type) -> Type, @E: Type, @A: Type, use Monad(M), a: A) -> Try(M, E, A) =
    Try { Monad/pure(Result/success(a)) };

pub let raise(@M: (Type) -> Type, @E: Type, @A: Type, use Monad(M), e: E) -> Try(M, E, A) =
    Try { Monad/pure(Result/failure(e)) };

pub let bind(
    @M: (Type) -> Type,
    @E: Type,
    @A: Type,
    @B: Type,
    use Monad(M),
    m: Try(M, E, A),
    f: (A) -> Try(M, E, B),
) -> Try(M, E, B) =
    Try {
        Monad/bind(
            m.0,
            (r: Result(E, A)) =>
                match r | success(a) => f(a).0 | failure(e) => Monad/pure(Result/failure(e)) end),
    };

-- An `M(Result(E, A))` as a `Try`: the seam a host wrapper crosses when its row answers a status.
pub let attempt(@M: (Type) -> Type, @E: Type, @A: Type, m: M(Result(E, A))) -> Try(M, E, A) =
    Try { m };

-- The boundary: the base action with its outcome as data, for the region that decides what a failure means.
pub let run(@M: (Type) -> Type, @E: Type, @A: Type, m: Try(M, E, A)) -> M(Result(E, A)) =
    m.0;

pub let rescue(
    @M: (Type) -> Type,
    @E: Type,
    @A: Type,
    use Monad(M),
    m: Try(M, E, A),
    handler: (E) -> Try(M, E, A),
) -> Try(M, E, A) =
    Try {
        Monad/bind(
            m.0,
            (r: Result(E, A)) =>
                match r | success(_) => Monad/pure(r) | failure(e) => handler(e).0 end),
    };

pub let map_error(
    @M: (Type) -> Type,
    @E: Type,
    @F: Type,
    @A: Type,
    use Monad(M),
    m: Try(M, E, A),
    f: (E) -> F,
) -> Try(M, F, A) =
    Try { Monad/bind(m.0, (r: Result(E, A)) => Monad/pure(Result/map_failure(r, f))) };

satisfy (@M: (Type) -> Type, @E: Type, use Monad(M)) => Monad((A: Type) => Try(M, E, A)) {
    pure(@A, a) = pure(a),
    bind(@A, @B, m, f) = bind(m, f),
}

-- A bare `Result` in a `Try` region is early return over the base.
satisfy (@M: (Type) -> Type, @E: Type, use Monad(M)) => Lift(
    (A: Type) => Result(E, A),
    (A: Type) => Try(M, E, A)) {
    lift(@A, r) = Try { Monad/pure(r) },
}

-- An `Io` action in a `Try` region over any base that admits one: the premise is what makes one witness serve every base — `Lift(Io, Io)` for `Try(Io, E)`, `Lift(Io, Async)` for `Try(Async, E)`.
satisfy (@M: (Type) -> Type, @E: Type, use Monad(M), use Lift(Io, M)) => Lift(
    Io,
    (A: Type) => Try(M, E, A)) {
    lift(@A, m) = Try { Monad/bind(Lift/lift(m), (a: A) => Monad/pure(Result/success(a))) },
}

-- An `Async` action in a `Try` region over `Async`, or over any base `Async` embeds in.
satisfy (@M: (Type) -> Type, @E: Type, use Monad(M), use Lift(Async, M)) => Lift(
    Async,
    (A: Type) => Try(M, E, A)) {
    lift(@A, m) = Try { Monad/bind(Lift/lift(m), (a: A) => Monad/pure(Result/success(a))) },
}

-- A `Try` over one base in a `Try` over another the first embeds in: `Try(Io, E)` inside `Try(Async, E)`.
satisfy (
    @M: (Type) -> Type,
    @N: (Type) -> Type,
    @E: Type,
    use Monad(M),
    use Monad(N),
    use Lift(M, N)) => Lift((A: Type) => Try(M, E, A), (A: Type) => Try(N, E, A)) {
    lift(@A, m) = Try { Lift/lift(m.0) },
}
