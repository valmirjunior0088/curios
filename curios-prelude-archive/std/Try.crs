use /std/{Monad, Lift, Result, Io, Async};

-- | An `M(Result(E, A))` sequenced so that a failure stops the region.
pub struct Try(M: (Type) -> Type, E: Type, A: Type): Type {
    M(Result(E, A)),
}

-- | `a` as a success.
pub let pure(@M: (Type) -> Type, @E: Type, @A: Type, use Monad(M), a: A) -> Try(M, E, A) =
    Try { Monad/pure(Result/success(a)) };

-- | `e` as a failure, which stops the region.
pub let raise(@M: (Type) -> Type, @E: Type, @A: Type, use Monad(M), e: E) -> Try(M, E, A) =
    Try { Monad/pure(Result/failure(e)) };

-- | `f` on the value of a success; a failure passes through.
pub let bind(
    @M: (Type) -> Type,
    @E: Type,
    @A: Type,
    @B: Type,
    use Monad(M),
    m: Try(M, E, A),
    f: (A) -> Try(M, E, B),
) -> Try(M, E, B) =
    Try {
        Monad/bind(m.0, (r: Result(E, A)) =>
            match r | success(a) => f(a).0 | failure(e) => Monad/pure(Result/failure(e)) end),
    };

-- | An `M(Result(E, A))` as a `Try`.
pub let attempt(@M: (Type) -> Type, @E: Type, @A: Type, m: M(Result(E, A))) -> Try(M, E, A) =
    Try { m };

-- | The base action with its outcome as data.
pub let run(@M: (Type) -> Type, @E: Type, @A: Type, m: Try(M, E, A)) -> M(Result(E, A)) =
    m.0;

-- | A failure handed to `handler`; a success passes through.
pub let rescue(
    @M: (Type) -> Type,
    @E: Type,
    @A: Type,
    use Monad(M),
    m: Try(M, E, A),
    handler: (E) -> Try(M, E, A),
) -> Try(M, E, A) =
    Try {
        Monad/bind(m.0, (r: Result(E, A)) =>
            match r | success(_) => Monad/pure(r) | failure(e) => handler(e).0 end),
    };

-- | `f` on the error of a failure.
pub let map_error(
    @M: (Type) -> Type,
    @E: Type,
    @F: Type,
    @A: Type,
    use Monad(M),
    m: Try(M, E, A),
    f: (E) -> F,
) -> Try(M, F, A) =
    Try { Monad/bind(m.0, (r: Result(E, A)) => Monad/pure(Result/map_failure(r, f))) };

satisfy (@M: (Type) -> Type, @E: Type, use Monad(M)) => Monad((A: Type) => Try(M, E, A)) {
    pure(@_A, a) = pure(a),
    bind(@_A, @_B, m, f) = bind(m, f),
}

-- | A bare `Result` in a `Try` region is early return.
satisfy (@M: (Type) -> Type, @E: Type, use Monad(M)) => Lift(
    (A: Type) => Result(E, A),
    (A: Type) => Try(M, E, A)) {
    lift(@_A, r) = Try { Monad/pure(r) },
}

-- | An `Io` action in a `Try` region over any base that admits one.
satisfy (@M: (Type) -> Type, @E: Type, use Monad(M), use Lift(Io, M)) => Lift(
    Io,
    (A: Type) => Try(M, E, A)) {
    lift(@A, m) = Try { Monad/bind(Lift/lift(m), (a: A) => Monad/pure(Result/success(a))) },
}

-- | An `Async` action in a `Try` region over `Async`, or over any base `Async` embeds in.
satisfy (@M: (Type) -> Type, @E: Type, use Monad(M), use Lift(Async, M)) => Lift(
    Async,
    (A: Type) => Try(M, E, A)) {
    lift(@A, m) = Try { Monad/bind(Lift/lift(m), (a: A) => Monad/pure(Result/success(a))) },
}

-- | A `Try` over one base in a `Try` over another the first embeds in.
satisfy (
    @M: (Type) -> Type,
    @N: (Type) -> Type,
    @E: Type,
    use Monad(M),
    use Monad(N),
    use Lift(M, N),
) => Lift((A: Type) => Try(M, E, A), (A: Type) => Try(N, E, A)) {
    lift(@_A, m) = Try { Lift/lift(m.0) },
}
