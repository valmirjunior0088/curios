use /std/{Bytes, Byte, Char, Str, Nat, Bool, List, Option, Result, Parse, Spell};
use /std/Bool/{True, False};
use /std/ops/{Eql};

--- The scheme, which decides the port when none is written and whether the connection is under TLS.
pub induct Scheme: pub Type
--- `http`: port 80 where none is written, and in the clear.
| http()
--- `https`: port 443 where none is written, and under TLS.
| https()
end

pub use Scheme/*;

satisfy Eql(Scheme);

satisfy Spell(Scheme);

--- Where a request goes: the scheme, the host, the port, the path, and the query as written after `?`, if any. A fragment is the client's and is dropped.
pub struct Url: pub Type {
    scheme: Scheme,
    host: Str,
    port: Nat,
    path: Str,
    query: Option(Str),
}

satisfy Eql(Url);

satisfy Spell(Url);

--- The port a scheme implies.
pub let default_port(s: Scheme) -> Nat =
    match s | http() => 80 | https() => 443 end;

let until(stops: List(Byte)) -> (Byte) -> Bool =
    (byte) => Bool/not(List/any(stops, (stop) => byte == stop));

let text(b: Bytes) -> Parse(Bytes, Str) =
    match Str/of_bytes(b) | some(s) => Parse/pure(s) | none() => Parse/fail("a URL is text") end;

let scheme: Parse(Bytes, Scheme) =
    let name = Parse/bytes/take_while(until([':']))!;
    let _ = Parse/bytes/literal("://")!;
    let s = text(name)!;
    choose
    | Str/eql_ascii_ci(s, "http") => Parse/pure(Scheme/http())
    | Str/eql_ascii_ci(s, "https") => Parse/pure(Scheme/https())
    | _ => Parse/fail(Str/flatten(["unknown scheme '", s, "'"]))
    end;

let is_digit(byte: Byte) -> Bool =
    Nat/in_range(Byte/to_nat(byte), '0', '9');

-- Whether the authority ends here: at the path, the query, the fragment, or the end of the text.
let ends_authority(next: Option(Byte)) -> Bool =
    match next
    | some(b) =>
        match Byte/to_nat(b)
        | '/' => true
        | '?' => true
        | '#' => true
        | _ => false
        end
    | none() => true
    end;

-- The port after a `:`: its digits up to where the authority ends. None is the scheme's, as RFC 3986 §3.2.3 reads an empty port, and a number no port holds is refused here rather than at the connection.
let port_number(s: Scheme) -> Parse(Bytes, Nat) =
    let _ = Parse/bytes/expect(':')!;
    let digits = Parse/bytes/take_while(is_digit)!;
    let next = Parse/bytes/peek!;
    match ends_authority(next)
    | false => Parse/fail("a port is a number")
    | true =>
        match Bytes/len(digits) == 0
        | true => Parse/pure(default_port(s))
        | false =>
            let spelled = text(digits)!;
            match Nat/of_str(spelled)
            | some(n) =>
                match n <= 65535
                | true => Parse/pure(n)
                | false => Parse/fail("a port is at most 65535")
                end
            | none() => Parse/fail("a port is a number")
            end
        end
    end;

let port_of(s: Scheme) -> Parse(Bytes, Nat) =
    let next = Parse/bytes/peek!;
    match next
    | some(b) => match Byte/to_nat(b) | ':' => port_number(s) | _ => Parse/pure(default_port(s)) end
    | none() => Parse/pure(default_port(s))
    end;

let path: Parse(Bytes, Str) =
    let b = Parse/bytes/take_while(until(['?', '#']))!;
    let s = text(b)!;
    match Str/is_empty(s) | true => Parse/pure("/") | false => Parse/pure(s) end;

let query_text: Parse(Bytes, Option(Str)) =
    let _ = Parse/bytes/expect('?')!;
    let b = Parse/bytes/take_while(until(['#']))!;
    let s = text(b)!;
    Parse/pure(Option/some(s));

let query: Parse(Bytes, Option(Str)) =
    let next = Parse/bytes/peek!;
    match next
    | some(b) => match Byte/to_nat(b) | '?' => query_text | _ => Parse/pure(Option/none()) end
    | none() => Parse/pure(Option/none())
    end;

let url: Parse(Bytes, Url) =
    let s = scheme!;
    let h = Parse/bytes/take_while(until([':', '/', '?', '#']))!;
    let host = text(h)!;
    let p = port_of(s)!;
    let pa = path!;
    let q = query!;
    let _ = Parse/bytes/rest!;
    match Str/is_empty(host)
    | true => Parse/fail("a URL names a host")
    | false => Parse/pure(Url { scheme = s, host = host, port = p, path = pa, query = q })
    end;

--- `s` read as a URL, or why it is not: a scheme other than `http` and `https`, a missing host, or a port that is no number of at most 65535. A port left empty, as in `http://h:/`, is the scheme's.
pub let of_str(s: Str) -> Result(Parse/Error, Url) =
    Parse/run(url, Str/to_bytes(s));

--- That `r` is a URL that read.
pub let Read(r: Result(Parse/Error, Url)) -> Prop =
    match r | success(_) => True | failure(_) => False end;

--- That `s` reads as a URL, decided by reduction: a literal that does not is refused where it is written.
pub let Valid(s: Str) -> Prop =
    Read(of_str(s));

--- The URL the literal `s` spells, at no cost at run time beyond the read.
pub let lit(s: Str, @ok: Valid(s)) -> Url =
    match of_str(s): (r) => (Read(r)) -> Url
    | success(u) => (_) => u
    | failure(_) => (absent) => match absent end
    end(ok);

let scheme_str(s: Scheme) -> Str =
    match s | http() => "http" | https() => "https" end;

let port_str(u: Url) -> Str =
    match u.port == default_port(u.scheme)
    | true => ""
    | false => Str/concat(":", Nat/to_str(u.port))
    end;

let query_str(q: Option(Str)) -> Str =
    match q | some(s) => Str/concat("?", s) | none() => "" end;

--- The URL as text.
pub let to_str(u: Url) -> Str =
    Str/flatten([scheme_str(u.scheme), "://", u.host, port_str(u), u.path, query_str(u.query)]);

--- The path's segments, for a server to match on: `/a/b/` is `["a", "b"]`.
pub let segments(u: Url) -> List(Str) =
    List/filter(Str/split(u.path, "/"), (s) => Bool/not(Str/is_empty(s)));

--- The hexadecimal digit of the nibble `n`, uppercase as a percent-encoding is written.
let hex_digit(n: Nat) -> Str =
    Str/of_char(Char/to_ascii_upper(Char/hex_digit(n)));

let unreserved(n: Nat) -> Bool =
    Nat/in_range(n, 'a', 'z') || Nat/in_range(n, 'A', 'Z') || Nat/in_range(n, '0', '9') || n == '-'
        || n == '_'
        || n == '.'
        || n == '~';

--- What a character is written as in a percent-encoded component, when it is not written as itself: each of its UTF-8 bytes as `%XX`.
let percent(c: Char) -> Option(Str) =
    match unreserved(Char/to_nat(c))
    | true => Option/none()
    | false =>
        Option/some(
            Str/flatten(
                Bytes/fold(
                    Char/to_utf8(c),
                    [],
                    (byte, acc) =>
                        let n = Byte/to_nat(byte);
                        [..acc, "%", hex_digit(n / 16), hex_digit(n % 16)])))
    end;

--- `component` percent-encoded: every character but the unreserved ones as the `%XX` of each of its bytes.
pub let encode(component: Str) -> Str =
    Str/escape(component, percent);

-- The digit travels with the evidence that it is one, because the caller combines two of them into a byte and reduction cannot see a bound a guard established. Deciding the range once is what produces both: the ladder yields a value `16` for anything that is not a hex digit, and the single comparison below is at once the refusal and the proof. Masking the digit instead would state a width this encoding does not have — a hex digit is four bits because of what it is, not because of where it is stored.
let hex_value(byte: Byte) -> Option({v: Nat, ok: Nat/Lt(v, 16)}) =
    let n = Byte/to_nat(byte);
    let digit =
        choose
        | Nat/in_range(n, '0', '9') => n - '0'
        | Nat/in_range(n, 'a', 'f') => n - 'a' + 10
        | Nat/in_range(n, 'A', 'F') => n - 'A' + 10
        | _ => 16
        end;
    match Nat/Lt/try(digit, 16)
    | some(ok) => Option/some((v = digit, ok = ok))
    | none() => Option/none()
    end;

let decode_at(b: Bytes, i: Nat, acc: Bytes, fuel: Nat) -> Option(Bytes) =
    match fuel
    | 0 => Option/some(acc)
    | rest + 1 =>
        match Bytes/try_get(b, i)
        | none() => Option/some(acc)
        | some(byte) =>
            match Byte/to_nat(byte)
            | '+' => decode_at(b, i + 1, x[..acc, ' '], rest)
            | '%' =>
                match (
                    Option/bind(Bytes/try_get(b, i + 1), hex_value),
                    Option/bind(Bytes/try_get(b, i + 2), hex_value))
                | (some(hi), some(lo)) =>
                    decode_at(b, i + 3, x[..acc, Nat/to_byte(hi.v * 16 + lo.v)], rest)
                | (some(_), none()) => Option/none()
                | (none(), _) => Option/none()
                end
            | _ => decode_at(b, i + 1, x[..acc, byte], rest)
            end
        end
    end;

--- `component` percent-decoded, `+` read as a space, or `none` when an escape is malformed or the result is not text.
pub let decode(component: Str) -> Option(Str) =
    let b = Str/to_bytes(component);
    Option/bind(decode_at(b, 0, x[], Bytes/len(b) + 1), Str/of_bytes);

--- The query as decoded pairs: `a=1&b=x+y` is `[("a", "1"), ("b", "x y")]`. A pair without `=` is a name with an empty value, as the form encoding reads it, and a pair that does not decode is dropped.
pub let query_pairs(u: Url) -> List({Str, Str}) =
    match u.query
    | none() => []
    | some(q) =>
        List/filter_map(
            Str/split(q, "&"),
            (pair) =>
                let (name, value) = Option/unwrap_or(Str/split_once(pair, "="), (pair, ""));
                match (decode(name), decode(value))
                | (some(n), some(v)) => Option/some((n, v))
                | (some(_), none()) => Option/none()
                | (none(), _) => Option/none()
                end)
    end;

--- `u` with `pairs` as its query, each name and value encoded.
pub let with_query(u: Url, pairs: List({Str, Str})) -> Url =
    match pairs
    | [] => Url { ..u, query = Option/none() }
    | _ =>
        Url {
            ..u,
            query =
                Option/some(
                    Str/join(
                        "&",
                        List/map(pairs, ((name, value)) =>
                            Str/flatten([encode(name), "=", encode(value)])))),
        }
    end;
