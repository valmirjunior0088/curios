pub use /sys/{Int};
pub use /sys/Int/{eql, neq, add, sub, mul, div, rem, lt, gt, lte, gte, and, or, xor, shl, shr, rotl,
    rotr, clz, ctz, popcnt, to_nat, to_flt};
use /std/{Nat, Str, Option, Order, Eql, Cmp, Add, Sub, Mul, Div, Rem, Show, Ord, True, False};

pub let to_str(n: Int) -> Str =
    let mag = Nat/to_str(abs(n));
    match n >= +0 | true => Str/concat("+", mag) | false => Str/concat("-", mag) end;

pub let not(x: Int) -> Int =
    xor(x, -1);

pub let of_str(s: Str) -> Option(Int) =
    match Str/is_empty(s)
    | true => Option/none()
    | false =>
        let first = Str/get(s, 0)!;
        let digits =
            match first == '+' || first == '-'
            | true => Str/slice(s, 1, Str/len(s))
            | false => s
            end;
        let negative = first == '-';
        let n = Nat/of_str(digits)!;
        match negative
        | true => Option/some(+0 - Nat/to_int(n))
        | false => Option/some(Nat/to_int(n))
        end
    end;

-- The procedure that decides `0 <= n`, the `Int` twin of `Nat/Lt/try`. `Int` carries no inductive ordering family — `Nat/Lte` has constructors a proof can recurse over, and there is no counterpart here — so an `Int` bound is *decided* or it is not had at all.
pub let non_neg(n: Int) -> Option(/syn/Int/NonNeg(n)) =
    match n >= +0: (r) => Option(match r: (_) => Prop | true => True | false => False end)
    | true => Option/some(True/qed())
    | false => Option/none()
    end;

-- Both branches decide their own bound rather than deriving the second from the first. That `0 - n` is non-negative whenever `n` is not would need `Int` arithmetic reasoning the library has no family to carry, so the negated branch asks the same question again — and its own failure, which no `Int` can reach, answers zero rather than pretending to a magnitude it did not compute.
pub let abs(n: Int) -> Nat =
    match non_neg(n)
    | some(ok) => to_nat(n, @ok)
    | none() => match non_neg(+0 - n) | some(ok) => to_nat(+0 - n, @ok) | none() => 0 end
    end;

pub let cmp(x: Int, y: Int) -> Order =
    choose | x < y => Order/lt() | x == y => Order/eq() | _ => Order/gt() end;

satisfy Eql(Int) {
    eql = eql,
    neq = neq,
}

satisfy Cmp(Int) {
    lt = lt,
    lte = lte,
    gt = gt,
    gte = gte,
}

satisfy Add(Int) {
    add = add,
}

satisfy Sub(Int) {
    sub = sub,
}

satisfy Mul(Int) {
    mul = mul,
}

satisfy Div(Int) {
    Ok(b) = /syn/Int/NonZero(b),
    div = div,
}

satisfy Rem(Int) {
    Ok(b) = /syn/Int/NonZero(b),
    rem = rem,
}

satisfy Show(Int) {
    show = to_str,
}

satisfy Ord(Int) {
    cmp = cmp,
}
