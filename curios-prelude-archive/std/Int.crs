pub use /sys/{Int};
pub use /syn/Int/{NonZero, NonNeg};
pub use /sys/Int/{eql, neq, add, sub, mul, div, rem, lt, gt, le, ge, and, or, xor, shl, shr, to_nat,
    to_flt};
use /std/{Nat, Str, Option, Ordering, Equal, Compare, Add, Subtract, Multiply, Divide, Remainder,
    Show, Spell, Ordered, True, False, Test};

pub let to_str(n: Int) -> Str =
    let mag = Nat/to_str(abs(n));
    match n >= +0 | true => Str/concat("+", mag) | false => Str/concat("-", mag) end;

pub let not(x: Int) -> Int =
    xor(x, -1);

pub let of_str(s: Str) -> Option(Int) =
    match Str/is_empty(s)
    | true => Option/none()
    | false =>
        let first = Str/try_get(s, 0)!;
        let digits =
            match first == '+' || first == '-'
            | true => Str/slice(s, 1, Str/len(s) - 1)
            | false => s
            end;
        let negative = first == '-';
        let n = Nat/of_str(digits)!;
        match negative
        | true => Option/some(+0 - Nat/to_int(n))
        | false => Option/some(Nat/to_int(n))
        end
    end;

-- The procedure that decides `0 <= n`, the `Int` twin of `Nat/Lt/try`. `Int` carries no inductive ordering family — `Nat/Le/Ind` has constructors a proof can recurse over, and there is no counterpart here — so an `Int` bound is *decided* or it is not had at all.
pub let non_neg(n: Int) -> Option(NonNeg(n)) =
    match n >= +0: (r) => Option(match r: (_) => Prop | true => True | false => False end)
    | true => Option/some(True/qed())
    | false => Option/none()
    end;

-- Both branches decide their own bound rather than deriving the second from the first. That `0 - n` is non-negative whenever `n` is not would need `Int` arithmetic reasoning the library has no family to carry, so the negated branch asks the same question again — and its own failure, which no `Int` can reach, answers zero rather than pretending to a magnitude it did not compute.
pub let abs(n: Int) -> Nat =
    match non_neg(n)
    | some(ok) => to_nat(n, @ok)
    | none() => match non_neg(+0 - n) | some(ok) => to_nat(+0 - n, @ok) | none() => 0 end
    end;

pub let cmp(x: Int, y: Int) -> Ordering =
    choose | x < y => Ordering/lt() | x == y => Ordering/eq() | _ => Ordering/gt() end;

pub let min(a: Int, b: Int) -> Int =
    match a < b | true => a | false => b end;

pub let max(a: Int, b: Int) -> Int =
    match a < b | true => b | false => a end;

-- `-1`, `+0` or `+1` by the sign of `n`.
pub let sign(n: Int) -> Int =
    choose | n < +0 => -1 | n == +0 => +0 | _ => +1 end;

satisfy Equal(Int) {
    eql = eql,
    neq = neq,
}

satisfy Compare(Int) {
    lt = lt,
    le = le,
    gt = gt,
    ge = ge,
}

satisfy Add(Int) {
    add = add,
}

satisfy Subtract(Int) {
    sub = sub,
}

satisfy Multiply(Int) {
    mul = mul,
}

satisfy Divide(Int) {
    Ok(b) = NonZero(b),
    div = div,
}

satisfy Remainder(Int) {
    Ok(b) = NonZero(b),
    rem = rem,
}

satisfy Show(Int) {
    show = to_str,
}

-- `to_str` already writes an explicit sign, which is exactly what keeps the text `Int`-typed without context: a bare `3` would re-parse as `Nat`.
satisfy Spell(Int) {
    spell = to_str,
}

satisfy Ordered(Int) {
    cmp = cmp,
}

-- A magnitude drawn as a `Nat`, and one more bit for the sign.
satisfy Test/Draw(Int) {
    all() = Option/none(),
    draw(seed, size) =
        let (magnitude, after) = Test/Draw/draw(@Nat, seed, size);
        let (sign, rest) = Test/Seed/next(after);
        let value = Nat/to_int(magnitude);
        (match Nat/and(sign, 1) == 1 | true => 0 - value | false => value end, rest),
}
