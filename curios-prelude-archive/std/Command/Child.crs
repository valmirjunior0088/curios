use /std/{Option, Try, Async, Io, stream};

-- | How a child ended: with an exit code, or by a signal.
pub mod Exit
    use /std/{Nat, Str, Equal, Show};

    -- | An exit code, or the signal that ended the child.
    pub induct Exit: pub Type
    | exited(Nat)
    | signaled(Nat)
    end

    pub use Exit/*;

    satisfy Equal(Exit);

    satisfy Show(Exit) {
        show(e) =
            match e
            | exited(code) => Str/flatten(["exited(", Nat/to_str(code), ")"])
            | signaled(signal) => Str/flatten(["signaled(", Nat/to_str(signal), ")"])
            end,
    }
end

pub use Exit/{let Exit};

-- | One end of a pipe to the child, read and written as a stream.
pub struct Pipe: Type {
    /sys/Handle,
}

satisfy stream/Read(Pipe) {
    read(p, n) = Async/raw/read(p.0, n),
}

satisfy stream/Write(Pipe) {
    write(p, b) = Async/raw/write(p.0, b),
}

-- | A running child, and whichever of its streams were piped.
pub struct Child: Type {
    handle: /sys/Handle,
    stdin: Option(Pipe),
    stdout: Option(Pipe),
    stderr: Option(Pipe),
}

-- | A child over the handles the host handed back. The seam `Command/spawn` builds one through.
pub let new(
    handle: /sys/Handle,
    stdin: Option(/sys/Handle),
    stdout: Option(/sys/Handle),
    stderr: Option(/sys/Handle),
) -> Child =
    Child {
        handle = handle,
        stdin = Option/map(stdin, (h) => Pipe { h }),
        stdout = Option/map(stdout, (h) => Pipe { h }),
        stderr = Option/map(stderr, (h) => Pipe { h }),
    };

-- | The pipe to the child's standard input, when it was piped.
pub let stdin(c: Child) -> Option(Pipe) =
    c.stdin;

-- | The pipe from the child's standard output, when it was piped.
pub let stdout(c: Child) -> Option(Pipe) =
    c.stdout;

-- | The pipe from the child's standard error, when it was piped.
pub let stderr(c: Child) -> Option(Pipe) =
    c.stderr;

let close_pipe(p: Option(Pipe)) -> Io({}) =
    match p | some(p) => /sys/Handle/close(p.0) | none() => Io/pure(()) end;

let close_pipes(c: Child) -> Io({}) =
    let _ = close_pipe(c.stdin)!;
    let _ = close_pipe(c.stdout)!;
    close_pipe(c.stderr);

-- | End the child if it still runs, and close its pipes.
pub let kill(c: Child) -> Io({}) =
    let _ = /sys/proc/kill(c.handle)!;
    close_pipes(c);

-- | How the child ended, parking until it does. The pipes are closed with it, so read what it wrote before waiting for it.
pub let wait(c: Child) -> Try(Async, Io/Error, Exit) =
    let _ = Async/raw/wait(c.handle, /sys/event/read)!;
    let r = /sys/proc/wait(c.handle)!;
    let _ = close_pipes(c)!;
    match Io/Error/of(r.status)
    | some(e) => Try/raise(e)
    | none() =>
        Try/pure(
            match r.signal == 0
            | true => Exit/exited(r.code)
            | false => Exit/signaled(r.signal)
            end)
    end;

-- | `body` with the child killed whichever way the task ends, so a child never outlives the bracket it was started in.
pub let with(@A: Type, c: Child, body: Try(Async, Io/Error, A)) -> Try(Async, Io/Error, A) =
    let outcome = Async/using(kill(c), Try/run(body))!;
    let a = outcome!;
    Try/pure(a);
