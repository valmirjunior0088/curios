-- This process: its arguments, its environment, and its end. Starting another is `Command`'s, and the child it starts is `Child`'s.
pub use /sys/proc/{args};
use /std/{Bytes, Nat, Str, Option, Io};

pub let env(name: Str) -> Io(Option(Bytes)) =
    let r = /sys/proc/env(Str/to_bytes(name))!;
    Io/pure(
        match r.status == /sys/status/ok
        | true => Option/some(r.value)
        | false => Option/none()
        end);

-- Unit inside the wrapper, not a caller-chosen type: `exit` never returns, and a non-returning term is unsound exactly when it inhabits a type nothing total inhabits. At `{}` there is nothing to forge. A branch that exits must still produce a description, so write `let _ = proc/exit(1)!; …` rather than passing the exit off as the value itself.
pub let exit(code: Nat) -> Io({}) =
    /sys/proc/exit(code);
