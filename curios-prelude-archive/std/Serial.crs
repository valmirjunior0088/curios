use /std/{Bytes, Nat, Bool, List, Result, Path, Try, Async, Io, Handle};

--- An open serial port.
pub struct Serial: Type {
    Handle,
}

--- The parity bit a character is framed with.
pub induct Parity: pub Type
--- No parity bit.
| none()
--- A bit making the count of one bits even.
| even()
--- A bit making the count of one bits odd.
| odd()
end

--- How the wire is paced.
pub induct Flow: pub Type
--- No flow control.
| none()
--- Hardware flow control over the RTS and CTS lines.
| hardware()
end

--- How a port is opened: its speed and its frame. `baud` is from 1 through 4294967295, `data_bits` is 7 or 8 and `stop_bits` 1 or 2; the host refuses any other as `other(22)`, before it touches the device.
pub struct Config: pub Type {
    baud: Nat,
    data_bits: Nat,
    parity: Parity,
    stop_bits: Nat,
    flow: Flow,
}

--- `baud` with the frame nearly every device speaks: 8 data bits, no parity, 1 stop bit, and no flow control. The speed has no default, since only the device knows it.
pub let config(baud: Nat) -> Config =
    Config {
        baud = baud,
        data_bits = 8,
        parity = Parity/none(),
        stop_bits = 1,
        flow = Flow/none(),
    };

let of_parity(parity: Parity) -> Nat =
    match parity
    | none() => /sys/serial_parity/none
    | even() => /sys/serial_parity/even
    | odd() => /sys/serial_parity/odd
    end;

let of_flow(flow: Flow) -> Nat =
    match flow | none() => /sys/serial_flow/none | hardware() => /sys/serial_flow/hardware end;

--- The port at `path`, opened raw at `c`'s speed and frame, or `other(22)` when the device takes another. Nothing holds it exclusively, so whether another open of the same device is refused is the device's to say. A character that fails its parity check arrives as it was received, and a break as a zero byte.
---
--- The system raises DTR as a port opens whatever the program wants, so a board that resets on DTR resets here; `discard_input` once it has booted drops the banner it printed.
pub let open(path: Path, c: Config) -> Try(Io, Io/Error, Serial) =
    let h =
        Io/Error/of_result(
            /sys/serial/open(
                Path/to_bytes(path),
                c.baud,
                c.data_bits,
                of_parity(c.parity),
                c.stop_bits,
                of_flow(c.flow))!)!;
    Try/pure(Serial { h });

--- Close `s`. What it accepted and has not sent is discarded, so the close never waits on the wire: `drain` first to send it, as `with` does.
pub let close(s: Serial) -> Io({}) =
    Handle/close(s.0);

--- Up to `n` bytes, parking until some arrive.
pub let read(s: Serial, n: Nat, @positive: Nat/Lt(0, n)) -> Async(Io/Chunk) =
    Async/Read/read(@Async, @Handle, s.0, n, @positive);

--- The whole of `b`, parking while the device cannot take more.
pub let write(s: Serial, b: Bytes) -> Async(Result(Io/Error, {})) =
    Async/Write/write(s.0, b);

satisfy Async/Read(Async, Serial) {
    read(s, n, @positive) = read(s, n, @positive),
}

let draining(s: Serial) -> Try(Io, Io/Error, Handle) =
    let wait = Io/Error/of_result(/sys/serial/drain(s.0)!)!;
    Try/pure(wait);

--- Park until `s` has sent what it accepted, or can no longer send it. A device that never takes the output — hardware flow control with nothing asking for more — parks the fiber for good, so bound it with a timeout where that can happen; a cancelled drain leaves the output where it was.
pub let drain(s: Serial) -> Try(Async, Io/Error, {}) =
    let wait = draining(s)!;
    let outcome = Async/using(Handle/close(wait), Async/read_all(wait))!;
    let _ = outcome!;
    Try/pure(());

satisfy Async/Write(Async, Serial) {
    write(s, b) = write(s, b),
    flush(s) = Try/run(drain(s)),
}

let control(s: Serial, op: Nat, on: Bool) -> Try(Io, Io/Error, {}) =
    let _ = Io/Error/of_result(/sys/serial/control(s.0, op, on)!)!;
    Try/pure(());

--- The Data Terminal Ready line at `on`. Lowering and raising it is how most boards are reset.
pub let set_dtr(s: Serial, on: Bool) -> Try(Io, Io/Error, {}) =
    control(s, /sys/serial_op/dtr, on);

--- The Request To Send line at `on`. Beside DTR, it drives the reset and boot pins a board wires to the pair.
pub let set_rts(s: Serial, on: Bool) -> Try(Io, Io/Error, {}) =
    control(s, /sys/serial_op/rts, on);

--- Drop what the device sent and the program has not read.
pub let discard_input(s: Serial) -> Try(Io, Io/Error, {}) =
    control(s, /sys/serial_op/discard_input, false);

--- `body` over the port at `path`, closed whichever way the task ends, a cancellation included; the body's own failure is the answer after the close. A body that ends well is followed by a `drain`, so what it wrote has left before the close discards the rest.
pub let with(
    @A: Type,
    path: Path,
    c: Config,
    body: (Serial) -> Try(Async, Io/Error, A),
) -> Try(Async, Io/Error, A) =
    let s = open(path, c)!;
    let outcome = Async/using(close(s), Try/run(drained(s, body(s))))!;
    let a = outcome!;
    Try/pure(a);

--- `body`, then `s` drained; a failure to drain is the task's.
let drained(@A: Type, s: Serial, body: Try(Async, Io/Error, A)) -> Try(Async, Io/Error, A) =
    let a = body!;
    let _ = drain(s)!;
    Try/pure(a);

--- The serial devices the host has, each by a path `open` takes, in byte order, and none where it has none. On Linux a device is named by its entry of `/dev/serial/by-id` where the system keeps one — a name that carries its vendor, product and serial number, and outlives the order devices were plugged in — and by its node otherwise, as an onboard port is `/dev/ttyS0`; on macOS by its callout device, `/dev/cu.` and its name.
pub let list: Try(Io, Io/Error, List(Path)) =
    let paths = Io/Error/of_result(/sys/serial/list!)!;
    Try/pure(List/map(paths, Path/of_bytes));
