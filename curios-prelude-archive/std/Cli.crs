use /std/{Str, Bytes, Nat, Int, Flt, Bool, Char, List, Option, Result, Io, print, True, False};

-- | How an argument's text is read into a value: the placeholder shown in help, and the reader.
pub struct Value: pub Type {
    A: Type,
    metavar: Str,
    read: (Str) -> Result(Str, A),
}

-- | A string, as written.
pub let str: Value =
    Value { A = Str, metavar = "S", read = (s) => Result/success(s) };

-- | A natural number in decimal.
pub let nat: Value =
    Value {
        A = Nat,
        metavar = "N",
        read =
            (s) =>
                match Nat/of_str(s)
                | some(n) => Result/success(n)
                | none() => Result/failure(Str/flatten(["expected a number, found '", s, "'"]))
                end,
    };

-- | An integer in decimal, with an optional sign.
pub let int: Value =
    Value {
        A = Int,
        metavar = "N",
        read =
            (s) =>
                match Int/of_str(s)
                | some(n) => Result/success(n)
                | none() => Result/failure(Str/flatten(["expected an integer, found '", s, "'"]))
                end,
    };

-- | A floating-point number.
pub let flt: Value =
    Value {
        A = Flt,
        metavar = "X",
        read =
            (s) =>
                match Flt/of_str(s)
                | some(x) => Result/success(x)
                | none() => Result/failure(Str/flatten(["expected a number, found '", s, "'"]))
                end,
    };

-- | A reader of a program's own type, shown as `metavar` in help.
pub let reader(@A: Type, metavar: Str, f: (Str) -> Result(Str, A)) -> Value =
    Value { A = A, metavar = metavar, read = f };

-- | Whether an option must appear, may be absent, or stands for `a` when absent.
pub induct Presence(A: Type): pub Type
| required()
| optional()
| default(a: A)
end

-- | What an argument is: a flag, an option taking a value, an option taking every value it is given, a positional, or the collector of every remaining positional.
pub induct Kind: pub Type
| flag()
| option(v: Value, presence: Presence(v.A))
| many(v: Value)
| positional(v: Value)
| rest(v: Value)
end

-- | One argument a program declares: its long name, an optional short one, its help line and its kind.
pub struct Arg: pub Type {
    long: Str,
    short: Option(Char),
    help: Str,
    kind: Kind,
}

-- | A flag `--long`.
pub let flag(long: Str, help: Str) -> Arg =
    Arg { long = long, short = Option/none(), help = help, kind = Kind/flag() };

-- | A required option `--long VALUE`.
pub let option(long: Str, v: Value, help: Str) -> Arg =
    Arg {
        long = long,
        short = Option/none(),
        help = help,
        kind = Kind/option(v, Presence/required()),
    };

-- | An option that may be absent, read as an `Option`.
pub let optional(long: Str, v: Value, help: Str) -> Arg =
    Arg {
        long = long,
        short = Option/none(),
        help = help,
        kind = Kind/option(v, Presence/optional()),
    };

-- | An option that stands for `fallback` when absent.
pub let default(long: Str, v: Value, fallback: v.A, help: Str) -> Arg =
    Arg {
        long = long,
        short = Option/none(),
        help = help,
        kind = Kind/option(v, Presence/default(fallback)),
    };

-- | An option that keeps every value it is given.
pub let many(long: Str, v: Value, help: Str) -> Arg =
    Arg { long = long, short = Option/none(), help = help, kind = Kind/many(v) };

-- | A required positional, filled in declaration order.
pub let positional(long: Str, v: Value, help: Str) -> Arg =
    Arg { long = long, short = Option/none(), help = help, kind = Kind/positional(v) };

-- | The collector of every positional after the declared ones. At most one, and after every positional.
pub let rest(long: Str, v: Value, help: Str) -> Arg =
    Arg { long = long, short = Option/none(), help = help, kind = Kind/rest(v) };

let KindCarrier(k: Kind) -> Type =
    match k
    | flag() => Bool
    | option(v, presence) =>
        match presence | required() => v.A | optional() => Option(v.A) | default(_) => v.A end
    | many(v) => List(v.A)
    | positional(v) => v.A
    | rest(v) => List(v.A)
    end;

-- | The type a parsed argument has in the record: `Bool` for a flag, the reader's type for a required or defaulted option and a positional, an `Option` for an optional one, and a list for `many` and `rest`.
pub let Carrier(a: Arg) -> Type =
    KindCarrier(a.kind);

let is_positional(k: Kind) -> Bool =
    match k | positional(_) => true | _ => false end;

let is_rest(k: Kind) -> Bool =
    match k | rest(_) => true | _ => false end;

-- | The record a line parsed into, indexed by the arguments it was parsed against.
pub induct Values: (List(Arg)) -> pub Type
| nil(): ([])
| cons(@a: Arg, @rest: List(Arg), head: Carrier(a), tail: Values(rest)): ([a, ..rest])
end

-- | The type `get` answers for `name` in `spec`.
pub let Lookup(spec: List(Arg), name: Str) -> Type =
    match spec
    | [] => {}
    | [a, ..rest] =>
        match Str/eql(a.long, name) | true => Carrier(a) | false => Lookup(rest, name) end
    end;

-- | That `name` is one of `spec`'s long names, decided by reduction: a name the declaration lacks is refused where it is written.
pub let Has(spec: List(Arg), name: Str) -> Prop =
    match spec
    | [] => False
    | [a, ..rest] => match Str/eql(a.long, name) | true => True | false => Has(rest, name) end
    end;

-- | The field named `name`, at the type its argument decides.
pub let get(
    @spec: List(Arg),
    v: Values(spec),
    name: Str,
    @ok: Has(spec, name),
) -> Lookup(spec, name) =
    let walk =
        match v: (s, _) => (found: Has(s, name)) -> Lookup(s, name)
        | nil() => (absent) => match absent end
        | cons(@a, @rest, head, tail) =>
            (found) =>
                let pick =
                    match Str/eql(a.long, name): (b) =>
                        (here: match b | true => True | false => Has(rest, name) end) -> match b
                        | true => Carrier(a)
                        | false => Lookup(rest, name)
                        end
                    | true => (_) => head
                    | false => (later) => get(@rest, tail, name, @later)
                    end;
                pick(found)
        end;
    walk(ok);

-- | What a program declares: its name and description, an optional version, its arguments and the handler that takes them, or its subcommands.
pub struct Cli: pub Type {
    name: Str,
    about: Str,
    version: Option(Str),
    args: List(Arg),
    run: (Values(args)) -> Io({}),
    commands: List(Cli),
}

let no_repeat_long(spec: List(Arg)) -> Bool =
    match spec
    | [] => true
    | [a, ..more] =>
        Bool/not(List/any(more, (b) => Str/eql(a.long, b.long))) && no_repeat_long(more)
    end;

let no_repeat_short(spec: List(Arg)) -> Bool =
    match spec
    | [] => true
    | [a, ..more] =>
        match a.short
        | none() => no_repeat_short(more)
        | some(c) =>
            Bool/not(
                List/any(
                    more,
                    (b) => match b.short | some(d) => Char/eql(c, d) | none() => false end))
                && no_repeat_short(more)
        end
    end;

let no_reserved(spec: List(Arg)) -> Bool =
    List/all(
        spec,
        (a) =>
            Bool/not(Str/eql(a.long, "help")) && Bool/not(Str/eql(a.long, "version"))
                && (match a.short | some(c) => Bool/not(Char/eql(c, 'h')) | none() => true end));

let rest_comes_last(spec: List(Arg), seen: Bool) -> Bool =
    match spec
    | [] => true
    | [a, ..more] =>
        match seen
        | true => Bool/not(is_positional(a.kind) || is_rest(a.kind)) && rest_comes_last(more, true)
        | false => rest_comes_last(more, is_rest(a.kind))
        end
    end;

let empty(@T: Type, l: List(T)) -> Bool =
    match l | [] => true | [_, .._] => false end;

let no_repeat_name(subs: List(Cli)) -> Bool =
    match subs
    | [] => true
    | [c, ..more] =>
        Bool/not(List/any(more, (d) => Str/eql(c.name, d.name))) && no_repeat_name(more)
    end;

let sound(cli: Cli) -> Bool =
    no_repeat_long(cli.args) && no_repeat_short(cli.args) && no_reserved(cli.args)
        && rest_comes_last(cli.args, false)
        && (match cli.commands
        | [] => true
        | [_, .._] =>
            empty(cli.args) && no_repeat_name(cli.commands)
                && List/all(
                    cli.commands,
                    (c) =>
                        empty(c.commands) && no_repeat_long(c.args) && no_repeat_short(c.args)
                            && no_reserved(c.args)
                            && rest_comes_last(c.args, false))
        end);

-- | That the declaration parses unambiguously: no reserved names, one `rest` after every positional, and subcommands one level deep. Decided by reduction and demanded by `main`.
pub let WellFormed(cli: Cli) -> Prop =
    match sound(cli) | true => True | false => False end;

-- | Why a line was refused.
pub induct Failure: pub Type
| unknown_option(token: Str)
| missing_value(name: Str)
| missing_required(name: Str)
| unexpected(token: Str)
| bad_value(name: Str, reason: Str)
| unknown_command(name: Str, known: List(Str))
| missing_command(known: List(Str))
end

-- | What a line came to: a parsed record, a request for help or the version, or a refusal.
pub induct Outcome(spec: List(Arg)): pub Type
| parsed(Values(spec))
| help()
| version()
| failure(Failure)
end

let no_occurrences: List(Str) =
    [];

let empty_slots(spec: List(Arg)) -> List(List(Str)) =
    List/replicate(List/len(spec), no_occurrences);

let push_at(slots: List(List(Str)), i: Nat, s: Str) -> List(List(Str)) =
    match slots
    | [] => []
    | [head, ..tail] =>
        match i | 0 => [[..head, s], ..tail] | j + 1 => [head, ..push_at(tail, j, s)] end
    end;

let takes_value(k: Kind) -> Bool =
    match k
    | flag() => false
    | option(_, _) => true
    | many(_) => true
    | positional(_) => false
    | rest(_) => false
    end;

let long_index(spec: List(Arg), name: Str) -> Option(Nat) =
    List/find_index(spec, (a) => Str/eql(a.long, name));

let short_index(spec: List(Arg), c: Char) -> Option(Nat) =
    List/find_index(spec, (a) => match a.short | some(d) => Char/eql(c, d) | none() => false end);

let name_at(spec: List(Arg), i: Nat) -> Str =
    Option/unwrap_or(Option/map(List/try_get(spec, i), (a) => a.long), "");

let wants_a_value(spec: List(Arg), i: Nat) -> Bool =
    Option/unwrap_or(Option/map(List/try_get(spec, i), (a) => takes_value(a.kind)), false);

let positional_indices(spec: List(Arg)) -> List(Nat) =
    let walk(rest: List(Arg), at: Nat) -> List(Nat) =
        match rest
        | [] => []
        | [a, ..more] =>
            match is_positional(a.kind)
            | true => [at, ..walk(more, at + 1)]
            | false => walk(more, at + 1)
            end
        end;
    walk(spec, 0);

let rest_index(spec: List(Arg)) -> Option(Nat) =
    List/find_index(spec, (a) => is_rest(a.kind));

let wants_help(argv: List(Str)) -> Bool =
    List/any(
        argv,
        (t) =>
            Str/eql(t, "--help")
                || Str/starts_with(t, "-") && Bool/not(Str/starts_with(t, "--"))
                    && Str/contains(t, "h"));

let wants_version(argv: List(Str)) -> Bool =
    List/any(argv, (t) => Str/eql(t, "--version"));

struct Walk: Type {
    slots: List(List(Str)),
    filled: Nat,
    literal: Bool,
}

induct Cluster: Type
| settled(w: Walk)
| needs(w: Walk, at: Nat, name: Str)
| broke(f: Failure)
end

let place(spec: List(Arg), w: Walk, token: Str) -> Result(Failure, Walk) =
    match List/try_get(positional_indices(spec), w.filled)
    | some(i) =>
        Result/success(Walk { ..w, slots = push_at(w.slots, i, token), filled = w.filled + 1 })
    | none() =>
        match rest_index(spec)
        | some(i) => Result/success(Walk { ..w, slots = push_at(w.slots, i, token) })
        | none() => Result/failure(Failure/unexpected(token))
        end
    end;

let run_cluster(spec: List(Arg), w: Walk, chars: List(Char), whole: Str) -> Cluster =
    match chars
    | [] => Cluster/settled(w)
    | [c, ..more] =>
        match short_index(spec, c)
        | none() => Cluster/broke(Failure/unknown_option(whole))
        | some(i) =>
            let name = name_at(spec, i);
            match wants_a_value(spec, i)
            | false =>
                run_cluster(spec, Walk { ..w, slots = push_at(w.slots, i, name) }, more, whole)
            | true =>
                match more
                | [] => Cluster/needs(w, i, name)
                | [_, .._] =>
                    Cluster/settled(
                        Walk {
                            ..w,
                            slots = push_at(w.slots, i, Str/flatten(List/map(more, Str/of_char))),
                        })
                end
            end
        end
    end;

let step(spec: List(Arg), w: Walk, tokens: List(Str)) -> Result(Failure, List(List(Str))) =
    match tokens
    | [] => Result/success(w.slots)
    | [t, ..more] =>
        match w.literal
        | true => Result/bind(place(spec, w, t), (w2) => step(spec, w2, more))
        | false =>
            match Str/eql(t, "--")
            | true => step(spec, Walk { ..w, literal = true }, more)
            | false =>
                match Str/starts_with(t, "--")
                | true =>
                    let body = Str/slice(t, 2, Str/len(t));
                    match Str/split_once(body, "=")
                    | some((name, value)) =>
                        match long_index(spec, name)
                        | none() => Result/failure(Failure/unknown_option(t))
                        | some(i) =>
                            match wants_a_value(spec, i)
                            | false =>
                                Result/failure(Failure/bad_value(name, "this flag takes no value"))
                            | true =>
                                step(spec, Walk { ..w, slots = push_at(w.slots, i, value) }, more)
                            end
                        end
                    | none() =>
                        match long_index(spec, body)
                        | none() => Result/failure(Failure/unknown_option(t))
                        | some(i) =>
                            match wants_a_value(spec, i)
                            | false =>
                                step(spec, Walk { ..w, slots = push_at(w.slots, i, body) }, more)
                            | true =>
                                match more
                                | [] => Result/failure(Failure/missing_value(body))
                                | [v, ..rest2] =>
                                    step(spec, Walk { ..w, slots = push_at(w.slots, i, v) }, rest2)
                                end
                            end
                        end
                    end
                | false =>
                    match Str/starts_with(t, "-") && Nat/lt(1, Str/len(t))
                    | true =>
                        match run_cluster(spec, w, Str/to_list(Str/slice(t, 1, Str/len(t))), t)
                        | broke(f) => Result/failure(f)
                        | settled(w2) => step(spec, w2, more)
                        | needs(w2, i, name) =>
                            match more
                            | [] => Result/failure(Failure/missing_value(name))
                            | [v, ..rest2] =>
                                step(spec, Walk { ..w2, slots = push_at(w2.slots, i, v) }, rest2)
                            end
                        end
                    | false => Result/bind(place(spec, w, t), (w2) => step(spec, w2, more))
                    end
                end
            end
        end
    end;

let field(name: Str, k: Kind, occurrences: List(Str)) -> Result(Failure, KindCarrier(k)) =
    let last_of = List/last(occurrences);
    let read_with(v: Value, s: Str) -> Result(Failure, v.A) =
        Result/map_failure(v.read(s), (reason) => Failure/bad_value(name, reason));
    match k: (k2) => Result(Failure, KindCarrier(k2))
    | flag() => Result/success(match occurrences | [] => false | [_, .._] => true end)
    | option(v, presence) =>
        match presence: (p) =>
            Result(
                Failure,
                match p | required() => v.A | optional() => Option(v.A) | default(_) => v.A end)
        | required() =>
            match last_of
            | none() => Result/failure(Failure/missing_required(name))
            | some(s) => read_with(v, s)
            end
        | optional() =>
            match last_of
            | none() => Result/success(Option/none())
            | some(s) => Result/map_success(read_with(v, s), (a) => Option/some(a))
            end
        | default(fallback) =>
            match last_of | none() => Result/success(fallback) | some(s) => read_with(v, s) end
        end
    | many(v) => List/traverse(occurrences, (s) => read_with(v, s))
    | positional(v) =>
        match last_of
        | none() => Result/failure(Failure/missing_required(name))
        | some(s) => read_with(v, s)
        end
    | rest(v) => List/traverse(occurrences, (s) => read_with(v, s))
    end;

let fill(spec: List(Arg), slots: List(List(Str))) -> Result(Failure, Values(spec)) =
    match spec: (s) => Result(Failure, Values(s))
    | [] => Result/success(Values/nil())
    | [a, ..more] =>
        let here = Option/unwrap_or(List/try_get(slots, 0), no_occurrences);
        let later = match slots | [] => [] | [_, ..tail] => tail end;
        Result/bind(
            field(a.long, a.kind, here),
            (head) => Result/map_success(fill(more, later), (tail) => Values/cons(head, tail)))
    end;

-- | A line read against `spec`, performing nothing. Help wins over every other reading of the line, and a version is answered only when `versioned`.
pub let parse(spec: List(Arg), argv: List(Str), versioned: Bool) -> Outcome(spec) =
    match wants_help(argv)
    | true => Outcome/help()
    | false =>
        match versioned && wants_version(argv)
        | true => Outcome/version()
        | false =>
            match step(spec, Walk { slots = empty_slots(spec), filled = 0, literal = false }, argv)
            | failure(f) => Outcome/failure(f)
            | success(slots) =>
                match fill(spec, slots)
                | failure(f) => Outcome/failure(f)
                | success(v) => Outcome/parsed(v)
                end
            end
        end
    end;

let shout(s: Str) -> Str =
    Str/flatten(List/map(Str/to_list(s), (c) => Str/of_char(Char/to_ascii_upper(c))));

let metavar_of(k: Kind) -> Option(Str) =
    match k
    | flag() => Option/none()
    | option(v, _) => Option/some(v.metavar)
    | many(v) => Option/some(v.metavar)
    | positional(_v) => Option/none()
    | rest(_v) => Option/none()
    end;

let placeholder(a: Arg) -> Option(Str) =
    match a.kind
    | positional(_) => Option/some(Str/flatten(["<", shout(a.long), ">"]))
    | rest(_) => Option/some(Str/flatten(["[", shout(a.long), "]..."]))
    | _ => Option/none()
    end;

let placeholders(spec: List(Arg)) -> List(Str) =
    List/filter_map(spec, placeholder);

let positional_rows(spec: List(Arg)) -> List({Str, Str}) =
    List/filter_map(spec, (a) => Option/map(placeholder(a), (p) => (p, a.help)));

let option_rows(spec: List(Arg)) -> List({Str, Str}) =
    List/filter_map(
        spec,
        (a) =>
            match is_positional(a.kind) || is_rest(a.kind)
            | true => Option/none()
            | false => Option/some((option_head(a), a.help))
            end);

let command_rows(subs: List(Cli)) -> List({Str, Str}) =
    List/map(subs, (c) => (c.name, c.about));

let has_options(spec: List(Arg)) -> Bool =
    List/any(spec, (a) => Bool/not(is_positional(a.kind) || is_rest(a.kind)));

-- | The one-line usage.
pub let usage(cli: Cli) -> Str =
    let head =
        match has_options(cli.args) | true => [cli.name, "[OPTIONS]"] | false => [cli.name] end;
    let tail = placeholders(cli.args);
    let commands = match cli.commands | [] => [] | [_, .._] => ["<COMMAND>"] end;
    Str/flatten(["Usage: ", Str/join(" ", List/flatten([head, tail, commands]))]);

let option_head(a: Arg) -> Str =
    let short =
        match a.short | some(c) => Str/flatten(["-", Str/of_char(c), ", "]) | none() => "    " end;
    let value =
        match metavar_of(a.kind) | some(m) => Str/flatten([" <", m, ">"]) | none() => "" end;
    Str/flatten([short, "--", a.long, value]);

let widest(rows: List({Str, Str})) -> Nat =
    List/fold(rows, 0, ((left, _), so_far) => Nat/max(Str/len(left), so_far));

let section(heading: Str, rows: List({Str, Str})) -> List(Str) =
    match rows
    | [] => []
    | [_, .._] =>
        let width = widest(rows);
        let render(row: {Str, Str}) -> Str =
            Str/flatten(["  ", Str/pad_end(row.0, width, ' '), "  ", row.1, "\n"]);
        List/flatten([[heading, "\n"], List/map(rows, render), ["\n"]])
    end;

let builtin_rows(cli: Cli) -> List({Str, Str}) =
    let help_row: {Str, Str} = ("-h, --help", "Print help");
    match cli.version
    | none() => [help_row]
    | some(_) => [help_row, ("    --version", "Print version")]
    end;

-- | The help screen: usage, then the positionals, the options and the subcommands with their help lines.
pub let help(cli: Cli) -> Str =
    let arguments = positional_rows(cli.args);
    let options = List/flatten([option_rows(cli.args), builtin_rows(cli)]);
    let commands = command_rows(cli.commands);
    Str/flatten(
        List/flatten(
            [
                [cli.about, "\n\n", usage(cli), "\n\n"],
                section("Arguments:", arguments),
                section("Options:", options),
                section("Commands:", commands)]));

let complaint(f: Failure) -> Str =
    match f
    | unknown_option(t) => Str/flatten(["unexpected argument '", t, "'"])
    | missing_value(n) => Str/flatten(["a value is required for '--", n, "'"])
    | missing_required(n) => Str/flatten(["the argument '", shout(n), "' is required"])
    | unexpected(t) => Str/flatten(["unexpected argument '", t, "'"])
    | bad_value(n, r) => Str/flatten(["invalid value for '--", n, "': ", r])
    | unknown_command(n, known) =>
        Str/flatten(["unrecognized subcommand '", n, "'\n  available: ", Str/join(", ", known)])
    | missing_command(known) =>
        Str/flatten(["a subcommand is required\n  available: ", Str/join(", ", known)])
    end;

-- | A refusal rendered for standard error, with the usage.
pub let report(cli: Cli, f: Failure) -> Str =
    Str/flatten(
        ["error: ", complaint(f), "\n\n", usage(cli), "\n\nFor more information, try '--help'.\n"]);

-- | What choosing a subcommand came to: the subcommand and its line, a request for help or the version, or a refusal.
pub induct Chosen: pub Type
| chose(sub: Cli, rest: List(Str))
| wanted_help()
| wanted_version()
| refused(f: Failure)
end

let command_names(subs: List(Cli)) -> List(Str) =
    match subs | [] => [] | [c, ..more] => [c.name, ..command_names(more)] end;

let named(subs: List(Cli), name: Str) -> Option(Cli) =
    match subs
    | [] => Option/none()
    | [c, ..more] =>
        match Str/eql(c.name, name) | true => Option/some(c) | false => named(more, name) end
    end;

-- | The subcommand the first token names, and the rest of the line as its own.
pub let select(cli: Cli, argv: List(Str)) -> Chosen =
    let names = command_names(cli.commands);
    match wants_help(argv)
    | true => Chosen/wanted_help()
    | false =>
        match Option/is_some(cli.version) && wants_version(argv)
        | true => Chosen/wanted_version()
        | false =>
            match argv
            | [] => Chosen/refused(Failure/missing_command(names))
            | [first, ..rest] =>
                match named(cli.commands, first)
                | some(sub) => Chosen/chose(sub, rest)
                | none() => Chosen/refused(Failure/unknown_command(first, names))
                end
            end
        end
    end;

let decode(raw: List(Bytes)) -> Result(Nat, List(Str)) =
    let walk(rest: List(Bytes), at: Nat) -> Result(Nat, List(Str)) =
        match rest
        | [] => Result/success([])
        | [b, ..more] =>
            match Str/of_bytes(b)
            | none() => Result/failure(at)
            | some(s) => Result/map_success(walk(more, at + 1), (tail) => [s, ..tail])
            end
        end;
    walk(raw, 0);

let fail_with(text: Str) -> Io({}) =
    let _ = Io/write(Io/stderr, Str/to_bytes(text))!;
    /std/proc/exit(2);

-- | The entry a program hands its `Cli` to: arguments read, help and the version answered on standard output with exit 0, a refusal reported on standard error with exit 2, and otherwise the handler run.
pub let main(cli: Cli, @_ok: WellFormed(cli)) -> Io({}) =
    let raw = /std/proc/args!;
    let dropped = match raw | [] => [] | [_, ..more] => more end;
    match decode(dropped)
    | failure(at) =>
        fail_with(
            Str/flatten(
                [
                    "error: argument ",
                    Nat/to_str(at + 1),
                    " is not valid UTF-8\n\n",
                    usage(cli),
                    "\n\nFor more information, try '--help'.\n"]))
    | success(argv) =>
        match parse(cli.args, argv, Option/is_some(cli.version))
        | help() => print(help(cli))
        | version() => print(Str/flatten([Option/unwrap_or(cli.version, ""), "\n"]))
        | failure(f) => fail_with(report(cli, f))
        | parsed(v) => cli.run(v)
        end
    end;
