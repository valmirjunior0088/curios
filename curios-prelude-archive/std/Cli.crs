-- A command-line interface is a value, and the record it parses into is a type computed from that value. A program writes a `Cli` -- a name, a list of `Arg`, and a handler -- and the module reads a line against it: `parse` turns the arguments into a `Values(args)`, `get(v, name)` reads one field at a type the specification decides, and a name the specification does not contain is refused where it is written rather than at run time. `select` picks a subcommand, `help` and `usage` render the screens, and `report` renders a refusal.
--
-- The token grammar is GNU's. In the order a token is tried: `--` makes every later token a positional; a lone `-` is an ordinary positional; `--name=value` is the option `name`, the first `=` splitting it and every later one belonging to the value; `--name` is the flag `name`, or the option `name` taking the next token verbatim; `-abc` is the flags `a` and `b` followed by `c` as a flag or as an option taking the rest of the token or the next one; anything else is a positional, filled in declaration order and then collected by `rest`. A long name is matched whole -- there is no abbreviation and no single-dash long option.
--
-- An option written twice keeps its last value, `many` keeps every value, and a flag written twice is set. `-h` or `--help` anywhere on the line answers help before any failure is reported, and `--version` likewise when the command declares one.
--
-- **There is no `main`, and a program writes its own entry.** The shape is fixed even though the module cannot yet hold it: read `/std/proc/args`, drop the program name, decode each argument with `Str/of_bytes` and refuse a non-UTF-8 one by its position rather than converting it lossily, hand the rest to `select` where there are subcommands and to `parse` where there are not, print `help` or the version to standard output and exit 0, print `report` to standard error and exit 2, and otherwise apply the command's own `run` to the parsed record. What stops that living here is the elaborator rather than the design: a specification-indexed function applied to a `Type`-carrying struct field has its instance levels read as constants, so `parse(cli.args, ...)` handed to `cli.run` is accepted by the elaborator and refused by the kernel. The roadmap carries it.
use /std/{Str, Nat, Int, Flt, Bool, Char, List, Option, Result, Io, True, False};

-- A reader is data rather than a witness, so a program's own type joins a specification by supplying one rather than by declaring an instance. `A` is a field because the carrier a specification entry contributes is read off the entry itself; see `Carrier`.
pub struct Value: pub Type {
    A: Type,
    metavar: Str,
    read: (Str) -> Result(Str, A),
}

pub let str: Value =
    Value { A = Str, metavar = "S", read = (s) => Result/success(s) };

pub let nat: Value =
    Value {
        A = Nat,
        metavar = "N",
        read =
            (s) =>
                match Nat/of_str(s)
                | some(n) => Result/success(n)
                | none() => Result/failure(Str/flatten(["expected a number, found '", s, "'"]))
                end,
    };

pub let int: Value =
    Value {
        A = Int,
        metavar = "N",
        read =
            (s) =>
                match Int/of_str(s)
                | some(n) => Result/success(n)
                | none() => Result/failure(Str/flatten(["expected an integer, found '", s, "'"]))
                end,
    };

pub let flt: Value =
    Value {
        A = Flt,
        metavar = "X",
        read =
            (s) =>
                match Flt/of_str(s)
                | some(x) => Result/success(x)
                | none() => Result/failure(Str/flatten(["expected a number, found '", s, "'"]))
                end,
    };

pub let reader(@A: Type, metavar: Str, f: (Str) -> Result(Str, A)) -> Value =
    Value { A = A, metavar = metavar, read = f };

-- Whether an option must appear, may be absent, or stands in for a value when absent. `default` carries the value at the reader's own type, which is what makes a defaulted option's carrier `A` rather than `Option(A)`.
pub induct Presence(A: Type): pub Type
| required()
| optional()
| default(a: A)
end

pub induct Kind: pub Type
| flag()
| option(v: Value, presence: Presence(v.A))
| many(v: Value)
| positional(v: Value)
| rest(v: Value)
end

pub struct Arg: pub Type {
    long: Str,
    short: Option(Char),
    help: Str,
    kind: Kind,
}

-- The smart constructors write the common shapes. A short alias or another metavariable is a structure update over one of them -- `Arg { ..Cli/flag("verbose", "Log every request"), short = Option/some('v') }` -- so there is no builder to learn and no half-built state to get wrong.
pub let flag(long: Str, help: Str) -> Arg =
    Arg { long = long, short = Option/none(), help = help, kind = Kind/flag() };

pub let option(long: Str, v: Value, help: Str) -> Arg =
    Arg {
        long = long,
        short = Option/none(),
        help = help,
        kind = Kind/option(v, Presence/required()),
    };

pub let optional(long: Str, v: Value, help: Str) -> Arg =
    Arg {
        long = long,
        short = Option/none(),
        help = help,
        kind = Kind/option(v, Presence/optional()),
    };

pub let default(long: Str, v: Value, fallback: v.A, help: Str) -> Arg =
    Arg {
        long = long,
        short = Option/none(),
        help = help,
        kind = Kind/option(v, Presence/default(fallback)),
    };

pub let many(long: Str, v: Value, help: Str) -> Arg =
    Arg { long = long, short = Option/none(), help = help, kind = Kind/many(v) };

pub let positional(long: Str, v: Value, help: Str) -> Arg =
    Arg { long = long, short = Option/none(), help = help, kind = Kind/positional(v) };

pub let rest(long: Str, v: Value, help: Str) -> Arg =
    Arg { long = long, short = Option/none(), help = help, kind = Kind/rest(v) };

-- What one *kind* contributes to the parsed record. Stated over the kind rather than over the whole entry because the function that builds a field walks the kind under a motive, and a motive can only name what the scrutinee refines: `Carrier(a)` would leave the arm's type stuck on `a` while the match refines `a.kind`.
let KindCarrier(k: Kind) -> Type =
    match k
    | flag() => Bool
    | option(v, presence) =>
        match presence | required() => v.A | optional() => Option(v.A) | default(_) => v.A end
    | many(v) => List(v.A)
    | positional(v) => v.A
    | rest(v) => List(v.A)
    end;

-- What one entry contributes to the parsed record. A flag is always answered, a required or defaulted option and a positional carry the reader's type bare, an optional one carries `Option`, and the two collecting kinds carry a list.
pub let Carrier(a: Arg) -> Type =
    KindCarrier(a.kind);

let is_positional(k: Kind) -> Bool =
    match k | positional(_) => true | _ => false end;

let is_rest(k: Kind) -> Bool =
    match k | rest(_) => true | _ => false end;

-- The parsed record, indexed by the specification it was parsed against. An inductive rather than a computed tuple, so `get(v, name)` reads the specification off `v`'s own type and a handler needs no annotation.
pub induct Values: (List(Arg)) -> pub Type
| nil(): ([])
| cons(@a: Arg, @rest: List(Arg), head: Carrier(a), tail: Values(rest)): ([a, ..rest])
end

-- The type `get` answers at `name`, walked at elaboration. The `[]` case is `{}` and unreachable: `Has` refuses the walk before it can arrive there.
pub let Lookup(spec: List(Arg), name: Str) -> Type =
    match spec
    | [] => {}
    | [a, ..rest] =>
        match Str/eql(a.long, name) | true => Carrier(a) | false => Lookup(rest, name) end
    end;

-- That `name` is one of `spec`'s long names, decided by reduction: `True` where the walk finds it and `False` at the end, so a literal specification discharges it silently and a misspelling is refused where it is written.
pub let Has(spec: List(Arg), name: Str) -> Prop =
    match spec
    | [] => False
    | [a, ..rest] => match Str/eql(a.long, name) | true => True | false => Has(rest, name) end
    end;

-- Read one field by name. The specification is implicit because it is the index of `v`'s type, so a handler writes `Cli/get(v, "port")` and gets the type the specification gives that name.
--
-- Both matches carry a motive that refines the bound alongside the result: the value walk eliminates into a function of the evidence rather than consuming it, because the arm that finds the name and the arm that keeps looking need the evidence at two different types.
pub let get(
    @spec: List(Arg),
    v: Values(spec),
    name: Str,
    @ok: Has(spec, name),
) -> Lookup(spec, name) =
    let walk =
        match v: (s, _) => (found: Has(s, name)) -> Lookup(s, name)
        | nil() => (absent) => match absent end
        | cons(@a, @rest, head, tail) =>
            (found) =>
                let pick =
                    match Str/eql(a.long, name): (b) =>
                        (here: match b | true => True | false => Has(rest, name) end) -> match b
                        | true => Carrier(a)
                        | false => Lookup(rest, name)
                        end
                    | true => (_) => head
                    | false => (later) => get(@rest, tail, name, @later)
                    end;
                pick(found)
        end;
    walk(ok);

-- What a program declares. A command either has arguments and a handler or has subcommands; sharing an argument between subcommands is writing the same `Arg` value into both lists, since a specification is a value.
--
-- `run` is typed by the `args` written two fields above it, so inside a literal the handler's parameter already carries that specification and `Cli/get(v, "port")` there needs no annotation.
pub struct Cli: pub Type {
    name: Str,
    about: Str,
    version: Option(Str),
    args: List(Arg),
    run: (Values(args)) -> Io({}),
    commands: List(Cli),
}

let no_repeat_long(spec: List(Arg)) -> Bool =
    match spec
    | [] => true
    | [a, ..more] =>
        Bool/not(List/any(more, (b) => Str/eql(a.long, b.long))) && no_repeat_long(more)
    end;

let no_repeat_short(spec: List(Arg)) -> Bool =
    match spec
    | [] => true
    | [a, ..more] =>
        match a.short
        | none() => no_repeat_short(more)
        | some(c) =>
            Bool/not(
                List/any(
                    more,
                    (b) => match b.short | some(d) => Char/eql(c, d) | none() => false end))
                && no_repeat_short(more)
        end
    end;

-- `help`, `h` and `version` are the entry's own, spelled here so that a cluster carrying `h` can be read as help before the line is understood at all.
let no_reserved(spec: List(Arg)) -> Bool =
    List/all(
        spec,
        (a) =>
            Bool/not(Str/eql(a.long, "help")) && Bool/not(Str/eql(a.long, "version"))
                && (match a.short | some(c) => Bool/not(Char/eql(c, 'h')) | none() => true end));

-- At most one `rest`, and every positional before it: once a `rest` has been seen nothing may fill from the bare tokens again, which is what makes "the next unfilled positional, then `rest`" a total rule rather than a race.
let rest_comes_last(spec: List(Arg), seen: Bool) -> Bool =
    match spec
    | [] => true
    | [a, ..more] =>
        match seen
        | true => Bool/not(is_positional(a.kind) || is_rest(a.kind)) && rest_comes_last(more, true)
        | false => rest_comes_last(more, is_rest(a.kind))
        end
    end;

let empty(@T: Type, l: List(T)) -> Bool =
    match l | [] => true | [_, .._] => false end;

let no_repeat_name(subs: List(Cli)) -> Bool =
    match subs
    | [] => true
    | [c, ..more] =>
        Bool/not(List/any(more, (d) => Str/eql(c.name, d.name))) && no_repeat_name(more)
    end;

-- Stated flat rather than recursively: the size order grades a constructor payload below its constructor and does not grade a projection below the struct it came from, so a `WellFormed` reached through `cli.commands` is refused as not terminating. One level is what this rule admits, and `main` dispatches exactly that far.
let sound(cli: Cli) -> Bool =
    no_repeat_long(cli.args) && no_repeat_short(cli.args) && no_reserved(cli.args)
        && rest_comes_last(cli.args, false)
        && (match cli.commands
        | [] => true
        | [_, .._] =>
            empty(cli.args) && no_repeat_name(cli.commands)
                && List/all(
                    cli.commands,
                    (c) =>
                        empty(c.commands) && no_repeat_long(c.args) && no_repeat_short(c.args)
                            && no_reserved(c.args)
                            && rest_comes_last(c.args, false))
        end);

-- Decided by reduction and demanded by `main`, so a specification that could never be parsed unambiguously is refused where it is written rather than at the first run that trips over it.
pub let WellFormed(cli: Cli) -> Prop =
    match sound(cli) | true => True | false => False end;

-- Why a line was refused. Each carries what the report needs to name the offender and nothing more; `usage` renders them.
pub induct Failure: pub Type
| unknown_option(token: Str)
| missing_value(name: Str)
| missing_required(name: Str)
| unexpected(token: Str)
| bad_value(name: Str, reason: Str)
| unknown_command(name: Str, known: List(Str))
| missing_command(known: List(Str))
end

-- What a line came to. `parse` answers one of these and performs nothing; `main` is what turns each into a stream and an exit status.
pub induct Outcome(spec: List(Arg)): pub Type
| parsed(Values(spec))
| help()
| version()
| failure(Failure)
end

-- Every entry gathers the same shape -- the raw strings the line supplied for it, in order -- and `field` decides what that shape means at each kind. A flag gathers its own name once per occurrence, so "was it written" is "is this list nonempty", and an option written twice keeps its last because `field` reads the last.
let no_occurrences: List(Str) =
    [];

let empty_slots(spec: List(Arg)) -> List(List(Str)) =
    List/replicate(List/len(spec), no_occurrences);

let push_at(slots: List(List(Str)), i: Nat, s: Str) -> List(List(Str)) =
    match slots
    | [] => []
    | [head, ..tail] =>
        match i | 0 => [[..head, s], ..tail] | j + 1 => [head, ..push_at(tail, j, s)] end
    end;

let takes_value(k: Kind) -> Bool =
    match k
    | flag() => false
    | option(_, _) => true
    | many(_) => true
    | positional(_) => false
    | rest(_) => false
    end;

let long_index(spec: List(Arg), name: Str) -> Option(Nat) =
    List/find_index(spec, (a) => Str/eql(a.long, name));

let short_index(spec: List(Arg), c: Char) -> Option(Nat) =
    List/find_index(spec, (a) => match a.short | some(d) => Char/eql(c, d) | none() => false end);

-- Read by a direct match rather than through `Option/map`: `Arg` carries a `Kind`, which carries a `Value`, which carries a `Type`, so the element type sits a universe above the ground one -- and the elaborator leaves `Option/map`'s instance level generalized where the argument's is concretely one, which the kernel then refuses as an instance it cannot verify. The match commits to no instance and needs none.
let name_at(spec: List(Arg), i: Nat) -> Str =
    match List/try_get(spec, i) | some(a) => a.long | none() => "" end;

let wants_a_value(spec: List(Arg), i: Nat) -> Bool =
    match List/try_get(spec, i) | some(a) => takes_value(a.kind) | none() => false end;

-- The indices of the positional entries in declaration order: the order bare tokens fill them.
let positional_indices(spec: List(Arg)) -> List(Nat) =
    let walk(rest: List(Arg), at: Nat) -> List(Nat) =
        match rest
        | [] => []
        | [a, ..more] =>
            match is_positional(a.kind)
            | true => [at, ..walk(more, at + 1)]
            | false => walk(more, at + 1)
            end
        end;
    walk(spec, 0);

let rest_index(spec: List(Arg)) -> Option(Nat) =
    List/find_index(spec, (a) => is_rest(a.kind));

-- `-h`, `--help`, or an `h` inside a short cluster. `WellFormed` reserves `h` and `help`, so an `h` in a cluster is never a program's own flag -- which is what lets help be decided before the line is understood at all, and so before any failure in it can be reported.
let wants_help(argv: List(Str)) -> Bool =
    List/any(
        argv,
        (t) =>
            Str/eql(t, "--help")
                || Str/starts_with(t, "-") && Bool/not(Str/starts_with(t, "--"))
                    && Str/contains(t, "h"));

let wants_version(argv: List(Str)) -> Bool =
    List/any(argv, (t) => Str/eql(t, "--version"));

-- What the token walk threads: what each entry has gathered, how many positional entries are filled, and whether `--` has been seen.
struct Walk: Type {
    slots: List(List(Str)),
    filled: Nat,
    literal: Bool,
}

-- What a short cluster left behind. `needs` is the last character asking for the following token, which the caller supplies: the walk cannot fetch it itself and stay structural, since the list it would then recurse on is a value rather than a payload of the list it is matching.
induct Cluster: Type
| settled(w: Walk)
| needs(w: Walk, at: Nat, name: Str)
| broke(f: Failure)
end

-- One bare token: the next unfilled positional in declaration order, then `rest`, and otherwise a refusal naming it.
let place(spec: List(Arg), w: Walk, token: Str) -> Result(Failure, Walk) =
    match List/try_get(positional_indices(spec), w.filled)
    | some(i) =>
        Result/success(Walk { ..w, slots = push_at(w.slots, i, token), filled = w.filled + 1 })
    | none() =>
        match rest_index(spec)
        | some(i) => Result/success(Walk { ..w, slots = push_at(w.slots, i, token) })
        | none() => Result/failure(Failure/unexpected(token))
        end
    end;

let run_cluster(spec: List(Arg), w: Walk, chars: List(Char), whole: Str) -> Cluster =
    match chars
    | [] => Cluster/settled(w)
    | [c, ..more] =>
        match short_index(spec, c)
        | none() => Cluster/broke(Failure/unknown_option(whole))
        | some(i) =>
            let name = name_at(spec, i);
            match wants_a_value(spec, i)
            | false =>
                run_cluster(spec, Walk { ..w, slots = push_at(w.slots, i, name) }, more, whole)
            | true =>
                match more
                | [] => Cluster/needs(w, i, name)
                | [_, .._] =>
                    Cluster/settled(
                        Walk {
                            ..w,
                            slots = push_at(w.slots, i, Str/flatten(List/map(more, Str/of_char))),
                        })
                end
            end
        end
    end;

-- The token walk. Every recursive call is on the tail of the list being matched, the two that consume a following token as a value included -- which is why `run_cluster` reports `needs` rather than fetching that token itself.
let step(spec: List(Arg), w: Walk, tokens: List(Str)) -> Result(Failure, List(List(Str))) =
    match tokens
    | [] => Result/success(w.slots)
    | [t, ..more] =>
        match w.literal
        | true => Result/bind(place(spec, w, t), (w2) => step(spec, w2, more))
        | false =>
            match Str/eql(t, "--")
            | true => step(spec, Walk { ..w, literal = true }, more)
            | false =>
                match Str/starts_with(t, "--")
                | true =>
                    let body = Str/slice(t, 2, Str/len(t));
                    match Str/split_once(body, "=")
                    | some((name, value)) =>
                        match long_index(spec, name)
                        | none() => Result/failure(Failure/unknown_option(t))
                        | some(i) =>
                            match wants_a_value(spec, i)
                            | false =>
                                Result/failure(Failure/bad_value(name, "this flag takes no value"))
                            | true =>
                                step(spec, Walk { ..w, slots = push_at(w.slots, i, value) }, more)
                            end
                        end
                    | none() =>
                        match long_index(spec, body)
                        | none() => Result/failure(Failure/unknown_option(t))
                        | some(i) =>
                            match wants_a_value(spec, i)
                            | false =>
                                step(spec, Walk { ..w, slots = push_at(w.slots, i, body) }, more)
                            | true =>
                                match more
                                | [] => Result/failure(Failure/missing_value(body))
                                | [v, ..rest2] =>
                                    step(spec, Walk { ..w, slots = push_at(w.slots, i, v) }, rest2)
                                end
                            end
                        end
                    end
                | false =>
                    match Str/starts_with(t, "-") && Nat/lt(1, Str/len(t))
                    | true =>
                        match run_cluster(spec, w, Str/to_list(Str/slice(t, 1, Str/len(t))), t)
                        | broke(f) => Result/failure(f)
                        | settled(w2) => step(spec, w2, more)
                        | needs(w2, i, name) =>
                            match more
                            | [] => Result/failure(Failure/missing_value(name))
                            | [v, ..rest2] =>
                                step(spec, Walk { ..w2, slots = push_at(w2.slots, i, v) }, rest2)
                            end
                        end
                    | false => Result/bind(place(spec, w, t), (w2) => step(spec, w2, more))
                    end
                end
            end
        end
    end;

-- One field of the parsed record, at the type its kind decides. The motive is over the *kind* -- what the match refines -- which is why `KindCarrier` is stated there rather than over the whole entry.
let field(name: Str, k: Kind, occurrences: List(Str)) -> Result(Failure, KindCarrier(k)) =
    let last_of = List/last(occurrences);
    let read_with(v: Value, s: Str) -> Result(Failure, v.A) =
        Result/map_failure(v.read(s), (reason) => Failure/bad_value(name, reason));
    match k: (k2) => Result(Failure, KindCarrier(k2))
    | flag() => Result/success(match occurrences | [] => false | [_, .._] => true end)
    | option(v, presence) =>
        match presence: (p) =>
            Result(
                Failure,
                match p | required() => v.A | optional() => Option(v.A) | default(_) => v.A end)
        | required() =>
            match last_of
            | none() => Result/failure(Failure/missing_required(name))
            | some(s) => read_with(v, s)
            end
        | optional() =>
            match last_of
            | none() => Result/success(Option/none())
            | some(s) => Result/map_success(read_with(v, s), (a) => Option/some(a))
            end
        | default(fallback) =>
            match last_of | none() => Result/success(fallback) | some(s) => read_with(v, s) end
        end
    | many(v) => List/traverse(occurrences, (s) => read_with(v, s))
    | positional(v) =>
        match last_of
        | none() => Result/failure(Failure/missing_required(name))
        | some(s) => read_with(v, s)
        end
    | rest(v) => List/traverse(occurrences, (s) => read_with(v, s))
    end;

-- The specification and the gathered slots walked in lockstep. `spec` carries the motive because it is what the answer is indexed by; the slots are an ordinary list beside it, and the two are the same length by construction -- `empty_slots` made one per entry and `push_at` never changes the length.
let fill(spec: List(Arg), slots: List(List(Str))) -> Result(Failure, Values(spec)) =
    match spec: (s) => Result(Failure, Values(s))
    | [] => Result/success(Values/nil())
    | [a, ..more] =>
        let here = Option/unwrap_or(List/try_get(slots, 0), no_occurrences);
        let later = match slots | [] => [] | [_, ..tail] => tail end;
        Result/bind(
            field(a.long, a.kind, here),
            (head) => Result/map_success(fill(more, later), (tail) => Values/cons(head, tail)))
    end;

-- The pure core: a line in, an outcome out, nothing performed. Help wins over every other reading of the line, and a version is answered only where the command declares one.
pub let parse(spec: List(Arg), argv: List(Str), versioned: Bool) -> Outcome(spec) =
    match wants_help(argv)
    | true => Outcome/help()
    | false =>
        match versioned && wants_version(argv)
        | true => Outcome/version()
        | false =>
            match step(spec, Walk { slots = empty_slots(spec), filled = 0, literal = false }, argv)
            | failure(f) => Outcome/failure(f)
            | success(slots) =>
                match fill(spec, slots)
                | failure(f) => Outcome/failure(f)
                | success(v) => Outcome/parsed(v)
                end
            end
        end
    end;

-- The placeholder an entry stands behind in the usage line and the option rows: a positional is its own name shouted, an option is its reader's metavariable, and a flag has none.
let shout(s: Str) -> Str =
    Str/flatten(List/map(Str/to_list(s), (c) => Str/of_char(Char/to_ascii_upper(c))));

let metavar_of(k: Kind) -> Option(Str) =
    match k
    | flag() => Option/none()
    | option(v, _) => Option/some(v.metavar)
    | many(v) => Option/some(v.metavar)
    | positional(v) => Option/none()
    | rest(v) => Option/none()
    end;

-- `Usage: name [OPTIONS] <ROOT> [REST]...`, with the bracket telling required from collected.
let placeholder(a: Arg) -> Option(Str) =
    match a.kind
    | positional(_) => Option/some(Str/flatten(["<", shout(a.long), ">"]))
    | rest(_) => Option/some(Str/flatten(["[", shout(a.long), "]..."]))
    | _ => Option/none()
    end;

-- Walked by hand rather than through `List/filter_map` and `List/map`: those carry two type parameters, and `Arg` sits a universe above `Str` because it reaches a `Type` through `Kind` and `Value`. The elaborator leaves one of the two instance levels generalized where the argument's is concrete, and the kernel refuses the instance it cannot verify; a written walk commits to none. `List/any` below is fine -- it has one parameter and nothing to leave undecided.
let placeholders(spec: List(Arg)) -> List(Str) =
    match spec
    | [] => []
    | [a, ..more] =>
        match placeholder(a)
        | some(p) => [p, ..placeholders(more)]
        | none() => placeholders(more)
        end
    end;

let positional_rows(spec: List(Arg)) -> List({Str, Str}) =
    match spec
    | [] => []
    | [a, ..more] =>
        match placeholder(a)
        | some(p) => [(p, a.help), ..positional_rows(more)]
        | none() => positional_rows(more)
        end
    end;

let option_rows(spec: List(Arg)) -> List({Str, Str}) =
    match spec
    | [] => []
    | [a, ..more] =>
        match is_positional(a.kind) || is_rest(a.kind)
        | true => option_rows(more)
        | false => [(option_head(a), a.help), ..option_rows(more)]
        end
    end;

let command_rows(subs: List(Cli)) -> List({Str, Str}) =
    match subs | [] => [] | [c, ..more] => [(c.name, c.about), ..command_rows(more)] end;

let has_options(spec: List(Arg)) -> Bool =
    List/any(spec, (a) => Bool/not(is_positional(a.kind) || is_rest(a.kind)));

pub let usage(cli: Cli) -> Str =
    let head =
        match has_options(cli.args) | true => [cli.name, "[OPTIONS]"] | false => [cli.name] end;
    let tail = placeholders(cli.args);
    let commands = match cli.commands | [] => [] | [_, .._] => ["<COMMAND>"] end;
    Str/flatten(["Usage: ", Str/join(" ", List/flatten([head, tail, commands]))]);

-- One option row's left column: `-v, --verbose`, or four spaces where there is no short, so the long names line up whether or not their neighbours have one.
let option_head(a: Arg) -> Str =
    let short =
        match a.short | some(c) => Str/flatten(["-", Str/of_char(c), ", "]) | none() => "    " end;
    let value =
        match metavar_of(a.kind) | some(m) => Str/flatten([" <", m, ">"]) | none() => "" end;
    Str/flatten([short, "--", a.long, value]);

-- A section is its rows padded to the widest left column in *that* section, two spaces before the help. Per section rather than across all three: a lone `<ROOT>` beside a long option row would otherwise carry the option column's padding into a heading it has nothing to do with. An empty section prints nothing at all rather than a bare heading.
let widest(rows: List({Str, Str})) -> Nat =
    List/fold(rows, 0, ((left, _), so_far) => Nat/max(Str/len(left), so_far));

let section(heading: Str, rows: List({Str, Str})) -> List(Str) =
    match rows
    | [] => []
    | [_, .._] =>
        let width = widest(rows);
        let render(row: {Str, Str}) -> Str =
            Str/flatten(["  ", Str/pad_end(row.0, width, ' '), "  ", row.1, "\n"]);
        List/flatten([[heading, "\n"], List/map(rows, render), ["\n"]])
    end;

-- The two rows every command answers, whatever it declares. They are in the help because `main` answers them, and `WellFormed` reserves their names so nothing can collide with them.
let builtin_rows(cli: Cli) -> List({Str, Str}) =
    let help_row: {Str, Str} = ("-h, --help", "Print help");
    match cli.version
    | none() => [help_row]
    | some(_) => [help_row, ("    --version", "Print version")]
    end;

pub let help(cli: Cli) -> Str =
    let arguments = positional_rows(cli.args);
    let options = List/flatten([option_rows(cli.args), builtin_rows(cli)]);
    let commands = command_rows(cli.commands);
    Str/flatten(
        List/flatten(
            [
                [cli.about, "\n\n", usage(cli), "\n\n"],
                section("Arguments:", arguments),
                section("Options:", options),
                section("Commands:", commands)]));

let complaint(f: Failure) -> Str =
    match f
    | unknown_option(t) => Str/flatten(["unexpected argument '", t, "'"])
    | missing_value(n) => Str/flatten(["a value is required for '--", n, "'"])
    | missing_required(n) => Str/flatten(["the argument '", shout(n), "' is required"])
    | unexpected(t) => Str/flatten(["unexpected argument '", t, "'"])
    | bad_value(n, r) => Str/flatten(["invalid value for '--", n, "': ", r])
    | unknown_command(n, known) =>
        Str/flatten(["unrecognized subcommand '", n, "'\n  available: ", Str/join(", ", known)])
    | missing_command(known) =>
        Str/flatten(["a subcommand is required\n  available: ", Str/join(", ", known)])
    end;

pub let report(cli: Cli, f: Failure) -> Str =
    Str/flatten(
        ["error: ", complaint(f), "\n\n", usage(cli), "\n\nFor more information, try '--help'.\n"]);

-- There is no `main` yet, and the gap is deliberate rather than forgotten: an entry handing `parse(cli.args, ...)` to `cli.run` is refused by the kernel, which reads the instance levels of a specification-indexed function applied to a `Type`-carrying field as constants where the caller supplies its own parameters. Until the elaborator settles which of a declaration's interface levels may be minimized and which must be generalized, a program spells the six lines itself over `parse`, `help` and `report`.
-- What choosing a subcommand came to. It mirrors `Outcome` deliberately: help is decided before the first token is read as a name, so a parent answers `--help` rather than refusing it as an unknown command, and a caller dispatches on one shape either way.
pub induct Chosen: pub Type
| chose(sub: Cli, rest: List(Str))
| wanted_help()
| wanted_version()
| refused(f: Failure)
end

let command_names(subs: List(Cli)) -> List(Str) =
    match subs | [] => [] | [c, ..more] => [c.name, ..command_names(more)] end;

let named(subs: List(Cli), name: Str) -> Option(Cli) =
    match subs
    | [] => Option/none()
    | [c, ..more] =>
        match Str/eql(c.name, name) | true => Option/some(c) | false => named(more, name) end
    end;

-- The first token names the subcommand and everything after it is that subcommand's line. One level deep: `WellFormed` requires every child's own `commands` to be empty, so what this hands back is a command that parses rather than one that selects again.
pub let select(cli: Cli, argv: List(Str)) -> Chosen =
    let names = command_names(cli.commands);
    match wants_help(argv)
    | true => Chosen/wanted_help()
    | false =>
        match Option/is_some(cli.version) && wants_version(argv)
        | true => Chosen/wanted_version()
        | false =>
            match argv
            | [] => Chosen/refused(Failure/missing_command(names))
            | [first, ..rest] =>
                match named(cli.commands, first)
                | some(sub) => Chosen/chose(sub, rest)
                | none() => Chosen/refused(Failure/unknown_command(first, names))
                end
            end
        end
    end;
