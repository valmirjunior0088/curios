pub use /sys/{Bool};
pub use /sys/Bool/{and, or, xor, eql, False, Holds};
use /std/{Str, Option, Eq, Show, Spell, Ordering, Ord};
use /std/ops/{Eql, Or, And, Cmp};

--- The trivial proposition, inhabited by `qed`: what a decided bound reduces to when it holds.
pub mod True;
pub use True/{let True};

--- The other value.
pub let not(b: Bool) -> Bool =
    xor(b, true);

--- `true` or `false`, as written.
pub let to_str(b: Bool) -> Str =
    match b | true => "true" | false => "false" end;

--- The value `to_str` writes, or `none` for any other text.
pub let of_str(s: Str) -> Option(Bool) =
    choose
    | s == "true" => Option/some(true)
    | s == "false" => Option/some(false)
    | _ => Option/none()
    end;

--- `false` and `true` are distinct: the absurdity every decision procedure over a `Bool` discharges its impossible arm with.
pub let false_neq_true(p: Eq(false, true)) -> Bool/False =
    Eq/subst(
        (b: Bool) => match b | true => Bool/False | false => Bool/True end,
        p,
        Bool/True/qed());

--- The decision as an equation: `Bool/Holds(b)` says `b` is `true`, and this says it the way `Eq/subst` rewrites with. By cases on `b`, since `Bool/Holds` reduces at each.
pub let eq_of_holds(b: Bool, h: Bool/Holds(b)) -> Eq(b, true) =
    match b
    | true => Eq/refl()
    | false => match h end
    end;

--- The equation as the decision, back: `Bool/True/qed()` carried along the equation read the other way.
pub let holds_of_eq(b: Bool, p: Eq(b, true)) -> Bool/Holds(b) =
    Eq/subst((x: Bool) => Bool/Holds(x), Eq/sym(p), Bool/True/qed());

satisfy Eql(Bool) {
    eql = eql,
    neq = xor,
}

satisfy Or(Bool) {
    or = or,
}

satisfy And(Bool) {
    and = and,
}

satisfy Show(Bool) {
    show = to_str,
}

satisfy Spell(Bool) {
    spell = to_str,
}

--- `false` below `true`.
pub let cmp(a: Bool, b: Bool) -> Ordering =
    match a
    | false => match b | false => Ordering/eq() | true => Ordering/lt() end
    | true => match b | false => Ordering/gt() | true => Ordering/eq() end
    end;

satisfy Cmp(Bool) {
    lt(a, b) = Ordering/is_lt(cmp(a, b)),
    le(a, b) = Ordering/is_le(cmp(a, b)),
    gt(a, b) = Ordering/is_gt(cmp(a, b)),
    ge(a, b) = Ordering/is_ge(cmp(a, b)),
}

satisfy Ord(Bool) {
    ord = cmp,
}
