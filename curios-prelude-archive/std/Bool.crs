pub use /sys/{Bool};
pub use /sys/Bool/{and, or, xor, eql};
use /std/{Nat, Str, Option, Eq, False, True, Eql, Or, And, Show, Spell, Order, Cmp, Ord};
use /std/Test/{Draw, Seed};

pub let not(b: Bool) -> Bool =
    xor(b, true);

pub let to_str(b: Bool) -> Str =
    match b | true => "true" | false => "false" end;

pub let of_str(s: Str) -> Option(Bool) =
    choose
    | s == "true" => Option/some(true)
    | s == "false" => Option/some(false)
    | _ => Option/none()
    end;

-- The two boolean constructors are distinct: a proof otherwise is absurd. Every `match b : Prop` decision procedure discharges its impossible branch through this.
pub let false_neq_true(p: Eq(false, true)) -> False =
    Eq/subst((b: Bool) => match b | true => False | false => True end, p, True/qed());

-- `xor` is disequality on one bit, so `!=` needs no negation here.
satisfy Eql(Bool) {
    eql = eql,
    neq = xor,
}

satisfy Or(Bool) {
    or = or,
}

satisfy And(Bool) {
    and = and,
}

satisfy Show(Bool) {
    show = to_str,
}

satisfy Spell(Bool) {
    spell = to_str,
}

-- `false` below `true`.
pub let cmp(a: Bool, b: Bool) -> Order =
    match a
    | false => match b | false => Order/eq() | true => Order/lt() end
    | true => match b | false => Order/gt() | true => Order/eq() end
    end;

satisfy Cmp(Bool) {
    lt(a, b) = Order/is_lt(cmp(a, b)),
    le(a, b) = Order/is_le(cmp(a, b)),
    gt(a, b) = Order/is_gt(cmp(a, b)),
    ge(a, b) = Order/is_ge(cmp(a, b)),
}

satisfy Ord(Bool) {
    cmp = cmp,
}

satisfy Draw(Bool) {
    draw(seed, size) =
        let (n, rest) = Seed/next(seed);
        (Nat/and(n, 1) == 1, rest),
}
