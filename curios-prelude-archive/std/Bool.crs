pub use /sys/{Bool};
pub use /sys/Bool/{and, or, xor, eql};
use /std/{Nat, Str, Option, Eq, False, True, Equal, Or, And, Show, Spell, Ordering, Compare,
    Ordered, Test};

pub let not(b: Bool) -> Bool =
    xor(b, true);

pub let to_str(b: Bool) -> Str =
    match b | true => "true" | false => "false" end;

pub let of_str(s: Str) -> Option(Bool) =
    choose
    | s == "true" => Option/some(true)
    | s == "false" => Option/some(false)
    | _ => Option/none()
    end;

-- The two boolean constructors are distinct: a proof otherwise is absurd. Every `match b : Prop` decision procedure discharges its impossible branch through this.
pub let false_neq_true(p: Eq(false, true)) -> False =
    Eq/subst((b: Bool) => match b | true => False | false => True end, p, True/qed());

-- `xor` is disequality on one bit, so `!=` needs no negation here.
satisfy Equal(Bool) {
    eql = eql,
    neq = xor,
}

satisfy Or(Bool) {
    or = or,
}

satisfy And(Bool) {
    and = and,
}

satisfy Show(Bool) {
    show = to_str,
}

satisfy Spell(Bool) {
    spell = to_str,
}

-- `false` below `true`.
pub let cmp(a: Bool, b: Bool) -> Ordering =
    match a
    | false => match b | false => Ordering/eq() | true => Ordering/lt() end
    | true => match b | false => Ordering/gt() | true => Ordering/eq() end
    end;

satisfy Compare(Bool) {
    lt(a, b) = Ordering/is_lt(cmp(a, b)),
    le(a, b) = Ordering/is_le(cmp(a, b)),
    gt(a, b) = Ordering/is_gt(cmp(a, b)),
    ge(a, b) = Ordering/is_ge(cmp(a, b)),
}

satisfy Ordered(Bool) {
    cmp = cmp,
}

satisfy Test/Draw(Bool) {
    all() = Option/some([true, false]),
    draw(seed, size) =
        let (n, rest) = Test/Seed/next(seed);
        (Nat/and(n, 1) == 1, rest),
}
