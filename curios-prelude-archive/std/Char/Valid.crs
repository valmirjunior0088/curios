use /std/{Bool, Nat, Option};
use /std/Char/{is_valid};

--- That `code` is a Unicode scalar value, which is what `Char` carries.
---
--- Decided, so a literal or a guard already taken discharges it by reduction.
pub let Valid(code: Nat) -> Prop =
    Bool/Holds(is_valid(code));

--- The evidence that `code` is a Unicode scalar value, or `none`.
pub let try(code: Nat) -> Option(Valid(code)) =
    match is_valid(code): (r) => Option(Bool/Holds(r))
    | true => Option/some(Bool/True/qed())
    | false => Option/none()
    end;
