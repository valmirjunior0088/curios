use /std/{Result, Nat, Byte, Bytes, Str, Bool, List, Option, Monad};

pub struct Parse(A: Type): pub Type {
    run(input: Bytes, pos: Nat) -> Result({Nat, A}, Str),
}

pub let run(@A: Type, p: Parse(A), input: Bytes) -> Result(A, Str) =
    match p.run(input, 0)
    | success((_, a)) => Result/success(a)
    | failure(msg) => Result/failure(msg)
    end;

pub let pure(@A: Type, a: A) -> Parse(A) =
    Parse { run(input, pos) = Result/success((pos, a)) };

pub let fail(@A: Type, msg: Str) -> Parse(A) =
    Parse { run(input, pos) = Result/failure(msg) };

pub let map(@A: Type, @B: Type, p: Parse(A), f: (A) -> B) -> Parse(B) =
    Parse {
        run(input, pos) =
            match p.run(input, pos)
            | success((next, a)) => Result/success((next, f(a)))
            | failure(msg) => Result/failure(msg)
            end,
    };

pub let bind(@A: Type, @B: Type, p: Parse(A), f: (A) -> Parse(B)) -> Parse(B) =
    Parse {
        run(input, pos) =
            match p.run(input, pos)
            | success((next, a)) => f(a).run(input, next)
            | failure(msg) => Result/failure(msg)
            end,
    };

pub let or(@A: Type, p: Parse(A), q: Parse(A)) -> Parse(A) =
    Parse {
        run(input, pos) =
            match p.run(input, pos)
            | success(pair) => Result/success(pair)
            | failure(_) => q.run(input, pos)
            end,
    };

pub let and(@A: Type, @B: Type, p: Parse(A), q: Parse(B)) -> Parse({A, B}) =
    Parse {
        run(input, pos) =
            match p.run(input, pos)
            | success((mid, a)) =>
                match q.run(input, mid)
                | success((next, b)) => Result/success((next, (a, b)))
                | failure(msg) => Result/failure(msg)
                end
            | failure(msg) => Result/failure(msg)
            end,
    };

pub let any_byte: Parse(Byte) =
    Parse {
        run(input, pos) =
            match Nat/Lt/try(pos, Bytes/len(input))
            | none() => Result/failure("unexpected end of input")
            | some(ok) => Result/success((pos + 1, Bytes/get(input, pos, @ok)))
            end,
    };

pub let peek_byte: Parse(Byte) =
    Parse {
        run(input, pos) =
            match Nat/Lt/try(pos, Bytes/len(input))
            | none() => Result/failure("unexpected end of input")
            | some(ok) => Result/success((pos, Bytes/get(input, pos, @ok)))
            end,
    };

pub let take_byte(expected: Byte) -> Parse(Byte) =
    Parse {
        run(input, pos) =
            match Nat/Lt/try(pos, Bytes/len(input))
            | none() => Result/failure("unexpected end of input")
            | some(ok) =>
                let byte = Bytes/get(input, pos, @ok);
                match byte == expected
                | true => Result/success((pos + 1, byte))
                | false => Result/failure("unexpected byte")
                end
            end,
    };

pub let take_literal(literal: Str) -> Parse({}) =
    Parse {
        run(input, pos) =
            let lit = Str/to_bytes(literal);
            let (stop, matched) =
                match Bytes/len(lit): (_) => {Nat, Bool}
                | 0 => (pos, true)
                | step + 1; ih =>
                    let (cur, live) = ih;
                    match live
                    | true =>
                        match Nat/Lt/try(cur, Bytes/len(input))
                        | none() => (cur, false)
                        | some(ok) =>
                            match Option/unwrap_or(Bytes/try_get(lit, step), 0)
                                == Bytes/get(input, cur, @ok)
                            | true => (cur + 1, true)
                            | false => (cur, false)
                            end
                        end
                    | false => ih
                    end
                end;
            match matched
            | true => Result/success((stop, ()))
            | false => Result/failure("unexpected literal")
            end,
    };

pub let eof: Parse({}) =
    Parse {
        run(input, pos) =
            match pos < Bytes/len(input)
            | true => Result/failure("expected end of input")
            | false => Result/success((pos, ()))
            end,
    };

pub let take_while(pred: (Byte) -> Bool) -> Parse(Bytes) =
    Parse {
        -- The walk carries the window's bound rather than testing for it: it counts what it has taken and only ever advances past an index `Nat/Lt/try` has already checked. Only the starting position is tested, because it is the one fact the caller supplies and `Parse` deliberately accepts an unchecked one — the same reason `any_byte` tests rather than demanding a bounded position.
        --
        -- Counting rather than tracking a stop is what leaves one invariant where there were two. `Nat/Le(pos + taken, len input)` *is* the window's bound, so it is carried into the slice with nothing done to it, and the ordering half the old `(start, end)` window also demanded has no proposition left to state. The count is what the loop naturally produces; the stop is recovered once, at the end, for the position the parse continues from.
        run(input, pos) =
            match Nat/Le/try(pos, Bytes/len(input))
            | none() => Result/failure("position past the end of input")
            | some(within) =>
                let (taken, at_stop, _) =
                    match Bytes/len(input) - pos: (_) =>
                        {
                            taken: Nat,
                            within: Nat/Le(pos + taken, Bytes/len(input)),
                            stopped: Bool}
                    | 0 => (0, within, false)
                    | step + 1; ih =>
                        let (taken, at_cur, stopped) = ih;
                        match stopped
                        | true => ih
                        | false =>
                            match Nat/Lt/try(pos + taken, Bytes/len(input))
                            | none() => (taken, at_cur, true)
                            | some(ok) =>
                                match pred(Bytes/get(input, pos + taken, @ok))
                                | true =>
                                    (
                                        taken + 1,
                                        Nat/Lt/le_succ_of_lt(
                                            pos + taken,
                                            Bytes/len(input),
                                            ok),
                                        false)
                                | false => (taken, at_cur, true)
                                end
                            end
                        end
                    end;
                Result/success((pos + taken, Bytes/slice(input, pos, taken, @at_stop)))
            end,
    };

pub let many0(@A: Type, p: Parse(A)) -> Parse(List(A)) =
    Parse {
        run(input, pos) =
            rec go(acc: List(A), cur: Nat) -> Result({Nat, List(A)}, Str) =
                match p.run(input, cur)
                | failure(_) => Result/success((cur, acc))
                | success((next, a)) =>
                    match next == cur
                    | true => Result/success((cur, acc))
                    | false => go([..acc, a], next)
                    end
                end;
            go([], pos),
    };

pub let sep_by0(@A: Type, @S: Type, elem: Parse(A), sep: Parse(S)) -> Parse(List(A)) =
    Parse {
        run(input, pos) =
            match elem.run(input, pos)
            | failure(_) => Result/success((pos, []))
            | success((first_end, first)) =>
                rec go(acc: List(A), cur: Nat) -> Result({Nat, List(A)}, Str) =
                    match sep.run(input, cur)
                    | failure(_) => Result/success((cur, acc))
                    | success((sep_end, _)) =>
                        match elem.run(input, sep_end)
                        | failure(_) => Result/success((cur, acc))
                        | success((next, x)) =>
                            match next == cur
                            | true => Result/success((cur, acc))
                            | false => go([..acc, x], next)
                            end
                        end
                    end;
                go([first], first_end)
            end,
    };

satisfy Monad(Parse) {
    pure = pure,
    bind = bind,
}
