use /std/{Result, Nat, Byte, Bytes, Str, Bool, List, Option, Monad};

-- | Why a parser refused, and where.
pub mod Error;
pub use Error/{let Error};

-- | A parser: from a position in the input to a position and a value, or a refusal.
pub struct Parse(A: Type): Type {
    run(input: Bytes, pos: Nat) -> Result(Error, {Nat, A}),
}

-- | `p` from the start of `input`: its value, or the refusal that stopped it. A parser that stops early still succeeds, so a parser that must consume everything ends with `eof`.
pub let run(@A: Type, p: Parse(A), input: Bytes) -> Result(Error, A) =
    match p.run(input, 0)
    | success((_, a)) => Result/success(a)
    | failure(refusal) => Result/failure(refusal)
    end;

-- | `a`, consuming nothing.
pub let pure(@A: Type, a: A) -> Parse(A) =
    Parse { run(_input, pos) = Result/success((pos, a)) };

-- | Decline with `msg`, consuming nothing.
pub let fail(@A: Type, msg: Str) -> Parse(A) =
    Parse { run(_input, pos) = Result/failure(Error/declined(msg, pos)) };

-- | `f` on the value.
pub let map(@A: Type, @B: Type, p: Parse(A), f: (A) -> B) -> Parse(B) =
    Parse {
        run(input, pos) =
            match p.run(input, pos)
            | success((next, a)) => Result/success((next, f(a)))
            | failure(refusal) => Result/failure(refusal)
            end,
    };

-- | `p`, then `f` on its value from where it stopped.
pub let bind(@A: Type, @B: Type, p: Parse(A), f: (A) -> Parse(B)) -> Parse(B) =
    Parse {
        run(input, pos) =
            match p.run(input, pos)
            | success((next, a)) => f(a).run(input, next)
            | failure(refusal) => Result/failure(refusal)
            end,
    };

-- | `p`, or `q` from the same position when `p` declines. A committed refusal is reported as it is.
pub let or(@A: Type, p: Parse(A), q: Parse(A)) -> Parse(A) =
    Parse {
        run(input, pos) =
            match p.run(input, pos)
            | success(pair) => Result/success(pair)
            | failure(e) =>
                match e.committed | false => q.run(input, pos) | true => Result/failure(e) end
            end,
    };

-- | `p` as the shape the input has been recognized to have: a refusal inside it is committed, so an enclosing `or` reports it rather than trying an alternative.
pub let commit(@A: Type, p: Parse(A)) -> Parse(A) =
    Parse {
        run(input, pos) =
            match p.run(input, pos)
            | success(pair) => Result/success(pair)
            | failure(refusal) => Result/failure(Error/commit(refusal))
            end,
    };

-- | `p`, declining with `msg` in place of its own reason.
pub let label(@A: Type, p: Parse(A), msg: Str) -> Parse(A) =
    or(p, fail(msg));

-- | `p`'s value, or `none` when it declines, consuming nothing then.
pub let optional(@A: Type, p: Parse(A)) -> Parse(Option(A)) =
    or(map(p, (a) => Option/some(a)), pure(Option/none()));

-- | `p` then `q`, their values paired.
pub let and(@A: Type, @B: Type, p: Parse(A), q: Parse(B)) -> Parse({A, B}) =
    Parse {
        run(input, pos) =
            match p.run(input, pos)
            | success((mid, a)) =>
                match q.run(input, mid)
                | success((next, b)) => Result/success((next, (a, b)))
                | failure(refusal) => Result/failure(refusal)
                end
            | failure(refusal) => Result/failure(refusal)
            end,
    };

-- | The next byte; declines at the end of the input.
pub let any_byte: Parse(Byte) =
    Parse {
        run(input, pos) =
            match Nat/Lt/try(pos, Bytes/len(input))
            | none() => Result/failure(Error/declined("unexpected end of input", pos))
            | some(ok) => Result/success((pos + 1, Bytes/get(input, pos, @ok)))
            end,
    };

-- | The next byte when `pred` accepts it; declines otherwise, consuming nothing.
pub let take_if(pred: (Byte) -> Bool) -> Parse(Byte) =
    bind(any_byte, (byte) =>
        match pred(byte) | true => pure(byte) | false => fail("unexpected byte") end);

-- | The next byte without consuming it; declines at the end of the input.
pub let peek_byte: Parse(Byte) =
    Parse {
        run(input, pos) =
            match Nat/Lt/try(pos, Bytes/len(input))
            | none() => Result/failure(Error/declined("unexpected end of input", pos))
            | some(ok) => Result/success((pos, Bytes/get(input, pos, @ok)))
            end,
    };

-- | The next byte without consuming it, or `none` at the end of the input.
pub let peek: Parse(Option(Byte)) =
    or(map(peek_byte, (b) => Option/some(b)), pure(Option/none()));

let byte_spelling(byte: Byte) -> Str =
    match Str/of_bytes(x[byte])
    | some(s) =>
        match Nat/in_range(Byte/to_nat(byte), 0x21, 0x7E)
        | true => Str/flatten(["'", s, "'"])
        | false => Str/concat("byte ", Nat/to_str(Byte/to_nat(byte)))
        end
    | none() => Str/concat("byte ", Nat/to_str(Byte/to_nat(byte)))
    end;

-- | The byte `expected`; declines on any other.
pub let take_byte(expected: Byte) -> Parse(Byte) =
    let message = Str/concat("expected ", byte_spelling(expected));
    Parse {
        run(input, pos) =
            match Nat/Lt/try(pos, Bytes/len(input))
            | none() => Result/failure(Error/declined("unexpected end of input", pos))
            | some(ok) =>
                let byte = Bytes/get(input, pos, @ok);
                match byte == expected
                | true => Result/success((pos + 1, byte))
                | false => Result/failure(Error/declined(message, pos))
                end
            end,
    };

-- | The bytes of `literal`, exactly; declines on anything else.
pub let take_literal(literal: Str) -> Parse({}) =
    let message = Str/flatten(["expected \"", literal, "\""]);
    Parse {
        run(input, pos) =
            let lit = Str/to_bytes(literal);
            let (stop, matched) =
                match Bytes/len(lit): (_) => {Nat, Bool}
                | 0 => (pos, true)
                | step + 1; ih =>
                    let (cur, live) = ih;
                    match live
                    | true =>
                        match Nat/Lt/try(cur, Bytes/len(input))
                        | none() => (cur, false)
                        | some(ok) =>
                            match Option/unwrap_or(Bytes/try_get(lit, step), 0)
                                == Bytes/get(input, cur, @ok)
                            | true => (cur + 1, true)
                            | false => (cur, false)
                            end
                        end
                    | false => ih
                    end
                end;
            match matched
            | true => Result/success((stop, ()))
            | false => Result/failure(Error/declined(message, pos))
            end,
    };

-- | The end of the input; declines while anything remains.
pub let eof: Parse({}) =
    Parse {
        run(input, pos) =
            match pos < Bytes/len(input)
            | true => Result/failure(Error/declined("expected end of input", pos))
            | false => Result/success((pos, ()))
            end,
    };

-- | The longest run of bytes `pred` accepts, possibly empty.
pub let take_while(pred: (Byte) -> Bool) -> Parse(Bytes) =
    Parse {
        run(input, pos) =
            match Nat/Le/try(pos, Bytes/len(input))
            | none() => Result/failure(Error/declined("position past the end of input", pos))
            | some(within) =>
                let (taken, at_stop, _) =
                    match Bytes/len(input) - pos: (_) =>
                        {taken: Nat, within: Nat/Le(pos + taken, Bytes/len(input)), stopped: Bool}
                    | 0 => (0, within, false)
                    | _step + 1; ih =>
                        let (taken, at_cur, stopped) = ih;
                        match stopped
                        | true => ih
                        | false =>
                            match Nat/Lt/try(pos + taken, Bytes/len(input))
                            | none() => (taken, at_cur, true)
                            | some(ok) =>
                                match pred(Bytes/get(input, pos + taken, @ok))
                                | true =>
                                    (
                                        taken + 1,
                                        Nat/Lt/le_succ_of_lt(pos + taken, Bytes/len(input), ok),
                                        false)
                                | false => (taken, at_cur, true)
                                end
                            end
                        end
                    end;
                Result/success((pos + taken, Bytes/slice(input, pos, taken, @at_stop)))
            end,
    };

-- | `p` for its value alone: the position is left where `p` started.
pub let lookahead(@A: Type, p: Parse(A)) -> Parse(A) =
    Parse {
        run(input, pos) =
            match p.run(input, pos)
            | success((_, a)) => Result/success((pos, a))
            | failure(refusal) => Result/failure(refusal)
            end,
    };

-- | Everything from the current position to the end of the input.
pub let rest: Parse(Bytes) =
    Parse {
        run(input, pos) =
            match Nat/Le/try(pos, Bytes/len(input))
            | none() => Result/failure(Error/declined("position past the end of input", pos))
            | some(within) => Result/success((Bytes/len(input), Bytes/drop(input, pos, @within)))
            end,
    };

-- | The next `n` bytes, or everything that remains when fewer are left.
pub let take(n: Nat) -> Parse(Bytes) =
    Parse {
        run(input, pos) =
            match Nat/Le/try(pos + n, Bytes/len(input))
            | some(within) => Result/success((pos + n, Bytes/slice(input, pos, n, @within)))
            | none() => rest.run(input, pos)
            end,
    };

-- | `p` repeated until it declines or consumes nothing, the values collected.
pub let many0(@A: Type, p: Parse(A)) -> Parse(List(A)) =
    Parse {
        run(input, pos) =
            let go(acc: List(A), cur: Nat) -> Result(Error, {Nat, List(A)}) =
                match p.run(input, cur)
                | failure(e) =>
                    match e.committed
                    | false => Result/success((cur, acc))
                    | true => Result/failure(e)
                    end
                | success((next, a)) =>
                    match next == cur
                    | true => Result/success((cur, acc))
                    | false => go([..acc, a], next)
                    end
                end;
            go([], pos),
    };

-- | `elem` separated by `sep`, zero or more times, the elements collected. A declined element after a separator gives the separator back.
pub let sep_by0(@A: Type, @S: Type, elem: Parse(A), sep: Parse(S)) -> Parse(List(A)) =
    Parse {
        run(input, pos) =
            match elem.run(input, pos)
            | failure(e) =>
                match e.committed
                | false => Result/success((pos, []))
                | true => Result/failure(e)
                end
            | success((first_end, first)) =>
                let go(acc: List(A), cur: Nat) -> Result(Error, {Nat, List(A)}) =
                    match sep.run(input, cur)
                    | failure(e) =>
                        match e.committed
                        | false => Result/success((cur, acc))
                        | true => Result/failure(e)
                        end
                    | success((sep_end, _)) =>
                        match elem.run(input, sep_end)
                        | failure(e) =>
                            match e.committed
                            | false => Result/success((cur, acc))
                            | true => Result/failure(e)
                            end
                        | success((next, x)) =>
                            match next == cur
                            | true => Result/success((cur, acc))
                            | false => go([..acc, x], next)
                            end
                        end
                    end;
                go([first], first_end)
            end,
    };

satisfy Monad(Parse) {
    pure = pure,
    bind = bind,
}
