pub use /sys/Bits/{let Bits, get, len, eql, slice};
use /std/{List, Nat, Bool, Option, Eq, Str, Equal, Show, Spell};
use /std/Test/{Draw, Seed};

pub let try_get(b: Bits, i: Nat) -> Option(Bool) =
    match i < len(b) | true => Option/some(get(b, i)) | false => Option/none() end;

pub let flatten(parts: List(Bits)) -> Bits =
    List/fold(parts, b[], (bits, acc) => b[..acc, ..bits]);

pub let fold(@A: Type, b: Bits, init: A, f: (Bool, A) -> A) -> A =
    let n = len(b);
    let go(k: Nat, i: Nat, acc: A, inv: Eq(i + k, n)) -> A =
        match k
        | 0 => acc
        -- `i < n` transported along the loop invariant: `i + (kp + 1) = n` gives `i ≤ i + kp`, whose successor is the bound `at` demands.
        | kp + 1 =>
            let below =
                Eq/subst((x) => Nat/Lt(i, x), inv, Nat/Lt/succ_of_ind(Nat/Le/Ind/add_r(i, kp)));
            go(kp, i + 1, f(get(b, i, @below), acc), inv)
        end;
    go(n, 0, init, Eq/refl());

satisfy Equal(Bits) {
    eql = eql,
    neq(a, b) = Bool/not(eql(a, b)),
}

satisfy Show(Bits) {
    show(b) =
        fold(b, "", (bit, acc) => Str/concat(acc, match bit | true => "1" | false => "0" end)),
}

satisfy Spell(Bits) {
    spell(b) =
        let parts = fold(b, [], (bit, acc) => [..acc, match bit | true => "1" | false => "0" end]);
        Str/concat("b[", Str/concat(Str/join(", ", parts), "]")),
}

let bits(seed: Seed, count: Nat) -> {Bits, Seed} =
    match count
    | 0 => (b[], seed)
    | more + 1; (acc, after) =>
        let (bit, rest) = Draw/draw(@Bool, after, 0);
        (b[..acc, bit], rest)
    end;

satisfy Draw(Bits) {
    draw(seed, size) =
        let (count, after) = Draw/draw(@Nat, seed, size);
        bits(after, count),
}
