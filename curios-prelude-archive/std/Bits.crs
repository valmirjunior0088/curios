pub use /sys/Bits/{let Bits, get, len, eql, slice, replicate, and, or, xor, to_bytes};
use /std/{List, Nat, Bool, Option, Eq, Str, Show, Spell, Ordering, Ord};
use /std/ops/{Eql, Cmp};

--- The bit at `i`, or `none` past the end.
pub let try_get(b: Bits, i: Nat) -> Option(Bool) =
    match i < len(b) | true => Option/some(get(b, i)) | false => Option/none() end;

--- Everything from `k` on, under the evidence that `k` is within the length.
pub let drop(b: Bits, k: Nat, @ok: Nat/Le(k, len(b))) -> Bits =
    slice(
        b,
        k,
        len(b) - k,
        @Eq/subst(
            (x) => Nat/Le(x, len(b)),
            Eq/sym(Nat/Le/add_sub_cancel(k, len(b), ok)),
            Nat/Le/refl(len(b))));

--- Every bit flipped.
---
--- An `xor` against a run of ones as long as this one, which is what makes the width a fact about the operand rather than a number written here. `Bits/len` reduces a fill to its own count, so the equal-length bound the `xor` states discharges without a guard.
pub let not(b: Bits) -> Bits =
    xor(b, replicate(len(b), true));

--- `b` moved `count` places toward the high end, zeros entering at the low end and whatever passes the top discarded.
---
--- Under the carrier's reading — least significant first — that is multiplication by two to the `count`, at the run's own width. A count past the length answers all zeros rather than a shorter run: the width belongs to the value, and moving its bits does not change it.
pub let shl(b: Bits, count: Nat) -> Bits =
    match Nat/le(count, len(b))
    | true => b[..replicate(count, false), ..slice(b, 0, len(b) - count)]
    | false => replicate(len(b), false)
    end;

--- `b` moved `count` places toward the low end, zeros entering at the high end — division by two to the `count`, at the same width.
pub let shr(b: Bits, count: Nat) -> Bits =
    match Nat/le(count, len(b))
    | true => b[..drop(b, count), ..replicate(count, false)]
    | false => replicate(len(b), false)
    end;

--- `b` rotated `count` places toward the high end, what passes the top re-entering at the bottom.
---
--- The count is taken modulo the width, which is what makes this total without a guard on the count itself; the empty run is the one case with no width to take it modulo, and rotating it is the identity.
pub let rotl(b: Bits, count: Nat) -> Bits =
    match Nat/lt(0, len(b))
    | true =>
        let keep = len(b) - Nat/rem(count, len(b));
        b[..drop(b, keep), ..slice(b, 0, keep)]
    | false => b
    end;

--- `b` rotated `count` places toward the low end.
pub let rotr(b: Bits, count: Nat) -> Bits =
    match Nat/lt(0, len(b))
    | true =>
        let places = Nat/rem(count, len(b));
        b[..drop(b, places), ..slice(b, 0, places)]
    | false => b
    end;

--- The concatenation, in order.
pub let flatten(parts: List(Bits)) -> Bits =
    List/fold(parts, b[], (bits, acc) => b[..acc, ..bits]);

--- Left to right with `f(bit, acc)`.
pub let fold(@A: Type, b: Bits, init: A, f: (Bool, A) -> A) -> A =
    let n = len(b);
    let go(k: Nat, i: Nat, acc: A, inv: Eq(i + k, n)) -> A =
        match k
        | 0 => acc
        | kp + 1 =>
            let below = Eq/subst((x) => Nat/Lt(i, x), inv, Bool/True/qed());
            go(kp, i + 1, f(get(b, i, @below), acc), inv)
        end;
    go(n, 0, init, Eq/refl());

-- The two halves of a cons, as total functions so congruence can take one apart.
--
-- Guarded rather than bounded, for the reason `/std/Bytes`'s own `head` and `tail` are: congruence needs one function of the whole value, and a bound stated over an arbitrary run has nothing to discharge it. On a cons the guard reduces, which is the only shape either is used at.
let head_of(x: Bits) -> Bool =
    match x | b[] => false | b[h, .._] => h end;

let tail_of(x: Bits) -> Bits =
    match x | b[] => b[] | b[_, ..t] => t end;

--- Whether `b` has a bit at all.
pub let nonempty(b: Bits) -> Bool =
    match b | b[] => false | b[_, .._] => true end;

--- A cons is injective in its head.
---
--- Read through a total projection of the whole value, which is what lets the equation be taken apart without a bound: the motive names `head_of` of each side, and `refl` collapses it.
pub let cons_inj_head(
    @h1: Bool,
    @t1: Bits,
    @h2: Bool,
    @t2: Bits,
    p: Eq(b[h1, ..t1], b[h2, ..t2]),
) -> Eq(h1, h2) =
    match p: (s, t, _) => Eq(head_of(s), head_of(t)) | refl(@_) => Eq/refl() end;

--- A cons is injective in its tail.
pub let cons_inj_tail(
    @h1: Bool,
    @t1: Bits,
    @h2: Bool,
    @t2: Bits,
    p: Eq(b[h1, ..t1], b[h2, ..t2]),
) -> Eq(t1, t2) =
    match p: (s, t, _) => Eq(tail_of(s), tail_of(t)) | refl(@_) => Eq/refl() end;

--- Congruence for a run extended by a head and a tail, which is the rebuild the two injections above take apart.
pub let cong_cons2(
    @h1: Bool,
    @h2: Bool,
    ph: Eq(h1, h2),
    @t1: Bits,
    @t2: Bits,
    pt: Eq(t1, t2),
) -> Eq(b[h1, ..t1], b[h2, ..t2]) =
    match ph
    | refl(@_) => match pt | refl(@_) => Eq/refl() end
    end;

--- The index of the first bit `pred` accepts, or `none`.
pub let find_index(b: Bits, pred: (Bool) -> Bool) -> Option(Nat) =
    let (_, found): {Nat, Option(Nat)} =
        fold(
            b,
            (0, Option/none()),
            (bit, (i, found)) =>
                match found
                | some(_) => (i, found)
                | none() =>
                    (i + 1, match pred(bit) | true => Option/some(i) | false => Option/none() end)
                end);
    found;

--- The index of the first bit equal to `x`, or `none`.
pub let index_of(b: Bits, x: Bool) -> Option(Nat) =
    find_index(b, (y) => y == x);

--- Whether `x` occurs in `b`.
pub let contains(b: Bits, x: Bool) -> Bool =
    Option/is_some(index_of(b, x));

--- `parts` with `sep` between each pair.
pub let join(sep: Bits, parts: List(Bits)) -> Bits =
    List/balanced(
        List/len(parts),
        b[],
        (i) => Option/unwrap_or(List/try_get(parts, i), b[]),
        (l, r) => b[..l, ..sep, ..r]);

--- Bitwise from index zero, a proper prefix first.
pub let cmp(a: Bits, b: Bits) -> Ordering =
    let go(i: Nat) -> Ordering =
        match i < len(a)
        | false => match i < len(b) | true => Ordering/lt() | false => Ordering/eq() end
        | true =>
            match i < len(b)
            | false => Ordering/gt()
            | true =>
                let r = Bool/cmp(get(a, i), get(b, i));
                match r | eq() => go(i + 1) | _ => r end
            end
        end;
    go(0);

satisfy Eql(Bits) {
    eql = eql,
    neq(a, b) = Bool/not(eql(a, b)),
}

satisfy Cmp(Bits) {
    lt(a, b) = Ordering/is_lt(cmp(a, b)),
    le(a, b) = Ordering/is_le(cmp(a, b)),
    gt(a, b) = Ordering/is_gt(cmp(a, b)),
    ge(a, b) = Ordering/is_ge(cmp(a, b)),
}

satisfy Ord(Bits) {
    ord = cmp,
}

satisfy Show(Bits) {
    show(b) =
        fold(b, "", (bit, acc) => Str/concat(acc, match bit | true => "1" | false => "0" end)),
}

satisfy Spell(Bits) {
    spell(b) =
        let parts = fold(b, [], (bit, acc) => [..acc, match bit | true => "1" | false => "0" end]);
        Str/concat("b[", Str/concat(Str/join(", ", parts), "]")),
}
