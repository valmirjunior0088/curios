use /std/{Bytes, Byte, Nat, Option, Result, Io, Async};

-- | One read's answer: bytes, the end of the stream, or a failure.
pub induct Chunk: pub Type
| chunk(Bytes)
| eof()
| error(Io/Error)
end

-- | A read row's status and bytes as a chunk; a `would_block` status is a failure here.
pub let of_status(status: Nat, bytes: Bytes) -> Chunk =
    match Io/Error/of(status)
    | some(e) => Chunk/error(e)
    | none() =>
        match status == /sys/status/eof | true => Chunk/eof() | false => Chunk/chunk(bytes) end
    end;

-- | What a stream is read through: up to `n` bytes, parking the fiber until some arrive.
pub concept Read(S: Type): pub Type {
    read(S, Nat) -> Async(Chunk),
}

-- | What a stream is written through: the whole of the bytes, a short write resent.
pub concept Write(S: Type): pub Type {
    write(S, Bytes) -> Async(Result(Io/Error, {})),
}

-- | Everything up to the end of the stream; a failure before the end drops what was read.
pub let read_all(@S: Type, use Read(S), s: S) -> Async(Result(Io/Error, Bytes)) =
    Async/drain((n) => Read/read(s, n));

-- | The bytes before the first `delimiter`, which is consumed and dropped, or everything read when the stream ends first.
pub let read_until(@S: Type, use Read(S), s: S, delimiter: Byte) -> Async(Result(Io/Error, Bytes)) =
    let go(acc: Bytes) -> Async(Result(Io/Error, Bytes)) =
        let c = Read/read(s, 1)!;
        match c
        | chunk(b) =>
            match Option/unwrap_or(Bytes/try_get(b, 0), delimiter) == delimiter
            | true => Async/pure(Result/success(acc))
            | false => go(x[..acc, ..b])
            end
        | eof() => Async/pure(Result/success(acc))
        | error(e) => Async/pure(Result/failure(e))
        end;
    go(x[]);

-- | Every chunk of `from` written to `to` until `from` ends; the first failure on either side is the answer.
pub let copy(
    @S: Type,
    @T: Type,
    use Read(S),
    use Write(T),
    from: S,
    to: T,
) -> Async(Result(Io/Error, {})) =
    let go() -> Async(Result(Io/Error, {})) =
        let c = Read/read(from, 4096)!;
        match c
        | chunk(b) =>
            let w = Write/write(to, b)!;
            match w | success(_) => go() | failure(e) => Async/pure(Result/failure(e)) end
        | eof() => Async/pure(Result/success(()))
        | error(e) => Async/pure(Result/failure(e))
        end;
    go();
