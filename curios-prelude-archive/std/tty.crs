use /std/{Nat, Bool, Str, Try, Async, Io, Equal, Show};

-- | The terminal's size in cells.
pub struct Size: pub Type {
    cols: Nat,
    rows: Nat,
}

satisfy Equal(Size);

satisfy Show(Size) {
    show(s) = Str/flatten([Nat/to_str(s.cols), "x", Nat/to_str(s.rows)]),
}

-- | Raw mode on or off.
pub let raw(on: Bool) -> Try(Io, Io/Error, {}) =
    let status = /sys/tty/raw(/sys/Handle/stdin, on)!;
    match Io/Error/of(status) | some(e) => Try/raise(e) | none() => Try/pure(()) end;

-- | The terminal's size now.
pub let size: Try(Io, Io/Error, Size) =
    let r = /sys/tty/size(/sys/Handle/stdin)!;
    match Io/Error/of(r.status)
    | some(e) => Try/raise(e)
    | none() => Try/pure(Size { cols = r.cols, rows = r.rows })
    end;

let restore: Io({}) =
    Io/bind(/sys/tty/raw(/sys/Handle/stdin, false), (_) => Io/pure(()));

-- | Raw mode around `body`, restored whichever way the body ends.
pub let with_raw(@A: Type, body: Try(Io, Io/Error, A)) -> Try(Io, Io/Error, A) =
    let _ = raw(true)!;
    let a =
        Try/rescue(
            body,
            (e) =>
                let _ = restore!;
                Try/raise(e))!;
    let _ = restore!;
    Try/pure(a);

-- | The same bracket inside a fiber, registered with the scheduler, so a cancelled task restores the mode.
pub let with_raw_async(@A: Type, body: Try(Async, Io/Error, A)) -> Try(Async, Io/Error, A) =
    let _ = raw(true)!;
    let outcome = Async/using(restore, Try/run(body))!;
    let a = outcome!;
    Try/pure(a);
