-- The terminal rows, wrapped: raw mode and the window size, and the bracket a terminal session is written over. `raw` and `size` are one `ioctl` each, and a program with no terminal learns it as `other(ENOTTY)`. The rows themselves are `/sys/tty`, which only the prelude may name, so this module is the whole of what a program reaches; the alternate screen, the cursor and the keyboard protocol are escape sequences a terminal library writes inside the bracket, not rows.
use /std/{Nat, Bool, Str, Handle, Result, Async, Io, Equal, Show};

pub struct Size: pub Type {
    cols: Nat,
    rows: Nat,
}

satisfy Equal(Size);

satisfy Show(Size) {
    show(s) = Str/flatten([Nat/to_str(s.cols), "x", Nat/to_str(s.rows)]),
}

pub let raw(h: Handle, on: Bool) -> Async(Result({}, Handle/Error)) =
    let status = /sys/tty/raw(h, on)!;
    Async/pure(
        match Handle/error_of(status)
        | some(e) => Result/failure(e)
        | none() => Result/success(())
        end);

pub let size(h: Handle) -> Async(Result(Size, Handle/Error)) =
    let r = /sys/tty/size(h)!;
    Async/pure(
        match Handle/error_of(r.status)
        | some(e) => Result/failure(e)
        | none() => Result/success(Size { cols = r.cols, rows = r.rows })
        end);

-- Raw mode around `body`, restored by `Async/using` on both scheduler exits — a cancelled task included — and by the native host underneath on a trap or an `exit`. The restoring switch's own status is dropped: there is nothing left to report it to.
pub let with_raw(@A: Type, h: Handle, body: Async(A)) -> Async(Result(A, Handle/Error)) =
    let on = raw(h, true)!;
    match on
    | failure(e) => Async/pure(Result/failure(e))
    | success(_) =>
        let restore = Io/bind(/sys/tty/raw(h, false), (_) => Io/pure(()));
        let a = Async/using(h, restore, body)!;
        Async/pure(Result/success(a))
    end;
