use /std/{Bytes, Byte, Nat, Int, Bool, Str, List, Option, Result, Cell, Monad, Lift, Io, Handle};
use /std/time/{Duration};
use /std/Handle/{Interest, Readiness};

--- A value fulfilled once, which a fiber parks on until it is. What `await` waits on, and what a primitive of its own hands out.
pub mod Future;
pub use Future/{let Future};

--- A flag one fiber raises and another parks on: the one park a program takes that waits on no handle and no timer.
pub mod Signal;
pub use Signal/{let Signal};

--- What a selection is written against: a non-committing attempt at a value and what to wait on while it declines.
pub mod Offer;
pub use Offer/{let Offer};

--- A bounded queue two fibers hand values through.
pub mod Channel;
pub use Channel/{let Channel};

struct Token: Type {
    Cell({}),
}

let cancel_token(t: Token) -> Io({}) =
    let _ = Cell/fill(t.0, ())!;
    Io/pure(());

let is_cancelled(t: Token) -> Io(Bool) =
    let held = Cell/poll(t.0)!;
    Io/pure(Option/is_some(held));

struct Guard: Type {
    done: Cell({}),
    release: Io({}),
}

--- One condition a parked fiber waits for. Readiness is observed again whenever the scheduler becomes idle.
induct Waiting: Type
| handle(Handle, Interest)
| timer(Duration)
| probe(Io(Bool))
end

pub let Wait: Type =
    Waiting;

pub mod Wait
    pub use /std/Async/Channel/{readable, writable};
    use /std/{Cell, Option, Io, Handle};
    use /std/Handle/{Interest};
    use /std/time/{Duration};
    use /std/Async/{Wait, Waiting};

    --- Until the handle is ready for the requested interest.
    pub let ready(handle: Handle, interest: Interest) -> Wait =
        Waiting/handle(handle, interest);

    --- Until this much time has passed after parking.
    pub let elapsed(duration: Duration) -> Wait =
        Waiting/timer(duration);

    --- Until the write-once cell is filled.
    pub let filled(@A: Type, cell: Cell(A)) -> Wait =
        Waiting/probe(Io/bind(Cell/poll(cell), (held) => Io/pure(Option/is_some(held))));
end

induct Pause: Type
| park(waits: List(Wait))
| fork(child: Io(Step({})), token: Token)
| acquire(Guard)
| yield_now()
and Step(A: Type): Type
| done(A)
| step(pause: Pause, next: Io(Step(A)))
end

--- A fiber: a computation that may park and resume.
pub struct Async(A: Type): Type {
    Io(Step(A)),
}

--- A fiber that answers nothing.
pub let Fiber: Type =
    Async({});

--- `a`, with no suspension.
pub let pure(@A: Type, a: A) -> Async(A) =
    Async { Io/pure(Step/done(a)) };

let bind_raw(@A: Type, @B: Type, m: Io(Step(A)), f: (A) -> Io(Step(B))) -> Io(Step(B)) =
    let s = m!;
    match s | done(a) => f(a) | step(p, k) => Io/pure(Step/step(p, bind_raw(k, f))) end;

--- `m`, then `f` on its answer.
pub let bind(@A: Type, @B: Type, m: Async(A), f: (A) -> Async(B)) -> Async(B) =
    Async { bind_raw(m.0, (a) => f(a).0) };

--- `f` on the answer.
pub let map(@A: Type, @B: Type, m: Async(A), f: (A) -> B) -> Async(B) =
    bind(m, (a) => pure(f(a)));

--- An `Io` action as one step that never parks.
pub let lift(@A: Type, action: Io(A)) -> Async(A) =
    Async { Io/bind(action, (a) => Io/pure(Step/done(a))) };

let suspend(p: Pause) -> Async({}) =
    Async { Io/pure(Step/step(p, Io/pure(Step/done(())))) };

--- Park until one of `waits` fires, whichever is first.
---
--- Readiness is advisory: an operation retried after a park may still answer `would_block`, so a caller parks in a loop rather than assuming the wait was truthful.
pub let park(waits: List(Wait)) -> Async({}) =
    suspend(Pause/park(waits));

--- Park for `d`.
pub let sleep(d: Duration) -> Async({}) =
    park([Wait/elapsed(d)]);

--- Park once, letting every other runnable fiber take a turn.
pub let yield_now: Async({}) =
    suspend(Pause/yield_now());

let acquire(g: Guard) -> Async({}) =
    suspend(Pause/acquire(g));

let fork_with(child: Fiber, t: Token) -> Async({}) =
    suspend(Pause/fork(child.0, t));

--- `body` with `fin` run when it is over: on the way out, or by the scheduler when the task is cancelled, dropped at the root's end, or found parked at a deadlock. Both exits, exactly once.
pub let using(@A: Type, fin: Io({}), body: Async(A)) -> Async(A) =
    let done = Cell/new()!;
    let g = Guard { done = done, release = fin };
    let _ = acquire(g)!;
    let a = body!;
    let _ = run_guard(g)!;
    pure(a);

--- Fork `body` as a fiber of its own, which runs before the forker takes another step.
pub let go(body: Fiber) -> Async({}) =
    let c = Cell/new()!;
    fork_with(body, Token { c });

--- Everything `read` yields up to the end of the stream; a failure before the end drops what was read.
pub let drain(
    @M: (Type) -> Type,
    use Monad(M),
    read: (Nat) -> M(Io/Chunk),
) -> M(Result(Io/Error, Bytes)) =
    let go(acc: Bytes) -> M(Result(Io/Error, Bytes)) =
        let r = read(4096)!;
        match r
        | chunk(bytes) => go(x[..acc, ..bytes])
        | eof() => Monad/pure(Result/success(acc))
        | error(e) => Monad/pure(Result/failure(e))
        end;
    go(x[]);

--- What a stream is read through, in the monad the region is written in: `Async` parks the fiber until bytes arrive, `Io` waits on this program's own behalf.
---
--- A carrier whose progress a peer decides declares only the `Async` witness, so reading it in an `Io` region is refused where it is written.
pub concept Read(M: (Type) -> Type, S: Type): pub Type {
    read(S, Nat) -> M(Io/Chunk),
}

--- What a stream is written through: the whole of the bytes, a short write resent.
pub concept Write(M: (Type) -> Type, S: Type): pub Type {
    write(S, Bytes) -> M(Result(Io/Error, {})),
}

--- Everything up to the end of the stream; a failure before the end drops what was read.
pub let read_all(
    @M: (Type) -> Type,
    @S: Type,
    use Monad(M),
    use Read(M, S),
    s: S,
) -> M(Result(Io/Error, Bytes)) =
    drain((n) => Read/read(s, n));

--- The bytes before the first `delimiter`, which is consumed and dropped, or everything read when the stream ends first.
pub let read_until(
    @M: (Type) -> Type,
    @S: Type,
    use Monad(M),
    use Read(M, S),
    s: S,
    delimiter: Byte,
) -> M(Result(Io/Error, Bytes)) =
    let go(acc: Bytes) -> M(Result(Io/Error, Bytes)) =
        let c = Read/read(s, 1)!;
        match c
        | chunk(b) =>
            match Option/unwrap_or(Bytes/try_get(b, 0), delimiter) == delimiter
            | true => Monad/pure(Result/success(acc))
            | false => go(x[..acc, ..b])
            end
        | eof() => Monad/pure(Result/success(acc))
        | error(e) => Monad/pure(Result/failure(e))
        end;
    go(x[]);

--- One line without its line ending — a newline, or a carriage return and a newline — or `none` when the stream ends with nothing read; what is read before the end is the last line, and a failure drops what was read.
pub let read_line(
    @M: (Type) -> Type,
    @S: Type,
    use Monad(M),
    use Read(M, S),
    s: S,
) -> M(Result(Io/Error, Option(Bytes))) =
    let newline: Byte = '\n';
    let carriage: Byte = '\r';
    -- A carriage return is held back until the next byte says whether it ends the line.
    let held(acc: Bytes, cr: Bool) -> Bytes =
        match cr | true => x[..acc, carriage] | false => acc end;
    let go(acc: Bytes, cr: Bool) -> M(Result(Io/Error, Option(Bytes))) =
        let c = Read/read(s, 1)!;
        match c
        | chunk(b) =>
            let byte = Option/unwrap_or(Bytes/try_get(b, 0), newline);
            choose
            | byte == newline => Monad/pure(Result/success(Option/some(acc)))
            | byte == carriage => go(held(acc, cr), true)
            | _ => go(x[..held(acc, cr), ..b], false)
            end
        | eof() =>
            Monad/pure(
                Result/success(
                    match cr || Bytes/len(acc) != 0
                    | true => Option/some(held(acc, cr))
                    | false => Option/none()
                    end))
        | error(e) => Monad/pure(Result/failure(e))
        end;
    go(x[], false);

--- Every chunk of `from` written to `to` until `from` ends; the first failure on either side is the answer.
pub let copy(
    @M: (Type) -> Type,
    @S: Type,
    @T: Type,
    use Monad(M),
    use Read(M, S),
    use Write(M, T),
    from: S,
    to: T,
) -> M(Result(Io/Error, {})) =
    let go() -> M(Result(Io/Error, {})) =
        let c = Read/read(from, 4096)!;
        match c
        | chunk(b) =>
            let w = Write/write(to, b)!;
            match w | success(_) => go() | failure(e) => Monad/pure(Result/failure(e)) end
        | eof() => Monad/pure(Result/success(()))
        | error(e) => Monad/pure(Result/failure(e))
        end;
    go();

--- The value `f` is fulfilled with, parking until it is.
pub let await(@A: Type, f: Future(A)) -> Async(A) =
    let polled = Future/poll(f)!;
    match polled
    | some(a) => pure(a)
    | none() =>
        let _ =
            park([
                Waiting/probe(Io/bind(Future/poll(f), (held) => Io/pure(Option/is_some(held))))])!;
        await(f)
    end;

struct Job: Type {
    resume: Fiber,
    token: Token,
    guards: List(Guard),
}

--- Every alternative of one park shares this claim cell. The job is immutable and only the first claim may enqueue it.
struct Slot: Type {
    job: Job,
    claimed: Cell({}),
}

let peek(s: Slot) -> Io(Option(Job)) =
    let held = Cell/poll(s.claimed)!;
    Io/pure(match held | some(_) => Option/none() | none() => Option/some(s.job) end);

let claim(s: Slot) -> Io(Option(Job)) =
    let taken = Cell/fill(s.claimed, ())!;
    Io/pure(match taken | true => Option/some(s.job) | false => Option/none() end);

struct Parked: Type {
    handle: Handle,
    interest: Interest,
    slot: Slot,
}

struct Sleeper: Type {
    due: Duration,
    slot: Slot,
}

let run_guard(g: Guard) -> Io({}) =
    let taken = Cell/fill(g.done, ())!;
    match taken | true => g.release | false => Io/pure(()) end;

let run_guards(gs: List(Guard)) -> Io({}) =
    match gs
    | [] => Io/pure(())
    | [g, ..more] =>
        let _ = run_guard(g)!;
        run_guards(more)
    end;

let live_guards(gs: List(Guard)) -> Io(List(Guard)) =
    match gs
    | [] => Io/pure([])
    | [g, ..more] =>
        let done = Cell/poll(g.done)!;
        let rest = live_guards(more)!;
        Io/pure(match done | some(_) => rest | none() => [g, ..rest] end)
    end;

let drain_jobs(js: List(Job)) -> Io({}) =
    match js
    | [] => Io/pure(())
    | [j, ..more] =>
        let _ = run_guards(j.guards)!;
        drain_jobs(more)
    end;

let drain_slots(ss: List(Slot)) -> Io({}) =
    match ss
    | [] => Io/pure(())
    | [s, ..more] =>
        let held = claim(s)!;
        match held
        | none() => drain_slots(more)
        | some(j) =>
            let _ = run_guards(j.guards)!;
            drain_slots(more)
        end
    end;

let sweep_parked(ss: List(Slot)) -> Io(List(Slot)) =
    match ss
    | [] => Io/pure([])
    | [s, ..more] =>
        let held = peek(s)!;
        match held
        | none() => sweep_parked(more)
        | some(j) =>
            let dead = is_cancelled(j.token)!;
            match dead
            | true =>
                let _ = run_guards(j.guards)!;
                let _ = claim(s)!;
                sweep_parked(more)
            | false =>
                let rest = sweep_parked(more)!;
                Io/pure([s, ..rest])
            end
        end
    end;

let poll_ready(blocked: List(Parked), timeout: Int) -> Io({List(Job), List(Parked)}) =
    let handles = List/map(blocked, (p: Parked) => p.handle);
    let events = List/map(blocked, (p: Parked) => p.interest);
    let results = Handle/poll(handles, events, timeout)!;
    let walk(
        rest: List(Parked),
        i: Nat,
        woken: List(Job),
        still: List(Parked),
    ) -> Io({List(Job), List(Parked)}) =
        match rest
        | [] => Io/pure((woken, still))
        | [p, ..tail] =>
            let held = peek(p.slot)!;
            match held
            | none() => walk(tail, i + 1, woken, still)
            | some(j) =>
                let dead = is_cancelled(j.token)!;
                match dead
                | true =>
                    let _ = claim(p.slot)!;
                    let _ = run_guards(j.guards)!;
                    walk(tail, i + 1, woken, still)
                | false =>
                    match Readiness/answers(
                        Option/unwrap_or(List/try_get(results, i), Readiness/nothing),
                        p.interest)
                    | true =>
                        let taken = claim(p.slot)!;
                        match taken
                        | none() => walk(tail, i + 1, woken, still)
                        | some(k) => walk(tail, i + 1, [k, ..woken], still)
                        end
                    | false => walk(tail, i + 1, woken, [p, ..still])
                    end
                end
            end
        end;
    walk(blocked, 0, [], []);

let sleep_timeout(sleeping: List(Sleeper)) -> Io(Int) =
    let earliest(rest: List(Sleeper), best: Option(Duration)) -> Option(Duration) =
        match rest
        | [] => best
        | [s, ..more] =>
            match best
            | none() => earliest(more, Option/some(s.due))
            | some(b) =>
                match Duration/before(s.due, b)
                | true => earliest(more, Option/some(s.due))
                | false => earliest(more, best)
                end
            end
        end;
    match earliest(sleeping, Option/none())
    | none() => Io/pure(-1)
    | some(due) =>
        let now = Duration/now()!;
        let remaining = Duration/sub(due, now);
        let whole = Duration/to_millis(remaining);
        Io/pure(
            match Duration/nanos(remaining) % 1000000 > 0
            | true => Nat/to_int(whole + 1)
            | false => Nat/to_int(whole)
            end)
    end;

let expire_sleepers(sleeping: List(Sleeper)) -> Io({List(Job), List(Sleeper)}) =
    let now = Duration/now()!;
    let walk(
        rest: List(Sleeper),
        woken: List(Job),
        still: List(Sleeper),
    ) -> Io({List(Job), List(Sleeper)}) =
        match rest
        | [] => Io/pure((woken, still))
        | [s, ..tail] =>
            let held = peek(s.slot)!;
            match held
            | none() => walk(tail, woken, still)
            | some(j) =>
                let dead = is_cancelled(j.token)!;
                match dead
                | true =>
                    let _ = claim(s.slot)!;
                    let _ = run_guards(j.guards)!;
                    walk(tail, woken, still)
                | false =>
                    match Duration/before(now, s.due)
                    | true => walk(tail, woken, [s, ..still])
                    | false =>
                        let taken = claim(s.slot)!;
                        match taken
                        | none() => walk(tail, woken, still)
                        | some(k) => walk(tail, [k, ..woken], still)
                        end
                    end
                end
            end
        end;
    walk(sleeping, [], []);

--- No runnable fiber, nothing blocked on a handle, and no sleeper: the root can never be fulfilled. `parked` is how many fibers wait on a condition that cannot become ready.
pub struct Deadlock: pub Type {
    parked: Nat,
}

struct Probed: Type {
    ready: Io(Bool),
    slot: Slot,
}

struct Queues: Type {
    runq: List(Job),
    blocked: List(Parked),
    sleeping: List(Sleeper),
    waiting: List(Slot),
    probes: List(Probed),
}

let enqueue(q: Queues, j: Job) -> Queues =
    Queues { ..q, runq = [..q.runq, j] };

let register_wait(q: Queues, slot: Slot, w: Wait) -> Io(Queues) =
    match w
    | handle(h, interest) =>
        Io/pure(
            Queues {
                ..q,
                blocked = [..q.blocked, Parked { handle = h, interest = interest, slot = slot }],
            })
    | timer(d) =>
        let now = Duration/now()!;
        Io/pure(
            Queues {
                ..q,
                sleeping = [..q.sleeping, Sleeper { due = Duration/add(now, d), slot = slot }],
            })
    | probe(ready) =>
        Io/pure(Queues { ..q, probes = [..q.probes, Probed { ready = ready, slot = slot }] })
    end;

let register_waits(q: Queues, slot: Slot, ws: List(Wait)) -> Io(Queues) =
    match ws
    | [] => Io/pure(q)
    | [w, ..more] =>
        let updated = register_wait(q, slot, w)!;
        register_waits(updated, slot, more)
    end;

let park_job(q: Queues, job: Job, ws: List(Wait)) -> Io(Queues) =
    let claimed = Cell/new()!;
    let slot = Slot { job = job, claimed = claimed };
    register_waits(Queues { ..q, waiting = [slot, ..q.waiting] }, slot, ws);

let serve(q: Queues, job: Job) -> Io(Queues) =
    let dead = is_cancelled(job.token)!;
    match dead
    | true =>
        let _ = run_guards(job.guards)!;
        Io/pure(q)
    | false =>
        let state = job.resume.0!;
        match state
        | done(_) =>
            let _ = run_guards(job.guards)!;
            Io/pure(q)
        | step(pause, next) => resume_after(q, job, pause, next)
        end
    end
and resume_after(q: Queues, job: Job, pause: Pause, next: Io(Step({}))) -> Io(Queues) =
    let resumed = Job { ..job, resume = Async { next } };
    match pause
    | park(ws) => park_job(q, resumed, ws)
    | fork(child, child_token) =>
        Io/pure(
            enqueue(
                enqueue(q, Job { resume = Async { child }, token = child_token, guards = [] }),
                resumed))
    | acquire(g) =>
        let kept = live_guards(job.guards)!;
        serve(q, Job { ..resumed, guards = [g, ..kept] })
    | yield_now() => Io/pure(enqueue(q, resumed))
    end;

let release_everything(q: Queues) -> Io({}) =
    let _ = drain_jobs(q.runq)!;
    drain_slots(q.waiting);

let live_blocked(ps: List(Parked)) -> Io(List(Parked)) =
    match ps
    | [] => Io/pure([])
    | [p, ..more] =>
        let held = peek(p.slot)!;
        let rest = live_blocked(more)!;
        Io/pure(match held | none() => rest | some(_) => [p, ..rest] end)
    end;

let live_sleeping(ss: List(Sleeper)) -> Io(List(Sleeper)) =
    match ss
    | [] => Io/pure([])
    | [s, ..more] =>
        let held = peek(s.slot)!;
        let rest = live_sleeping(more)!;
        Io/pure(match held | none() => rest | some(_) => [s, ..rest] end)
    end;

let live_probes(ps: List(Probed)) -> Io(List(Probed)) =
    match ps
    | [] => Io/pure([])
    | [p, ..more] =>
        let held = peek(p.slot)!;
        let rest = live_probes(more)!;
        Io/pure(match held | none() => rest | some(_) => [p, ..rest] end)
    end;

--- Release cancelled jobs and forget every registration whose shared claim has been taken.
let prune(q: Queues) -> Io(Queues) =
    let waiting = sweep_parked(q.waiting)!;
    let blocked = live_blocked(q.blocked)!;
    let sleeping = live_sleeping(q.sleeping)!;
    let probes = live_probes(q.probes)!;
    Io/pure(
        Queues { ..q, blocked = blocked, sleeping = sleeping, waiting = waiting, probes = probes });

let scan_probes(q: Queues, ps: List(Probed)) -> Io(Queues) =
    match ps
    | [] => Io/pure(q)
    | [p, ..more] =>
        let held = peek(p.slot)!;
        match held
        | none() => scan_probes(q, more)
        | some(_) =>
            let ready = p.ready!;
            match ready
            | false => scan_probes(q, more)
            | true =>
                let taken = claim(p.slot)!;
                match taken
                | none() => scan_probes(q, more)
                | some(job) => scan_probes(enqueue(q, job), more)
                end
            end
        end
    end;

let wake_ready(q: Queues) -> Io(Queues) =
    let timeout = sleep_timeout(q.sleeping)!;
    let polled = poll_ready(q.blocked, timeout)!;
    let expired = expire_sleepers(q.sleeping)!;
    Io/pure(
        Queues { ..q, runq = [..polled.0, ..expired.0], blocked = polled.1, sleeping = expired.1 });

let root_job(@A: Type, root: Async(A), answer: Cell(A), token: Token) -> Job =
    Job {
        resume = bind(root, (a) => bind(lift(Cell/fill(answer, a)), (_) => pure(()))),
        token = token,
        guards = [],
    };

let drive(@A: Type, q: Queues, answer: Cell(A)) -> Io(Result(Deadlock, A)) =
    let finished = Cell/poll(answer)!;
    match finished
    | some(a) =>
        let _ = release_everything(q)!;
        Io/pure(Result/success(a))
    | none() =>
        match q.runq
        | [] =>
            let cleaned = prune(q)!;
            let scanned = scan_probes(cleaned, cleaned.probes)!;
            let ready = prune(scanned)!;
            match List/len(ready.runq) > 0
            | true => drive(ready, answer)
            | false =>
                match List/len(ready.blocked) == 0 && List/len(ready.sleeping) == 0
                | true =>
                    let _ = release_everything(ready)!;
                    Io/pure(Result/failure(Deadlock { parked = List/len(ready.waiting) }))
                | false =>
                    let woken = wake_ready(ready)!;
                    drive(woken, answer)
                end
            end
        | [job, ..rest] =>
            let updated = serve(Queues { ..q, runq = rest }, job)!;
            drive(updated, answer)
        end
    end;

--- Drive `root` to its answer, or to the deadlock that stops it.
pub let block_on(@A: Type, root: Async(A)) -> Io(Result(Deadlock, A)) =
    let answer: Cell(A) = Cell/new()!;
    let root_cancelled: Cell({}) = Cell/new()!;
    let q =
        Queues {
            runq = [root_job(root, answer, Token { root_cancelled })],
            blocked = [],
            sleeping = [],
            waiting = [],
            probes = [],
        };
    drive(q, answer);

--- Drive `main` to its end; a deadlock is reported on standard error and exits with 1.
pub let run(main: Async({})) -> Io({}) =
    let outcome = block_on(main)!;
    match outcome
    | success(_) => Io/pure(())
    | failure(d) =>
        let _ =
            /std/print_err(
                Str/flatten([
                    "async: deadlocked, no runnable work remains and ",
                    Nat/to_str(d.parked),
                    " fiber(s) wait on a condition that cannot become ready\n"]))!;
        /sys/proc/exit(1)
    end;

--- A spawned fiber: its answer, and the means to cancel it.
pub struct Task(A: Type): Type {
    result: Future(A),
    token: Token,
}

--- Fork `body` as a task whose answer `join` waits for.
pub let spawn(@A: Type, body: Async(A)) -> Async(Task(A)) =
    let f = Future/new()!;
    let c = Cell/new()!;
    let t = Token { c };
    let task = Task { result = f, token = t };
    let _ =
        fork_with(
            Async { bind_raw(body.0, (a) => bind(lift(Future/fulfill(f, a)), (_) => pure(())).0) },
            t)!;
    pure(task);

--- The task's answer, parking until it has one.
pub let join(@A: Type, task: Task(A)) -> Async(A) =
    await(task.result);

--- Ask the task to stop; its guards are released when the scheduler finds it cancelled.
pub let cancel(@A: Type, task: Task(A)) -> Io({}) =
    cancel_token(task.token);

let cancel_all(ts: List(Token)) -> Io({}) =
    match ts
    | [] => Io/pure(())
    | [t, ..more] =>
        let _ = cancel_token(t)!;
        cancel_all(more)
    end;

--- Every task's answer, in order, each spawned before the next is waited for.
pub let join_all(@A: Type, tasks: List(Async(A))) -> Async(List(A)) =
    let go(i: Nat) -> Async(List(A)) =
        match Nat/Lt/try(i, List/len(tasks))
        | none() => pure([])
        | some(ok) =>
            let h = spawn(List/get(@Async(A), tasks, i, @ok))!;
            let rest = go(i + 1)!;
            let a = join(h)!;
            pure([a, ..rest])
        end;
    go(0);

let attempt(@A: Type, offers: List(Offer(A)), i: Nat) -> Io(Option({Nat, A})) =
    match offers
    | [] => Io/pure(Option/none())
    | [o, ..more] =>
        let got = o.try!;
        match got | some(a) => Io/pure(Option/some((i, a))) | none() => attempt(more, i + 1) end
    end;

let waits_of(@A: Type, offers: List(Offer(A))) -> Io(List(Wait)) =
    match offers
    | [] => Io/pure([])
    | [o, ..more] =>
        let w = o.wait!;
        let ws = waits_of(more)!;
        Io/pure([w, ..ws])
    end;

--- The first offer to yield a value, with its index, parking on all of them while every one declines. Offers are tried in list order, so a selection is not fair, and nothing leaves a source until it is the answer, so an offer that loses has consumed nothing.
pub let select(@A: Type, offers: List(Offer(A))) -> Async({Nat, A}) =
    let taken = attempt(offers, 0)!;
    match taken
    | some(w) => pure(w)
    | none() =>
        let ws = waits_of(offers)!;
        let _ = park(ws)!;
        select(offers)
    end;

--- An offer that yields once `d` has passed.
pub let after(d: Duration) -> Io(Offer({})) =
    let start = Duration/now()!;
    let due = Duration/add(start, d);
    Io/pure(
        Offer/new(
            Io/bind(
                Duration/now(),
                (t) =>
                    Io/pure(
                        match Duration/before(t, due)
                        | true => Option/none()
                        | false => Option/some(())
                        end)),
            Io/bind(Duration/now(), (t) => Io/pure(Wait/elapsed(Duration/sub(due, t))))));

--- An offer that yields the task's answer once it has one.
pub let joined(@A: Type, task: Task(A)) -> Offer(A) =
    Offer/new(
        Future/poll(task.result),
        Io/pure(
            Waiting/probe(
                Io/bind(Future/poll(task.result), (held) => Io/pure(Option/is_some(held))))));

let spawn_all(@A: Type, tasks: List(Async(A))) -> Async(List(Task(A))) =
    match tasks
    | [] => pure([])
    | [t, ..more] =>
        let h = spawn(t)!;
        let rest = spawn_all(more)!;
        pure([h, ..rest])
    end;

--- The first of `tasks` to answer, with its index; the others are cancelled. A task abandoned part-way loses whatever it had taken and not yet answered with, which is what abandoning a running computation costs — a selection over `Offer`s takes nothing until it keeps it, and is the way to choose without paying that.
pub let first(@A: Type, tasks: List(Async(A))) -> Async({Nat, A}) =
    let running = spawn_all(tasks)!;
    let w = select(List/map(running, (t: Task(A)) => joined(t)))!;
    let _ = lift(cancel_all(List/map(running, (t: Task(A)) => t.token)))!;
    pure(w);

--- The first of `tasks` to answer; the others are cancelled.
pub let race(@A: Type, tasks: List(Async(A))) -> Async(A) =
    map(first(tasks), (w) => w.1);

--- `body`'s answer, or `none` when `d` passes first, in which case `body` is cancelled. An answer that lands after `d` is dropped, which is what a timeout means.
pub let timeout(@A: Type, d: Duration, body: Async(A)) -> Async(Option(A)) =
    let running = spawn(body)!;
    let timer = lift(after(d))!;
    let w =
        select([
            Offer/map(joined(running), (a) => Option/some(a)),
            Offer/map(timer, (_) => Option/none())])!;
    let _ = lift(cancel(running))!;
    pure(w.1);

satisfy Monad(Async) {
    pure = pure,
    bind = bind,
}

satisfy Lift(Io, Async) {
    lift = lift,
}

satisfy Lift(Async, Async) {
    lift(@_, m) = m,
}
