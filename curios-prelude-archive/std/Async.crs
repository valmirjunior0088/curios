use /std/{Handle, Bytes, Nat, Int, Bool, List, Option, Result, Cell, Monad, Lift, Io};
use /std/time/{Duration};

-- Both are scheduler plumbing: their operations exist so this module and its descendants can drive a fiber, not so a program can complete someone else's future. The modules stay private and only the two type names are re-exported, which leaves `Future/fulfill` and friends reachable within `/std/Async` alone.
mod Waker;
pub use Waker/{let Waker};

mod Future;
pub use Future/{let Future};

struct Token: Type {
    Cell(Bool),
}

let cancel_token(t: Token) -> Io({}) =
    Cell/set(t.0, true);

let is_cancelled(t: Token) -> Io(Bool) =
    Cell/get(t.0);

struct Guard: Type {
    handle: Handle,
    release: Io({}),
}

-- `Step` is the suspension, and it recurses through `Io` because computing what comes next is itself a host effect — reading a socket to decide whether to yield. That is the whole of what `Pause/defer` used to spell with a `() -> Async(A)` thunk: delay, hand-rolled, with no type behind it.
--
-- A struct cannot join an `induct … and …` group, so `fork` names the raw continuation rather than `Fiber`. `Pause` is private, so nothing about that reaches a consumer.
induct Pause: Type
| wait(handle: Handle, interest: Nat)
| sleep(Duration)
| fork(child: Io(Step({})), token: Token)
| park((Waker) -> Io({}))
| acquire(handle: Handle, release: Io({}))
| release(Handle)
| yield_now()
and Step(A: Type): Type
| done(A)
| step(pause: Pause, next: Io(Step(A)))
end

-- Nominal, not a transparent alias for `Io(Step(A))`: a witness is keyed by the rigid head of its concept's parameters, and an alias would reduce to `Io`'s head and collide with `Monad(Io)`. The newtype is what lets `Async` own its own key, and so its own `!`.
--
-- Its representation stays private, which keeps `Step` out of the public interface entirely.
pub struct Async(A: Type): Type {
    Io(Step(A)),
}

pub let Fiber: Type =
    Async({});

pub let pure(@A: Type, a: A) -> Async(A) =
    Async { Io/pure(Step/done(a)) };

rec bind_raw(@A: Type, @B: Type, m: Io(Step(A)), f: (A) -> Io(Step(B))) -> Io(Step(B)) =
    let s = m!;
    match s | done(a) => f(a) | step(p, k) => Io/pure(Step/step(p, bind_raw(k, f))) end;

pub let bind(@A: Type, @B: Type, m: Async(A), f: (A) -> Async(B)) -> Async(B) =
    Async { bind_raw(m.0, (a) => f(a).0) };

pub let map(@A: Type, @B: Type, m: Async(A), f: (A) -> B) -> Async(B) =
    bind(m, (a) => pure(f(a)));

-- The seam between the two monads: an `Io` action as one non-suspending step. Every host operation a fiber performs arrives through here.
--
-- Built with an explicit `Io/bind` rather than `!`: a struct literal's field is not its own region, so a `!` here would hoist into this body — which is `Async`-typed — and ask for `Monad(Io)` where `Monad(Async)` is wanted.
pub let lift(@A: Type, action: Io(A)) -> Async(A) =
    Async { Io/bind(action, (a) => Io/pure(Step/done(a))) };

let suspend(p: Pause) -> Async({}) =
    Async { Io/pure(Step/step(p, Io/pure(Step/done(())))) };

pub let wait(h: Handle, ev: Nat) -> Async({}) =
    suspend(Pause/wait(h, ev));

pub let sleep(d: Duration) -> Async({}) =
    suspend(Pause/sleep(d));

pub let park(register: (Waker) -> Io({})) -> Async({}) =
    suspend(Pause/park(register));

pub let yield_now: Async({}) =
    suspend(Pause/yield_now());

pub let acquire(h: Handle, fin: Io({})) -> Async({}) =
    suspend(Pause/acquire(h, fin));

pub let release(h: Handle) -> Async({}) =
    suspend(Pause/release(h));

let fork_with(child: Fiber, t: Token) -> Async({}) =
    suspend(Pause/fork(child.0, t));

pub let using(@A: Type, h: Handle, fin: Io({}), body: Async(A)) -> Async(A) =
    let _ = acquire(h, fin)!;
    let a = body!;
    let _ = release(h)!;
    pure(a);

pub let go(body: Fiber) -> Async({}) =
    let c = Cell/new(false)!;
    fork_with(body, Token { c });

-- Failing to clear O_NONBLOCK is not cosmetic: the handle stays blocking and the next read stalls the whole single-threaded scheduler, so the status is reported rather than dropped.
pub let nonblocking(h: Handle) -> Io(Result({}, Handle/Error)) =
    let status = /sys/socket/set_nonblocking(h, true)!;
    Io/pure(
        match status == /sys/status/ok
        | true => Result/success(())
        | false => Result/failure(Handle/error_of(status))
        end);

pub let read(h: Handle, n: Nat) -> Async(Handle/Read) =
    let nb = nonblocking(h)!;
    match nb
    | failure(e) => pure(Handle/Read/error(e))
    | success(_) =>
        rec go() -> Async(Handle/Read) =
            let r = /sys/Handle/read(h, n)!;
            choose
            | r.status == /sys/status/would_block =>
                let _ = wait(h, /sys/poll/read)!;
                go()
            | r.status == /sys/status/eof => pure(Handle/Read/eof())
            | r.status == /sys/status/ok => pure(Handle/Read/chunk(r.bytes))
            | _ => pure(Handle/Read/error(Handle/error_of(r.status)))
            end;
        go()
    end;

pub let write(h: Handle, b: Bytes) -> Async(Result({}, Handle/Error)) =
    let nb = nonblocking(h)!;
    match nb
    | failure(e) => pure(Result/failure(e))
    | success(_) =>
        rec go(rest: Bytes) -> Async(Result({}, Handle/Error)) =
            let r = /sys/Handle/write(h, rest)!;
            choose
            | r.status == /sys/status/would_block =>
                let _ = wait(h, /sys/poll/write)!;
                go(rest)
            | r.status != /sys/status/ok => pure(Result/failure(Handle/error_of(r.status)))
            | r.written < Bytes/len(rest) =>
                let _ = wait(h, /sys/poll/write)!;
                go(Bytes/slice(rest, r.written, Bytes/len(rest)))
            | _ => pure(Result/success(()))
            end;
        go(b)
    end;

pub let accept(l: Handle) -> Async(Result(Handle, Handle/Error)) =
    let nb = nonblocking(l)!;
    match nb
    | failure(e) => pure(Result/failure(e))
    | success(_) =>
        rec go() -> Async(Result(Handle, Handle/Error)) =
            let r = /sys/socket/accept(l)!;
            choose
            | r.status == /sys/status/would_block =>
                let _ = wait(l, /sys/poll/read)!;
                go()
            | r.status == /sys/status/ok => pure(Result/success(r.handle))
            | _ => pure(Result/failure(Handle/error_of(r.status)))
            end;
        go()
    end;

-- `eof` is the stream's orderly terminator; an `error` means it ended without one, so the accumulated prefix is not the content and is dropped rather than passed off as complete.
pub let drain(read: (Nat) -> Async(Handle/Read)) -> Async(Result(Bytes, Handle/Error)) =
    rec go(acc: Bytes) -> Async(Result(Bytes, Handle/Error)) =
        let r = read(4096)!;
        match r
        | chunk(bytes) => go(x[..acc, ..bytes])
        | eof() => pure(Result/success(acc))
        | error(e) => pure(Result/failure(e))
        end;
    go(x[]);

pub rec await(@A: Type, f: Future(A)) -> Async(A) =
    let polled = Future/poll(f)!;
    match polled
    | some(a) => pure(a)
    | none() =>
        let _ = park((w) => Future/register(f, w))!;
        await(f)
    end;

struct Job: Type {
    resume: Fiber,
    token: Token,
    guards: List(Guard),
}

let Slot: Type =
    Cell(Option(Job));

struct Parked: Type {
    handle: Handle,
    interest: Nat,
    resume: Fiber,
    token: Token,
    guards: List(Guard),
}

struct Sleeper: Type {
    due: Duration,
    resume: Fiber,
    token: Token,
    guards: List(Guard),
}

rec run_guards(gs: List(Guard)) -> Io({}) =
    match gs
    | [] => Io/pure(())
    | [g, ..more] =>
        let _ = g.release!;
        run_guards(more)
    end;

rec release_guard(h: Handle, gs: List(Guard)) -> Io(List(Guard)) =
    match gs
    | [] => Io/pure([])
    | [g, ..more] =>
        match /sys/Handle/eql(g.handle, h)
        | true =>
            let _ = g.release!;
            Io/pure(more)
        | false =>
            let rest = release_guard(h, more)!;
            Io/pure([g, ..rest])
        end
    end;

rec drain_jobs(js: List(Job)) -> Io({}) =
    match js
    | [] => Io/pure(())
    | [j, ..more] =>
        let _ = run_guards(j.guards)!;
        drain_jobs(more)
    end;

rec drain_parked(ps: List(Parked)) -> Io({}) =
    match ps
    | [] => Io/pure(())
    | [p, ..more] =>
        let _ = run_guards(p.guards)!;
        drain_parked(more)
    end;

rec drain_sleeping(ss: List(Sleeper)) -> Io({}) =
    match ss
    | [] => Io/pure(())
    | [s, ..more] =>
        let _ = run_guards(s.guards)!;
        drain_sleeping(more)
    end;

rec drain_slots(ss: List(Slot)) -> Io({}) =
    match ss
    | [] => Io/pure(())
    | [s, ..more] =>
        let held = Cell/get(s)!;
        match held
        | none() => drain_slots(more)
        | some(j) =>
            let _ = run_guards(j.guards)!;
            drain_slots(more)
        end
    end;

rec sweep_parked(ss: List(Slot)) -> Io(List(Slot)) =
    match ss
    | [] => Io/pure([])
    | [s, ..more] =>
        let held = Cell/get(s)!;
        match held
        | none() => sweep_parked(more)
        | some(j) =>
            let dead = is_cancelled(j.token)!;
            match dead
            | true =>
                let _ = run_guards(j.guards)!;
                let _ = Cell/set(s, Option/none())!;
                sweep_parked(more)
            | false =>
                let rest = sweep_parked(more)!;
                Io/pure([s, ..rest])
            end
        end
    end;

let is_ready(results: Nat, interest: Nat) -> Bool =
    Nat/and(results, Nat/or(Nat/or(interest, /sys/poll/err), /sys/poll/hup)) > 0;

let poll_ready(blocked: List(Parked), timeout: Int) -> Io({List(Job), List(Parked)}) =
    let handles = List/map(blocked, (p: Parked) => p.handle);
    let events = List/map(blocked, (p: Parked) => p.interest);
    let results = /sys/Handle/poll(handles, events, timeout)!;
    rec walk(
        rest: List(Parked),
        i: Nat,
        woken: List(Job),
        still: List(Parked),
    ) -> Io({List(Job), List(Parked)}) =
        match rest
        | [] => Io/pure((woken, still))
        | [p, ..tail] =>
            let dead = is_cancelled(p.token)!;
            match dead
            | true =>
                let _ = run_guards(p.guards)!;
                walk(tail, i + 1, woken, still)
            | false =>
                match is_ready(/sys/List/get(results, i), p.interest)
                | true =>
                    walk(
                        tail,
                        i + 1,
                        [Job { resume = p.resume, token = p.token, guards = p.guards }, ..woken],
                        still)
                | false => walk(tail, i + 1, woken, [p, ..still])
                end
            end
        end;
    walk(blocked, 0, [], []);

let sleep_timeout(sleeping: List(Sleeper)) -> Io(Int) =
    rec earliest(rest: List(Sleeper), best: Option(Duration)) -> Option(Duration) =
        match rest
        | [] => best
        | [s, ..more] =>
            match best
            | none() => earliest(more, Option/some(s.due))
            | some(b) =>
                match Duration/before(s.due, b)
                | true => earliest(more, Option/some(s.due))
                | false => earliest(more, best)
                end
            end
        end;
    match earliest(sleeping, Option/none())
    | none() => Io/pure(-1)
    | some(due) =>
        let now = Duration/now()!;
        let remaining = Duration/sub(due, now);
        let whole = Duration/to_millis(remaining);
        Io/pure(
            match Duration/nanos(remaining) % 1000000 > 0
            | true => Nat/to_int(whole + 1)
            | false => Nat/to_int(whole)
            end)
    end;

let expire_sleepers(sleeping: List(Sleeper)) -> Io({List(Job), List(Sleeper)}) =
    let now = Duration/now()!;
    rec walk(
        rest: List(Sleeper),
        woken: List(Job),
        still: List(Sleeper),
    ) -> Io({List(Job), List(Sleeper)}) =
        match rest
        | [] => Io/pure((woken, still))
        | [s, ..tail] =>
            let dead = is_cancelled(s.token)!;
            match dead
            | true =>
                let _ = run_guards(s.guards)!;
                walk(tail, woken, still)
            | false =>
                match Duration/before(now, s.due)
                | true => walk(tail, woken, [s, ..still])
                | false =>
                    walk(
                        tail,
                        [Job { resume = s.resume, token = s.token, guards = s.guards }, ..woken],
                        still)
                end
            end
        end;
    walk(sleeping, [], []);

-- No runnable job, nothing blocked on a handle, and no sleeper: the root can never be fulfilled. Nominal and empty — it records that the fact occurred, and leaves room to carry a diagnostic later without changing how callers match.
pub struct Deadlock: pub Type {}

-- The scheduler's four work queues, named together rather than threaded as loose cells through one closure. The root's result cell is deliberately *not* a field: it is the only piece that knows the answer type, so keeping it out leaves every function that merely moves fibers around monomorphic.
struct Queues: Type {
    runq: Cell(List(Job)),
    blocked: Cell(List(Parked)),
    sleeping: Cell(List(Sleeper)),
    parked: Cell(List(Slot)),
}

let enqueue(q: Queues, j: Job) -> Io({}) =
    let current = Cell/get(q.runq)!;
    Cell/set(q.runq, [j, ..current]);

let block_on_handle(q: Queues, job: Job, h: Handle, interest: Nat) -> Io({}) =
    let current = Cell/get(q.blocked)!;
    Cell/set(
        q.blocked,
        [
            Parked {
                handle = h,
                interest = interest,
                resume = job.resume,
                token = job.token,
                guards = job.guards,
            },
            ..current]);

let sleep_until(q: Queues, job: Job, d: Duration) -> Io({}) =
    let now = Duration/now()!;
    let current = Cell/get(q.sleeping)!;
    Cell/set(
        q.sleeping,
        [
            Sleeper {
                due = Duration/add(now, d),
                resume = job.resume,
                token = job.token,
                guards = job.guards,
            },
            ..current]);

let park_on_waker(q: Queues, job: Job, register: (Waker) -> Io({})) -> Io({}) =
    let slot = Cell/new(Option/some(job))!;
    let current = Cell/get(q.parked)!;
    let _ = Cell/set(q.parked, [slot, ..current])!;
    -- Built with explicit `bind`, not `!`: the waker is a description the scheduler runs when the
    -- slot is woken, and a `!` here would hoist the reads into *this* region and perform them now.
    -- Emptying the slot before enqueueing is what makes a second wake a no-op.
    let waker =
        Io/bind(
            Cell/get(slot),
            (held) =>
                match held
                | none() => Io/pure(())
                | some(j) => Io/bind(Cell/set(slot, Option/none()), (_) => enqueue(q, j))
                end);
    register(Waker/new(waker));

-- Run one fiber until it suspends, finishes, or is found cancelled. A cancelled or finished fiber releases its guards and is not requeued; a suspended one is handed to `resume_after` with the continuation that will resume it.
rec serve(q: Queues, job: Job) -> Io({}) =
    let dead = is_cancelled(job.token)!;
    match dead
    | true => run_guards(job.guards)
    | false =>
        let state = job.resume.0!;
        match state
        | done(_) => run_guards(job.guards)
        | step(pause, next) => resume_after(q, job, pause, next)
        end
    end

-- Where each suspension reason decides what becomes of the fiber. `resumed` is the same job with its continuation in place — every arm needs it, so it is built once here rather than six times below.
and resume_after(q: Queues, job: Job, pause: Pause, next: Io(Step({}))) -> Io({}) =
    let resumed = Job { ..job, resume = Async { next } };
    match pause
    | wait(h, interest) => block_on_handle(q, resumed, h, interest)
    | sleep(d) => sleep_until(q, resumed, d)
    | fork(child, child_token) =>
        let _ = enqueue(q, resumed)!;
        enqueue(q, Job { resume = Async { child }, token = child_token, guards = [] })
    | park(register) => park_on_waker(q, resumed, register)
    -- Acquiring and releasing a guard are bookkeeping, not suspension: the fiber is served again immediately rather than going back through the queue.
    | acquire(h, release) =>
        serve(q, Job { ..resumed, guards = [Guard { handle = h, release = release }, ..job.guards] })
    | release(h) =>
        let remaining = release_guard(h, job.guards)!;
        serve(q, Job { ..resumed, guards = remaining })
    | yield_now() => enqueue(q, resumed)
    end;

-- Release every guard still held anywhere in the scheduler. Runs on both exits — the root finishing and the deadlock — so a handle opened by a fiber that never resumes is still closed.
let release_everything(q: Queues) -> Io({}) =
    let runnable = Cell/get(q.runq)!;
    let _ = drain_jobs(runnable)!;
    let blocked = Cell/get(q.blocked)!;
    let _ = drain_parked(blocked)!;
    let sleeping = Cell/get(q.sleeping)!;
    let _ = drain_sleeping(sleeping)!;
    let parked = Cell/get(q.parked)!;
    drain_slots(parked);

let forget_cancelled_wakers(q: Queues) -> Io({}) =
    let slots = Cell/get(q.parked)!;
    let live = sweep_parked(slots)!;
    Cell/set(q.parked, live);

-- Nothing runnable and nothing that could become runnable: no handle to poll and no timer to expire. This is the deadlock condition.
let is_stalled(q: Queues) -> Io(Bool) =
    let blocked = Cell/get(q.blocked)!;
    let sleeping = Cell/get(q.sleeping)!;
    Io/pure(List/len(blocked) == 0 && List/len(sleeping) == 0);

-- Block until a handle is ready or the earliest timer is due, then move everything woken onto the run queue.
let wake_ready(q: Queues) -> Io({}) =
    let sleeping = Cell/get(q.sleeping)!;
    let timeout = sleep_timeout(sleeping)!;
    let blocked = Cell/get(q.blocked)!;
    let polled = poll_ready(blocked, timeout)!;
    let expired = expire_sleepers(sleeping)!;
    let _ = Cell/set(q.runq, [..polled.0, ..expired.0])!;
    let _ = Cell/set(q.blocked, polled.1)!;
    Cell/set(q.sleeping, expired.1);

-- The root fiber, wrapped so that finishing it records the answer where `drive` will find it. This is the only place the answer type appears in the scheduler.
let root_job(@A: Type, root: Async(A), answer: Cell(Option(A)), token: Token) -> Job =
    Job {
        resume = bind(root, (a) => bind(lift(Cell/set(answer, Option/some(a))), (_) => pure(()))),
        token = token,
        guards = [],
    };

-- The scheduler loop: serve whatever is runnable, and when nothing is, either wait for the host or report that nothing ever will be.
rec drive(@A: Type, q: Queues, answer: Cell(Option(A))) -> Io(Result(A, Deadlock)) =
    let finished = Cell/get(answer)!;
    match finished
    | some(a) =>
        let _ = release_everything(q)!;
        Io/pure(Result/success(a))
    | none() =>
        let runnable = Cell/get(q.runq)!;
        match runnable
        | [] =>
            let _ = forget_cancelled_wakers(q)!;
            let stalled = is_stalled(q)!;
            match stalled
            | true =>
                -- Reported to the caller rather than fatal: terminating the process is `run`'s decision, not the scheduler's.
                let _ = release_everything(q)!;
                Io/pure(Result/failure(Deadlock {}))
            | false =>
                let _ = wake_ready(q)!;
                drive(q, answer)
            end
        | [job, ..rest] =>
            let _ = Cell/set(q.runq, rest)!;
            let _ = serve(q, job)!;
            drive(q, answer)
        end
    end;

pub let block_on(@A: Type, root: Async(A)) -> Io(Result(A, Deadlock)) =
    let runq: Cell(List(Job)) = Cell/new([])!;
    let blocked: Cell(List(Parked)) = Cell/new([])!;
    let sleeping: Cell(List(Sleeper)) = Cell/new([])!;
    let parked: Cell(List(Slot)) = Cell/new([])!;
    let q = Queues { runq = runq, blocked = blocked, sleeping = sleeping, parked = parked };
    let answer: Cell(Option(A)) = Cell/new(Option/none())!;
    let root_cancelled: Cell(Bool) = Cell/new(false)!;
    let _ = enqueue(q, root_job(root, answer, Token { root_cancelled }))!;
    drive(q, answer);

pub let run(main: Async({})) -> Io({}) =
    let outcome = block_on(main)!;
    match outcome
    | success(_) => Io/pure(())
    | failure(_) =>
        let _ = /std/print_err("async: deadlocked, no runnable work remains\n")!;
        /sys/proc/exit(1)
    end;

pub struct Task(A: Type): Type {
    result: Future(A),
    token: Token,
}

pub let spawn(@A: Type, body: Async(A)) -> Async(Task(A)) =
    let f = Future/new()!;
    let c = Cell/new(false)!;
    let t = Token { c };
    let task = Task { result = f, token = t };
    let _ =
        fork_with(
            Async { bind_raw(body.0, (a) => bind(lift(Future/fulfill(f, a)), (_) => pure(())).0) },
            t)!;
    pure(task);

pub let join(@A: Type, task: Task(A)) -> Async(A) =
    await(task.result);

pub let cancel(@A: Type, task: Task(A)) -> Io({}) =
    cancel_token(task.token);

rec cancel_all(ts: List(Token)) -> Io({}) =
    match ts
    | [] => Io/pure(())
    | [t, ..more] =>
        let _ = cancel_token(t)!;
        cancel_all(more)
    end;

pub let join_all(@A: Type, tasks: List(Async(A))) -> Async(List(A)) =
    rec go(i: Nat) -> Async(List(A)) =
        match Nat/Lt/try(i, List/len(tasks))
        | none() => pure([])
        | some(ok) =>
            let h = spawn(List/at(tasks, i, ok))!;
            let rest = go(i + 1)!;
            let a = join(h)!;
            pure([a, ..rest])
        end;
    go(0);

pub let select(@A: Type, tasks: List(Async(A))) -> Async({Nat, A}) =
    let winner = Future/new()!;
    rec arm(i: Nat) -> Async(List(Token)) =
        match Nat/Lt/try(i, List/len(tasks))
        | none() => pure([])
        | some(ok) =>
            let c = Cell/new(false)!;
            let t = Token { c };
            let _ =
                fork_with(
                    Async {
                        bind_raw(
                            List/at(tasks, i, ok).0,
                            (a) => bind(lift(Future/fulfill(winner, (i, a))), (_) => pure(())).0),
                    },
                    t)!;
            let rest = arm(i + 1)!;
            pure([t, ..rest])
        end;
    let tokens = arm(0)!;
    let w = await(winner)!;
    let _ = cancel_all(tokens)!;
    pure(w);

pub let race(@A: Type, tasks: List(Async(A))) -> Async(A) =
    map(select(tasks), (w) => w.1);

pub let timeout(@A: Type, d: Duration, body: Async(A)) -> Async(Option(A)) =
    map(
        select([map(body, (a) => Option/some(a)), map(sleep(d), (_) => Option/none())]),
        (w) => w.1);

satisfy Monad(Async) {
    pure = pure,
    bind = bind,
}

satisfy Lift(Io, Async) {
    lift = lift,
}
