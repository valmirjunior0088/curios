use /std/{Bytes, Nat, Int, Bool, Str, List, Option, Result, Cell, Monad, Lift, Io, stream};
use /std/time/{Duration};

mod Waker;
pub use Waker/{let Waker};

mod Future;
pub use Future/{let Future};

-- | A flag one fiber raises and another parks on: the one park a program takes that waits on no handle and no timer.
pub mod Signal;
pub use Signal/{let Signal};

-- | What a selection is written against: a non-committing attempt at a value and what to wait on while it declines.
pub mod Offer;
pub use Offer/{let Offer};

-- | A bounded queue two fibers hand values through.
pub mod Channel;
pub use Channel/{let Channel};

-- | The loops that turn a raw handle's `would_block` into a park, for a stream type's own witness.
pub mod raw;

struct Token: Type {
    Cell(Bool),
}

let cancel_token(t: Token) -> Io({}) =
    Cell/set(t.0, true);

let is_cancelled(t: Token) -> Io(Bool) =
    Cell/get(t.0);

struct Guard: Type {
    done: Cell(Bool),
    release: Io({}),
}

-- | One thing a parked fiber waits for. A park names a list of them and resumes on whichever fires first.
pub induct Wait: pub Type
| readable(handle: /sys/Handle, interest: Nat)
| elapsed(Duration)
| woken(register: (Waker) -> Io({}))
end

induct Pause: Type
| park(waits: List(Wait))
| fork(child: Io(Step({})), token: Token)
| acquire(Guard)
| yield_now()
and Step(A: Type): Type
| done(A)
| step(pause: Pause, next: Io(Step(A)))
end

-- | A fiber: a computation that may park and resume.
pub struct Async(A: Type): Type {
    Io(Step(A)),
}

-- | A fiber that answers nothing.
pub let Fiber: Type =
    Async({});

-- | `a`, with no suspension.
pub let pure(@A: Type, a: A) -> Async(A) =
    Async { Io/pure(Step/done(a)) };

let bind_raw(@A: Type, @B: Type, m: Io(Step(A)), f: (A) -> Io(Step(B))) -> Io(Step(B)) =
    let s = m!;
    match s | done(a) => f(a) | step(p, k) => Io/pure(Step/step(p, bind_raw(k, f))) end;

-- | `m`, then `f` on its answer.
pub let bind(@A: Type, @B: Type, m: Async(A), f: (A) -> Async(B)) -> Async(B) =
    Async { bind_raw(m.0, (a) => f(a).0) };

-- | `f` on the answer.
pub let map(@A: Type, @B: Type, m: Async(A), f: (A) -> B) -> Async(B) =
    bind(m, (a) => pure(f(a)));

-- | An `Io` action as one step that never parks.
pub let lift(@A: Type, action: Io(A)) -> Async(A) =
    Async { Io/bind(action, (a) => Io/pure(Step/done(a))) };

let suspend(p: Pause) -> Async({}) =
    Async { Io/pure(Step/step(p, Io/pure(Step/done(())))) };

let park(waits: List(Wait)) -> Async({}) =
    suspend(Pause/park(waits));

let wait(h: /sys/Handle, ev: Nat) -> Async({}) =
    park([Wait/readable(h, ev)]);

-- | Park for `d`.
pub let sleep(d: Duration) -> Async({}) =
    park([Wait/elapsed(d)]);

let on_waker(register: (Waker) -> Io({})) -> Async({}) =
    park([Wait/woken(register)]);

-- | Park once, letting every other runnable fiber take a turn.
pub let yield_now: Async({}) =
    suspend(Pause/yield_now());

let acquire(g: Guard) -> Async({}) =
    suspend(Pause/acquire(g));

let fork_with(child: Fiber, t: Token) -> Async({}) =
    suspend(Pause/fork(child.0, t));

-- | `body` with `fin` run when it is over: on the way out, or by the scheduler when the task is cancelled, dropped at the root's end, or found parked at a deadlock. Both exits, exactly once.
pub let using(@A: Type, fin: Io({}), body: Async(A)) -> Async(A) =
    let done = Cell/new(false)!;
    let g = Guard { done = done, release = fin };
    let _ = acquire(g)!;
    let a = body!;
    let _ = run_guard(g)!;
    pure(a);

-- | Fork `body` as a fiber of its own, which runs before the forker takes another step.
pub let go(body: Fiber) -> Async({}) =
    let c = Cell/new(false)!;
    fork_with(body, Token { c });

-- | Everything `read` yields up to the end of the stream; a failure before the end drops what was read.
pub let drain(read: (Nat) -> Async(stream/Chunk)) -> Async(Result(Io/Error, Bytes)) =
    let go(acc: Bytes) -> Async(Result(Io/Error, Bytes)) =
        let r = read(4096)!;
        match r
        | chunk(bytes) => go(x[..acc, ..bytes])
        | eof() => pure(Result/success(acc))
        | error(e) => pure(Result/failure(e))
        end;
    go(x[]);

-- | The value `f` is fulfilled with, parking until it is.
pub let await(@A: Type, f: Future(A)) -> Async(A) =
    let polled = Future/poll(f)!;
    match polled
    | some(a) => pure(a)
    | none() =>
        let _ = on_waker((w) => Future/register(f, w))!;
        await(f)
    end;

struct Job: Type {
    resume: Fiber,
    token: Token,
    guards: List(Guard),
}

-- | Where a parked job waits to be claimed. Every registration one park makes points at the same slot, so the first wait to fire takes the job and every other finds it gone.
let Slot: Type =
    Cell(Option(Job));

let claim(s: Slot) -> Io(Option(Job)) =
    let held = Cell/get(s)!;
    match held
    | none() => Io/pure(Option/none())
    | some(j) =>
        let _ = Cell/set(s, Option/none())!;
        Io/pure(Option/some(j))
    end;

struct Parked: Type {
    handle: /sys/Handle,
    interest: Nat,
    slot: Slot,
}

struct Sleeper: Type {
    due: Duration,
    slot: Slot,
}

let run_guard(g: Guard) -> Io({}) =
    let done = Cell/get(g.done)!;
    match done
    | true => Io/pure(())
    | false =>
        let _ = Cell/set(g.done, true)!;
        g.release
    end;

let run_guards(gs: List(Guard)) -> Io({}) =
    match gs
    | [] => Io/pure(())
    | [g, ..more] =>
        let _ = run_guard(g)!;
        run_guards(more)
    end;

let live_guards(gs: List(Guard)) -> Io(List(Guard)) =
    match gs
    | [] => Io/pure([])
    | [g, ..more] =>
        let done = Cell/get(g.done)!;
        let rest = live_guards(more)!;
        Io/pure(match done | true => rest | false => [g, ..rest] end)
    end;

let drain_jobs(js: List(Job)) -> Io({}) =
    match js
    | [] => Io/pure(())
    | [j, ..more] =>
        let _ = run_guards(j.guards)!;
        drain_jobs(more)
    end;

let drain_slots(ss: List(Slot)) -> Io({}) =
    match ss
    | [] => Io/pure(())
    | [s, ..more] =>
        let held = claim(s)!;
        match held
        | none() => drain_slots(more)
        | some(j) =>
            let _ = run_guards(j.guards)!;
            drain_slots(more)
        end
    end;

let sweep_parked(ss: List(Slot)) -> Io(List(Slot)) =
    match ss
    | [] => Io/pure([])
    | [s, ..more] =>
        let held = Cell/get(s)!;
        match held
        | none() => sweep_parked(more)
        | some(j) =>
            let dead = is_cancelled(j.token)!;
            match dead
            | true =>
                let _ = run_guards(j.guards)!;
                let _ = Cell/set(s, Option/none())!;
                sweep_parked(more)
            | false =>
                let rest = sweep_parked(more)!;
                Io/pure([s, ..rest])
            end
        end
    end;

let is_ready(results: Nat, interest: Nat) -> Bool =
    Nat/and(results, Nat/or(Nat/or(interest, /sys/event/err), /sys/event/hup)) > 0;

let poll_ready(blocked: List(Parked), timeout: Int) -> Io({List(Job), List(Parked)}) =
    let handles = List/map(blocked, (p: Parked) => p.handle);
    let events = List/map(blocked, (p: Parked) => p.interest);
    let results = /sys/Handle/poll(handles, events, timeout)!;
    let walk(
        rest: List(Parked),
        i: Nat,
        woken: List(Job),
        still: List(Parked),
    ) -> Io({List(Job), List(Parked)}) =
        match rest
        | [] => Io/pure((woken, still))
        | [p, ..tail] =>
            let held = Cell/get(p.slot)!;
            match held
            | none() => walk(tail, i + 1, woken, still)
            | some(j) =>
                let dead = is_cancelled(j.token)!;
                match dead
                | true =>
                    let _ = claim(p.slot)!;
                    let _ = run_guards(j.guards)!;
                    walk(tail, i + 1, woken, still)
                | false =>
                    match is_ready(Option/unwrap_or(List/try_get(results, i), 0), p.interest)
                    | true =>
                        let taken = claim(p.slot)!;
                        match taken
                        | none() => walk(tail, i + 1, woken, still)
                        | some(k) => walk(tail, i + 1, [k, ..woken], still)
                        end
                    | false => walk(tail, i + 1, woken, [p, ..still])
                    end
                end
            end
        end;
    walk(blocked, 0, [], []);

let sleep_timeout(sleeping: List(Sleeper)) -> Io(Int) =
    let earliest(rest: List(Sleeper), best: Option(Duration)) -> Option(Duration) =
        match rest
        | [] => best
        | [s, ..more] =>
            match best
            | none() => earliest(more, Option/some(s.due))
            | some(b) =>
                match Duration/before(s.due, b)
                | true => earliest(more, Option/some(s.due))
                | false => earliest(more, best)
                end
            end
        end;
    match earliest(sleeping, Option/none())
    | none() => Io/pure(-1)
    | some(due) =>
        let now = Duration/now()!;
        let remaining = Duration/sub(due, now);
        let whole = Duration/to_millis(remaining);
        Io/pure(
            match Duration/nanos(remaining) % 1000000 > 0
            | true => Nat/to_int(whole + 1)
            | false => Nat/to_int(whole)
            end)
    end;

let expire_sleepers(sleeping: List(Sleeper)) -> Io({List(Job), List(Sleeper)}) =
    let now = Duration/now()!;
    let walk(
        rest: List(Sleeper),
        woken: List(Job),
        still: List(Sleeper),
    ) -> Io({List(Job), List(Sleeper)}) =
        match rest
        | [] => Io/pure((woken, still))
        | [s, ..tail] =>
            let held = Cell/get(s.slot)!;
            match held
            | none() => walk(tail, woken, still)
            | some(j) =>
                let dead = is_cancelled(j.token)!;
                match dead
                | true =>
                    let _ = claim(s.slot)!;
                    let _ = run_guards(j.guards)!;
                    walk(tail, woken, still)
                | false =>
                    match Duration/before(now, s.due)
                    | true => walk(tail, woken, [s, ..still])
                    | false =>
                        let taken = claim(s.slot)!;
                        match taken
                        | none() => walk(tail, woken, still)
                        | some(k) => walk(tail, [k, ..woken], still)
                        end
                    end
                end
            end
        end;
    walk(sleeping, [], []);

-- | No runnable fiber, nothing blocked on a handle, and no sleeper: the root can never be fulfilled. `parked` is how many fibers wait on a waker nothing will fire.
pub struct Deadlock: pub Type {
    parked: Nat,
}

struct Queues: Type {
    runq: Cell(List(Job)),
    blocked: Cell(List(Parked)),
    sleeping: Cell(List(Sleeper)),
    waiting: Cell(List(Slot)),
}

let enqueue(q: Queues, j: Job) -> Io({}) =
    let current = Cell/get(q.runq)!;
    Cell/set(q.runq, [..current, j]);

let waker_for(q: Queues, slot: Slot) -> Waker =
    Waker/new(
        Io/bind(
            claim(slot),
            (held) => match held | none() => Io/pure(()) | some(j) => enqueue(q, j) end));

let register_wait(q: Queues, slot: Slot, w: Wait) -> Io({}) =
    match w
    | readable(h, interest) =>
        let current = Cell/get(q.blocked)!;
        Cell/set(q.blocked, [Parked { handle = h, interest = interest, slot = slot }, ..current])
    | elapsed(d) =>
        let now = Duration/now()!;
        let current = Cell/get(q.sleeping)!;
        Cell/set(q.sleeping, [Sleeper { due = Duration/add(now, d), slot = slot }, ..current])
    | woken(register) => register(waker_for(q, slot))
    end;

let register_waits(q: Queues, slot: Slot, ws: List(Wait)) -> Io({}) =
    match ws
    | [] => Io/pure(())
    | [w, ..more] =>
        let _ = register_wait(q, slot, w)!;
        register_waits(q, slot, more)
    end;

let park_job(q: Queues, job: Job, ws: List(Wait)) -> Io({}) =
    let slot = Cell/new(Option/some(job))!;
    let current = Cell/get(q.waiting)!;
    let _ = Cell/set(q.waiting, [slot, ..current])!;
    register_waits(q, slot, ws);

let serve(q: Queues, job: Job) -> Io({}) =
    let dead = is_cancelled(job.token)!;
    match dead
    | true => run_guards(job.guards)
    | false =>
        let state = job.resume.0!;
        match state
        | done(_) => run_guards(job.guards)
        | step(pause, next) => resume_after(q, job, pause, next)
        end
    end
and resume_after(q: Queues, job: Job, pause: Pause, next: Io(Step({}))) -> Io({}) =
    let resumed = Job { ..job, resume = Async { next } };
    match pause
    | park(ws) => park_job(q, resumed, ws)
    | fork(child, child_token) =>
        let _ = enqueue(q, Job { resume = Async { child }, token = child_token, guards = [] })!;
        enqueue(q, resumed)
    | acquire(g) =>
        let kept = live_guards(job.guards)!;
        serve(q, Job { ..resumed, guards = [g, ..kept] })
    | yield_now() => enqueue(q, resumed)
    end;

let release_everything(q: Queues) -> Io({}) =
    let runnable = Cell/get(q.runq)!;
    let _ = drain_jobs(runnable)!;
    let waiting = Cell/get(q.waiting)!;
    drain_slots(waiting);

let forget_cancelled(q: Queues) -> Io({}) =
    let slots = Cell/get(q.waiting)!;
    let live = sweep_parked(slots)!;
    Cell/set(q.waiting, live);

let live_blocked(ps: List(Parked)) -> Io(List(Parked)) =
    match ps
    | [] => Io/pure([])
    | [p, ..more] =>
        let held = Cell/get(p.slot)!;
        let rest = live_blocked(more)!;
        Io/pure(match held | none() => rest | some(_) => [p, ..rest] end)
    end;

let live_sleeping(ss: List(Sleeper)) -> Io(List(Sleeper)) =
    match ss
    | [] => Io/pure([])
    | [s, ..more] =>
        let held = Cell/get(s.slot)!;
        let rest = live_sleeping(more)!;
        Io/pure(match held | none() => rest | some(_) => [s, ..rest] end)
    end;

-- | Forget the registrations of a job some other wait already claimed, so one park over several waits leaves nothing behind it.
let prune(q: Queues) -> Io({}) =
    let blocked = Cell/get(q.blocked)!;
    let kept_blocked = live_blocked(blocked)!;
    let _ = Cell/set(q.blocked, kept_blocked)!;
    let sleeping = Cell/get(q.sleeping)!;
    let kept_sleeping = live_sleeping(sleeping)!;
    Cell/set(q.sleeping, kept_sleeping);

let is_stalled(q: Queues) -> Io(Bool) =
    let blocked = Cell/get(q.blocked)!;
    let sleeping = Cell/get(q.sleeping)!;
    Io/pure(List/len(blocked) == 0 && List/len(sleeping) == 0);

let wake_ready(q: Queues) -> Io({}) =
    let sleeping = Cell/get(q.sleeping)!;
    let timeout = sleep_timeout(sleeping)!;
    let blocked = Cell/get(q.blocked)!;
    let polled = poll_ready(blocked, timeout)!;
    let expired = expire_sleepers(sleeping)!;
    let _ = Cell/set(q.runq, [..polled.0, ..expired.0])!;
    let _ = Cell/set(q.blocked, polled.1)!;
    Cell/set(q.sleeping, expired.1);

let root_job(@A: Type, root: Async(A), answer: Cell(Option(A)), token: Token) -> Job =
    Job {
        resume = bind(root, (a) => bind(lift(Cell/set(answer, Option/some(a))), (_) => pure(()))),
        token = token,
        guards = [],
    };

let drive(@A: Type, q: Queues, answer: Cell(Option(A))) -> Io(Result(Deadlock, A)) =
    let finished = Cell/get(answer)!;
    match finished
    | some(a) =>
        let _ = release_everything(q)!;
        Io/pure(Result/success(a))
    | none() =>
        let runnable = Cell/get(q.runq)!;
        match runnable
        | [] =>
            let _ = forget_cancelled(q)!;
            let _ = prune(q)!;
            let stalled = is_stalled(q)!;
            match stalled
            | true =>
                let slots = Cell/get(q.waiting)!;
                let _ = release_everything(q)!;
                Io/pure(Result/failure(Deadlock { parked = List/len(slots) }))
            | false =>
                let _ = wake_ready(q)!;
                drive(q, answer)
            end
        | [job, ..rest] =>
            let _ = Cell/set(q.runq, rest)!;
            let _ = serve(q, job)!;
            drive(q, answer)
        end
    end;

-- | Drive `root` to its answer, or to the deadlock that stops it.
pub let block_on(@A: Type, root: Async(A)) -> Io(Result(Deadlock, A)) =
    let runq: Cell(List(Job)) = Cell/new([])!;
    let blocked: Cell(List(Parked)) = Cell/new([])!;
    let sleeping: Cell(List(Sleeper)) = Cell/new([])!;
    let waiting: Cell(List(Slot)) = Cell/new([])!;
    let q = Queues { runq = runq, blocked = blocked, sleeping = sleeping, waiting = waiting };
    let answer: Cell(Option(A)) = Cell/new(Option/none())!;
    let root_cancelled: Cell(Bool) = Cell/new(false)!;
    let _ = enqueue(q, root_job(root, answer, Token { root_cancelled }))!;
    drive(q, answer);

-- | Drive `main` to its end; a deadlock is reported on standard error and exits with 1.
pub let run(main: Async({})) -> Io({}) =
    let outcome = block_on(main)!;
    match outcome
    | success(_) => Io/pure(())
    | failure(d) =>
        let _ =
            /std/print_err(
                Str/flatten([
                    "async: deadlocked, no runnable work remains and ",
                    Nat/to_str(d.parked),
                    " fiber(s) wait on a waker nothing will fire\n"]))!;
        /sys/proc/exit(1)
    end;

-- | A spawned fiber: its answer, and the means to cancel it.
pub struct Task(A: Type): Type {
    result: Future(A),
    token: Token,
}

-- | Fork `body` as a task whose answer `join` waits for.
pub let spawn(@A: Type, body: Async(A)) -> Async(Task(A)) =
    let f = Future/new()!;
    let c = Cell/new(false)!;
    let t = Token { c };
    let task = Task { result = f, token = t };
    let _ =
        fork_with(
            Async { bind_raw(body.0, (a) => bind(lift(Future/fulfill(f, a)), (_) => pure(())).0) },
            t)!;
    pure(task);

-- | The task's answer, parking until it has one.
pub let join(@A: Type, task: Task(A)) -> Async(A) =
    await(task.result);

-- | Ask the task to stop; its guards are released when the scheduler finds it cancelled.
pub let cancel(@A: Type, task: Task(A)) -> Io({}) =
    cancel_token(task.token);

let cancel_all(ts: List(Token)) -> Io({}) =
    match ts
    | [] => Io/pure(())
    | [t, ..more] =>
        let _ = cancel_token(t)!;
        cancel_all(more)
    end;

-- | Every task's answer, in order, each spawned before the next is waited for.
pub let join_all(@A: Type, tasks: List(Async(A))) -> Async(List(A)) =
    let go(i: Nat) -> Async(List(A)) =
        match Nat/Lt/try(i, List/len(tasks))
        | none() => pure([])
        | some(ok) =>
            let h = spawn(List/get(@Async(A), tasks, i, @ok))!;
            let rest = go(i + 1)!;
            let a = join(h)!;
            pure([a, ..rest])
        end;
    go(0);

let attempt(@A: Type, offers: List(Offer(A)), i: Nat) -> Io(Option({Nat, A})) =
    match offers
    | [] => Io/pure(Option/none())
    | [o, ..more] =>
        let got = o.try!;
        match got | some(a) => Io/pure(Option/some((i, a))) | none() => attempt(more, i + 1) end
    end;

let waits_of(@A: Type, offers: List(Offer(A))) -> Io(List(Wait)) =
    match offers
    | [] => Io/pure([])
    | [o, ..more] =>
        let w = o.wait!;
        let ws = waits_of(more)!;
        Io/pure([w, ..ws])
    end;

-- | The first offer to yield a value, with its index, parking on all of them while every one declines. Offers are tried in list order, so a selection is not fair, and nothing leaves a source until it is the answer, so an offer that loses has consumed nothing.
pub let select(@A: Type, offers: List(Offer(A))) -> Async({Nat, A}) =
    let taken = attempt(offers, 0)!;
    match taken
    | some(w) => pure(w)
    | none() =>
        let ws = waits_of(offers)!;
        let _ = park(ws)!;
        select(offers)
    end;

-- | An offer that yields once `d` has passed.
pub let after(d: Duration) -> Io(Offer({})) =
    let start = Duration/now()!;
    let due = Duration/add(start, d);
    Io/pure(
        Offer/new(
            Io/bind(
                Duration/now(),
                (t) =>
                    Io/pure(
                        match Duration/before(t, due)
                        | true => Option/none()
                        | false => Option/some(())
                        end)),
            Io/bind(Duration/now(), (t) => Io/pure(Wait/elapsed(Duration/sub(due, t))))));

-- | An offer that yields the task's answer once it has one.
pub let joined(@A: Type, task: Task(A)) -> Offer(A) =
    Offer/new(
        Future/poll(task.result),
        Io/pure(Wait/woken((w) => Future/register(task.result, w))));

let spawn_all(@A: Type, tasks: List(Async(A))) -> Async(List(Task(A))) =
    match tasks
    | [] => pure([])
    | [t, ..more] =>
        let h = spawn(t)!;
        let rest = spawn_all(more)!;
        pure([h, ..rest])
    end;

-- | The first of `tasks` to answer, with its index; the others are cancelled. A task abandoned part-way loses whatever it had taken and not yet answered with, which is what abandoning a running computation costs — a selection over `Offer`s takes nothing until it keeps it, and is the way to choose without paying that.
pub let first(@A: Type, tasks: List(Async(A))) -> Async({Nat, A}) =
    let running = spawn_all(tasks)!;
    let w = select(List/map(running, (t: Task(A)) => joined(t)))!;
    let _ = lift(cancel_all(List/map(running, (t: Task(A)) => t.token)))!;
    pure(w);

-- | The first of `tasks` to answer; the others are cancelled.
pub let race(@A: Type, tasks: List(Async(A))) -> Async(A) =
    map(first(tasks), (w) => w.1);

-- | `body`'s answer, or `none` when `d` passes first, in which case `body` is cancelled. An answer that lands after `d` is dropped, which is what a timeout means.
pub let timeout(@A: Type, d: Duration, body: Async(A)) -> Async(Option(A)) =
    let running = spawn(body)!;
    let timer = lift(after(d))!;
    let w =
        select([
            Offer/map(joined(running), (a) => Option/some(a)),
            Offer/map(timer, (_) => Option/none())])!;
    let _ = lift(cancel(running))!;
    pure(w.1);

satisfy Monad(Async) {
    pure = pure,
    bind = bind,
}

satisfy Lift(Io, Async) {
    lift = lift,
}

satisfy Lift(Async, Async) {
    lift(@_A, m) = m,
}
