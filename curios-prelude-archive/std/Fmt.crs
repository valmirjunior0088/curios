use /std/{Bytes, Byte, Str, Nat, Show, Io};

-- | A parsed format string: literal pieces, and the places an argument goes.
pub induct Fmt: pub Type
| nil()
| lit(piece: Str, rest: Fmt)
| show(Fmt)
end

-- | The type of a function taking one `Show`-able argument per place in `f` and answering a `T`.
pub let format_type_with(T: Type, f: Fmt) -> Type =
    match f
    | nil() => T
    | lit(_, rest) => format_type_with(T, rest)
    | show(rest) => (@A: Type, use Show(A), a: A) -> format_type_with(T, rest)
    end;

let flush(bytes: Bytes, start: Nat, count: Nat, rest: Fmt) -> Fmt =
    match Nat/Le/try(start + count, Bytes/len(bytes))
    | none() => Fmt/nil()
    | some(within) =>
        match Str/of_bytes(Bytes/slice(bytes, start, count, @within))
        | some(piece) => Fmt/lit(piece, rest)
        | none() => Fmt/nil()
        end
    end;

let parse_at(bytes: Bytes, pos: Nat, fuel: Nat) -> Fmt =
    match fuel
    | 0 => Fmt/nil()
    | rest + 1 =>
        match Nat/Lt/try(pos, Bytes/len(bytes))
        | none() => Fmt/nil()
        | some(ok) =>
            match Byte/to_nat(Bytes/get(bytes, pos, @ok))
            | 37 => Fmt/show(parse_at(bytes, pos + 1, rest))
            | _ => parse_lit_at(bytes, pos, 0, rest)
            end
        end
    end
and parse_lit_at(bytes: Bytes, start: Nat, taken: Nat, fuel: Nat) -> Fmt =
    match fuel
    | 0 => flush(bytes, start, taken, Fmt/nil())
    | rest + 1 =>
        match Nat/Lt/try(start + taken, Bytes/len(bytes))
        | none() => flush(bytes, start, taken, Fmt/nil())
        | some(ok) =>
            match Byte/to_nat(Bytes/get(bytes, start + taken, @ok))
            | 37 => flush(bytes, start, taken, Fmt/show(parse_at(bytes, start + taken + 1, rest)))
            | 92 => parse_esc_at(bytes, start, taken, rest)
            | _ => parse_lit_at(bytes, start, taken + 1, rest)
            end
        end
    end
and parse_esc_at(bytes: Bytes, start: Nat, taken: Nat, fuel: Nat) -> Fmt =
    match fuel
    | 0 => flush(bytes, start, taken, Fmt/nil())
    | rest + 1 =>
        match Nat/Lt/try(start + taken + 1, Bytes/len(bytes))
        | none() => parse_lit_at(bytes, start, taken + 1, rest)
        | some(ok) =>
            match Byte/to_nat(Bytes/get(bytes, start + taken + 1, @ok))
            | 37 =>
                flush(bytes, start, taken, Fmt/lit("%", parse_at(bytes, start + taken + 2, rest)))
            | _ => parse_lit_at(bytes, start, taken + 1, rest)
            end
        end
    end;

-- | The format `s` spells: `%` is a place, `\%` a literal percent.
pub let parse(s: Str) -> Fmt =
    let bytes = Str/to_bytes(s);
    parse_at(bytes, 0, 3 * Bytes/len(bytes) + 3);

let go_with(T: Type, finish: (Str) -> T, f: Fmt, acc: Str) -> format_type_with(T, f) =
    match f
    | nil() => finish(acc)
    | lit(piece, rest) => go_with(T, finish, rest, Str/concat(acc, piece))
    | show(rest) => (use w, a) => go_with(T, finish, rest, Str/concat(acc, Show/show(a)))
    end;

-- | The text of `s` with its places filled by the arguments that follow.
pub let render(s: Str) -> format_type_with(Str, parse(s)) =
    go_with(Str, (x) => x, parse(s), "");

-- | The text of `s` with its places filled, written to standard output.
pub let print(s: Str) -> format_type_with(Io({}), parse(s)) =
    go_with(Io({}), (x) => /std/print(x), parse(s), "");

-- | The text of `s` with its places filled, written to standard error.
pub let print_err(s: Str) -> format_type_with(Io({}), parse(s)) =
    go_with(Io({}), (x) => /std/print_err(x), parse(s), "");
