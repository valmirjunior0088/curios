use /std/{Monad};

-- | A computation over a state `S` answering an `A` and the next state.
pub struct State(S: Type, A: Type): Type {
    (S) -> {A, S},
}

-- | Any state transformer as a `State` action.
pub let state(@S: Type, @A: Type, f: (S) -> {A, S}) -> State(S, A) =
    State { f };

-- | `a`, with the state untouched.
pub let pure(@S: Type, @A: Type, a: A) -> State(S, A) =
    State { (s) => (a, s) };

-- | `m`, then `f` on its answer from the state it left.
pub let bind(@S: Type, @A: Type, @B: Type, m: State(S, A), f: (A) -> State(S, B)) -> State(S, B) =
    State {
        (s) =>
            let r = m.0(s);
            f(r.0).0(r.1),
    };

-- | The current state.
pub let get(@S: Type) -> State(S, S) =
    State { (s) => (s, s) };

-- | `s` as the state.
pub let put(@S: Type, s: S) -> State(S, {}) =
    State { (_) => ((), s) };

-- | `f` on the current state.
pub let modify(@S: Type, f: (S) -> S) -> State(S, {}) =
    bind(get(), (s) => put(f(s)));

-- | `m` from `init`: its answer and the final state.
pub let run(@S: Type, @A: Type, m: State(S, A), init: S) -> {A, S} =
    m.0(init);

satisfy (@S: Type) => Monad((A: Type) => State(S, A)) {
    pure(@_A, a) = pure(a),
    bind(@_A, @_B, m, f) = bind(m, f),
}
