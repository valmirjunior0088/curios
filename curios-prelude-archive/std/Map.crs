-- A crit-bit (Patricia) trie keyed on the byte string a `Key` witness produces. The map deliberately does not remember `K`: the trie's identity *is* that byte string, so two key types serializing alike are the same key. `Key` is therefore a write-side injection only — `entries`, `keys`, and `fold` hand back `Bytes`, and a caller wanting typed keys decodes at the boundary.
use /std/{Bytes, Byte, Nat, Bool, Str, List, Option, Eq, Equal, Show};

induct Node(V: Type): Type
| leaf(key: Bytes, value: V)
| fork(crit: Nat, zero: Node(V), one: Node(V))
end

pub struct Map(V: Type): Type {
    size: Nat,
    root: Option(Node(V)),
}

-- The trie's identity is the byte string, so a `to_bytes` that collides silently merges two keys into one entry. `injective` is that obligation stated where it can be checked: a witness cannot register without proving its own encoding distinguishes what the key type distinguishes.
pub concept Key(K: Type): pub Type {
    to_bytes(K) -> Bytes,
    injective(a: K, b: K, same: Eq(to_bytes(a), to_bytes(b))) -> Eq(a, b),
}

satisfy Key(Bytes) {
    to_bytes(b) = b,
    -- The identity encoding: the goal reduces to the hypothesis.
    injective(a, b, same) = same,
}

satisfy Key(Str) {
    to_bytes = Str/to_bytes,
    injective(a, b, same) = Str/eq_of_bytes(a, b, same),
}

-- No `Key(Nat)`. Its base-256 encoding recursed on `x / 256`, and intrinsic `Nat` eliminates only by unary successor, so no induction principle reaches that recursion: the injectivity is unprovable with or without the division reduction laws.
--
-- Rocq's answer is not to encode into a binary representation but to *work* in one — `positive` is this library's `BigPos` and `N` its `BigNat` — where digit injectivity comes from the representation rather than from arithmetic. Its bridge from unary `nat` is proved by successor (`Pos.of_nat (S n) = Pos.succ (Pos.of_nat n)`), which is affordable exactly because that bridge is only ever needed inside proofs. Agda and Lean instead give the digit expansion its own well-founded or fuel-based recursion, and neither form exists here.
--
-- So a caller wanting numeric keys encodes them at the boundary, and a future `Key` for a binary carrier is the shape worth building.
-- The range test is written `g < len` rather than as a refuted `g >= len` so that the in-range arm can index through `Bytes/get`: `Nat/Lt` is decided on exactly this comparison, so refining it to `true` reduces the proposition away and the bound is discharged with nothing written. Spelling the same fact the other way round leaves the refinement on `>=`, where nothing reduces `<`, and the index becomes unpayable.
let bit(k: Bytes, j: Nat) -> Nat =
    let g = j / 9;
    let o = j % 9;
    match g < Bytes/len(k)
    | false => 0
    | true =>
        match o == 0
        | true => 1
        | false => Nat/and(Nat/shr(Byte/to_nat(Bytes/get(k, g)), 8 - o), 1)
        end
    end;

let crit(a: Bytes, b: Bytes) -> Nat =
    let bits(x: Nat, y: Nat, g: Nat, o: Nat) -> Nat =
        match Nat/and(Nat/shr(x, 8 - o), 1) == Nat/and(Nat/shr(y, 8 - o), 1)
        | true => bits(x, y, g, o + 1)
        | false => g * 9 + o
        end;
    -- Nested rather than conjoined, for the reason `bit` states: a refinement records the term it scrutinised, so a true `x && y` says nothing about `x`, and each bound has to be refined on its own before `Bytes/get` will take it. Both exhausted branches agree, so the split changes nothing but what is provable inside them.
    let bytes(g: Nat) -> Nat =
        match g < Bytes/len(a)
        | false => g * 9
        | true =>
            match g < Bytes/len(b)
            | false => g * 9
            | true =>
                let x = Byte/to_nat(Bytes/get(a, g));
                let y = Byte/to_nat(Bytes/get(b, g));
                match x == y | true => bytes(g + 1) | false => bits(x, y, g, 1) end
            end
        end;
    bytes(0);

let lookup(@V: Type, t: Node(V), k: Bytes) -> {Bytes, V} =
    match t
    | leaf(k0, v0) => (k0, v0)
    | fork(c, z, o) => match bit(k, c) | 0 => lookup(z, k) | _ => lookup(o, k) end
    end;

let wedge(@V: Type, c: Nat, b: Nat, k: Bytes, v: V, t: Node(V)) -> Node(V) =
    match b | 0 => Node/fork(c, Node/leaf(k, v), t) | _ => Node/fork(c, t, Node/leaf(k, v)) end;

-- One descent per insert, deciding on the way back up. `insert1` answers the rebuilt subtree, a crit position, and one of three states: 0 placed, 1 pending, 2 replaced. The state is what keeps `size` right, and `pending` is what lets a single walk find an attachment point the descent could not have known.
--
-- Why the return side can decide it: the leaf reached by following `k`'s bits sits in the branch matching `k` at every fork on the path, so it agrees with `k` at every crit there, and `c = crit(k, k0)` is therefore never equal to a path crit. Crits increase strictly downward, so the wedge point — the shallowest fork whose crit exceeds `c` — is the child of the *deepest* fork whose crit is below `c`, and climbing from the leaf reaches that fork before any other with a crit below `c`. A fork still pending returns its own node untouched, so nothing above the wedge point is rebuilt and nothing below it was.
--
-- This was the retired map-wall campaign's step 3, held back there because the qp reshape would have replaced the crit descent outright. That reshape was built, measured and declined, so nothing supersedes it any more.
let insert1(@V: Type, t: Node(V), k: Bytes, v: V) -> {Node(V), Nat, Nat} =
    match t
    | leaf(k0, v0) =>
        match Bytes/eql(k0, k)
        | true => (Node/leaf(k, v), 0, 2)
        | false => (Node/leaf(k0, v0), crit(k, k0), 1)
        end
    | fork(tc, z, o) =>
        match bit(k, tc)
        | 0 =>
            let (z2, c, st) = insert1(z, k, v);
            match st
            | 1 =>
                match tc < c
                | true => (Node/fork(tc, wedge(c, bit(k, c), k, v, z2), o), 0, 0)
                | false => (t, c, 1)
                end
            | _ => (Node/fork(tc, z2, o), 0, st)
            end
        | _ =>
            let (o2, c, st) = insert1(o, k, v);
            match st
            | 1 =>
                match tc < c
                | true => (Node/fork(tc, z, wedge(c, bit(k, c), k, v, o2)), 0, 0)
                | false => (t, c, 1)
                end
            | _ => (Node/fork(tc, z, o2), 0, st)
            end
        end
    end;

-- The same single descent for removal, over three states: 0 unchanged, 1 removed, 2 emptied. A fork whose child emptied answers its other child, which is the collapse that keeps the shape canonical; `emptied` reaching the root means the map held exactly this one entry. The node answered alongside `emptied` is the untouched original and is never read.
let remove1(@V: Type, t: Node(V), k: Bytes) -> {Node(V), Nat} =
    match t
    | leaf(k0, v0) => match Bytes/eql(k0, k) | true => (t, 2) | false => (t, 0) end
    | fork(c, z, o) =>
        match bit(k, c)
        | 0 =>
            let (z2, st) = remove1(z, k);
            match st | 2 => (o, 1) | 1 => (Node/fork(c, z2, o), 1) | _ => (t, 0) end
        | _ =>
            let (o2, st) = remove1(o, k);
            match st | 2 => (z, 1) | 1 => (Node/fork(c, z, o2), 1) | _ => (t, 0) end
        end
    end;

pub let empty(@V: Type) -> Map(V) =
    Map { size = 0, root = Option/none() };

pub let len(@V: Type, m: Map(V)) -> Nat =
    m.size;

pub let get(@K: Type, @V: Type, use Key(K), m: Map(V), key: K) -> Option(V) =
    let k = Key/to_bytes(key);
    match m.root
    | none() => Option/none()
    | some(n) =>
        let (k0, v0) = lookup(n, k);
        match Bytes/eql(k0, k) | true => Option/some(v0) | false => Option/none() end
    end;

pub let has(@K: Type, @V: Type, use Key(K), m: Map(V), key: K) -> Bool =
    Option/is_some(get(m, key));

pub let insert(@K: Type, @V: Type, use Key(K), m: Map(V), key: K, v: V) -> Map(V) =
    let k = Key/to_bytes(key);
    match m.root
    | none() => Map { size = 1, root = Option/some(Node/leaf(k, v)) }
    | some(n) =>
        let (n2, c, st) = insert1(n, k, v);
        match st
        | 2 => Map { size = m.size, root = Option/some(n2) }
        | 1 => Map { size = m.size + 1, root = Option/some(wedge(c, bit(k, c), k, v, n2)) }
        | _ => Map { size = m.size + 1, root = Option/some(n2) }
        end
    end;

pub let remove(@K: Type, @V: Type, use Key(K), m: Map(V), key: K) -> Map(V) =
    let k = Key/to_bytes(key);
    match m.root
    | none() => m
    | some(n) =>
        let (n2, st) = remove1(n, k);
        match st
        | 2 => Map { size = m.size - 1, root = Option/none() }
        | 1 => Map { size = m.size - 1, root = Option/some(n2) }
        | _ => m
        end
    end;

pub let fold(@V: Type, @A: Type, m: Map(V), init: A, f: (Bytes, V, A) -> A) -> A =
    match m.root
    | none() => init
    | some(n) =>
        let go(t: Node(V), acc: A) -> A =
            match t | leaf(k, v) => f(k, v, acc) | fork(c, z, o) => go(o, go(z, acc)) end;
        go(n, init)
    end;

pub let entries(@V: Type, m: Map(V)) -> List({Bytes, V}) =
    fold(m, [], (k, v, acc) => [..acc, (k, v)]);

pub let keys(@V: Type, m: Map(V)) -> List(Bytes) =
    fold(m, [], (k, _, acc) => [..acc, k]);

pub let values(@V: Type, m: Map(V)) -> List(V) =
    fold(m, [], (_, v, acc) => [..acc, v]);

pub let of(@K: Type, @V: Type, use Key(K), l: List({K, V})) -> Map(V) =
    List/fold(l, empty(), ((k, v), acc) => insert(acc, k, v));

pub let get_or(@K: Type, @V: Type, use Key(K), m: Map(V), key: K, default: V) -> V =
    Option/unwrap_or(get(m, key), default);

-- The one rewriting entry point: `f` sees the current value or `none`, and answers the value to keep or `none` to remove.
pub let update(
    @K: Type,
    @V: Type,
    use Key(K),
    m: Map(V),
    key: K,
    f: (Option(V)) -> Option(V),
) -> Map(V) =
    match f(get(m, key)) | some(v) => insert(m, key, v) | none() => remove(m, key) end;

-- Over the values alone: the keys are the trie's and stay where they are, so the shape is rebuilt node for node.
let map_node(@V: Type, @W: Type, t: Node(V), f: (V) -> W) -> Node(W) =
    match t
    | leaf(k, v) => Node/leaf(k, f(v))
    | fork(c, z, o) => Node/fork(c, map_node(z, f), map_node(o, f))
    end;

pub let map(@V: Type, @W: Type, m: Map(V), f: (V) -> W) -> Map(W) =
    Map { size = m.size, root = Option/map(m.root, (n: Node(V)) => map_node(n, f)) };

-- Rebuilt entry by entry, since a removed leaf collapses its fork and a filtered shape is easier to rebuild than to repair.
pub let filter(@V: Type, m: Map(V), pred: (Bytes, V) -> Bool) -> Map(V) =
    fold(
        m,
        empty(),
        (k, v, acc) => match pred(k, v) | true => insert(acc, k, v) | false => acc end);

-- Right-biased: an entry of `b` replaces `a`'s under the same key.
pub let union(@V: Type, a: Map(V), b: Map(V)) -> Map(V) =
    fold(b, a, (k, v, acc) => insert(acc, k, v));

-- Entry lists compared pairwise through the value witness alone. Going through `Equal(List({Bytes, V}))` instantiates the tuple witness at a second universe instance of `V`, which the kernel refuses to identify with the premise's; the direct walk asks the premise itself.
let same_entries(@V: Type, use Equal(V), xs: List({Bytes, V}), ys: List({Bytes, V})) -> Bool =
    match xs
    | [] => match ys | [] => true | _ => false end
    | [x, ..xt] =>
        match ys
        | [] => false
        | [y, ..yt] => Bytes/eql(x.0, y.0) && x.1 == y.1 && same_entries(xt, yt)
        end
    end;

-- The trie is canonical, so two maps are equal exactly when their entries are; the keys compared and shown are the `Bytes` the trie holds.
satisfy (@V: Type, use Equal(V)) => Equal(Map(V)) {
    eql(a, b) = same_entries(entries(a), entries(b)),
    neq(a, b) = Bool/not(same_entries(entries(a), entries(b))),
}

satisfy (@V: Type, use Show(V)) => Show(Map(V)) {
    show(m) =
        Str/flatten(
            [
                "{",
                Str/join(
                    ", ",
                    List/map(
                        entries(m),
                        ((k, v)) => Str/flatten([Show/show(k), ": ", Show/show(v)]))),
                "}"]),
}
