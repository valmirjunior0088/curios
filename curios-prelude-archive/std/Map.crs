-- A crit-bit (Patricia) trie keyed on the byte string a `Key` witness produces. The map deliberately does not remember `K`: the trie's identity *is* that byte string, so two key types serializing alike are the same key. `Key` is therefore a write-side injection only — `entries`, `keys`, and `fold` hand back `Bytes`, and a caller wanting typed keys decodes at the boundary.
use /std/{Bytes, Byte, Nat, Bool, Str, List, Option, Eq};

induct Node(V: Type): Type
| leaf(key: Bytes, value: V)
| fork(crit: Nat, zero: Node(V), one: Node(V))
end

pub struct Map(V: Type): Type {
    size: Nat,
    root: Option(Node(V)),
}

-- The trie's identity is the byte string, so a `to_bin` that collides silently merges two keys into one entry. `injective` is that obligation stated where it can be checked: a witness cannot register without proving its own encoding distinguishes what the key type distinguishes.
pub concept Key(K: Type): pub Type {
    to_bin(K) -> Bytes,
    injective(a: K, b: K, same: Eq(to_bin(a), to_bin(b))) -> Eq(a, b),
}

satisfy Key(Bytes) {
    to_bin(b) = b,
    -- The identity encoding: the goal reduces to the hypothesis.
    injective(a, b, same) = same,
}

satisfy Key(Str) {
    to_bin = Str/to_bytes,
    injective(a, b, same) = Str/eq_of_bytes(a, b, same),
}

-- No `Key(Nat)`. Its base-256 encoding recursed on `x / 256`, and intrinsic `Nat` eliminates only by unary successor, so no induction principle reaches that recursion: the injectivity is unprovable with or without the division reduction laws.
--
-- Rocq's answer is not to encode into a binary representation but to *work* in one — `positive` is this library's `NonZero` and `N` its `BigNat` — where digit injectivity comes from the representation rather than from arithmetic. Its bridge from unary `nat` is proved by successor (`Pos.of_nat (S n) = Pos.succ (Pos.of_nat n)`), which is affordable exactly because that bridge is only ever needed inside proofs. Agda and Lean instead give the digit expansion its own well-founded or fuel-based recursion, and neither form exists here.
--
-- So a caller wanting numeric keys encodes them at the boundary, and a future `Key` for a binary carrier is the shape worth building.

let bit(k: Bytes, j: Nat) -> Nat =
    let g = j / 9;
    let o = j % 9;
    choose
    | g >= Bytes/len(k) => 0
    | o == 0 => 1
    | _ => Nat/and(Nat/shr(Byte/to_nat(/sys/Bytes/get(k, g)), 8 - o), 1)
    end;

let crit(a: Bytes, b: Bytes) -> Nat =
    rec bits(x: Nat, y: Nat, g: Nat, o: Nat) -> Nat =
        match Nat/and(Nat/shr(x, 8 - o), 1) == Nat/and(Nat/shr(y, 8 - o), 1)
        | true => bits(x, y, g, o + 1)
        | false => g * 9 + o
        end;
    rec bytes(g: Nat) -> Nat =
        match g < Bytes/len(a) && g < Bytes/len(b)
        | true =>
            let x = Byte/to_nat(/sys/Bytes/get(a, g));
            let y = Byte/to_nat(/sys/Bytes/get(b, g));
            match x == y | true => bytes(g + 1) | false => bits(x, y, g, 1) end
        | false => g * 9
        end;
    bytes(0);

rec lookup(@V: Type, t: Node(V), k: Bytes) -> {Bytes, V} =
    match t
    | leaf(k0, v0) => (k0, v0)
    | fork(c, z, o) => match bit(k, c) | 0 => lookup(z, k) | _ => lookup(o, k) end
    end;

rec replace(@V: Type, t: Node(V), k: Bytes, v: V) -> Node(V) =
    match t
    | leaf(k0, v0) => Node/leaf(k, v)
    | fork(c, z, o) =>
        match bit(k, c)
        | 0 => Node/fork(c, replace(z, k, v), o)
        | _ => Node/fork(c, z, replace(o, k, v))
        end
    end;

let wedge(@V: Type, c: Nat, b: Nat, k: Bytes, v: V, t: Node(V)) -> Node(V) =
    match b | 0 => Node/fork(c, Node/leaf(k, v), t) | _ => Node/fork(c, t, Node/leaf(k, v)) end;

rec insert_node(@V: Type, t: Node(V), c: Nat, b: Nat, k: Bytes, v: V) -> Node(V) =
    match t
    | leaf(k0, v0) => wedge(c, b, k, v, Node/leaf(k0, v0))
    | fork(tc, z, o) =>
        match tc < c
        | true =>
            match bit(k, tc)
            | 0 => Node/fork(tc, insert_node(z, c, b, k, v), o)
            | _ => Node/fork(tc, z, insert_node(o, c, b, k, v))
            end
        | false => wedge(c, b, k, v, Node/fork(tc, z, o))
        end
    end;

rec remove_node(@V: Type, t: Node(V), k: Bytes) -> Option(Node(V)) =
    match t
    | leaf(k0, v0) => Option/none()
    | fork(c, z, o) =>
        match bit(k, c)
        | 0 =>
            match remove_node(z, k)
            | none() => Option/some(o)
            | some(z2) => Option/some(Node/fork(c, z2, o))
            end
        | _ =>
            match remove_node(o, k)
            | none() => Option/some(z)
            | some(o2) => Option/some(Node/fork(c, z, o2))
            end
        end
    end;

pub let empty(@V: Type) -> Map(V) =
    Map { size = 0, root = Option/none() };

pub let len(@V: Type, m: Map(V)) -> Nat =
    m.size;

pub let get(@K: Type, @V: Type, use Key(K), m: Map(V), key: K) -> Option(V) =
    let k = Key/to_bin(key);
    match m.root
    | none() => Option/none()
    | some(n) =>
        let (k0, v0) = lookup(n, k);
        match Bytes/eql(k0, k) | true => Option/some(v0) | false => Option/none() end
    end;

pub let has(@K: Type, @V: Type, use Key(K), m: Map(V), key: K) -> Bool =
    Option/is_some(get(m, key));

pub let insert(@K: Type, @V: Type, use Key(K), m: Map(V), key: K, v: V) -> Map(V) =
    let k = Key/to_bin(key);
    match m.root
    | none() => Map { size = 1, root = Option/some(Node/leaf(k, v)) }
    | some(n) =>
        let (k0, _) = lookup(n, k);
        match Bytes/eql(k0, k)
        | true => Map { size = m.size, root = Option/some(replace(n, k, v)) }
        | false =>
            let c = crit(k, k0);
            Map { size = m.size + 1, root = Option/some(insert_node(n, c, bit(k, c), k, v)) }
        end
    end;

pub let remove(@K: Type, @V: Type, use Key(K), m: Map(V), key: K) -> Map(V) =
    let k = Key/to_bin(key);
    match m.root
    | none() => m
    | some(n) =>
        let (k0, _) = lookup(n, k);
        match Bytes/eql(k0, k)
        | true => Map { size = m.size - 1, root = remove_node(n, k) }
        | false => m
        end
    end;

pub let fold(@V: Type, @A: Type, m: Map(V), init: A, f: (Bytes, V, A) -> A) -> A =
    match m.root
    | none() => init
    | some(n) =>
        rec go(t: Node(V), acc: A) -> A =
            match t | leaf(k, v) => f(k, v, acc) | fork(c, z, o) => go(o, go(z, acc)) end;
        go(n, init)
    end;

pub let entries(@V: Type, m: Map(V)) -> List({Bytes, V}) =
    fold(m, [], (k, v, acc) => [..acc, (k, v)]);

pub let keys(@V: Type, m: Map(V)) -> List(Bytes) =
    fold(m, [], (k, _, acc) => [..acc, k]);

pub let values(@V: Type, m: Map(V)) -> List(V) =
    fold(m, [], (_, v, acc) => [..acc, v]);

pub let of(@K: Type, @V: Type, use Key(K), l: List({K, V})) -> Map(V) =
    List/fold(l, empty(), ((k, v), acc) => insert(acc, k, v));
