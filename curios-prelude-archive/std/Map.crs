use /std/{Bytes, Byte, Nat, Bool, Str, List, Option, Eq, Equal, Show, Spell};

induct Node(V: Type): Type
| leaf(key: Bytes, value: V)
| fork(crit: Nat, zero: Node(V), one: Node(V))
end

-- | A map from encoded keys to values.
pub struct Map(V: Type): Type {
    size: Nat,
    root: Option(Node(V)),
}

-- | How a key type encodes to the byte string that identifies it.
pub concept Key(K: Type): pub Type {
    -- | The encoding.
    to_bytes(K) -> Bytes,
    -- | Distinct keys encode distinctly.
    injective(a: K, b: K, same: Eq(to_bytes(a), to_bytes(b))) -> Eq(a, b),
}

-- | The identity encoding.
satisfy Key(Bytes) {
    to_bytes(b) = b,
    injective(_a, _b, same) = same,
}

-- | The UTF-8 bytes.
satisfy Key(Str) {
    to_bytes = Str/to_bytes,
    injective(a, b, same) = Str/eq_of_bytes(a, b, same),
}

let bit(k: Bytes, j: Nat) -> Nat =
    let g = j / 9;
    let o = j % 9;
    match g < Bytes/len(k)
    | false => 0
    | true =>
        match o == 0
        | true => 1
        | false => Nat/and(Nat/shr(Byte/to_nat(Bytes/get(k, g)), 8 - o), 1)
        end
    end;

let crit(a: Bytes, b: Bytes) -> Nat =
    let bits(x: Nat, y: Nat, g: Nat, o: Nat) -> Nat =
        match Nat/and(Nat/shr(x, 8 - o), 1) == Nat/and(Nat/shr(y, 8 - o), 1)
        | true => bits(x, y, g, o + 1)
        | false => g * 9 + o
        end;
    let bytes(g: Nat) -> Nat =
        match g < Bytes/len(a)
        | false => g * 9
        | true =>
            match g < Bytes/len(b)
            | false => g * 9
            | true =>
                let x = Byte/to_nat(Bytes/get(a, g));
                let y = Byte/to_nat(Bytes/get(b, g));
                match x == y | true => bytes(g + 1) | false => bits(x, y, g, 1) end
            end
        end;
    bytes(0);

let lookup(@V: Type, t: Node(V), k: Bytes) -> {Bytes, V} =
    match t
    | leaf(k0, v0) => (k0, v0)
    | fork(c, z, o) => match bit(k, c) | 0 => lookup(z, k) | _ => lookup(o, k) end
    end;

let wedge(@V: Type, c: Nat, b: Nat, k: Bytes, v: V, t: Node(V)) -> Node(V) =
    match b | 0 => Node/fork(c, Node/leaf(k, v), t) | _ => Node/fork(c, t, Node/leaf(k, v)) end;

let insert1(@V: Type, t: Node(V), k: Bytes, v: V) -> {Node(V), Nat, Nat} =
    match t
    | leaf(k0, v0) =>
        match Bytes/eql(k0, k)
        | true => (Node/leaf(k, v), 0, 2)
        | false => (Node/leaf(k0, v0), crit(k, k0), 1)
        end
    | fork(tc, z, o) =>
        match bit(k, tc)
        | 0 =>
            let (z2, c, st) = insert1(z, k, v);
            match st
            | 1 =>
                match tc < c
                | true => (Node/fork(tc, wedge(c, bit(k, c), k, v, z2), o), 0, 0)
                | false => (t, c, 1)
                end
            | _ => (Node/fork(tc, z2, o), 0, st)
            end
        | _ =>
            let (o2, c, st) = insert1(o, k, v);
            match st
            | 1 =>
                match tc < c
                | true => (Node/fork(tc, z, wedge(c, bit(k, c), k, v, o2)), 0, 0)
                | false => (t, c, 1)
                end
            | _ => (Node/fork(tc, z, o2), 0, st)
            end
        end
    end;

let remove1(@V: Type, t: Node(V), k: Bytes) -> {Node(V), Nat} =
    match t
    | leaf(k0, _v0) => match Bytes/eql(k0, k) | true => (t, 2) | false => (t, 0) end
    | fork(c, z, o) =>
        match bit(k, c)
        | 0 =>
            let (z2, st) = remove1(z, k);
            match st | 2 => (o, 1) | 1 => (Node/fork(c, z2, o), 1) | _ => (t, 0) end
        | _ =>
            let (o2, st) = remove1(o, k);
            match st | 2 => (z, 1) | 1 => (Node/fork(c, z, o2), 1) | _ => (t, 0) end
        end
    end;

-- | The empty map.
pub let empty(@V: Type) -> Map(V) =
    Map { size = 0, root = Option/none() };

-- | How many entries.
pub let len(@V: Type, m: Map(V)) -> Nat =
    m.size;

-- | The value at `key`, or `none`.
pub let get(@K: Type, @V: Type, use Key(K), m: Map(V), key: K) -> Option(V) =
    let k = Key/to_bytes(key);
    match m.root
    | none() => Option/none()
    | some(n) =>
        let (k0, v0) = lookup(n, k);
        match Bytes/eql(k0, k) | true => Option/some(v0) | false => Option/none() end
    end;

-- | Whether `key` has an entry.
pub let has(@K: Type, @V: Type, use Key(K), m: Map(V), key: K) -> Bool =
    Option/is_some(get(m, key));

-- | `m` with `key` at `v`, replacing an entry under the same key.
pub let insert(@K: Type, @V: Type, use Key(K), m: Map(V), key: K, v: V) -> Map(V) =
    let k = Key/to_bytes(key);
    match m.root
    | none() => Map { size = 1, root = Option/some(Node/leaf(k, v)) }
    | some(n) =>
        let (n2, c, st) = insert1(n, k, v);
        match st
        | 2 => Map { size = m.size, root = Option/some(n2) }
        | 1 => Map { size = m.size + 1, root = Option/some(wedge(c, bit(k, c), k, v, n2)) }
        | _ => Map { size = m.size + 1, root = Option/some(n2) }
        end
    end;

-- | `m` without `key`; unchanged when absent.
pub let remove(@K: Type, @V: Type, use Key(K), m: Map(V), key: K) -> Map(V) =
    let k = Key/to_bytes(key);
    match m.root
    | none() => m
    | some(n) =>
        let (n2, st) = remove1(n, k);
        match st
        | 2 => Map { size = m.size - 1, root = Option/none() }
        | 1 => Map { size = m.size - 1, root = Option/some(n2) }
        | _ => m
        end
    end;

-- | Over the entries in key order with `f(key, value, acc)`, the keys as encoded.
pub let fold(@V: Type, @A: Type, m: Map(V), init: A, f: (Bytes, V, A) -> A) -> A =
    match m.root
    | none() => init
    | some(n) =>
        let go(t: Node(V), acc: A) -> A =
            match t | leaf(k, v) => f(k, v, acc) | fork(_c, z, o) => go(o, go(z, acc)) end;
        go(n, init)
    end;

-- | The entries in key order, the keys as encoded.
pub let entries(@V: Type, m: Map(V)) -> List({Bytes, V}) =
    fold(m, [], (k, v, acc) => [..acc, (k, v)]);

-- | The keys in order, as encoded.
pub let keys(@V: Type, m: Map(V)) -> List(Bytes) =
    fold(m, [], (k, _, acc) => [..acc, k]);

-- | The values in key order.
pub let values(@V: Type, m: Map(V)) -> List(V) =
    fold(m, [], (_, v, acc) => [..acc, v]);

-- | The map of the pairs, a later pair replacing an earlier one under the same key.
pub let of(@K: Type, @V: Type, use Key(K), l: List({K, V})) -> Map(V) =
    List/fold(l, empty(), ((k, v), acc) => insert(acc, k, v));

-- | The value at `key`, or `default`.
pub let get_or(@K: Type, @V: Type, use Key(K), m: Map(V), key: K, default: V) -> V =
    Option/unwrap_or(get(m, key), default);

-- | The entry at `key` rewritten by `f`, which sees the current value or `none` and answers the value to keep or `none` to remove.
pub let update(
    @K: Type,
    @V: Type,
    use Key(K),
    m: Map(V),
    key: K,
    f: (Option(V)) -> Option(V),
) -> Map(V) =
    match f(get(m, key)) | some(v) => insert(m, key, v) | none() => remove(m, key) end;

let map_node(@V: Type, @W: Type, t: Node(V), f: (V) -> W) -> Node(W) =
    match t
    | leaf(k, v) => Node/leaf(k, f(v))
    | fork(c, z, o) => Node/fork(c, map_node(z, f), map_node(o, f))
    end;

-- | `f` on every value.
pub let map(@V: Type, @W: Type, m: Map(V), f: (V) -> W) -> Map(W) =
    Map { size = m.size, root = Option/map(m.root, (n: Node(V)) => map_node(n, f)) };

-- | The entries `pred` accepts.
pub let filter(@V: Type, m: Map(V), pred: (Bytes, V) -> Bool) -> Map(V) =
    fold(
        m,
        empty(),
        (k, v, acc) => match pred(k, v) | true => insert(acc, k, v) | false => acc end);

-- | Every entry of either, `b`'s winning under a shared key.
pub let union(@V: Type, a: Map(V), b: Map(V)) -> Map(V) =
    fold(b, a, (k, v, acc) => insert(acc, k, v));

let same_entries(@V: Type, use Equal(V), xs: List({Bytes, V}), ys: List({Bytes, V})) -> Bool =
    match xs
    | [] => match ys | [] => true | _ => false end
    | [x, ..xt] =>
        match ys
        | [] => false
        | [y, ..yt] => Bytes/eql(x.0, y.0) && x.1 == y.1 && same_entries(xt, yt)
        end
    end;

-- | Entry by entry.
satisfy (@V: Type, use Equal(V)) => Equal(Map(V)) {
    eql(a, b) = same_entries(entries(a), entries(b)),
    neq(a, b) = Bool/not(same_entries(entries(a), entries(b))),
}

satisfy (@V: Type, use Show(V)) => Show(Map(V)) {
    show(m) =
        Str/flatten(
            [
                "{",
                Str/join(
                    ", ",
                    List/map(
                        entries(m),
                        ((k, v)) => Str/flatten([Show/show(k), ": ", Show/show(v)]))),
                "}"]),
}

-- | As `Map/of` over the encoded keys.
satisfy (@V: Type, use Spell(V)) => Spell(Map(V)) {
    spell(m) =
        Str/flatten(
            [
                "Map/of([",
                Str/join(
                    ", ",
                    List/map(
                        entries(m),
                        ((k, v)) => Str/flatten(["(", Spell/spell(k), ", ", Spell/spell(v), ")"]))),
                "])"]),
}
