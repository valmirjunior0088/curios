pub use /sys/{Io};
pub use /sys/Io/{pure, bind};
use /std/{Monad, Lift, Bytes, Byte, Nat, Option, Result, Async, Handle};

-- | The failure every host operation reports.
pub mod Error;
pub use Error/{let Error};

satisfy Monad(Io) {
    pure = pure,
    bind = bind,
}

-- | The identity edge, for a witness whose premise is `Lift(Io, M)` at `M = Io`.
satisfy Lift(Io, Io) {
    lift(@_A, m) = m,
}

-- | What one read answers with.
pub mod Chunk;
pub use Chunk/{let Chunk};

-- | An input stream of this process.
pub struct Input: Type {
    Handle,
}

-- | An output stream of this process.
pub struct Output: Type {
    Handle,
}

-- | Standard input.
pub let stdin: Input =
    Input { Handle/stdin };

-- | Standard output.
pub let stdout: Output =
    Output { Handle/stdout };

-- | Standard error.
pub let stderr: Output =
    Output { Handle/stderr };

-- | Up to `n` bytes, waited for on this program's own behalf. Inside a fiber, `Async/Read`'s `read` parks instead.
pub let read(i: Input, n: Nat) -> Io(Chunk) =
    Async/Read/read(i.0, n);

-- | One line without its newline, `none` at the end of the input. An error ends the input as the end does, and what was read before it is still the line.
pub let read_line(i: Input) -> Io(Option(Bytes)) =
    let go(acc: Bytes) -> Io(Option(Bytes)) =
        let c = read(i, 1)!;
        match c
        | chunk(b) =>
            match Byte/to_nat(Option/unwrap_or(Bytes/try_get(b, 0), 0)) == 0xA
            | true => Io/pure(Option/some(acc))
            | false => go(x[..acc, ..b])
            end
        | _ =>
            Io/pure(
                match Bytes/len(acc) == 0 | true => Option/none() | false => Option/some(acc) end)
        end;
    go(x[]);

-- | The whole of `b`, a short write resent; the first failure is the answer.
let written(o: Output, b: Bytes) -> Io(Result(Error, {})) =
    Async/Write/write(o.0, b);

-- | The whole of `b`, a short write resent and a failure dropped.
pub let write(o: Output, b: Bytes) -> Io({}) =
    Io/bind(written(o, b), (_) => Io/pure(()));

satisfy Async/Read(Io, Input) {
    read(i, n) = read(i, n),
}

satisfy Async/Read(Async, Input) {
    read(i, n) = Async/Read/read(i.0, n),
}

satisfy Async/Write(Io, Output) {
    write(o, b) = written(o, b),
}

satisfy Async/Write(Async, Output) {
    write(o, b) = Async/Write/write(o.0, b),
}
