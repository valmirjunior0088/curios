use /std/{Nat, Bool, Option, Eq};
use /std/Nat/{Le, Lt};

--- `n <= n`.
pub let refl(n: Nat) -> Le(n, n) =
    Bool/True/qed();

--- `a <= b` gives `a <= b + 1`.
pub let succ_r(a: Nat, b: Nat, p: Le(a, b)) -> Le(a, b + 1) =
    match a
    | 0 => Bool/True/qed()
    | ap + 1 =>
        match b
        | 0 => match p end
        | bp + 1 => succ_r(ap, bp, p)
        end
    end;

--- `a <= a + k`.
pub let add_r(a: Nat, k: Nat) -> Le(a, a + k) =
    Bool/True/qed();

--- The procedure that decides `a <= b`: the evidence when it holds, `none` otherwise.
pub let try(a: Nat, b: Nat) -> Option(Le(a, b)) =
    match a <= b: (r) => Option(Bool/Holds(r))
    | true => Option/some(Bool/True/qed())
    | false => Option/none()
    end;

--- `0 < n` gives `1 <= n`.
pub let one_of_positive(@n: Nat, p: Lt(0, n)) -> Le(1, n) =
    match n
    | 0 => match p end
    | _ + 1 => Bool/True/qed()
    end;

--- `a < b` gives `a <= b`.
pub let of_lt(a: Nat, b: Nat, p: Lt(a, b)) -> Le(a, b) =
    match a
    | 0 => Bool/True/qed()
    | ap + 1 =>
        match b
        | 0 => match p end
        | bp + 1 => of_lt(ap, bp, p)
        end
    end;

--- A comparison that came back `false` is the other one: `a < b` failing gives `b <= a`.
---
--- The decided pair is total, so refuting one settles the other — but only a proof can say so, because reduction reads terms and a guard's `false` arm is a fact about the scope. This is the bridge out of such an arm, where `Bool/True/qed()` inhabits the hypothesis and the conclusion is what the arm actually needed.
pub let of_not_lt(a: Nat, b: Nat, p: Bool/Holds(Bool/not(a < b))) -> Le(b, a) =
    match a
    | 0 =>
        match b
        | 0 => Bool/True/qed()
        | _ + 1 => match p end
        end
    | ap + 1 => match b | 0 => Bool/True/qed() | bp + 1 => of_not_lt(ap, bp, p) end
    end;

--- An equation's bound: `a = b` gives `a <= b`.
pub let of_eq(@a: Nat, @b: Nat, e: Eq()(a, b)) -> Le(a, b) =
    Eq/subst((x: Nat) => Le(a, x), e, refl(a));

--- Transitivity.
pub let trans(@a: Nat, @b: Nat, @c: Nat, p: Le(a, b), q: Le(b, c)) -> Le(a, c) =
    match a
    | 0 => Bool/True/qed()
    | ap + 1 =>
        match b
        | 0 => match p end
        | bp + 1 =>
            match c
            | 0 => match q end
            | cp + 1 => trans(@ap, @bp, @cp, p, q)
            end
        end
    end;

--- `a <= b` gives `n + a <= n + b`.
pub let add_mono_l(n: Nat, @a: Nat, @b: Nat, p: Le(a, b)) -> Le(n + a, n + b) =
    p;

--- `a <= b` and `c <= d` give `a + c <= b + d`: two bounds added side by side.
---
--- The step a proof the elaborator writes from the facts in scope is summed with, one fact at a time. It is [`trans`] alone, because `a + c <= b + c` cancels to `a <= b` and `b + c <= b + d` to `c <= d`.
pub let add(@a: Nat, @b: Nat, @c: Nat, @d: Nat, p: Le(a, b), q: Le(c, d)) -> Le(a + c, b + d) =
    trans(@a + c, @b + c, @b + d, p, q);

--- `a <= b` gives `a * k <= b * k`.
---
--- The successor case is one application of [`add_mono_l`]: `(a + 1) * k` is `k + a * k`, which is what that step has to produce.
pub let mul_mono_r(@a: Nat, @b: Nat, k: Nat, p: Le(a, b)) -> Le(a * k, b * k) =
    match a
    | 0 => Bool/True/qed()
    | ap + 1 =>
        match b
        | 0 => match p end
        | bp + 1 => add_mono_l(k, mul_mono_r(@ap, @bp, k, p))
        end
    end;

--- `a <= b` gives `a - k <= b - k`: `Nat` subtraction truncates, and truncating both sides by one amount keeps their order. It is the bound a digit `x - lo` takes from `x <= hi`, which needs no `lo <= x`; that half is what makes `x - lo` the digit rather than a truncation, through [`add_sub_cancel`].
pub let sub_mono_r(@a: Nat, @b: Nat, k: Nat, p: Le(a, b)) -> Le(a - k, b - k) =
    match k
    | 0 => p
    | kp + 1 =>
        match a
        | 0 => Bool/True/qed()
        | ap + 1 =>
            match b
            | 0 => match p end
            | bp + 1 => sub_mono_r(@ap, @bp, kp, p)
            end
        end
    end;

--- `n - k <= n`: `Nat` subtraction never grows what it takes from.
pub let sub_le(n: Nat, k: Nat) -> Le(n - k, n) =
    match k
    | 0 => refl(n)
    | kp + 1 => match n | 0 => Bool/True/qed() | np + 1 => succ_r(np - kp, np, sub_le(np, kp)) end
    end;

--- A decided range check as its two bounds: `in_range(c, lo, hi)` gives `lo <= c` and `c <= hi`.
pub let of_in_range(
    c: Nat,
    lo: Nat,
    hi: Nat,
    h: Bool/Holds(Nat/in_range(c, lo, hi)),
) -> {low: Le(lo, c), high: Le(c, hi)} =
    match c >= lo
    | true => (low = Bool/True/qed(), high = h)
    | false => match h end
    end;

--- Two bounds facing a value as the range check they make: `of_in_range` read backwards.
pub let to_in_range(
    c: Nat,
    lo: Nat,
    hi: Nat,
    low: Le(lo, c),
    high: Le(c, hi),
) -> Bool/Holds(Nat/in_range(c, lo, hi)) =
    match c >= lo
    | true => high
    | false => match low end
    end;

--- Two bounds facing each other pin one value.
pub let antisym(a: Nat, b: Nat, p: Le(a, b), q: Le(b, a)) -> Eq()(a, b) =
    match a
    | 0 =>
        match b
        | 0 => Eq/refl()
        | _ + 1 => match q end
        end
    | ap + 1 =>
        match b
        | 0 => match p end
        | bp + 1 => Eq/cong((x) => x + 1, antisym(ap, bp, p, q))
        end
    end;

--- `a + (b - a) = b` under `a <= b`, which is what makes it true, since `Nat` subtraction truncates.
pub let add_sub_cancel(a: Nat, b: Nat, p: Le(a, b)) -> Eq()(a + (b - a), b) =
    match a
    | 0 => Eq/refl()
    | ap + 1 =>
        match b
        | 0 => match p end
        | bp + 1 => Eq/cong((x) => x + 1, add_sub_cancel(ap, bp, p))
        end
    end;

--- `a <= b` gives `a - b <= 0`: `Nat` subtraction truncates where it would go below zero.
---
--- The case [`add_sub_cancel`] leaves out, where `a - b` is no difference: a proof the elaborator writes over a truncated subtraction splits on `b <= a` and takes this in the arm where that fails. Conversion does not decide it there, since the arm's guard is a fact about the scope and reduction reads terms.
pub let sub_zero(a: Nat, b: Nat, p: Le(a, b)) -> Le(a - b, 0) =
    match a
    | 0 => Bool/True/qed()
    | ap + 1 =>
        match b
        | 0 => match p end
        | bp + 1 => sub_zero(ap, bp, p)
        end
    end;
