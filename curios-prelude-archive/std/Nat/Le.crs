pub use /syn/Nat/{Le};
use /std/{Nat, Option, True, False, Eq};

-- | `a <= b` as an inductive proposition: `z` proves `0 <= n` and `s` lifts `a <= b` to `a + 1 <= b + 1`, so a proof can recurse over the evidence.
pub mod Ind;
pub use Ind/{let Ind};

-- | `n <= n`.
pub let refl(n: Nat) -> Le(n, n) =
    True/qed();

-- | The inductive form as the decided one.
pub let of_ind(@a: Nat, @b: Nat, p: Ind(a, b)) -> Le(a, b) =
    match p: (x, y, _w) => Le(x, y) | z(@_) => True/qed() | s(@_, @_, prev) => of_ind(prev) end;

-- | The decided form as the inductive one.
pub let to_ind(a: Nat, b: Nat, p: Le(a, b)) -> Ind(a, b) =
    match a
    | 0 => Ind/z()
    | ap + 1 =>
        match b
        | 0 => match p end
        | bp + 1 => Ind/s(to_ind(ap, bp, p))
        end
    end;

-- | `a <= b` gives `a <= b + 1`.
pub let succ_r(a: Nat, b: Nat, p: Le(a, b)) -> Le(a, b + 1) =
    of_ind(Ind/succ_r(to_ind(a, b, p)));

-- | The procedure that decides `a <= b`: the evidence when it holds, `none` otherwise.
pub let try(a: Nat, b: Nat) -> Option(Le(a, b)) =
    match a <= b: (r) => Option(match r: (_) => Prop | true => True | false => False end)
    | true => Option/some(True/qed())
    | false => Option/none()
    end;

-- | Transitivity.
pub let trans(@a: Nat, @b: Nat, @c: Nat, p: Le(a, b), q: Le(b, c)) -> Le(a, c) =
    of_ind(Ind/trans(to_ind(a, b, p), to_ind(b, c, q)));

-- | `a + (b - a) = b` under `a <= b`, which is what makes it true, since `Nat` subtraction truncates.
pub let add_sub_cancel(a: Nat, b: Nat, p: Le(a, b)) -> Eq(a + (b - a), b) =
    match a
    | 0 => Eq/refl()
    | ap + 1 =>
        match b
        | 0 => match p end
        | bp + 1 => Eq/cong((x) => x + 1, add_sub_cancel(ap, bp, p))
        end
    end;
