-- `a < b` as a decided proposition: `True` when the machine comparison holds and `False` otherwise, so a proof reduces away on any concrete pair rather than being built constructor by constructor. `Nat/Lt` is the proposition, `Nat/Lt/try` decides it, and the remaining laws bridge it to `Nat/Lte`.
pub use /syn/Nat/{Lt};
use /std/{Nat, Option, True, False};
use /std/Nat/{Lte, Le};

pub let try(a: Nat, b: Nat) -> Option(Lt(a, b)) =
    match a < b: (r) => Option(match r: (_) => Prop | true => True | false => False end)
    | true => Option/some(True/qed())
    | false => Option/none()
    end;

-- `0 < n` and `1 <= n` are one fact, but the two decided propositions scrutinise different machine comparisons, and cancellation relates operands rather than operators — so neither reduces into the other. Casing on `n` settles it without induction: at zero the hypothesis is already `False`, and above it the shared successor cancels on both sides.
pub let le_one_of_positive(@n: Nat, p: Lt(0, n)) -> Nat/Le(1, n) =
    match n | 0 => match p end | pred + 1 => True/qed() end;

pub rec succ_of_lte(@a: Nat, @b: Nat, p: Lte(a, b)) -> Lt(a, b + 1) =
    match p: (x, y, w) => Lt(x, y + 1)
    | z(@_) => True/qed()
    | s(@_, @_, prev) => succ_of_lte(prev)
    end;

pub let of_lte_succ(@a: Nat, @b: Nat, p: Lte(a + 1, b)) -> Lt(a, b) =
    match p: (x, y, w) => Lt(x - 1, y) | s(@a2, @b2, prev) => succ_of_lte(prev) end;

-- The strict bound weakened into the inductive family, so a `<` guard can reach the laws that recurse over `Nat/Lte`. The zero case is immediate, the case where the bound has run out is `False` under the hypothesis, and the successor case is the hypothesis itself — `a + 1 < b + 1` and `a < b` are one term once the shared floor cancels.
pub rec lte_of_lt(a: Nat, b: Nat, p: Lt(a, b)) -> Lte(a, b) =
    match a
    | 0 => Lte/z()
    | ap + 1 =>
        match b
        | 0 => match p end
        | bp + 1 => Lte/s(lte_of_lt(ap, bp, p))
        end
    end;

-- `a < b` gives `a <= b`, through the inductive family both decided forms are related by.
pub let le_of_lt(a: Nat, b: Nat, p: Lt(a, b)) -> Nat/Le(a, b) =
    Le/of_lte(lte_of_lt(a, b, p));

-- `a < b` gives `a + 1 <= b`: the strict bound is exactly the non-strict one on the successor. Lived in `/std/Str/utf8` until the windows needed it too — a fact about `Nat`, homed with the rest of them.
pub rec lte_succ_of_lt(i: Nat, n: Nat, p: Lt(i, n)) -> Lte(i + 1, n) =
    match n
    | 0 => match p end
    | np + 1 =>
        match i | 0 => Lte/s(Lte/z()) | ip + 1 => Lte/s(lte_succ_of_lt(ip, np, p)) end
    end;

-- The same, decided: what a window opened just past a checked index demands.
pub let le_succ_of_lt(i: Nat, n: Nat, p: Lt(i, n)) -> Nat/Le(i + 1, n) =
    Le/of_lte(lte_succ_of_lt(i, n, p));
