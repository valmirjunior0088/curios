use /std/{Str, Equal};
use /std/Tui/{Style};

-- | One position on the screen.
pub struct Cell: pub Type {
    -- | The text shown: one column's worth, with any combining marks.
    symbol: Str,
    style: Style,
}

satisfy Equal(Cell);

-- | A space in the plain style.
pub let blank: Cell =
    Cell { symbol = " ", style = Style/plain };

-- | The second half of a double-width symbol: no text, so the renderer writes nothing for it.
pub let continuation: Cell =
    Cell { symbol = "", style = Style/plain };

-- | `s` in `style`. Nothing here checks that `s` is one column wide; `Frame/text` is where a string becomes cells.
pub let of_str(style: Style, s: Str) -> Cell =
    Cell { symbol = s, style = style };
