use /std/{Bool, Equal};
use /std/Tui/{Color};

-- | Two colours and six attributes. Every style is a struct update from `plain`.
pub struct Style: pub Type {
    fg: Color,
    bg: Color,
    bold: Bool,
    dim: Bool,
    italic: Bool,
    underline: Bool,
    reverse: Bool,
    strike: Bool,
}

satisfy Equal(Style);

-- | The terminal's default colours and no attribute.
pub let plain: Style =
    Style {
        fg = Color/default(),
        bg = Color/default(),
        bold = false,
        dim = false,
        italic = false,
        underline = false,
        reverse = false,
        strike = false,
    };
