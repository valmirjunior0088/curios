use /std/{Nat};
use /std/Tui/{Frame};

-- | The part of `frame` from `x`, `y` on, at `w` by `h`; a window past the edge shows blank.
pub let draw(
    @w0: Nat,
    @h0: Nat,
    frame: Frame(w0, h0),
    x: Nat,
    y: Nat,
    w: Nat,
    h: Nat,
) -> Frame(w, h) =
    Frame/fit(Frame/crop(frame, x, y).frame, w, h);
