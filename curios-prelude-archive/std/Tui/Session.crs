-- The effectful floor: the terminal taken and given back. `with` is the bracket — raw mode through `tty/with_raw_async`, then the alternate screen, the hidden cursor, bracketed paste and the kitty keyboard flag, each undone in reverse on the way out, whichever way the body ends — and `size`, `draw` and `read` are what a program with a loop of its own writes it over. `Tui/run` is one such program.
--
-- **A session remembers three things**, and nothing else touches the terminal: the bytes a chunk ended inside, so the next chunk completes them; the previous frame beside its size, so a draw is a diff; and the size last read, so a loop can ask for it without another `ioctl`. The previous frame is kept at the size it had, and a draw at the same size runs the diff at the shared type through `Frame/fit`, which is the identity there; a draw at a new size clears and writes the whole frame, since what the terminal shows after a resize is not the previous frame anyway.
use /std/{Nat, Bool, Str, Bytes, List, Option, Cell, Io, Try, Async, tty, stream, Equal};
use /std/time/{Duration};
use /std/Tui/{Frame, Event, input, render, ansi};

struct Held: Type {
    w: Nat,
    h: Nat,
    frame: Frame(w, h),
}

pub struct Session: Type {
    rest: Cell(Bytes),
    previous: Cell(Option(Held)),
    size: Cell(tty/Size),
}

let enter: Io({}) =
    Io/write(
        Io/stdout,
        x[..ansi/alternate_on, ..ansi/cursor_hide, ..ansi/paste_on, ..ansi/kitty_push]);

let leave: Io({}) =
    Io/write(
        Io/stdout,
        x[..ansi/kitty_pop, ..ansi/paste_off, ..ansi/cursor_show, ..ansi/alternate_off]);

-- The bracket. Raw mode first, so a terminal that is not one fails here with `ENOTTY` before anything is written; the modes are switched inside it and released by `Async/using` on both scheduler exits, and raw mode after them.
pub let with(@A: Type, body: (Session) -> Try(Async, Io/Error, A)) -> Try(Async, Io/Error, A) =
    tty/with_raw_async(
        let first = tty/size!;
        let rest: Cell(Bytes) = Cell/new(x[])!;
        let previous: Cell(Option(Held)) = Cell/new(Option/none())!;
        let size: Cell(tty/Size) = Cell/new(first)!;
        let s = Session { rest = rest, previous = previous, size = size };
        let _ = enter!;
        let outcome = Async/using(leave, Try/run(body(s)))!;
        let a = outcome!;
        Try/pure(a));

-- The terminal's size now, recorded for `last_size`.
pub let size(s: Session) -> Try(Async, Io/Error, tty/Size) =
    let now = tty/size!;
    let _ = Cell/set(s.size, now)!;
    Try/pure(now);

-- The size last read, by `with` or `size`.
pub let last_size(s: Session) -> Io(tty/Size) =
    Cell/get(s.size);

-- Write `frame` as the difference from the previous one where the size is unchanged, and whole where it is not, then remember it.
pub let draw(
    @w: Nat,
    @h: Nat,
    s: Session,
    frame: Frame(w, h),
    cursor: Option({x: Nat, y: Nat}),
) -> Async({}) =
    let held = Cell/get(s.previous)!;
    let before: Option(Frame(w, h)) =
        match held
        | none() => Option/none()
        | some(p) =>
            match p.w == w && p.h == h
            | true => Option/some(Frame/fit(p.frame, w, h))
            | false => Option/none()
            end
        end;
    let _ = Io/write(Io/stdout, render/render(before, frame, cursor))!;
    Cell/set(s.previous, Option/some(Held { w = w, h = h, frame = frame }));

-- The next burst of input as events, parking until one arrives; `none` once standard input has ended. A burst that ends inside a sequence is given a short interval for the rest to follow, and settled by `input/flush` when nothing does — a lone Escape becomes the Escape key here and nowhere else.
pub let read(@E: Type, s: Session) -> Async(Option(List(Event(E)))) =
    let carried = Cell/get(s.rest)!;
    let got = stream/Read/read(Io/stdin, 1024)!;
    match got
    | eof() => Async/pure(Option/none())
    | error(_) => Async/pure(Option/none())
    | chunk(bytes) =>
        let d = input/decode(x[..carried, ..bytes]);
        match Bytes/len(d.rest) == 0: (_) => Async(Option(List(Event(E))))
        | true =>
            let _ = Cell/set(s.rest, x[])!;
            Async/pure(Option/some(d.events))
        -- Nothing more came: the tail is settled as it stands.
        | false =>
            let settle() -> Async(Option(List(Event(E)))) =
                let _ = Cell/set(s.rest, x[])!;
                Async/pure(Option/some([..d.events, ..input/flush(d.rest)]));
            let more = Async/timeout(Duration/of_millis(30), stream/Read/read(Io/stdin, 1024))!;
            match more: (_) => Async(Option(List(Event(E))))
            | none() => settle()
            | some(c) =>
                match c: (_) => Async(Option(List(Event(E))))
                | chunk(next) =>
                    let settled = input/decode(x[..d.rest, ..next]);
                    let _ = Cell/set(s.rest, settled.rest)!;
                    Async/pure(Option/some([..d.events, ..settled.events]))
                | _ => settle()
                end
            end
        end
    end;
