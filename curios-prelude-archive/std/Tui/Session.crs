use /std/{Nat, Bytes, List, Option, Io, Try, Async, Tty};
use /std/time/{Duration};
use /std/Tui/{Frame, Event, input, render, ansi};

struct Held: Type {
    w: Nat,
    h: Nat,
    frame: Frame(w, h),
}

--- A terminal taken: what it remembers between draws and reads.
pub struct Session: Type {
    tty: Tty,
    rest: Bytes,
    previous: Option(Held),
    size: Tty/Size,
}

let enter: Io({}) =
    Io/write(Io/stdout, x[
        ..ansi/alternate_on,
        ..ansi/cursor_hide,
        ..ansi/paste_on,
        ..ansi/kitty_push]);

let leave: Io({}) =
    Io/write(Io/stdout, x[
        ..ansi/kitty_pop,
        ..ansi/paste_off,
        ..ansi/cursor_show,
        ..ansi/alternate_off]);

--- The bracket: raw mode, the alternate screen, the hidden cursor, bracketed paste and the kitty keyboard flag, each undone in reverse whichever way `body` ends.
pub let with(@A: Type, body: (Session) -> Try(Async, Io/Error, A)) -> Try(Async, Io/Error, A) =
    let t = Tty/stdin;
    Tty/with_raw_async(
        t,
        let first = Tty/size(t)!;
        let s = Session { tty = t, rest = x[], previous = Option/none(), size = first };
        let _ = enter!;
        let outcome = Async/using(leave, Try/run(body(s)))!;
        let a = outcome!;
        Try/pure(a));

--- The terminal's size now, together with the session remembering it.
pub let size(s: Session) -> Try(Async, Io/Error, {Session, Tty/Size}) =
    let now = Tty/size(s.tty)!;
    Try/pure((resized(s, now), now));

--- Remember a size received through a resize event.
pub let resized(s: Session, now: Tty/Size) -> Session =
    Session { ..s, size = now };

--- The size last read.
pub let last_size(s: Session) -> Io(Tty/Size) =
    Io/pure(s.size);

--- `frame` written as the difference from the previous one where the size is unchanged, and whole where it is not.
pub let draw(
    @w: Nat,
    @h: Nat,
    s: Session,
    frame: Frame(w, h),
    cursor: Option({x: Nat, y: Nat}),
) -> Async(Session) =
    let before: Option(Frame(w, h)) =
        match s.previous
        | none() => Option/none()
        | some(p) =>
            match p.w == w && p.h == h
            | true => Option/some(Frame/fit(p.frame, w, h))
            | false => Option/none()
            end
        end;
    let _ = Io/write(Io/stdout, render/render(before, frame, cursor))!;
    Async/pure(Session { ..s, previous = Option/some(Held { w = w, h = h, frame = frame }) });

--- The updated session and next burst of input as events, parking until one arrives; `none` once standard input has ended.
pub let read(@E: Type, s: Session) -> Async({Session, Option(List(Event(E)))}) =
    let got = Async/Read/read(Io/stdin, 1024)!;
    match got
    | eof() => Async/pure((s, Option/none()))
    | error(_) => Async/pure((s, Option/none()))
    | chunk(bytes) =>
        let d = input/decode(x[..s.rest, ..bytes]);
        match Bytes/len(d.rest) == 0: (_) => Async({Session, Option(List(Event(E)))})
        | true => Async/pure((Session { ..s, rest = x[] }, Option/some(d.events)))
        | false =>
            let settle() -> Async({Session, Option(List(Event(E)))}) =
                Async/pure((
                    Session { ..s, rest = x[] },
                    Option/some([..d.events, ..input/flush(d.rest)])));
            let more = Async/timeout(Duration/of_millis(30), Async/Read/read(Io/stdin, 1024))!;
            match more
            | some(chunk(next)) =>
                let settled = input/decode(x[..d.rest, ..next]);
                Async/pure((
                    Session { ..s, rest = settled.rest },
                    Option/some([..d.events, ..settled.events])))
            | _ => settle()
            end
        end
    end;
