use /std/{Nat, Bool, Char, Equal, Spell};

-- | A character, or a named key. The End key is `end_key`, since `end` is a reserved word.
pub induct Code: pub Type
| char(Char)
| enter()
| escape()
| backspace()
| tab()
| delete()
| insert()
| up()
| down()
| left()
| right()
| home()
| end_key()
| page_up()
| page_down()
| f(Nat)
end

pub use Code/*;

satisfy Equal(Code);

satisfy Spell(Code);

-- | A code and its modifiers.
pub struct Key: pub Type {
    code: Code,
    shift: Bool,
    alt: Bool,
    ctrl: Bool,
}

satisfy Equal(Key);

satisfy Spell(Key);

-- | `code` with no modifier.
pub let plain(code: Code) -> Key =
    Key { code = code, shift = false, alt = false, ctrl = false };

-- | `code` with Ctrl.
pub let with_ctrl(code: Code) -> Key =
    Key { code = code, shift = false, alt = false, ctrl = true };

-- | `code` with Alt.
pub let with_alt(code: Code) -> Key =
    Key { code = code, shift = false, alt = true, ctrl = false };
