-- A frame, and the algebra that builds one. `Frame(w, h)` is `Vec` twice — `h` rows of `w` cells — so the size a frame covers is part of its type and the compiler checks every join.
--
-- **What that buys.** `beside` refuses two frames of different heights where the join is written, `above` two of different widths, and a `view` must produce exactly the frame it was asked for. The class of bug this removes — a column that does not fill its pane, a widget that overflows it, a border off by one — is what every surveyed library's issue tracker is full of, and the two that are honest about it pad the mismatch away in silence.
--
-- **What it costs.** One coercion. A string's width is a runtime fact, so `text` answers a dependent pair — the width it turned out to be, beside the frame at that width — and `fit` is what carries such a value into a pane of a size the type knows. `fit` crops what is too large and pads what is too small, by recursion on the *target* size, which is why cropping and padding are one function and no `Eq/subst` appears anywhere in this module. A frame split at a fixed part cases on the size, and the spelling `h - 1` is refused because nothing says `h` is positive.
--
-- **Reading a frame back.** `to_lines`, `row` and `get` are the in-memory backend every surveyed library ships and the reason a `view` can be asserted with no terminal in sight: a frame is a value, so a test compares it to another value. A continuation cell carries no text, so `to_lines` reads a double-width glyph as itself rather than as a glyph and a gap.
use /std/{Nat, Str, List, Vec, Tui};
use /std/Nat/{Lt};
use /std/Tui/{Style, Cell};

pub let Frame(w: Nat, h: Nat) -> Type =
    Vec(Vec(Cell, w), h);

-- Crop or pad `v` to exactly `m`, by recursion on the target rather than on the vector: `0` answers `nil` whatever is left over, and `p + 1` takes the head where there is one and `fill` where there is not. One function for both directions, and no proof relating `n` to `m` — which is the whole reason `fit` needs no lemma.
let resize(@T: Type, fill: T, m: Nat, @n: Nat, v: Vec(T, n)) -> Vec(T, m) =
    (match m: (k) => (j: Nat, Vec(T, j)) -> Vec(T, k)
    | 0 => (_j, _x) => Vec/nil()
    | _p + 1; ih =>
        (_j, x) =>
            match x
            | nil() => Vec/cons(fill, ih(0, Vec/nil()))
            | cons(@q, y, ys) => Vec/cons(y, ih(q, ys))
            end
    end)(n, v);

-- Drop up to `k` elements, saturating at the end. `List/slice` carries a `Nat/Le(start + length, len)` bound, and a clip has nothing to discharge it with: where the patch sits and how wide it is are both runtime facts, and running off the end is the case this function exists to absorb.
let drop_upto(@T: Type, l: List(T), k: Nat) -> List(T) =
    match k
    | 0 => l
    | _p + 1; ih => match ih | [] => [] | [_, ..rest] => rest end
    end;

pub let blank(w: Nat, h: Nat) -> Frame(w, h) =
    Vec/replicate(h, Vec/replicate(w, Cell/blank));

pub let filled(c: Cell, w: Nat, h: Nat) -> Frame(w, h) =
    Vec/replicate(h, Vec/replicate(w, c));

-- Join left to right. The heights must agree, and they agree in the type, so the zip below needs no bound.
pub let beside(@w1: Nat, @w2: Nat, @h: Nat, a: Frame(w1, h), b: Frame(w2, h)) -> Frame(w1 + w2, h) =
    Vec/map((r) => Vec/append(r.0, r.1), Vec/zip(a, b));

-- Join top to bottom. The widths must agree, so the rows are already the same type and stacking them is `Vec/append`.
pub let above(@w: Nat, @h1: Nat, @h2: Nat, a: Frame(w, h1), b: Frame(w, h2)) -> Frame(w, h1 + h2) =
    Vec/append(a, b);

-- The one coercion: crop what overflows, pad what falls short, in both dimensions at once.
pub let fit(@w0: Nat, @h0: Nat, frame: Frame(w0, h0), w: Nat, h: Nat) -> Frame(w, h) =
    resize(Vec/replicate(w, Cell/blank), h, Vec/map((row) => resize(Cell/blank, w, row), frame));

pub let restyle(@w: Nat, @h: Nat, f: (Style) -> Style, frame: Frame(w, h)) -> Frame(w, h) =
    Vec/map((row) => Vec/map((c) => Cell { ..c, style = f(c.style) }, row), frame);

-- The cells one string paints, and how many columns they cover. A combining mark joins the cell before it rather than taking one of its own, and a double-width scalar takes its cell and a `Cell/continuation` beside it, so the count returned is the *column* count and matches `Tui/text/width`.
let cells_of(style: Style, s: Str) -> {n: Nat, Vec(Cell, n)} =
    let empty: List(Cell) = [];
    let reversed =
        List/fold(
            Str/to_list(s),
            empty,
            (c, acc) =>
                match Tui/text/char_width(c)
                | 0 =>
                    match acc
                    | [] => acc
                    | [prev, ..rest] =>
                        [Cell { ..prev, symbol = Str/concat(prev.symbol, Str/of_char(c)) }, ..rest]
                    end
                | 1 => [Cell/of_str(style, Str/of_char(c)), ..acc]
                | _ => [Cell/continuation, Cell/of_str(style, Str/of_char(c)), ..acc]
                end);
    Vec/of_list(List/reverse(reversed));

-- One line of styled text, at whatever width it turned out to be. The pair is what a runtime-sized value looks like in a library whose sizes are types; `fit` is what carries it into a pane.
pub let text(style: Style, s: Str) -> {w: Nat, frame: Frame(w, 1)} =
    let cells = cells_of(style, s);
    (w = cells.0, frame = Vec/cons(cells.1, Vec/nil()));

-- Build a frame of a known size from text, one string per row, each fitted to `w` and the whole fitted to `h`. The counterpart of `to_lines`, and what a test writes its expected frame as.
pub let of_lines(style: Style, lines: List(Str), w: Nat, h: Nat) -> Frame(w, h) =
    let row_of(l: Str) -> Vec(Cell, w) = resize(Cell/blank, w, cells_of(style, l).1);
    resize(Vec/replicate(w, Cell/blank), h, Vec/of_list(List/map(lines, row_of)).1);

-- The frame as text, one string per row. A continuation cell contributes nothing, so a double-width glyph reads as the one glyph it is.
pub let to_lines(@w: Nat, @h: Nat, frame: Frame(w, h)) -> List(Str) =
    List/map(Vec/to_list(frame), (r) => Str/flatten(List/map(Vec/to_list(r), (c) => c.symbol)));

pub let row(@w: Nat, @h: Nat, frame: Frame(w, h), y: Nat, ok: Lt(y, h)) -> Vec(Cell, w) =
    Vec/get(@Vec(Cell, w), @h, frame, y, @ok);

pub let get(
    @w: Nat,
    @h: Nat,
    frame: Frame(w, h),
    x: Nat,
    y: Nat,
    ok_x: Lt(x, w),
    ok_y: Lt(y, h),
) -> Cell =
    Vec/get(@Cell, @w, Vec/get(@Vec(Cell, w), @h, frame, y, @ok_y), x, @ok_x);

-- Paint `top` onto `base` with its upper-left corner at `(x, y)`, clipped to `base`. There is no bound to discharge because nothing is required to fit: a `top` that runs past the edge is cropped, and one placed entirely outside changes nothing. That is what makes this the popup primitive — a dialog's position is a runtime fact, and demanding a proof of it would push the arithmetic into every caller.
pub let overlay(
    @w: Nat,
    @h: Nat,
    @w1: Nat,
    @h1: Nat,
    base: Frame(w, h),
    top: Frame(w1, h1),
    x: Nat,
    y: Nat,
) -> Frame(w, h) =
    let patches = List/map(Vec/to_list(top), Vec/to_list);
    let splice(index: Nat, under: List(Cell)) -> List(Cell) =
        match List/try_get(patches, index - y)
        | none() => under
        | some(patch) =>
            match y <= index
            | false => under
            | true =>
                List/flatten([List/take(under, x), patch, drop_upto(under, x + List/len(patch))])
            end
        end;
    let row_of(r: {Nat, Vec(Cell, w)}) -> Vec(Cell, w) =
        let spliced = Vec/of_list(splice(r.0, Vec/to_list(r.1)));
        resize(Cell/blank, w, spliced.1);
    let rows = Vec/of_list(List/map(List/zip(List/range(0, h), Vec/to_list(base)), row_of));
    resize(Vec/replicate(w, Cell/blank), h, rows.1);

-- The rows from `y` and the columns from `x` on, at whatever size is left: the offset-taking counterpart of `fit`, and what a viewport is before it is fitted. Past the edge there is nothing left, and the size says so.
pub let crop(
    @w: Nat,
    @h: Nat,
    frame: Frame(w, h),
    x: Nat,
    y: Nat,
) -> {cw: Nat, ch: Nat, frame: Frame(cw, ch)} =
    let rows =
        List/map(
            drop_upto(Vec/to_list(frame), y),
            (r) => Vec/of_list(drop_upto(Vec/to_list(r), x)));
    let cw = w - x;
    let fitted = List/map(rows, (r) => resize(Cell/blank, cw, r.1));
    let stacked = Vec/of_list(fitted);
    (cw = cw, ch = stacked.0, frame = stacked.1);
