use /std/{Nat, Str, List, Vec, Tui};
use /std/Nat/{Lt};
use /std/Tui/{Style, Tile};

-- | `h` rows of `w` tiles.
pub let Frame(w: Nat, h: Nat) -> Type =
    Vec(Vec(Tile, w), h);

let resize(@T: Type, fill: T, m: Nat, @n: Nat, v: Vec(T, n)) -> Vec(T, m) =
    (match m: (k) => (j: Nat, Vec(T, j)) -> Vec(T, k)
    | 0 => (_j, _x) => Vec/nil()
    | _p + 1; ih =>
        (_j, x) =>
            match x
            | nil() => Vec/cons(fill, ih(0, Vec/nil()))
            | cons(@q, y, ys) => Vec/cons(y, ih(q, ys))
            end
    end)(n, v);

let drop_upto(@T: Type, l: List(T), k: Nat) -> List(T) =
    match k
    | 0 => l
    | _p + 1; ih => match ih | [] => [] | [_, ..rest] => rest end
    end;

-- | `w` by `h` of blank tiles.
pub let blank(w: Nat, h: Nat) -> Frame(w, h) =
    Vec/replicate(h, Vec/replicate(w, Tile/blank));

-- | `w` by `h` of `c`.
pub let filled(c: Tile, w: Nat, h: Nat) -> Frame(w, h) =
    Vec/replicate(h, Vec/replicate(w, c));

-- | `a` then `b`, left to right. The heights agree in the type.
pub let beside(@w1: Nat, @w2: Nat, @h: Nat, a: Frame(w1, h), b: Frame(w2, h)) -> Frame(w1 + w2, h) =
    Vec/map((r) => Vec/append(r.0, r.1), Vec/zip(a, b));

-- | `a` then `b`, top to bottom. The widths agree in the type.
pub let above(@w: Nat, @h1: Nat, @h2: Nat, a: Frame(w, h1), b: Frame(w, h2)) -> Frame(w, h1 + h2) =
    Vec/append(a, b);

-- | `frame` at `w` by `h`: cropped where it overflows, padded with blanks where it falls short.
pub let fit(@w0: Nat, @h0: Nat, frame: Frame(w0, h0), w: Nat, h: Nat) -> Frame(w, h) =
    resize(Vec/replicate(w, Tile/blank), h, Vec/map((row) => resize(Tile/blank, w, row), frame));

-- | `f` on every tile's style.
pub let restyle(@w: Nat, @h: Nat, f: (Style) -> Style, frame: Frame(w, h)) -> Frame(w, h) =
    Vec/map((row) => Vec/map((c) => Tile { ..c, style = f(c.style) }, row), frame);

let tiles_of(style: Style, s: Str) -> {n: Nat, Vec(Tile, n)} =
    let empty: List(Tile) = [];
    let reversed =
        List/fold(
            Str/to_list(s),
            empty,
            (c, acc) =>
                match Tui/text/char_width(c)
                | 0 =>
                    match acc
                    | [] => acc
                    | [prev, ..rest] =>
                        [Tile { ..prev, symbol = Str/concat(prev.symbol, Str/of_char(c)) }, ..rest]
                    end
                | 1 => [Tile/of_str(style, Str/of_char(c)), ..acc]
                | _ => [Tile/continuation, Tile/of_str(style, Str/of_char(c)), ..acc]
                end);
    Vec/of_list(List/reverse(reversed));

-- | One row of `s` in `style`, at whatever width it turns out to be.
pub let text(style: Style, s: Str) -> {w: Nat, frame: Frame(w, 1)} =
    let tiles = tiles_of(style, s);
    (w = tiles.0, frame = Vec/cons(tiles.1, Vec/nil()));

-- | A frame of `w` by `h` from `lines`, one per row, each fitted to `w` and the whole fitted to `h`.
pub let of_lines(style: Style, lines: List(Str), w: Nat, h: Nat) -> Frame(w, h) =
    let row_of(l: Str) -> Vec(Tile, w) = resize(Tile/blank, w, tiles_of(style, l).1);
    resize(Vec/replicate(w, Tile/blank), h, Vec/of_list(List/map(lines, row_of)).1);

-- | The frame as text, one string per row. A continuation tile contributes nothing.
pub let to_lines(@w: Nat, @h: Nat, frame: Frame(w, h)) -> List(Str) =
    List/map(Vec/to_list(frame), (r) => Str/flatten(List/map(Vec/to_list(r), (c) => c.symbol)));

-- | Row `y`, under the evidence that it is within the height.
pub let row(@w: Nat, @h: Nat, frame: Frame(w, h), y: Nat, ok: Lt(y, h)) -> Vec(Tile, w) =
    Vec/get(@Vec(Tile, w), @h, frame, y, @ok);

-- | The tile at `x`, `y`, under the evidence that both are within the frame.
pub let get(
    @w: Nat,
    @h: Nat,
    frame: Frame(w, h),
    x: Nat,
    y: Nat,
    ok_x: Lt(x, w),
    ok_y: Lt(y, h),
) -> Tile =
    Vec/get(@Tile, @w, Vec/get(@Vec(Tile, w), @h, frame, y, @ok_y), x, @ok_x);

-- | `top` painted onto `base` with its upper-left corner at `x`, `y`, clipped to `base`. Nothing is required to fit.
pub let overlay(
    @w: Nat,
    @h: Nat,
    @w1: Nat,
    @h1: Nat,
    base: Frame(w, h),
    top: Frame(w1, h1),
    x: Nat,
    y: Nat,
) -> Frame(w, h) =
    let patches = List/map(Vec/to_list(top), Vec/to_list);
    let splice(index: Nat, under: List(Tile)) -> List(Tile) =
        match List/try_get(patches, index - y)
        | none() => under
        | some(patch) =>
            match y <= index
            | false => under
            | true =>
                List/flatten([List/take(under, x), patch, drop_upto(under, x + List/len(patch))])
            end
        end;
    let row_of(r: {Nat, Vec(Tile, w)}) -> Vec(Tile, w) =
        let spliced = Vec/of_list(splice(r.0, Vec/to_list(r.1)));
        resize(Tile/blank, w, spliced.1);
    let rows = Vec/of_list(List/map(List/zip(List/range(0, h), Vec/to_list(base)), row_of));
    resize(Vec/replicate(w, Tile/blank), h, rows.1);

-- | The rows from `y` and the columns from `x` on, at whatever size is left.
pub let crop(
    @w: Nat,
    @h: Nat,
    frame: Frame(w, h),
    x: Nat,
    y: Nat,
) -> {cw: Nat, ch: Nat, frame: Frame(cw, ch)} =
    let rows =
        List/map(
            drop_upto(Vec/to_list(frame), y),
            (r) => Vec/of_list(drop_upto(Vec/to_list(r), x)));
    let cw = w - x;
    let fitted = List/map(rows, (r) => resize(Tile/blank, cw, r.1));
    let stacked = Vec/of_list(fitted);
    (cw = cw, ch = stacked.0, frame = stacked.1);
