use /std/{Nat, Byte, Equal};
use /std/Nat/{Lt};

-- | The terminal's default, one of the sixteen the palette names, one of the 256-colour cube, or a direct 24-bit triple.
pub induct Color: pub Type
| default()
| ansi(n: Nat, @ok: Lt(n, 16))
| indexed(Byte)
| rgb(Byte, Byte, Byte)
end

pub use Color/*;

satisfy Equal(Color);

-- | Palette colour 0.
pub let black: Color =
    Color/ansi(0);

-- | Palette colour 1.
pub let red: Color =
    Color/ansi(1);

-- | Palette colour 2.
pub let green: Color =
    Color/ansi(2);

-- | Palette colour 3.
pub let yellow: Color =
    Color/ansi(3);

-- | Palette colour 4.
pub let blue: Color =
    Color/ansi(4);

-- | Palette colour 5.
pub let magenta: Color =
    Color/ansi(5);

-- | Palette colour 6.
pub let cyan: Color =
    Color/ansi(6);

-- | Palette colour 7.
pub let white: Color =
    Color/ansi(7);

-- | Palette colour 8.
pub let bright_black: Color =
    Color/ansi(8);

-- | Palette colour 9.
pub let bright_red: Color =
    Color/ansi(9);

-- | Palette colour 10.
pub let bright_green: Color =
    Color/ansi(10);

-- | Palette colour 11.
pub let bright_yellow: Color =
    Color/ansi(11);

-- | Palette colour 12.
pub let bright_blue: Color =
    Color/ansi(12);

-- | Palette colour 13.
pub let bright_magenta: Color =
    Color/ansi(13);

-- | Palette colour 14.
pub let bright_cyan: Color =
    Color/ansi(14);

-- | Palette colour 15.
pub let bright_white: Color =
    Color/ansi(15);
