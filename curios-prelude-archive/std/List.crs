pub use /sys/{List};
pub use /sys/List/{get, len, slice, map};
use /std/{Nat, Bool, Option, Eq, Str, Show, Monad};

pub let try_get(@T: Type, a: List(T), i: Nat) -> Option(T) =
    match i < len(a) | true => Option/some(get(a, i)) | false => Option/none() end;

pub let flatten(@T: Type, parts: List(List(T))) -> List(T) =
    fold(parts, [], (a, acc) => [..acc, ..a]);

pub let fold(@T: Type, @A: Type, l: List(T), init: A, f: (T, A) -> A) -> A =
    let n = len(l);
    rec go(k: Nat, i: Nat, acc: A, inv: Eq(i + k, n)) -> A =
        match k
        | 0 => acc
        -- `i < n` transported along the loop invariant: `i + (kp + 1) = n` gives `i ≤ i + kp`, whose successor is the bound `at` demands.
        | kp + 1 =>
            let below =
                Eq/subst((x) => Nat/Lt(i, x), inv, Nat/Lt/succ_of_ind(Nat/Le/Ind/add_r(i, kp)));
            go(kp, i + 1, f(get(@T, l, i, @below), acc), inv)
        end;
    go(n, 0, init, Eq/refl());

-- The bound is scrutinised as `len(l)` rather than through a `let`-bound alias, for the reason `Map/bit` states: a refinement records the term it scrutinised, and `at` demands the bound spelled the way `Nat/Lt` states it.
pub let find(@T: Type, l: List(T), pred: (T) -> Bool) -> Option(T) =
    rec go(i: Nat) -> Option(T) =
        match i < len(l)
        | true =>
            let x = get(l, i);
            match pred(x) | true => Option/some(x) | false => go(i + 1) end
        | false => Option/none()
        end;
    go(0);

pub let balanced(@A: Type, n: Nat, empty: A, single: (Nat) -> A, combine: (A, A) -> A) -> A =
    rec go(lo: Nat, hi: Nat) -> A =
        choose
        | lo + 1 < hi =>
            let mid = (lo + hi) / 2;
            combine(go(lo, mid), go(mid, hi))
        | lo < hi => single(lo)
        | _ => empty
        end;
    go(0, n);

satisfy (@A: Type, use Show(A)) => Show(List(A)) {
    show(l) = Str/concat("[", Str/concat(Str/join(", ", map(l, (x) => Show/show(x))), "]")),
}

satisfy Monad(List) {
    pure(x) = [x],
    bind(m, f) = fold(m, [], (x, acc) => [..acc, ..f(x)]),
}
