-- | Division, which `/` dispatches through.
pub concept Div(A: Type): pub Type {
    -- | The precondition this carrier states for a divisor: `True` where division is total, and a proposition the caller must discharge where it is not.
    Ok(A) -> Prop,
    -- | The quotient, under the evidence that `b` may be divided by.
    div(a: A, b: A, @ok: Ok(b)) -> A,
}

pub use Div/{div};
