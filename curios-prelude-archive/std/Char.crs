use /std/{Nat, Byte, Bool, Bytes, Option, Ordering, Eq, Str, Show, Spell, Ord, proved};
use /std/ops/{Eql, Cmp};

--- Whether `code` is a Unicode scalar value: a code point up to `U+10FFFF` outside the surrogate range.
let is_valid(code: Nat) -> Bool =
    code < 0xD800 || code >= 0xE000 && code <= 0x10FFFF;

--- That a code point is a Unicode scalar value, which is what `Char` carries, and deciding it where no guard has.
pub mod Valid;
pub use Valid/{let Valid};

--- One Unicode scalar value.
pub struct Char: pub Type {
    --- Its code point.
    code: Nat,
    --- Why that code point is a scalar value rather than a surrogate.
    valid: Valid(code),
}

--- The code point.
pub let to_nat(c: Char) -> Nat =
    c.code;

--- The character with code point `code`, or `none` for a surrogate or a value past `U+10FFFF`.
pub let of_nat(code: Nat) -> Option(Char) =
    match Valid/try(code)
    | some(valid) => Option/some(Char { code = code, valid = valid })
    | none() => Option/none()
    end;

--- Equal code points are equal characters.
pub let eq_of_code(a: Char, b: Char, proof: Eq()(a.code, b.code)) -> Eq()(a, b) =
    Eq/subst(
        (code: Nat) => (valid: Valid(code)) -> Eq()(a, Char { code = code, valid = valid }),
        proof,
        (_: Valid(a.code)) => Eq/refl())(b.valid);

--- Whether the two are equal.
pub let eql(a: Char, b: Char) -> Bool =
    a.code == b.code;

--- Code-point order.
pub let ord(a: Char, b: Char) -> Ordering =
    Nat/ord(a.code, b.code);

--- Whether `a` is below `b` in code-point order.
---
--- Stated on the code points directly, as `Byte`'s order is on its values, so that a comparison of characters is a comparison of naturals once unfolded and reduces as one — its negation is its dual, and swapping its operands is the mirrored comparison. Read through `ord` it would be a stuck match on an `Ordering`, which no law relates to another.
pub let lt(a: Char, b: Char) -> Bool =
    a.code < b.code;

--- Whether `a` is at most `b` in code-point order.
pub let le(a: Char, b: Char) -> Bool =
    a.code <= b.code;

--- Whether `a` is above `b` in code-point order.
pub let gt(a: Char, b: Char) -> Bool =
    a.code > b.code;

--- Whether `a` is at least `b` in code-point order.
pub let ge(a: Char, b: Char) -> Bool =
    a.code >= b.code;

--- That `a` is below `b` in code-point order, decided as `Nat/Lt` is.
pub let Lt(a: Char, b: Char) -> Prop =
    Bool/Holds(lt(a, b));

--- That `a` is at most `b` in code-point order, decided as `Nat/Le` is.
pub let Le(a: Char, b: Char) -> Prop =
    Bool/Holds(le(a, b));

--- Space, tab, newline, vertical tab, form feed or carriage return.
pub let is_whitespace(c: Char) -> Bool =
    c.code == 0x20 || Nat/in_range(c.code, 0x9, 0xD);

--- `0` through `9`.
pub let is_digit(c: Char) -> Bool =
    Nat/in_range(c.code, 0x30, 0x39);

--- `a` through `z`.
pub let is_lower(c: Char) -> Bool =
    Nat/in_range(c.code, 0x61, 0x7A);

--- `A` through `Z`.
pub let is_upper(c: Char) -> Bool =
    Nat/in_range(c.code, 0x41, 0x5A);

--- An ASCII letter.
pub let is_alpha(c: Char) -> Bool =
    is_lower(c) || is_upper(c);

--- An ASCII letter or digit.
pub let is_alphanumeric(c: Char) -> Bool =
    is_alpha(c) || is_digit(c);

--- An ASCII uppercase letter lowered; anything else unchanged.
pub let to_ascii_lower(c: Char) -> Char =
    match is_upper(c)
    | true => Char { code = c.code + 0x20, valid = Valid/below_surrogates(c.code + 0x20, proved()) }
    | false => c
    end;

--- An ASCII lowercase letter raised; anything else unchanged.
pub let to_ascii_upper(c: Char) -> Char =
    match is_lower(c)
    | true => Char { code = c.code - 0x20, valid = Valid/below_surrogates(c.code - 0x20, proved()) }
    | false => c
    end;

--- The lowercase hexadecimal digit for `nibble` modulo sixteen. Both codes are scalar values by reduction, since a remainder sits below its divisor.
pub let hex_digit(nibble: Nat) -> Char =
    match nibble % 0x10 < 10
    | true => Char { code = nibble % 0x10 + 0x30, valid = Bool/True/qed() }
    | false => Char { code = nibble % 0x10 - 10 + 0x61, valid = Bool/True/qed() }
    end;

--- The value of a hexadecimal digit in either case, or `none`.
pub let of_hex_digit(c: Char) -> Option(Nat) =
    choose
    | is_digit(c) => Option/some(c.code - 0x30)
    | Nat/in_range(c.code, 0x61, 0x66) => Option/some(c.code - 0x61 + 10)
    | Nat/in_range(c.code, 0x41, 0x46) => Option/some(c.code - 0x41 + 10)
    | _ => Option/none()
    end;

--- The character a byte below 128 encodes, or `none`.
pub let of_ascii(byte: Byte) -> Option(Char) =
    match Byte/to_nat(byte) < 0x80 | true => of_nat(Byte/to_nat(byte)) | false => Option/none() end;

--- The byte a character below 128 encodes, or `none`.
pub let to_ascii(c: Char) -> Option(Byte) =
    match c.code < 0x80
    | true => Option/some(Nat/to_byte(c.code % 0x80))
    | false => Option/none()
    end;

--- The UTF-8 encoding, one to four bytes: `/std/Str/Valid/encoded` proves them well-formed.
---
--- Each byte is built under the bound it is proved to satisfy, and none is masked. A continuation byte's six bits are below `0x40` by the remainder that selects them, which reduction decides. A lead byte's payload is below its family's width because the code point is below the family's end: the guard says so for the first three families, and for the fourth, which has no guard, `c.valid` does — a scalar value is at most `U+10FFFF`, so its lead byte is at most `F4`.
pub let to_utf8(c: Char) -> Bytes =
    let code = c.code;
    choose
    | code < 0x80 => x[Nat/to_byte(code)]
    | code < 0x800 => x[Nat/to_byte(0xC0 + code / 0x40), Nat/to_byte(0x80 + code % 0x40)]
    | code < 0x10000 =>
        x[
            Nat/to_byte(0xE0 + code / 0x1000),
            Nat/to_byte(0x80 + code % 0x1000 / 0x40),
            Nat/to_byte(0x80 + code % 0x40)]
    | _ =>
        let scalar = Valid/at_most(code, c.valid);
        x[
            Nat/to_byte(0xF0 + code / 0x40000),
            Nat/to_byte(0x80 + code % 0x40000 / 0x1000),
            Nat/to_byte(0x80 + code % 0x1000 / 0x40),
            Nat/to_byte(0x80 + code % 0x40)]
    end;

satisfy Eql(Char) {
    eql = eql,
    neq(a, b) = Bool/not(eql(a, b)),
}

satisfy Cmp(Char) {
    lt = lt,
    le = le,
    gt = gt,
    ge = ge,
}

satisfy Show(Char) {
    show(c) = Str/of_char(c),
}

--- A character literal, escaped where the literal grammar needs it.
satisfy Spell(Char) {
    spell(c) =
        let body =
            match to_nat(c)
            | '\n' => "\\n"
            | '\t' => "\\t"
            | '\r' => "\\r"
            | '\\' => "\\\\"
            | '\'' => "\\'"
            | _ => Str/of_char(c)
            end;
        Str/concat("'", Str/concat(body, "'")),
}

satisfy Ord(Char) {
    ord = ord,
}
