-- Unicode scalar values are certified by /syn/Char. Classification and case conversion in this initial API are deliberately ASCII-only; Unicode database policy remains outside the foundational scalar type.
pub use /syn/{Char};
pub use /syn/Char/{Below, InRange, Scalar};
use /std/{Nat, Byte, Bool, Bytes, Option, Ordering, Eq, True, Str, Equal, Compare, Show, Spell,
    Ordered, Test};

pub let to_nat(c: Char) -> Nat =
    c.code;

pub let of_nat(code: Nat) -> Option(Char) =
    match code < 0xD800
    | true => Option/some(Char { code = code, scalar = Scalar/below(True/qed()) })
    | false =>
        match code >= 0xE000
        | true =>
            match code <= 0x10FFFF
            | true => Option/some(Char { code = code, scalar = Scalar/above(True/qed()) })
            | false => Option/none()
            end
        | false => Option/none()
        end
    end;

pub let eq_of_code(a: Char, b: Char, proof: Eq(a.code, b.code)) -> Eq(a, b) =
    Eq/subst(
        (code: Nat) => (scalar: Scalar(code)) -> Eq(a, Char { code = code, scalar = scalar }),
        proof,
        (scalar: Scalar(a.code)) => Eq/refl())(b.scalar);

pub let eql(a: Char, b: Char) -> Bool =
    a.code == b.code;

pub let cmp(a: Char, b: Char) -> Ordering =
    Nat/cmp(a.code, b.code);

pub let lt(a: Char, b: Char) -> Bool =
    match cmp(a, b) | lt() => true | _ => false end;

pub let le(a: Char, b: Char) -> Bool =
    match cmp(a, b) | gt() => false | _ => true end;

pub let gt(a: Char, b: Char) -> Bool =
    match cmp(a, b) | gt() => true | _ => false end;

pub let ge(a: Char, b: Char) -> Bool =
    match cmp(a, b) | lt() => false | _ => true end;

pub let is_whitespace(c: Char) -> Bool =
    c.code == 0x20 || Nat/in_range(c.code, 0x9, 0xD);

pub let is_digit(c: Char) -> Bool =
    Nat/in_range(c.code, 0x30, 0x39);

pub let is_lower(c: Char) -> Bool =
    Nat/in_range(c.code, 0x61, 0x7A);

pub let is_upper(c: Char) -> Bool =
    Nat/in_range(c.code, 0x41, 0x5A);

pub let is_alpha(c: Char) -> Bool =
    is_lower(c) || is_upper(c);

pub let is_alphanumeric(c: Char) -> Bool =
    is_alpha(c) || is_digit(c);

pub let to_ascii_lower(c: Char) -> Char =
    match is_upper(c) | true => Option/unwrap_or(of_nat(c.code + 0x20), c) | false => c end;

pub let to_ascii_upper(c: Char) -> Char =
    match is_lower(c) | true => Option/unwrap_or(of_nat(c.code - 0x20), c) | false => c end;

let ascii_zero: Char =
    Char { code = 0x30, scalar = Scalar/below(True/qed()) };

pub let hex_digit(nibble: Nat) -> Char =
    let digit =
        match nibble % 0x10 < 10
        | true => nibble % 0x10 + 0x30
        | false => nibble % 0x10 - 10 + 0x61
        end;
    Option/unwrap_or(of_nat(digit), ascii_zero);

pub let of_hex_digit(c: Char) -> Option(Nat) =
    choose
    | is_digit(c) => Option/some(c.code - 0x30)
    | Nat/in_range(c.code, 0x61, 0x66) => Option/some(c.code - 0x61 + 10)
    | Nat/in_range(c.code, 0x41, 0x46) => Option/some(c.code - 0x41 + 10)
    | _ => Option/none()
    end;

pub let of_ascii(byte: Byte) -> Option(Char) =
    match Byte/to_nat(byte) < 0x80 | true => of_nat(Byte/to_nat(byte)) | false => Option/none() end;

pub let to_ascii(c: Char) -> Option(Byte) =
    match c.code < 0x80 | true => Option/some(Nat/to_byte(c.code)) | false => Option/none() end;

-- Guarded on `0 < shift` rather than a refuted `shift == 0`, for the reason `Map/bit` states: the division's precondition is decided on *that* comparison, so refining it is what discharges the bound, where an equality refined to false leaves it stuck on a comparison nothing relates to it.
let emit_continuations(acc: Bytes, codepoint: Nat, shift: Nat) -> Bytes =
    match 0 < shift
    | false => acc
    | true =>
        let group = codepoint / shift % 0x40;
        emit_continuations(x[..acc, Nat/to_byte(0x80 + group)], codepoint, Nat/div(shift, 0x40))
    end;

pub let to_utf8(c: Char) -> Bytes =
    let codepoint = c.code;
    choose
    | codepoint < 0x80 => x[Nat/to_byte(codepoint)]
    | codepoint < 0x800 => emit_continuations(x[Nat/to_byte(0xC0 + codepoint / 0x40)], codepoint, 1)
    | codepoint < 0x10000 =>
        emit_continuations(x[Nat/to_byte(0xE0 + codepoint / 0x1000)], codepoint, 0x40)
    | _ => emit_continuations(x[Nat/to_byte(0xF0 + codepoint / 0x40000)], codepoint, 0x1000)
    end;

satisfy Equal(Char) {
    eql = eql,
    neq(a, b) = Bool/not(eql(a, b)),
}

satisfy Compare(Char) {
    lt = lt,
    le = le,
    gt = gt,
    ge = ge,
}

satisfy Show(Char) {
    show(c) = Str/of_char(c),
}

-- Each escape arm is the character it stands for, dispatched on the scalar value: `to_nat` at the head makes the projection visible, and the literals in the arms are the escapes as written.
satisfy Spell(Char) {
    spell(c) =
        let body =
            match to_nat(c)
            | '\n' => "\\n"
            | '\t' => "\\t"
            | '\r' => "\\r"
            | '\\' => "\\\\"
            | '\'' => "\\'"
            | _ => Str/of_char(c)
            end;
        Str/concat("'", Str/concat(body, "'")),
}

satisfy Ordered(Char) {
    cmp = cmp,
}

-- Printable ASCII, so a drawn character spells as itself and a drawn string reads as text. `of_nat` cannot refuse a code below 128, so the fallback is never reached.
satisfy Test/Draw(Char) {
    all() = Option/none(),
    draw(seed, size) =
        let (n, rest) = Test/Seed/next(seed);
        (Option/unwrap_or(of_nat(32 + n % 95), ' '), rest),
}
