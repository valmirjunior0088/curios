use /std/{Nat, Byte, Bool, Bytes, Option, Ordering, Eq, False, True, Str, Show, Spell, Ord};
use /std/ops/{Eql, Cmp};

-- | That `code` is below `bound`, decided.
pub let Below(code: Nat, bound: Nat) -> Prop =
    Bool/Holds(code < bound);

-- | That `code` lies between `lo` and `hi`, both ends included, decided.
pub let InRange(code: Nat, lo: Nat, hi: Nat) -> Prop =
    match code >= lo | true => Bool/Holds(code <= hi) | false => False end;

-- | That `code` is a Unicode scalar value, which is every code point but the surrogates.
pub induct Scalar: (Nat) -> pub Prop
-- | Below the surrogate range.
| below(@code: Nat, proof: Below(code, 0xD800)): (code)
-- | Above the surrogate range, up to the last code point.
| above(@code: Nat, proof: InRange(code, 0xE000, 0x10FFFF)): (code)
end

-- | One Unicode scalar value.
pub struct Char: pub Type {
    -- | Its code point.
    code: Nat,
    -- | Why that code point is a scalar value rather than a surrogate.
    scalar: Scalar(code),
}

-- | The code point.
pub let to_nat(c: Char) -> Nat =
    c.code;

-- | The character with code point `code`, or `none` for a surrogate or a value past `U+10FFFF`.
pub let of_nat(code: Nat) -> Option(Char) =
    match code < 0xD800
    | true => Option/some(Char { code = code, scalar = Scalar/below(True/qed()) })
    | false =>
        match code >= 0xE000
        | true =>
            match code <= 0x10FFFF
            | true => Option/some(Char { code = code, scalar = Scalar/above(True/qed()) })
            | false => Option/none()
            end
        | false => Option/none()
        end
    end;

-- | Eql code points are equal characters.
pub let eq_of_code(a: Char, b: Char, proof: Eq(a.code, b.code)) -> Eq(a, b) =
    Eq/subst(
        (code: Nat) => (scalar: Scalar(code)) -> Eq(a, Char { code = code, scalar = scalar }),
        proof,
        (_: Scalar(a.code)) => Eq/refl())(b.scalar);

-- | Whether the two are equal.
pub let eql(a: Char, b: Char) -> Bool =
    a.code == b.code;

-- | Code-point order.
pub let cmp(a: Char, b: Char) -> Ordering =
    Nat/cmp(a.code, b.code);

-- | Whether `a` is below `b` in code-point order.
pub let lt(a: Char, b: Char) -> Bool =
    match cmp(a, b) | lt() => true | _ => false end;

-- | Whether `a` is at most `b` in code-point order.
pub let le(a: Char, b: Char) -> Bool =
    match cmp(a, b) | gt() => false | _ => true end;

-- | Whether `a` is above `b` in code-point order.
pub let gt(a: Char, b: Char) -> Bool =
    match cmp(a, b) | gt() => true | _ => false end;

-- | Whether `a` is at least `b` in code-point order.
pub let ge(a: Char, b: Char) -> Bool =
    match cmp(a, b) | lt() => false | _ => true end;

-- | Space, tab, newline, vertical tab, form feed or carriage return.
pub let is_whitespace(c: Char) -> Bool =
    c.code == 0x20 || Nat/in_range(c.code, 0x9, 0xD);

-- | `0` through `9`.
pub let is_digit(c: Char) -> Bool =
    Nat/in_range(c.code, 0x30, 0x39);

-- | `a` through `z`.
pub let is_lower(c: Char) -> Bool =
    Nat/in_range(c.code, 0x61, 0x7A);

-- | `A` through `Z`.
pub let is_upper(c: Char) -> Bool =
    Nat/in_range(c.code, 0x41, 0x5A);

-- | An ASCII letter.
pub let is_alpha(c: Char) -> Bool =
    is_lower(c) || is_upper(c);

-- | An ASCII letter or digit.
pub let is_alphanumeric(c: Char) -> Bool =
    is_alpha(c) || is_digit(c);

-- | An ASCII uppercase letter lowered; anything else unchanged.
pub let to_ascii_lower(c: Char) -> Char =
    match is_upper(c) | true => Option/unwrap_or(of_nat(c.code + 0x20), c) | false => c end;

-- | An ASCII lowercase letter raised; anything else unchanged.
pub let to_ascii_upper(c: Char) -> Char =
    match is_lower(c) | true => Option/unwrap_or(of_nat(c.code - 0x20), c) | false => c end;

let ascii_zero: Char =
    Char { code = 0x30, scalar = Scalar/below(True/qed()) };

-- | The lowercase hexadecimal digit for `nibble` modulo sixteen.
pub let hex_digit(nibble: Nat) -> Char =
    let digit =
        match nibble % 0x10 < 10
        | true => nibble % 0x10 + 0x30
        | false => nibble % 0x10 - 10 + 0x61
        end;
    Option/unwrap_or(of_nat(digit), ascii_zero);

-- | The value of a hexadecimal digit in either case, or `none`.
pub let of_hex_digit(c: Char) -> Option(Nat) =
    choose
    | is_digit(c) => Option/some(c.code - 0x30)
    | Nat/in_range(c.code, 0x61, 0x66) => Option/some(c.code - 0x61 + 10)
    | Nat/in_range(c.code, 0x41, 0x46) => Option/some(c.code - 0x41 + 10)
    | _ => Option/none()
    end;

-- | The character a byte below 128 encodes, or `none`.
pub let of_ascii(byte: Byte) -> Option(Char) =
    match Byte/to_nat(byte) < 0x80 | true => of_nat(Byte/to_nat(byte)) | false => Option/none() end;

-- | The byte a character below 128 encodes, or `none`.
pub let to_ascii(c: Char) -> Option(Byte) =
    match c.code < 0x80
    | true => Option/some(Nat/to_byte(c.code % 0x80))
    | false => Option/none()
    end;

let emit_continuations(acc: Bytes, codepoint: Nat, shift: Nat) -> Bytes =
    match 0 < shift
    | false => acc
    | true =>
        let group = codepoint / shift % 0x40;
        emit_continuations(x[..acc, Nat/to_byte(0x80 + group)], codepoint, Nat/div(shift, 0x40))
    end;

-- | The UTF-8 encoding, one to four bytes.
-- |
-- | Each lead byte masks to the payload width its own form declares — seven bits for ASCII, five for the two-byte lead, four for the three-byte, three for the four-byte — so the value is in range on its face rather than because a guard three lines up says so. Three of the four arms are guarded and the mask is an identity under the guard; the fourth has no guard at all, and its width is the only thing standing between `0x10FFFF` and a lead byte that means something else.
pub let to_utf8(c: Char) -> Bytes =
    let codepoint = c.code;
    choose
    | codepoint < 0x80 => x[Nat/to_byte(codepoint % 0x80)]
    | codepoint < 0x800 =>
        emit_continuations(x[Nat/to_byte(0xC0 + codepoint / 0x40 % 0x20)], codepoint, 1)
    | codepoint < 0x10000 =>
        emit_continuations(x[Nat/to_byte(0xE0 + codepoint / 0x1000 % 0x10)], codepoint, 0x40)
    | _ => emit_continuations(x[Nat/to_byte(0xF0 + codepoint / 0x40000 % 0x08)], codepoint, 0x1000)
    end;

satisfy Eql(Char) {
    eql = eql,
    neq(a, b) = Bool/not(eql(a, b)),
}

satisfy Cmp(Char) {
    lt = lt,
    le = le,
    gt = gt,
    ge = ge,
}

satisfy Show(Char) {
    show(c) = Str/of_char(c),
}

-- | A character literal, escaped where the literal grammar needs it.
satisfy Spell(Char) {
    spell(c) =
        let body =
            match to_nat(c)
            | '\n' => "\\n"
            | '\t' => "\\t"
            | '\r' => "\\r"
            | '\\' => "\\\\"
            | '\'' => "\\'"
            | _ => Str/of_char(c)
            end;
        Str/concat("'", Str/concat(body, "'")),
}

satisfy Ord(Char) {
    ord = cmp,
}
