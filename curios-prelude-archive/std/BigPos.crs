-- Strictly-positive naturals, as a `BigNat` paired with a proof that its packed representation is nonempty (`is_cons(value.bits)`). The record is transparent: the accompanying proof, not an opaque wrapper, is what enforces the invariant, so `.value` is directly usable by consumers (e.g. `BigInt`). Operations delegate to `BigNat` over the magnitude and transport the nonzero certificate through the same raw ripple-carry the `BigNat` op runs, so the algebraic lemma corpus is a one-line delegation each.
use /std/{Bool, Bits, Eq, False, True, BigNat, Show};
use /std/BigNat/{of_trimmed_bits, is_trimmed, is_trimmed_of_canonical, trim, view, combine};

-- | nonzero certificate: the (canonical) word is nonempty. A plain match (no fold), so it reduces on any cons-headed word, even one with an opaque tail.
pub let is_cons(bits: Bits) -> Prop =
    match bits | b[] => False | b[_, .._] => True end;

pub struct BigPos: pub Type {
    value: BigNat,
    non_zero: is_cons(value.bits),
}

pub let eq(a: BigPos, b: BigPos, p: Eq(a.value, b.value)) -> Eq(a, b) =
    Eq/subst(
        (m: BigNat) => (nz: is_cons(m.bits)) -> Eq(a, BigPos { value = m, non_zero = nz }),
        p,
        (_nz: is_cons(a.value.bits)) => Eq/refl())(b.non_zero);

pub let nz_trimmed(t: BigPos) -> Eq(is_trimmed(t.value.bits), true) =
    is_trimmed_of_canonical(t.value.bits, t.value.canonical);

let cons_low_trimmed(
    low: Bool,
    bits: Bits,
    tr: Eq(is_trimmed(bits), true),
    ne: is_cons(bits),
) -> Eq(is_trimmed(b[low, ..bits]), true) =
    match bits
    | b[] => match ne end
    | b[_, .._] => tr
    end;

-- | combine / trim-head helpers for the mul-nonzero proof
let combine_non_zero(h: Bool, w: Bits, ne: is_cons(w)) -> is_cons(combine(h, w)) =
    match w
    | b[] => match ne end
    | b[_, .._] => True/qed()
    end;

let combine_true_non_zero(w: Bits) -> is_cons(combine(true, w)) =
    match w | b[] => True/qed() | b[_, .._] => True/qed() end;

let trim_head_non_zero(h: Bool, r: Bits, ne: is_cons(trim(r))) -> is_cons(trim(b[h, ..r])) =
    combine_non_zero(h, trim(r), ne);

let trim_head_true(r: Bits) -> is_cons(trim(b[1, ..r])) =
    combine_true_non_zero(trim(r));

-- | ===================== smart constructors =====================
pub let one: BigPos =
    BigPos { value = of_trimmed_bits(b[1], Eq/refl()), non_zero = True/qed() };

pub let dbl(t: BigPos) -> BigPos =
    BigPos {
        value =
            of_trimmed_bits(
                b[0, ..t.value.bits],
                cons_low_trimmed(false, t.value.bits, nz_trimmed(t), t.non_zero)),
        non_zero = True/qed(),
    };

pub let dbl_succ(t: BigPos) -> BigPos =
    BigPos {
        value =
            of_trimmed_bits(
                b[1, ..t.value.bits],
                cons_low_trimmed(true, t.value.bits, nz_trimmed(t), t.non_zero)),
        non_zero = True/qed(),
    };

-- | ===================== BigNat bridge =====================
-- | reflect a BigNat as zero-or-nonzero, rebuilding the BigPos certificate bit by bit through the smart constructors (recursion over BigNat's view, as in bit_len).
pub induct Split: pub Type
| zero()
| pos(BigPos)
end

pub let of_big_nat(a: BigNat) -> Split =
    match view(a)
    | zero() => Split/zero()
    | succ(low, tail) =>
        match of_big_nat(tail)
        | zero() => Split/pos(one)
        | pos(t) => match low | true => Split/pos(dbl_succ(t)) | false => Split/pos(dbl(t)) end
        end
    end;

-- | ===================== operations =====================
-- | Each operation is a facade: the module's namesake binding is the operation and the laws about it nest underneath — `BigPos/add` adds, `BigPos/add/assoc` is its associativity, `BigPos/add/trim_non_zero` the certificate transport it is built from. The helpers above are shared by more than one operation, so they stay here, private to this subtree.
pub mod add;
pub use add/{let add};

pub mod succ;
pub use succ/{let succ};

pub mod mul;
pub use mul/{let mul};

pub mod cmp;
pub use cmp/{let cmp};

satisfy Show(BigPos) {
    show(n) = BigNat/to_str(n.value),
}
