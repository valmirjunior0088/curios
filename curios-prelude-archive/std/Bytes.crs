pub use /sys/Bytes/{let Bytes, get, len, eql, slice};
use /std/{List, Nat, Byte, Bool, Option, Eq, Char, Str, Equal, Show, Spell, Ordering, Compare,
    Ordered};
use /std/Test/{Draw, Seed};

pub let try_get(b: Bytes, i: Nat) -> Option(Byte) =
    match i < len(b) | true => Option/some(get(b, i)) | false => Option/none() end;

-- Minimal big-endian bytes of `n` — empty for zero, no leading zero otherwise — so distinct naturals encode to distinct sequences, and the result serves as a map key under `Key(Bytes)`'s identity witness with no proof obligation of its own. The dividing recursion is `Nat/to_str`'s shape at base 256, and `of_nat`'s bound needs no refinement here: the reducer knows `n % 256` by its remainder bound, so the comparison decides definitionally and the proof is written nowhere.
pub let of_nat(n: Nat) -> Bytes =
    match n == 0 | true => x[] | false => x[..of_nat(n / 256), Byte/of_nat(n % 256)] end;

-- Everything from `k` on, which is what a window over "the rest" is: `slice`'s count is `len(b) - k`, and the bound that count needs is `k + (len(b) - k) <= len(b)` — an identity only under the hypothesis, since `Nat` subtraction truncates. Spending `Nat/Le/add_sub_cancel` here is what keeps every caller stating the fact it actually holds (`k` is inside `b`) rather than the one the primitive wants.
pub let drop(b: Bytes, k: Nat, @ok: Nat/Le(k, len(b))) -> Bytes =
    slice(
        b,
        k,
        len(b) - k,
        @Eq/subst(
            (x) => Nat/Le(x, len(b)),
            Eq/sym(Nat/Le/add_sub_cancel(k, len(b), ok)),
            Nat/Le/refl(len(b))));

pub let flatten(parts: List(Bytes)) -> Bytes =
    List/fold(parts, x[], (b, acc) => x[..acc, ..b]);

pub let fold(@A: Type, b: Bytes, init: A, f: (Byte, A) -> A) -> A =
    let n = len(b);
    let go(k: Nat, i: Nat, acc: A, inv: Eq(i + k, n)) -> A =
        match k
        | 0 => acc
        -- `i < n` transported along the loop invariant: `i + (kp + 1) = n` gives `i ≤ i + kp`, whose successor is the bound `at` demands.
        | kp + 1 =>
            let below =
                Eq/subst((x) => Nat/Lt(i, x), inv, Nat/Lt/succ_of_ind(Nat/Le/Ind/add_r(i, kp)));
            go(kp, i + 1, f(get(b, i, @below), acc), inv)
        end;
    go(n, 0, init, Eq/refl());

pub let find_index(b: Bytes, pred: (Byte) -> Bool) -> Option(Nat) =
    let (_, found): {Nat, Option(Nat)} =
        fold(
            b,
            (0, Option/none()),
            (byte, (i, found)) =>
                match found
                | some(_) => (i, found)
                | none() =>
                    (i + 1, match pred(byte) | true => Option/some(i) | false => Option/none() end)
                end);
    found;

pub let join(sep: Bytes, parts: List(Bytes)) -> Bytes =
    List/balanced(
        List/len(parts),
        x[],
        (i) => Option/unwrap_or(List/try_get(parts, i), x[]),
        (l, r) => x[..l, ..sep, ..r]);

-- Bytewise, the shorter prefix first. Each index is scrutinised against the length it reads through, which is what discharges `get`'s bound with nothing written.
pub let cmp(a: Bytes, b: Bytes) -> Ordering =
    let go(i: Nat) -> Ordering =
        match i < len(a)
        | false => match i < len(b) | true => Ordering/lt() | false => Ordering/eq() end
        | true =>
            match i < len(b)
            | false => Ordering/gt()
            | true =>
                let r = Nat/cmp(Byte/to_nat(get(a, i)), Byte/to_nat(get(b, i)));
                match r | eq() => go(i + 1) | _ => r end
            end
        end;
    go(0);

satisfy Equal(Bytes) {
    eql = eql,
    neq(a, b) = Bool/not(eql(a, b)),
}

satisfy Compare(Bytes) {
    lt(a, b) = Ordering/is_lt(cmp(a, b)),
    le(a, b) = Ordering/is_le(cmp(a, b)),
    gt(a, b) = Ordering/is_gt(cmp(a, b)),
    ge(a, b) = Ordering/is_ge(cmp(a, b)),
}

satisfy Ordered(Bytes) {
    cmp = cmp,
}

satisfy Show(Bytes) {
    show(b) =
        Option/unwrap_or(
            Str/of_bytes(
                fold(
                    b,
                    x[],
                    (byte, acc) =>
                        let n = Byte/to_nat(byte);
                        let hi = Char/to_utf8(Char/hex_digit(n / 0x10));
                        let lo = Char/to_utf8(Char/hex_digit(n % 0x10));
                        x[..acc, ..hi, ..lo])),
            ""),
}

satisfy Spell(Bytes) {
    spell(b) =
        let parts = fold(b, [], (byte, acc) => [..acc, Nat/to_str(Byte/to_nat(byte))]);
        Str/concat("x[", Str/concat(Str/join(", ", parts), "]")),
}

let bytes(seed: Seed, count: Nat) -> {Bytes, Seed} =
    match count
    | 0 => (x[], seed)
    | more + 1; (acc, after) =>
        let (byte, rest) = Draw/draw(@Byte, after, 0);
        (x[..acc, byte], rest)
    end;

satisfy Draw(Bytes) {
    all() = Option/none(),
    draw(seed, size) =
        let (count, after) = Draw/draw(@Nat, seed, size);
        bytes(after, count),
}
