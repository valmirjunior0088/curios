pub use /sys/Bytes/{let Bytes, get, len, eql, slice, replicate, and, or, xor, to_bits};
use /std/{List, Nat, Byte, Bool, Option, Eq, Char, Str, Show, Spell, Ordering, Ord};
use /std/ops/{Eql, Cmp};

--- The byte at `i`, or `none` past the end.
pub let try_get(b: Bytes, i: Nat) -> Option(Byte) =
    match i < len(b) | true => Option/some(get(b, i)) | false => Option/none() end;

--- The minimal encoding of `n`, least-significant byte first as the carrier reads: empty for zero, no trailing zero otherwise, so distinct numbers encode distinctly.
---
--- A direct cons, which is the shape `x[h, ..t]` builds and the shape `to_nat` folds back. The big-endian spelling this replaced was a snoc under the same plain name, which is why the carrier had no way to read a run back and why taking one apart needed a window at the far seam rather than the eliminator's own.
pub let of_nat(n: Nat) -> Bytes =
    match n == 0 | true => x[] | false => x[Nat/to_byte(n % 256), ..of_nat(n / 256)] end;

--- The number a minimal encoding denotes, which is `of_nat`'s inverse.
---
--- One structural fold, because the least significant byte arrives first and carries a weight the fold already knows. Reading a big-endian run back needs the length before it can weigh its first byte, which is the whole reason this did not exist before.
pub let to_nat(b: Bytes) -> Nat =
    match b | x[] => 0 | x[h, .._]; ih => Byte/to_nat(h) + 256 * ih end;

-- A number as a base-256 high part and a low digit, with the equation joining them.
--
-- The decomposition `of_nat` recurses on, carried as evidence rather than recomputed. `n / 256` and `n % 256` read off `joined` by the division split alone — the residual is a `Byte`, whose carrier bound is what lets the split fire — so Euclid's recombination below is one substitution and needs no law of its own.
struct Split(n: Nat): Type {
    high: Nat,
    low: Byte,
    joined: Eq(n, 256 * high + Byte/to_nat(low)),
}

-- Every number has one, by successor induction.
--
-- The step decides whether the digit has filled. The bump branch discharges its own bound by the arm's refinement, `Lt(d + 1, 256)` being `Lt(d, 255)` after cancellation; the carry branch is where the digit is known to be `255`, which takes both directions of the order — `le_of_not_lt` for the half the guard refuted and the carrier's own bound for the other.
let split(n: Nat) -> Split(n) =
    match n
    | 0 => Split { high = 0, low = 0, joined = Eq/refl() }
    | p + 1; prev =>
        match Byte/to_nat(prev.low) < 255
        | true =>
            Split {
                high = prev.high,
                low = Nat/to_byte(Byte/to_nat(prev.low) + 1),
                joined = Eq/cong((x) => x + 1, prev.joined),
            }
        | false =>
            let filled: Eq(Byte/to_nat(prev.low), 255) =
                Nat/Le/antisym(
                    Byte/to_nat(prev.low),
                    255,
                    Nat/Lt/le_succ_of_lt(Byte/to_nat(prev.low), 256, Bool/True/qed()),
                    Nat/Lt/le_of_not_lt(Byte/to_nat(prev.low), 255, Bool/True/qed()));
            Split {
                high = prev.high + 1,
                low = 0,
                joined =
                    Eq/cong(
                        (x) => x + 1,
                        Eq/subst((d) => Eq(p, 256 * prev.high + d), filled, prev.joined)),
            }
        end
    end;

-- Euclid's recombination at the encoding's radix.
let euclid(n: Nat) -> Eq(256 * (n / 256) + n % 256, n) =
    Eq/subst((m) => Eq(256 * (m / 256) + m % 256, m), Eq/sym(split(n).joined), Eq/refl());

-- The recursion `of_nat` performs terminates, which is what lets injectivity recurse the same way.
let high_below(n: Nat, positive: Nat/Lt(0, n)) -> Nat/Lt(n / 256, n) =
    let s = split(n);
    let p: Nat/Lt(0, 256 * s.high + Byte/to_nat(s.low)) =
        Eq/subst((m) => Nat/Lt(0, m), s.joined, positive);
    let inner: Nat/Lt(s.high, 256 * s.high + Byte/to_nat(s.low)) =
        match s.high: (h) => Nat/Lt(h, 256 * h + Byte/to_nat(s.low))
        | 0 => p
        | _ + 1 => Bool/True/qed()
        end;
    Eq/subst((m) => Nat/Lt(m / 256, m), Eq/sym(s.joined), inner);

-- The two halves of a cons, as total functions so congruence can take one apart.
--
-- Both are guarded rather than bounded at the call: congruence needs one function of the whole value, and a bound stated over an arbitrary `Bytes` has nothing to discharge it. On the encoding's own shape the guard reduces and the window locates, which is all either is used at.
let tail(z: Bytes) -> Bytes =
    match 1 + (len(z) - 1) <= len(z) | true => slice(z, 1, len(z) - 1) | false => x[] end;

let head(z: Bytes) -> Byte =
    Option/unwrap_or(try_get(z, 0), 0);

-- An empty encoding is no encoding of a positive number: the lengths differ, and a length of zero against a successor is refuted by the comparison that decides it.
let no_empty(k: Byte, p: Bytes, e: Eq(x[], x[k, ..p])) -> Bool/False =
    Eq/subst((m) => Bool/Holds(Nat/eql(0, m)), Eq/cong(len, e), Bool/True/qed());

--- Distinct numbers encode distinctly, which is what makes the encoding a key.
---
--- Course-of-values induction, because the recursion divides rather than decrements. Each step takes the encoding apart at its first byte — the digit by an index at it, the rest by a window past it — recovers the two numbers' high parts from the induction hypothesis and their low digits from the byte round trip, and rejoins both by Euclid's recombination.
pub let of_nat_injective(a: Nat, b: Nat, same: Eq(of_nat(a), of_nat(b))) -> Eq(a, b) =
    Nat/Lt/strong(
        (m) => (d: Nat, e: Eq(of_nat(m), of_nat(d))) -> Eq(m, d),
        (n, ih) =>
            (d, e) =>
                match n
                | 0 =>
                    match d
                    | 0 => Eq/refl()
                    | dp + 1 =>
                        match no_empty(Nat/to_byte((dp + 1) % 256), of_nat((dp + 1) / 256), e) end
                    end
                | np + 1 =>
                    match d
                    | 0 =>
                        match no_empty(
                            Nat/to_byte((np + 1) % 256),
                            of_nat((np + 1) / 256),
                            Eq/sym(e))
                        end
                    | dq + 1 =>
                        let heads: Eq(of_nat((np + 1) / 256), of_nat((dq + 1) / 256)) =
                            Eq/cong(tail, e);
                        let digits: Eq((np + 1) % 256, (dq + 1) % 256) =
                            Eq/cong(Byte/to_nat, Eq/cong(head, e));
                        let highs: Eq((np + 1) / 256, (dq + 1) / 256) =
                            ih((np + 1) / 256, high_below(np + 1, Bool/True/qed()))(
                                (dq + 1) / 256,
                                heads);
                        let rejoined: Eq(
                            256 * ((np + 1) / 256) + (np + 1) % 256,
                            256 * ((dq + 1) / 256) + (dq + 1) % 256) =
                            Eq/subst(
                                (y) =>
                                    Eq(
                                        256 * ((np + 1) / 256) + (np + 1) % 256,
                                        256 * ((dq + 1) / 256) + y),
                                digits,
                                Eq/subst(
                                    (x) =>
                                        Eq(
                                            256 * ((np + 1) / 256) + (np + 1) % 256,
                                            256 * x + (np + 1) % 256),
                                    highs,
                                    Eq/refl()));
                        Eq/trans(Eq/sym(euclid(np + 1)), Eq/trans(rejoined, euclid(dq + 1)))
                    end
                end,
        a)(b, same);

--- Everything from `k` on, under the evidence that `k` is within the length.
pub let drop(b: Bytes, k: Nat, @ok: Nat/Le(k, len(b))) -> Bytes =
    slice(
        b,
        k,
        len(b) - k,
        @Eq/subst(
            (x) => Nat/Le(x, len(b)),
            Eq/sym(Nat/Le/add_sub_cancel(k, len(b), ok)),
            Nat/Le/refl(len(b))));

--- Every bit of every byte flipped.
---
--- An `xor` against a run of all-ones bytes as long as this one, so the width is a fact about the operand rather than a number written here. `Bytes/len` reduces a fill to its own count, so the equal-length bound the `xor` states discharges without a guard.
pub let not(b: Bytes) -> Bytes =
    xor(b, replicate(len(b), 0xFF));

--- `b` moved `count` bytes toward the high end, zero bytes entering at the low end and whatever passes the top discarded.
---
--- Under the carrier's reading — least significant first, which is what `of_nat` writes — that is multiplication by 256 to the `count`, at the run's own width. A count past the length answers all zeros rather than a shorter run: the width belongs to the value.
---
--- Whole bytes, not bits. A byte string has no finer position to move by, and the bit-granular question is `Bits`'s to answer — `to_bits` is the way across.
pub let shl(b: Bytes, count: Nat) -> Bytes =
    match Nat/le(count, len(b))
    | true => x[..replicate(count, 0x00), ..slice(b, 0, len(b) - count)]
    | false => replicate(len(b), 0x00)
    end;

--- `b` moved `count` bytes toward the low end, zero bytes entering at the high end.
pub let shr(b: Bytes, count: Nat) -> Bytes =
    match Nat/le(count, len(b))
    | true => x[..drop(b, count), ..replicate(count, 0x00)]
    | false => replicate(len(b), 0x00)
    end;

--- `b` rotated `count` bytes toward the high end, what passes the top re-entering at the bottom.
---
--- The count is taken modulo the width, which is what makes this total without a guard on the count itself; the empty run is the one case with no width to take it modulo, and rotating it is the identity.
pub let rotl(b: Bytes, count: Nat) -> Bytes =
    match Nat/lt(0, len(b))
    | true =>
        let keep = len(b) - Nat/rem(count, len(b));
        x[..drop(b, keep), ..slice(b, 0, keep)]
    | false => b
    end;

--- `b` rotated `count` bytes toward the low end.
pub let rotr(b: Bytes, count: Nat) -> Bytes =
    match Nat/lt(0, len(b))
    | true =>
        let places = Nat/rem(count, len(b));
        x[..drop(b, places), ..slice(b, 0, places)]
    | false => b
    end;

--- The concatenation, in order.
pub let flatten(parts: List(Bytes)) -> Bytes =
    List/fold(parts, x[], (b, acc) => x[..acc, ..b]);

--- Left to right with `f(byte, acc)`.
pub let fold(@A: Type, b: Bytes, init: A, f: (Byte, A) -> A) -> A =
    let n = len(b);
    let go(k: Nat, i: Nat, acc: A, inv: Eq(i + k, n)) -> A =
        match k
        | 0 => acc
        | kp + 1 =>
            let below = Eq/subst((x) => Nat/Lt(i, x), inv, Bool/True/qed());
            go(kp, i + 1, f(get(b, i, @below), acc), inv)
        end;
    go(n, 0, init, Eq/refl());

--- The index of the first byte `pred` accepts, or `none`.
pub let find_index(b: Bytes, pred: (Byte) -> Bool) -> Option(Nat) =
    let (_, found): {Nat, Option(Nat)} =
        fold(
            b,
            (0, Option/none()),
            (byte, (i, found)) =>
                match found
                | some(_) => (i, found)
                | none() =>
                    (i + 1, match pred(byte) | true => Option/some(i) | false => Option/none() end)
                end);
    found;

--- The index of the first byte equal to `x`, or `none`.
pub let index_of(b: Bytes, x: Byte) -> Option(Nat) =
    find_index(b, (y) => y == x);

--- Whether `x` occurs in `b`.
pub let contains(b: Bytes, x: Byte) -> Bool =
    Option/is_some(index_of(b, x));

--- `parts` with `sep` between each pair.
pub let join(sep: Bytes, parts: List(Bytes)) -> Bytes =
    List/balanced(
        List/len(parts),
        x[],
        (i) => Option/unwrap_or(List/try_get(parts, i), x[]),
        (l, r) => x[..l, ..sep, ..r]);

--- Bytewise, a proper prefix first.
pub let cmp(a: Bytes, b: Bytes) -> Ordering =
    let go(i: Nat) -> Ordering =
        match i < len(a)
        | false => match i < len(b) | true => Ordering/lt() | false => Ordering/eq() end
        | true =>
            match i < len(b)
            | false => Ordering/gt()
            | true =>
                let r = Nat/cmp(Byte/to_nat(get(a, i)), Byte/to_nat(get(b, i)));
                match r | eq() => go(i + 1) | _ => r end
            end
        end;
    go(0);

satisfy Eql(Bytes) {
    eql = eql,
    neq(a, b) = Bool/not(eql(a, b)),
}

satisfy Cmp(Bytes) {
    lt(a, b) = Ordering/is_lt(cmp(a, b)),
    le(a, b) = Ordering/is_le(cmp(a, b)),
    gt(a, b) = Ordering/is_gt(cmp(a, b)),
    ge(a, b) = Ordering/is_ge(cmp(a, b)),
}

satisfy Ord(Bytes) {
    ord = cmp,
}

--- Hexadecimal, two digits per byte.
satisfy Show(Bytes) {
    show(b) =
        Option/unwrap_or(
            Str/of_bytes(
                fold(
                    b,
                    x[],
                    (byte, acc) =>
                        let n = Byte/to_nat(byte);
                        let hi = Char/to_utf8(Char/hex_digit(n / 0x10));
                        let lo = Char/to_utf8(Char/hex_digit(n % 0x10));
                        x[..acc, ..hi, ..lo])),
            ""),
}

satisfy Spell(Bytes) {
    spell(b) =
        let parts = fold(b, [], (byte, acc) => [..acc, Nat/to_str(Byte/to_nat(byte))]);
        Str/concat("x[", Str/concat(Str/join(", ", parts), "]")),
}
