use /std/{Bits, Bool, BigNat, BigPos};
use /std/BigPos/{is_cons};

let raw_cons(x: Bits) -> is_cons(BigNat/succ/raw(x)) =
    match x
    | b[] => Bool/True/qed()
    | b[xh, .._] => match xh | true => Bool/True/qed() | false => Bool/True/qed() end
    end;

--- The successor.
pub let succ(p: BigPos) -> BigPos =
    BigPos { value = BigNat/succ(p.value), non_zero = raw_cons(p.value.bits) };
