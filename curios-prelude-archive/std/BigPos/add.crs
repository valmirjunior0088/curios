use /std/{Bool, Bits, Eq, True, BigNat, BigPos};
use /std/Bool/{false_neq_true};
use /std/BigNat/{is_trimmed, trim, xor3, maj3};
use /std/BigPos/{is_cons, trim_head_non_zero, trim_head_true};

let raw_cons(x: Bits, y: Bits, c: Bool, ne: is_cons(x)) -> is_cons(BigNat/add/raw(x, y, c)) =
    match x: (r) => is_cons(BigNat/add/raw(r, y, c))
    | b[] => match ne end
    | b[xh, ..xt] =>
        match y: (yy) => is_cons(BigNat/add/raw(b[xh, ..xt], yy, c))
        | b[] => True/qed()
        | b[_, .._] => True/qed()
        end
    end;

let carry_non_zero(x: Bits) -> is_cons(trim(BigNat/add/raw(b[], x, true))) =
    match x
    | b[] => True/qed()
    | b[xh, ..xt] =>
        match xh
        | true => trim_head_non_zero(false, BigNat/add/raw(b[], xt, true), carry_non_zero(xt))
        | false => trim_head_true(BigNat/add/raw(b[], xt, false))
        end
    end;

-- | A nonempty word stays nonempty through a trim.
pub let trim_non_zero(
    a: Bits,
    b: Bits,
    c: Bool,
    tr: Eq(is_trimmed(a), true),
    ne: is_cons(a),
) -> is_cons(trim(BigNat/add/raw(a, b, c))) =
    match a
    | b[] => match ne end
    | b[ah, ..at] =>
        match at
        | b[] =>
            match ah
            | true =>
                match b
                | b[] => match c | false => True/qed() | true => True/qed() end
                | b[bh, ..bt] =>
                    match bh
                    | true =>
                        match c
                        | true => trim_head_true(BigNat/add/raw(b[], bt, true))
                        | false =>
                            trim_head_non_zero(
                                false,
                                BigNat/add/raw(b[], bt, true),
                                carry_non_zero(bt))
                        end
                    | false =>
                        match c
                        | true =>
                            trim_head_non_zero(
                                false,
                                BigNat/add/raw(b[], bt, true),
                                carry_non_zero(bt))
                        | false => trim_head_true(BigNat/add/raw(b[], bt, false))
                        end
                    end
                end
            | false => match false_neq_true(tr) end
            end
        | b[_ath, .._att] =>
            match b
            | b[] =>
                trim_head_non_zero(
                    xor3(ah, false, c),
                    BigNat/add/raw(at, b[], maj3(ah, false, c)),
                    trim_non_zero(at, b[], maj3(ah, false, c), tr, True/qed()))
            | b[bh, ..bt] =>
                trim_head_non_zero(
                    xor3(ah, bh, c),
                    BigNat/add/raw(at, bt, maj3(ah, bh, c)),
                    trim_non_zero(at, bt, maj3(ah, bh, c), tr, True/qed()))
            end
        end
    end;

-- | The sum.
pub let add(p: BigPos, q: BigPos) -> BigPos =
    BigPos {
        value = p.value + q.value,
        non_zero = raw_cons(p.value.bits, q.value.bits, false, p.non_zero),
    };

-- | Commutativity.
pub let comm(p: BigPos, q: BigPos) -> Eq(add(p, q), add(q, p)) =
    BigPos/eq(add(p, q), add(q, p), BigNat/add/comm(p.value, q.value));

-- | Associativity.
pub let assoc(p: BigPos, q: BigPos, r: BigPos) -> Eq(add(add(p, q), r), add(p, add(q, r))) =
    BigPos/eq(add(add(p, q), r), add(p, add(q, r)), BigNat/add/assoc(p.value, q.value, r.value));
