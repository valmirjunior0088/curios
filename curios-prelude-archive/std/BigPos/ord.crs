use /std/{Ordering, Eq, BigNat, BigPos};
use /std/Ordering/{cong_flip};

--- The order of the two.
pub let ord(p: BigPos, q: BigPos) -> Ordering =
    BigNat/ord(p.value, q.value);

--- A positive compares equal to itself.
pub let refl(p: BigPos) -> Eq(ord(p, p), Ordering/eq()) =
    BigNat/ord/refl(p.value);

--- Positives that compare equal are equal.
pub let to_eq(p: BigPos, q: BigPos, w: Eq(ord(p, q), Ordering/eq())) -> Eq(p, q) =
    BigPos/eq(p, q, BigNat/ord/to_eq(p.value, q.value, w));

--- Swapping the operands flips the answer.
pub let flip(p: BigPos, q: BigPos) -> Eq(ord(q, p), Ordering/flip(ord(p, q))) =
    BigNat/ord/flip(p.value, q.value);

--- Transitivity.
pub let trans(
    p: BigPos,
    q: BigPos,
    r: BigPos,
    u: Eq(ord(p, q), Ordering/lt()),
    v: Eq(ord(q, r), Ordering/lt()),
) -> Eq(ord(p, r), Ordering/lt()) =
    BigNat/ord/trans(p.value, q.value, r.value, u, v);

--- `gt` one way is `lt` the other.
pub let gt_to_lt(
    p: BigPos,
    q: BigPos,
    w: Eq(ord(p, q), Ordering/gt()),
) -> Eq(ord(q, p), Ordering/lt()) =
    Eq/trans(flip(p, q), cong_flip(w));
