-- The filesystem beyond a file's contents: what is at a path, the names in a directory, and making, moving and removing things. Every row carries `Bytes` paths as `file/open` does, and a listing and the working directory come back as the bytes the host holds — a name that is not UTF-8 is the caller's to decode or refuse, so nothing here decodes. The rows are synchronous and hold no handle, but the functions are `Async` as `File/open` is, so one region mixes them freely. The release targets are Linux and macOS, so the path functions at the end take `/` as the one separator.
use /std/{Nat, Bool, Str, Bytes, List, Option, Result, Handle, Async, Io, Eql, Show};
use /std/time/{Timestamp};

pub induct Kind: pub Type
| file()
| directory()
| symlink()
| other()
end

satisfy Eql(Kind);

satisfy Show(Kind) {
    show(k) =
        match k
        | file() => "file"
        | directory() => "directory"
        | symlink() => "symlink"
        | other() => "other"
        end,
}

let kind_of(code: Nat) -> Kind =
    choose
    | code == /sys/kind/file => Kind/file()
    | code == /sys/kind/directory => Kind/directory()
    | code == /sys/kind/symlink => Kind/symlink()
    | _ => Kind/other()
    end;

-- `size` is the pair of base-10⁹ limbs the row hands over: a `Nat` cannot hold a file size at runtime and `BigNat` is more than a size needs. `size_nat` reads it inside the envelope. `mtime` is a `Timestamp`, a moment with a meaning, not an `Instant`, which is a reading of the monotonic clock and could not compare with one.
pub struct Metadata: pub Type {
    kind: Kind,
    size: {hi: Nat, lo: Nat},
    mtime: Timestamp,
}

pub let size_nat(m: Metadata) -> Option(Nat) =
    match m.size.hi == 0 | true => Option/some(m.size.lo) | false => Option/none() end;

let outcome(status: Nat) -> Result({}, Handle/Error) =
    match Handle/error_of(status) | some(e) => Result/failure(e) | none() => Result/success(()) end;

pub let stat(path: Str) -> Async(Result(Metadata, Handle/Error)) =
    let r = /sys/file/stat(Str/to_bytes(path))!;
    Async/pure(
        match Handle/error_of(r.status)
        | some(e) => Result/failure(e)
        | none() =>
            Result/success(
                Metadata {
                    kind = kind_of(r.kind),
                    size = (hi = r.size_hi, lo = r.size_lo),
                    mtime = Timestamp/of_unix(r.mtime_hi, r.mtime_lo, r.mtime_nanos),
                })
        end);

-- `not_found` is the answer `false`; every other failure is the failure it is.
let kind_is(path: Str, want: (Kind) -> Bool) -> Async(Result(Bool, Handle/Error)) =
    let r = stat(path)!;
    Async/pure(
        match r
        | success(m) => Result/success(want(m.kind))
        | failure(e) => match e | not_found() => Result/success(false) | _ => Result/failure(e) end
        end);

pub let exists(path: Str) -> Async(Result(Bool, Handle/Error)) =
    kind_is(path, (k) => true);

pub let is_file(path: Str) -> Async(Result(Bool, Handle/Error)) =
    kind_is(path, (k) => k == Kind/file());

pub let is_dir(path: Str) -> Async(Result(Bool, Handle/Error)) =
    kind_is(path, (k) => k == Kind/directory());

pub let list(path: Str) -> Async(Result(List(Bytes), Handle/Error)) =
    let r = /sys/dir/list(Str/to_bytes(path))!;
    Async/pure(
        match Handle/error_of(r.status)
        | some(e) => Result/failure(e)
        | none() => Result/success(r.names)
        end);

pub let create_dir(path: Str) -> Async(Result({}, Handle/Error)) =
    let status = /sys/dir/create(Str/to_bytes(path))!;
    Async/pure(outcome(status));

pub let remove_dir(path: Str) -> Async(Result({}, Handle/Error)) =
    let status = /sys/dir/remove(Str/to_bytes(path))!;
    Async/pure(outcome(status));

pub let remove_file(path: Str) -> Async(Result({}, Handle/Error)) =
    let status = /sys/file/remove(Str/to_bytes(path))!;
    Async/pure(outcome(status));

pub let rename(from: Str, to: Str) -> Async(Result({}, Handle/Error)) =
    let status = /sys/file/rename(Str/to_bytes(from), Str/to_bytes(to))!;
    Async/pure(outcome(status));

pub let cwd: Async(Result(Bytes, Handle/Error)) =
    let r = /sys/proc/cwd!;
    Async/pure(
        match Handle/error_of(r.status)
        | some(e) => Result/failure(e)
        | none() => Result/success(r.path)
        end);

-- `a/b`, with one separator between them whatever `a` ends in; an empty side is the other side.
pub let join(a: Str, b: Str) -> Str =
    choose
    | Str/is_empty(a) => b
    | Str/is_empty(b) => a
    | Str/ends_with(a, "/") => Str/concat(a, b)
    | _ => Str/flatten([a, "/", b])
    end;

-- The last component, which a listing's entry is; empty after a trailing separator.
pub let name(p: Str) -> Str =
    Option/unwrap_or(List/last(Str/split(p, "/")), "");

-- Everything before the last separator: `none` for a bare name, and `/` itself for a child of the root.
pub let parent(p: Str) -> Option(Str) =
    let parts = Str/split(p, "/");
    let n = List/len(parts);
    match n < 2
    | true => Option/none()
    | false =>
        let above = Str/join("/", List/take(parts, n - 1));
        Option/some(match Str/is_empty(above) | true => "/" | false => above end)
    end;

-- The text after the last `.` of the name, when the name has one that is not its first character: `.bashrc` has none and `archive.tar.gz` has `gz`.
pub let extension(p: Str) -> Option(Str) =
    let parts = Str/split(name(p), ".");
    let n = List/len(parts);
    choose
    | n < 2 => Option/none()
    | n == 2 && Str/is_empty(Option/unwrap_or(List/try_get(parts, 0), "")) => Option/none()
    | _ => List/last(parts)
    end;

-- Every prefix of `path` created in turn, one that already exists left as it is. Written over the rows with no row of its own, since a majority of the surveyed libraries ship it and the host pays nothing for it.
pub let create_dir_all(path: Str) -> Async(Result({}, Handle/Error)) =
    let go(prefix: Str, parts: List(Str)) -> Async(Result({}, Handle/Error)) =
        match parts
        | [] => Async/pure(Result/success(()))
        | [part, ..rest] =>
            let next =
                choose
                | Str/is_empty(prefix) && Str/is_empty(part) => "/"
                | _ => join(prefix, part)
                end;
            let r = create_dir(next)!;
            match r
            | success(_) => go(next, rest)
            | failure(e) =>
                match e | exists() => go(next, rest) | _ => Async/pure(Result/failure(e)) end
            end
        end;
    go("", Str/split(path, "/"));

-- Everything at `path`, a directory's entries first. Written over the rows at `Bytes`, so a name that is not UTF-8 is removed like any other.
pub let remove_all(path: Str) -> Async(Result({}, Handle/Error)) =
    remove_all_bytes(Str/to_bytes(path));

let remove_all_bytes(path: Bytes) -> Async(Result({}, Handle/Error)) =
    let s = /sys/file/stat(path)!;
    match Handle/error_of(s.status)
    | some(e) => Async/pure(Result/failure(e))
    | none() =>
        match s.kind == /sys/kind/directory
        | false =>
            let status = /sys/file/remove(path)!;
            Async/pure(outcome(status))
        | true =>
            let l = /sys/dir/list(path)!;
            match Handle/error_of(l.status)
            | some(e) => Async/pure(Result/failure(e))
            | none() =>
                let r = remove_each(path, l.names)!;
                match r
                | failure(e) => Async/pure(Result/failure(e))
                | success(_) =>
                    let status = /sys/dir/remove(path)!;
                    Async/pure(outcome(status))
                end
            end
        end
    end
and remove_each(dir: Bytes, names: List(Bytes)) -> Async(Result({}, Handle/Error)) =
    match names
    | [] => Async/pure(Result/success(()))
    | [name, ..rest] =>
        let r = remove_all_bytes(x[..dir, '/', ..name])!;
        match r
        | failure(e) => Async/pure(Result/failure(e))
        | success(_) => remove_each(dir, rest)
        end
    end;
