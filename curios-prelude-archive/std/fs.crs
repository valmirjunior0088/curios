use /std/{Nat, Bool, List, Option, Path, Try, Io, Equal, Show};
use /std/time/{Timestamp};

-- | What is at a path.
pub induct Kind: pub Type
| file()
| directory()
| symlink()
| other()
end

satisfy Equal(Kind);

satisfy Show(Kind) {
    show(k) =
        match k
        | file() => "file"
        | directory() => "directory"
        | symlink() => "symlink"
        | other() => "other"
        end,
}

let kind_of(code: Nat) -> Kind =
    choose
    | code == /sys/file_kind/file => Kind/file()
    | code == /sys/file_kind/directory => Kind/directory()
    | code == /sys/file_kind/symlink => Kind/symlink()
    | _ => Kind/other()
    end;

-- | What `stat` reports.
pub struct Metadata: pub Type {
    kind: Kind,
    -- | The size in bytes, as two base-billion limbs.
    size: {hi: Nat, lo: Nat},
    -- | When the contents last changed.
    mtime: Timestamp,
}

-- | The size as one number, or `none` past the carrier.
pub let size_nat(m: Metadata) -> Option(Nat) =
    match m.size.hi == 0 | true => Option/some(m.size.lo) | false => Option/none() end;

let outcome(status: Nat) -> Try(Io, Io/Error, {}) =
    match Io/Error/of(status) | some(e) => Try/raise(e) | none() => Try/pure(()) end;

-- | What is at `path`.
pub let stat(path: Path) -> Try(Io, Io/Error, Metadata) =
    let r = /sys/file/stat(Path/to_bytes(path))!;
    match Io/Error/of(r.status)
    | some(e) => Try/raise(e)
    | none() =>
        Try/pure(
            Metadata {
                kind = kind_of(r.kind),
                size = (hi = r.size_hi, lo = r.size_lo),
                mtime = Timestamp/of_unix(r.mtime_hi, r.mtime_lo, r.mtime_nanos),
            })
    end;

let kind_is(path: Path, want: (Kind) -> Bool) -> Try(Io, Io/Error, Bool) =
    let r = Try/run(stat(path))!;
    match r
    | success(m) => Try/pure(want(m.kind))
    | failure(e) => match e | not_found() => Try/pure(false) | _ => Try/raise(e) end
    end;

-- | Whether anything is at `path`.
pub let exists(path: Path) -> Try(Io, Io/Error, Bool) =
    kind_is(path, (_k) => true);

-- | Whether a regular file is at `path`.
pub let is_file(path: Path) -> Try(Io, Io/Error, Bool) =
    kind_is(path, (k) => k == Kind/file());

-- | Whether a directory is at `path`.
pub let is_dir(path: Path) -> Try(Io, Io/Error, Bool) =
    kind_is(path, (k) => k == Kind/directory());

-- | The entries' names, each a `Path` that `Path/join` puts back under `path`.
pub let list(path: Path) -> Try(Io, Io/Error, List(Path)) =
    let r = /sys/dir/list(Path/to_bytes(path))!;
    match Io/Error/of(r.status)
    | some(e) => Try/raise(e)
    | none() => Try/pure(List/map(r.names, Path/of_bytes))
    end;

-- | A directory at `path`, whose parent must exist.
pub let create_dir(path: Path) -> Try(Io, Io/Error, {}) =
    let status = /sys/dir/create(Path/to_bytes(path))!;
    outcome(status);

-- | Remove the empty directory at `path`.
pub let remove_dir(path: Path) -> Try(Io, Io/Error, {}) =
    let status = /sys/dir/remove(Path/to_bytes(path))!;
    outcome(status);

-- | Remove the file at `path`.
pub let remove_file(path: Path) -> Try(Io, Io/Error, {}) =
    let status = /sys/file/remove(Path/to_bytes(path))!;
    outcome(status);

-- | Move what is at `from` to `to`.
pub let rename(from: Path, to: Path) -> Try(Io, Io/Error, {}) =
    let status = /sys/file/rename(Path/to_bytes(from), Path/to_bytes(to))!;
    outcome(status);

-- | The working directory.
pub let cwd: Try(Io, Io/Error, Path) =
    let r = /sys/proc/cwd!;
    match Io/Error/of(r.status)
    | some(e) => Try/raise(e)
    | none() => Try/pure(Path/of_bytes(r.path))
    end;

-- | A directory at `path` and every missing parent; one that already exists is left as it is.
pub let create_dir_all(path: Path) -> Try(Io, Io/Error, {}) =
    let r = Try/run(create_dir(path))!;
    match r
    | success(_) => Try/pure(())
    | failure(e) =>
        match e
        | exists() => Try/pure(())
        | not_found() =>
            match Path/parent(path)
            | some(parent) =>
                let _ = create_dir_all(parent)!;
                create_dir(path)
            | none() => Try/raise(e)
            end
        | _ => Try/raise(e)
        end
    end;

-- | Remove what is at `path`, a directory's entries first.
pub let remove_all(path: Path) -> Try(Io, Io/Error, {}) =
    let m = stat(path)!;
    match m.kind
    | directory() =>
        let entries = list(path)!;
        let _ = remove_each(path, entries)!;
        remove_dir(path)
    | _ => remove_file(path)
    end
and remove_each(dir: Path, entries: List(Path)) -> Try(Io, Io/Error, {}) =
    match entries
    | [] => Try/pure(())
    | [entry, ..rest] =>
        let _ = remove_all(Path/join(dir, entry))!;
        remove_each(dir, rest)
    end;
