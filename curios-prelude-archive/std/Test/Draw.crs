use /std/{Nat, Option, List};
use /std/Test/{Seed};

-- | How a value of `A` is drawn for a property test.
pub concept Draw(A: Type): pub Type {
    -- | Every value, when the type is small enough to enumerate; `none` otherwise.
    all() -> Option(List(A)),
    -- | One value no larger than the size admits, and the seed after it.
    draw(Seed, Nat) -> {A, Seed},
}

pub use Draw/*;
