use /std/{Nat, Bool, Bytes, Str, List, Map, Result};
use /std/Toml/{Toml, Seg, State, let Build};

induct Act: Type
| act_table()
| act_many()
| act_value(Toml)
end

pub let build_empty: Build =
    Build { root = Map/empty(), side = Map/empty(), scope = [] };

let seg_key(pre: Bytes, seg: Seg) -> Bytes =
    match seg
    | plain(name) =>
        let nb = Str/to_bytes(name);
        x[..pre, 0x70, ..Str/to_bytes(Nat/to_str(Bytes/len(nb))), 0x3A, ..nb]
    | at(name, index) =>
        let nb = Str/to_bytes(name);
        x[
            ..pre,
            0x61,
            ..Str/to_bytes(Nat/to_str(Bytes/len(nb))),
            0x3A,
            ..nb,
            0x23,
            ..Str/to_bytes(Nat/to_str(index)),
            0x3B]
    end;

let seg_name(seg: Seg) -> Str =
    match seg | plain(name) => name | at(name, _) => name end;

let replace_at(
    items: List(Toml),
    index: Nat,
    ok: Nat/Lt(index, List/len(items)),
    value: Toml,
) -> List(Toml) =
    let count = List/len(@Toml, items);
    [
        ..List/slice(@Toml, items, 0, index, @Nat/Lt/le_of_lt(index, count, ok)),
        value,
        ..List/drop(@Toml, items, index + 1, @Nat/Lt/le_succ_of_lt(index, count, ok))];

let may_extend(side: Map(State), kp: Bytes, act: Act) -> Result(Str, {}) =
    match Map/get(side, kp)
    | some(st) =>
        match act
        | act_value(_) =>
            match st
            | dotted() => Result/success(())
            | inline() => Result/failure("cannot extend an inline table")
            | _ => Result/failure("cannot extend a table defined elsewhere with dotted keys")
            end
        | _ =>
            match st
            | header() => Result/success(())
            | implicit() => Result/success(())
            | dotted() => Result/failure("cannot extend a table created by dotted keys")
            | _ => Result/failure("cannot extend an inline table")
            end
        end
    | none() => Result/failure("cannot extend an inline table")
    end;

let walk_final(
    m: Map(Toml),
    side: Map(State),
    pre: Bytes,
    name: Str,
    act: Act,
) -> Result(Str, {Map(Toml), Map(State), List(Seg)}) =
    let kf = seg_key(pre, Seg/plain(name));
    match act
    | act_table() =>
        match Map/get(m, name)
        | none() =>
            Result/success(
                (
                    Map/insert(m, name, Toml/table(Map/empty())),
                    Map/insert(side, kf, State/header()),
                    [Seg/plain(name)]))
        | some(existing) =>
            match existing
            | table(_) =>
                match Map/get(side, kf)
                | some(st) =>
                    match st
                    | implicit() =>
                        Result/success((m, Map/insert(side, kf, State/header()), [Seg/plain(name)]))
                    | header() => Result/failure("table defined more than once")
                    | dotted() => Result/failure("cannot redefine a table created by dotted keys")
                    | _ => Result/failure("cannot extend an inline table")
                    end
                | none() => Result/failure("cannot extend an inline table")
                end
            | arr(_) => Result/failure("cannot redefine an array as a table")
            | _ => Result/failure("key conflicts with an existing value")
            end
        end
    | act_many() =>
        match Map/get(m, name)
        | none() =>
            Result/success(
                (
                    Map/insert(m, name, Toml/arr([Toml/table(Map/empty())])),
                    Map/insert(side, kf, State/many()),
                    [Seg/at(name, 0)]))
        | some(existing) =>
            match existing
            | arr(items) =>
                match Map/get(side, kf)
                | some(st) =>
                    match st
                    | many() =>
                        Result/success(
                            (
                                Map/insert(m, name, Toml/arr([..items, Toml/table(Map/empty())])),
                                side,
                                [Seg/at(name, List/len(items))]))
                    | _ => Result/failure("cannot append to a static array")
                    end
                | none() => Result/failure("cannot append to a static array")
                end
            | table(_) => Result/failure("cannot redefine a table as an array of tables")
            | _ => Result/failure("key conflicts with an existing value")
            end
        end
    | act_value(v) =>
        match Map/get(m, name)
        | none() =>
            let side2: Map(State) =
                match v | table(_) => Map/insert(side, kf, State/inline()) | _ => side end;
            Result/success((Map/insert(m, name, v), side2, [Seg/plain(name)]))
        | some(_) => Result/failure("duplicate key")
        end
    end;

let walk(
    m: Map(Toml),
    side: Map(State),
    pre: Bytes,
    segs: List(Seg),
    unchecked: Nat,
    act: Act,
) -> Result(Str, {Map(Toml), Map(State), List(Seg)}) =
    match segs
    | [] => Result/failure("empty key path")
    | [seg, ..rest] =>
        match rest
        | [] => walk_final(m, side, pre, seg_name(seg), act)
        | [_, .._] =>
            match unchecked > 0
            | true =>
                match seg
                | plain(name) =>
                    match Map/get(m, name)
                    | some(existing) =>
                        match existing
                        | table(inner) =>
                            match walk(inner, side, seg_key(pre, seg), rest, unchecked - 1, act)
                            | success((inner2, side2, res)) =>
                                Result/success(
                                    (Map/insert(m, name, Toml/table(inner2)), side2, [seg, ..res]))
                            | failure(msg) => Result/failure(msg)
                            end
                        | _ => Result/failure("scope is not a table")
                        end
                    | none() => Result/failure("scope is missing")
                    end
                | at(name, index) =>
                    match Map/get(m, name)
                    | some(existing) =>
                        match existing
                        | arr(items) =>
                            match Nat/Lt/try(index, List/len(items))
                            | some(in_range) =>
                                match List/get(@Toml, items, index, @in_range)
                                | table(inner) =>
                                    match walk(
                                        inner,
                                        side,
                                        seg_key(pre, seg),
                                        rest,
                                        unchecked - 1,
                                        act)
                                    | success((inner2, side2, res)) =>
                                        let items2 =
                                            replace_at(items, index, in_range, Toml/table(inner2));
                                        Result/success(
                                            (
                                                Map/insert(m, name, Toml/arr(items2)),
                                                side2,
                                                [seg, ..res]))
                                    | failure(msg) => Result/failure(msg)
                                    end
                                | _ => Result/failure("scope element is not a table")
                                end
                            | none() => Result/failure("scope element is missing")
                            end
                        | _ => Result/failure("scope is not an array of tables")
                        end
                    | none() => Result/failure("scope is missing")
                    end
                end
            | false =>
                let name = seg_name(seg);
                let kp = seg_key(pre, Seg/plain(name));
                match Map/get(m, name)
                | none() =>
                    let created: State =
                        match act | act_value(_) => State/dotted() | _ => State/implicit() end;
                    match walk(Map/empty(), Map/insert(side, kp, created), kp, rest, 0, act)
                    | success((inner2, side2, res)) =>
                        Result/success(
                            (
                                Map/insert(m, name, Toml/table(inner2)),
                                side2,
                                [Seg/plain(name), ..res]))
                    | failure(msg) => Result/failure(msg)
                    end
                | some(existing) =>
                    match existing
                    | table(inner) =>
                        match may_extend(side, kp, act)
                        | failure(msg) => Result/failure(msg)
                        | success(_) =>
                            match walk(inner, side, kp, rest, 0, act)
                            | success((inner2, side2, res)) =>
                                Result/success(
                                    (
                                        Map/insert(m, name, Toml/table(inner2)),
                                        side2,
                                        [Seg/plain(name), ..res]))
                            | failure(msg) => Result/failure(msg)
                            end
                        end
                    | arr(items) =>
                        let is_many: Bool =
                            match Map/get(side, kp)
                            | some(st) => match st | many() => true | _ => false end
                            | none() => false
                            end;
                        match is_many
                        | true =>
                            match act
                            | act_value(_) =>
                                Result/failure("cannot extend an array of tables with dotted keys")
                            | _ =>
                                let index = List/len(items) - 1;
                                let seg2 = Seg/at(name, index);
                                match Nat/Lt/try(index, List/len(items))
                                | some(in_range) =>
                                    match List/get(@Toml, items, index, @in_range)
                                    | table(inner) =>
                                        match walk(inner, side, seg_key(pre, seg2), rest, 0, act)
                                        | success((inner2, side2, res)) =>
                                            let items2 =
                                                replace_at(
                                                    items,
                                                    index,
                                                    in_range,
                                                    Toml/table(inner2));
                                            Result/success(
                                                (
                                                    Map/insert(m, name, Toml/arr(items2)),
                                                    side2,
                                                    [seg2, ..res]))
                                        | failure(msg) => Result/failure(msg)
                                        end
                                    | _ => Result/failure("array element is not a table")
                                    end
                                | none() => Result/failure("array of tables is empty")
                                end
                            end
                        | false => Result/failure("cannot extend a static array")
                        end
                    | _ => Result/failure("key conflicts with an existing value")
                    end
                end
            end
        end
    end;

let plains(names: List(Str)) -> List(Seg) =
    List/map(names, (n) => Seg/plain(n));

pub let apply_assign(b: Build, path: List(Str), v: Toml) -> Result(Str, Build) =
    match walk(
        b.root,
        b.side,
        x[],
        [..b.scope, ..plains(path)],
        List/len(b.scope),
        Act/act_value(v))
    | success((root2, side2, _)) =>
        Result/success(Build { root = root2, side = side2, scope = b.scope })
    | failure(msg) => Result/failure(msg)
    end;

pub let apply_header(b: Build, path: List(Str)) -> Result(Str, Build) =
    match walk(b.root, b.side, x[], plains(path), 0, Act/act_table())
    | success((root2, side2, resolved)) =>
        Result/success(Build { root = root2, side = side2, scope = resolved })
    | failure(msg) => Result/failure(msg)
    end;

pub let apply_aot(b: Build, path: List(Str)) -> Result(Str, Build) =
    match walk(b.root, b.side, x[], plains(path), 0, Act/act_many())
    | success((root2, side2, resolved)) =>
        Result/success(Build { root = root2, side = side2, scope = resolved })
    | failure(msg) => Result/failure(msg)
    end;

pub let inline_fold(pairs: List({List(Str), Toml})) -> Result(Str, Map(Toml)) =
    let start: Result(Str, Build) = Result/success(build_empty);
    match List/fold(
        pairs,
        start,
        (pair, acc) => Result/bind(acc, (b) => apply_assign(b, pair.0, pair.1)))
    | success(b) => Result/success(b.root)
    | failure(msg) => Result/failure(msg)
    end;
