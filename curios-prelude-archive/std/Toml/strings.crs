use /std/{Nat, Int, Flt, Bool, Byte, Bytes, Char, Str, List, Map, Option, Result, Parse};
use /std/Toml/scan/{hex_val};

-- One hex digit of an escape. The two ways of not finding one are different errors here -- running out of input truncates the escape, a wrong byte spells it wrongly -- so this peeks rather than labelling a single refusal.
let hex_digit: Parse(Nat) =
    let next = Parse/peek!;
    match next
    | none() => Parse/fail("unterminated escape")
    | some(b) =>
        match hex_val(Byte/to_nat(b))
        | some(v) =>
            let _ = Parse/any_byte!;
            Parse/pure(v)
        | none() => Parse/fail("invalid hex digit in escape")
        end
    end;

let hex_digits(count: Nat, acc: Nat) -> Parse(Nat) =
    match count
    | 0 => Parse/pure(acc)
    | pred + 1 =>
        let v = hex_digit!;
        hex_digits(pred, acc * 0x10 + v)
    end;

let scalar_utf8(code: Nat) -> Parse(Bytes) =
    match Char/of_nat(code)
    | some(c) => Parse/pure(Char/to_utf8(c))
    | none() => Parse/fail("invalid Unicode scalar in escape")
    end;

-- one basic-string escape, the backslash already consumed
let escape: Parse(Bytes) =
    let next = Parse/peek!;
    match next
    | none() => Parse/fail("unterminated escape")
    | some(b) =>
        let _ = Parse/any_byte!;
        match Byte/to_nat(b)
        | 98 => Parse/pure(x[0x8])
        | 116 => Parse/pure(x[0x9])
        | 110 => Parse/pure(x[0xA])
        | 102 => Parse/pure(x[0xC])
        | 114 => Parse/pure(x[0xD])
        | 34 => Parse/pure(x[0x22])
        | 92 => Parse/pure(x[0x5C])
        | 117 =>
            let code = hex_digits(4, 0)!;
            scalar_utf8(code)
        | 85 =>
            let code = hex_digits(8, 0)!;
            scalar_utf8(code)
        | _ => Parse/fail("unknown escape")
        end
    end;

-- A carriage return is only ever legal as the first half of a CRLF, so consuming one is all-or-nothing: `optional` gives a lone one back, and every caller turns that into the same refusal.
let crlf: Parse(Option({Byte, Byte})) =
    Parse/optional(Parse/and(Parse/take_byte(0xD), Parse/take_byte(0xA)));

let quotes(quote: Byte, count: Nat) -> Bytes =
    match count | 0 => x[] | pred + 1; ih => x[..ih, quote] end;

let basic_body(acc: Bytes) -> Parse(Bytes) =
    let next = Parse/peek!;
    match next
    | none() => Parse/fail("unterminated string")
    | some(b) =>
        let n = Byte/to_nat(b);
        choose
        | n == 0x22 =>
            let _ = Parse/any_byte!;
            Parse/pure(acc)
        | n == 0x5C =>
            let _ = Parse/any_byte!;
            let chunk = escape!;
            basic_body(x[..acc, ..chunk])
        | n == 0x9 =>
            let _ = Parse/any_byte!;
            basic_body(x[..acc, b])
        | n < 0x20 => Parse/fail("control character in string")
        | n == 0x7F => Parse/fail("control character in string")
        | _ =>
            let _ = Parse/any_byte!;
            basic_body(x[..acc, b])
        end
    end;

let basic_str_scan: Parse(Bytes) =
    let _ = Parse/label(Parse/take_byte(0x22), "expected string")!;
    basic_body(x[]);

let literal_body(acc: Bytes) -> Parse(Bytes) =
    let next = Parse/peek!;
    match next
    | none() => Parse/fail("unterminated string")
    | some(b) =>
        let n = Byte/to_nat(b);
        choose
        | n == 0x27 =>
            let _ = Parse/any_byte!;
            Parse/pure(acc)
        | n == 0x9 =>
            let _ = Parse/any_byte!;
            literal_body(x[..acc, b])
        | n < 0x20 => Parse/fail("control character in string")
        | n == 0x7F => Parse/fail("control character in string")
        | _ =>
            let _ = Parse/any_byte!;
            literal_body(x[..acc, b])
        end
    end;

let literal_str_scan: Parse(Bytes) =
    let _ = Parse/label(Parse/take_byte(0x27), "expected string")!;
    literal_body(x[]);

-- after a line-ending backslash: whitespace, then at least one newline, then any further whitespace and newlines
let trim_run(seen_nl: Bool) -> Parse({}) =
    let stop: Parse({}) =
        match seen_nl | true => Parse/pure(()) | false => Parse/fail("invalid escape") end;
    let next = Parse/peek!;
    match next
    | none() => stop
    | some(b) =>
        let n = Byte/to_nat(b);
        choose
        | n == 0x20 =>
            let _ = Parse/any_byte!;
            trim_run(seen_nl)
        | n == 0x9 =>
            let _ = Parse/any_byte!;
            trim_run(seen_nl)
        | n == 0xA =>
            let _ = Parse/any_byte!;
            trim_run(true)
        | n == 0xD =>
            let pair = crlf!;
            match pair
            | some(_) => trim_run(true)
            | none() => Parse/fail("bare carriage return")
            end
        | _ => stop
        end
    end;

-- A multiline string's opening delimiter may be followed by one newline, which is not part of the content.
let skip_opening_newline: Parse({}) =
    let lf = Parse/optional(Parse/take_byte(0xA))!;
    match lf
    | some(_) => Parse/pure(())
    | none() =>
        let _ = crlf!;
        Parse/pure(())
    end;

-- The closing delimiter is three quotes, but a run of up to five ends the string with the surplus kept as content -- so the whole run is read at once and its length decides, rather than a quote at a time.
let ml_basic_body(acc: Bytes) -> Parse(Bytes) =
    let next = Parse/peek!;
    match next
    | none() => Parse/fail("unterminated string")
    | some(b) =>
        let n = Byte/to_nat(b);
        choose
        | n == 0x22 =>
            let run = Parse/take_while((c) => Byte/to_nat(c) == 0x22)!;
            let q = Bytes/len(run);
            choose
            | q >= 6 => Parse/fail("too many quotes")
            | q >= 3 => Parse/pure(x[..acc, ..quotes(b, q - 3)])
            | _ => ml_basic_body(x[..acc, ..quotes(b, q)])
            end
        | n == 0x5C =>
            let _ = Parse/any_byte!;
            let folded = Parse/peek!;
            match folded
            | some(w) =>
                let m = Byte/to_nat(w);
                match m == 0x20 || m == 0x9 || m == 0xA || m == 0xD
                | true =>
                    let _ = trim_run(false)!;
                    ml_basic_body(acc)
                | false =>
                    let chunk = escape!;
                    ml_basic_body(x[..acc, ..chunk])
                end
            | none() =>
                let chunk = escape!;
                ml_basic_body(x[..acc, ..chunk])
            end
        | n == 0xA =>
            let _ = Parse/any_byte!;
            ml_basic_body(x[..acc, b])
        | n == 0xD =>
            let pair = crlf!;
            match pair
            | some(_) => ml_basic_body(x[..acc, 0xD, 0xA])
            | none() => Parse/fail("bare carriage return")
            end
        | n == 0x9 =>
            let _ = Parse/any_byte!;
            ml_basic_body(x[..acc, b])
        | n < 0x20 => Parse/fail("control character in string")
        | n == 0x7F => Parse/fail("control character in string")
        | _ =>
            let _ = Parse/any_byte!;
            ml_basic_body(x[..acc, b])
        end
    end;

let ml_literal_body(acc: Bytes) -> Parse(Bytes) =
    let next = Parse/peek!;
    match next
    | none() => Parse/fail("unterminated string")
    | some(b) =>
        let n = Byte/to_nat(b);
        choose
        | n == 0x27 =>
            let run = Parse/take_while((c) => Byte/to_nat(c) == 0x27)!;
            let q = Bytes/len(run);
            choose
            | q >= 6 => Parse/fail("too many quotes")
            | q >= 3 => Parse/pure(x[..acc, ..quotes(b, q - 3)])
            | _ => ml_literal_body(x[..acc, ..quotes(b, q)])
            end
        | n == 0xA =>
            let _ = Parse/any_byte!;
            ml_literal_body(x[..acc, b])
        | n == 0xD =>
            let pair = crlf!;
            match pair
            | some(_) => ml_literal_body(x[..acc, 0xD, 0xA])
            | none() => Parse/fail("bare carriage return")
            end
        | n == 0x9 =>
            let _ = Parse/any_byte!;
            ml_literal_body(x[..acc, b])
        | n < 0x20 => Parse/fail("control character in string")
        | n == 0x7F => Parse/fail("control character in string")
        | _ =>
            let _ = Parse/any_byte!;
            ml_literal_body(x[..acc, b])
        end
    end;

let str_of(b: Bytes) -> Parse(Str) =
    match Str/of_bytes(b)
    | some(s) => Parse/pure(s)
    | none() => Parse/fail("invalid UTF-8 in string")
    end;

pub let str_basic: Parse(Str) =
    let b = basic_str_scan!;
    str_of(b);

pub let str_literal: Parse(Str) =
    let b = literal_str_scan!;
    str_of(b);

pub let str_ml_basic: Parse(Str) =
    let _ = Parse/take_literal("\"\"\"")!;
    let _ = skip_opening_newline!;
    let b = ml_basic_body(x[])!;
    str_of(b);

pub let str_ml_literal: Parse(Str) =
    let _ = Parse/take_literal("'''")!;
    let _ = skip_opening_newline!;
    let b = ml_literal_body(x[])!;
    str_of(b);
