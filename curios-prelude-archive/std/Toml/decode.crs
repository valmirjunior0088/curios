use /std/{Nat, Int, Flt, Bool, Byte, Bytes, Char, Str, List, Map, Option, Result, Parse};
use /std/Toml/{Toml, let Build};
use /std/Toml/build/{apply_assign, apply_header, apply_aot, build_empty};
use /std/Toml/scan/{line_end, trivia, ws};
use /std/Toml/keys/{key_part};
use /std/Toml/values/{value_parse};

induct Stmt: Type
| assign(path: List(Str), value: Toml)
| table_header(List(Str))
| array_header(List(Str))
end

let key_path(acc: List(Str)) -> Parse(List(Str)) =
    let k = key_part!;
    let _ = ws!;
    let acc2 = [..acc, k];
    let dot = Parse/optional(Parse/take_byte(0x2E))!;
    match dot
    | some(_) =>
        let _ = ws!;
        key_path(acc2)
    | none() => Parse/pure(acc2)
    end;

-- A `[[` header is read as two separate brackets, so the second one's absence is the doubled form's own error rather than the single form's.
let header(double: Bool) -> Parse(List(Str)) =
    let _ = ws!;
    let path = key_path([])!;
    let _ = Parse/label(Parse/take_byte(0x5D), "expected ']' in table header")!;
    match double
    | true =>
        let _ = Parse/label(Parse/take_byte(0x5D), "expected ']]' in table header")!;
        Parse/pure(path)
    | false => Parse/pure(path)
    end;

let stmt: Parse(Stmt) =
    let bracket = Parse/optional(Parse/take_byte(0x5B))!;
    match bracket
    | none() =>
        let path = key_path([])!;
        let _ = Parse/label(Parse/take_byte(0x3D), "expected '=' after key")!;
        let _ = ws!;
        let value = value_parse!;
        Parse/pure(Stmt/assign(path, value))
    | some(_) =>
        let doubled = Parse/optional(Parse/take_byte(0x5B))!;
        match doubled
        | some(_) =>
            let path = header(true)!;
            Parse/pure(Stmt/array_header(path))
        | none() =>
            let path = header(false)!;
            Parse/pure(Stmt/table_header(path))
        end
    end;

let stmts(acc: List(Stmt)) -> Parse(List(Stmt)) =
    let _ = trivia!;
    let done = Parse/optional(Parse/eof)!;
    match done
    | some(_) => Parse/pure(acc)
    | none() =>
        let s = stmt!;
        let _ = line_end!;
        stmts([..acc, s])
    end;

pub let decode(source: Str) -> Result(Str, Map(Toml)) =
    match Parse/run(stmts([]), Str/to_bytes(source))
    | failure(msg) => Result/failure(msg)
    | success(parsed) =>
        let start: Result(Str, Build) = Result/success(build_empty);
        match List/fold(
            parsed,
            start,
            (s, acc) =>
                Result/bind(
                    acc,
                    (b) =>
                        match s
                        | assign(path, v) => apply_assign(b, path, v)
                        | table_header(path) => apply_header(b, path)
                        | array_header(path) => apply_aot(b, path)
                        end))
        | success(b) => Result/success(b.root)
        | failure(msg) => Result/failure(msg)
        end
    end;
