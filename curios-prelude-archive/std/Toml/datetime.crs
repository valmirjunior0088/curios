use /std/{Nat, Int, Bool, Byte, Parse};
use /std/Toml/{Toml, Date, Time, OffsetDateTime, LocalDateTime};
use /std/Toml/calendar/{date_ok, time_ok};

-- One decimal digit. Both ways of not finding one -- the end of input and a non-digit -- are the same refusal to the caller, which is what `label` states here.
let digit: Parse(Nat) =
    Parse/label(
        Parse/map(
            Parse/take_if((b) => Nat/in_range(Byte/to_nat(b), 0x30, 0x39)),
            (b) => Byte/to_nat(b) - 0x30),
        "expected digit");

-- Exactly `count` digits, as one number. A date-time field is fixed-width, so a short run is an error rather than a stopping point.
let fixed(count: Nat, acc: Nat) -> Parse(Nat) =
    match count
    | 0 => Parse/pure(acc)
    | pred + 1 =>
        let d = digit!;
        fixed(pred, acc * 10 + d)
    end;

let expect(want: Byte) -> Parse({}) =
    Parse/label(Parse/map(Parse/take_byte(want), (_) => ()), "malformed date-time");

let nat_pow10(n: Nat) -> Nat =
    match n | 0 => 1 | _pred + 1; ih => ih * 10 end;

let frac_stop(taken: Nat, acc: Nat, seen: Bool) -> Parse(Nat) =
    match seen
    | true => Parse/pure(acc * nat_pow10(9 - taken))
    | false => Parse/fail("expected digit")
    end;

-- fractional seconds: at most nine digits honored, further digits truncated
let frac_digits(taken: Nat, acc: Nat, seen: Bool) -> Parse(Nat) =
    let next = Parse/peek!;
    match next
    | none() => frac_stop(taken, acc, seen)
    | some(b) =>
        match Nat/in_range(Byte/to_nat(b), 0x30, 0x39)
        | false => frac_stop(taken, acc, seen)
        | true =>
            let _ = Parse/any_byte!;
            match taken < 9
            | true => frac_digits(taken + 1, acc * 10 + (Byte/to_nat(b) - 0x30), true)
            | false => frac_digits(taken, acc, true)
            end
        end
    end;

-- A dot commits to a fractional part: once it is consumed, a run of digits must follow, so this deliberately does not fall back to zero on failure the way an `or` would.
let frac_part: Parse(Nat) =
    let dot = Parse/optional(Parse/take_byte(0x2E))!;
    match dot | some(_) => frac_digits(0, 0, false) | none() => Parse/pure(0) end;

-- Each of the three shapes commits once its prefix can be nothing else -- four digits and a dash are a date, two digits and a colon a time, a sign after a time an offset -- so a malformed one reports its own reason rather than letting the integer parser read its leading digits and fail on what follows. The committed parts are named because `!` sequences in the enclosing region, not in a call's argument.
let date_fields(y: Nat) -> Parse(Date) =
    let mo = fixed(2, 0)!;
    let _ = expect(0x2D)!;
    let d = fixed(2, 0)!;
    let date = Date { year = y, month = mo, day = d };
    match date_ok(date) | true => Parse/pure(date) | false => Parse/fail("invalid date") end;

let date_parse: Parse(Date) =
    let y = fixed(4, 0)!;
    let _ = expect(0x2D)!;
    Parse/commit(date_fields(y));

let time_fields(h: Nat) -> Parse(Time) =
    let mi = fixed(2, 0)!;
    let _ = expect(0x3A)!;
    let s = fixed(2, 0)!;
    let ns = frac_part!;
    let time = Time { hour = h, minute = mi, second = s, nanosecond = ns };
    match time_ok(time) | true => Parse/pure(time) | false => Parse/fail("invalid time") end;

let time_parse: Parse(Time) =
    let h = fixed(2, 0)!;
    let _ = expect(0x3A)!;
    Parse/commit(time_fields(h));

let offset_fields(sign: Byte) -> Parse(Int) =
    let oh = fixed(2, 0)!;
    let _ = expect(0x3A)!;
    let om = fixed(2, 0)!;
    match oh <= 23 && om <= 59
    | true =>
        let mins = oh * 60 + om;
        match sign == 0x2D
        | true => Parse/pure(+0 - Nat/to_int(mins))
        | false => Parse/pure(Nat/to_int(mins))
        end
    | false => Parse/fail("invalid offset")
    end;

let offset_parse: Parse(Int) =
    let zulu = Parse/optional(Parse/take_if((b) => b == 0x5A || b == 0x7A))!;
    match zulu
    | some(_) => Parse/pure(+0)
    | none() =>
        let sign = Parse/label(Parse/take_if((b) => b == 0x2B || b == 0x2D), "expected offset")!;
        Parse/commit(offset_fields(sign))
    end;

-- Everything after a date that is still part of one value. The `or`s here start *after* the date has been consumed, which is what makes a separator with no time behind it give the separator back and leave a plain local date standing -- rather than failing the whole value, and rather than backtracking over the date as well.
let date_time_tail(date: Date) -> Parse(Toml) =
    let _ = Parse/take_if((b) => b == 0x54 || b == 0x74 || b == 0x20)!;
    let time = time_parse!;
    Parse/or(
        Parse/map(
            offset_parse,
            (off) =>
                Toml/offset_date_time(
                    OffsetDateTime { date = date, time = time, offset_minutes = off })),
        Parse/pure(Toml/local_date_time(LocalDateTime { date = date, time = time })));

let date_led: Parse(Toml) =
    let date = date_parse!;
    Parse/or(date_time_tail(date), Parse/pure(Toml/local_date(date)));

pub let datetime_value: Parse(Toml) =
    Parse/or(date_led, Parse/map(time_parse, (time) => Toml/local_time(time)));
