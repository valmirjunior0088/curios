use /std/{Nat, Bool, Option, True, False};

let sound(hour: Nat, minute: Nat, second: Nat, nanosecond: Nat) -> Bool =
    hour <= 23 && minute <= 59 && second <= 60 && nanosecond <= 999999999;

-- | That the four spell a time of day. A second of `60` is admitted, since RFC 3339 writes a leap second that way.
pub let Valid(hour: Nat, minute: Nat, second: Nat, nanosecond: Nat) -> Prop =
    match sound(hour, minute, second, nanosecond) | true => True | false => False end;

-- | A time of day, to the nanosecond.
pub struct Time: pub Type {
    hour: Nat,
    minute: Nat,
    second: Nat,
    nanosecond: Nat,
    ok: Valid(hour, minute, second, nanosecond),
}

-- | The time, under the evidence that the four spell one.
pub let of(
    hour: Nat,
    minute: Nat,
    second: Nat,
    nanosecond: Nat,
    @ok: Valid(hour, minute, second, nanosecond),
) -> Time =
    Time { hour = hour, minute = minute, second = second, nanosecond = nanosecond, ok = ok };

let try_valid(
    hour: Nat,
    minute: Nat,
    second: Nat,
    nanosecond: Nat,
) -> Option(Valid(hour, minute, second, nanosecond)) =
    match sound(hour, minute, second, nanosecond): (r) =>
        Option(match r: (_) => Prop | true => True | false => False end)
    | true => Option/some(True/qed())
    | false => Option/none()
    end;

-- | The time, decided: `none` where the four spell none.
pub let try_of(hour: Nat, minute: Nat, second: Nat, nanosecond: Nat) -> Option(Time) =
    match try_valid(hour, minute, second, nanosecond)
    | some(ok) => Option/some(of(hour, minute, second, nanosecond, @ok))
    | none() => Option/none()
    end;
