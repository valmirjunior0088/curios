use /std/{Bytes, Str, List, Parse};
use /std/Toml/scan/{is_bare_byte, ws};
use /std/Toml/strings/{str_basic, str_literal};

let key_bare: Parse(Bytes, Str) =
    let chunk = Parse/bytes/take_while(is_bare_byte)!;
    match Bytes/len(chunk) == 0
    | true => Parse/fail("expected key")
    | false =>
        match Str/of_bytes(chunk)
        | some(s) => Parse/pure(s)
        | none() => Parse/fail("expected key")
        end
    end;

--- One key: bare, or quoted as a basic or a literal string.
pub let key_part: Parse(Bytes, Str) =
    Parse/or(key_bare, Parse/or(str_basic, str_literal));

let dot_part: Parse(Bytes, Str) =
    let _ = ws!;
    let _ = Parse/bytes/expect(0x2E)!;
    let _ = ws!;
    key_part;

--- A dotted key as its parts, in the order they were written.
pub let key_dotted: Parse(Bytes, List(Str)) =
    let first = key_part!;
    let rest = Parse/many0(dot_part)!;
    Parse/pure([first, ..rest]);
