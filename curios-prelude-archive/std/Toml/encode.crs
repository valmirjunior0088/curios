use /std/{Nat, Int, Flt, Bool, Bytes, Char, Str, List, Map, Option, Result};
use /std/Toml/{Toml, Date, Time, Error};
use /std/Toml/scan/{is_bare_byte};

let bare_ok(s: Str) -> Bool =
    let bs = Str/to_bytes(s);
    match Bytes/len(bs) == 0
    | true => false
    | false => Bytes/fold(bs, true, (b, ok) => ok && is_bare_byte(b))
    end;

--- What a character is written as inside a basic string, when it is not written as itself: the quote, the backslash, the control characters and DEL, which TOML escapes.
let escaped(c: Char) -> Option(Str) =
    let n = Char/to_nat(c);
    match n
    | '"' => Option/some("\\\"")
    | '\\' => Option/some("\\\\")
    | '\u{8}' => Option/some("\\b")
    | '\t' => Option/some("\\t")
    | '\n' => Option/some("\\n")
    | '\u{C}' => Option/some("\\f")
    | '\r' => Option/some("\\r")
    | _ =>
        match n < 0x20 || n == 0x7F
        | true =>
            Option/some(
                Str/flatten([
                    "\\u00",
                    Str/of_char(Char/hex_digit(n / 0x10)),
                    Str/of_char(Char/hex_digit(n % 0x10))]))
        | false => Option/none()
        end
    end;

let quote_str(s: Str) -> Str =
    Str/flatten(["\"", Str/escape(s, escaped), "\""]);

let spell_key(kb: Bytes) -> Result(Error, Str) =
    match Str/of_bytes(kb)
    | none() => Result/failure(Error/invalid_key(kb))
    | some(s) =>
        match bare_ok(s) | true => Result/success(s) | false => Result/success(quote_str(s)) end
    end;

let pad(n: Nat, width: Nat) -> Str =
    let s = Nat/to_str(n);
    Str/concat(Str/repeat("0", width - Str/len(s)), s);

--- `ns` nanoseconds as the fraction after a time's point: its nine digits with the trailing zeros dropped and one kept at least, or nothing at all for none.
let ns_str(ns: Nat) -> Str =
    match ns == 0
    | true => ""
    | false =>
        let trimmed(n: Nat, width: Nat) -> {Nat, Nat} =
            match width
            | 0 => (n, 0)
            | w + 1 =>
                match w == 0 || n % 10 != 0 | true => (n, width) | false => trimmed(n / 10, w) end
            end;
        let (digits, width) = trimmed(ns, 9);
        Str/concat(".", pad(digits, width))
    end;

let date_str(d: Date) -> Str =
    Str/flatten([pad(d.year, 4), "-", pad(d.month, 2), "-", pad(d.day, 2)]);

let time_str(t: Time) -> Str =
    Str/flatten([
        pad(t.hour, 2),
        ":",
        pad(t.minute, 2),
        ":",
        pad(t.second, 2),
        ns_str(t.nanosecond)]);

let offset_str(mins: Int) -> Str =
    match mins == +0
    | true => "Z"
    | false =>
        let mag = Int/abs(mins);
        let sign = match mins > +0 | true => "+" | false => "-" end;
        Str/flatten([sign, pad(mag / 60, 2), ":", pad(mag % 60, 2)])
    end;

let int_str(n: Int) -> Str =
    choose
    | n >= +0 => Nat/to_str(Int/to_nat(n))
    | _ => Str/concat("-", Nat/to_str(Int/abs(n)))
    end;

let flt_str(f: Flt) -> Str =
    choose
    | Bool/not(Flt/is_finite(f)) =>
        choose
        | f > +0.0 => "inf"
        | f < +0.0 => "-inf"
        | Flt/is_sign_minus(f) => "-nan"
        | _ => "nan"
        end
    | _ =>
        let raw = Flt/to_str(f);
        let unsigned = match Str/strip_prefix(raw, "+") | some(bare) => bare | none() => raw end;
        match Str/contains(unsigned, '.') || Str/contains(unsigned, 'e')
        | true => unsigned
        | false => Str/concat(unsigned, ".0")
        end
    end;

let value_str(v: Toml) -> Result(Error, Str) =
    match v
    | str(s) => Result/success(quote_str(s))
    | int(n) => Result/success(int_str(n))
    | flt(f) => Result/success(flt_str(f))
    | bool(x) => Result/success(Bool/to_str(x))
    | offset_date_time(odt) =>
        Result/success(
            Str/flatten([
                date_str(odt.date),
                "T",
                time_str(odt.time),
                offset_str(odt.offset_minutes)]))
    | local_date_time(ldt) =>
        Result/success(Str/flatten([date_str(ldt.date), "T", time_str(ldt.time)]))
    | local_date(d) => Result/success(date_str(d))
    | local_time(t) => Result/success(time_str(t))
    | arr(items) =>
        let start: Result(Error, List(Str)) = Result/success([]);
        let parts =
            List/fold(items, start, (item, acc) =>
                let parts = acc!;
                let s = value_str(item)!;
                Result/success([..parts, s]))!;
        Result/success(Str/flatten(["[", Str/join(", ", parts), "]"]))
    | table(m) =>
        match List/len(Map/entries(m)) == 0
        | true => Result/success("{}")
        | false =>
            let body = pairs_str(Map/entries(m))!;
            Result/success(Str/flatten(["{ ", body, " }"]))
        end
    end
and pairs_str(entries: List({Bytes, Toml})) -> Result(Error, Str) =
    let start: Result(Error, List(Str)) = Result/success([]);
    let parts =
        List/fold(entries, start, (entry, acc) =>
            let parts = acc!;
            let k = spell_key(entry.0)!;
            let vs = value_str(entry.1)!;
            Result/success([..parts, Str/flatten([k, " = ", vs])]))!;
    Result/success(Str/join(", ", parts));

let encode_table(prefix: List(Str), m: Map(Toml)) -> Result(Error, Str) =
    let entries = Map/entries(m);
    let start: Result(Error, List(Str)) = Result/success([]);
    let value_lines =
        List/fold(entries, start, (entry, acc) =>
            let lines = acc!;
            match entry.1
            | table(_) => Result/success(lines)
            | _ =>
                let k = spell_key(entry.0)!;
                let vs = value_str(entry.1)!;
                Result/success([..lines, Str/flatten([k, " = ", vs, "\n"])])
            end)!;
    let table_blocks =
        List/fold(entries, start, (entry, acc) =>
            let blocks = acc!;
            match entry.1
            | table(sub) =>
                let k = spell_key(entry.0)!;
                let body = encode_table([..prefix, k], sub)!;
                Result/success([
                    ..blocks,
                    Str/flatten(["[", Str/join(".", [..prefix, k]), "]\n", body])])
            | _ => Result/success(blocks)
            end)!;
    Result/success(Str/concat(Str/flatten(value_lines), Str/flatten(table_blocks)));

--- `m` as one deterministic document: the root's plain values first, then its tables. A key that is not UTF-8 or an invalid calendar value is refused rather than written.
pub let encode(m: Map(Toml)) -> Result(Error, Str) =
    encode_table([], m);
