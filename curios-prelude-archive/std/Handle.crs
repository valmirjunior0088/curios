pub use /sys/{Handle};
pub use /sys/Handle/{stdin, stdout, stderr, eql};
use /std/{Bytes, Nat, Result, List, Io, True};

pub induct Error: pub Type
| not_found()
| permission_denied()
| exists()
| refused()
| tls()
| would_block()
| other(Nat)
end

let errors: List({Nat, Error}) =
    [
        (/sys/status/not_found, Error/not_found()),
        (/sys/status/permission_denied, Error/permission_denied()),
        (/sys/status/exists, Error/exists()),
        (/sys/status/refused, Error/refused()),
        (/sys/status/tls, Error/tls()),
        (/sys/status/would_block, Error/would_block())];

pub let error_of(status: Nat) -> Error =
    List/fold(
        errors,
        -- Not a named code: the errno passthrough lane, offset by other_base so an errno never collides with a named code.
        Error/other(status - /sys/status/other_base),
        (entry, acc) => match status == entry.0 | true => entry.1 | false => acc end);

pub induct Read: pub Type
| chunk(Bytes)
| eof()
| error(Error)
end

pub let read(h: Handle, n: Nat) -> Io(Read) =
    let r = /sys/Handle/read(h, n)!;
    Io/pure(
        choose
        | r.status == /sys/status/ok => Read/chunk(r.bytes)
        | r.status == /sys/status/eof => Read/eof()
        | _ => Read/error(error_of(r.status))
        end);

pub rec write(h: Handle, b: Bytes) -> Io(Result({}, Error)) =
    let r = /sys/Handle/write(h, b)!;
    choose
    | r.status != /sys/status/ok => Io/pure(Result/failure(error_of(r.status)))
    | r.written < Bytes/len(b) =>
        write(
            h,
            Bytes/drop(b, r.written, @Nat/Lt/le_of_lt(r.written, Bytes/len(b), True/qed())))
    | _ => Io/pure(Result/success(()))
    end;
