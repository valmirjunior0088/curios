-- The raw handle the host mints, re-exported for `/std`'s own modules: a stream type wraps one behind a private representation and reads it through `/std/Async/raw`. A program never holds one.
pub use /sys/{Handle};
pub use /sys/Handle/{stdin, stdout, stderr, eql};
use /std/{Bool, Equal};

satisfy Equal(Handle) {
    eql = eql,
    neq(a, b) = Bool/not(eql(a, b)),
}
