pub use /sys/{Handle};
pub use /sys/Handle/{close, stdin, stdout, stderr};
use /std/{Bool, Byte, Bytes, Nat, Int, List, Result, Io, Async};

--- What a park asks to be woken for.
pub mod Interest;
pub use Interest/{let Interest};

--- What a poll reports for one handle.
pub mod Readiness;
pub use Readiness/{let Readiness};

let to_mask(i: Interest) -> Byte =
    Byte/or(
        match i.readable | true => /sys/event/read | false => 0 end,
        match i.writable | true => /sys/event/write | false => 0 end);

let flagged(mask: Byte, flag: Byte) -> Bool =
    Byte/to_nat(Byte/and(mask, flag)) > 0;

let of_mask(mask: Byte) -> Readiness =
    Readiness {
        fired =
            Interest {
                readable = flagged(mask, /sys/event/read),
                writable = flagged(mask, /sys/event/write),
            },
        failed = flagged(mask, /sys/event/err),
        hung_up = flagged(mask, /sys/event/hup),
    };

--- A poll's masks cross as one byte per handle, in the handles' order.
let to_masks(interests: List(Interest)) -> Bytes =
    match interests | [] => x[] | [i, ..rest] => x[to_mask(i), ..to_masks(rest)] end;

let of_masks(masks: Bytes) -> List(Readiness) =
    match masks | x[] => [] | x[m, ..rest] => [of_mask(m), ..of_masks(rest)] end;

--- Wait until a handle is ready for the interest beside it, or until `timeout` milliseconds pass; a negative timeout waits forever and zero answers at once.
pub let poll(
    handles: List(Handle),
    interests: List(Interest),
    timeout: Int,
) -> Io(List(Readiness)) =
    let masks = /sys/Handle/poll(handles, to_masks(interests), timeout)!;
    Io/pure(of_masks(masks));

--- Up to `n` bytes, waited for on this program's own behalf: a host that would block is polled until it would not.
let read_waiting(h: Handle, n: Nat) -> Io(Io/Chunk) =
    let r = /sys/Handle/read(h, n)!;
    match r
    | success(some(b)) => Io/pure(Io/Chunk/chunk(b))
    | success(none()) => Io/pure(Io/Chunk/eof())
    | failure(s) =>
        choose
        | s == /sys/status/would_block =>
            let _ = poll([h], [Interest/readable], -1)!;
            read_waiting(h, n)
        | _ => Io/pure(Io/Chunk/error(Io/Error/of(s)))
        end
    end;

--- The whole of `b`, waited for on this program's own behalf: a host that would block is polled until it would not, and a short write is resent; the first failure is the answer.
let write_waiting(h: Handle, b: Bytes) -> Io(Result(Io/Error, {})) =
    let r = /sys/Handle/write(h, b)!;
    match r
    | success(written) =>
        choose
        | written < Bytes/len(b) =>
            write_waiting(
                h,
                Bytes/drop(b, written, @Nat/Lt/le_of_lt(written, Bytes/len(b), Bool/True/qed())))
        | _ => Io/pure(Result/success(()))
        end
    | failure(s) =>
        choose
        | s == /sys/status/would_block =>
            let _ = poll([h], [Interest/writable], -1)!;
            write_waiting(h, b)
        | _ => Io/pure(Result/failure(Io/Error/of(s)))
        end
    end;

--- What `h` holds of the writes it accepted, handed on and waited for on this program's own behalf.
let flush_waiting(h: Handle) -> Io(Result(Io/Error, {})) =
    let r = /sys/Handle/flush(h)!;
    match r
    | success(_) => Io/pure(Result/success(()))
    | failure(s) =>
        choose
        | s == /sys/status/would_block =>
            let _ = poll([h], [Interest/writable], -1)!;
            flush_waiting(h)
        | _ => Io/pure(Result/failure(Io/Error/of(s)))
        end
    end;

let park_on(h: Handle, interest: Interest) -> Async({}) =
    Async/park([Async/Wait/ready(h, interest)]);

--- Up to `n` bytes, parking the fiber while the host would block.
let read_parking(h: Handle, n: Nat) -> Async(Io/Chunk) =
    let r = /sys/Handle/read(h, n)!;
    match r
    | success(some(b)) => Async/pure(Io/Chunk/chunk(b))
    | success(none()) => Async/pure(Io/Chunk/eof())
    | failure(s) =>
        choose
        | s == /sys/status/would_block =>
            let _ = park_on(h, Interest/readable)!;
            read_parking(h, n)
        | _ => Async/pure(Io/Chunk/error(Io/Error/of(s)))
        end
    end;

--- The whole of `b`, parking while the host would block and resending a short write.
let write_parking(h: Handle, b: Bytes) -> Async(Result(Io/Error, {})) =
    let r = /sys/Handle/write(h, b)!;
    match r
    | success(written) =>
        choose
        | written < Bytes/len(b) =>
            let _ = park_on(h, Interest/writable)!;
            write_parking(
                h,
                Bytes/drop(b, written, @Nat/Lt/le_of_lt(written, Bytes/len(b), Bool/True/qed())))
        | _ => Async/pure(Result/success(()))
        end
    | failure(s) =>
        choose
        | s == /sys/status/would_block =>
            let _ = park_on(h, Interest/writable)!;
            write_parking(h, b)
        | _ => Async/pure(Result/failure(Io/Error/of(s)))
        end
    end;

--- What `h` holds of the writes it accepted, handed on, parking while the host would block.
let flush_parking(h: Handle) -> Async(Result(Io/Error, {})) =
    let r = /sys/Handle/flush(h)!;
    match r
    | success(_) => Async/pure(Result/success(()))
    | failure(s) =>
        choose
        | s == /sys/status/would_block =>
            let _ = park_on(h, Interest/writable)!;
            flush_parking(h)
        | _ => Async/pure(Result/failure(Io/Error/of(s)))
        end
    end;

satisfy Async/Read(Io, Handle) {
    read(h, n) = read_waiting(h, n),
}

satisfy Async/Read(Async, Handle) {
    read(h, n) = read_parking(h, n),
}

satisfy Async/Write(Io, Handle) {
    write(h, b) = write_waiting(h, b),
    flush(h) = flush_waiting(h),
}

satisfy Async/Write(Async, Handle) {
    write(h, b) = write_parking(h, b),
    flush(h) = flush_parking(h),
}
