use /std/{Nat, Bool, List, Option, Io, Try, Async};
use /std/time/{Duration};
use /std/Async/{Channel};

-- | A terminal colour, in the four forms a terminal understands.
pub mod Color;
pub use Color/{let Color};

-- | How a tile is painted: two colours and six attributes.
pub mod Style;
pub use Style/{let Style};

-- | One tile of the screen: a column of a row, with its text and its style.
pub mod Tile;
pub use Tile/{let Tile};

-- | How wide a string is on a terminal, and truncation and wrapping over that measurement.
pub mod text;

-- | A screen or a part of one, with its size in its type, and the algebra that builds one.
pub mod Frame;
pub use Frame/{let Frame};

-- | A tree of named panes, and the sizes a frame splits into along it.
pub mod Layout;
pub use Layout/{let Layout};

-- | A key as a program sees it: a code and three modifiers.
pub mod Key;
pub use Key/{let Key};

-- | What reaches a program's `update`.
pub mod Event;
pub use Event/{let Event};

-- | The bytes a terminal sends, read as the keys and pastes they encode.
pub mod input;

mod ansi;

-- | Two frames of one size into the bytes that carry the terminal from the first to the second.
pub mod render;

-- | The terminal taken and given back, and what a program with a loop of its own writes it over.
pub mod Session;
pub use Session/{let Session};

-- | A frame in a box.
pub mod Border;

-- | Styled text wrapped into a pane.
pub mod Paragraph;

-- | A list with one selected entry.
pub mod Listing;
pub use Listing/{let Listing};

-- | A single line of text being edited.
pub mod Field;
pub use Field/{let Field};

-- | A window onto a larger frame.
pub mod Viewport;

-- | What an `update` asks the loop to do beside the new model: nothing, stop, run an `Async` and hand its answer back as `Event/custom`, or several of those.
pub induct Cmd(E: Type): pub Type
| none()
| quit()
| perform(Async(E))
| batch(List(Cmd(E)))
end

-- | A program: its first model and command, how an event changes the model, what the model looks like at a size, and where the cursor goes.
pub struct Tui(M: Type, E: Type): pub Type {
    init: {M, Cmd(E)},
    update: (model: M, event: Event(E)) -> {M, Cmd(E)},
    -- | Typed at the size it is given, so a frame that does not fill the terminal is refused where it is written.
    view: (model: M, w: Nat, h: Nat) -> Frame(w, h),
    -- | Where the terminal's cursor goes, or hidden.
    cursor: (model: M, w: Nat, h: Nat) -> Option({x: Nat, y: Nat}),
}

let flatten(@E: Type, c: Cmd(E)) -> {quit: Bool, pending: List(Async(E))} =
    match c
    | none() => (quit = false, pending = [])
    | quit() => (quit = true, pending = [])
    | perform(a) => (quit = false, pending = [a])
    | batch(cs) =>
        List/fold(
            cs,
            (quit = false, pending = []),
            (inner, acc) =>
                let f = flatten(inner);
                (quit = acc.quit || f.quit, pending = [..acc.pending, ..f.pending]))
    end;

-- | The program's fold with no terminal: `events` through `update` from the initial model, stopping at the first `quit`. Answers the model, whether it quit, the frame at `w` by `h`, and every `perform` it asked for, unrun.
pub let drive(
    @M: Type,
    @E: Type,
    app: Tui(M, E),
    w: Nat,
    h: Nat,
    events: List(Event(E)),
) -> {model: M, quit: Bool, frame: Frame(w, h), pending: List(Async(E))} =
    let start = flatten(app.init.1);
    let state =
        List/fold(
            events,
            (model = app.init.0, quit = start.quit, pending = start.pending),
            (e, acc) =>
                match acc.quit
                | true => acc
                | false =>
                    let next = app.update(acc.model, e);
                    let f = flatten(next.1);
                    (model = next.0, quit = f.quit, pending = [..acc.pending, ..f.pending])
                end);
    (
        model = state.model,
        quit = state.quit,
        frame = app.view(state.model, w, h),
        pending = state.pending);

-- | Run the program in a session until it quits, answering its last model. Keys, resizes and the answers of the program's own commands feed one queue, and the screen is drawn once per burst.
pub let run(@M: Type, @E: Type, app: Tui(M, E)) -> Try(Async, Io/Error, M) =
    Session/with(
        (s) =>
            let queue: {Channel/Sender(Event(E)), Channel/Receiver(Event(E))} = Channel/new(256)!;
            let push(e: Event(E)) -> Async({}) =
                let _ = Channel/send(queue.0, e)!;
                Async/pure(());
            let reader() -> Async({}) =
                let got = Session/read(@E, s)!;
                match got
                | none() => Async/pure(())
                | some(events) =>
                    let _ = List/each(events, push)!;
                    reader()
                end;
            let ticker() -> Async({}) =
                let _ = Async/sleep(Duration/of_millis(100))!;
                let known = Session/last_size(s)!;
                let now = Try/run(Session/size(s))!;
                match now
                | failure(_) => ticker()
                | success(sz) =>
                    match sz == known
                    | true => ticker()
                    | false =>
                        let _ = push(Event/resize(sz.cols, sz.rows))!;
                        ticker()
                    end
                end;
            let answer(a: Async(E)) -> Async({}) =
                let e = a!;
                push(Event/custom(e));
            let issue(c: Cmd(E)) -> Async(Bool) =
                let f = flatten(c);
                let _ = List/each(f.pending, (a) => Async/go(answer(a)))!;
                Async/pure(f.quit);
            let draw(m: M) -> Async({}) =
                let sz = Session/last_size(s)!;
                Session/draw(s, app.view(m, sz.cols, sz.rows), app.cursor(m, sz.cols, sz.rows));
            let drain(m: M, events: List(Event(E))) -> Async({M, Bool}) =
                match events
                | [] => Async/pure((m, false))
                | [e, ..more] =>
                    let next = app.update(m, e);
                    let stop = issue(next.1)!;
                    match stop
                    | true => Async/pure((next.0, true))
                    | false => drain(next.0, more)
                    end
                end;
            -- Everything queued behind the event that woke the loop, so a burst still draws once.
            let burst(acc: List(Event(E))) -> Async(List(Event(E))) =
                let more = Async/lift(Channel/try_recv(queue.1))!;
                match more | none() => Async/pure(acc) | some(e) => burst([..acc, e]) end;
            let loop(m: M) -> Async(M) =
                let woke = Channel/recv(queue.1)!;
                match woke
                | none() => Async/pure(m)
                | some(e) =>
                    let events = burst([e])!;
                    let folded = drain(m, events)!;
                    match folded.1
                    | true => Async/pure(folded.0)
                    | false =>
                        let _ = draw(folded.0)!;
                        loop(folded.0)
                    end
                end;
            let _ = Async/go(reader())!;
            let _ = Async/go(ticker())!;
            let first = issue(app.init.1)!;
            match first
            | true => Try/pure(app.init.0)
            | false =>
                let _ = draw(app.init.0)!;
                let m = loop(app.init.0)!;
                Try/pure(m)
            end);
