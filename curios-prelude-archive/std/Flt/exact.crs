use /std/{Flt, Nat, Int, Bool, Bytes, Option};
use /std/Flt/{Rounding};

let pow2(k: Nat) -> Nat =
    Nat/shl(1, k);

--- How many bits spell `n`: none for zero, one past the highest set bit otherwise.
pub let bit_len(n: Nat) -> Nat =
    match n | 0 => 0 | _ => Nat/log2(n) + 1 end;

--- `f`'s bit pattern as a natural.
pub let bits(f: Flt) -> Nat =
    Bytes/to_nat(Flt/to_le_bytes(f));

--- The float a 64-bit pattern spells, eight bytes least significant first.
pub let of_bits(n: Nat) -> Flt =
    let at = (i: Nat) => Nat/to_byte(Nat/shr(n, 8 * i) % 256);
    Flt/of_le_bytes(x[at(0), at(1), at(2), at(3), at(4), at(5), at(6), at(7)]);

--- Whether a significand that lost bits steps up to the next one: `above` says the lost part is past half a unit, `tie` that it is exactly half, `odd` that the kept significand is odd, `inexact` that anything was lost.
pub let rounds_up(r: Rounding, negative: Bool, above: Bool, tie: Bool, odd: Bool, inexact: Bool) -> Bool =
    match r
    | ties_to_even() => above || (tie && odd)
    | ties_to_away() => above || tie
    | toward_zero() => false
    | toward_positive() => inexact && Bool/not(negative)
    | toward_negative() => inexact && negative
    end;

--- Whether a result past the largest finite value becomes the infinity of its sign rather than that value (§7.4): always when rounding to nearest, when directed only toward the infinity of its own sign.
let overflows_to_infinity(r: Rounding, negative: Bool) -> Bool =
    match r
    | toward_zero() => false
    | toward_positive() => Bool/not(negative)
    | toward_negative() => negative
    | _ => true
    end;

let sign_bit(negative: Bool) -> Nat =
    match negative | true => pow2(63) | false => 0 end;

--- The float a significand under `2^53` and its exponent encode: a subnormal when the hidden bit is clear, which leaves the exponent at the grid; otherwise the biased field, past the largest of which an overflow answers what `r` sends it to.
let encode(r: Rounding, negative: Bool, m: Nat, e: Int) -> Flt =
    let field = e + +1075;
    choose
    | m < pow2(52) => of_bits(sign_bit(negative) + m)
    | field >= +2047 =>
        match overflows_to_infinity(r, negative)
        | true => of_bits(sign_bit(negative) + 0x7FF0000000000000)
        | false => of_bits(sign_bit(negative) + 0x7FEFFFFFFFFFFFFF)
        end
    | _ => of_bits(sign_bit(negative) + Nat/shl(Int/abs(field), 52) + (m - pow2(52)))
    end;

--- The float `(-1)^negative · (m + ε) · 2^e` rounds to in `r`, `ε` in `(0, 1)` when `sticky` and zero when not — `curios_num::Floating`'s `round`, line for line, so the rounding a type reasons about is the one every primitive folds by.
pub let round(r: Rounding, negative: Bool, m: Nat, e: Int, sticky: Bool) -> Flt =
    let width = Nat/to_int(bit_len(m));
    let grid = -1074 - e;
    choose
    | m == 0 && Bool/not(sticky) => of_bits(sign_bit(negative))
    -- The whole value, a residue included, lies under half the least subnormal.
    | grid > width =>
        match rounds_up(r, negative, false, false, false, true)
        | true => of_bits(sign_bit(negative) + 1)
        | false => of_bits(sign_bit(negative))
        end
    | _ =>
        let shift = Int/max(width - +53, grid);
        match shift <= +0
        -- Nothing dropped: normalize left until the significand is full or the exponent reaches the grid.
        | true =>
            let left = Int/abs(Int/min(+0 - shift, e + +1074));
            encode(r, negative, Nat/shl(m, left), e - Nat/to_int(left))
        | false =>
            let s = Int/abs(shift);
            let kept = Nat/shr(m, s);
            let dropped = m - Nat/shl(kept, s);
            let half = pow2(s - 1);
            let above = dropped > half || (dropped == half && sticky);
            let tie = dropped == half && Bool/not(sticky);
            let inexact = sticky || dropped != 0;
            let up = rounds_up(r, negative, above, tie, Bool/not(Nat/is_even(kept)), inexact);
            let stepped = match up | true => kept + 1 | false => kept end;
            -- Rounding up can carry out of the significand, one bit wider.
            match stepped == pow2(53)
            | true => encode(r, negative, pow2(52), e + shift + +1)
            | false => encode(r, negative, stepped, e + shift)
            end
        end
    end;

--- A finite float's value, `(-1)^negative · magnitude · 2^exponent`, unnormalized: nothing is lost by representing one, and the arithmetic below keeps it so.
pub struct Dyadic: pub Type {
    negative: Bool,
    magnitude: Nat,
    exponent: Int,
}

--- The dyadic a finite `f` denotes, `none` for an infinity or a NaN. A zero keeps its sign, which only a caller that rounds reads.
pub let of_flt(f: Flt) -> Option(Dyadic) =
    let b = bits(f);
    let negative = b >= pow2(63);
    let field = Nat/shr(b, 52) % 2048;
    let fraction = b % pow2(52);
    choose
    | field == 2047 => Option/none()
    | field == 0 => Option/some(Dyadic { negative = negative, magnitude = fraction, exponent = -1074 })
    | _ =>
        Option/some(Dyadic {
            negative = negative,
            magnitude = fraction + pow2(52),
            exponent = Nat/to_int(field) - +1075,
        })
    end;

--- The exact product.
pub let mul(a: Dyadic, b: Dyadic) -> Dyadic =
    Dyadic {
        negative = a.negative != b.negative,
        magnitude = a.magnitude * b.magnitude,
        exponent = a.exponent + b.exponent,
    };

--- `a`'s magnitude at the lower exponent `to`, exactly.
let lowered(a: Dyadic, to: Int) -> Nat =
    Nat/shl(a.magnitude, Int/abs(a.exponent - to));

--- The exact sum. A zero sum is positive; which zero a rounded sum answers is the rounding's to say.
pub let add(a: Dyadic, b: Dyadic) -> Dyadic =
    let e = Int/min(a.exponent, b.exponent);
    let x = lowered(a, e);
    let y = lowered(b, e);
    choose
    | a.negative == b.negative => Dyadic { negative = a.negative, magnitude = x + y, exponent = e }
    | x >= y => Dyadic { negative = a.negative && x != y, magnitude = x - y, exponent = e }
    | _ => Dyadic { negative = b.negative, magnitude = y - x, exponent = e }
    end;

--- Whether the two denote the same number, the zeros one number.
pub let same_value(a: Dyadic, b: Dyadic) -> Bool =
    let e = Int/min(a.exponent, b.exponent);
    let x = lowered(a, e);
    let y = lowered(b, e);
    x == y && (x == 0 || a.negative == b.negative);

--- `magnitude · 2^exponent` rounded to 53 bits in `r` with no ceiling on the exponent, compared with the largest finite value: IEEE's test for overflow (§7.4), which the ceiling a real rounding applies would hide.
pub let overflows(r: Rounding, negative: Bool, m: Nat, e: Int, sticky: Bool) -> Bool =
    let width = bit_len(m);
    choose
    | width == 0 => false
    | width <= 53 => e + Nat/to_int(width) > +1024
    | _ =>
        let s = width - 53;
        let kept = Nat/shr(m, s);
        let dropped = m - Nat/shl(kept, s);
        let half = pow2(s - 1);
        let above = dropped > half || (dropped == half && sticky);
        let tie = dropped == half && Bool/not(sticky);
        let inexact = sticky || dropped != 0;
        let up = rounds_up(r, negative, above, tie, Bool/not(Nat/is_even(kept)), inexact);
        let stepped = match up | true => kept + 1 | false => kept end;
        e + Nat/to_int(s + bit_len(stepped)) > +1024
    end;

--- Whether `m · 2^e` is nonzero and below the least normal `2^-1022` — and so is any value above it by less than `2^e`, which a quotient's sticky residue is: tininess detected before rounding, the one reading this library takes (§7.5).
pub let tiny(m: Nat, e: Int) -> Bool =
    m != 0 && e + Nat/to_int(bit_len(m)) <= -1022;

--- The quotient of two nonzero dyadics to 64 bits and past, with whether anything remained: `q · 2^e` below the exact quotient by less than a unit exactly when `sticky`, which every rounding reads the same as the quotient itself.
pub let quotient(a: Dyadic, b: Dyadic) -> {Dyadic, Bool} =
    let k = 64 + bit_len(b.magnitude);
    let scaled = Nat/shl(a.magnitude, k);
    match b.magnitude
    | 0 => (Dyadic { negative = false, magnitude = 0, exponent = +0 }, false)
    | d + 1 =>
        (Dyadic {
            negative = a.negative != b.negative,
            magnitude = scaled / (d + 1),
            exponent = a.exponent - b.exponent - Nat/to_int(k),
        }, scaled % (d + 1) != 0)
    end;
