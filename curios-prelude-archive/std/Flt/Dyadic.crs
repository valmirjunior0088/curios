use /std/{Flt, Nat, Int, Bool, Option};
use /std/Flt/{exact};

--- A finite float's value, `(-1)^negative · magnitude · 2^exponent`, unnormalized: nothing is lost by representing one, and the arithmetic below keeps it so.
pub struct Dyadic: pub Type {
    negative: Bool,
    magnitude: Nat,
    exponent: Int,
}

--- The dyadic a finite `f` denotes, `none` for an infinity or a NaN. A zero keeps its sign, which only a caller that rounds reads.
pub let try_of(f: Flt) -> Option(Dyadic) =
    match Flt/finite(f) | some(ok) => Option/some(of(f, @ok)) | none() => Option/none() end;

--- The exact value of a finite `f`, its sign kept on a zero as well.
pub let of(f: Flt, @ok: Flt/Finite(f)) -> Dyadic =
    Dyadic {
        negative = Flt/is_sign_minus(f),
        magnitude = Int/abs(Flt/mantissa(f, @ok)),
        exponent = Flt/exponent(f, @ok),
    };

--- The exact product.
pub let mul(a: Dyadic, b: Dyadic) -> Dyadic =
    Dyadic {
        negative = a.negative != b.negative,
        magnitude = a.magnitude * b.magnitude,
        exponent = a.exponent + b.exponent,
    };

--- `a`'s magnitude at the lower exponent `to`, exactly.
let lowered(a: Dyadic, to: Int) -> Nat =
    Nat/shl(a.magnitude, Int/abs(a.exponent - to));

--- The exact sum. A zero sum is positive; which zero a rounded sum answers is the rounding's to say.
pub let add(a: Dyadic, b: Dyadic) -> Dyadic =
    let e = Int/min(a.exponent, b.exponent);
    let x = lowered(a, e);
    let y = lowered(b, e);
    choose
    | a.negative == b.negative => Dyadic { negative = a.negative, magnitude = x + y, exponent = e }
    | x >= y => Dyadic { negative = a.negative && x != y, magnitude = x - y, exponent = e }
    | _ => Dyadic { negative = b.negative, magnitude = y - x, exponent = e }
    end;

--- Whether the two denote the same number, the zeros one number.
pub let same_value(a: Dyadic, b: Dyadic) -> Bool =
    let e = Int/min(a.exponent, b.exponent);
    let x = lowered(a, e);
    let y = lowered(b, e);
    x == y && (x == 0 || a.negative == b.negative);

--- The quotient of `a` by a nonzero `b` to 64 bits and past, with whether anything remained: `q · 2^e` below the exact quotient by less than a unit exactly when `sticky`, which every rounding reads the same as the quotient itself.
pub let quotient(a: Dyadic, b: Dyadic, @ok: Nat/Lt(0, b.magnitude)) -> {Dyadic, Bool} =
    let k = 64 + exact/bit_len(b.magnitude);
    let scaled = Nat/shl(a.magnitude, k);
    (match b.magnitude: (m) => (Nat/Lt(0, m)) -> {Dyadic, Bool}
    | 0 => (no) => match no end
    | d + 1 =>
        (_) =>
            (Dyadic {
                negative = a.negative != b.negative,
                magnitude = scaled / (d + 1),
                exponent = a.exponent - b.exponent - Nat/to_int(k),
            }, scaled % (d + 1) != 0)
    end)(ok);
