use /std/{Flt, Nat, Int, Bool, State, Monad, Lift};
use /std/Flt/{Rounding, Exceptions, rounded, signals};

--- What the environment holds: the rounding direction every operation below reads (§4.2), and the exceptions raised so far (§7).
pub let Status: Type = {rounding: Rounding, exceptions: Exceptions};

--- IEEE 754's floating-point environment as a monad (§4.2, §7): a computation that rounds in the environment's direction and records every exception it raises, both threaded as state rather than held by the machine. A `State` over the same status sequences in an `Env` region through its `Lift`, and `run` is the one way out.
pub struct Env(A: Type): Type {
    State(Status, A),
}

--- One step over the status.
let step(@A: Type, f: (Status) -> {A, Status}) -> Env(A) =
    Env { State/state(f) };

--- `a`, with the environment untouched.
pub let pure(@A: Type, a: A) -> Env(A) =
    step((s) => (a, s));

--- `m`, then `f` on its answer in the environment it left.
pub let bind(@A: Type, @B: Type, m: Env(A), f: (A) -> Env(B)) -> Env(B) =
    Env { State/bind(m.0, (a) => f(a).0) };

--- `a`, with `e` raised.
let raising(@A: Type, a: A, e: Exceptions) -> Env(A) =
    step((s) => (a, (rounding = s.rounding, exceptions = Exceptions/union(s.exceptions, e))));

--- An operation of `rounded` in the environment's direction, raising what its `signals` twin says.
let rounding_by(value: (Rounding) -> Flt, raised: (Rounding) -> Exceptions) -> Env(Flt) =
    step((s) =>
        (value(s.rounding), (
            rounding = s.rounding,
            exceptions = Exceptions/union(s.exceptions, raised(s.rounding)),
        )));

--- `a + b` in the environment's direction.
pub let add(a: Flt, b: Flt) -> Env(Flt) =
    rounding_by((r) => rounded/add(r, a, b), (r) => signals/add(r, a, b));

--- `a - b` in the environment's direction.
pub let sub(a: Flt, b: Flt) -> Env(Flt) =
    rounding_by((r) => rounded/sub(r, a, b), (r) => signals/sub(r, a, b));

--- `a · b` in the environment's direction.
pub let mul(a: Flt, b: Flt) -> Env(Flt) =
    rounding_by((r) => rounded/mul(r, a, b), (r) => signals/mul(r, a, b));

--- `a / b` in the environment's direction.
pub let div(a: Flt, b: Flt) -> Env(Flt) =
    rounding_by((r) => rounded/div(r, a, b), (r) => signals/div(r, a, b));

--- `a · b + c`, rounded once in the environment's direction.
pub let fma(a: Flt, b: Flt, c: Flt) -> Env(Flt) =
    rounding_by((r) => rounded/fma(r, a, b, c), (r) => signals/fma(r, a, b, c));

--- The square root of `a` in the environment's direction.
pub let sqrt(a: Flt) -> Env(Flt) =
    rounding_by((r) => rounded/sqrt(r, a), (r) => signals/sqrt(r, a));

--- The `Flt` `n` rounds to in the environment's direction.
pub let of_nat(n: Nat) -> Env(Flt) =
    rounding_by((r) => rounded/of_nat(r, n), (r) => signals/of_nat(r, n));

--- The `Flt` `n` rounds to in the environment's direction.
pub let of_int(n: Int) -> Env(Flt) =
    rounding_by((r) => rounded/of_int(r, n), (r) => signals/of_int(r, n));

--- `f · 2^n` in the environment's direction.
pub let scale(f: Flt, n: Int) -> Env(Flt) =
    rounding_by((r) => rounded/scale(r, f, n), (r) => signals/scale(r, f, n));

--- IEEE's `remainder`, which is exact and so reads no direction.
pub let remainder(x: Flt, y: Flt) -> Env(Flt) =
    raising(Flt/remainder(x, y), signals/remainder(x, y));

--- IEEE's `roundToIntegralExact` (§5.3.1): the integral value `a` rounds to in the environment's direction, raising inexact when it differs from `a`. The five named roundings, which never raise it, are `rounded/to_integral`.
pub let to_integral_exact(a: Flt) -> Env(Flt) =
    rounding_by((r) => rounded/to_integral(r, a), (r) => signals/to_integral_exact(r, a));

--- Only the invalid operation, when `invalid` holds.
let invalid_when(invalid: Bool) -> Exceptions =
    match invalid | true => Exceptions { ..Exceptions/none, invalid = true } | false => Exceptions/none end;

--- A comparison's answer, raising the invalid operation when `invalid` holds.
let compared(answer: Bool, invalid: Bool) -> Env(Bool) =
    raising(answer, invalid_when(invalid));

--- Whether a quiet comparison is invalid: only at a signaling NaN (§5.11).
let quiet(a: Flt, b: Flt) -> Bool =
    Flt/is_signaling(a) || Flt/is_signaling(b);

--- Whether a signaling comparison is invalid: at any NaN (§5.11).
let signaling(a: Flt, b: Flt) -> Bool =
    Flt/is_nan(a) || Flt/is_nan(b);

--- `compareQuietEqual`: whether the two are equal, a NaN equal to nothing.
pub let eql(a: Flt, b: Flt) -> Env(Bool) =
    compared(a == b, quiet(a, b));

--- `compareQuietNotEqual`.
pub let neq(a: Flt, b: Flt) -> Env(Bool) =
    compared(a != b, quiet(a, b));

--- `compareSignalingLess`: invalid at any NaN, which is what `<` means under IEEE (§5.11).
pub let lt(a: Flt, b: Flt) -> Env(Bool) =
    compared(a < b, signaling(a, b));

--- `compareSignalingLessEqual`.
pub let le(a: Flt, b: Flt) -> Env(Bool) =
    compared(a <= b, signaling(a, b));

--- `compareSignalingGreater`.
pub let gt(a: Flt, b: Flt) -> Env(Bool) =
    compared(a > b, signaling(a, b));

--- `compareSignalingGreaterEqual`.
pub let ge(a: Flt, b: Flt) -> Env(Bool) =
    compared(a >= b, signaling(a, b));

--- `compareSignalingEqual`: equality that is invalid at any NaN.
pub let eql_signaling(a: Flt, b: Flt) -> Env(Bool) =
    compared(a == b, signaling(a, b));

--- `compareSignalingNotEqual`.
pub let neq_signaling(a: Flt, b: Flt) -> Env(Bool) =
    compared(a != b, signaling(a, b));

--- `compareQuietLess`: `<` invalid only at a signaling NaN.
pub let lt_quiet(a: Flt, b: Flt) -> Env(Bool) =
    compared(a < b, quiet(a, b));

--- `compareQuietLessEqual`.
pub let le_quiet(a: Flt, b: Flt) -> Env(Bool) =
    compared(a <= b, quiet(a, b));

--- `compareQuietGreater`.
pub let gt_quiet(a: Flt, b: Flt) -> Env(Bool) =
    compared(a > b, quiet(a, b));

--- `compareQuietGreaterEqual`.
pub let ge_quiet(a: Flt, b: Flt) -> Env(Bool) =
    compared(a >= b, quiet(a, b));

--- `compareQuietUnordered`: whether either is a NaN.
pub let unordered(a: Flt, b: Flt) -> Env(Bool) =
    compared(Flt/unordered(a, b), quiet(a, b));

--- `raiseFlags`: raise `e`.
pub let raise(e: Exceptions) -> Env({}) =
    raising((), e);

--- `lowerFlags`: lower `e`, leaving the rest raised.
pub let lower(e: Exceptions) -> Env({}) =
    step((s) => ((), (rounding = s.rounding, exceptions = Exceptions/difference(s.exceptions, e))));

--- `testFlags`: whether any of `e` is raised.
pub let test(e: Exceptions) -> Env(Bool) =
    step((s) => (Exceptions/any(Exceptions/intersection(s.exceptions, e)), s));

--- `saveAllFlags`: every exception raised so far.
pub let save: Env(Exceptions) =
    step((s) => (s.exceptions, s));

--- `restoreFlags`: the raised exceptions set to `e`, as `save` answered them.
pub let restore(e: Exceptions) -> Env({}) =
    step((s) => ((), (rounding = s.rounding, exceptions = e)));

--- `testSavedFlags`: whether any of `e` is among what `save` answered.
pub let test_saved(saved: Exceptions, e: Exceptions) -> Bool =
    Exceptions/any(Exceptions/intersection(saved, e));

--- `getBinaryRoundingDirection`, and IEEE's `saveModes`: the direction the operations round in, the one mode this environment holds.
pub let rounding: Env(Rounding) =
    step((s) => (s.rounding, s));

--- `setBinaryRoundingDirection`, and IEEE's `restoreModes` given what `rounding` answered; `set_rounding(Rounding/ties_to_even())` is `defaultModes`.
pub let set_rounding(r: Rounding) -> Env({}) =
    step((s) => ((), (rounding = r, exceptions = s.exceptions)));

--- `m` rounding in `r`, the direction before it restored after: a block with a constant rounding attribute (§4.1).
pub let with_rounding(@A: Type, r: Rounding, m: Env(A)) -> Env(A) =
    let previous = rounding!;
    let _ = set_rounding(r)!;
    let a = m!;
    let _ = set_rounding(previous)!;
    pure(a);

--- `m` from the default environment — ties to even, nothing raised — answering its value and every exception it raised.
pub let run(@A: Type, m: Env(A)) -> {A, Exceptions} =
    let (a, s) = State/run(m.0, (rounding = Rounding/ties_to_even(), exceptions = Exceptions/none));
    (a, s.exceptions);

satisfy Monad(Env) {
    pure = pure,
    bind = bind,
}

--- A `State` over the environment's status, sequenced in an `Env` region.
satisfy Lift((A: Type) => State(Status, A), Env) {
    lift(@_, m) = Env { m },
}
