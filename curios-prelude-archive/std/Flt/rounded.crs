use /std/{Flt, Nat, Int, Bool, Str, Option};
use /std/Flt/{Rounding, exact, Dyadic};

--- `a + b`, in the direction `r` names.
pub let add(r: Rounding, a: Flt, b: Flt) -> Flt =
    match r
    | ties_to_even() => /sys/Flt/add(a, b)
    | ties_to_away() => /sys/Flt/ties_to_away/add(a, b)
    | toward_zero() => /sys/Flt/toward_zero/add(a, b)
    | toward_positive() => /sys/Flt/toward_positive/add(a, b)
    | toward_negative() => /sys/Flt/toward_negative/add(a, b)
    end;

--- `a - b`, in the direction `r` names.
pub let sub(r: Rounding, a: Flt, b: Flt) -> Flt =
    match r
    | ties_to_even() => /sys/Flt/sub(a, b)
    | ties_to_away() => /sys/Flt/ties_to_away/sub(a, b)
    | toward_zero() => /sys/Flt/toward_zero/sub(a, b)
    | toward_positive() => /sys/Flt/toward_positive/sub(a, b)
    | toward_negative() => /sys/Flt/toward_negative/sub(a, b)
    end;

--- `a · b`, in the direction `r` names.
pub let mul(r: Rounding, a: Flt, b: Flt) -> Flt =
    match r
    | ties_to_even() => /sys/Flt/mul(a, b)
    | ties_to_away() => /sys/Flt/ties_to_away/mul(a, b)
    | toward_zero() => /sys/Flt/toward_zero/mul(a, b)
    | toward_positive() => /sys/Flt/toward_positive/mul(a, b)
    | toward_negative() => /sys/Flt/toward_negative/mul(a, b)
    end;

--- `a / b`, in the direction `r` names.
pub let div(r: Rounding, a: Flt, b: Flt) -> Flt =
    match r
    | ties_to_even() => /sys/Flt/div(a, b)
    | ties_to_away() => /sys/Flt/ties_to_away/div(a, b)
    | toward_zero() => /sys/Flt/toward_zero/div(a, b)
    | toward_positive() => /sys/Flt/toward_positive/div(a, b)
    | toward_negative() => /sys/Flt/toward_negative/div(a, b)
    end;

--- `a · b + c`, rounded once, in the direction `r` names.
pub let fma(r: Rounding, a: Flt, b: Flt, c: Flt) -> Flt =
    match r
    | ties_to_even() => /sys/Flt/fma(a, b, c)
    | ties_to_away() => /sys/Flt/ties_to_away/fma(a, b, c)
    | toward_zero() => /sys/Flt/toward_zero/fma(a, b, c)
    | toward_positive() => /sys/Flt/toward_positive/fma(a, b, c)
    | toward_negative() => /sys/Flt/toward_negative/fma(a, b, c)
    end;

--- The square root of `a`, in the direction `r` names.
pub let sqrt(r: Rounding, a: Flt) -> Flt =
    match r
    | ties_to_even() => /sys/Flt/sqrt(a)
    | ties_to_away() => /sys/Flt/ties_to_away/sqrt(a)
    | toward_zero() => /sys/Flt/toward_zero/sqrt(a)
    | toward_positive() => /sys/Flt/toward_positive/sqrt(a)
    | toward_negative() => /sys/Flt/toward_negative/sqrt(a)
    end;

--- The `Flt` a `Nat` rounds to in the direction `r` names.
pub let of_nat(r: Rounding, n: Nat) -> Flt =
    match r
    | ties_to_even() => /sys/Nat/to_flt(n)
    | ties_to_away() => /sys/Flt/ties_to_away/of_nat(n)
    | toward_zero() => /sys/Flt/toward_zero/of_nat(n)
    | toward_positive() => /sys/Flt/toward_positive/of_nat(n)
    | toward_negative() => /sys/Flt/toward_negative/of_nat(n)
    end;

--- The `Flt` an `Int` rounds to in the direction `r` names.
pub let of_int(r: Rounding, n: Int) -> Flt =
    match r
    | ties_to_even() => /sys/Int/to_flt(n)
    | ties_to_away() => /sys/Flt/ties_to_away/of_int(n)
    | toward_zero() => /sys/Flt/toward_zero/of_int(n)
    | toward_positive() => /sys/Flt/toward_positive/of_int(n)
    | toward_negative() => /sys/Flt/toward_negative/of_int(n)
    end;

--- The integral value `a` rounds to in the direction `r` names (§5.3.1): `floor` toward negative, `ceil` toward positive, `trunc` toward zero, `nearest` ties to even and `round` ties away.
pub let to_integral(r: Rounding, a: Flt) -> Flt =
    match r
    | ties_to_even() => /sys/Flt/nearest(a)
    | ties_to_away() => /sys/Flt/round(a)
    | toward_zero() => /sys/Flt/trunc(a)
    | toward_positive() => /sys/Flt/ceil(a)
    | toward_negative() => /sys/Flt/floor(a)
    end;

--- `m · 2^e`, rounded once in the direction `r` names: the rounding every operation in this module performs, stated over the exact value rather than over operands. An exact zero is `+0.0`.
pub let of_dyadic(r: Rounding, m: Int, e: Int) -> Flt =
    exact/round(r, m < +0, Int/abs(m), e, false);

--- `f · 2^n`, rounded once in the direction `r` names (§5.3.3 `scaleB`). A NaN answers itself quieted; an infinity and a zero are their own scalings.
pub let scale(r: Rounding, f: Flt, n: Int) -> Flt =
    choose
    | Flt/is_nan(f) => f + f
    | Flt/is_zero(f) => f
    | some(d) = Dyadic/try_of(f) => exact/round(r, d.negative, d.magnitude, d.exponent + n, false)
    -- An infinity, its own scaling.
    | _ => f
    end;

--- Whether truncating to `t` moves away from zero when rounding in the direction `r` names, `fraction` being the magnitude truncation dropped: exact, since the fractional part of a float is a float.
let steps_away(r: Rounding, negative: Bool, t: Nat, fraction: Flt) -> Bool =
    exact/rounds_up(r, negative, fraction > 0.5, fraction == 0.5, Bool/not(Nat/is_even(t)), fraction != +0.0);

--- IEEE's `convertToInteger` in the direction `r` names (§5.8): `f` rounded to an `Int`, exactly — `Flt/to_int`'s truncation under the bound, stepped one away from zero where the direction says the dropped fraction rounds up.
pub let to_int(r: Rounding, f: Flt, @ok: Flt/Finite(f)) -> Int =
    let t = Flt/to_int(f, @ok);
    let negative = f < +0.0;
    match steps_away(r, negative, Int/abs(t), Flt/abs(f - Int/to_flt(t)))
    | false => t
    | true => match negative | true => t - +1 | false => t + +1 end
    end;

--- `to_int` for a non-negative `f`, as a `Nat`: `Flt/to_nat`'s truncation under the bound, stepped up where the direction says the dropped fraction rounds up.
pub let to_nat(r: Rounding, f: Flt, @ok: Flt/NonNeg(f)) -> Nat =
    let t = Flt/to_nat(f, @ok);
    match steps_away(r, false, t, f - Nat/to_flt(t)) | true => t + 1 | false => t end;

--- `Flt/of_str` in the direction `r` names: decimal or hex text read exactly and rounded once, the special names read as they are. `none` for text that spells no number.
pub let of_str(r: Rounding, s: Str) -> Option(Flt) =
    Flt/of_str_in(r, s);

--- `Flt/of_hex_str` in the direction `r` names.
pub let of_hex_str(r: Rounding, s: Str) -> Option(Flt) =
    Flt/of_hex_str_in(r, s);

--- `Flt/of_decimal` in the direction `r` names: `d · 10^e`, of the sign `negative` gives, rounded once.
pub let of_decimal(r: Rounding, negative: Bool, d: Nat, e: Int, digits: Nat) -> Flt =
    Flt/of_decimal_in(r, negative, d, e, digits);

--- `Flt/to_str_significant` in the direction `r` names: exactly `n` significant digits (§5.12.2).
pub let to_str_significant(r: Rounding, f: Flt, n: Nat, @ok: Nat/Lt(0, n)) -> Str =
    match n
    | 0 => match ok end
    | k + 1 => Flt/to_str_significant_in(r, f, k + 1)
    end;
