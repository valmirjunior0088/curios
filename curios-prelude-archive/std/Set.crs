use /std/{Nat, Bool, Str, List, Map, Equal, Show, Spell};
use /std/Map/{Key};

-- | A set of keys.
pub struct Set(K: Type): Type {
    map: Map(K),
}

-- | The empty set.
pub let empty(@K: Type) -> Set(K) =
    Set { map = Map/empty() };

-- | How many elements.
pub let len(@K: Type, s: Set(K)) -> Nat =
    Map/len(s.map);

-- | Whether `k` is an element.
pub let has(@K: Type, use Key(K), s: Set(K), k: K) -> Bool =
    Map/has(s.map, k);

-- | `s` with `k`.
pub let insert(@K: Type, use Key(K), s: Set(K), k: K) -> Set(K) =
    Set { map = Map/insert(s.map, k, k) };

-- | `s` without `k`; unchanged when absent.
pub let remove(@K: Type, use Key(K), s: Set(K), k: K) -> Set(K) =
    Set { map = Map/remove(s.map, k) };

-- | Over the elements in the order of their encoded keys, with `f(elem, acc)`.
pub let fold(@K: Type, @A: Type, s: Set(K), init: A, f: (K, A) -> A) -> A =
    Map/fold(s.map, init, (_, k, acc) => f(k, acc));

-- | The elements, in the order of their encoded keys.
pub let to_list(@K: Type, s: Set(K)) -> List(K) =
    Map/values(s.map);

-- | The set of the elements of `l`.
pub let of(@K: Type, use Key(K), l: List(K)) -> Set(K) =
    List/fold(l, empty(), (k, acc) => insert(acc, k));

-- | Every element of either.
pub let union(@K: Type, a: Set(K), b: Set(K)) -> Set(K) =
    Set { map = Map/union(a.map, b.map) };

satisfy (@K: Type, use Equal(K)) => Equal(Set(K)) {
    eql(a, b) = to_list(a) == to_list(b),
    neq(a, b) = to_list(a) != to_list(b),
}

satisfy (@K: Type, use Show(K)) => Show(Set(K)) {
    show(s) = Show/show(to_list(s)),
}

satisfy (@K: Type, use Spell(K)) => Spell(Set(K)) {
    spell(s) = Str/flatten(["Set/of(", Spell/spell(to_list(s)), ")"]),
}
