use /std/{Bytes, Byte, Str, Bool, Char, Flt, Nat, Parse, Result, Option, List};
use /std/Json/{Json};

let is_num_byte(byte: Byte) -> Bool =
    match Byte/to_nat(byte)
    | 45 => true
    | 43 => true
    | 46 => true
    | 101 => true
    | 69 => true
    | _ => Nat/in_range(Byte/to_nat(byte), 0x30, 0x39)
    end;

let parse_null: Parse(Json) =
    Parse/map(Parse/take_literal("null"), (_) => Json/null());

let parse_true_val: Parse(Json) =
    Parse/map(Parse/take_literal("true"), (_) => Json/bool(true));

let parse_false_val: Parse(Json) =
    Parse/map(Parse/take_literal("false"), (_) => Json/bool(false));

let parse_num: Parse(Json) =
    let chunk = Parse/take_while(is_num_byte)!;
    match Flt/of_str(Option/unwrap_or(Str/of_bytes(chunk), ""))
    | some(value) => Parse/pure(Json/num(value))
    | none() => Parse/fail("expected number")
    end;

let is_not_string_special(byte: Byte) -> Bool =
    match Byte/to_nat(byte) | 34 => false | 92 => false | _ => true end;

let hex_digit: Parse(Nat) =
    let byte = Parse/any_byte!;
    match Char/of_ascii(byte)
    | some(c) =>
        match Char/of_hex_digit(c)
        | some(v) => Parse/pure(v)
        | none() => Parse/fail("invalid hex digit")
        end
    | none() => Parse/fail("invalid hex digit")
    end;

let hex4: Parse(Nat) =
    let a = hex_digit!;
    let b = hex_digit!;
    let c = hex_digit!;
    let d = hex_digit!;
    Parse/pure(a * 0x1000 + b * 0x100 + c * 0x10 + d);

let parse_unicode: Parse(Bytes) =
    let hi = hex4!;
    match hi >= 0xD800 && hi <= 0xDBFF
    | true =>
        let _ = Parse/label(Parse/take_byte(0x5C), "expected low surrogate")!;
        let _ = Parse/label(Parse/take_byte(0x75), "expected low surrogate")!;
        let lo = hex4!;
        match lo >= 0xDC00 && lo <= 0xDFFF
        | true =>
            match Char/of_nat(0x10000 + (hi - 0xD800) * 0x400 + (lo - 0xDC00))
            | some(c) => Parse/pure(Char/to_utf8(c))
            | none() => Parse/fail("invalid Unicode scalar")
            end
        | false => Parse/fail("invalid low surrogate")
        end
    | false =>
        match Char/of_nat(hi)
        | some(c) => Parse/pure(Char/to_utf8(c))
        | none() => Parse/fail("invalid Unicode scalar")
        end
    end;

-- The backslash commits: past it, an unknown letter is a bad escape, not the end of a string segment to be closed by a quote that is not there.
let escape_fields: Parse(Bytes) =
    let byte = Parse/any_byte!;
    match Byte/to_nat(byte)
    | 34 => Parse/pure(Str/to_bytes("\""))
    | 92 => Parse/pure(Str/to_bytes("\\"))
    | 47 => Parse/pure(Str/to_bytes("/"))
    | 98 => Parse/pure(x[0x8])
    | 102 => Parse/pure(x[0xC])
    | 110 => Parse/pure(Str/to_bytes("\n"))
    | 114 => Parse/pure(Str/to_bytes("\r"))
    | 116 => Parse/pure(Str/to_bytes("\t"))
    | 117 => parse_unicode
    | _ => Parse/fail("unknown escape")
    end;

let parse_str_escape: Parse(Bytes) =
    let _ = Parse/take_byte(0x5C)!;
    Parse/commit(escape_fields);

let parse_str_segment: Parse(Bytes) =
    Parse/take_while(is_not_string_special);

let parse_str_body: Parse(List(Bytes)) =
    Parse/many0(Parse/or(parse_str_escape, parse_str_segment));

let parse_raw_str: Parse(Str) =
    let _ = Parse/take_byte(0x22)!;
    let chunks = parse_str_body!;
    let _ = Parse/take_byte(0x22)!;
    match Str/of_bytes(Bytes/flatten(chunks))
    | some(s) => Parse/pure(s)
    | none() => Parse/fail("invalid UTF-8 in string")
    end;

let parse_str_value: Parse(Json) =
    Parse/map(parse_raw_str, (s) => Json/str(s));

let is_ws(byte: Byte) -> Bool =
    match Byte/to_nat(byte)
    | 32 => true
    | 9 => true
    | 10 => true
    | 13 => true
    | _ => false
    end;

let ws: Parse({}) =
    Parse/map(Parse/take_while(is_ws), (_) => ());

let symbol(b: Byte) -> Parse(Byte) =
    let _ = ws!;
    Parse/take_byte(b);

-- A comma commits to the element after it, so `[1,]` is refused at the missing value. `Parse/sep_by0` instead backtracks a declined element to before its separator, which is the right reading for a Toml array, where a trailing comma is legal, and the wrong one here, where it surfaced as the bracket refusing the comma.
let after_comma(@A: Type, elem: Parse(A)) -> Parse(A) =
    let _ = symbol(0x2C)!;
    Parse/commit(elem);

let elements(@A: Type, elem: Parse(A)) -> Parse(List(A)) =
    Parse/bind(
        elem,
        (first) => Parse/map(Parse/many0(after_comma(elem)), (rest) => [first, ..rest]));

-- The byte after the opening bracket decides between its two continuations -- the closing bracket, or elements the aggregate then commits to -- so an empty aggregate is recognized rather than backtracked to, and `[x]` reports the value it expected instead of the bracket an `or` would have tried next. `after` is the refusal once an element has been read, where either a separator or the close would do.
let bracketed(@A: Type, open: Byte, elem: Parse(A), close: Byte, after: Str) -> Parse(List(A)) =
    let _ = symbol(open)!;
    let _ = ws!;
    let byte = Parse/peek_byte!;
    match byte == close
    | true => Parse/map(Parse/any_byte, (_) => [])
    | false =>
        let elems = Parse/commit(elements(elem))!;
        let _ = Parse/label(symbol(close), after)!;
        Parse/pure(elems)
    end;

let is_num_start(byte: Byte) -> Bool =
    match Byte/to_nat(byte) | 45 => true | _ => Nat/in_range(Byte/to_nat(byte), 0x30, 0x39) end;

-- The dispatch reads the first byte without consuming it, so each arm parses the value whole -- including the byte that selected it.
let value: Parse(Json) =
    let _ = ws!;
    let byte = Parse/peek_byte!;
    match Byte/to_nat(byte)
    | 110 => parse_null
    | 116 => parse_true_val
    | 102 => parse_false_val
    | 34 => parse_str_value
    | 91 => parse_arr
    | 123 => parse_obj
    | _ => match is_num_start(byte) | true => parse_num | false => Parse/fail("expected value") end
    end
and parse_arr: Parse(Json) =
    Parse/map(bracketed(0x5B, value, 0x5D, "expected ',' or ']'"), (elems) => Json/arr(elems))
and parse_obj: Parse(Json) =
    Parse/map(bracketed(0x7B, parse_pair, 0x7D, "expected ',' or '}'"), (pairs) => Json/obj(pairs))
-- A key commits to its colon and value: past `"a"`, the input is a member or malformed, never something else.
and parse_pair: Parse({Str, Json}) =
    let _ = ws!;
    let key = parse_raw_str!;
    Parse/commit(member_value(key))
and member_value(key: Str) -> Parse({Str, Json}) =
    let _ = symbol(0x3A)!;
    let val = value!;
    Parse/pure((key, val));

-- A whole document, which is what the module's two entry points are a pair for: `value` is composable and reads one value, and past it `nulll`, `truex`, `1 garbage` and `"a""b"` each read as their prefix and the rest went unmentioned -- `Parse/run` hands back no position, so a caller could not even learn a prefix had been taken. `Toml/decode` reaches its own end the same way. `ws` first, since every value parser consumes only the trivia *before* it.
pub let decode: Parse(Json) =
    let parsed = value!;
    let _ = ws!;
    let _ = Parse/eof!;
    Parse/pure(parsed);
