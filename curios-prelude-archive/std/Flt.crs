pub use /sys/{Flt};
pub use /syn/Flt/{FourBytes, Finite, NonNeg};
pub use /sys/Flt/{add, sub, mul, div, rem, min, max, eql, neq, lt, gt, le, ge, neg, abs, sqrt,
    floor, ceil, trunc, nearest, copysign, to_nat, to_int, to_le_bytes, of_le_bytes};
use /std/{Nat, Byte, Int, Str, Char, Bool, Option, Bytes, List, Ordering, BigNat, Equal, Compare,
    Add, Subtract, Multiply, Divide, Remainder, Show, Spell, Ordered, True, False};

-- The two infinities are spelled by division rather than by their bit patterns, and that is a dependency fact rather than a style preference: `of_le_bytes` states a length precondition, so building an infinity from bytes would make these depend on the very operation whose bound wants naming an infinity. `div` states no precondition — `Flt` division is total, an IEEE infinity being a value rather than a failure — so this direction has no edge back.
pub let pos_inf: Flt =
    div(+1.0, +0.0);

pub let neg_inf: Flt =
    div(-1.0, +0.0);

-- `nan` keeps its bit pattern, because `0.0 / 0.0` is *a* NaN whose payload the standard leaves to the implementation while `Flt` preserves bits and compares them — and `/std/Toml` promises one encoding. Nothing here depends on it: no precondition mentions NaN, since every comparison already rejects one. The literal operand settles `of_le_bytes`'s length bound by reduction, so the obligation is discharged with nothing written.
pub let nan: Flt =
    of_le_bytes(x[0x0, 0x0, 0xC0, 0x7F]);

-- Finite is stated as an open interval between the two infinities, which rejects all three non-finite floats with one ordered pair: `+inf` fails the upper bound, `-inf` the lower, and a NaN fails both, since every IEEE comparison with one is false. No `f == f` idiom and no separate NaN test.
pub let is_finite(f: Flt) -> Bool =
    f > neg_inf && f < pos_inf;

-- The total form of the reinterpretation, deciding the bound the bounded one states — the pairing every checked accessor carries, as `Bytes/get` does over `Bytes/try_get`.
pub let try_of_le_bytes(b: Bytes) -> Option(Flt) =
    match Nat/eql(Bytes/len(b), 4): (_) => Option(Flt)
    | true => Option/some(of_le_bytes(b, @True/qed()))
    | false => Option/none()
    end;

-- The procedures that decide the two narrowings' bounds, in the `Int/non_neg` idiom: the guard refines the scrutinee, so each arm's proposition reduces to `True` or to `False` and the `some` arm's obligation is discharged by the comparison itself.
--
-- Each scrutinee must be spelled as its proposition spells it, operand order included — a refinement is keyed on the term written, and `min <= f` is not the term `f >= min`. The extremes are written out because `/syn/Flt` keeps them private, so the two spellings are checked against each other by this build rather than shared through a name.
pub let finite(f: Flt) -> Option(Finite(f)) =
    match -340282350000000000000000000000000000000.0 <= f
        && f <= +340282350000000000000000000000000000000.0: (r) =>
        Option(match r: (_) => Prop | true => True | false => False end)
    | true => Option/some(True/qed())
    | false => Option/none()
    end;

pub let non_neg(f: Flt) -> Option(NonNeg(f)) =
    match f >= +0.0 && f <= +340282350000000000000000000000000000000.0: (r) =>
        Option(match r: (_) => Prop | true => True | false => False end)
    | true => Option/some(True/qed())
    | false => Option/none()
    end;

-- The total forms of the two narrowings, written over the deciders above — the pairing every checked accessor carries. Both bounds are now *decided*: `Flt` comparisons fold, so a closed call discharges its own obligation and an open one discharges it behind a guard.
--
-- `some` means the truncation is *defined*, which is exactly what the precondition says. It is deliberately not a promise that the conversion cannot trap: a defined result too large for the runtime carrier still refuses at the narrowing, as `Nat` arithmetic does past the same envelope, and checking for that here would write a backend width into `/std`.
pub let try_to_nat(f: Flt) -> Option(Nat) =
    match non_neg(f) | some(ok) => Option/some(to_nat(f, @ok)) | none() => Option/none() end;

pub let try_to_int(f: Flt) -> Option(Int) =
    match finite(f) | some(ok) => Option/some(to_int(f, @ok)) | none() => Option/none() end;

let pow2(k: Nat) -> BigNat =
    BigNat/mul/pow2(BigNat/of_nat(1), k);

let divmod(r: BigNat, s: BigNat, d: Nat) -> {Nat, BigNat} =
    match r < s | true => (d, r) | false => divmod(r - s, s, d + 1) end;

let scale_up(rpm: BigNat, s: BigNat, k: Int) -> {BigNat, Int} =
    match rpm > s | true => scale_up(rpm, BigNat/mul/small(s, 10), k + 1) | false => (s, k) end;

let scale_down(
    r: BigNat,
    mp: BigNat,
    mm: BigNat,
    s: BigNat,
    k: Int,
) -> {BigNat, BigNat, BigNat, Int} =
    match BigNat/mul/small(r + mp, 10) <= s
    | true =>
        scale_down(
            BigNat/mul/small(r, 10),
            BigNat/mul/small(mp, 10),
            BigNat/mul/small(mm, 10),
            s,
            k - 1)
    | false => (r, mp, mm, k)
    end;

let generate(r: BigNat, s: BigNat, mp: BigNat, mm: BigNat, even: Bool) -> List(Nat) =
    let r10 = BigNat/mul/small(r, 10);
    let mp10 = BigNat/mul/small(mp, 10);
    let mm10 = BigNat/mul/small(mm, 10);
    let (d, rem) = divmod(r10, s, 0);
    let low = match even | true => rem <= mm10 | false => rem < mm10 end;
    let high = match even | true => rem + mp10 >= s | false => rem + mp10 > s end;
    match low || high
    | true =>
        let last =
            choose
            | Bool/not(low) => d + 1
            | Bool/not(high) => d
            | BigNat/mul/small(rem, 2) < s => d
            | _ => d + 1
            end;
        [last]
    | false => [d, ..generate(rem, s, mp10, mm10, even)]
    end;

let digits_to_str(ds: List(Nat)) -> Str =
    List/fold(ds, "", (d, acc) => Str/concat(acc, Nat/to_str(d)));

let normalize(ds: List(Nat)) -> {List(Nat), Bool} =
    match ds
    | [] => ([], false)
    | [h, ..t] =>
        match List/len(t) == 0
        | true => match h == 10 | true => ([0], true) | false => ([h], false) end
        | false =>
            let (rest, carry) = normalize(t);
            choose
            | Bool/not(carry) => ([h, ..rest], false)
            | h == 9 => ([0, ..rest], true)
            | _ => ([h + 1, ..rest], false)
            end
        end
    end;

let setup(f_mant: Nat, exp_field: Nat) -> {BigNat, BigNat, BigNat, BigNat} =
    match exp_field >= 150
    | true =>
        let ep = exp_field - 150;
        match f_mant == 0x800000
        | true =>
            (
                BigNat/mul/pow2(BigNat/of_nat(f_mant), ep + 2),
                BigNat/of_nat(4),
                pow2(ep + 1),
                pow2(ep))
        | false =>
            (BigNat/mul/pow2(BigNat/of_nat(f_mant), ep + 1), BigNat/of_nat(2), pow2(ep), pow2(ep))
        end
    | false =>
        let abs_e = 150 - Nat/max(exp_field, 1);
        match exp_field < 2 || Bool/not(f_mant == 0x800000)
        | true =>
            (
                BigNat/mul/small(BigNat/of_nat(f_mant), 2),
                pow2(abs_e + 1),
                BigNat/of_nat(1),
                BigNat/of_nat(1))
        | false =>
            (
                BigNat/mul/small(BigNat/of_nat(f_mant), 4),
                pow2(abs_e + 2),
                BigNat/of_nat(2),
                BigNat/of_nat(1))
        end
    end;

-- Guarded on `k >= 0` rather than a refuted `k <= 0`, because `Int/to_nat`'s precondition is decided on that comparison and nothing relates the two when both are stuck. The zero exponent moves inside, where it was previously carried by the refuted arm: at `k = 0` the leading form is what it always was, `0.` over no padding.
let layout(digits_str: Str, k: Int) -> Str =
    let len = Str/len(digits_str);
    let leading = (pad: Nat) => Str/concat(Str/concat("0.", Str/repeat("0", pad)), digits_str);
    match k >= +0
    | false => leading(Int/abs(k))
    | true =>
        let kn = Int/to_nat(k);
        match kn == 0
        | true => leading(0)
        | false =>
            match kn < len
            | true =>
                Str/concat(
                    Str/concat(Str/slice(digits_str, 0, kn), "."),
                    Str/slice(digits_str, kn, len - kn))
            | false => Str/concat(digits_str, Str/repeat("0", kn - len))
            end
        end
    end;

let render(f_mant: Nat, exp_field: Nat, even: Bool) -> Str =
    let (r0, s0, mp0, mm0) = setup(f_mant, exp_field);
    let (s1, k1) = scale_up(r0 + mp0, s0, +0);
    let (r1, mp1, mm1, k2) = scale_down(r0, mp0, mm0, s1, k1);
    let digits = generate(r1, s1, mp1, mm1, even);
    let (norm, carry) = normalize(digits);
    match carry
    | true => layout(digits_to_str([1, ..norm]), k2 + 1)
    | false => layout(digits_to_str(norm), k2)
    end;

pub let cmp(x: Flt, y: Flt) -> Ordering =
    choose | x < y => Ordering/lt() | x == y => Ordering/eq() | _ => Ordering/gt() end;

pub let to_str(f: Flt) -> Str =
    let b = to_le_bytes(f);
    let b0 = Byte/to_nat(Option/unwrap_or(Bytes/try_get(b, 0), 0));
    let b1 = Byte/to_nat(Option/unwrap_or(Bytes/try_get(b, 1), 0));
    let b2 = Byte/to_nat(Option/unwrap_or(Bytes/try_get(b, 2), 0));
    let b3 = Byte/to_nat(Option/unwrap_or(Bytes/try_get(b, 3), 0));
    let exp_field = b3 % 0x80 * 2 + b2 / 0x80;
    let mant_field = b2 % 0x80 * 0x10000 + b1 * 0x100 + b0;
    let sign = match b3 >= 0x80 | true => "-" | false => "+" end;
    choose
    | exp_field == 0xFF && mant_field == 0 => Str/concat(sign, "inf")
    | exp_field == 0xFF => "NaN"
    | exp_field == 0 && mant_field == 0 => Str/concat(sign, "0")
    | _ =>
        let f_mant = match exp_field == 0 | true => mant_field | false => mant_field + 0x800000 end;
        let even = f_mant % 2 == 0;
        Str/concat(sign, render(f_mant, exp_field, even))
    end;

pub let pow10(n: Nat) -> Flt =
    match n | 0 => +1.0 | pred + 1; ih => ih * +10.0 end;

-- `of_str` is exact: the digits are read into a `BigNat` and `D · 10^E` is narrowed to the nearest binary32 once, ties to even, the way the printer above is exact in the other direction. It used to compute `to_flt(int) + to_flt(frac) / pow10(len) * pow10(exp)` — four roundings, `to_flt` already past nine digits, and `pow10(39)` is `inf`, which flushed every subnormal to zero — and failed `of_str(to_str(x)) == x` for about forty percent of finite values.
let pow10_big(n: Nat) -> BigNat =
    match n | 0 => BigNat/of_nat(1) | p + 1; ih => BigNat/mul/small(ih, 10) end;

-- The decimal digits of `s` as a number, or `none` on any other character. The empty string is zero, so an absent integer or fraction part reads as nothing rather than failing.
let digits_big(s: Str) -> Option(BigNat) =
    Str/fold(
        s,
        Option/some(BigNat/zero),
        (c, acc) =>
            let a = acc!;
            match Char/is_digit(c)
            | true => Option/some(BigNat/mul/small(a, 10) + BigNat/of_nat(Char/to_nat(c) - 0x30))
            | false => Option/none()
            end);

-- `2^e` as a float, exact over the whole binary32 range: a power of two is representable from `2^-149` to `2^127`, and each doubling or halving on the way to one is exact. Halving rather than dividing by `2^|e|` is what reaches the subnormal powers, whose reciprocals overflow.
let two_pow(e: Int) -> Flt =
    let mag = Int/abs(e);
    match e >= +0
    | true => match mag | 0 => +1.0 | k + 1; ih => ih * +2.0 end
    | false => match mag | 0 => +1.0 | k + 1; ih => ih * +0.5 end
    end;

-- `bits` quotient bits of `n / d`, most significant first, where `d` arrives scaled so that `d <= n < 2 · d`: each step keeps or drops the current power of `d`, halves it — exact, since every power down to the last is `d` times a power of two — and shifts the bit in. The remainder says whether anything was lost below the last bit.
let quotient(n: BigNat, d: BigNat, bits: Nat, acc: Nat) -> {Nat, BigNat} =
    match bits
    | 0 => (acc, n)
    | b + 1 =>
        match n >= d
        | true => quotient(n - d, BigNat/div2(d), b, acc * 2 + 1)
        | false => quotient(n, BigNat/div2(d), b, acc * 2)
        end
    end;

-- Drop `shift` low bits of `q`, rounding half to even; `sticky` is whether anything below `q` itself was nonzero, which breaks a tie the dropped bits alone would call exact. Shifts rather than division, since a divisor built from a runtime `shift` states no decidable bound.
let round_bits(q: Nat, shift: Nat, sticky: Bool) -> Nat =
    let kept = Nat/shr(q, shift);
    let dropped = q - Nat/shl(kept, shift);
    let half = Nat/shl(1, shift - 1);
    let up =
        choose
        | dropped > half => true
        | dropped < half => false
        | sticky => true
        | _ => Nat/rem(kept, 2) == 1
        end;
    match up | true => kept + 1 | false => kept end;

-- The binary32 nearest to `m · 2^e` given `m` as the 26 bits `q` of a quotient in `[2^25, 2^26)` and the sticky flag below them, with the value in `[2^s, 2^(s + 1))`. A normal result keeps 24 of the 26 bits; a subnormal one is rounded on the `2^-149` grid directly from the same 26 bits, so nothing is rounded twice; a carry out of the top bit renormalizes, and past the largest exponent the answer is infinity.
let assemble(q: Nat, sticky: Bool, s: Int) -> Flt =
    choose
    | s > +127 => pos_inf
    | s < -126 =>
        let shift = Int/abs(+0 - (s + +124));
        match shift >= 27
        | true => +0.0
        | false => Nat/to_flt(round_bits(q, shift, sticky)) * two_pow(-149)
        end
    | _ =>
        let mant = round_bits(q, 2, sticky);
        match mant == 0x1000000
        | true =>
            match s == +127 | true => pos_inf | false => Nat/to_flt(0x800000) * two_pow(s - +22) end
        | false => Nat/to_flt(mant) * two_pow(s - +23)
        end
    end;

-- The binary32 nearest to `D · 10^E`, correctly rounded, with the sign applied last so a zero keeps it. `digits` is how many decimal digits spelled `D`, leading zeros included, which bounds `D` above and so decides underflow before any power of ten is built; overflow is decided from `D`'s bit length, which bounds it below. Inside those two clamps the numerator and denominator are exact and the quotient's top 26 bits settle the rounding.
pub let of_decimal(negative: Bool, d: BigNat, e: Int, digits: Nat) -> Flt =
    let magnitude =
        choose
        | BigNat/is_zero(d) => +0.0
        | e >= +0 && (BigNat/bit_len(d) >= 129 || e >= +39) => pos_inf
        | e < +0 && Nat/to_int(digits) + e <= -46 => +0.0
        | _ =>
            let (n0, d0) =
                match e >= +0: (_) => {BigNat, BigNat}
                | true => (BigNat/mul(d, pow10_big(Int/abs(e))), BigNat/of_nat(1))
                | false => (d, pow10_big(Int/abs(e)))
                end;
            -- Scale so the quotient has 26 bits: `2^24 < n1 / d1 < 2^26` from the bit lengths alone, then one doubling where it fell short of `2^25`.
            let sh = Nat/to_int(25 + BigNat/bit_len(d0)) - Nat/to_int(BigNat/bit_len(n0));
            let (n1, d1) =
                match sh >= +0: (_) => {BigNat, BigNat}
                | true => (BigNat/mul/pow2(n0, Int/abs(sh)), d0)
                | false => (n0, BigNat/mul/pow2(d0, Int/abs(sh)))
                end;
            let top = BigNat/mul/pow2(d1, 25);
            let (n2, sh2) =
                match n1 < top: (_) => {BigNat, Int}
                | true => (BigNat/mul/pow2(n1, 1), sh + +1)
                | false => (n1, sh)
                end;
            let (q, rest) = quotient(n2, top, 26, 0);
            assemble(q, Bool/not(BigNat/is_zero(rest)), +25 - sh2)
        end;
    match negative | true => neg(magnitude) | false => magnitude end;

let exponent_of(s: Str, e_pos: Nat, len: Nat) -> Option(Int) =
    match e_pos < len
    | true => Int/of_str(Str/slice(s, e_pos + 1, len - (e_pos + 1)))
    | false => Option/some(+0)
    end;

pub let of_str(s: Str) -> Option(Flt) =
    match Str/is_empty(s)
    | true => Option/none()
    | false =>
        let first = Str/try_get(s, 0)!;
        let is_neg = first == '-';
        let start = choose | first == '+' => 1 | first == '-' => 1 | _ => 0 end;
        let len = Str/len(s);
        let dot_pos = Option/unwrap_or(Str/find(s, '.'), len);
        let e_pos =
            Nat/min(
                Option/unwrap_or(Str/find(s, 'e'), len),
                Option/unwrap_or(Str/find(s, 'E'), len));
        let int_end = Nat/min(dot_pos, e_pos);
        let int_slice = Str/slice(s, start, int_end - start);
        let frac_slice =
            match dot_pos < e_pos
            | true => Str/slice(s, dot_pos + 1, e_pos - (dot_pos + 1))
            | false => ""
            end;
        match Bool/not(Str/is_empty(int_slice)) || Bool/not(Str/is_empty(frac_slice))
        | true =>
            let spelled = Str/concat(int_slice, frac_slice);
            let digits = digits_big(spelled)!;
            let exponent = exponent_of(s, e_pos, len)!;
            let scale = exponent - Nat/to_int(Str/len(frac_slice));
            Option/some(of_decimal(is_neg, digits, scale, Str/len(spelled)))
        | false => Option/none()
        end
    end;

satisfy Equal(Flt) {
    eql = eql,
    neq = neq,
}

satisfy Compare(Flt) {
    lt = lt,
    le = le,
    gt = gt,
    ge = ge,
}

satisfy Add(Flt) {
    add = add,
}

satisfy Subtract(Flt) {
    sub = sub,
}

satisfy Multiply(Flt) {
    mul = mul,
}

-- IEEE division is total, so this carrier's domain is everything and the obligation costs nothing — the check that the concept can express "no precondition" without a carve-out.
satisfy Divide(Flt) {
    Ok(b) = True,
    div(a, b) = div(a, b),
}

satisfy Remainder(Flt) {
    Ok(b) = True,
    rem(a, b) = rem(a, b),
}

satisfy Show(Flt) {
    show = to_str,
}

-- `to_str` writes `+2.5`, `+0`, `+inf` and `NaN`, none of which are literals as written: the sign is stripped, a missing point gains `.0`, and the non-finite values take their `/std/Flt` names, which no literal denotes.
--
-- **The four cases are told apart by value, not by `to_str`'s text.** Matching the rendered `"NaN"`, `"+inf"` and `"-inf"` made this witness's one obligation -- that its text re-parses -- rest on three string constants agreeing with a rendering six lines above, which no type holds together and which a change as small as writing `nan` for TOML's spelling would break silently. `is_finite` is the same ordered pair it always was, and the sign then separates the two infinities: a NaN fails both comparisons, since every IEEE comparison with one is false, so it falls through with no `f == f` idiom.
satisfy Spell(Flt) {
    spell(f) =
        choose
        | Bool/not(is_finite(f)) =>
            choose
            | f > +0.0 => "/std/Flt/pos_inf"
            | f < +0.0 => "/std/Flt/neg_inf"
            | _ => "/std/Flt/nan"
            end
        -- Rendered only on the arm that reads it, now that no case is decided from the text.
        | _ =>
            let raw = to_str(f);
            let unsigned =
                match Str/try_get(raw, 0)
                | some(head) =>
                    match head == '+'
                    | true => Str/slice(raw, 1, Str/len(raw) - 1)
                    | false => raw
                    end
                | none() => raw
                end;
            let pointed = match Str/find(unsigned, '.') | some(_) => true | none() => false end;
            let exponented = match Str/find(unsigned, 'e') | some(_) => true | none() => false end;
            match pointed || exponented | true => unsigned | false => Str/concat(unsigned, ".0") end
        end,
}

satisfy Ordered(Flt) {
    cmp = cmp,
}
