pub use /sys/{Flt};
pub use /sys/Flt/{add, sub, mul, div, fma, rem, min, max, eql, neq, lt, gt, le, ge, neg, abs,
    sqrt, round, floor, ceil, trunc, nearest, copysign, to_nat, to_int, to_le_bytes, of_le_bytes};
pub use /sys/Flt/{Finite, NonNeg};

--- IEEE 754's rounding directions.
pub mod Rounding;
pub use Rounding/{let Rounding};

--- The operations that round, each in the direction its first argument names.
pub mod rounded;

--- The exact layer every rounding in this library goes through.
mod exact;
use /std/{Nat, Byte, Int, Str, Char, Bool, Option, Bytes, List, Ordering, Show, Spell, Ord};
use /std/ops/{Eql, Cmp, Add, Sub, Mul, Div, Rem};

--- That `b` is eight bytes long, decided.
pub let EightBytes(b: Bytes) -> Prop =
    Bool/Holds(Nat/eql(Bytes/len(b), 8));

--- Positive infinity.
pub let pos_inf: Flt =
    div(+1.0, +0.0);

--- Negative infinity.
pub let neg_inf: Flt =
    div(-1.0, +0.0);

--- The default NaN: positive, quiet and without a payload, which is what an invalid operation with no NaN operand answers.
pub let nan: Flt =
    of_le_bytes(x[0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0xF8, 0x7F]);

--- Whether `f` is a number: neither infinity nor a NaN.
pub let is_finite(f: Flt) -> Bool =
    f > neg_inf && f < pos_inf;

--- The float whose little-endian bytes these are, or `none` unless there are exactly eight.
pub let try_of_le_bytes(b: Bytes) -> Option(Flt) =
    match Nat/eql(Bytes/len(b), 8): (_) => Option(Flt)
    | true => Option/some(of_le_bytes(b, @Bool/True/qed()))
    | false => Option/none()
    end;

--- The procedure that decides `Finite(f)`: the evidence when `f` is a number, `none` otherwise.
pub let finite(f: Flt) -> Option(Finite(f)) =
    match neg_inf < f && f < pos_inf: (r) => Option(Bool/Holds(r))
    | true => Option/some(Bool/True/qed())
    | false => Option/none()
    end;

--- The procedure that decides `NonNeg(f)`: the evidence when `f` is a non-negative number, `none` otherwise. `-0.0` qualifies.
pub let non_neg(f: Flt) -> Option(NonNeg(f)) =
    match f >= +0.0 && f < pos_inf: (r) => Option(Bool/Holds(r))
    | true => Option/some(Bool/True/qed())
    | false => Option/none()
    end;

--- `f` truncated toward zero, or `none` unless it is a non-negative number.
pub let try_to_nat(f: Flt) -> Option(Nat) =
    match non_neg(f) | some(ok) => Option/some(to_nat(f, @ok)) | none() => Option/none() end;

--- `f` truncated toward zero, or `none` unless it is a number.
pub let try_to_int(f: Flt) -> Option(Int) =
    match finite(f) | some(ok) => Option/some(to_int(f, @ok)) | none() => Option/none() end;

let pow2(k: Nat) -> Nat =
    Nat/shl(1, k);

--- The quotient and remainder of `r` by `s`. Every caller's `s` is positive; a zero one answers `(0, r)` so the precondition `/` asks for is discharged by the match rather than carried in.
let div_mod(r: Nat, s: Nat) -> {Nat, Nat} =
    match s | 0 => (0, r) | sp + 1 => (r / (sp + 1), r % (sp + 1)) end;

--- How many decimal places the two scalings may move the exponent. A finite binary64 lies between `4.9 · 10⁻³²⁴` and `1.8 · 10³⁰⁸`, so neither moves it past 324 places: the count never runs out and changes no answer, and it is what lets `to_str` stand in a type.
let scaling_fuel: Nat = 330;

--- How many digits `generate` may write. Seventeen significant digits tell every binary64 apart, so the shortest spelling stops by then: the count never runs out and changes no answer.
let digit_fuel: Nat = 20;

let scale_up(fuel: Nat, rpm: Nat, s: Nat, k: Int) -> {Nat, Int} =
    match fuel
    | 0 => (s, k)
    | pred + 1 => match rpm > s | true => scale_up(pred, rpm, s * 10, k + 1) | false => (s, k) end
    end;

let scale_down(fuel: Nat, r: Nat, mp: Nat, mm: Nat, s: Nat, k: Int) -> {Nat, Nat, Nat, Int} =
    match fuel
    | 0 => (r, mp, mm, k)
    | pred + 1 =>
        match (r + mp) * 10 <= s
        | true => scale_down(pred, r * 10, mp * 10, mm * 10, s, k - 1)
        | false => (r, mp, mm, k)
        end
    end;

let generate(fuel: Nat, r: Nat, s: Nat, mp: Nat, mm: Nat, even: Bool) -> List(Nat) =
    match fuel
    | 0 => []
    | pred + 1 =>
        let r10 = r * 10;
        let mp10 = mp * 10;
        let mm10 = mm * 10;
        let (d, rem) = div_mod(r10, s);
        let low = match even | true => rem <= mm10 | false => rem < mm10 end;
        let high = match even | true => rem + mp10 >= s | false => rem + mp10 > s end;
        match low || high
        | true =>
            let last =
                choose
                | Bool/not(low) => d + 1
                | Bool/not(high) => d
                | rem * 2 < s => d
                | _ => d + 1
                end;
            [last]
        | false => [d, ..generate(pred, rem, s, mp10, mm10, even)]
        end
    end;

let digits_to_str(ds: List(Nat)) -> Str =
    List/fold(ds, "", (d, acc) => Str/concat(acc, Nat/to_str(d)));

let normalize(ds: List(Nat)) -> {List(Nat), Bool} =
    match ds
    | [] => ([], false)
    | [h, ..t] =>
        match List/len(t) == 0
        | true => match h == 10 | true => ([0], true) | false => ([h], false) end
        | false =>
            let (rest, carry) = normalize(t);
            choose
            | Bool/not(carry) => ([h, ..rest], false)
            | h == 9 => ([0, ..rest], true)
            | _ => ([h + 1, ..rest], false)
            end
        end
    end;

let setup(f_mant: Nat, exp_field: Nat) -> {Nat, Nat, Nat, Nat} =
    let hidden = pow2(52);
    match exp_field >= 1075
    | true =>
        let ep = exp_field - 1075;
        match f_mant == hidden
        | true => (Nat/shl(f_mant, ep + 2), 4, pow2(ep + 1), pow2(ep))
        | false => (Nat/shl(f_mant, ep + 1), 2, pow2(ep), pow2(ep))
        end
    | false =>
        let abs_e = 1075 - Nat/max(exp_field, 1);
        match exp_field < 2 || Bool/not(f_mant == hidden)
        | true => (f_mant * 2, pow2(abs_e + 1), 1, 1)
        | false => (f_mant * 4, pow2(abs_e + 2), 2, 1)
        end
    end;

let layout(digits_str: Str, k: Int) -> Str =
    let len = Str/len(digits_str);
    let leading = (pad: Nat) => Str/concat(Str/concat("0.", Str/repeat("0", pad)), digits_str);
    match k >= +0
    | false => leading(Int/abs(k))
    | true =>
        let kn = Int/to_nat(k);
        match kn == 0
        | true => leading(0)
        | false =>
            match kn < len
            | true =>
                Str/concat(
                    Str/concat(Str/slice(digits_str, 0, kn), "."),
                    Str/slice(digits_str, kn, len - kn))
            | false => Str/concat(digits_str, Str/repeat("0", kn - len))
            end
        end
    end;

let render(f_mant: Nat, exp_field: Nat, even: Bool) -> Str =
    let (r0, s0, mp0, mm0) = setup(f_mant, exp_field);
    let (s1, k1) = scale_up(scaling_fuel, r0 + mp0, s0, +0);
    let (r1, mp1, mm1, k2) = scale_down(scaling_fuel, r0, mp0, mm0, s1, k1);
    let digits = generate(digit_fuel, r1, s1, mp1, mm1, even);
    let (norm, carry) = normalize(digits);
    match carry
    | true => layout(digits_to_str([1, ..norm]), k2 + 1)
    | false => layout(digits_to_str(norm), k2)
    end;

--- The two in IEEE 754's total order, which tells every `Flt` apart: the negative NaNs, then `-inf` up through `-0`, then `+0` up through `+inf`, then the positive NaNs. NaNs order by their bits outward from the infinity of their sign, so a signaling NaN sits nearer it than a quiet one, as §5.10 orders them.
---
--- `==` and `<` stay IEEE's comparisons, which call the two zeros equal and leave a NaN unordered. This is the order `Ord`, and so `List/sort`, needs, and the identity `Hash` already reads. It is also how this library spells IEEE's `totalOrder(x, y)`, as `ord(x, y) != gt`, and `totalOrderMag(x, y)`, as `ord(abs(x), abs(y)) != gt`.
pub let ord(x: Flt, y: Flt) -> Ordering =
    choose
    | x < y => Ordering/lt()
    | y < x => Ordering/gt()
    | _ => Nat/ord(total_key(x), total_key(y))
    end;

--- `f`'s bits as the natural whose order is the total one: a negative pattern complemented below `2⁶³`, a positive one lifted above it. Only equal numbers and NaNs reach it, since a comparison decides every other pair.
let total_key(f: Flt) -> Nat =
    let bits = Bytes/to_nat(to_le_bytes(f));
    let top = pow2(63);
    match bits >= top | true => pow2(64) - 1 - bits | false => bits + top end;

--- The shortest decimal that reads back as `f`, always signed: `+2.5`, `-0`, `+inf`, `-inf` or `NaN`.
pub let to_str(f: Flt) -> Str =
    let b = to_le_bytes(f);
    let at = (i: Nat) => Byte/to_nat(Option/unwrap_or(Bytes/try_get(b, i), 0));
    let b6 = at(6);
    let b7 = at(7);
    let exp_field = b7 % 0x80 * 16 + b6 / 0x10;
    let place = (acc: Nat, v: Nat) => Nat/shl(acc, 8) + v;
    let mant_field =
        place(
            place(place(place(place(place(b6 % 0x10, at(5)), at(4)), at(3)), at(2)), at(1)),
            at(0));
    let sign = match b7 >= 0x80 | true => "-" | false => "+" end;
    choose
    | exp_field == 0x7FF && mant_field == 0 => Str/concat(sign, "inf")
    | exp_field == 0x7FF => "NaN"
    | exp_field == 0 && mant_field == 0 => Str/concat(sign, "0")
    | _ =>
        let f_mant = match exp_field == 0 | true => mant_field | false => mant_field + pow2(52) end;
        let even = Nat/is_even(f_mant);
        Str/concat(sign, render(f_mant, exp_field, even))
    end;

--- Ten to the power `n`, as a float.
pub let pow10(n: Nat) -> Flt =
    match n | 0 => +1.0 | _ + 1; ih => ih * +10.0 end;

--- The number a run of decimal digits spells, `0` for an empty one, `none` if anything else is in it.
let decimal_value(s: Str) -> Option(Nat) =
    Str/fold(
        s,
        Option/some(0),
        (c, acc) =>
            let a = acc!;
            match Char/is_digit(c)
            | true => Option/some(a * 10 + (Char/to_nat(c) - 0x30))
            | false => Option/none()
            end);

--- The float nearest to `d` times ten to the `e`, correctly rounded with ties to even, negated when `negative`. `digits` is how many decimal digits spelled `d`, leading zeros included.
pub let of_decimal(negative: Bool, d: Nat, e: Int, digits: Nat) -> Flt =
    let magnitude =
        choose
        | d == 0 => +0.0
        | e >= +0 && (exact/bit_len(d) >= 1025 || e >= +309) => pos_inf
        | e < +0 && Nat/to_int(digits) + e <= -324 => +0.0
        | _ =>
            let (n0, d0) =
                match e >= +0: (_) => {Nat, Nat}
                | true => (d * Nat/pow(10, Int/abs(e)), 1)
                | false => (d, Nat/pow(10, Int/abs(e)))
                end;
            let sh = Nat/to_int(54 + exact/bit_len(d0)) - Nat/to_int(exact/bit_len(n0));
            let (n1, d1) =
                match sh >= +0: (_) => {Nat, Nat}
                | true => (Nat/shl(n0, Int/abs(sh)), d0)
                | false => (n0, Nat/shl(d0, Int/abs(sh)))
                end;
            let top = Nat/shl(d1, 54);
            let (n2, sh2) =
                match n1 < top: (_) => {Nat, Int}
                | true => (Nat/shl(n1, 1), sh + +1)
                | false => (n1, sh)
                end;
            -- `n2` lies in `[top, 2 · top)`, so its quotient by `d1` has exactly 55 bits, `q · 2^-sh2` with the remainder the sticky part: the exact layer rounds it once.
            let (q, rest) = div_mod(n2, d1);
            exact/round(Rounding/ties_to_even(), false, q, +0 - sh2, rest != 0)
        end;
    match negative | true => neg(magnitude) | false => magnitude end;

let exponent_of(s: Str, e_pos: Nat, len: Nat) -> Option(Int) =
    match e_pos < len
    | true => Int/of_str(Str/slice(s, e_pos + 1, len - (e_pos + 1)))
    | false => Option/some(+0)
    end;

--- The float a decimal spells: an optional sign, digits with an optional point, and an optional `e` exponent, correctly rounded. An optional sign before `inf`, `infinity` or `nan`, in any case, reads as the infinity of that sign or the default NaN, which is what `to_str` writes for them and what IEEE 754 §5.12.1 requires a reader to accept. `none` for any other text.
pub let of_str(s: Str) -> Option(Flt) =
    match Str/is_empty(s)
    | true => Option/none()
    | false =>
        let first = Str/try_get(s, 0)!;
        let is_neg = first == '-';
        let start = choose | first == '+' => 1 | first == '-' => 1 | _ => 0 end;
        let len = Str/len(s);
        let body = Str/slice(s, start, len - start);
        choose
        | Str/eql_ascii_ci(body, "inf") || Str/eql_ascii_ci(body, "infinity") =>
            Option/some(match is_neg | true => neg_inf | false => pos_inf end)
        | Str/eql_ascii_ci(body, "nan") => Option/some(nan)
        | _ => of_decimal_str(s, is_neg, start, len)
        end
    end;

--- The finite half of `of_str`: `s` read as a decimal whose digits begin at `start`.
let of_decimal_str(s: Str, is_neg: Bool, start: Nat, len: Nat) -> Option(Flt) =
    let dot_pos = Option/unwrap_or(Str/index_of(s, '.'), len);
    let e_pos =
        Nat/min(
            Option/unwrap_or(Str/index_of(s, 'e'), len),
            Option/unwrap_or(Str/index_of(s, 'E'), len));
    let int_end = Nat/min(dot_pos, e_pos);
    let int_slice = Str/slice(s, start, int_end - start);
    let frac_slice =
        match dot_pos < e_pos
        | true => Str/slice(s, dot_pos + 1, e_pos - (dot_pos + 1))
        | false => ""
        end;
    match Bool/not(Str/is_empty(int_slice)) || Bool/not(Str/is_empty(frac_slice))
    | true =>
        let spelled = Str/concat(int_slice, frac_slice);
        let digits = decimal_value(spelled)!;
        let exponent = exponent_of(s, e_pos, len)!;
        let scale = exponent - Nat/to_int(Str/len(frac_slice));
        Option/some(of_decimal(is_neg, digits, scale, Str/len(spelled)))
    | false => Option/none()
    end;

satisfy Eql(Flt) {
    eql = eql,
    neq = neq,
}

satisfy Cmp(Flt) {
    lt = lt,
    le = le,
    gt = gt,
    ge = ge,
}

satisfy Add(Flt) {
    add = add,
}

satisfy Sub(Flt) {
    sub = sub,
}

satisfy Mul(Flt) {
    mul = mul,
}

--- No precondition: IEEE division is total.
satisfy Div(Flt) {
    Ok(_) = Bool/True,
    div(a, b) = div(a, b),
}

--- No precondition: IEEE remainder is total.
satisfy Rem(Flt) {
    Ok(_) = Bool/True,
    rem(a, b) = rem(a, b),
}

satisfy Show(Flt) {
    show = to_str,
}

--- A finite value spells as a literal, the sign dropped and a point added where `to_str` wrote none; the non-finite values spell as their names here.
satisfy Spell(Flt) {
    spell(f) =
        choose
        | Bool/not(is_finite(f)) =>
            choose
            | f > +0.0 => "/std/Flt/pos_inf"
            | f < +0.0 => "/std/Flt/neg_inf"
            | _ => "/std/Flt/nan"
            end
        | _ =>
            let raw = to_str(f);
            let unsigned =
                match Str/try_get(raw, 0)
                | some(head) =>
                    match head == '+'
                    | true => Str/slice(raw, 1, Str/len(raw) - 1)
                    | false => raw
                    end
                | none() => raw
                end;
            let pointed = match Str/index_of(unsigned, '.') | some(_) => true | none() => false end;
            let exponented =
                match Str/index_of(unsigned, 'e') | some(_) => true | none() => false end;
            match pointed || exponented | true => unsigned | false => Str/concat(unsigned, ".0") end
        end,
}

satisfy Ord(Flt) {
    ord = ord,
}
