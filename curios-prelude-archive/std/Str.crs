use /std/{Char, Nat, Byte, Bytes, Bool, List, Option, Eq, Show, Spell, Ordering, Ord};
use /std/ops/{Eql, Cmp};

--- What a byte begins, as UTF-8 reads it.
pub induct Class: pub Type
--- A character of one byte.
| ascii()
--- The first of a character whose remaining `count` bytes must each lie between `lo` and `hi`.
| lead(count: Nat, lo: Nat, hi: Nat, payload: Nat)
--- A byte no character may begin with.
| bad()
end

--- What `c` begins.
pub let classify(c: Byte) -> Class =
    let n = Byte/to_nat(c);
    choose
    | Nat/in_range(n, 0x0, 0x7F) => Class/ascii()
    | Nat/in_range(n, 0xC2, 0xDF) => Class/lead(1, 0x80, 0xBF, n - 0xC0)
    | Nat/in_range(n, 0xE0, 0xEF) =>
        let lo = choose | n == 0xE0 => 0xA0 | _ => 0x80 end;
        let hi = choose | n == 0xED => 0x9F | _ => 0xBF end;
        Class/lead(2, lo, hi, n - 0xE0)
    | Nat/in_range(n, 0xF0, 0xF4) =>
        let lo = choose | n == 0xF0 => 0x90 | _ => 0x80 end;
        let hi = choose | n == 0xF4 => 0x8F | _ => 0xBF end;
        Class/lead(3, lo, hi, n - 0xF0)
    | _ => Class/bad()
    end;

--- Whether `c` continues a character: a byte in `0x80..=0xBF`, which no character begins with.
pub let continues(c: Byte) -> Bool =
    Nat/in_range(Byte/to_nat(c), 0x80, 0xBF);

--- That a class asks its continuation bytes for a range inside `0x80..=0xBF`.
let class_continues(k: Class) -> Bool =
    match k | ascii() => true | lead(_, lo, hi, _) => 0x80 <= lo && hi <= 0xBF | bad() => true end;

--- Every lead `classify` reports asks its continuation bytes for a range inside `0x80..=0xBF`. Walked by `classify`'s own guards, each of which fixes the range it reports.
let classify_continues(c: Byte) -> Bool/Holds(class_continues(classify(c))) =
    let n = Byte/to_nat(c);
    match Nat/in_range(n, 0x0, 0x7F)
    | true => Bool/True/qed()
    | false =>
        match Nat/in_range(n, 0xC2, 0xDF)
        | true => Bool/True/qed()
        | false =>
            match Nat/in_range(n, 0xE0, 0xEF)
            | true =>
                match n == 0xE0
                | true => match n == 0xED | true => Bool/True/qed() | false => Bool/True/qed() end
                | false => match n == 0xED | true => Bool/True/qed() | false => Bool/True/qed() end
                end
            | false =>
                match Nat/in_range(n, 0xF0, 0xF4)
                | true =>
                    match n == 0xF0
                    | true =>
                        match n == 0xF4 | true => Bool/True/qed() | false => Bool/True/qed() end
                    | false =>
                        match n == 0xF4 | true => Bool/True/qed() | false => Bool/True/qed() end
                    end
                | false => Bool/True/qed()
                end
            end
        end
    end;

--- How far through a character a walk over bytes has come.
pub induct Scan: pub Type
--- Between characters, where a new one may begin.
| lead()
--- Inside a character, with `remaining` bytes still owed, each between `lo` and `hi`.
| cont(remaining: Nat, lo: Nat, hi: Nat)
--- Past a byte the encoding does not admit, which nothing recovers from.
| bad()
end

--- The state reading `c` leaves the scan in.
pub let step(c: Byte, s: Scan) -> Scan =
    let n = Byte/to_nat(c);
    match s
    | bad() => Scan/bad()
    | cont(rem, lo, hi) =>
        choose
        | Bool/not(Nat/in_range(n, lo, hi)) => Scan/bad()
        | rem == 1 => Scan/lead()
        | _ => Scan/cont(rem - 1, 0x80, 0xBF)
        end
    | lead() =>
        match classify(c)
        | ascii() => Scan/lead()
        | lead(cont, lo, hi, _) => Scan/cont(cont, lo, hi)
        | bad() => Scan/bad()
        end
    end;

--- A scan between characters that meets a byte continuing one goes bad: `classify` reports no lead for it, each of its guards refuted by the byte's range.
let step_of_continuing(
    c: Byte,
    q: Bool/Holds(continues(c)),
) -> Eq(step(c, Scan/lead()), Scan/bad()) =
    let n = Byte/to_nat(c);
    let range = Nat/Le/of_in_range(n, 0x80, 0xBF, q);
    match Nat/in_range(n, 0x0, 0x7F)
    | true =>
        match Nat/Le/trans(range.low, Nat/Le/of_in_range(n, 0x0, 0x7F, Bool/True/qed()).high) end
    | false =>
        match Nat/in_range(n, 0xC2, 0xDF)
        | true =>
            match Nat/Le/trans(Nat/Le/of_in_range(n, 0xC2, 0xDF, Bool/True/qed()).low, range.high)
            end
        | false =>
            match Nat/in_range(n, 0xE0, 0xEF)
            | true =>
                match Nat/Le/trans(
                    Nat/Le/of_in_range(n, 0xE0, 0xEF, Bool/True/qed()).low,
                    range.high)
                end
            | false =>
                match Nat/in_range(n, 0xF0, 0xF4)
                | true =>
                    match Nat/Le/trans(
                        Nat/Le/of_in_range(n, 0xF0, 0xF4, Bool/True/qed()).low,
                        range.high)
                    end
                | false => Eq/refl()
                end
            end
        end
    end;

--- The state reading all of `b` leaves the scan in.
pub let scan_from(s: Scan, b: Bytes) -> Scan =
    match b | x[] => s | x[h, ..t] => scan_from(step(h, s), t) end;

--- That bytes are well-formed UTF-8, which is what `Str` carries: what that rests on, from any scan state, and what the operations carry it through.
pub mod Valid;
pub use Valid/{let Valid};

--- A position in text: a byte offset at which a character may begin, typed by the text it belongs to. Deciding one reads a single byte; that such an offset is where valid text divides into valid text is `Valid/before` and `Valid/after`.
pub mod At;
pub use At/{let At};

--- How many bytes the first `n` characters take from scan state `s`.
pub let drop_width(n: Nat, s: Scan, b: Bytes) -> Nat =
    match b
    | x[] => 0
    | x[h, ..t] =>
        match s
        | lead() => match n | 0 => 0 | pred + 1 => 1 + drop_width(pred, step(h, Scan/lead()), t) end
        | cont(_, _, _) => 1 + drop_width(n, step(h, s), t)
        | bad() => 1 + drop_width(n, step(h, Scan/bad()), t)
        end
    end;

--- `drop_width` never passes the end.
pub let drop_width_within(n: Nat, s: Scan, b: Bytes) -> Nat/Le(drop_width(n, s, b), Bytes/len(b)) =
    match b
    | x[] => Bool/True/qed()
    | x[h, ..t] =>
        match s
        | lead() =>
            match n
            | 0 => Bool/True/qed()
            | pred + 1 => drop_width_within(pred, step(h, Scan/lead()), t)
            end
        | cont(_, _, _) => drop_width_within(n, step(h, s), t)
        | bad() => drop_width_within(n, step(h, Scan/bad()), t)
        end
    end;

--- How many characters `b` holds from scan state `s`.
pub let count_scalars(s: Scan, b: Bytes) -> Nat =
    match b
    | x[] => 0
    | x[h, ..t] =>
        match s
        | lead() => count_scalars(step(h, Scan/lead()), t) + 1
        | cont(_, _, _) => count_scalars(step(h, s), t)
        | bad() => count_scalars(step(h, Scan/bad()), t)
        end
    end;

--- Whether every code from `min` to `max` is a scalar value: the range lies below the surrogates, or past them and at most `U+10FFFF`. One contiguous range, so these two cases are the whole of it.
let scalars(min: Nat, max: Nat) -> Bool =
    max < 0xD800 || min >= 0xE000 && max <= 0x10FFFF;

--- Whether a character in flight can only end at a scalar value: `rem` continuation bytes still owed, the next between `lo` and `hi` and any after it between `0x80` and `0xBF`, over the bits `partial` has gathered so far.
---
--- The range is stated per remaining count at literal weights — each continuation byte shifts what came before by six bits — because `Nat/pow` recurses, and a type may not mention a recursion. No count past three begins a character, so those are refused along with zero.
let pending(rem: Nat, lo: Nat, hi: Nat, partial: Nat) -> Bool =
    match rem
    | 0 => false
    | r0 + 1 =>
        match r0
        | 0 => scalars(partial * 0x40 + (lo - 0x80), partial * 0x40 + (hi - 0x80))
        | r1 + 1 =>
            match r1
            | 0 =>
                scalars(
                    (partial * 0x40 + (lo - 0x80)) * 0x40,
                    (partial * 0x40 + (hi - 0x80)) * 0x40 + 0x3F)
            | r2 + 1 =>
                match r2
                | 0 =>
                    scalars(
                        (partial * 0x40 + (lo - 0x80)) * 0x40 * 0x40,
                        ((partial * 0x40 + (hi - 0x80)) * 0x40 + 0x3F) * 0x40 + 0x3F)
                | _ + 1 => false
                end
            end
        end
    end;

--- A range of scalar values narrowed stays one.
let scalars_within(
    min: Nat,
    max: Nat,
    min2: Nat,
    max2: Nat,
    s: Bool/Holds(scalars(min, max)),
    low: Nat/Le(min, min2),
    high: Nat/Le(max2, max),
) -> Bool/Holds(scalars(min2, max2)) =
    match max < 0xD800
    | true =>
        match max2 < 0xD800
        | true => Bool/True/qed()
        | false => match Nat/Lt/lt_of_le_lt(max2, max, 0xD800, high, Bool/True/qed()) end
        end
    | false =>
        match min >= 0xE000
        | false => match s end
        | true =>
            match max <= 0x10FFFF
            | false => match s end
            | true =>
                match max2 < 0xD800
                | true => Bool/True/qed()
                | false =>
                    match min2 >= 0xE000
                    | false => match Nat/Le/trans(@0xE000, @min, @min2, Bool/True/qed(), low) end
                    | true =>
                        match max2 <= 0x10FFFF
                        | true => Bool/True/qed()
                        | false =>
                            match Nat/Le/trans(@max2, @max, @0x10FFFF, high, Bool/True/qed()) end
                        end
                    end
                end
            end
        end
    end;

--- The last byte of a character, read in range, ends it at a scalar value.
let concluded(
    lo: Nat,
    hi: Nat,
    partial: Nat,
    c: Nat,
    p: Bool/Holds(pending(1, lo, hi, partial)),
    inside: Bool/Holds(Nat/in_range(c, lo, hi)),
) -> Char/Valid(partial * 0x40 + (c - 0x80)) =
    scalars_within(
        partial * 0x40 + (lo - 0x80),
        partial * 0x40 + (hi - 0x80),
        partial * 0x40 + (c - 0x80),
        partial * 0x40 + (c - 0x80),
        p,
        Nat/Le/add_mono_l(
            partial * 0x40,
            Nat/Le/sub_mono_r(0x80, Nat/Le/of_in_range(c, lo, hi, inside).low)),
        Nat/Le/add_mono_l(
            partial * 0x40,
            Nat/Le/sub_mono_r(0x80, Nat/Le/of_in_range(c, lo, hi, inside).high)));

--- A byte read in range, with more still owed, leaves a character that can still only end at a scalar value: its range narrows to the one below that byte.
let advanced(
    rem: Nat,
    lo: Nat,
    hi: Nat,
    partial: Nat,
    c: Nat,
    p: Bool/Holds(pending(rem, lo, hi, partial)),
    inside: Bool/Holds(Nat/in_range(c, lo, hi)),
    more: Bool/Holds(Bool/not(rem == 1)),
) -> Bool/Holds(pending(rem - 1, 0x80, 0xBF, partial * 0x40 + (c - 0x80))) =
    let low =
        Nat/Le/add_mono_l(
            partial * 0x40,
            Nat/Le/sub_mono_r(0x80, Nat/Le/of_in_range(c, lo, hi, inside).low));
    let high =
        Nat/Le/add_mono_l(
            partial * 0x40,
            Nat/Le/sub_mono_r(0x80, Nat/Le/of_in_range(c, lo, hi, inside).high));
    match rem
    | 0 => match p end
    | r1 + 1 =>
        match r1
        | 0 => match more end
        | r2 + 1 =>
            match r2
            | 0 =>
                scalars_within(
                    (partial * 0x40 + (lo - 0x80)) * 0x40,
                    (partial * 0x40 + (hi - 0x80)) * 0x40 + 0x3F,
                    (partial * 0x40 + (c - 0x80)) * 0x40,
                    (partial * 0x40 + (c - 0x80)) * 0x40 + 0x3F,
                    p,
                    Nat/Le/mul_mono_r(0x40, low),
                    Nat/Le/mul_mono_r(0x40, high))
            | r3 + 1 =>
                match r3
                | 0 =>
                    scalars_within(
                        (partial * 0x40 + (lo - 0x80)) * 0x40 * 0x40,
                        ((partial * 0x40 + (hi - 0x80)) * 0x40 + 0x3F) * 0x40 + 0x3F,
                        (partial * 0x40 + (c - 0x80)) * 0x40 * 0x40,
                        ((partial * 0x40 + (c - 0x80)) * 0x40 + 0x3F) * 0x40 + 0x3F,
                        p,
                        Nat/Le/mul_mono_r(0x40, Nat/Le/mul_mono_r(0x40, low)),
                        Nat/Le/mul_mono_r(0x40, Nat/Le/mul_mono_r(0x40, high)))
                | _ + 1 => match p end
                end
            end
        end
    end;

--- Whether the character `c` begins can only end at a scalar value: what `classify`'s ranges promise of a lead byte, and nothing to promise of any other.
let begins_scalars(c: Byte) -> Bool =
    match classify(c) | lead(rem, lo, hi, partial) => pending(rem, lo, hi, partial) | _ => true end;

--- Whether every byte below `k` begins only scalar values.
let each_below(k: Nat) -> Bool =
    match k | 0 => true | kp + 1 => begins_scalars(Nat/to_byte(kp % 256)) && each_below(kp) end;

--- `classify`'s promise, decided once over every byte rather than proved family by family: the check is a structural recursion the build runs, so a change to `classify`'s ranges that broke it would stop the build rather than wait for a proof to be revisited.
let every_byte: Bool/Holds(each_below(256)) =
    Bool/True/qed();

--- A byte below `m`, read out of the check over every byte below `m`.
let begins_below(
    m: Nat,
    n: Nat,
    all: Bool/Holds(each_below(m)),
    inside: Nat/Lt(n, m),
) -> Bool/Holds(begins_scalars(Nat/to_byte(n % 256))) =
    match m
    | 0 => match inside end
    | mp + 1 =>
        match begins_scalars(Nat/to_byte(mp % 256))
        | false => match all end
        | true =>
            match n < mp
            | true => begins_below(mp, n, all, Bool/True/qed())
            | false =>
                Eq/subst(
                    (k: Nat) => Bool/Holds(begins_scalars(Nat/to_byte(k % 256))),
                    Nat/Le/antisym(
                        mp,
                        n,
                        Nat/Lt/le_of_not_lt(n, mp, Bool/True/qed()),
                        Nat/Lt/le_succ_of_lt(n, mp + 1, inside)),
                    Bool/True/qed())
            end
        end
    end;

--- Every byte begins only scalar values.
let begins_scalars_of(c: Byte) -> Bool/Holds(begins_scalars(c)) =
    begins_below(256, Byte/to_nat(c), every_byte, Bool/True/qed());

--- Text: bytes certified as UTF-8.
pub struct Str: pub Type {
    --- The bytes themselves.
    bytes: Bytes,
    --- Why they are well-formed UTF-8.
    valid: Valid(bytes),
}

--- The UTF-8 bytes.
pub let to_bytes(s: Str) -> Bytes =
    s.bytes;

--- The text the bytes encode, or `none` unless they are UTF-8.
pub let of_bytes(b: Bytes) -> Option(Str) =
    match Valid/try(Scan/lead(), b)
    | some(v) => Option/some(Str { bytes = b, valid = v })
    | none() => Option/none()
    end;

--- The one-character string.
pub let of_char(c: Char) -> Str =
    Str { bytes = Char/to_utf8(c), valid = Valid/encoded(c) };

--- Eql bytes are equal strings.
pub let eq_of_bytes(a: Str, b: Str, p: Eq(a.bytes, b.bytes)) -> Eq(a, b) =
    Eq/subst(
        (bytes: Bytes) => (valid: Valid(bytes)) -> Eq(a, Str { bytes = bytes, valid = valid }),
        p,
        (_: Valid(a.bytes)) => Eq/refl())(b.valid);

--- `a` then `b`.
pub let concat(a: Str, b: Str) -> Str =
    Str { bytes = x[..a.bytes, ..b.bytes], valid = Valid/concat(a.valid, b.valid) };

--- The text before `at`, cut in O(1).
pub let before(s: Str, at: At(s)) -> Str =
    Str {
        bytes = Bytes/slice(s.bytes, 0, at.offset, @at.within),
        valid = Valid/before(s.valid, at.offset, at.within, at.boundary),
    };

--- The text from `at` on, cut in O(1).
pub let after(s: Str, at: At(s)) -> Str =
    Str {
        bytes = Bytes/drop(s.bytes, at.offset, @at.within),
        valid = Valid/after(s.valid, at.offset, at.within, at.boundary),
    };

let drop_n(n: Nat, s: Str) -> Str =
    Str {
        bytes =
            Bytes/drop(
                s.bytes,
                drop_width(n, Scan/lead(), s.bytes),
                @drop_width_within(n, Scan/lead(), s.bytes)),
        valid = Valid/drop(n, Scan/lead(), s.valid),
    };

let take_n(n: Nat, s: Str) -> Str =
    Str {
        bytes =
            Bytes/slice(
                s.bytes,
                0,
                drop_width(n, Scan/lead(), s.bytes),
                @drop_width_within(n, Scan/lead(), s.bytes)),
        valid = Valid/take(n, Scan/lead(), s.valid),
    };

--- The `n` characters from `x`, stopping at either end, so a window past the end is what is there.
pub let slice(s: Str, x: Nat, n: Nat) -> Str =
    take_n(n, drop_n(x, s));

--- The concatenation, in order.
pub let flatten(parts: List(Str)) -> Str =
    List/fold(parts, "", (p, acc) => concat(acc, p));

--- Whether the two are equal.
pub let eql(a: Str, b: Str) -> Bool =
    Bytes/eql(to_bytes(a), to_bytes(b));

let lower_ascii_byte(byte: Byte) -> Byte =
    let n = Byte/to_nat(byte);
    match Nat/in_range(n, 0x41, 0x5A) | true => Nat/to_byte((n + 0x20) % 0x80) | false => byte end;

let lower_ascii_bytes(b: Bytes) -> Bytes =
    Bytes/fold(b, x[], (byte, acc) => x[..acc, lower_ascii_byte(byte)]);

--- Equality with ASCII letters compared regardless of case; every other character exactly.
pub let eql_ascii_ci(a: Str, b: Str) -> Bool =
    Bytes/eql(lower_ascii_bytes(to_bytes(a)), lower_ascii_bytes(to_bytes(b)));

--- `s` written `n` times.
pub let repeat(s: Str, n: Nat) -> Str =
    List/balanced(n, "", (_) => s, (l, r) => concat(l, r));

--- Whether a scan state can only finish its character at a scalar value, `partial` being the bits gathered so far: `pending` inside a character, and nothing owed between them.
let pending_at(sc: Scan, partial: Nat) -> Bool =
    match sc | cont(rem, lo, hi) => pending(rem, lo, hi, partial) | _ => true end;

--- Left to right over the characters with `f(char, acc)`.
---
--- The walk carries the string's validity from the state it has reached and, beside the bits of the character in flight, the proof that it can only end at a scalar value. So every character it hands `f` is built with its proof, and a byte the encoding does not admit is a contradiction rather than an arm. Both proofs erase, and the accumulator is what it was.
pub let fold(@A: Type, s: Str, init: A, f: (Char, A) -> A) -> A =
    let go(
        sc: Scan,
        b: Bytes,
        v: Valid/from(sc, b),
        acc: {A, Nat},
        p: Bool/Holds(pending_at(sc, acc.1)),
    ) -> {A, Nat} =
        match b
        | x[] => acc
        | x[h, ..t] =>
            match sc
            | lead() =>
                match classify(h)
                | ascii() =>
                    go(
                        Scan/lead(),
                        t,
                        v,
                        (f(Char { code = Byte/to_nat(h), valid = Bool/True/qed() }, acc.0), 0),
                        Bool/True/qed())
                | lead(rem, lo, hi, partial) =>
                    go(Scan/cont(rem, lo, hi), t, v, (acc.0, partial), begins_scalars_of(h))
                | bad() => match Valid/from_bad(@t, v) end
                end
            | cont(rem, lo, hi) =>
                let partial = acc.1 * 0x40 + (Byte/to_nat(h) - 0x80);
                match Nat/in_range(Byte/to_nat(h), lo, hi)
                | false => match Valid/from_bad(@t, v) end
                | true =>
                    match rem == 1
                    | true =>
                        let last =
                            Eq/subst(
                                (r: Nat) => Bool/Holds(pending(r, lo, hi, acc.1)),
                                Nat/eq_of_eql(rem, 1, Bool/True/qed()),
                                p);
                        go(
                            Scan/lead(),
                            t,
                            v,
                            (
                                f(
                                    Char {
                                        code = partial,
                                        valid =
                                            concluded(
                                                lo,
                                                hi,
                                                acc.1,
                                                Byte/to_nat(h),
                                                last,
                                                Bool/True/qed()),
                                    },
                                    acc.0),
                                0),
                            Bool/True/qed())
                    | false =>
                        go(
                            Scan/cont(rem - 1, 0x80, 0xBF),
                            t,
                            v,
                            (acc.0, partial),
                            advanced(
                                rem,
                                lo,
                                hi,
                                acc.1,
                                Byte/to_nat(h),
                                p,
                                Bool/True/qed(),
                                Bool/True/qed()))
                    end
                end
            | bad() => match Valid/from_bad(@x[h, ..t], v) end
            end
        end;
    go(Scan/lead(), s.bytes, s.valid, (init, 0), Bool/True/qed()).0;

--- The characters.
pub let to_list(s: Str) -> List(Char) =
    fold(s, [], (c, acc) => [..acc, c]);

--- How many characters, not bytes.
pub let len(s: Str) -> Nat =
    count_scalars(Scan/lead(), s.bytes);

--- The characters of a concatenation are those of its halves. Not a law of the bytes: it holds because a valid string reads the scan back to `lead` at its end, which is what `Valid` says and what the count restarts on.
pub let len_concat(a: Str, b: Str) -> Eq(len(concat(a, b)), len(a) + len(b)) =
    count_concat(a.bytes, b.bytes, a.valid);

--- `count_scalars` splits at the seam of a concatenation whose first half reads to the end, from whatever state the reading starts in — the strengthening `len_concat` needs to descend a byte, where the state has moved.
let count_concat(
    a: Bytes,
    b: Bytes,
    @s: Scan,
    w: Valid/from(s, a),
) -> Eq(count_scalars(s, x[..a, ..b]), count_scalars(s, a) + count_scalars(Scan/lead(), b)) =
    match a
    | x[] =>
        match s
        | lead() => Eq/refl()
        | cont(_, _, _) => match w end
        | bad() => match w end
        end
    | x[h, ..t] =>
        match s
        | lead() => Eq/cong((n: Nat) => n + 1, count_concat(t, b, @step(h, Scan/lead()), w))
        | cont(_, _, _) => count_concat(t, b, @step(h, s), w)
        | bad() => count_concat(t, b, @step(h, Scan/bad()), w)
        end
    end;

--- Whether there are no characters.
pub let is_empty(s: Str) -> Bool =
    Bytes/len(to_bytes(s)) == 0;

--- The index of the first character `pred` accepts, or `none`.
pub let find_index(s: Str, pred: (Char) -> Bool) -> Option(Nat) =
    let (_, found): {Nat, Option(Nat)} =
        fold(
            s,
            (0, Option/none()),
            (codepoint, (i, found)) =>
                match found
                | some(_) => (i, found)
                | none() =>
                    (
                        i + 1,
                        match pred(codepoint) | true => Option/some(i) | false => Option/none() end)
                end);
    found;

--- The index of the first `target`, or `none`.
pub let index_of(s: Str, target: Char) -> Option(Nat) =
    find_index(s, (codepoint) => codepoint == target);

--- The first character `pred` accepts, or `none`.
---
--- Folded rather than read back through `try_get`, so the search is one walk and needs nothing declared after it.
pub let find(s: Str, pred: (Char) -> Bool) -> Option(Char) =
    fold(
        s,
        Option/none(),
        (codepoint, found) =>
            match found
            | some(_) => found
            | none() =>
                match pred(codepoint) | true => Option/some(codepoint) | false => Option/none() end
            end);

--- Whether `target` occurs in `s`.
pub let contains(s: Str, target: Char) -> Bool =
    Option/is_some(index_of(s, target));

--- The character at `i`, or `none` past the end.
pub let try_get(s: Str, i: Nat) -> Option(Char) =
    let (_, found): {Nat, Option(Char)} =
        fold(
            s,
            (0, Option/none()),
            (codepoint, (idx, found)) =>
                match found
                | some(_) => (idx, found)
                | none() =>
                    match idx == i
                    | true => (idx + 1, Option/some(codepoint))
                    | false => (idx + 1, Option/none())
                    end
                end);
    found;

--- The character at `i`, under the evidence that `i` is within the length.
pub let get(s: Str, i: Nat, ok: Nat/Lt(i, len(s))) -> Char =
    let go(
        sc: Scan,
        b: Bytes,
        valid: Valid/from(sc, b),
        i: Nat,
        within: Nat/Lt(i, count_scalars(sc, b)),
    ) -> Char =
        match b
        | x[] => match within end
        | x[h, ..t] =>
            match sc
            | lead() =>
                match i
                | 0 => Valid/decode_head(h, valid)
                | pred + 1 => go(step(h, Scan/lead()), t, valid, pred, within)
                end
            | cont(_, _, _) => go(step(h, sc), t, valid, i, within)
            | bad() => go(step(h, Scan/bad()), t, valid, i, within)
            end
        end;
    go(Scan/lead(), s.bytes, s.valid, i, ok);

--- `parts` with `sep` between each pair.
pub let join(sep: Str, parts: List(Str)) -> Str =
    List/balanced(
        List/len(parts),
        "",
        (i) => Option/unwrap_or(List/try_get(parts, i), ""),
        (l, r) => concat(concat(l, sep), r));

let trim_bounds(s: Str) -> {Nat, Nat} =
    let n = len(s);
    let (_, start, stop): {Nat, Nat, Nat} =
        fold(
            s,
            (0, n, 0),
            (codepoint, (i, start, stop)) =>
                match Char/is_whitespace(codepoint)
                | true => (i + 1, start, stop)
                | false =>
                    let begin = match start < n | true => start | false => i end;
                    (i + 1, begin, i + 1)
                end);
    (start, stop);

--- Without leading and trailing whitespace.
pub let trim(s: Str) -> Str =
    let (lo, hi) = trim_bounds(s);
    match lo < hi | true => slice(s, lo, hi - lo) | false => "" end;

--- Without leading whitespace.
pub let trim_start(s: Str) -> Str =
    drop_n(trim_bounds(s).0, s);

--- Without trailing whitespace.
pub let trim_end(s: Str) -> Str =
    take_n(trim_bounds(s).1, s);

--- Whether `s` begins with `prefix`.
pub let starts_with(s: Str, prefix: Str) -> Bool =
    eql(take_n(len(prefix), s), prefix);

--- Whether `s` ends with `suffix`.
pub let ends_with(s: Str, suffix: Str) -> Bool =
    eql(drop_n(len(s) - len(suffix), s), suffix);

--- The text before the first `sep` and the text after it, or `none` when `sep` does not occur.
pub let split_once(s: Str, sep: Str) -> Option({Str, Str}) =
    let m = len(sep);
    let go(i: Nat, rest: Str) -> Option({Str, Str}) =
        choose
        | starts_with(rest, sep) => Option/some((take_n(i, s), drop_n(m, rest)))
        | is_empty(rest) => Option/none()
        | _ => go(i + 1, drop_n(1, rest))
        end;
    go(0, s);

--- Whether `needle` occurs in `s` as a run of characters.
---
--- Named apart from [`contains`], which is the element reading `/std/List`, `/std/Bytes` and `/std/Bits` all give that word. The substring family beside it — `starts_with`, `ends_with`, `split_once`, `split` and `replace` — takes a `Str` needle too and needs no such mark, because none of them names an operation another carrier spells differently.
pub let has_substr(s: Str, needle: Str) -> Bool =
    Option/is_some(split_once(s, needle));

--- The pieces between occurrences of `sep`, the separators dropped; an empty separator splits into characters.
pub let split(s: Str, sep: Str) -> List(Str) =
    match is_empty(sep)
    | true => List/map(to_list(s), of_char)
    | false =>
        match split_once(s, sep)
        | some((before, after)) => [before, ..split(after, sep)]
        | none() => [s]
        end
    end;

--- Every occurrence of `from` replaced by `to`, left to right; an empty `from` changes nothing.
pub let replace(s: Str, from: Str, to: Str) -> Str =
    match is_empty(from)
    | true => s
    | false =>
        match split_once(s, from)
        | some((before, after)) => concat(concat(before, to), replace(after, from, to))
        | none() => s
        end
    end;

--- The lines: split on newlines, one trailing carriage return dropped from each, and a final newline closing the last line rather than opening an empty one.
pub let lines(s: Str) -> List(Str) =
    let strip(line: Str) -> Str =
        match ends_with(line, "\r") | true => take_n(len(line) - 1, line) | false => line end;
    match split_once(s, "\n")
    | some((line, rest)) => [strip(line), ..lines(rest)]
    | none() => match is_empty(s) | true => [] | false => [strip(s)] end
    end;

--- `s` widened to `n` characters with `c` at the front; a string already that wide is unchanged.
pub let pad_start(s: Str, n: Nat, c: Char) -> Str =
    concat(repeat(of_char(c), n - len(s)), s);

--- `s` widened to `n` characters with `c` at the end; a string already that wide is unchanged.
pub let pad_end(s: Str, n: Nat, c: Char) -> Str =
    concat(s, repeat(of_char(c), n - len(s)));

satisfy Eql(Str) {
    eql = eql,
    neq(a, b) = Bool/not(eql(a, b)),
}

satisfy Show(Str) {
    show(s) = s,
}

--- A string literal, escaped where the literal grammar needs it.
satisfy Spell(Str) {
    spell(s) =
        let body =
            fold(s, "", (c, acc) =>
                concat(
                    acc,
                    match Char/to_nat(c)
                    | '\n' => "\\n"
                    | '\t' => "\\t"
                    | '\r' => "\\r"
                    | '\\' => "\\\\"
                    | '"' => "\\\""
                    | _ => of_char(c)
                    end));
        concat("\"", concat(body, "\"")),
}

--- Code-point order.
pub let ord(a: Str, b: Str) -> Ordering =
    Bytes/ord(to_bytes(a), to_bytes(b));

satisfy Cmp(Str) {
    lt(a, b) = Ordering/is_lt(ord(a, b)),
    le(a, b) = Ordering/is_le(ord(a, b)),
    gt(a, b) = Ordering/is_gt(ord(a, b)),
    ge(a, b) = Ordering/is_ge(ord(a, b)),
}

satisfy Ord(Str) {
    ord = ord,
}
