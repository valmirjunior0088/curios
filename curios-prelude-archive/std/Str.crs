pub use /syn/{Str};
pub use /syn/Str/{Class, classify, Scan, step, Utf8, Valid};
use /syn/{True};
use /std/{Char, Nat, Byte, Bytes, Bool, List, Option, Eq, Equal, Show, Spell, Ordering, Compare,
    Ordered, Test};

-- | The scan-witness machinery every operation below rests on.
pub mod utf8;
use utf8/{check, concat_closed, drop_width, drop_width_within, drop_valid, take_valid, peel_byte,
    certify_decoded, decode_head, count_scalars};

pub let to_bytes(s: Str) -> Bytes =
    s.bytes;

pub let of_bytes(b: Bytes) -> Option(Str) =
    match check(Scan/lead(), b)
    | some(v) => Option/some(Str { bytes = b, valid = v })
    | none() => Option/none()
    end;

-- | The one-scalar string. `Char/to_utf8` encodes exactly the sequences `check` accepts, so the fallback is unreachable; the four bytes are re-checked rather than certified because no lemma relates the encoder to the scan.
pub let of_char(c: Char) -> Str =
    Option/unwrap_or(of_bytes(Char/to_utf8(c)), "");

-- | Storage decides identity: the scan witness is proof-irrelevant, so two strings over the same bytes are the same string. The `BigNat/eq` and `Char/eq_of_code` construction at a third carrier — transport the field equality under a motive abstracting the dependent field, then apply the result to the right-hand witness.
pub let eq_of_bytes(a: Str, b: Str, p: Eq(a.bytes, b.bytes)) -> Eq(a, b) =
    Eq/subst(
        (bytes: Bytes) => (valid: Valid(bytes)) -> Eq(a, Str { bytes = bytes, valid = valid }),
        p,
        (_valid: Valid(a.bytes)) => Eq/refl())(b.valid);

pub let concat(a: Str, b: Str) -> Str =
    Str { bytes = x[..a.bytes, ..b.bytes], valid = concat_closed(a.valid, b.valid) };

let drop_n(n: Nat, s: Str) -> Str =
    Str {
        bytes =
            Bytes/drop(
                s.bytes,
                drop_width(n, Scan/lead(), s.bytes),
                @drop_width_within(n, Scan/lead(), s.bytes)),
        valid = drop_valid(n, Scan/lead(), s.valid),
    };

let take_n(n: Nat, s: Str) -> Str =
    Str {
        bytes =
            Bytes/slice(
                s.bytes,
                0,
                drop_width(n, Scan/lead(), s.bytes),
                @drop_width_within(n, Scan/lead(), s.bytes)),
        valid = take_valid(n, Scan/lead(), s.valid),
    };

-- | A window of `n` characters from `x`, saturating at either end: `take_n` and `drop_n` both stop at what is there, so a window running past the end is the tail rather than a refusal. Unbounded, so it owes no proof — and count-based like the bounded windows, which is what a reversed range being unspellable buys: `slice(s, 5, 3)` used to compute `take_n(0, ..)` on truncating subtraction and answer the empty string for a range nobody meant.
pub let slice(s: Str, x: Nat, n: Nat) -> Str =
    take_n(n, drop_n(x, s));

pub let flatten(parts: List(Str)) -> Str =
    List/fold(parts, "", (p, acc) => concat(acc, p));

pub let eql(a: Str, b: Str) -> Bool =
    Bytes/eql(to_bytes(a), to_bytes(b));

-- | ASCII-insensitive equality folds only encoded ASCII letters. Every non-ASCII UTF-8 byte is left untouched, so this is not Unicode case folding.
let lower_ascii_byte(byte: Byte) -> Byte =
    let n = Byte/to_nat(byte);
    match Nat/in_range(n, 0x41, 0x5A) | true => Nat/to_byte(n + 0x20) | false => byte end;

let lower_ascii_bytes(b: Bytes) -> Bytes =
    Bytes/fold(b, x[], (byte, acc) => x[..acc, lower_ascii_byte(byte)]);

pub let eql_ascii_ci(a: Str, b: Str) -> Bool =
    Bytes/eql(lower_ascii_bytes(to_bytes(a)), lower_ascii_bytes(to_bytes(b)));

pub let repeat(s: Str, n: Nat) -> Str =
    List/balanced(n, "", (_i) => s, (l, r) => concat(l, r));

-- | The accumulator is threaded by the recursion, not by the motive, and that is the whole of why this is a `rec` rather than an induction over `s.bytes`.
-- |
-- | Written as an induction, the result of folding the tail has to be a *function* of the scan state and the accumulator, because a right fold cannot carry a value leftwards any other way. That makes every step return a closure, so a walk of N characters allocates N of them and applies the composition once — the cost is in the encoding, not in the work. Here `sc` and `acc` are ordinary parameters that the tail call carries forward, and the scan witness rides along as a third, transported one byte at a time by `peel_byte` exactly as it was before. `at` below walks the same way, for the same reason.
pub let fold(@A: Type, s: Str, init: A, f: (Char, A) -> A) -> A =
    let go(sc: Scan, b: Bytes, valid: Utf8(sc, b), acc: {A, Nat}) -> {A, Nat} =
        match b
        | x[] => acc
        | x[h, ..t] =>
            match sc
            | lead() =>
                go(
                    step(h, Scan/lead()),
                    t,
                    peel_byte(True/qed(), valid),
                    match classify(h)
                    | ascii() => (f(certify_decoded(Byte/to_nat(h)), acc.0), 0)
                    | lead(_width, _lo, _hi, payload) => (acc.0, payload)
                    | bad() => acc
                    end)
            | cont(rem, _lo, _hi) =>
                let partial = acc.1 * 0x40 + (Byte/to_nat(h) - 0x80);
                go(
                    step(h, sc),
                    t,
                    peel_byte(True/qed(), valid),
                    match rem == 1
                    | true => (f(certify_decoded(partial), acc.0), 0)
                    | false => (acc.0, partial)
                    end)
            | bad() => go(step(h, Scan/bad()), t, peel_byte(True/qed(), valid), acc)
            end
        end;
    go(Scan/lead(), s.bytes, s.valid, (init, 0)).0;

pub let to_list(s: Str) -> List(Char) =
    fold(s, [], (c, acc) => [..acc, c]);

pub let len(s: Str) -> Nat =
    count_scalars(Scan/lead(), s.bytes);

-- | Emptiness without the walk `len` performs, and it decides exactly that question: a `Str` carries a scan from `lead()`, so it holds no scalars precisely when it holds no bytes. Empty bytes count none, and nonempty bytes have their first byte read in the `lead()` state — the only arm `count_scalars` increments on — so the count is at least one. `Bytes/len` reads a stored length, so this settles in constant time what `len(s) == 0` settles in a pass over every byte.
pub let is_empty(s: Str) -> Bool =
    Bytes/len(to_bytes(s)) == 0;

pub let find_index(s: Str, pred: (Char) -> Bool) -> Option(Nat) =
    let (_, found): {Nat, Option(Nat)} =
        fold(
            s,
            (0, Option/none()),
            (codepoint, (i, found)) =>
                match found
                | some(_) => (i, found)
                | none() =>
                    (
                        i + 1,
                        match pred(codepoint) | true => Option/some(i) | false => Option/none() end)
                end);
    found;

pub let find(s: Str, target: Char) -> Option(Nat) =
    find_index(s, (codepoint) => codepoint == target);

pub let try_get(s: Str, i: Nat) -> Option(Char) =
    let (_, found): {Nat, Option(Char)} =
        fold(
            s,
            (0, Option/none()),
            (codepoint, (idx, found)) =>
                match found
                | some(_) => (idx, found)
                | none() =>
                    match idx == i
                    | true => (idx + 1, Option/some(codepoint))
                    | false => (idx + 1, Option/none())
                    end
                end);
    found;

pub let get(s: Str, i: Nat, ok: Nat/Lt(i, len(s))) -> Char =
    let go(
        sc: Scan,
        b: Bytes,
        valid: Utf8(sc, b),
        i: Nat,
        le: Nat/Le/Ind(i + 1, count_scalars(sc, b)),
    ) -> Char =
        match b
        | x[] => match le end
        | x[h, ..t] =>
            match sc
            | lead() =>
                match i
                | 0 => decode_head(h, valid)
                | pred + 1 =>
                    go(
                        step(h, Scan/lead()),
                        t,
                        peel_byte(True/qed(), valid),
                        pred,
                        match le: (x, y, _le) => Nat/Le/Ind(x - 1, y - 1)
                        | s(@_a, @_c, prev) => prev
                        end)
                end
            | cont(_rem, _lo, _hi) => go(step(h, sc), t, peel_byte(True/qed(), valid), i, le)
            | bad() => go(step(h, Scan/bad()), t, peel_byte(True/qed(), valid), i, le)
            end
        end;
    go(
        Scan/lead(),
        s.bytes,
        s.valid,
        i,
        Nat/Lt/ind_succ_of_lt(i, count_scalars(Scan/lead(), s.bytes), ok));

pub let join(sep: Str, parts: List(Str)) -> Str =
    List/balanced(
        List/len(parts),
        "",
        (i) => Option/unwrap_or(List/try_get(parts, i), ""),
        (l, r) => concat(concat(l, sep), r));

let trim_bounds(s: Str) -> {Nat, Nat} =
    let n = len(s);
    let (_, start, stop): {Nat, Nat, Nat} =
        fold(
            s,
            (0, n, 0),
            (codepoint, (i, start, stop)) =>
                match Char/is_whitespace(codepoint)
                | true => (i + 1, start, stop)
                | false =>
                    let begin = match start < n | true => start | false => i end;
                    (i + 1, begin, i + 1)
                end);
    (start, stop);

pub let trim(s: Str) -> Str =
    let (lo, hi) = trim_bounds(s);
    match lo < hi | true => slice(s, lo, hi - lo) | false => "" end;

pub let trim_start(s: Str) -> Str =
    drop_n(trim_bounds(s).0, s);

pub let trim_end(s: Str) -> Str =
    take_n(trim_bounds(s).1, s);

-- | Decomposition. Everything below works over scalar windows through `take_n` and `drop_n`, so each result carries the proof `slice` threads and nothing re-validates. Two windows are compared by `eql`, bytewise: UTF-8 is self-synchronizing, so encoded bytes agree exactly when the scalars they encode agree, and nothing is decoded. The searches recurse on a strictly shorter suffix, which is general recursion, so a type may not mention them.
pub let starts_with(s: Str, prefix: Str) -> Bool =
    eql(take_n(len(prefix), s), prefix);

-- | Truncating subtraction settles the short case: when `suffix` is longer than `s` nothing is dropped, and the comparison is of two strings of different lengths.
pub let ends_with(s: Str, suffix: Str) -> Bool =
    eql(drop_n(len(s) - len(suffix), s), suffix);

-- | The text before the first occurrence of `sep` and the text after it; `none` when it does not occur. An empty separator occurs at once, before the first scalar.
pub let split_once(s: Str, sep: Str) -> Option({Str, Str}) =
    let m = len(sep);
    let go(i: Nat, rest: Str) -> Option({Str, Str}) =
        choose
        | starts_with(rest, sep) => Option/some((take_n(i, s), drop_n(m, rest)))
        | is_empty(rest) => Option/none()
        | _ => go(i + 1, drop_n(1, rest))
        end;
    go(0, s);

pub let contains(s: Str, needle: Str) -> Bool =
    Option/is_some(split_once(s, needle));

-- | The pieces between occurrences of `sep`, the separators dropped; an empty separator splits into scalars, which is the guard's answer rather than the search's -- `split_once` finds an empty needle at once and forever, so walking one would never advance.
pub let split(s: Str, sep: Str) -> List(Str) =
    match is_empty(sep)
    | true => List/map(to_list(s), of_char)
    | false =>
        match split_once(s, sep)
        | some((before, after)) => [before, ..split(after, sep)]
        | none() => [s]
        end
    end;

-- | Every occurrence of `from` replaced by `to`, left to right and without rescanning what `to` inserted.
-- |
-- | An empty `from` comes back unchanged, and the guard is what says so rather than the search: `split_once` finds an empty needle *at once*, before the first scalar, which is why `contains(s, "")` is true -- so the recursion below would split at position zero forever. `split` takes the same guard to the other answer, scalars, because there the walk has one; here it does not, and the identity is the only terminating reading.
pub let replace(s: Str, from: Str, to: Str) -> Str =
    match is_empty(from)
    | true => s
    | false =>
        match split_once(s, from)
        | some((before, after)) => concat(concat(before, to), replace(after, from, to))
        | none() => s
        end
    end;

-- | The lines of `s`: split on `'\n'`, one trailing `'\r'` dropped from each, and a final terminator closes the last line rather than opening an empty one, so `"a\nb\n"` has two lines and `""` none.
pub let lines(s: Str) -> List(Str) =
    let strip(line: Str) -> Str =
        match ends_with(line, "\r") | true => take_n(len(line) - 1, line) | false => line end;
    match split_once(s, "\n")
    | some((line, rest)) => [strip(line), ..lines(rest)]
    | none() => match is_empty(s) | true => [] | false => [strip(s)] end
    end;

-- | `s` widened to `n` scalars with copies of `c` at the front; a string already that wide comes back as it is.
pub let pad_start(s: Str, n: Nat, c: Char) -> Str =
    concat(repeat(of_char(c), n - len(s)), s);

pub let pad_end(s: Str, n: Nat, c: Char) -> Str =
    concat(s, repeat(of_char(c), n - len(s)));

satisfy Equal(Str) {
    eql = eql,
    neq(a, b) = Bool/not(eql(a, b)),
}

satisfy Show(Str) {
    show(s) = s,
}

satisfy Spell(Str) {
    spell(s) =
        let body =
            fold(
                s,
                "",
                (c, acc) =>
                    concat(
                        acc,
                        match Char/to_nat(c)
                        | '\n' => "\\n"
                        | '\t' => "\\t"
                        | '\r' => "\\r"
                        | '\\' => "\\\\"
                        | '"' => "\\\""
                        | _ => of_char(c)
                        end));
        concat("\"", concat(body, "\"")),
}

-- | Code-point order without decoding: UTF-8 bytewise order is scalar-value order, so the comparison is `Bytes/cmp` over the storage and `sort` on strings means code-point order.
pub let cmp(a: Str, b: Str) -> Ordering =
    Bytes/cmp(to_bytes(a), to_bytes(b));

satisfy Compare(Str) {
    lt(a, b) = Ordering/is_lt(cmp(a, b)),
    le(a, b) = Ordering/is_le(cmp(a, b)),
    gt(a, b) = Ordering/is_gt(cmp(a, b)),
    ge(a, b) = Ordering/is_ge(cmp(a, b)),
}

satisfy Ordered(Str) {
    cmp = cmp,
}

let chars(seed: Test/Seed, size: Nat, count: Nat) -> {Str, Test/Seed} =
    match count
    | 0 => ("", seed)
    | _more + 1; (acc, after) =>
        let (c, rest) = Test/Draw/draw(@Char, after, size);
        (concat(acc, of_char(c)), rest)
    end;

-- | At most `size` characters, each drawn as a `Char`.
satisfy Test/Draw(Str) {
    all() = Option/none(),
    draw(seed, size) =
        let (count, after) = Test/Draw/draw(@Nat, seed, size);
        chars(after, size, count),
}
