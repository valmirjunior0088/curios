use /std/{Nat, Byte, Bytes, Bits, Bool, Str, List, Option, Int, Flt};

--- How a value encodes to the bytes that identify it.
---
--- The encoding is a value's identity and is *determined*: one value encodes to one byte string, in any program, from the value and the carrier's documented reading alone — which is what `/std/Map`'s `Key` adds injectivity to, and what makes two runs of the same program agree.
pub concept Hash(T: Type): pub Type {
    --- The encoding.
    hash(T) -> Bytes,
}

pub use Hash/*;

--- `b` ahead of enough zero bytes to reach `width`, or `b` itself when it is already that long.
---
--- Trailing rather than leading, and that is not a preference. `Bytes/of_nat` writes its least significant byte first, so a zero byte *after* the run is a higher place worth nothing, while one before it would multiply the value by 256: padding `5` and `1280` on the wrong side gives both `x[0,0,0,5]`, and two distinct numbers sharing an encoding is exactly what every user of this function exists to prevent. `Key`'s law would refuse its own case at the witness; `framed`, `tagged` and `digest` carry no law and would collide in silence.
pub let padded(b: Bytes, width: Nat) -> Bytes =
    Bytes/flatten([b, Bytes/replicate(width - Bytes/len(b), 0x0)]);

--- `b` behind its four-byte length.
---
--- Four bytes because the minimal encoding of any length a `Bytes` value can have is at most that long, so the frame is self-delimiting: a concatenation of framed parts splits back into exactly the parts it was built from. Fixed width is what makes that true, not which end the length reads from.
pub let framed(b: Bytes) -> Bytes =
    Bytes/flatten([padded(Bytes/of_nat(Bytes/len(b)), 4), b]);

--- A constructor's tag and its payloads' encodings, each framed.
---
--- What a derived witness writes. Framing every part is what keeps two distinct values from sharing an encoding, and it is the whole of what an injectivity proof over this would need.
pub let tagged(tag: Nat, parts: List(Bytes)) -> Bytes =
    Bytes/flatten([framed(Bytes/of_nat(tag)), Bytes/flatten(List/map(parts, framed))]);

--- One polynomial lane: `acc · base + byte + 1` reduced modulo `prime`, folded over `b`.
---
--- Spelled with `Nat/rem` rather than `%` because the modulus is a parameter. `%` states `Lt(0, b)` on its divisor and has nowhere to put the evidence, and an obligation discharges by reduction, by a guard's refinement, or by a written proof — never by a search of what happens to be in scope. This telescope holds the proof, so it hands it over.
let lane(b: Bytes, base: Nat, prime: Nat, @ok: Nat/Lt(0, prime)) -> Nat =
    Bytes/fold(b, 1, (byte, acc) => Nat/rem(acc * base + Byte/to_nat(byte) + 1, prime, @ok));

--- Eight bytes summarizing `b`.
---
--- **Not stable across compiler versions: do not persist or transmit one.** Three polynomial lanes at distinct primes, which is enough for dedup, cache keys and bloom filters and is not adversarially resistant — anyone who chooses the input can collide it. Encode with `Hash/hash` where the bytes must keep meaning.
---
--- Every intermediate stays below `2^31`, which is what lets a mixer be written in `Nat` at all: an accumulator is below its prime, so a product is below `prime · base`, and each pair below is chosen to keep that inside the carrier. A wider mixer would need wrapping arithmetic, which `Nat` refuses rather than performs.
pub let digest(b: Bytes) -> Bytes =
    Bytes/flatten([
        padded(Bytes/of_nat(lane(b, 131, 8388593)), 3),
        padded(Bytes/of_nat(lane(b, 137, 8388581)), 3),
        padded(Bytes/of_nat(lane(b, 139, 8388571) % 65536), 2)]);

--- The digest of `v`'s encoding.
pub let of(@T: Type, use Hash(T), v: T) -> Bytes =
    digest(Hash/hash(v));

--- The identity encoding.
satisfy Hash(Bytes) {
    hash(b) = b,
}

--- One byte per bit, least significant first as the carrier reads.
---
--- **Not the packed form, and that is the whole difficulty.** Packing is not injective on its own: `b[1]` and `b[1, 0]` are one byte each and the same byte, since a run's padding is zeroed, so a dense encoding would have to carry the length beside the bytes and `Bits/to_bytes` would have to be reached past the alignment it demands. A byte per bit carries the length in its own extent — the encoding is as long as the run — and needs neither. The width is paid once here and not in what a key holds, `Hash/of` digesting the result to eight bytes.
---
--- **Eightfold is a held position, not a settled one.** It is what a reading with no consumers should cost the library to state, and a dense encoding is available the moment one arrives: the length beside the packed bytes, with `/std/Map`'s `Key(Bits)` reproved over the pair rather than over the extent. Until then the cheap encoding would buy nothing and owe a second proof, so the width stands.
---
--- Spelled as the structural fold rather than through `Bits/fold`, which threads an accumulator: `/std/Map`'s `Key(Bits)` inverts this by induction, and the `; ih` form is what makes `hash(b[h, ..t])` reduce to `x[<h>, ..hash(t)]` at all. Through the accumulating fold the two sides differ in what they start from, and relating them costs a distribution lemma for nothing.
satisfy Hash(Bits) {
    hash(b) =
        match b
        | b[] => x[]
        | b[h, .._]; ih => x[match h | true => 0x1 | false => 0x0 end, ..ih]
        end,
}

--- The UTF-8 bytes.
satisfy Hash(Str) {
    hash = Str/to_bytes,
}

--- The minimal encoding, least-significant byte first as the carrier reads.
satisfy Hash(Nat) {
    hash = Bytes/of_nat,
}

--- A sign byte before the magnitude.
satisfy Hash(Int) {
    hash(i) =
        Bytes/flatten([
            match i >= +0 | true => x[0x0] | false => x[0x1] end,
            Bytes/of_nat(Int/abs(i))]),
}

--- The one byte itself.
---
--- Spelled as the byte rather than routed through `Bytes/of_nat` and padded back to one byte, which is the same encoding for all 256 values and says it the long way round: `of_nat` answers the empty run at zero, so the padding existed only to undo that. Written directly, `/std/Map`'s `Key(Byte)` reads the byte back with the index that put it there instead of proving its way through a minimal encoding.
satisfy Hash(Byte) {
    hash(b) = x[b],
}

satisfy Hash(Bool) {
    hash(b) = match b | true => x[0x1] | false => x[0x0] end,
}

--- The little-endian bit pattern, so distinct floats encode distinctly, every NaN pattern among them.
satisfy Hash(Flt) {
    hash = Flt/to_le_bytes,
}

satisfy (@A: Type, use Hash(A)) => Hash(List(A)) {
    hash(values) = tagged(List/len(values), List/map(values, (value) => Hash/hash(value))),
}

satisfy (@A: Type, use Hash(A)) => Hash(Option(A)) {
    hash(value) =
        match value | none() => tagged(0, []) | some(inner) => tagged(1, [Hash/hash(inner)]) end,
}
