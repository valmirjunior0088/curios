use /std/{Bool, Equal, Show, Spell, Str, Option, Ordering, Compare, Ordered};
use /std/Test/{Draw, Seed};

pub induct Result(A: Type, E: Type): pub Type
| success(A)
| failure(E)
end

pub use Result/*;

pub let map_success(@A: Type, @B: Type, @E: Type, r: Result(A, E), f: (A) -> B) -> Result(B, E) =
    match r | success(a) => Result/success(f(a)) | failure(e) => Result/failure(e) end;

pub let map_failure(@A: Type, @E: Type, @F: Type, r: Result(A, E), f: (E) -> F) -> Result(A, F) =
    match r | success(a) => Result/success(a) | failure(e) => Result/failure(f(e)) end;

pub let bind(
    @A: Type,
    @B: Type,
    @E: Type,
    m: Result(A, E),
    f: (A) -> Result(B, E),
) -> Result(B, E) =
    match m | success(a) => f(a) | failure(e) => Result/failure(e) end;

pub let flatten(@A: Type, @E: Type, r: Result(Result(A, E), E)) -> Result(A, E) =
    match r | success(inner) => inner | failure(e) => Result/failure(e) end;

pub let unwrap_or(@A: Type, @E: Type, r: Result(A, E), default: A) -> A =
    match r | success(a) => a | failure(_) => default end;

pub let is_success(@A: Type, @E: Type, r: Result(A, E)) -> Bool =
    match r | success(_) => true | failure(_) => false end;

pub let is_failure(@A: Type, @E: Type, r: Result(A, E)) -> Bool =
    match r | success(_) => false | failure(_) => true end;

pub let to_option(@A: Type, @E: Type, r: Result(A, E)) -> Option(A) =
    match r | success(a) => Option/some(a) | failure(_) => Option/none() end;

pub let unwrap_or_else(@A: Type, @E: Type, r: Result(A, E), default: (E) -> A) -> A =
    match r | success(a) => a | failure(e) => default(e) end;

satisfy (@A: Type, @E: Type, use Equal(A), use Equal(E)) => Equal(Result(A, E));

satisfy (@A: Type, @E: Type, use Show(A), use Show(E)) => Show(Result(A, E)) {
    show(r) =
        match r
        | success(x) => Str/concat("success(", Str/concat(Show/show(x), ")"))
        | failure(e) => Str/concat("failure(", Str/concat(Show/show(e), ")"))
        end,
}

satisfy (@A: Type, @E: Type, use Spell(A), use Spell(E)) => Spell(Result(A, E));

-- `failure` below `success`.
pub let cmp(
    @A: Type,
    @E: Type,
    use Ordered(A),
    use Ordered(E),
    a: Result(A, E),
    b: Result(A, E),
) -> Ordering =
    match a
    | failure(e) => match b | failure(f) => Ordered/cmp(e, f) | success(_) => Ordering/lt() end
    | success(x) => match b | failure(_) => Ordering/gt() | success(y) => Ordered/cmp(x, y) end
    end;

satisfy (@A: Type, @E: Type, use Ordered(A), use Ordered(E)) => Compare(Result(A, E)) {
    lt(a, b) = Ordering/is_lt(cmp(a, b)),
    le(a, b) = Ordering/is_le(cmp(a, b)),
    gt(a, b) = Ordering/is_gt(cmp(a, b)),
    ge(a, b) = Ordering/is_ge(cmp(a, b)),
}

satisfy (@A: Type, @E: Type, use Ordered(A), use Ordered(E)) => Ordered(Result(A, E)) {
    cmp = cmp,
}

satisfy (@A: Type, @E: Type, use Draw(A), use Draw(E)) => Draw(Result(A, E)) {
    draw(seed, size) =
        let (n, after) = Seed/next(seed);
        match n % 4 == 0
        | true =>
            let (failure, rest) = Draw/draw(@E, after, size);
            (Result/failure(failure), rest)
        | false =>
            let (value, rest) = Draw/draw(@A, after, size);
            (Result/success(value), rest)
        end,
}
