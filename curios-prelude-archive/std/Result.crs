use /std/{Bool, Show, Spell, Str, Option, Ordering, Ord, Monad};
use /std/ops/{Eql, Cmp};

-- | Success or failure, the failure's type first.
pub induct Result(E: Type, A: Type): pub Type
-- | It worked, carrying the value.
| success(A)
-- | It did not, carrying the error.
| failure(E)
end

pub use Result/*;

-- | `a` as a success.
pub let pure(@E: Type, @A: Type, a: A) -> Result(E, A) =
    Result/success(a);

-- | `e` as a failure: in a `Result` region, the early return.
pub let raise(@E: Type, @A: Type, e: E) -> Result(E, A) =
    Result/failure(e);

-- | A failure handed to `handler`; a success passes through.
pub let rescue(@E: Type, @A: Type, r: Result(E, A), handler: (E) -> Result(E, A)) -> Result(E, A) =
    match r | success(_) => r | failure(e) => handler(e) end;

-- | `f` on the value of a success.
pub let map_success(@A: Type, @B: Type, @E: Type, r: Result(E, A), f: (A) -> B) -> Result(E, B) =
    match r | success(a) => Result/success(f(a)) | failure(e) => Result/failure(e) end;

-- | `f` on the error of a failure.
pub let map_failure(@A: Type, @E: Type, @F: Type, r: Result(E, A), f: (E) -> F) -> Result(F, A) =
    match r | success(a) => Result/success(a) | failure(e) => Result/failure(f(e)) end;

-- | `f` on the value of a success; a failure passes through.
pub let bind(
    @A: Type,
    @B: Type,
    @E: Type,
    m: Result(E, A),
    f: (A) -> Result(E, B),
) -> Result(E, B) =
    match m | success(a) => f(a) | failure(e) => Result/failure(e) end;

-- | A result of a result collapsed to one.
pub let flatten(@A: Type, @E: Type, r: Result(E, Result(E, A))) -> Result(E, A) =
    match r | success(inner) => inner | failure(e) => Result/failure(e) end;

-- | The value, or `default` on a failure.
pub let unwrap_or(@A: Type, @E: Type, r: Result(E, A), default: A) -> A =
    match r | success(a) => a | failure(_) => default end;

-- | Whether `r` is a success.
pub let is_success(@A: Type, @E: Type, r: Result(E, A)) -> Bool =
    match r | success(_) => true | failure(_) => false end;

-- | Whether `r` is a failure.
pub let is_failure(@A: Type, @E: Type, r: Result(E, A)) -> Bool =
    match r | success(_) => false | failure(_) => true end;

-- | The value of a success; a failure is `none`, its error dropped.
pub let to_option(@A: Type, @E: Type, r: Result(E, A)) -> Option(A) =
    match r | success(a) => Option/some(a) | failure(_) => Option/none() end;

-- | The value, or what `default` answers to the error.
pub let unwrap_or_else(@A: Type, @E: Type, r: Result(E, A), default: (E) -> A) -> A =
    match r | success(a) => a | failure(e) => default(e) end;

satisfy (@E: Type) => Monad((A: Type) => Result(E, A)) {
    pure(@_, a) = pure(a),
    bind(@_, @_, m, f) = bind(m, f),
}

satisfy (@A: Type, @E: Type, use Eql(A), use Eql(E)) => Eql(Result(E, A));

satisfy (@A: Type, @E: Type, use Show(A), use Show(E)) => Show(Result(E, A)) {
    show(r) =
        match r
        | success(x) => Str/concat("success(", Str/concat(Show/show(x), ")"))
        | failure(e) => Str/concat("failure(", Str/concat(Show/show(e), ")"))
        end,
}

satisfy (@A: Type, @E: Type, use Spell(A), use Spell(E)) => Spell(Result(E, A));

-- | `failure` below `success`; two failures by `E`'s order and two successes by `A`'s.
pub let cmp(
    @A: Type,
    @E: Type,
    use Ord(A),
    use Ord(E),
    a: Result(E, A),
    b: Result(E, A),
) -> Ordering =
    match a
    | failure(e) => match b | failure(f) => Ord/ord(e, f) | success(_) => Ordering/lt() end
    | success(x) => match b | failure(_) => Ordering/gt() | success(y) => Ord/ord(x, y) end
    end;

satisfy (@A: Type, @E: Type, use Ord(A), use Ord(E)) => Cmp(Result(E, A)) {
    lt(a, b) = Ordering/is_lt(cmp(a, b)),
    le(a, b) = Ordering/is_le(cmp(a, b)),
    gt(a, b) = Ordering/is_gt(cmp(a, b)),
    ge(a, b) = Ordering/is_ge(cmp(a, b)),
}

satisfy (@A: Type, @E: Type, use Ord(A), use Ord(E)) => Ord(Result(E, A)) {
    ord = cmp,
}
