use /std/Str/{classify, Scan, step, scan_from, drop_width, drop_width_within, pending, concluded,
    advanced, begins_scalars_of};
use /std/{Bool, Byte, Bytes, Char, Eq, Nat, Option};

--- Whether a scan has come to rest between characters.
let at_lead(s: Scan) -> Bool =
    match s | lead() => true | _ => false end;

--- That `b`, read from the scan state `s`, lands back between characters: `Valid` from any state.
---
--- Decided, so it has no constructors to walk. A proof walks the bytes instead: `from(s, x[c, ..t])` *is* `from(step(c, s), t)`, so the evidence for the whole is already the evidence for the tail. A recursive call writes the tail it moves to, as `@t`, since inferring it from the evidence would take the whole.
pub let from(s: Scan, b: Bytes) -> Prop =
    Bool/Holds(at_lead(scan_from(s, b)));

--- That `b` is well-formed UTF-8, which is what `Str` carries.
---
--- Decided: reading `b` from the first byte lands back between characters, so a literal discharges it by running the scan.
pub let Valid(b: Bytes) -> Prop =
    from(Scan/lead(), b);

--- A scan at rest is at `lead`.
let lead_of(s: Scan, h: Bool/Holds(at_lead(s))) -> Eq(s, Scan/lead()) =
    match s
    | lead() => Eq/refl()
    | cont(_, _, _) => match h end
    | bad() => match h end
    end;

--- Reading a concatenation is reading its halves in turn.
let append(
    s: Scan,
    a: Bytes,
    b: Bytes,
) -> Eq(scan_from(s, x[..a, ..b]), scan_from(scan_from(s, a), b)) =
    match a | x[] => Eq/refl() | x[h, ..t] => append(step(h, s), t, b) end;

--- The procedure that decides whether `b` is well-formed from `s`: the evidence when it is, `none` otherwise.
pub let try(s: Scan, b: Bytes) -> Option(from(s, b)) =
    match at_lead(scan_from(s, b)): (r) => Option(Bool/Holds(r))
    | true => Option/some(Bool/True/qed())
    | false => Option/none()
    end;

--- Valid bytes concatenate to valid bytes.
pub let concat(@a: Bytes, @b: Bytes, va: Valid(a), vb: Valid(b)) -> Valid(x[..a, ..b]) =
    Eq/subst(
        (sc: Scan) => Bool/Holds(at_lead(sc)),
        Eq/sym(
            Eq/trans(
                append(Scan/lead(), a, b),
                Eq/cong((sc: Scan) => scan_from(sc, b), lead_of(scan_from(Scan/lead(), a), va)))),
        vb);

--- Validity carried past the first `n` characters.
pub let drop(
    n: Nat,
    s: Scan,
    @b: Bytes,
    d: from(s, b),
) -> Valid(Bytes/drop(b, drop_width(n, s, b), @drop_width_within(n, s, b))) =
    match b
    | x[] =>
        match s
        | lead() => Bool/True/qed()
        | cont(_, _, _) => match d end
        | bad() => match d end
        end
    | x[c, ..t] =>
        match s
        | lead() => match n | 0 => d | pred + 1 => drop(pred, step(c, Scan/lead()), @t, d) end
        | cont(_, _, _) => drop(n, step(c, s), @t, d)
        | bad() => drop(n, step(c, Scan/bad()), @t, d)
        end
    end;

--- Validity carried onto the first `n` characters.
pub let take(
    n: Nat,
    s: Scan,
    @b: Bytes,
    d: from(s, b),
) -> from(s, Bytes/slice(b, 0, drop_width(n, s, b), @drop_width_within(n, s, b))) =
    match b
    | x[] => d
    | x[c, ..t] =>
        match s
        | lead() =>
            match n | 0 => Bool/True/qed() | pred + 1 => take(pred, step(c, Scan/lead()), @t, d) end
        | cont(_, _, _) => take(n, step(c, s), @t, d)
        | bad() => take(n, step(c, Scan/bad()), @t, d)
        end
    end;

--- Nothing is valid from the bad state.
pub let from_bad(@x: Bytes, w: from(Scan/bad(), x)) -> Bool/False =
    match x
    | x[] => match w end
    | x[_, ..t] => from_bad(@t, w)
    end;

--- The rest of a character owed `rem` continuation bytes, the next between `lo` and `hi`, over the bits `partial` has gathered: read off the bytes the evidence says follow, and ended at a scalar value because it can only end at one.
---
--- A walk over the evidence rather than over an offset: each arm is the scan's own step, specialized by its guard, so a byte out of range is the bad state that valid bytes never reach, and a character cut short is a scan left inside it at the end.
let finish(
    rem: Nat,
    lo: Nat,
    hi: Nat,
    partial: Nat,
    @t: Bytes,
    p: Bool/Holds(pending(rem, lo, hi, partial)),
    w: from(Scan/cont(rem, lo, hi), t),
) -> Char =
    match t
    | x[] => match w end
    | x[c, ..rest] =>
        match Nat/in_range(Byte/to_nat(c), lo, hi)
        | false => match from_bad(@rest, w) end
        | true =>
            match rem == 1
            | true =>
                let last =
                    Eq/subst(
                        (r: Nat) => Bool/Holds(pending(r, lo, hi, partial)),
                        Nat/eq_of_eql(rem, 1, Bool/True/qed()),
                        p);
                Char {
                    code = partial * 0x40 + (Byte/to_nat(c) - 0x80),
                    valid = concluded(lo, hi, partial, Byte/to_nat(c), last, Bool/True/qed()),
                }
            | false =>
                finish(
                    rem - 1,
                    0x80,
                    0xBF,
                    partial * 0x40 + (Byte/to_nat(c) - 0x80),
                    @rest,
                    advanced(
                        rem,
                        lo,
                        hi,
                        partial,
                        Byte/to_nat(c),
                        p,
                        Bool/True/qed(),
                        Bool/True/qed()),
                    w)
            end
        end
    end;

--- The first character of bytes valid from the first byte.
pub let decode_head(c: Byte, @t: Bytes, w: from(Scan/lead(), x[c, ..t])) -> Char =
    match classify(c)
    | ascii() => Char { code = Byte/to_nat(c), valid = Bool/True/qed() }
    | lead(rem, lo, hi, partial) => finish(rem, lo, hi, partial, @t, begins_scalars_of(c), w)
    | bad() => match from_bad(@t, w) end
    end;

--- A character's UTF-8 encoding is well-formed.
---
--- Walked by the guards `Char/to_utf8` chose its family by, so each arm's goal reduces to that family's bytes read through `classify`. What reduction cannot see is where a lead byte narrows its first continuation's range, and each such edge is one arm: `E0` floors it at `A0`, so a three-byte form cannot spell what two bytes hold; `ED` caps it at `9F`, which excludes the surrogates; `F0` floors it at `90`, lifting a four-byte value past `U+FFFF`; and `F4` caps it at `8F`, at `U+10FFFF`. The code point's own bounds settle each — its guards, and `c.valid` where the ceiling is the scalar values' — and every other byte's range reduction decides.
pub let encoded(c: Char) -> Valid(Char/to_utf8(c)) =
    match c.code < 0x80
    | true => Bool/True/qed()
    | false =>
        match c.code < 0x800
        -- `C2..=DF`: the lead byte's payload is at least `2`, since the code point is at least `0x80`, and below `0x20`.
        | true =>
            match c.code / 0x40 >= 2
            | false =>
                match Nat/Lt/lt_of_lt_le(
                    c.code / 0x40,
                    2,
                    c.code / 0x40,
                    Bool/True/qed(),
                    Nat/div_mod/le_div_of_mul_le(2, c.code, 0x40, Bool/True/qed()))
                end
            | true =>
                match c.code / 0x40 <= 0x1F
                | true => Bool/True/qed()
                | false =>
                    match Nat/Lt/lt_of_le_lt(
                        0x20,
                        c.code / 0x40,
                        0x20,
                        Nat/Lt/le_succ_of_lt(0x1F, c.code / 0x40, Bool/True/qed()),
                        Nat/div_mod/div_lt_of_lt_mul(0x20, c.code, 0x40, Bool/True/qed()))
                    end
                end
            end
        | false =>
            match c.code < 0x10000
            -- `E0..=EF`, the lead byte's payload being below `0x10`.
            | true =>
                match c.code / 0x1000 <= 0xF
                | false =>
                    match Nat/Lt/lt_of_le_lt(
                        0x10,
                        c.code / 0x1000,
                        0x10,
                        Nat/Lt/le_succ_of_lt(0xF, c.code / 0x1000, Bool/True/qed()),
                        Nat/div_mod/div_lt_of_lt_mul(0x10, c.code, 0x1000, Bool/True/qed()))
                    end
                | true =>
                    match c.code / 0x1000 == 0
                    -- `E0`: the code point is at least `0x800` with nothing above its low twelve bits, so its next six are at least `0x20`.
                    | true =>
                        match c.code / 0x1000 == 0xD
                        | true =>
                            match Eq/subst(
                                (k: Nat) => Bool/Holds(k == 0xD),
                                Nat/eq_of_eql(c.code / 0x1000, 0, Bool/True/qed()),
                                Bool/True/qed())
                            end
                        | false =>
                            match c.code % 0x1000 / 0x40 >= 0x20
                            | true => Bool/True/qed()
                            | false =>
                                let low: Nat/Le(0x800, c.code % 0x1000) =
                                    Eq/subst(
                                        (k: Nat) => Nat/Le(0x800, k * 0x1000 + c.code % 0x1000),
                                        Nat/eq_of_eql(c.code / 0x1000, 0, Bool/True/qed()),
                                        Bool/True/qed());
                                match Nat/Lt/lt_of_lt_le(
                                    c.code % 0x1000 / 0x40,
                                    0x20,
                                    c.code % 0x1000 / 0x40,
                                    Bool/True/qed(),
                                    Nat/div_mod/le_div_of_mul_le(0x20, c.code % 0x1000, 0x40, low))
                                end
                            end
                        end
                    | false =>
                        match c.code / 0x1000 == 0xD
                        -- `ED`: the code point is below `0xE000`, so validity puts it below the surrogates at `0xD800`, and its next six bits below `0x20`.
                        | true =>
                            match c.code % 0x1000 / 0x40 <= 0x1F
                            | true => Bool/True/qed()
                            | false =>
                                let below_end: Nat/Lt(c.code, 0xE000) =
                                    Eq/subst(
                                        (k: Nat) => Nat/Lt(k * 0x1000 + c.code % 0x1000, 0xE000),
                                        Eq/sym(
                                            Nat/eq_of_eql(c.code / 0x1000, 0xD, Bool/True/qed())),
                                        Bool/True/qed());
                                let high: Nat/Lt(0xD * 0x1000 + c.code % 0x1000, 0xD800) =
                                    Eq/subst(
                                        (k: Nat) => Nat/Lt(k * 0x1000 + c.code % 0x1000, 0xD800),
                                        Nat/eq_of_eql(c.code / 0x1000, 0xD, Bool/True/qed()),
                                        Char/Valid/below_surrogates_of(c.code, c.valid, below_end));
                                match Nat/Lt/lt_of_le_lt(
                                    0x20,
                                    c.code % 0x1000 / 0x40,
                                    0x20,
                                    Nat/Lt/le_succ_of_lt(
                                        0x1F,
                                        c.code % 0x1000 / 0x40,
                                        Bool/True/qed()),
                                    Nat/div_mod/div_lt_of_lt_mul(0x20, c.code % 0x1000, 0x40, high))
                                end
                            end
                        | false => Bool/True/qed()
                        end
                    end
                end
            -- `F0..=F4`, the lead byte's payload being at most `4` because a scalar value is at most `U+10FFFF`.
            | false =>
                let top = Char/Valid/at_most(c.code, c.valid);
                match c.code / 0x40000 <= 4
                | false =>
                    match Nat/Lt/lt_of_le_lt(
                        5,
                        c.code / 0x40000,
                        5,
                        Nat/Lt/le_succ_of_lt(4, c.code / 0x40000, Bool/True/qed()),
                        Nat/div_mod/div_lt_of_lt_mul(
                            5,
                            c.code,
                            0x40000,
                            Nat/Lt/lt_of_le_lt(c.code, 0x10FFFF, 0x140000, top, Bool/True/qed())))
                    end
                | true =>
                    match c.code / 0x40000 == 0
                    -- `F0`: the code point is at least `0x10000` with nothing above its low eighteen bits, so its next six are at least `0x10`.
                    | true =>
                        match c.code / 0x40000 == 4
                        | true =>
                            match Eq/subst(
                                (k: Nat) => Bool/Holds(k == 4),
                                Nat/eq_of_eql(c.code / 0x40000, 0, Bool/True/qed()),
                                Bool/True/qed())
                            end
                        | false =>
                            match c.code % 0x40000 / 0x1000 >= 0x10
                            | true => Bool/True/qed()
                            | false =>
                                let low: Nat/Le(0x10000, c.code % 0x40000) =
                                    Eq/subst(
                                        (k: Nat) => Nat/Le(0x10000, k * 0x40000 + c.code % 0x40000),
                                        Nat/eq_of_eql(c.code / 0x40000, 0, Bool/True/qed()),
                                        Bool/True/qed());
                                match Nat/Lt/lt_of_lt_le(
                                    c.code % 0x40000 / 0x1000,
                                    0x10,
                                    c.code % 0x40000 / 0x1000,
                                    Bool/True/qed(),
                                    Nat/div_mod/le_div_of_mul_le(
                                        0x10,
                                        c.code % 0x40000,
                                        0x1000,
                                        low))
                                end
                            end
                        end
                    | false =>
                        match c.code / 0x40000 == 4
                        -- `F4`: the code point is at most `U+10FFFF`, so its next six bits are at most `0xF`.
                        | true =>
                            match c.code % 0x40000 / 0x1000 <= 0xF
                            | true => Bool/True/qed()
                            | false =>
                                let high: Nat/Le(4 * 0x40000 + c.code % 0x40000, 0x10FFFF) =
                                    Eq/subst(
                                        (k: Nat) =>
                                            Nat/Le(k * 0x40000 + c.code % 0x40000, 0x10FFFF),
                                        Nat/eq_of_eql(c.code / 0x40000, 4, Bool/True/qed()),
                                        top);
                                match Nat/Lt/lt_of_le_lt(
                                    0x10,
                                    c.code % 0x40000 / 0x1000,
                                    0x10,
                                    Nat/Lt/le_succ_of_lt(
                                        0xF,
                                        c.code % 0x40000 / 0x1000,
                                        Bool/True/qed()),
                                    Nat/div_mod/div_lt_of_lt_mul(
                                        0x10,
                                        c.code % 0x40000,
                                        0x1000,
                                        Nat/Lt/lt_of_le_lt(
                                            c.code % 0x40000,
                                            0xFFFF,
                                            0x10000,
                                            high,
                                            Bool/True/qed())))
                                end
                            end
                        | false => Bool/True/qed()
                        end
                    end
                end
            end
        end
    end;
