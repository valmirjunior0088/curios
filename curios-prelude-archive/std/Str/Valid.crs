use /std/Str/{Class, classify, Scan, step, scan_from, Valid, drop_width, drop_width_within,
    take_continuations, certify_decoded};
use /std/{Bool, Byte, Bytes, Char, Eq, False, Nat, Option, True};

--- Whether a scan has come to rest between characters.
let at_lead(s: Scan) -> Bool =
    match s | lead() => true | _ => false end;

--- That `b`, read from the scan state `s`, lands back between characters: `Valid` from any state.
---
--- Decided, so it has no constructors to walk. A proof walks the bytes instead: `from(s, x[c, ..t])` *is* `from(step(c, s), t)`, so the evidence for the whole is already the evidence for the tail. A recursive call writes the tail it moves to, as `@t`, since inferring it from the evidence would take the whole.
pub let from(s: Scan, b: Bytes) -> Prop =
    Bool/Holds(at_lead(scan_from(s, b)));

--- A scan at rest is at `lead`.
let lead_of(s: Scan, h: Bool/Holds(at_lead(s))) -> Eq(s, Scan/lead()) =
    match s
    | lead() => Eq/refl()
    | cont(_, _, _) => match h end
    | bad() => match h end
    end;

--- Reading a concatenation is reading its halves in turn.
let append(
    s: Scan,
    a: Bytes,
    b: Bytes,
) -> Eq(scan_from(s, x[..a, ..b]), scan_from(scan_from(s, a), b)) =
    match a | x[] => Eq/refl() | x[h, ..t] => append(step(h, s), t, b) end;

--- The procedure that decides whether `b` is well-formed from `s`: the evidence when it is, `none` otherwise.
pub let try(s: Scan, b: Bytes) -> Option(from(s, b)) =
    match at_lead(scan_from(s, b)): (r) => Option(Bool/Holds(r))
    | true => Option/some(True/qed())
    | false => Option/none()
    end;

--- Valid bytes concatenate to valid bytes.
pub let concat(@a: Bytes, @b: Bytes, va: Valid(a), vb: Valid(b)) -> Valid(x[..a, ..b]) =
    Eq/subst(
        (sc: Scan) => Bool/Holds(at_lead(sc)),
        Eq/sym(
            Eq/trans(
                append(Scan/lead(), a, b),
                Eq/cong((sc: Scan) => scan_from(sc, b), lead_of(scan_from(Scan/lead(), a), va)))),
        vb);

--- Validity carried past the first `n` characters.
pub let drop(
    n: Nat,
    s: Scan,
    @b: Bytes,
    d: from(s, b),
) -> Valid(Bytes/drop(b, drop_width(n, s, b), @drop_width_within(n, s, b))) =
    match b
    | x[] =>
        match s
        | lead() => True/qed()
        | cont(_, _, _) => match d end
        | bad() => match d end
        end
    | x[c, ..t] =>
        match s
        | lead() => match n | 0 => d | pred + 1 => drop(pred, step(c, Scan/lead()), @t, d) end
        | cont(_, _, _) => drop(n, step(c, s), @t, d)
        | bad() => drop(n, step(c, Scan/bad()), @t, d)
        end
    end;

--- Validity carried onto the first `n` characters.
pub let take(
    n: Nat,
    s: Scan,
    @b: Bytes,
    d: from(s, b),
) -> from(s, Bytes/slice(b, 0, drop_width(n, s, b), @drop_width_within(n, s, b))) =
    match b
    | x[] => d
    | x[c, ..t] =>
        match s
        | lead() =>
            match n | 0 => True/qed() | pred + 1 => take(pred, step(c, Scan/lead()), @t, d) end
        | cont(_, _, _) => take(n, step(c, s), @t, d)
        | bad() => take(n, step(c, Scan/bad()), @t, d)
        end
    end;

--- Nothing is valid from the bad state.
pub let from_bad(@x: Bytes, w: from(Scan/bad(), x)) -> False =
    match x
    | x[] => match w end
    | x[_, ..t] => from_bad(@t, w)
    end;

--- Inside a character, at least the continuation bytes it still owes follow.
pub let cont_len(
    k: Nat,
    @lo: Nat,
    @hi: Nat,
    @t: Bytes,
    w: from(Scan/cont(k, lo, hi), t),
) -> Nat/Le/Ind(k, Bytes/len(t)) =
    match k
    | 0 => Nat/Le/Ind/z()
    | kp + 1 =>
        match t
        | x[] => match w end
        | x[c, ..rest] =>
            match kp
            | 0 => Nat/Le/Ind/s(Nat/Le/Ind/z())
            | kpp + 1 =>
                Nat/Le/Ind/s(
                    match Nat/in_range(Byte/to_nat(c), lo, hi)
                    | true => cont_len(kpp + 1, @0x80, @0xBF, @rest, w)
                    | false => match from_bad(@rest, w) end
                    end)
            end
        end
    end;

let scan_of_class(cl: Class) -> Scan =
    match cl
    | ascii() => Scan/lead()
    | lead(count, lo, hi, _) => Scan/cont(count, lo, hi)
    | bad() => Scan/bad()
    end;

let step_scans(c: Byte) -> Eq(step(c, Scan/lead()), scan_of_class(classify(c))) =
    Eq/refl();

--- The code point of the first character, as a number.
let decode_head_raw(c: Byte, @t: Bytes, w: from(Scan/lead(), x[c, ..t])) -> Nat =
    let rest = Eq/subst((sc: Scan) => from(sc, t), step_scans(c), w);
    (match classify(c): (cl) => (w2: from(scan_of_class(cl), t)) -> Nat
    | ascii() => (_) => Byte/to_nat(c)
    | lead(k, _, _, payload) => (w2) => take_continuations(t, 0, k, payload, cont_len(k, w2)).0
    | bad() => (w2) => match from_bad(w2) end
    end)(rest);

--- The first character of bytes valid from the first byte.
pub let decode_head(c: Byte, @t: Bytes, w: from(Scan/lead(), x[c, ..t])) -> Char =
    certify_decoded(decode_head_raw(c, w));
