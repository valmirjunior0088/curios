use /syn/Str/{Class, classify, Scan, step, Utf8, Valid};
use /syn/{True, False};
use /std/{Char, Nat, Byte, Bytes, Eq, Option};

let seq(@s: Scan, @a: Bytes, @b: Bytes, va: Utf8(s, a), vb: Valid(b)) -> Utf8(s, x[..a, ..b]) =
    match va: (q, x, _w) => Utf8(q, x[..x, ..b])
    | stop() => vb
    | more(c, st, t, rest) => Utf8/more(c, st, x[..t, ..b], seq(rest, vb))
    end;

-- | Valid bytes concatenate to valid bytes.
pub let concat_closed(@a: Bytes, @b: Bytes, va: Valid(a), vb: Valid(b)) -> Valid(x[..a, ..b]) =
    seq(va, vb);

-- | The procedure that decides whether `b` scans from `s`: the witness when it does, `none` otherwise.
pub let check(s: Scan, b: Bytes) -> Option(Utf8(s, b)) =
    match b
    | x[] =>
        match s
        | lead() => Option/some(Utf8/stop())
        | cont(_rem, _lo, _hi) => Option/none()
        | bad() => Option/none()
        end
    | x[h, ..t] =>
        match check(step(h, s), t)
        | some(rest) => Option/some(Utf8/more(h, s, t, rest))
        | none() => Option/none()
        end
    end;

-- | How many bytes the first `n` characters take from scan state `s`.
pub let drop_width(n: Nat, s: Scan, b: Bytes) -> Nat =
    match b
    | x[] => 0
    | x[h, ..t] =>
        match s
        | lead() => match n | 0 => 0 | pred + 1 => 1 + drop_width(pred, step(h, Scan/lead()), t) end
        | cont(_rem, _lo, _hi) => 1 + drop_width(n, step(h, s), t)
        | bad() => 1 + drop_width(n, step(h, Scan/bad()), t)
        end
    end;

-- | `drop_width` never passes the end.
pub let drop_width_within(n: Nat, s: Scan, b: Bytes) -> Nat/Le(drop_width(n, s, b), Bytes/len(b)) =
    match b: (v) => Nat/Le(drop_width(n, s, v), Bytes/len(v))
    | x[] => True/qed()
    | x[h, ..t] =>
        match s
        | lead() =>
            match n
            | 0 => True/qed()
            | pred + 1 => drop_width_within(pred, step(h, Scan/lead()), t)
            end
        | cont(_rem, _lo, _hi) => drop_width_within(n, step(h, s), t)
        | bad() => drop_width_within(n, step(h, Scan/bad()), t)
        end
    end;

-- | The witness carried past the first `n` characters.
pub let drop_valid(
    n: Nat,
    s: Scan,
    @b: Bytes,
    d: Utf8(s, b),
) -> Valid(Bytes/drop(b, drop_width(n, s, b), @drop_width_within(n, s, b))) =
    match s
    | lead() =>
        match d
        | stop() => Utf8/stop()
        | more(c, _st, t, rest) =>
            match n
            | 0 => Utf8/more(c, Scan/lead(), t, rest)
            | pred + 1 => drop_valid(pred, step(c, Scan/lead()), rest)
            end
        end
    | cont(_rem, _lo, _hi) =>
        match d | more(c, _st, _t, rest) => drop_valid(n, step(c, s), rest) end
    | bad() => match d | more(c, _st, _t, rest) => drop_valid(n, step(c, Scan/bad()), rest) end
    end;

-- | The witness carried onto the first `n` characters.
pub let take_valid(
    n: Nat,
    s: Scan,
    @b: Bytes,
    d: Utf8(s, b),
) -> Utf8(s, Bytes/slice(b, 0, drop_width(n, s, b), @drop_width_within(n, s, b))) =
    match s
    | lead() =>
        match d
        | stop() => Utf8/stop()
        | more(c, _st, t, rest) =>
            match n
            | 0 => Utf8/stop()
            | pred + 1 =>
                Utf8/more(
                    c,
                    Scan/lead(),
                    Bytes/slice(
                        t,
                        0,
                        drop_width(pred, step(c, Scan/lead()), t),
                        @drop_width_within(pred, step(c, Scan/lead()), t)),
                    take_valid(pred, step(c, Scan/lead()), rest))
            end
        end
    | cont(rem, lo, hi) =>
        match d
        | more(c, _st, t, rest) =>
            Utf8/more(
                c,
                Scan/cont(rem, lo, hi),
                Bytes/slice(
                    t,
                    0,
                    drop_width(n, step(c, s), t),
                    @drop_width_within(n, step(c, s), t)),
                take_valid(n, step(c, s), rest))
        end
    | bad() =>
        match d
        | more(c, _st, t, rest) =>
            Utf8/more(
                c,
                Scan/bad(),
                Bytes/slice(
                    t,
                    0,
                    drop_width(n, step(c, Scan/bad()), t),
                    @drop_width_within(n, step(c, Scan/bad()), t)),
                take_valid(n, step(c, Scan/bad()), rest))
        end
    end;

-- | Nothing scans from the bad state.
pub let bad_uninhabited(@x: Bytes, w: Utf8(Scan/bad(), x)) -> False =
    match w | more(_c, _st, _t, rest) => bad_uninhabited(rest) end;

-- | Inside a sequence, at least the remaining continuation bytes follow.
pub let cont_len(
    k: Nat,
    @lo: Nat,
    @hi: Nat,
    @t: Bytes,
    w: Utf8(Scan/cont(k, lo, hi), t),
) -> Nat/Le/Ind(k, Bytes/len(t)) =
    match k
    | 0 => Nat/Le/Ind/z()
    | kp + 1 =>
        match w
        | more(c, _st, _tt, rest) =>
            match kp
            | 0 => Nat/Le/Ind/s(Nat/Le/Ind/z())
            | kpp + 1 =>
                Nat/Le/Ind/s(
                    match Nat/in_range(Byte/to_nat(c), lo, hi)
                    | true => cont_len(kpp + 1, rest)
                    | false => match bad_uninhabited(rest) end
                    end)
            end
        end
    end;

-- | A sequence never waits on zero continuation bytes.
pub let cont0_uninhabited(
    @lo: Nat,
    @hi: Nat,
    @t: Bytes,
    w: Utf8(Scan/cont(0, lo, hi), t),
) -> False =
    match w
    | more(c, _st, _t2, rest) =>
        match Nat/in_range(Byte/to_nat(c), lo, hi)
        | true => cont0_uninhabited(rest)
        | false => bad_uninhabited(rest)
        end
    end;

-- | The continuation bytes from `off`, folded into `acc`.
pub let take_continuations(
    b: Bytes,
    off: Nat,
    remaining: Nat,
    acc: Nat,
    bound: Nat/Le/Ind(off + remaining, Bytes/len(b)),
) -> {Nat, Nat} =
    match remaining
    | 0 => (acc, off)
    | pred + 1 =>
        take_continuations(
            b,
            off + 1,
            pred,
            acc * 0x40
                + (Byte/to_nat(
                    Bytes/get(
                        b,
                        off,
                        @Nat/Lt/of_ind_succ(
                            Nat/Le/Ind/trans(Nat/Le/Ind/s(Nat/Le/Ind/add_r(off, pred)), bound))))
                    - 0x80),
            bound)
    end;

-- | The witness advanced past the first byte.
pub let peel_byte(
    @s: Scan,
    @b: Bytes,
    nz: Nat/Lt(0, Bytes/len(b)),
    w: Utf8(s, b),
) -> Utf8(step(Bytes/get(b, 0, @nz), s), Bytes/drop(b, 1, @Nat/Lt/le_one_of_positive(nz))) =
    match w
    | stop() => match nz end
    | more(_c, _st, _t, rest) => rest
    end;

-- | How many characters `b` holds from scan state `s`.
pub let count_scalars(s: Scan, b: Bytes) -> Nat =
    match b
    | x[] => 0
    | x[h, ..t] =>
        match s
        | lead() => count_scalars(step(h, Scan/lead()), t) + 1
        | cont(_rem, _lo, _hi) => count_scalars(step(h, s), t)
        | bad() => count_scalars(step(h, Scan/bad()), t)
        end
    end;

let scan_of_class(cl: Class) -> Scan =
    match cl
    | ascii() => Scan/lead()
    | lead(count, lo, hi, _) => Scan/cont(count, lo, hi)
    | bad() => Scan/bad()
    end;

let step_scans(c: Byte) -> Eq(step(c, Scan/lead()), scan_of_class(classify(c))) =
    Eq/refl();

-- | The code point of the first character, as a number.
pub let decode_head_raw(c: Byte, @t: Bytes, w: Utf8(Scan/lead(), x[c, ..t])) -> Nat =
    let peeled = Eq/subst((sc: Scan) => Utf8(sc, t), step_scans(c), peel_byte(True/qed(), w));
    (match classify(c): (cl) => (w2: Utf8(scan_of_class(cl), t)) -> Nat
    | ascii() => (_w2) => Byte/to_nat(c)
    | lead(k, _lo, _hi, payload) => (w2) => take_continuations(t, 0, k, payload, cont_len(k, w2)).0
    | bad() => (w2) => match bad_uninhabited(w2) end
    end)(peeled);

-- | A decoded code point as a character.
pub let certify_decoded(code: Nat) -> Char =
    Option/unwrap_or(Char/of_nat(code), '?');

-- | The first character.
pub let decode_head(c: Byte, @t: Bytes, w: Utf8(Scan/lead(), x[c, ..t])) -> Char =
    certify_decoded(decode_head_raw(c, w));
