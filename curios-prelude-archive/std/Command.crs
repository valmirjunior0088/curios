use /std/{Bytes, Nat, Str, List, Option, Result, Path, Try, Io, Async, stream};

-- | How a child's standard stream is wired.
pub mod Stdio;
pub use Stdio/{let Stdio};

-- | A running child process.
pub mod Child;
pub use Child/{let Child};

-- | A program to run, and how to run it.
pub struct Command: pub Type {
    program: Str,
    args: List(Str),
    -- | The working directory, or the parent's.
    cwd: Option(Path),
    -- | Entries laid over the inherited environment.
    env: List({Str, Str}),
    stdin: Stdio,
    stdout: Stdio,
    stderr: Stdio,
}

-- | `program` with `args`, inheriting the working directory, the environment and every stream.
pub let new(program: Str, args: List(Str)) -> Command =
    Command {
        program = program,
        args = args,
        cwd = Option/none(),
        env = [],
        stdin = Stdio/inherit(),
        stdout = Stdio/inherit(),
        stderr = Stdio/inherit(),
    };

let stdio_of(s: Stdio) -> Nat =
    match s
    | inherit() => /sys/stdio_mode/inherit
    | piped() => /sys/stdio_mode/pipe
    | null() => /sys/stdio_mode/null
    end;

let env_entry(entry: {Str, Str}) -> Bytes =
    x[..Str/to_bytes(entry.0), '=', ..Str/to_bytes(entry.1)];

let pipe(child: /sys/Handle, which: Nat, mode: Stdio) -> Try(Io, Io/Error, Option(/sys/Handle)) =
    match mode
    | piped() =>
        let s = /sys/proc/stream(child, which)!;
        match Io/Error/of(s.status)
        | some(e) => Try/raise(e)
        | none() => Try/pure(Option/some(s.handle))
        end
    | _ => Try/pure(Option/none())
    end;

-- | Start `cmd`. Nothing guards the child: `Child/with` is the bracket that kills it when the task around it ends.
pub let spawn(cmd: Command) -> Try(Io, Io/Error, Child) =
    let r =
        /sys/proc/spawn(
            [Str/to_bytes(cmd.program), ..List/map(cmd.args, Str/to_bytes)],
            match cmd.cwd | some(p) => Path/to_bytes(p) | none() => x[] end,
            List/map(cmd.env, env_entry),
            stdio_of(cmd.stdin),
            stdio_of(cmd.stdout),
            stdio_of(cmd.stderr))!;
    match Io/Error/of(r.status)
    | some(e) => Try/raise(e)
    | none() =>
        let stdin = pipe(r.child, 0, cmd.stdin)!;
        let stdout = pipe(r.child, 1, cmd.stdout)!;
        let stderr = pipe(r.child, 2, cmd.stderr)!;
        Try/pure(Child/new(r.child, stdin, stdout, stderr))
    end;

let drain(p: Option(Child/Pipe)) -> Async(Result(Io/Error, Bytes)) =
    match p | some(p) => stream/read_all(p) | none() => Async/pure(Result/success(x[])) end;

let capture(
    child: Child,
) -> Try(Async, Io/Error, {exit: Child/Exit, stdout: Bytes, stderr: Bytes}) =
    let out = Async/spawn(drain(Child/stdout(child)))!;
    let err = Async/spawn(drain(Child/stderr(child)))!;
    let o = Async/join(out)!;
    let e = Async/join(err)!;
    let stdout = o!;
    let stderr = e!;
    let exit = Child/wait(child)!;
    Try/pure((exit = exit, stdout = stdout, stderr = stderr));

-- | `cmd` run to its end with both outputs captured, and how it ended.
pub let run(
    cmd: Command,
) -> Try(Async, Io/Error, {exit: Child/Exit, stdout: Bytes, stderr: Bytes}) =
    let child = spawn(Command { ..cmd, stdout = Stdio/piped(), stderr = Stdio/piped() })!;
    Child/with(child, capture(child));

-- | `cmd` run with its streams as wired, and how it ended.
pub let status(cmd: Command) -> Try(Async, Io/Error, Child/Exit) =
    let child = spawn(cmd)!;
    Child/with(child, Child/wait(child));
