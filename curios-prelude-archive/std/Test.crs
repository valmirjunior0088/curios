use /std/{Nat, Bool, Str, Bytes, List, Option, Result, Try, Io, Spell, Show, print, proc};
use /std/ops/{Eql};

-- | How a test came out.
pub induct Verdict: pub Type
-- | It held.
| passed()
-- | It did not, with what went wrong.
| failed(Str)
end

-- | A check `curios test` runs, and what a `test` declaration declares.
-- |
-- | Its representation is sealed, so one is built through the combinators below rather than by naming a constructor.
pub induct Test: Type
| verdict(Verdict)
| action(Io(Test))
end

-- | The test that holds when `condition` is true.
pub let assert(condition: Bool) -> Test =
    Test/verdict(
        match condition
        | true => Verdict/passed()
        | false => Verdict/failed("the condition was false")
        end);

-- | The test that holds when the two are equal, reporting both when they are not.
pub let equal(@A: Type, use Eql(A), use Spell(A), actual: A, expected: A) -> Test =
    match actual == expected
    | true => Test/verdict(Verdict/passed())
    | false =>
        Test/verdict(
            Verdict/failed(
                Str/concat(
                    "expected ",
                    Str/concat(
                        Spell/spell(expected),
                        Str/concat(" but got ", Spell/spell(actual))))))
    end;

-- | A test out of an effectful thunk, which is how a test reaches `Io`.
pub let perform(thunk: () -> Io(Test)) -> Test =
    Test/action(thunk());

-- | One test over many: it fails at the first that fails, naming that one's position.
pub let all(tests: List(Test)) -> Test =
    let (conjunction, _) =
        List/fold(
            tests,
            (Test/verdict(Verdict/passed()), 0),
            (t, state: {Test, Nat}) =>
                let (acc, index) = state;
                (conjoin(acc, case(index, t)), index + 1));
    conjunction;

let case(index: Nat, t: Test) -> Test =
    match t
    | verdict(v) =>
        match v
        | passed() => t
        | failed(message) =>
            Test/verdict(
                Verdict/failed(
                    Str/concat("case ", Str/concat(Nat/to_str(index), Str/concat(": ", message)))))
        end
    | action(io) =>
        perform(() =>
            let inner = io!;
            Io/pure(case(index, inner)))
    end;

let conjoin(left: Test, right: Test) -> Test =
    match left
    | verdict(v) => match v | passed() => right | failed(_) => left end
    | action(io) =>
        perform(() =>
            let inner = io!;
            Io/pure(conjoin(inner, right)))
    end;

let outcome(@E: Type, use Show(E), io: Io(Result(E, Test))) -> Io(Test) =
    let r = io!;
    Io/pure(
        match r | success(t) => t | failure(e) => Test/verdict(Verdict/failed(Show/show(e))) end);

-- | A test out of a thunk that may fail, reporting the error when it does.
pub let try(@E: Type, use Show(E), thunk: () -> Try(Io, E, Test)) -> Test =
    Test/action(outcome(Try/run(thunk())));

let report(name: Str, t: Test) -> Io(Bool) =
    match t
    | verdict(v) =>
        match v
        | passed() =>
            let _ = print(Str/concat(name, ": passed\n"))!;
            Io/pure(true)
        | failed(message) =>
            let _ = print(Str/concat(name, Str/concat(": failed\n  ", Str/concat(message, "\n"))))!;
            Io/pure(false)
        end
    | action(io) =>
        let inner = io!;
        report(name, inner)
    end;

let parse_index(raw: Bytes) -> Option(Nat) =
    match Str/of_bytes(raw) | some(s) => Nat/of_str(s) | none() => Option/none() end;

let run_all(tests: List({Str, () -> Test})) -> Io(Bool) =
    List/fold(
        tests,
        Io/pure(true),
        ((name, body), acc) =>
            let earlier = acc!;
            let here = report(name, body())!;
            Io/pure(earlier && here));

-- | The tail `curios test` runs: it performs each named test and reports what each came to.
pub let main(tests: List({Str, () -> Test})) -> Io({}) =
    let arguments = proc/args!;
    match List/try_get(arguments, 1)
    | some(raw) =>
        match parse_index(raw)
        | some(index) =>
            match List/try_get(tests, index)
            | some((name, body)) =>
                let ok = report(name, body())!;
                match ok | true => Io/pure(()) | false => proc/exit(1) end
            | none() => proc/exit(1)
            end
        | none() => proc/exit(1)
        end
    | none() =>
        let ok = run_all(tests)!;
        match ok | true => Io/pure(()) | false => proc/exit(1) end
    end;
