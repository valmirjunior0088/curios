pub use /syn/Test/{let Test, Verdict, prove, refl, check, equal, perform, main};

-- The property-testing library, under the one name everything testing-shaped is found by: `Test/Seed` the pure splittable generator, `Test/Draw` what an argument is drawn from. Each is re-exported as a value too, so the path names the module and the type at once.
pub mod Seed;

pub mod Draw;
pub use Seed/{let Seed};
pub use Draw/{let Draw};
