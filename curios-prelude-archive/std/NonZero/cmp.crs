-- Comparison of strictly-positive naturals. Every law is a one-line delegation: the magnitudes decide the order, and `NonZero/eq` lifts a magnitude equality back to the record, since the certificate is proof-irrelevant.
use /std/{Order, Eq, BigNat, NonZero};
use /std/Order/{cong_flip};

pub let cmp(p: NonZero, q: NonZero) -> Order =
    BigNat/cmp/cmp(p.magnitude, q.magnitude);

pub let refl(p: NonZero) -> Eq(cmp(p, p), Order/eq()) =
    BigNat/cmp/refl(p.magnitude);

pub let to_eq(p: NonZero, q: NonZero, w: Eq(cmp(p, q), Order/eq())) -> Eq(p, q) =
    NonZero/eq(p, q, BigNat/cmp/to_eq(p.magnitude, q.magnitude, w));

pub let flip(p: NonZero, q: NonZero) -> Eq(cmp(q, p), Order/flip(cmp(p, q))) =
    BigNat/cmp/flip(p.magnitude, q.magnitude);

pub let trans(
    p: NonZero,
    q: NonZero,
    r: NonZero,
    u: Eq(cmp(p, q), Order/lt()),
    v: Eq(cmp(q, r), Order/lt()),
) -> Eq(cmp(p, r), Order/lt()) =
    BigNat/cmp/trans(p.magnitude, q.magnitude, r.magnitude, u, v);

pub let gt_to_lt(
    p: NonZero,
    q: NonZero,
    w: Eq(cmp(p, q), Order/gt()),
) -> Eq(cmp(q, p), Order/lt()) =
    Eq/trans(flip(p, q), cong_flip(w));
