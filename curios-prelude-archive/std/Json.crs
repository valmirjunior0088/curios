use /std/{Bool, Flt, Str, List};

-- | A JSON value.
pub induct Json: pub Type
-- | `null`.
| null()
-- | `true` or `false`.
| bool(Bool)
-- | A number.
| num(Flt)
-- | A string.
| str(Str)
-- | An array, in order.
| arr(List(Json))
-- | An object: its members, in the order they were written.
| obj(List({Str, Json}))
end

pub use Json/*;

mod encode;
pub use encode/{encode};

mod decode;
pub use decode/{decode};
