use /std/{Nat, Bool, Bits, Eq};
use /std/BigNat/{BigNat, combine, combine_cons, combine_is_trimmed, cong_combine, dbl, dbl_raw, eq,
    is_trimmed, is_trimmed_of_canonical, maj3, of_bits, of_nat, of_trimmed_bits, trim,
    trim_is_trimmed, trim_of_trimmed, xor3, add};

--- The product of two words, untrimmed.
pub let raw(x: Bits, y: Bits) -> Bits =
    match x
    | b[] => b[]
    | b[xh, ..xt] =>
        match xh | true => add/raw(y, b[0, ..raw(xt, y)], false) | false => b[0, ..raw(xt, y)] end
    end;

--- The product.
pub let mul(a: BigNat, b: BigNat) -> BigNat =
    of_bits(raw(a.bits, b.bits));

-- `k` zero bits ahead of a word's own — the fill `pow2` prepends, built as one run rather than `k` of them. Zero stays zero: a fill ahead of no bits is redundant high zeros, which is not a trimmed word.
let spread(k: Nat, bits: Bits) -> Bits =
    match bits | b[] => b[] | b[_, .._] => b[..Bits/replicate(k, false), ..bits] end;

-- No places is the word itself.
let spread_zero(bits: Bits) -> Eq(spread(0, bits), bits) =
    match bits | b[] => Eq/refl() | b[_, .._] => Eq/refl() end;

-- One more place is one more doubling — the step the `dbl` spine gave by definition and the flat fill has to state.
--
-- The nonempty arm is where the fill's own opacity is paid for: `combine` cannot see that a run led by a symbolic fill is a cons, so the equation comes from [`combine_cons`] and the length that discharges it, rather than from the match reducing.
let spread_succ(k: Nat, bits: Bits) -> Eq(spread(k + 1, bits), combine(false, spread(k, bits))) =
    match bits
    | b[] => Eq/refl()
    | b[h, ..t] => Eq/sym(combine_cons(false, spread(k, b[h, ..t]), Bool/True/qed()))
    end;

-- Zeros ahead of a trimmed word leave its high bit where it was, so it stays trimmed.
let spread_is_trimmed(
    k: Nat,
    bits: Bits,
    p: Eq(is_trimmed(bits), true),
) -> Eq(is_trimmed(spread(k, bits)), true) =
    match k
    | 0 => Eq/subst((w) => Eq(is_trimmed(w), true), Eq/sym(spread_zero(bits)), p)
    | pred + 1; ih =>
        Eq/subst(
            (w) => Eq(is_trimmed(w), true),
            Eq/sym(spread_succ(pred, bits)),
            combine_is_trimmed(false, spread(pred, bits), ih))
    end;

--- `a` times two to the `k`.
---
--- One run of `k` zero bits ahead of the word rather than `k` doublings of it. The spine this replaced allocated a word per place, which over `Flt`'s exponent range is a thousand of them for one conversion; the laws below still induct on `k`, and each step names [`pow2_succ`] where it used to reduce to a `dbl` by definition.
pub let pow2(a: BigNat, k: Nat) -> BigNat =
    of_trimmed_bits(
        spread(k, a.bits),
        spread_is_trimmed(k, a.bits, is_trimmed_of_canonical(a.bits, a.canonical)));

-- The two equations the spine gave for nothing, which every law below now names instead.
let pow2_zero(a: BigNat) -> Eq(pow2(a, 0), a) =
    eq(pow2(a, 0), a, spread_zero(a.bits));

let pow2_succ(a: BigNat, k: Nat) -> Eq(pow2(a, k + 1), dbl(pow2(a, k))) =
    eq(pow2(a, k + 1), dbl(pow2(a, k)), spread_succ(k, a.bits));

-- Congruence over both summands at once, which the laws below take where a one-sided `Eq/cong` would need two steps each.
let cong_add(
    @s: BigNat,
    @t: BigNat,
    @u: BigNat,
    @v: BigNat,
    p: Eq(s, t),
    q: Eq(u, v),
) -> Eq(add(s, u), add(t, v)) =
    Eq/trans(Eq/cong((x) => add(x, u), p), Eq/cong((y) => add(t, y), q));

--- `a` times the machine natural `c`.
pub let small(a: BigNat, c: Nat) -> BigNat =
    mul(a, of_nat(c));

let cong_trim(@s: Bits, @t: Bits, p: Eq(s, t)) -> Eq(trim(s), trim(t)) =
    Eq/cong(trim, p);

let of_bits_eq(u: Bits, v: Bits, p: Eq(trim(u), trim(v))) -> Eq(of_bits(u), of_bits(v)) =
    eq(of_bits(u), of_bits(v), p);

let add_combine_l(
    h: Bool,
    w: Bits,
    v: Bits,
    c: Bool,
) -> Eq(trim(add/raw(combine(h, w), v, c)), trim(add/raw(b[h, ..w], v, c))) =
    match w
    | b[] =>
        match h
        | true => Eq/refl()
        | false =>
            match v
            | b[] => match c | true => Eq/refl() | false => Eq/refl() end
            | b[_, .._] => Eq/refl()
            end
        end
    | b[_, .._] => Eq/refl()
    end;

let trim_add_raw_trim_l(
    u: Bits,
    v: Bits,
    c: Bool,
) -> Eq(trim(add/raw(trim(u), v, c)), trim(add/raw(u, v, c))) =
    match u
    | b[] => Eq/refl()
    | b[uh, ..ut] =>
        match v
        | b[] =>
            Eq/trans(
                add_combine_l(uh, trim(ut), b[], c),
                cong_combine(xor3(uh, false, c), trim_add_raw_trim_l(ut, b[], maj3(uh, false, c))))
        | b[vh, ..vt] =>
            Eq/trans(
                add_combine_l(uh, trim(ut), b[vh, ..vt], c),
                cong_combine(xor3(uh, vh, c), trim_add_raw_trim_l(ut, vt, maj3(uh, vh, c))))
        end
    end;

let trim_add_raw_trim_r(
    u: Bits,
    v: Bits,
    c: Bool,
) -> Eq(trim(add/raw(u, trim(v), c)), trim(add/raw(u, v, c))) =
    Eq/trans(
        cong_trim(add/raw_comm(u, trim(v), c)),
        Eq/trans(trim_add_raw_trim_l(v, u, c), cong_trim(add/raw_comm(v, u, c))));

let combine_l(
    h: Bool,
    w: Bits,
    v: Bits,
) -> Eq(trim(raw(combine(h, w), v)), trim(raw(b[h, ..w], v))) =
    match w
    | b[] => match h | true => Eq/refl() | false => Eq/refl() end
    | b[_, .._] => Eq/refl()
    end;

let trim_raw_trim_l(u: Bits, v: Bits) -> Eq(trim(raw(trim(u), v)), trim(raw(u, v))) =
    match u
    | b[] => Eq/refl()
    | b[uh, ..ut] =>
        match uh
        | true =>
            Eq/trans(
                combine_l(true, trim(ut), v),
                Eq/trans(
                    Eq/sym(trim_add_raw_trim_r(v, b[0, ..raw(trim(ut), v)], false)),
                    Eq/trans(
                        cong_trim(
                            add/cong_raw_r(v, cong_combine(false, trim_raw_trim_l(ut, v)), false)),
                        trim_add_raw_trim_r(v, b[0, ..raw(ut, v)], false))))
        | false =>
            Eq/trans(combine_l(false, trim(ut), v), cong_combine(false, trim_raw_trim_l(ut, v)))
        end
    end;

let trim_raw_trim_r(u: Bits, v: Bits) -> Eq(trim(raw(u, trim(v))), trim(raw(u, v))) =
    match u
    | b[] => Eq/refl()
    | b[uh, ..ut] =>
        match uh
        | true =>
            Eq/trans(
                trim_add_raw_trim_l(v, b[0, ..raw(ut, trim(v))], false),
                Eq/trans(
                    Eq/sym(trim_add_raw_trim_r(v, b[0, ..raw(ut, trim(v))], false)),
                    Eq/trans(
                        cong_trim(
                            add/cong_raw_r(v, cong_combine(false, trim_raw_trim_r(ut, v)), false)),
                        trim_add_raw_trim_r(v, b[0, ..raw(ut, v)], false))))
        | false => cong_combine(false, trim_raw_trim_r(ut, v))
        end
    end;

let trim_cons_cong(
    h: Bool,
    @s: Bits,
    @t: Bits,
    p: Eq(trim(s), trim(t)),
) -> Eq(trim(b[h, ..s]), trim(b[h, ..t])) =
    cong_combine(h, p);

let trim_add_raw_l_cong(
    @s: Bits,
    @t: Bits,
    p: Eq(trim(s), trim(t)),
    v: Bits,
    c: Bool,
) -> Eq(trim(add/raw(s, v, c)), trim(add/raw(t, v, c))) =
    Eq/trans(
        Eq/sym(trim_add_raw_trim_l(s, v, c)),
        Eq/trans(cong_trim(add/cong_raw_l(p, v, c)), trim_add_raw_trim_l(t, v, c)));

let trim_add_raw_r_cong(
    u: Bits,
    @s: Bits,
    @t: Bits,
    p: Eq(trim(s), trim(t)),
    c: Bool,
) -> Eq(trim(add/raw(u, s, c)), trim(add/raw(u, t, c))) =
    Eq/trans(
        Eq/sym(trim_add_raw_trim_r(u, s, c)),
        Eq/trans(cong_trim(add/cong_raw_r(u, p, c)), trim_add_raw_trim_r(u, t, c)));

let trim_zero_r(y: Bits) -> Eq(trim(raw(y, b[])), b[]) =
    match y
    | b[] => Eq/refl()
    | b[yh, ..yt] =>
        match yh
        | true =>
            Eq/trans(
                cong_trim(add/raw_zero_l(b[0, ..raw(yt, b[])])),
                cong_combine(false, trim_zero_r(yt)))
        | false => cong_combine(false, trim_zero_r(yt))
        end
    end;

--- Multiplying by one trims to the same word.
pub let trim_one_r(x: Bits) -> Eq(trim(raw(x, b[1])), trim(x)) =
    match x
    | b[] => Eq/refl()
    | b[xh, ..xt] =>
        match xh
        | true =>
            cong_combine(true, Eq/trans(cong_trim(add/raw_zero_l(raw(xt, b[1]))), trim_one_r(xt)))
        | false => cong_combine(false, trim_one_r(xt))
        end
    end;

--- A zero low bit on the right shifts the product.
pub let trim_bit0_r(x: Bits, y: Bits) -> Eq(trim(raw(x, b[0, ..y])), trim(b[0, ..raw(x, y)])) =
    match x
    | b[] => Eq/refl()
    | b[xh, ..xt] =>
        match xh
        | true => cong_combine(false, trim_add_raw_r_cong(y, trim_bit0_r(xt, y), false))
        | false => cong_combine(false, trim_bit0_r(xt, y))
        end
    end;

--- A one low bit on the right adds the left operand to the shifted product.
pub let trim_bit1_r(
    x: Bits,
    y: Bits,
) -> Eq(trim(raw(x, b[1, ..y])), trim(add/raw(x, b[0, ..raw(x, y)], false))) =
    match x
    | b[] => Eq/sym(cong_trim(add/raw_zero_l(b[0])))
    | b[xh, ..xt] =>
        match xh
        | true =>
            cong_combine(
                true,
                Eq/trans(
                    trim_add_raw_r_cong(y, trim_bit1_r(xt, y), false),
                    cong_trim(
                        Eq/trans(
                            Eq/sym(add/raw_assoc(y, xt, b[0, ..raw(xt, y)], false, false)),
                            Eq/trans(
                                add/cong_raw_l(
                                    add/raw_comm(y, xt, false),
                                    b[0, ..raw(xt, y)],
                                    false),
                                add/raw_assoc(xt, y, b[0, ..raw(xt, y)], false, false))))))
        | false => cong_combine(false, trim_bit1_r(xt, y))
        end
    end;

--- `raw` is commutative up to trim.
pub let trim_comm(x: Bits, y: Bits) -> Eq(trim(raw(x, y)), trim(raw(y, x))) =
    match x
    | b[] => Eq/sym(trim_zero_r(y))
    | b[xh, ..xt] =>
        match xh
        | true =>
            Eq/trans(
                trim_add_raw_r_cong(y, trim_cons_cong(false, trim_comm(xt, y)), false),
                Eq/sym(trim_bit1_r(y, xt)))
        | false => Eq/trans(cong_combine(false, trim_comm(xt, y)), Eq/sym(trim_bit0_r(y, xt)))
        end
    end;

let add_raw_medial(
    a: Bits,
    b: Bits,
    c: Bits,
    d: Bits,
) -> Eq(
    add/raw(add/raw(a, b, false), add/raw(c, d, false), false),
    add/raw(add/raw(a, c, false), add/raw(b, d, false), false)) =
    Eq/trans(
        add/raw_assoc(a, b, add/raw(c, d, false), false, false),
        Eq/trans(
            add/cong_raw_r(a, Eq/sym(add/raw_assoc(b, c, d, false, false)), false),
            Eq/trans(
                add/cong_raw_r(a, add/cong_raw_l(add/raw_comm(b, c, false), d, false), false),
                Eq/trans(
                    add/cong_raw_r(a, add/raw_assoc(c, b, d, false, false), false),
                    Eq/sym(add/raw_assoc(a, c, add/raw(b, d, false), false, false))))));

--- Left distributivity up to trim.
pub let trim_distrib_l(
    x: Bits,
    y: Bits,
    z: Bits,
) -> Eq(trim(raw(x, add/raw(y, z, false))), trim(add/raw(raw(x, y), raw(x, z), false))) =
    match x
    | b[] => Eq/refl()
    | b[xh, ..xt] =>
        match xh
        | true =>
            Eq/trans(
                trim_add_raw_r_cong(
                    add/raw(y, z, false),
                    trim_cons_cong(false, trim_distrib_l(xt, y, z)),
                    false),
                Eq/sym(cong_trim(add_raw_medial(y, b[0, ..raw(xt, y)], z, b[0, ..raw(xt, z)]))))
        | false => cong_combine(false, trim_distrib_l(xt, y, z))
        end
    end;

--- Right distributivity up to trim.
pub let trim_distrib_r(
    x: Bits,
    y: Bits,
    z: Bits,
) -> Eq(trim(raw(add/raw(y, z, false), x)), trim(add/raw(raw(y, x), raw(z, x), false))) =
    Eq/trans(
        trim_comm(add/raw(y, z, false), x),
        Eq/trans(
            trim_distrib_l(x, y, z),
            Eq/trans(
                trim_add_raw_l_cong(trim_comm(x, y), raw(x, z), false),
                trim_add_raw_r_cong(raw(y, x), trim_comm(x, z), false))));

--- Associativity up to trim.
pub let trim_assoc(
    x: Bits,
    y: Bits,
    z: Bits,
) -> Eq(trim(raw(raw(x, y), z)), trim(raw(x, raw(y, z)))) =
    match x
    | b[] => Eq/refl()
    | b[xh, ..xt] =>
        match xh
        | true =>
            Eq/trans(
                trim_distrib_r(z, y, b[0, ..raw(xt, y)]),
                trim_add_raw_r_cong(raw(y, z), trim_cons_cong(false, trim_assoc(xt, y, z)), false))
        | false => cong_combine(false, trim_assoc(xt, y, z))
        end
    end;

--- Commutativity.
pub let comm(a: BigNat, b: BigNat) -> Eq(mul(a, b), mul(b, a)) =
    of_bits_eq(raw(a.bits, b.bits), raw(b.bits, a.bits), trim_comm(a.bits, b.bits));

--- Associativity.
pub let assoc(a: BigNat, b: BigNat, c: BigNat) -> Eq(mul(mul(a, b), c), mul(a, mul(b, c))) =
    of_bits_eq(
        raw(trim(raw(a.bits, b.bits)), c.bits),
        raw(a.bits, trim(raw(b.bits, c.bits))),
        Eq/trans(
            trim_raw_trim_l(raw(a.bits, b.bits), c.bits),
            Eq/trans(
                trim_assoc(a.bits, b.bits, c.bits),
                Eq/sym(trim_raw_trim_r(a.bits, raw(b.bits, c.bits))))));

--- Left distributivity over addition.
pub let distrib_l(
    a: BigNat,
    b: BigNat,
    c: BigNat,
) -> Eq(mul(a, add(b, c)), add(mul(a, b), mul(a, c))) =
    let raw_b = raw(a.bits, b.bits);
    let raw_c = raw(a.bits, c.bits);
    let trim_b = trim(raw_b);
    let trim_c = trim(raw_c);
    eq(
        mul(a, add(b, c)),
        add(mul(a, b), mul(a, c)),
        Eq/trans(
            trim_distrib_l(a.bits, b.bits, c.bits),
            Eq/trans(
                Eq/sym(trim_add_raw_trim_l(raw_b, raw_c, false)),
                Eq/trans(
                    Eq/sym(trim_add_raw_trim_r(trim_b, raw_c, false)),
                    trim_of_trimmed(
                        add/raw(trim_b, trim_c, false),
                        add/raw_trimmed(
                            trim_b,
                            trim_c,
                            false,
                            trim_is_trimmed(raw_b),
                            trim_is_trimmed(raw_c)))))));

--- Right distributivity over addition.
pub let distrib_r(
    a: BigNat,
    b: BigNat,
    c: BigNat,
) -> Eq(mul(add(b, c), a), add(mul(b, a), mul(c, a))) =
    let raw_b = raw(b.bits, a.bits);
    let raw_c = raw(c.bits, a.bits);
    let trim_b = trim(raw_b);
    let trim_c = trim(raw_c);
    eq(
        mul(add(b, c), a),
        add(mul(b, a), mul(c, a)),
        Eq/trans(
            trim_distrib_r(a.bits, b.bits, c.bits),
            Eq/trans(
                Eq/sym(trim_add_raw_trim_l(raw_b, raw_c, false)),
                Eq/trans(
                    Eq/sym(trim_add_raw_trim_r(trim_b, raw_c, false)),
                    trim_of_trimmed(
                        add/raw(trim_b, trim_c, false),
                        add/raw_trimmed(
                            trim_b,
                            trim_c,
                            false,
                            trim_is_trimmed(raw_b),
                            trim_is_trimmed(raw_c)))))));

let cong_dbl(@s: BigNat, @t: BigNat, p: Eq(s, t)) -> Eq(dbl(s), dbl(t)) =
    Eq/cong(dbl, p);

let trim_dbl_raw(x: BigNat) -> Eq(trim(dbl_raw(x.bits)), combine(false, x.bits)) =
    cong_combine(false, trim_of_trimmed(x.bits, is_trimmed_of_canonical(x.bits, x.canonical)));

let dbl_add_raw(
    x: Bits,
    y: Bits,
) -> Eq(
    combine(false, add/raw(x, y, false)),
    add/raw(combine(false, x), combine(false, y), false)) =
    match x
    | b[] => match y | b[] => Eq/refl() | b[_, .._] => Eq/refl() end
    | b[_, .._] => match y | b[] => Eq/refl() | b[_, .._] => Eq/refl() end
    end;

let dbl_add(a: BigNat, b: BigNat) -> Eq(dbl(add(a, b)), add(dbl(a), dbl(b))) =
    eq(dbl(add(a, b)), add(dbl(a), dbl(b)), dbl_add_raw(a.bits, b.bits));

let dbl_mul_l(a: BigNat, b: BigNat) -> Eq(dbl(mul(a, b)), mul(dbl(a), b)) =
    eq(
        dbl(mul(a, b)),
        mul(dbl(a), b),
        Eq/trans(
            Eq/sym(trim_raw_trim_l(dbl_raw(a.bits), b.bits)),
            Eq/cong((w) => trim(raw(w, b.bits)), trim_dbl_raw(a))));

--- `pow2` distributes over addition.
pub let pow2_add(
    a: BigNat,
    b: BigNat,
    k: Nat,
) -> Eq(pow2(add(a, b), k), add(pow2(a, k), pow2(b, k))) =
    match k
    | 0 => Eq/trans(pow2_zero(add(a, b)), cong_add(Eq/sym(pow2_zero(a)), Eq/sym(pow2_zero(b))))
    | pred + 1; ih =>
        Eq/trans(
            pow2_succ(add(a, b), pred),
            Eq/trans(
                cong_dbl(ih),
                Eq/trans(
                    dbl_add(pow2(a, pred), pow2(b, pred)),
                    cong_add(Eq/sym(pow2_succ(a, pred)), Eq/sym(pow2_succ(b, pred))))))
    end;

--- `pow2` of a product moves onto the left factor.
pub let pow2_mul_l(a: BigNat, b: BigNat, k: Nat) -> Eq(pow2(mul(a, b), k), mul(pow2(a, k), b)) =
    match k
    | 0 => Eq/trans(pow2_zero(mul(a, b)), Eq/cong((x) => mul(x, b), Eq/sym(pow2_zero(a))))
    | pred + 1; ih =>
        Eq/trans(
            pow2_succ(mul(a, b), pred),
            Eq/trans(
                cong_dbl(ih),
                Eq/trans(
                    dbl_mul_l(pow2(a, pred), b),
                    Eq/cong((x) => mul(x, b), Eq/sym(pow2_succ(a, pred))))))
    end;

--- Two `pow2`s compose by adding their exponents.
pub let pow2_compose(a: BigNat, j: Nat, k: Nat) -> Eq(pow2(pow2(a, j), k), pow2(a, j + k)) =
    match k
    | 0 => pow2_zero(pow2(a, j))
    | pred + 1; ih =>
        Eq/trans(
            pow2_succ(pow2(a, j), pred),
            Eq/trans(cong_dbl(ih), Eq/sym(pow2_succ(a, j + pred))))
    end;
