use /std/{Nat, Bool, Bits, Str, Ordering, Eq, False, True, Equal, Compare, Add, Subtract, Multiply,
    Show, Ordered};
use /std/Bool/{false_neq_true};
use /std/Ordering/{lt_neq_eq, gt_neq_eq, eq_neq_lt, gt_neq_lt};
use /std/BigNat/{BigNat, cong_cons2, eq};

pub let raw(x: Bits, y: Bits) -> Ordering =
    match x
    | b[] => match y | b[] => Ordering/eq() | b[_, .._] => Ordering/lt() end
    | b[xh, ..xt] =>
        match y
        | b[] => Ordering/gt()
        | b[yh, ..yt] =>
            match raw(xt, yt)
            | eq() =>
                match xh
                | true => match yh | true => Ordering/eq() | false => Ordering/gt() end
                | false => match yh | true => Ordering/lt() | false => Ordering/eq() end
                end
            | lt() => Ordering/lt()
            | gt() => Ordering/gt()
            end
        end
    end;

pub let cmp(a: BigNat, b: BigNat) -> Ordering =
    raw(a.bits, b.bits);

pub let eql(a: BigNat, b: BigNat) -> Bool =
    match cmp(a, b) | eq() => true | _ => false end;

pub let lt(a: BigNat, b: BigNat) -> Bool =
    match cmp(a, b) | lt() => true | _ => false end;

pub let le(a: BigNat, b: BigNat) -> Bool =
    match cmp(a, b) | gt() => false | _ => true end;

pub let gt(a: BigNat, b: BigNat) -> Bool =
    match cmp(a, b) | gt() => true | _ => false end;

pub let ge(a: BigNat, b: BigNat) -> Bool =
    match cmp(a, b) | lt() => false | _ => true end;

let absorb_eq(
    o: Ordering,
    p: Eq(o, Ordering/eq()),
) -> Eq(
    match o: (_) => Ordering
    | eq() => Ordering/eq()
    | lt() => Ordering/lt()
    | gt() => Ordering/gt()
    end,
    Ordering/eq()) =
    Eq/subst(
        (v: Ordering) =>
            Eq(
                match v | eq() => Ordering/eq() | lt() => Ordering/lt() | gt() => Ordering/gt() end,
                Ordering/eq()),
        Eq/sym(p),
        Eq/refl());

pub let raw_refl(x: Bits) -> Eq(raw(x, x), Ordering/eq()) =
    match x: (a) => Eq(raw(a, a), Ordering/eq())
    | b[] => Eq/refl()
    | b[h, ..t] =>
        match h
        | true => absorb_eq(raw(t, t), raw_refl(t))
        | false => absorb_eq(raw(t, t), raw_refl(t))
        end
    end;

let sub_split(
    s: Ordering,
    @E: Ordering,
    p: Eq(match s | eq() => E | lt() => Ordering/lt() | gt() => Ordering/gt() end, Ordering/eq()),
) -> Eq(s, Ordering/eq()) =
    match s: (r) => Eq(r, Ordering/eq())
    | eq() => Eq/refl()
    | lt() => match lt_neq_eq(p) end
    | gt() => match gt_neq_eq(p) end
    end;

let cong_cmp_match(
    @s: Ordering,
    @t: Ordering,
    p: Eq(s, t),
    @E: Ordering,
) -> Eq(
    match s: (_) => Ordering | eq() => E | lt() => Ordering/lt() | gt() => Ordering/gt() end,
    match t: (_) => Ordering | eq() => E | lt() => Ordering/lt() | gt() => Ordering/gt() end) =
    match p: (u, v, q) =>
        Eq(
            match u: (_) => Ordering
            | eq() => E
            | lt() => Ordering/lt()
            | gt() => Ordering/gt()
            end,
            match v: (_) => Ordering
            | eq() => E
            | lt() => Ordering/lt()
            | gt() => Ordering/gt()
            end)
    | refl(@z) => Eq/refl()
    end;

pub let raw_to_eq(x: Bits, y: Bits, p: Eq(raw(x, y), Ordering/eq())) -> Eq(x, y) =
    match x
    | b[] =>
        match y
        | b[] => Eq/refl()
        | b[_, .._] => match lt_neq_eq(p) end
        end
    | b[xh, ..xt] =>
        match y
        | b[] => match gt_neq_eq(p) end
        | b[yh, ..yt] =>
            cong_cons2(
                cmp_head_eq(xh, yh, Eq/trans(Eq/sym(cong_cmp_match(sub_split(raw(xt, yt), p))), p)),
                raw_to_eq(xt, yt, sub_split(raw(xt, yt), p)))
        end
    end
and cmp_head_eq(
    xh: Bool,
    yh: Bool,
    p: Eq(
        match xh
        | true => match yh | true => Ordering/eq() | false => Ordering/gt() end
        | false => match yh | true => Ordering/lt() | false => Ordering/eq() end
        end,
        Ordering/eq()),
) -> Eq(xh, yh) =
    match xh
    | true =>
        match yh
        | true => Eq/refl()
        | false => match gt_neq_eq(p) end
        end
    | false =>
        match yh
        | true => match lt_neq_eq(p) end
        | false => Eq/refl()
        end
    end;

let flip_heads(
    xh: Bool,
    yh: Bool,
) -> Eq(
    match yh
    | true => match xh | true => Ordering/eq() | false => Ordering/gt() end
    | false => match xh | true => Ordering/lt() | false => Ordering/eq() end
    end,
    Ordering/flip(
        match xh
        | true => match yh | true => Ordering/eq() | false => Ordering/gt() end
        | false => match yh | true => Ordering/lt() | false => Ordering/eq() end
        end)) =
    match xh
    | true => match yh | true => Eq/refl() | false => Eq/refl() end
    | false => match yh | true => Eq/refl() | false => Eq/refl() end
    end;

pub let raw_flip(x: Bits, y: Bits) -> Eq(raw(y, x), Ordering/flip(raw(x, y))) =
    match x: (a) => Eq(raw(y, a), Ordering/flip(raw(a, y)))
    | b[] =>
        match y: (b) => Eq(raw(b, b[]), Ordering/flip(raw(b[], b)))
        | b[] => Eq/refl()
        | b[_, .._] => Eq/refl()
        end
    | b[xh, ..xt] =>
        match y: (b) => Eq(raw(b, b[xh, ..xt]), Ordering/flip(raw(b[xh, ..xt], b)))
        | b[] => Eq/refl()
        | b[yh, ..yt] =>
            Eq/trans(
                cong_cmp_match(raw_flip(xt, yt)),
                match raw(xt, yt): (r) =>
                    Eq(
                        match Ordering/flip(r)
                        | eq() =>
                            match yh
                            | true => match xh | true => Ordering/eq() | false => Ordering/gt() end
                            | false => match xh | true => Ordering/lt() | false => Ordering/eq() end
                            end
                        | lt() => Ordering/lt()
                        | gt() => Ordering/gt()
                        end,
                        Ordering/flip(
                            match r
                            | eq() =>
                                match xh
                                | true =>
                                    match yh | true => Ordering/eq() | false => Ordering/gt() end
                                | false =>
                                    match yh | true => Ordering/lt() | false => Ordering/eq() end
                                end
                            | lt() => Ordering/lt()
                            | gt() => Ordering/gt()
                            end))
                | eq() => flip_heads(xh, yh)
                | lt() => Eq/refl()
                | gt() => Eq/refl()
                end)
        end
    end;

let force_lt(
    @s: Ordering,
    @E: Ordering,
    p: Eq(s, Ordering/lt()),
) -> Eq(
    match s: (_) => Ordering | eq() => E | lt() => Ordering/lt() | gt() => Ordering/gt() end,
    Ordering/lt()) =
    Eq/subst(
        (v: Ordering) =>
            Eq(
                match v | eq() => E | lt() => Ordering/lt() | gt() => Ordering/gt() end,
                Ordering/lt()),
        Eq/sym(p),
        Eq/refl());

let head_lt_yh(
    xh: Bool,
    yh: Bool,
    p: Eq(
        match xh
        | true => match yh | true => Ordering/eq() | false => Ordering/gt() end
        | false => match yh | true => Ordering/lt() | false => Ordering/eq() end
        end,
        Ordering/lt()),
) -> Eq(yh, true) =
    match xh
    | true =>
        match yh
        | true => match eq_neq_lt(p) end
        | false => match gt_neq_lt(p) end
        end
    | false =>
        match yh
        | true => Eq/refl()
        | false => match eq_neq_lt(p) end
        end
    end;

let head_lt_xh(
    xh: Bool,
    yh: Bool,
    p: Eq(
        match xh
        | true => match yh | true => Ordering/eq() | false => Ordering/gt() end
        | false => match yh | true => Ordering/lt() | false => Ordering/eq() end
        end,
        Ordering/lt()),
) -> Eq(xh, false) =
    match xh
    | true =>
        match yh
        | true => match eq_neq_lt(p) end
        | false => match gt_neq_lt(p) end
        end
    | false => Eq/refl()
    end;

let reduce_whole(
    @a: Bits,
    @b: Bits,
    @s: Ordering,
    e: Eq(raw(a, b), s),
    @E: Ordering,
    p: Eq(
        match raw(a, b) | eq() => E | lt() => Ordering/lt() | gt() => Ordering/gt() end,
        Ordering/lt()),
) -> Eq(
    match s: (_) => Ordering | eq() => E | lt() => Ordering/lt() | gt() => Ordering/gt() end,
    Ordering/lt()) =
    Eq/subst(
        (r: Ordering) =>
            Eq(
                match r | eq() => E | lt() => Ordering/lt() | gt() => Ordering/gt() end,
                Ordering/lt()),
        e,
        p);

let cons_lt(
    xh: Bool,
    zh: Bool,
    @xt: Bits,
    @zt: Bits,
    tail_lt: Eq(raw(xt, zt), Ordering/lt()),
) -> Eq(raw(b[xh, ..xt], b[zh, ..zt]), Ordering/lt()) =
    match xh
    | true => match zh | true => force_lt(tail_lt) | false => force_lt(tail_lt) end
    | false => match zh | true => force_lt(tail_lt) | false => force_lt(tail_lt) end
    end;

let trans_cons(
    @xh: Bool,
    @xt: Bits,
    @yh: Bool,
    @yt: Bits,
    @zh: Bool,
    @zt: Bits,
    s1: Ordering,
    e1: Eq(raw(xt, yt), s1),
    s2: Ordering,
    e2: Eq(raw(yt, zt), s2),
    p: Eq(raw(b[xh, ..xt], b[yh, ..yt]), Ordering/lt()),
    q: Eq(raw(b[yh, ..yt], b[zh, ..zt]), Ordering/lt()),
    ih: (pl: Eq(raw(xt, yt), Ordering/lt())) -> (ql: Eq(raw(yt, zt), Ordering/lt())) -> Eq(
        raw(xt, zt),
        Ordering/lt()),
) -> Eq(raw(b[xh, ..xt], b[zh, ..zt]), Ordering/lt()) =
    match s1: (r1) => Eq(raw(b[xh, ..xt], b[zh, ..zt]), Ordering/lt())
    | gt() => match gt_neq_lt(reduce_whole(e1, p)) end
    | lt() =>
        match s2: (r2) => Eq(raw(b[xh, ..xt], b[zh, ..zt]), Ordering/lt())
        | gt() => match gt_neq_lt(reduce_whole(e2, q)) end
        | lt() => cons_lt(xh, zh, ih(e1)(e2))
        | eq() =>
            cons_lt(
                xh,
                zh,
                Eq/subst((w: Bits) => Eq(raw(xt, w), Ordering/lt()), raw_to_eq(yt, zt, e2), e1))
        end
    | eq() =>
        match s2: (r3) => Eq(raw(b[xh, ..xt], b[zh, ..zt]), Ordering/lt())
        | gt() => match gt_neq_lt(reduce_whole(e2, q)) end
        | lt() =>
            cons_lt(
                xh,
                zh,
                Eq/subst(
                    (w: Bits) => Eq(raw(w, zt), Ordering/lt()),
                    Eq/sym(raw_to_eq(xt, yt, e1)),
                    e2))
        | eq() =>
            match false_neq_true(
                Eq/trans(
                    Eq/sym(head_lt_xh(yh, zh, reduce_whole(e2, q))),
                    head_lt_yh(xh, yh, reduce_whole(e1, p))))
            end
        end
    end;

pub let raw_trans(
    x: Bits,
    y: Bits,
    z: Bits,
    p: Eq(raw(x, y), Ordering/lt()),
    q: Eq(raw(y, z), Ordering/lt()),
) -> Eq(raw(x, z), Ordering/lt()) =
    match x
    | b[] =>
        match y
        | b[] => match eq_neq_lt(p) end
        | b[yh, ..yt] =>
            match z
            | b[] => match gt_neq_lt(q) end
            | b[_, .._] => Eq/refl()
            end
        end
    | b[xh, ..xt] =>
        match y
        | b[] => match gt_neq_lt(p) end
        | b[yh, ..yt] =>
            match z
            | b[] => match gt_neq_lt(q) end
            | b[zh, ..zt] =>
                trans_cons(
                    raw(xt, yt),
                    Eq/refl(),
                    raw(yt, zt),
                    Eq/refl(),
                    p,
                    q,
                    (pl) => (ql) => raw_trans(xt, yt, zt, pl, ql))
            end
        end
    end;

pub let refl(a: BigNat) -> Eq(cmp(a, a), Ordering/eq()) =
    raw_refl(a.bits);

pub let to_eq(a: BigNat, b: BigNat, p: Eq(cmp(a, b), Ordering/eq())) -> Eq(a, b) =
    eq(a, b, raw_to_eq(a.bits, b.bits, p));

pub let flip(a: BigNat, b: BigNat) -> Eq(cmp(b, a), Ordering/flip(cmp(a, b))) =
    raw_flip(a.bits, b.bits);

pub let trans(
    a: BigNat,
    b: BigNat,
    c: BigNat,
    p: Eq(cmp(a, b), Ordering/lt()),
    q: Eq(cmp(b, c), Ordering/lt()),
) -> Eq(cmp(a, c), Ordering/lt()) =
    raw_trans(a.bits, b.bits, c.bits, p, q);
