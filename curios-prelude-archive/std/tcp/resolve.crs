use /std/{Str, Nat, Bytes, Result, Option, List, Try, Async, Io};

-- Split out so its sequencing is a body of its own. A `!` in an argument position hoists into the
-- *enclosing* region, which would perform the wait before `using` had acquired the handle; a call hands `using` an inert description instead.
let resolved_address(h: /sys/Handle) -> Async(Result(Io/Error, Bytes)) =
    let _ = Async/raw/wait(h, /sys/event/read)!;
    let a = /sys/dns/resolve(h)!;
    match Io/Error/of(a.status)
    | some(e) => Async/pure(Result/failure(e))
    | none() => Async/pure(Result/success(Option/unwrap_or(List/try_get(a.addresses, 0), x[])))
    end;

-- The first address `host` resolves to, with `port`, as the bytes the socket rows take. The lookup parks the fiber until the resolver answers.
pub let resolve(host: Str, port: Nat) -> Try(Async, Io/Error, Bytes) =
    let r = /sys/dns/lookup(Str/to_bytes(host), port)!;
    match Io/Error/of(r.status)
    | some(e) => Try/raise(e)
    | none() =>
        let a = Async/using(/sys/Handle/close(r.handle), resolved_address(r.handle))!;
        let addr = a!;
        Try/pure(addr)
    end;
