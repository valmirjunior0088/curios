use /std/{Bytes, Str, Nat, Handle, Result, Async, Io};
use /std/tcp/{resolve, Socket};

pub struct Listener: Type {
    Handle,
}

let bind_listen(addr: Bytes) -> Io(Result(Handle/Error, Listener)) =
    let s = /sys/socket/open(addr)!;
    match Handle/error_of(s.status)
    | some(e) => Io/pure(Result/failure(e))
    | none() =>
        let _ = /sys/socket/set_reuseaddr(s.handle, true)!;
        let bound = /sys/socket/bind(s.handle, addr)!;
        match Handle/error_of(bound)
        | some(e) =>
            let _ = /sys/Handle/close(s.handle)!;
            Io/pure(Result/failure(e))
        | none() =>
            let status = /sys/socket/listen(s.handle, 128)!;
            match Handle/error_of(status)
            | some(e) =>
                let _ = /sys/Handle/close(s.handle)!;
                Io/pure(Result/failure(e))
            | none() => Io/pure(Result/success(Listener { s.handle }))
            end
        end
    end;

let listen(host: Str, port: Nat) -> Async(Result(Handle/Error, Listener)) =
    let resolved = resolve(host, port)!;
    match resolved
    | failure(e) => Async/pure(Result/failure(e))
    | success(addr) => Async/lift(bind_listen(addr))
    end;

-- A body of its own, so its sequencing does not hoist into `listen_loop`'s region ahead of the `using` that owns the listener's lifetime.
let accept_loop(l: Listener, on_conn: (Handle) -> Async({})) -> Async({}) =
    let go() -> Async({}) =
        let r = Async/accept(l.0)!;
        match r
        | failure(_) => Async/pure(())
        | success(h) =>
            let _ = on_conn(h)!;
            go()
        end;
    go();

let listen_loop(
    host: Str,
    port: Nat,
    on_conn: (Handle) -> Async({}),
) -> Async(Result(Handle/Error, {})) =
    let opened = listen(host, port)!;
    match opened
    | failure(e) => Async/pure(Result/failure(e))
    | success(l) =>
        let _ = Async/using(l.0, /sys/Handle/close(l.0), accept_loop(l, on_conn))!;
        Async/pure(Result/success(()))
    end;

-- An accepted stream arrives non-blocking from the host, so it is handed to its own fiber at once.
let serve_conn(h: Handle, handler: (Socket) -> Async({})) -> Async({}) =
    Async/go(Async/using(h, /sys/Handle/close(h), handler(Socket/new(h))));

pub let serve(
    host: Str,
    port: Nat,
    handler: (Socket) -> Async({}),
) -> Async(Result(Handle/Error, {})) =
    listen_loop(host, port, (h) => serve_conn(h, handler));

let serve_tls_conn(h: Handle, cfg: Handle, handler: (Socket) -> Async({})) -> Async({}) =
    let status = /sys/tls/start_server(h, cfg)!;
    match status == /sys/status/ok
    | true => Async/using(h, /sys/Handle/close(h), handler(Socket/new(h)))
    | false => Async/lift(/sys/Handle/close(h))
    end;

pub let serve_tls(
    host: Str,
    port: Nat,
    cert: Bytes,
    key: Bytes,
    handler: (Socket) -> Async({}),
) -> Async(Result(Handle/Error, {})) =
    let cfg = /sys/tls/server_config(cert, key)!;
    match Handle/error_of(cfg.status)
    | some(e) => Async/pure(Result/failure(e))
    | none() =>
        Async/using(
            cfg.handle,
            /sys/Handle/close(cfg.handle),
            listen_loop(host, port, (h) => serve_tls_conn(h, cfg.handle, handler)))
    end;
