use /std/{Bytes, Str, Nat, Bool, Result, Try, Async, Io, Handle};
use /std/tcp/{resolve, let Socket};
use /std/Handle/{Interest};

--- Up to `n` bytes, parking until some arrive.
pub let read(c: Socket, n: Nat) -> Async(Io/Chunk) =
    Async/Read/read(c.0, n);

--- The whole of `b`, parking while the peer cannot take more.
pub let write(c: Socket, b: Bytes) -> Async(Result(Io/Error, {})) =
    Async/Write/write(c.0, b);

satisfy Async/Read(Async, Socket) {
    read(c, n) = read(c, n),
}

satisfy Async/Write(Async, Socket) {
    write(c, b) = write(c, b),
    flush(c) = Async/Write/flush(c.0),
}

--- Close `c`.
pub let close(c: Socket) -> Io({}) =
    Handle/close(c.0);

let ok(r: Result(Nat, {})) -> Try(Io, Io/Error, {}) =
    let _ = Io/Error/of_result(r)!;
    Try/pure(());

let close_raising(@A: Type, h: Handle, e: Io/Error) -> Try(Io, Io/Error, A) =
    let _ = Handle/close(h)!;
    Try/raise(e);

let open_and_connect(addr: Bytes) -> Try(Io, Io/Error, {Handle, Bool}) =
    let h = Io/Error/of_result(/sys/socket/open(addr)!)!;
    let r = /sys/socket/connect(h, addr)!;
    match r
    | success(_) => Try/pure((h, false))
    | failure(s) =>
        match s == /sys/status/would_block
        | true => Try/pure((h, true))
        | false =>
            let _ = Handle/close(h)!;
            Try/raise(Io/Error/of(s))
        end
    end;

let settle(h: Handle, pending: Bool) -> Try(Async, Io/Error, {}) =
    match pending
    | false => Try/pure(())
    | true =>
        let _ = Async/park([Async/Wait/ready(h, Interest/writable)])!;
        let r = /sys/socket/finish_connect(h)!;
        match r
        | success(_) => Try/pure(())
        | failure(s) =>
            match s == /sys/status/would_block
            | true => settle(h, true)
            | false => Try/raise(Io/Error/of(s))
            end
        end
    end;

let upgrade(h: Handle, host: Str, tls: Bool) -> Try(Io, Io/Error, {}) =
    match tls
    | true =>
        let r = /sys/tls/start(h, Str/to_bytes(host))!;
        ok(r)
    | false => Try/pure(())
    end;

let connect_addr(host: Str, addr: Bytes, tls: Bool) -> Try(Async, Io/Error, Socket) =
    let (h, pending) = open_and_connect(addr)!;
    let _ = Try/rescue(settle(h, pending), (e) => close_raising(h, e))!;
    let _ = Try/rescue(upgrade(h, host, tls), (e) => close_raising(h, e))!;
    Try/pure(Socket { h });

--- A connection to `host` at `port`, in the clear. Nothing guards it: `with` is the bracket that closes it.
pub let connect(host: Str, port: Nat) -> Try(Async, Io/Error, Socket) =
    let addr = resolve(host, port)!;
    connect_addr(host, addr, false);

--- A connection to `host` at `port` under TLS, the certificate checked against `host`.
pub let connect_tls(host: Str, port: Nat) -> Try(Async, Io/Error, Socket) =
    let addr = resolve(host, port)!;
    connect_addr(host, addr, true);

--- `body` over the socket `open` connects, closed whichever way the task ends.
pub let with(
    @A: Type,
    open: Try(Async, Io/Error, Socket),
    body: (Socket) -> Try(Async, Io/Error, A),
) -> Try(Async, Io/Error, A) =
    let c = open!;
    let outcome = Async/using(close(c), Try/run(flushed(c, body(c))))!;
    let a = outcome!;
    Try/pure(a);

--- `body`, then what `c` holds of the writes it accepted handed on, so a TLS stream has sent its records before `with` closes it; a failure to hand them on is the task's.
let flushed(@A: Type, c: Socket, body: Try(Async, Io/Error, A)) -> Try(Async, Io/Error, A) =
    let a = body!;
    let _ = Try/attempt(Async/Write/flush(c))!;
    Try/pure(a);

--- `request` written whole and the reply read to its end, over the socket `open` connects, closed after. One exchange with a peer that closes when it has answered.
pub let call(open: Try(Async, Io/Error, Socket), request: Bytes) -> Try(Async, Io/Error, Bytes) =
    with(open, (c) =>
        let _ = Try/attempt(write(c, request))!;
        Try/attempt(Async/read_all(c)));
