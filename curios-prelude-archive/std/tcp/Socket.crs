use /std/{Bytes, Str, Nat, Bool, Result, Try, Async, Io, stream};
use /std/tcp/{resolve};

-- | A connected socket.
pub struct Socket: Type {
    /sys/Handle,
}

-- | A socket over an accepted handle. The seam `Listener/accept` builds one through.
pub let new(h: /sys/Handle) -> Socket =
    Socket { h };

-- | Up to `n` bytes, parking until some arrive.
pub let read(c: Socket, n: Nat) -> Async(stream/Chunk) =
    Async/raw/read(c.0, n);

-- | The whole of `b`, parking while the peer cannot take more.
pub let write(c: Socket, b: Bytes) -> Async(Result(Io/Error, {})) =
    Async/raw/write(c.0, b);

satisfy stream/Read(Socket) {
    read(c, n) = read(c, n),
}

satisfy stream/Write(Socket) {
    write(c, b) = write(c, b),
}

-- | Close `c`.
pub let close(c: Socket) -> Io({}) =
    /sys/Handle/close(c.0);

let ok(status: Nat) -> Try(Io, Io/Error, {}) =
    match Io/Error/of(status) | some(e) => Try/raise(e) | none() => Try/pure(()) end;

let close_raising(@A: Type, h: /sys/Handle, e: Io/Error) -> Try(Io, Io/Error, A) =
    let _ = /sys/Handle/close(h)!;
    Try/raise(e);

let open_and_connect(addr: Bytes) -> Try(Io, Io/Error, {/sys/Handle, Bool}) =
    let s = /sys/socket/open(addr)!;
    let _ = ok(s.status)!;
    let status = /sys/socket/connect(s.handle, addr)!;
    choose
    | status == /sys/status/would_block => Try/pure((s.handle, true))
    | _ =>
        match Io/Error/of(status)
        | some(e) =>
            let _ = /sys/Handle/close(s.handle)!;
            Try/raise(e)
        | none() => Try/pure((s.handle, false))
        end
    end;

let settle(h: /sys/Handle, pending: Bool) -> Try(Async, Io/Error, {}) =
    match pending
    | false => Try/pure(())
    | true =>
        let _ = Async/raw/wait(h, /sys/event/write)!;
        let status = /sys/socket/finish_connect(h)!;
        choose | status == /sys/status/would_block => settle(h, true) | _ => ok(status) end
    end;

let upgrade(h: /sys/Handle, host: Str, tls: Bool) -> Try(Io, Io/Error, {}) =
    match tls
    | true =>
        let status = /sys/tls/start(h, Str/to_bytes(host))!;
        ok(status)
    | false => Try/pure(())
    end;

let connect_addr(host: Str, addr: Bytes, tls: Bool) -> Try(Async, Io/Error, Socket) =
    let (h, pending) = open_and_connect(addr)!;
    let _ = Try/rescue(settle(h, pending), (e) => close_raising(h, e))!;
    let _ = Try/rescue(upgrade(h, host, tls), (e) => close_raising(h, e))!;
    Try/pure(Socket { h });

-- | A connection to `host` at `port`, in the clear. Nothing guards it: `with` is the bracket that closes it.
pub let connect(host: Str, port: Nat) -> Try(Async, Io/Error, Socket) =
    let addr = resolve(host, port)!;
    connect_addr(host, addr, false);

-- | A connection to `host` at `port` under TLS, the certificate checked against `host`.
pub let connect_tls(host: Str, port: Nat) -> Try(Async, Io/Error, Socket) =
    let addr = resolve(host, port)!;
    connect_addr(host, addr, true);

-- | `body` over the socket `open` connects, closed whichever way the task ends.
pub let with(
    @A: Type,
    open: Try(Async, Io/Error, Socket),
    body: (Socket) -> Try(Async, Io/Error, A),
) -> Try(Async, Io/Error, A) =
    let c = open!;
    let outcome = Async/using(close(c), Try/run(body(c)))!;
    let a = outcome!;
    Try/pure(a);

-- | `request` written whole and the reply read to its end, over the socket `open` connects, closed after. One exchange with a peer that closes when it has answered.
pub let call(open: Try(Async, Io/Error, Socket), request: Bytes) -> Try(Async, Io/Error, Bytes) =
    with(
        open,
        (c) =>
            let _ = Try/attempt(write(c, request))!;
            Try/attempt(stream/read_all(c)));
