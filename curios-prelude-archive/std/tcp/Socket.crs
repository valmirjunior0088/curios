use /std/{Bytes, Str, Nat, Bool, Handle, Result, Async, Io};
use /std/tcp/{Settings, resolve};

pub struct Socket: Type {
    Handle,
}

-- `Listener` is a sibling, so it cannot reach this representation; the constructor is the public seam through which it wraps an accepted handle.
pub let new(h: Handle) -> Socket =
    Socket { h };

pub let read(c: Socket, n: Nat) -> Async(Handle/Read) =
    Async/read(c.0, n);

pub let write(c: Socket, b: Bytes) -> Async(Result(Io/Error, {})) =
    Async/write(c.0, b);

let upgrade(h: Handle, host: Str, tls: Bool) -> Io(Nat) =
    match tls
    | true => /sys/tls/start(h, Str/to_bytes(host))
    | false => Io/pure(/sys/status/ok)
    end;

-- Every step up to the connect is a syscall that answers at once; the connect itself is where a peer decides, so the host may hand the wait back: a non-blocking socket answers `would_block` for any peer that is not local, which `settle` turns into a park on `WRITE` until the kernel has settled it.
let open_and_connect(addr: Bytes) -> Io(Result(Io/Error, {Handle, Bool})) =
    let s = /sys/socket/open(addr)!;
    match Io/Error/error_of(s.status)
    | some(e) => Io/pure(Result/failure(e))
    | none() =>
        let status = /sys/socket/connect(s.handle, addr)!;
        choose
        | status == /sys/status/would_block => Io/pure(Result/success((s.handle, true)))
        | _ =>
            match Io/Error/error_of(status)
            | some(e) =>
                let _ = /sys/Handle/close(s.handle)!;
                Io/pure(Result/failure(e))
            | none() => Io/pure(Result/success((s.handle, false)))
            end
        end
    end;

-- A pending connect settles once the socket polls writable, and `finish_connect` reads the outcome; an honest early answer of `would_block` parks again.
let settle(h: Handle, pending: Bool) -> Async(Result(Io/Error, {})) =
    match pending
    | false => Async/pure(Result/success(()))
    | true =>
        let _ = Async/wait(h, /sys/event/write)!;
        let status = /sys/socket/finish_connect(h)!;
        choose
        | status == /sys/status/would_block => settle(h, true)
        | _ =>
            Async/pure(
                match Io/Error/error_of(status)
                | some(e) => Result/failure(e)
                | none() => Result/success(())
                end)
        end
    end;

let connect_addr(settings: Settings, host: Str, addr: Bytes) -> Async(Result(Io/Error, Socket)) =
    let opened = open_and_connect(addr)!;
    match opened
    | failure(e) => Async/pure(Result/failure(e))
    | success((h, pending)) =>
        let settled = settle(h, pending)!;
        match settled
        | failure(e) =>
            let _ = /sys/Handle/close(h)!;
            Async/pure(Result/failure(e))
        | success(_) =>
            let upgraded = upgrade(h, host, settings.tls)!;
            match Io/Error/error_of(upgraded)
            | some(e) =>
                let _ = /sys/Handle/close(h)!;
                Async/pure(Result/failure(e))
            | none() => Async/pure(Result/success(Socket { h }))
            end
        end
    end;

let connect_socket(settings: Settings, host: Str, port: Nat) -> Async(Result(Io/Error, Socket)) =
    let resolved = resolve(host, port)!;
    match resolved
    | failure(e) => Async/pure(Result/failure(e))
    | success(addr) => connect_addr(settings, host, addr)
    end;

pub let connect(settings: Settings, host: Str, port: Nat) -> Async(Result(Io/Error, Socket)) =
    let opened = connect_socket(settings, host, port)!;
    match opened
    | failure(e) => Async/pure(Result/failure(e))
    | success(c) =>
        let _ = Async/acquire(c.0, /sys/Handle/close(c.0))!;
        Async/pure(Result/success(c))
    end;

pub let close(c: Socket) -> Async({}) =
    Async/release(c.0);

pub let with(
    @A: Type,
    settings: Settings,
    host: Str,
    port: Nat,
    f: (Socket) -> Async(A),
) -> Async(Result(Io/Error, A)) =
    let opened = connect(settings, host, port)!;
    match opened
    | failure(e) => Async/pure(Result/failure(e))
    | success(c) =>
        let a = f(c)!;
        let _ = close(c)!;
        Async/pure(Result/success(a))
    end;

let drain(c: Socket) -> Async(Result(Io/Error, Bytes)) =
    Async/drain((n) => read(c, n));

-- `with` wraps the body's own failure channel in its connect/close one; flatten collapses the two so a caller sees one channel whichever stage failed.
pub let call(
    settings: Settings,
    host: Str,
    port: Nat,
    request: Bytes,
) -> Async(Result(Io/Error, Bytes)) =
    Async/map(
        with(
            settings,
            host,
            port,
            (c) =>
                let w = write(c, request)!;
                match w | success(_) => drain(c) | failure(e) => Async/pure(Result/failure(e)) end),
        (r) => Result/flatten(r));
