use /std/{List, Option, Cell, Io, Async};
use /std/Async/{Waker};

induct State: Type
| idle(List(Waker))
| raised()
end

-- | A flag one fiber raises and another parks on.
pub struct Signal: Type {
    Cell(State),
}

-- | A lowered flag.
pub let new() -> Io(Signal) =
    let cell = Cell/new(State/idle([]))!;
    Io/pure(Signal { cell });

let wake_all(ws: List(Waker)) -> Io({}) =
    match ws
    | [] => Io/pure(())
    | [w, ..more] =>
        let _ = Waker/wake(w)!;
        wake_all(more)
    end;

-- | Raise the flag and wake every fiber parked on it. A raised flag stays raised until a `wait` lowers it, so a burst of notifications is one wake.
pub let notify(s: Signal) -> Io({}) =
    let state = Cell/get(s.0)!;
    match state
    | raised() => Io/pure(())
    | idle(ws) =>
        let _ = Cell/set(s.0, State/raised())!;
        wake_all(ws)
    end;

let listen(s: Signal, w: Waker) -> Io({}) =
    let now = Cell/get(s.0)!;
    match now | raised() => Waker/wake(w) | idle(ws) => Cell/set(s.0, State/idle([w, ..ws])) end;

let lower(s: Signal) -> Io(Option({})) =
    let state = Cell/get(s.0)!;
    match state
    | raised() =>
        let _ = Cell/set(s.0, State/idle([]))!;
        Io/pure(Option/some(()))
    | idle(_) => Io/pure(Option/none())
    end;

-- | An offer that yields once the flag is raised, lowering it.
pub let offer(s: Signal) -> Async/Offer({}) =
    Async/Offer/new(lower(s), Io/pure(Async/Wait/woken((w) => listen(s, w))));

-- | Park until the flag is raised, then lower it. A flag already raised is lowered at once.
pub let wait(s: Signal) -> Async({}) =
    Async/map(Async/select([offer(s)]), (_) => ());
