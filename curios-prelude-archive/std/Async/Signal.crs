use /std/{Io, Async};
use /std/Async/{Channel};

--- A flag one fiber raises and another parks on. Notifications coalesce while its one slot is full.
pub struct Signal: Type {
    sender: Channel/Sender({}),
    receiver: Channel/Receiver({}),
}

--- A lowered flag.
pub let new() -> Io(Signal) =
    let ends = Channel/new(1)!;
    Io/pure(Signal { sender = ends.0, receiver = ends.1 });

--- Raise the flag. A raised flag stays raised until taken, so a burst of notifications is one pending wake.
pub let notify(s: Signal) -> Io({}) =
    let _ = Channel/try_send(s.sender, ())!;
    Io/pure(());

--- An offer that yields once the flag is raised, lowering it.
pub let offer(s: Signal) -> Async/Offer({}) =
    Async/Offer/new(Channel/try_recv(s.receiver), Io/pure(Async/Wait/readable(s.receiver)));

--- Park until the flag is raised, then lower it. A flag already raised is lowered at once.
pub let wait(s: Signal) -> Async({}) =
    Async/map(Async/select([offer(s)]), (_) => ());
