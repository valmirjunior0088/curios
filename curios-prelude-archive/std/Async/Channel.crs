pub use /sys/{Channel};
use /std/{Nat, Bool, Option, Io, Async};
use /std/Async/{Offer};

--- The end values are put in.
pub struct Sender(A: Type): Type {
    Channel(A),
}

--- The end values are taken from.
pub struct Receiver(A: Type): Type {
    Channel(A),
}

--- A channel holding at most `capacity` values, and the two ends of it. A sender needing acknowledgement can include a reply cell in its message.
pub let new(
    @A: Type,
    capacity: Nat,
    @positive: Nat/Lt(0, capacity),
) -> Io({Sender(A), Receiver(A)}) =
    let c = /sys/Channel/new(@A, capacity, @positive)!;
    Io/pure((Sender { c }, Receiver { c }));

--- Put `a` in without parking: `true` when it was taken, `false` when the channel is full or closed.
pub let try_send(@A: Type, s: Sender(A), a: A) -> Io(Bool) =
    let outcome = /sys/Channel/push(s.0, a)!;
    Io/pure(match outcome | taken() => true | full() => false | closed() => false end);

--- Take the next value without parking: `none` when nothing is queued.
pub let try_recv(@A: Type, r: Receiver(A)) -> Io(Option(A)) =
    let outcome = /sys/Channel/take(r.0)!;
    Io/pure(
        match outcome
        | item(a) => Option/some(a)
        | empty() => Option/none()
        | ended() => Option/none()
        end);

--- A wait satisfied while an item is queued or the channel is closed.
pub let readable(@A: Type, r: Receiver(A)) -> Async/Wait =
    let ready() -> Io(Bool) =
        let count = /sys/Channel/count(r.0)!;
        let closed = /sys/Channel/closed(r.0)!;
        Io/pure(count > 0 || closed);
    Async/Waiting/probe(ready());

--- A wait satisfied while the channel has room or is closed.
pub let writable(@A: Type, s: Sender(A)) -> Async/Wait =
    let ready() -> Io(Bool) =
        let count = /sys/Channel/count(s.0)!;
        let capacity = /sys/Channel/capacity(s.0)!;
        let closed = /sys/Channel/closed(s.0)!;
        Io/pure(count < capacity || closed);
    Async/Waiting/probe(ready());

--- An offer that yields the next value, or `none` once the channel is closed and drained.
pub let recv_offer(@A: Type, r: Receiver(A)) -> Offer(Option(A)) =
    Offer/new(
        Io/bind(
            /sys/Channel/take(r.0),
            (outcome) =>
                Io/pure(
                    match outcome
                    | item(a) => Option/some(Option/some(a))
                    | empty() => Option/none()
                    | ended() => Option/some(Option/none())
                    end)),
        Io/pure(readable(r)));

--- An offer that yields `true` once `a` has been put in, or `false` if the channel closed first.
pub let send_offer(@A: Type, s: Sender(A), a: A) -> Offer(Bool) =
    Offer/new(
        Io/bind(
            /sys/Channel/push(s.0, a),
            (outcome) =>
                Io/pure(
                    match outcome
                    | taken() => Option/some(true)
                    | full() => Option/none()
                    | closed() => Option/some(false)
                    end)),
        Io/pure(writable(s)));

--- The next value, parking while there is none; `none` once the channel is closed and drained.
pub let recv(@A: Type, r: Receiver(A)) -> Async(Option(A)) =
    Async/map(Async/select([recv_offer(r)]), (w) => w.1);

--- Put `a` in, parking while the channel is full; `false` when it is closed.
pub let send(@A: Type, s: Sender(A), a: A) -> Async(Bool) =
    Async/map(Async/select([send_offer(s, a)]), (w) => w.1);

--- Close the channel. A receiver drains what is already queued and then answers `none`, and a send answers `false`.
pub let close(@A: Type, s: Sender(A)) -> Io({}) =
    /sys/Channel/close(s.0);
