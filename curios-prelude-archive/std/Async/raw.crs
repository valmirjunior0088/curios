use /std/{Bytes, Nat, Result, Io, Async, True};

let wait(h: /sys/Handle, ev: Nat) -> Async({}) =
    Async/park([Async/Wait/readable(h, ev)]);

-- | Up to `n` bytes from `h`, parking while the host would block.
pub let read(h: /sys/Handle, n: Nat) -> Async(Io/Chunk) =
    let go() -> Async(Io/Chunk) =
        let r = /sys/Handle/read(h, n)!;
        match r.status == /sys/status/would_block
        | true =>
            let _ = wait(h, /sys/event/read)!;
            go()
        | false =>
            match Io/Error/of(r.status)
            | some(e) => Async/pure(Io/Chunk/error(e))
            | none() =>
                match r.status == /sys/status/eof
                | true => Async/pure(Io/Chunk/eof())
                | false => Async/pure(Io/Chunk/chunk(r.bytes))
                end
            end
        end;
    go();

-- | The whole of `b` to `h`, parking while the host would block and resending a short write.
pub let write(h: /sys/Handle, b: Bytes) -> Async(Result(Io/Error, {})) =
    let go(rest: Bytes) -> Async(Result(Io/Error, {})) =
        let r = /sys/Handle/write(h, rest)!;
        match r.status == /sys/status/would_block
        | true =>
            let _ = wait(h, /sys/event/write)!;
            go(rest)
        | false =>
            match Io/Error/of(r.status)
            | some(e) => Async/pure(Result/failure(e))
            | none() =>
                match r.written < Bytes/len(rest)
                | true =>
                    let _ = wait(h, /sys/event/write)!;
                    go(
                        Bytes/drop(
                            rest,
                            r.written,
                            @Nat/Lt/le_of_lt(r.written, Bytes/len(rest), True/qed())))
                | false => Async/pure(Result/success(()))
                end
            end
        end;
    go(b);
