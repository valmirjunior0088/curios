-- The loops that turn a raw handle's `would_block` into a park: the seam every stream type's `Read` and `Write` witness is written over, and where an accepted connection is pulled. The host never waits on a peer, so a read, write or accept that cannot progress answers `would_block` here and the fiber parks on the handle until `poll` reports it ready. Public so `File`, `tcp`, a child's pipes and `Io`'s standard streams reach it from their own modules; a program holds no raw handle, so it has nothing to hand these.
use /std/{Bytes, Nat, Result, Io, Async, True, stream};

-- | The park itself, for a module that waits on a handle of its own — a child's exit, a resolver, a pending connect — rather than through one of the loops below. `Async` keeps the suspension private and this is its one public spelling.
pub let wait(h: /sys/Handle, ev: Nat) -> Async({}) =
    Async/wait(h, ev);

pub let read(h: /sys/Handle, n: Nat) -> Async(stream/Chunk) =
    let go() -> Async(stream/Chunk) =
        let r = /sys/Handle/read(h, n)!;
        match r.status == /sys/status/would_block
        | true =>
            let _ = wait(h, /sys/event/read)!;
            go()
        | false =>
            match Io/Error/of(r.status)
            | some(e) => Async/pure(stream/Chunk/error(e))
            | none() =>
                match r.status == /sys/status/eof
                | true => Async/pure(stream/Chunk/eof())
                | false => Async/pure(stream/Chunk/chunk(r.bytes))
                end
            end
        end;
    go();

pub let write(h: /sys/Handle, b: Bytes) -> Async(Result(Io/Error, {})) =
    let go(rest: Bytes) -> Async(Result(Io/Error, {})) =
        let r = /sys/Handle/write(h, rest)!;
        match r.status == /sys/status/would_block
        | true =>
            let _ = wait(h, /sys/event/write)!;
            go(rest)
        | false =>
            match Io/Error/of(r.status)
            | some(e) => Async/pure(Result/failure(e))
            | none() =>
                match r.written < Bytes/len(rest)
                | true =>
                    let _ = wait(h, /sys/event/write)!;
                    go(
                        Bytes/drop(
                            rest,
                            r.written,
                            @Nat/Lt/le_of_lt(r.written, Bytes/len(rest), True/qed())))
                | false => Async/pure(Result/success(()))
                end
            end
        end;
    go(b);

pub let accept(l: /sys/Handle) -> Async(Result(Io/Error, /sys/Handle)) =
    let go() -> Async(Result(Io/Error, /sys/Handle)) =
        let r = /sys/socket/accept(l)!;
        match r.status == /sys/status/would_block
        | true =>
            let _ = wait(l, /sys/event/read)!;
            go()
        | false =>
            match Io/Error/of(r.status)
            | some(e) => Async/pure(Result/failure(e))
            | none() => Async/pure(Result/success(r.handle))
            end
        end;
    go();
