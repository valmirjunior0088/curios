use /std/{Bool, Nat};

pub concept Add(A: Type): pub Type {
    add(A, A) -> A,
}

pub concept Sub(A: Type): pub Type {
    sub(A, A) -> A,
}

pub concept Mul(A: Type): pub Type {
    mul(A, A) -> A,
}

pub concept Div(A: Type): pub Type {
    div(A, A) -> A,
}

pub concept Rem(A: Type): pub Type {
    rem(A, A) -> A,
}

pub concept And(A: Type): pub Type {
    and(A, A) -> A,
}

pub concept Or(A: Type): pub Type {
    or(A, A) -> A,
}

pub concept Cmp(A: Type): pub Type {
    lt(A, A) -> Bool,
    lte(A, A) -> Bool,
    gt(A, A) -> Bool,
    gte(A, A) -> Bool,
}

pub concept Monad(M: (Type) -> Type): pub Type {
    pure(@A: Type, A) -> M(A),
    bind(@A: Type, @B: Type, M(A), (A) -> M(B)) -> M(B),
}

pub concept Lift(M: (Type) -> Type, N: (Type) -> Type): pub Type {
    use Monad(M),
    use Monad(N),
    lift(@A: Type, M(A)) -> N(A),
}

pub mod Eql;
pub use Eql/{let Eql};

pub mod True;
pub use True/{let True};

pub mod False;
pub use False/{let False};

pub mod Char;
pub use Char/{let Char};

pub mod Str;
pub use Str/{let Str};

-- Scrutinised through `/sys/Nat/lt` rather than `<`, which would be the same proposition with an edge nothing can see: `into_core` leaves an infix unresolved and the concept projection is inserted during elaboration, so the topological sort has no `Lt → Cmp(Nat)` edge to order by. With `/sys`'s accessors depending on this name, that ordering stops being luck.
pub let Lt(a: Nat, b: Nat) -> Prop =
    match /sys/Nat/lt(a, b) | true => True | false => False end;
