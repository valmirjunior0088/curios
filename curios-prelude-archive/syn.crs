use /std/{Bool};

-- | Addition, which `+` dispatches through.
pub concept Add(A: Type): pub Type {
    -- | The sum of the two.
    add(A, A) -> A,
}

-- | Subtraction, which `-` dispatches through.
pub concept Subtract(A: Type): pub Type {
    -- | The second taken from the first.
    sub(A, A) -> A,
}

-- | Multiplication, which `*` dispatches through.
pub concept Multiply(A: Type): pub Type {
    -- | The product of the two.
    mul(A, A) -> A,
}

-- | Division, which `/` dispatches through.
pub concept Divide(A: Type): pub Type {
    -- | The precondition this carrier states for a divisor: `True` where division is total, and a proposition the caller must discharge where it is not.
    Ok(A) -> Prop,
    -- | The quotient, under the evidence that `b` may be divided by.
    div(a: A, b: A, @ok: Ok(b)) -> A,
}

-- | Remainder, which `%` dispatches through.
pub concept Remainder(A: Type): pub Type {
    -- | The precondition this carrier states for a divisor, as `Divide`'s is.
    Ok(A) -> Prop,
    -- | What is left of `a` once `b` has been taken from it as often as it goes.
    rem(a: A, b: A, @ok: Ok(b)) -> A,
}

-- | Conjunction, which `&&` dispatches through.
pub concept And(A: Type): pub Type {
    -- | Both.
    and(A, A) -> A,
}

-- | Disjunction, which `||` dispatches through.
pub concept Or(A: Type): pub Type {
    -- | Either.
    or(A, A) -> A,
}

-- | The order comparisons, which `<`, `<=`, `>` and `>=` dispatch through.
pub concept Compare(A: Type): pub Type {
    -- | Whether the first is below the second.
    lt(A, A) -> Bool,
    -- | Whether the first is below the second or equal to it.
    le(A, A) -> Bool,
    -- | Whether the first is above the second.
    gt(A, A) -> Bool,
    -- | Whether the first is above the second or equal to it.
    ge(A, A) -> Bool,
}

-- | Equality as a decision, which `==` and `!=` dispatch through.
-- |
-- | Distinct from `Eq`, which is the proposition that two values are the same: a witness here answers, and owes no proof that its answer agrees.
pub concept Equal(A: Type): pub Type {
    -- | Whether the two are equal.
    eql(A, A) -> Bool,
    -- | Whether the two differ, supplied in its own right rather than read off `eql`.
    neq(A, A) -> Bool,
}

-- | Sequencing, which postfix `!` dispatches through.
pub concept Monad(M: (Type) -> Type): pub Type {
    -- | The description that performs nothing and yields the value.
    pure(@A: Type, A) -> M(A),
    -- | The description that performs the first, then whatever the continuation makes of its result.
    bind(@A: Type, @B: Type, M(A), (A) -> M(B)) -> M(B),
}

-- | The canonical embedding of one monad into another, which `!` inserts where an action's monad differs from its region's.
-- |
-- | One witness may occupy each ordered pair, so which embedding runs is a fact about the program rather than about a call site, and embeddings never chain.
pub concept Lift(M: (Type) -> Type, N: (Type) -> Type): pub Type {
    use Monad(M),
    use Monad(N),
    -- | The action, carried into the second monad.
    lift(@A: Type, M(A)) -> N(A),
}

pub mod Char;
pub use Char/{let Char};

pub mod Str;
pub use Str/{let Str};

pub mod Nat;

pub mod Int;

pub mod Flt;

pub mod Test;

pub mod Spell;
