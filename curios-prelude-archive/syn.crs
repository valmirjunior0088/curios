use /std/{Bool};

pub concept Add(A: Type): pub Type {
    add(A, A) -> A,
}

pub concept Sub(A: Type): pub Type {
    sub(A, A) -> A,
}

pub concept Mul(A: Type): pub Type {
    mul(A, A) -> A,
}

pub concept Div(A: Type): pub Type {
    div(A, A) -> A,
}

pub concept Rem(A: Type): pub Type {
    rem(A, A) -> A,
}

pub concept And(A: Type): pub Type {
    and(A, A) -> A,
}

pub concept Or(A: Type): pub Type {
    or(A, A) -> A,
}

pub concept Cmp(A: Type): pub Type {
    lt(A, A) -> Bool,
    lte(A, A) -> Bool,
    gt(A, A) -> Bool,
    gte(A, A) -> Bool,
}

pub concept Monad(M: (Type) -> Type): pub Type {
    pure(@A: Type, A) -> M(A),
    bind(@A: Type, @B: Type, M(A), (A) -> M(B)) -> M(B),
}

-- The canonical embedding of one monad into another: `lift` is a monad morphism, so sequencing an `M` action inside an `N` region means what it meant in `M`. One witness per ordered pair program-wide; embeddings never chain automatically — a composite edge is declared, not derived. The `Monad` superclasses make an edge between non-monads undeclarable.
pub concept Lift(M: (Type) -> Type, N: (Type) -> Type): pub Type {
    use Monad(M),
    use Monad(N),
    lift(@A: Type, M(A)) -> N(A),
}

pub mod Eql;
pub use Eql/{let Eql};

pub mod True;
pub use True/{let True};

pub mod False;
pub use False/{let False};

pub mod Char;
pub use Char/{let Char};

pub mod Str;
pub use Str/{let Str};
