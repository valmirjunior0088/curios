pub let print(s: Str) -> Io({}) =
    let _ = Handle/write(Handle/stdout, Str/to_bytes(s))!;
    Io/pure(());

pub let print_err(s: Str) -> Io({}) =
    let _ = Handle/write(Handle/stderr, Str/to_bytes(s))!;
    Io/pure(());

pub let read() -> Io(Option(Bytes)) =
    rec go(acc: Bytes) -> Io(Option(Bytes)) =
        let r = /sys/Handle/read(Handle/stdin, 1)!;
        choose
        | r.status != /sys/status/ok && Bytes/len(acc) == 0 => Io/pure(Option/none())
        | r.status != /sys/status/ok => Io/pure(Option/some(acc))
        | Byte/to_nat(Option/unwrap_or(Bytes/try_get(r.bytes, 0), 0)) == 0xA =>
            Io/pure(Option/some(acc))
        | _ => go(x[..acc, ..r.bytes])
        end;
    go(x[]);
