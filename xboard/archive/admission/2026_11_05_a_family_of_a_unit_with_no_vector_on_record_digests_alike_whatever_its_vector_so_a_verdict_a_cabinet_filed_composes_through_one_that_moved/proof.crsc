-- `/app/X` was taken from the cabinet's record of it, filed while `F` was positive, because `F` digests alike with no vector on record whatever the walk mounting `/lib` computes for it (`recheck::stored`, `baseline::read_digest`); `X` holds a function out of `X`, and `self_app` applies one to itself.
let /self_app: (x: #{node = InductType} /app/X()) -> #{node = InductType} /sys/Bool/False() =
    (x: #{node = InductType} /app/X()) =>
        #{goal = #{node = InductType} /sys/Bool/False()}
        match x
        | c(m) =>
            #{goal = #{node = InductType} /sys/Bool/False()}
            match m
            | mk(g) => #{goal = #{node = InductType} /sys/Bool/False()} match g | gmk(f) => f(x) end
            end
        end;

/self_app(
    /app/X/c(
        (#{universes = {levels = [0]}} /lib/F/mk)(
            @#{node = InductType} /app/X(),
            (#{universes = {levels = [0]}} /base/G/gmk)(
                @#{node = InductType} /app/X(),
                /self_app))))
