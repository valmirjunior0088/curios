-- `a_guard_settled_where_its_operands_are_proofs_as_a_term.crsc` with the unit type `{}` where `Two` stood, and no declaration: at `true` the operands' type has one inhabitant by its shape, and conversion holds `h(p)` and `h(q)` one term there as it does at a proposition. The guard names `p` and `q`, whose type names `c`, so the split's arm restates it and settles it there, and the `qed` after the split is refused at `Holds(k(0))`.
((
    c: #BoolType,
    h: (x: #{goal = Type} match c | false => #NatType | true => {} end) -> #NatType,
    k: (n: #NatType) -> #BoolType,
    p: #{goal = Type} match c | false => #NatType | true => {} end,
    q: #{goal = Type} match c | false => #NatType | true => {} end,
    guard: /sys/Bool/Holds(
        #{goal = #BoolType} match #NatEql(h(p), h(q)) | false => k(1) | true => k(0) end)) =>
    #{goal = /sys/Bool/Holds(k(0))}
    match #{goal = #BoolType} match #NatEql(h(p), h(q)) | false => k(1) | true => k(0) end
    | false => #{goal = /sys/Bool/Holds(k(0))} match guard end
    | true =>
        let w: #{node = InductType} /sys/Bool/True() =
            #{goal = #{node = InductType} /sys/Bool/True()}
            match c
            | false => #{node = Variant} /sys/Bool/True/qed()
            | true =>
                let u: /sys/Bool/Holds(k(0)) = #{node = Variant} /sys/Bool/True/qed();
                #{node = Variant} /sys/Bool/True/qed()
            end;
        #{node = Variant} /sys/Bool/True/qed()
    end)(
    false,
    (n2: #NatType) => n2,
    (n3: #NatType) => #NatEql(n3, 1),
    0,
    1,
    #{node = Variant} /sys/Bool/True/qed())
