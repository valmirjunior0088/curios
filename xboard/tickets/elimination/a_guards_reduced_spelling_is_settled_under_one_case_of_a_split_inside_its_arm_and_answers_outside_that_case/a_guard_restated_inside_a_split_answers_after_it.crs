-- `a_guard_settled_where_its_operands_are_units.crs` typed through a motive, so no declared result settles the guard before the split: `inside` asks for the guard's spelling in the split's `true` arm, where `p` and `q` are units and it is `k(0)`. The recorded guard steps aside in that arm and is settled only outside it, with `c` open, where `h(p)` and `h(q)` are apart, so `after` is refused at `Holds(k(0))`.
use /std/{Nat, Bool};
use /std/Bool/{True, False, Holds};

let F(c: Bool) -> Type =
    match c | true => {} | false => Nat end;

let f(
    P: ((Nat) -> Bool) -> Prop,
    c: Bool,
    h: (F(c)) -> Nat,
    k: (Nat) -> Bool,
    p: F(c),
    q: F(c),
    into: (Holds(k(0))) -> P(k),
) -> (Holds(match h(p) == h(q) | true => k(0) | false => k(1) end)) -> P(k) =
    match match h(p) == h(q) | true => k(0) | false => k(1) end: (b) => (Holds(b)) -> P(k)
    | true =>
        (_: Holds(true)) =>
            let split: {} =
                match c
                | false => ()
                | true =>
                    let inside: Holds(k(0) || true) = True/qed();
                    ()
                end;
            let after: Holds(k(0)) = True/qed();
            into(after)
    | false => (g: Holds(false)) => match g end
    end;

f(
    (k: (Nat) -> Bool) => Holds(k(0)),
    false,
    (n: Nat) => n,
    (n: Nat) => n == 1,
    0,
    1,
    (x: Holds(0 == 1)) => x)(
    True/qed())
