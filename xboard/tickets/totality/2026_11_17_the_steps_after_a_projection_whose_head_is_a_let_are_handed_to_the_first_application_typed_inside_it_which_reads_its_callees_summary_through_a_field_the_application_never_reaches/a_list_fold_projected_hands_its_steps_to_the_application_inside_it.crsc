-- The tuple carrier's recursion with a list fold as the projected head: its list, holding `/g(n, …)`, is typed before its initial value, a tuple that applies the callback at `n`, which the fold answers.
let /g: (n: #NatType, u: (#NatType) -> #NatType) -> {
    #NatType,
    ((#NatType) -> #{node = InductType} /sys/Bool/False()) -> #NatType} =
    (n: #NatType, u: (#NatType) -> #NatType) =>
        (
            u(0),
            (f: (#NatType) -> #{node = InductType} /sys/Bool/False()) =>
                #{goal = #NatType}
                match n | 0 => 0 | k + 1 => #{goal = #NatType} match f(k) end end);

#{node = Rec, proof = true}
let /spin: (n: #NatType) -> #{node = InductType} /sys/Bool/False() =
    (n: #NatType) =>
        #ListFold(
            {#NatType, ((#NatType) -> #{node = InductType} /sys/Bool/False()) -> #NatType},
            {
                #NatType,
                ((#NatType) -> #{node = InductType} /sys/Bool/False()) ->
                    #{node = InductType}
                    /sys/Bool/False()},
            #List(
                {#NatType, ((#NatType) -> #{node = InductType} /sys/Bool/False()) -> #NatType},
                [/g(n, (x: #NatType) => x)]),
            (0, (f: (#NatType) -> #{node = InductType} /sys/Bool/False()) => f(n)),
            (
                item: {
                    #NatType,
                    ((#NatType) -> #{node = InductType} /sys/Bool/False()) -> #NatType},
                acc: {
                    #NatType,
                    ((#NatType) -> #{node = InductType} /sys/Bool/False()) ->
                        #{node = InductType}
                        /sys/Bool/False()}) => acc).1((c: #NatType) => /spin(c));

/spin(0)
