-- `read` is the match on `p` that reads its payload back.
-- A match on a proposition whose indices pin its payload fired on the type its scrutinee was assumed at, so `read` was `b` wherever `p : Read(b)` and named `p` and not `b`. The `true` arm of the match on `b` re-types `p` at `Read(true)`, where `read` was `true` and `Holds(read)` `True`, and the certifier remembered that reduct under `read`. Leaving the arm puts `p` back at `Read(b)` and drops no case equation, and the reducts remembered of terms naming a local were cleared on the way out only where one was dropped. So the `qed` after the match was checked at a `Holds(read)` that still answered `True`, for every `b`, and at `false` what it proved is `Holds(false)`. A bracket that closes an arm's re-typing now clears them as the re-typing does; and the match states the instance it eliminates, so the arm's case is a substitution into it and what is remembered inside the arm is remembered of another term. After the arm `Holds(read)` is `Holds(b)`, which `qed` does not inhabit.
induct /Read: (i: #BoolType) -> pub Prop
| mk(x: #BoolType): (x)
end

((b: #BoolType, p: #{node = InductType} /Read()(b)) =>
    ((w: #{node = InductType} /sys/Bool/True()) =>
        (
            k: /sys/Bool/Holds(
                #{goal = #BoolType, cases = {stated = #{node = InductType} /Read()(b)}}
                match p | mk(x) => x end)) => k)(
        #{goal = #{node = InductType} /sys/Bool/True()}
        match b
        | false => #{node = Variant} /sys/Bool/True/qed()
        | true =>
            ((
                h: /sys/Bool/Holds(
                    #{goal = #BoolType, cases = {stated = #{node = InductType} /Read()(b)}}
                    match p | mk(x2) => x2 end)) => #{node = Variant} /sys/Bool/True/qed())(
                #{node = Variant} /sys/Bool/True/qed())
        end)(#{node = Variant} /sys/Bool/True/qed()))(false, #{node = Variant} /Read/mk(false))
