mod tests;

-- How UTF-8 reads bytes: what a byte begins, how far through a character a walk has come, and the ranges a character in flight can still end in.
mod utf8;
pub use utf8/{classify, step, scan_from, count_scalars};
use utf8/{concluded, advanced, begins_scalars_of};

--- That bytes are well-formed UTF-8, which is what `Str` carries: what that rests on, from any scan state, and what the operations carry it through.
pub mod Valid;
pub use Valid/{let Valid};

--- A position in text: a byte offset at which a character may begin, typed by the text it belongs to.
---
--- Deciding one reads a single byte; that such an offset is where valid text divides into valid text is `Valid/before` and `Valid/after`.
pub mod At;
pub use At/{let At};

-- The walks a search makes: a character a predicate accepts, and a needle's first occurrence, found as bytes.
mod search;
use search/{seek, occurrence, first_occurrence, back_over};

--- How many characters, not bytes, with how a concatenation's count is its halves'.
pub mod length;
pub use length/{let length};

--- The order of two texts, by code point, and its laws.
pub mod ord;
pub use ord/{let ord};

--- A normalization form of UAX #15, which `normalize` brings a text to.
pub mod Form;
pub use Form/{let Form};

-- How a text is brought to a normalization form: each character decomposed, the marks put in canonical order, and the result composed again where the form composes.
mod normalization;
use normalization/{normalized};

use /std/{Char, Nat, Byte, Bytes, Bool, List, Option, Result, Eq, Show, Spell, Ordering, Ord, Hash,
    proved};
use /std/ops/{Eql};
use /std/Bool/{True, Holds};

--- What a byte begins, as UTF-8 reads it.
pub induct Class: pub Type
--- A character of one byte.
| ascii()
--- The first of a character whose remaining `count` bytes must each lie between `lo` and `hi`.
| lead(count: Nat, lo: Nat, hi: Nat, payload: Nat)
--- A byte no character may begin with.
| bad()
end

--- How far through a character a walk over bytes has come.
pub induct Scan: pub Type
--- Between characters, where a new one may begin.
| lead()
--- Inside a character, with `remaining` bytes still owed, each between `lo` and `hi`.
| cont(remaining: Nat, lo: Nat, hi: Nat)
--- Past a byte the encoding does not admit, which nothing recovers from.
| bad()
end

--- Text: bytes certified as UTF-8.
pub struct Str: pub Type {
    bytes: Bytes,
    --- Why they are well-formed UTF-8.
    @valid: Valid(bytes),
}

--- The UTF-8 bytes.
pub let to_bytes(s: Str) -> Bytes =
    s.bytes;

-- Each byte is put to `scan_from` by itself rather than to `step`: only bytes that are not text are read here, and a second caller of `step` would keep it from being folded into the scan every `of_bytes` runs.
--- How many of the bytes read so far are text once `rest` has been read from `sc`. On a byte UTF-8 does not admit, or at an end inside a character, it is `last`, the last offset that fell between characters. `read` counts the bytes before `rest`.
let text_before(sc: Scan, rest: Bytes, read: Nat, last: Nat) -> Nat =
    match rest
    | 0x[] => last
    | 0x[h, ..t] =>
        match scan_from(sc, 0x[h])
        | lead() => text_before(Scan/lead(), t, read + 1, read + 1)
        | cont(rem, lo, hi) => text_before(Scan/cont(rem, lo, hi), t, read + 1, last)
        | bad() => last
        end
    end;

--- The text the bytes encode, or where they stop being text: the length of their longest prefix that is well-formed UTF-8, which is where the first character that is not begins.
pub let of_bytes(b: Bytes) -> Result(Nat, Str) =
    match Valid/try(Scan/lead(), b)
    | some(v) => Result/success(Str { bytes = b })
    | none() => Result/failure(text_before(Scan/lead(), b, 0, 0))
    end;

-- U+FFFD, which stands where bytes are no text.
let replacement: Char =
    '\u{FFFD}';

-- The character the scalar `n` is, or U+FFFD where it is none.
let scalar(n: Nat) -> Char =
    match Char/of_nat(n) | some(c) => c | none() => replacement end;

-- A decoding that replaces what is not text after `c` begins a character: its scan, the bits of the character in flight, and the characters read, newest first.
let begun(c: Byte, read: List(Char)) -> {Scan, Nat, List(Char)} =
    match classify(c)
    | ascii() => (Scan/lead(), 0, [scalar(Byte/to_nat(c)), ..read])
    | lead(count, lo, hi, payload) => (Scan/cont(count, lo, hi), payload, read)
    | bad() => (Scan/lead(), 0, [replacement, ..read])
    end;

-- `at` with `c` read: a byte the character in flight admits goes into it, and one it does not ends it as U+FFFD and begins anew.
let replaced(c: Byte, at: {Scan, Nat, List(Char)}) -> {Scan, Nat, List(Char)} =
    let (scan, bits, read) = at;
    let n = Byte/to_nat(c);
    match scan
    | cont(remaining, lo, hi) =>
        match
        | Bool/not(Nat/in_range(n, lo, hi)) => begun(c, [replacement, ..read])
        | remaining == 1 => (Scan/lead(), 0, [scalar(bits * 64 + n % 64), ..read])
        | _ => (Scan/cont(remaining - 1, 0x80, 0xBF), bits * 64 + n % 64, read)
        end
    | _ => begun(c, read)
    end;

--- The text the bytes encode, each maximal ill-formed subsequence replaced by U+FFFD as Unicode's substitution practice and the Encoding Standard's UTF-8 decoder replace it: one for a byte no character begins with, one for a character a byte it cannot hold cuts short, and one for a character the bytes end inside. Well-formed bytes are the text they are.
pub let of_bytes_lossy(b: Bytes) -> Str =
    match of_bytes(b)
    | success(s) => s
    | failure(_) =>
        let (scan, _, read) = Bytes/fold(b, (Scan/lead(), 0, []), replaced);
        let chars = match scan | cont(_, _, _) => [replacement, ..read] | _ => read end;
        flatten(List/map(List/reverse(chars), of_char))
    end;

--- The one-character string.
pub let of_char(c: Char) -> Str =
    Str { bytes = Char/to_utf8(c), @valid = Valid/encoded(c) };

--- Equal bytes are equal strings.
pub let eq_of_bytes(a: Str, b: Str, p: Eq()(a.bytes, b.bytes)) -> Eq()(a, b) =
    Eq/subst(
        (bytes: Bytes) => (valid: Valid(bytes)) -> Eq()(a, Str { bytes = bytes }),
        p,
        (_: Valid(a.bytes)) => Eq/refl())(
        b.valid);

--- `a` then `b`.
pub let concat(a: Str, b: Str) -> Str =
    Str { bytes = 0x[..a.bytes, ..b.bytes], @valid = Valid/concat(a.valid, b.valid) };

--- The text before `at`, cut in O(1).
pub let before(s: Str, at: At(s)) -> Str =
    Str {
        bytes = Bytes/slice(s.bytes, 0, at.offset, @at.within),
        @valid = Valid/before(s.valid, at.offset, at.within, at.boundary) };

--- The text from `at` on, cut in O(1).
pub let after(s: Str, at: At(s)) -> Str =
    Str {
        bytes = Bytes/drop(s.bytes, at.offset, @at.within),
        @valid = Valid/after(s.valid, at.offset, at.within, at.boundary) };

--- The text from `from` to `to`, cut in O(1): what lies before `to` in the text after `from`.
pub let between(s: Str, from: At(s), to: At(s), @ordered: Holds(from.offset <= to.offset)) -> Str =
    before(after(s, from), At/to_after(s, from, to, @ordered));

--- `s` as its extended grapheme clusters, in order: what a reader sees as its characters, each a letter with its marks, an emoji sequence or a flag as one, by the boundaries of [`At/next_grapheme`].
pub let graphemes(s: Str) -> List(Str) =
    At/forward(
        (_: At(s)) => List(Str),
        (p, again) =>
            match At/try_next_grapheme(s, p)
            | none() => []
            | some(cluster) =>
                [between(s, p, cluster.past), ..again(cluster.past, cluster.progress)]
            end,
        At/start(s));

--- The concatenation, in order.
pub let flatten(parts: List(Str)) -> Str =
    List/fold(parts, "", (p, acc) => concat(acc, p));

--- Whether the two are equal.
pub let eql(a: Str, b: Str) -> Bool =
    to_bytes(a) == to_bytes(b);

let lower_ascii_byte(byte: Byte) -> Byte =
    let n = Byte/to_nat(byte);
    match Nat/in_range(n, 'A', 'Z')
    | true => Nat/to_byte((n + 0x20) % 0x80)
    | false => byte
    end;

let lower_ascii_bytes(b: Bytes) -> Bytes =
    Bytes/fold(b, 0x[], (byte, acc) => 0x[..acc, lower_ascii_byte(byte)]);

--- Equality with ASCII letters compared regardless of case; every other character exactly.
pub let eql_ignoring_ascii_case(a: Str, b: Str) -> Bool =
    lower_ascii_bytes(to_bytes(a)) == lower_ascii_bytes(to_bytes(b));

--- `s` in upper case, Unicode's `toUppercase`: each character by its full mapping, `Char/to_upper`, so `straße` becomes `STRASSE`.
pub let to_upper(s: Str) -> Str =
    fold(s, "", (c, written) => concat(written, Char/to_upper(c)));

--- `s` folded for caseless comparison, Unicode's `toCasefold`: each character by its full folding, `Char/to_casefold`, so `Straße` and `STRASSE` both become `strasse`.
pub let to_casefold(s: Str) -> Str =
    fold(s, "", (c, written) => concat(written, Char/to_casefold(c)));

--- `s` in the normalization form `form` (UAX #15), so the spellings Unicode calls equivalent become one: `é` written as one character or as `e` and a combining acute accent is the one character under `nfc()` and the two under `nfd()`, and `ﬁ` becomes `fi` under `nfkc()`. `==` stays a comparison of characters, so a program comparing text from a user, a file name or the web normalizes both sides to one form first.
pub let normalize(s: Str, form: Form) -> Str =
    normalized(s, form);

--- Whether `s` is in the normalization form `form` already: whether normalizing it changes nothing.
pub let is_normalized(s: Str, form: Form) -> Bool =
    normalize(s, form) == s;

--- Whether the two are equal regardless of case, Unicode's default caseless matching: their folds are equal, so `Straße` matches `STRASSE`. Every character's case is read, past ASCII too; `eql_ignoring_ascii_case` is the comparison a protocol that folds ASCII alone reads.
pub let eql_ignoring_case(a: Str, b: Str) -> Bool =
    to_casefold(a) == to_casefold(b);

-- How far `to_lower` has come: the text it has written, whether the last character it read that is not case-ignorable is cased, and a capital sigma it holds back, as what the case-ignorable characters after it lower to, until the next character that is not case-ignorable, or the end, decides whether the sigma ends a word.
struct Lowering: Type {
    written: Str,
    cased: Bool,
    held: Option(Str),
}

--- `s` in lower case, as Unicode's `toLowercase`: each character by its full mapping (`Char/to_lower`), except that a capital sigma ending a word becomes `ς` (`Final_Sigma`: after a cased character and before none, case-ignorable characters skipped), so `ΟΔΟΣ` becomes `οδος`.
pub let to_lower(s: Str) -> Str =
    let settled(written: Str, held: Option(Str), next_cased: Bool) -> Str =
        match held
        | none() => written
        | some(after) =>
            let sigma = match next_cased | true => "σ" | false => "ς" end;
            concat(concat(written, sigma), after)
        end;
    let lowered =
        fold(
            s,
            Lowering { written = "", cased = false, held = Option/none() },
            (c, at) =>
                match at.held
                | some(after), Char/is_case_ignorable(c) =>
                    Lowering { ..at, held = Option/some(concat(after, Char/to_lower(c))) }
                | _ =>
                    let written = settled(at.written, at.held, Char/is_cased(c));
                    match
                    | c == 'Σ', at.cased =>
                        Lowering { written = written, cased = true, held = Option/some("") }
                    | Char/is_case_ignorable(c) =>
                        Lowering {
                            written = concat(written, Char/to_lower(c)),
                            cased = at.cased,
                            held = Option/none() }
                    | _ =>
                        Lowering {
                            written = concat(written, Char/to_lower(c)),
                            cased = Char/is_cased(c),
                            held = Option/none() }
                    end
                end);
    settled(lowered.written, lowered.held, false);

--- `s` written `n` times.
---
--- Half the copies are built once and joined to themselves, with `s` once more where `n` is odd, so `n` copies take a number of joins logarithmic in `n` and hold each half once.
pub let repeat(s: Str, n: Nat) -> Str =
    match n < 2
    | true => match n | 0 => "" | _ => s end
    | false =>
        let half = repeat(s, n / 2);
        let doubled = concat(half, half);
        match n % 2 | 0 => doubled | _ => concat(doubled, s) end
    end;

-- A character is read whole at its lead byte, its continuation bytes in a line rather than a turn each, so no bits of one are carried from a turn to the next. The walk carries the string's validity between characters, and each byte it reads steps it as the scan does: a byte the encoding does not admit is a contradiction rather than an arm, and the proof that a character in flight can only end at a scalar value goes from byte to byte with it, so every character it hands `f` is built with its proof. Both proofs erase.
--- Left to right over the characters with `f(char, acc)`.
pub let fold(@A: Type, s: Str, init: A, f: (Char, A) -> A) -> A =
    let go(b: Bytes, v: Valid(b), acc: A) -> A =
        match b
        | 0x[] => acc
        | 0x[h, ..t] =>
            match classify(h)
            | ascii() => go(t, v, f(Char { code = Byte/to_nat(h) }, acc))
            | lead(rem, lo, hi, partial) =>
                let p = begins_scalars_of(h);
                match t
                | 0x[] => match v end
                | 0x[c1, ..t1] =>
                    match Nat/in_range(Byte/to_nat(c1), lo, hi)
                    | false => match Valid/from_bad(@t1, v) end
                    | true =>
                        let one = partial * 0x40 + (Byte/to_nat(c1) - 0x80);
                        match rem
                        | 0 => match p end
                        | 1 =>
                            go(
                                t1,
                                v,
                                f(
                                    Char {
                                        code = one,
                                        @valid =
                                            concluded(
                                                lo,
                                                hi,
                                                partial,
                                                Byte/to_nat(c1),
                                                p,
                                                True/qed()) },
                                    acc))
                        | r2 + 2 =>
                            let p1 =
                                advanced(
                                    rem,
                                    lo,
                                    hi,
                                    partial,
                                    Byte/to_nat(c1),
                                    p,
                                    True/qed(),
                                    proved());
                            match t1
                            | 0x[] => match v end
                            | 0x[c2, ..t2] =>
                                match Nat/in_range(Byte/to_nat(c2), 0x80, 0xBF)
                                | false => match Valid/from_bad(@t2, v) end
                                | true =>
                                    let two = one * 0x40 + (Byte/to_nat(c2) - 0x80);
                                    match r2
                                    | 0 =>
                                        go(
                                            t2,
                                            v,
                                            f(
                                                Char {
                                                    code = two,
                                                    @valid =
                                                        concluded(
                                                            0x80,
                                                            0xBF,
                                                            one,
                                                            Byte/to_nat(c2),
                                                            p1,
                                                            True/qed()) },
                                                acc))
                                    | r3 + 1 =>
                                        let p2 =
                                            advanced(
                                                rem - 1,
                                                0x80,
                                                0xBF,
                                                one,
                                                Byte/to_nat(c2),
                                                p1,
                                                True/qed(),
                                                proved());
                                        match t2
                                        | 0x[] => match v end
                                        | 0x[c3, ..t3] =>
                                            match Nat/in_range(Byte/to_nat(c3), 0x80, 0xBF)
                                            | false => match Valid/from_bad(@t3, v) end
                                            | true =>
                                                match r3
                                                | 0 =>
                                                    go(
                                                        t3,
                                                        v,
                                                        f(
                                                            Char {
                                                                code =
                                                                    two * 0x40
                                                                        + (Byte/to_nat(c3) - 0x80),
                                                                @valid =
                                                                    concluded(
                                                                        0x80,
                                                                        0xBF,
                                                                        two,
                                                                        Byte/to_nat(c3),
                                                                        p2,
                                                                        True/qed()) },
                                                            acc))
                                                | _ + 1 => match p end
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            | bad() => match Valid/from_bad(@t, v) end
            end
        end;
    go(s.bytes, s.valid, init);

--- What a walk over the bytes of `whole` answers: how many it took, which lie within `whole`, that a character may begin past them, and the character it stopped before, or `none` at the end.
let Leading(whole: Bytes) -> Type =
    {
        taken: Nat,
        within: Holds(taken <= Bytes/length(whole)),
        boundary: Holds(At/starts(Bytes/drop(whole, taken, @within))),
        stop: Option(Char)};

--- A walk over `whole` that stands `taken` bytes in, before `passed` and then `t`, stands before `t` once it passes `passed`.
let passing(
    @whole: Bytes,
    @passed: Bytes,
    @t: Bytes,
    taken: Nat,
    w: Holds(taken <= Bytes/length(whole)),
    e: Eq()(Bytes/drop(whole, taken, @w), 0x[..passed, ..t]),
) -> {
    within: Holds(taken + Bytes/length(passed) <= Bytes/length(whole)),
    cut: Eq()(Bytes/drop(whole, taken + Bytes/length(passed), @within), t)} =
    let room: Holds(Bytes/length(passed) <= Bytes/length(Bytes/drop(whole, taken, @w))) =
        Eq/subst((b: Bytes) => Holds(Bytes/length(passed) <= Bytes/length(b)), Eq/sym(e), proved());
    (
        within = proved(),
        cut =
            Eq/subst(
                (b: Bytes) =>
                    (q: Holds(Bytes/length(passed) <= Bytes/length(b))) -> Eq()(
                        Bytes/drop(b, Bytes/length(passed), @q),
                        t),
                Eq/sym(e),
                (_) => Eq/refl())(
                room));

--- Where a walk over the bytes of `whole` stops, `taken` bytes in, before `b` and the character `stop` begins it with: valid bytes begin where a character may.
let stopped(
    @whole: Bytes,
    @b: Bytes,
    v: Valid(b),
    taken: Nat,
    stop: Option(Char),
    @w: Holds(taken <= Bytes/length(whole)),
    @e: Eq()(Bytes/drop(whole, taken, @w), b),
) -> Leading(whole) =
    (
        taken = taken,
        within = w,
        boundary = Eq/subst((x: Bytes) => Holds(At/starts(x)), Eq/sym(e), Valid/begins(v)),
        stop = stop);

--- How many bytes at the front of `b` hold characters `pred` accepts, counted on from `taken`, and the first character it refused. It decodes as [`fold`] does. Its place in `whole` is carried as proofs only, so the stop is a position of `whole` without a slice being made.
-- A stop passes the walk's own `b`: filled from the refined type, a hidden argument is `0x[h, ..t]` rebuilt where the walk stands.
let leading(
    b: Bytes,
    v: Valid(b),
    pred: (Char) -> Bool,
    taken: Nat,
    @whole: Bytes,
    @w: Holds(taken <= Bytes/length(whole)),
    @e: Eq()(Bytes/drop(whole, taken, @w), b),
) -> Leading(whole) =
    match b
    | 0x[] => stopped(@whole, @b, v, taken, Option/none(), @w, @e)
    | 0x[h, ..t] =>
        match classify(h)
        | ascii() =>
            let c = Char { code = Byte/to_nat(h) };
            match pred(c)
            | true =>
                let step = passing(@whole, @0x[h], @t, taken, w, e);
                leading(t, v, pred, taken + 1, @whole, @step.within, @step.cut)
            | false => stopped(@whole, @b, v, taken, Option/some(c), @w, @e)
            end
        | lead(rem, lo, hi, partial) =>
            let p = begins_scalars_of(h);
            match t
            | 0x[] => match v end
            | 0x[c1, ..t1] =>
                match Nat/in_range(Byte/to_nat(c1), lo, hi)
                | false => match Valid/from_bad(@t1, v) end
                | true =>
                    let one = partial * 0x40 + (Byte/to_nat(c1) - 0x80);
                    match rem
                    | 0 => match p end
                    | 1 =>
                        let c =
                            Char {
                                code = one,
                                @valid =
                                    concluded(lo, hi, partial, Byte/to_nat(c1), p, True/qed()) };
                        match pred(c)
                        | true =>
                            let step = passing(@whole, @0x[h, c1], @t1, taken, w, e);
                            leading(t1, v, pred, taken + 2, @whole, @step.within, @step.cut)
                        | false => stopped(@whole, @b, v, taken, Option/some(c), @w, @e)
                        end
                    | r2 + 2 =>
                        let p1 =
                            advanced(
                                rem,
                                lo,
                                hi,
                                partial,
                                Byte/to_nat(c1),
                                p,
                                True/qed(),
                                proved());
                        match t1
                        | 0x[] => match v end
                        | 0x[c2, ..t2] =>
                            match Nat/in_range(Byte/to_nat(c2), 0x80, 0xBF)
                            | false => match Valid/from_bad(@t2, v) end
                            | true =>
                                let two = one * 0x40 + (Byte/to_nat(c2) - 0x80);
                                match r2
                                | 0 =>
                                    let c =
                                        Char {
                                            code = two,
                                            @valid =
                                                concluded(
                                                    0x80,
                                                    0xBF,
                                                    one,
                                                    Byte/to_nat(c2),
                                                    p1,
                                                    True/qed()) };
                                    match pred(c)
                                    | true =>
                                        let step =
                                            passing(@whole, @0x[h, c1, c2], @t2, taken, w, e);
                                        leading(
                                            t2,
                                            v,
                                            pred,
                                            taken + 3,
                                            @whole,
                                            @step.within,
                                            @step.cut)
                                    | false => stopped(@whole, @b, v, taken, Option/some(c), @w, @e)
                                    end
                                | r3 + 1 =>
                                    let p2 =
                                        advanced(
                                            rem - 1,
                                            0x80,
                                            0xBF,
                                            one,
                                            Byte/to_nat(c2),
                                            p1,
                                            True/qed(),
                                            proved());
                                    match t2
                                    | 0x[] => match v end
                                    | 0x[c3, ..t3] =>
                                        match Nat/in_range(Byte/to_nat(c3), 0x80, 0xBF)
                                        | false => match Valid/from_bad(@t3, v) end
                                        | true =>
                                            match r3
                                            | 0 =>
                                                let c =
                                                    Char {
                                                        code =
                                                            two * 0x40 + (Byte/to_nat(c3) - 0x80),
                                                        @valid =
                                                            concluded(
                                                                0x80,
                                                                0xBF,
                                                                two,
                                                                Byte/to_nat(c3),
                                                                p2,
                                                                True/qed()) };
                                                match pred(c)
                                                | true =>
                                                    let step =
                                                        passing(
                                                            @whole,
                                                            @0x[h, c1, c2, c3],
                                                            @t3,
                                                            taken,
                                                            w,
                                                            e);
                                                    leading(
                                                        t3,
                                                        v,
                                                        pred,
                                                        taken + 4,
                                                        @whole,
                                                        @step.within,
                                                        @step.cut)
                                                | false =>
                                                    stopped(
                                                        @whole,
                                                        @b,
                                                        v,
                                                        taken,
                                                        Option/some(c),
                                                        @w,
                                                        @e)
                                                end
                                            | _ + 1 => match p end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        | bad() => match Valid/from_bad(@t, v) end
        end
    end;

--- The characters.
pub let to_list(s: Str) -> List(Char) =
    fold(s, [], (c, acc) => [..acc, c]);

-- `count_scalars` splits at the seam of a concatenation whose first half reads to the end, from whatever state the reading starts in — the strengthening `length/concat` needs to descend a byte, where the state has moved.
let count_concat(
    a: Bytes,
    b: Bytes,
    @s: Scan,
    w: Valid/from(s, a),
) -> Eq()(count_scalars(s, 0x[..a, ..b]), count_scalars(s, a) + count_scalars(Scan/lead(), b)) =
    match a
    | 0x[] =>
        match s
        | lead() => Eq/refl()
        | cont(_, _, _) | bad() => match w end
        end
    | 0x[h, ..t] =>
        match s
        | lead() => Eq/cong((n: Nat) => n + 1, count_concat(t, b, @step(h, Scan/lead()), w))
        | cont(_, _, _) => count_concat(t, b, @step(h, s), w)
        | bad() => count_concat(t, b, @step(h, Scan/bad()), w)
        end
    end;

--- Whether there are no characters.
pub let is_empty(s: Str) -> Bool =
    Bytes/length(to_bytes(s)) == 0;

--- Where the first character `pred` accepts is, or `none`.
pub let find_index(s: Str, pred: (Char) -> Bool) -> Option(At(s)) =
    Option/map(seek(s, At/start(s), pred), (found) => found.at);

--- Where the first `target` is, or `none`.
pub let index_of(s: Str, target: Char) -> Option(At(s)) =
    find_index(s, (c) => c == target);

--- The first character `pred` accepts, or `none`.
pub let find(s: Str, pred: (Char) -> Bool) -> Option(Char) =
    Option/map(seek(s, At/start(s), pred), (found) => found.char);

--- Whether `target` occurs in `s`.
pub let contains(s: Str, target: Char) -> Bool =
    Option/is_some(index_of(s, target));

--- `parts` with `sep` between each pair.
pub let join(sep: Str, parts: List(Str)) -> Str =
    List/balanced(
        List/length(parts),
        "",
        (i, ok) => List/get(@Str, parts, i, @ok),
        (l, r) => concat(concat(l, sep), r));

--- Bytes are what lies before `k` followed by what lies from `k` on.
let split_at(
    b: Bytes,
    k: Nat,
    within: Holds(k <= Bytes/length(b)),
) -> Eq()(b, 0x[..Bytes/slice(b, 0, k, @within), ..Bytes/drop(b, k, @within)]) =
    match k
    | 0 => Eq/refl()
    | j + 1 =>
        match b
        | 0x[] => match within end
        | 0x[h, ..t] => Eq/cong((r: Bytes) => 0x[h, ..r], split_at(t, j, within))
        end
    end;

-- Compared as bytes, UTF-8 encoding each character one way: valid text that holds a valid piece's bytes at a boundary holds its characters, and goes on past them as valid text, so the position past it is a boundary with no character decoded.
--- Where `piece` follows `from` in `s`: the position past it, which is not before `from`, or `none` when `s` does not hold it there.
pub let follows(
    s: Str,
    from: At(s),
    piece: Str,
) -> Option({past: At(s), reach: Holds(from.offset <= past.offset)}) =
    let rest = after(s, from);
    let n = Bytes/length(piece.bytes);
    match Bool/holds(n <= Bytes/length(rest.bytes))
    | some(fits), Bytes/slice(rest.bytes, 0, n, @fits) == piece.bytes =>
        let onward: Valid(Bytes/drop(rest.bytes, n, @fits)) =
            Valid/after_prefix(
                piece.valid,
                Eq/subst(
                    (p: Bytes) => Valid(0x[..p, ..Bytes/drop(rest.bytes, n, @fits)]),
                    proved(@Eq()(Bytes/slice(rest.bytes, 0, n, @fits), piece.bytes)),
                    Eq/subst((w: Bytes) => Valid(w), split_at(rest.bytes, n, fits), rest.valid)));
        Option/some((
            past = At { offset = from.offset + n, @_, @boundary = Valid/begins(onward) },
            reach = proved()))
    | _ => Option/none()
    end;

--- The position past the longest run of characters from `from` that `pred` accepts, which is not before `from`: one walk over the bytes from `from`, which stops at the first character refused or at the end, its position built where it stops.
pub let span(
    s: Str,
    from: At(s),
    pred: (Char) -> Bool,
) -> {past: At(s), reach: Holds(from.offset <= past.offset)} =
    let rest = after(s, from);
    let walked = leading(rest.bytes, rest.valid, pred, 0, @rest.bytes, @proved(), @Eq/refl());
    (
        past = At { offset = from.offset + walked.taken, @_, @boundary = walked.boundary },
        reach = proved());

--- Where `needle` first occurs in `s`, or `none`; an empty needle occurs at the start.
pub let index_of_substr(s: Str, needle: Str) -> Option(At(s)) =
    Option/map(first_occurrence(s, needle), (found) => found.start);

--- Without leading and trailing whitespace: what `Char/is_whitespace` accepts, Unicode's `White_Space`.
pub let trim(s: Str) -> Str =
    trim_end(trim_start(s));

--- Without leading whitespace, as `trim` reads it.
pub let trim_start(s: Str) -> Str =
    match find_index(s, (c) => Bool/not(Char/is_whitespace(c)))
    | some(at) => after(s, at)
    | none() => ""
    end;

--- Without trailing whitespace, as `trim` reads it.
pub let trim_end(s: Str) -> Str =
    before(s, back_over(s, At/finish(s), Char/is_whitespace));

--- `s` without `prefix` at its front, or `none` when it does not begin with it.
pub let strip_prefix(s: Str, prefix: Str) -> Option(Str) =
    Option/map(follows(s, At/start(s), prefix), (met) => after(s, met.past));

--- `s` without `suffix` at its end, or `none` when it does not end with it: the bytes where it would begin compared with its own, a valid suffix beginning where a character may.
pub let strip_suffix(s: Str, suffix: Str) -> Option(Str) =
    let n = Bytes/length(suffix.bytes);
    match Bool/holds(n <= Bytes/length(s.bytes))
    | some(_), Bytes/drop(s.bytes, Bytes/length(s.bytes) - n) == suffix.bytes =>
        Option/some(
            before(
                s,
                At {
                    offset = Bytes/length(s.bytes) - n,
                    @_,
                    @boundary =
                        Eq/subst(
                            (w: Bytes) => Holds(At/starts(w)),
                            Eq/sym(
                                proved(
                                    @Eq()(
                                        Bytes/drop(s.bytes, Bytes/length(s.bytes) - n),
                                        suffix.bytes))),
                            Valid/begins(suffix.valid)) }))
    | _ => Option/none()
    end;

--- Whether `s` begins with `prefix`.
pub let starts_with(s: Str, prefix: Str) -> Bool =
    Option/is_some(strip_prefix(s, prefix));

--- Whether `s` ends with `suffix`.
pub let ends_with(s: Str, suffix: Str) -> Bool =
    Option/is_some(strip_suffix(s, suffix));

--- The text before the first `sep` and the text after it, or `none` when `sep` does not occur.
pub let split_once(s: Str, sep: Str) -> Option({Str, Str}) =
    Option/map(first_occurrence(s, sep), (found) => (before(s, found.start), after(s, found.past)));

--- Whether `needle` occurs in `s` as a run of characters.
---
--- Not `contains`, which tests for one element here as in `/std/List` and `/std/Bytes`. The rest of the substring family (`starts_with`, `ends_with`, `strip_prefix`, `strip_suffix`, `split_once`, `split`, `replace` and `index_of_substr`) takes a `Str` needle under its usual name, since no other carrier uses those names differently.
pub let has_substr(s: Str, needle: Str) -> Bool =
    Option/is_some(first_occurrence(s, needle));

--- The pieces between occurrences of `sep`, the separators dropped; an empty separator splits into characters.
pub let split(s: Str, sep: Str) -> List(Str) =
    match At/try_next(sep, At/start(sep))
    | none() => List/map(to_list(s), of_char)
    | some(first) =>
        At/forward(
            (_) => (pieces: List(Str)) -> List(Str),
            (at, again) =>
                (pieces) =>
                    match occurrence(s, at, sep, first)
                    | some(found) =>
                        again(found.past, proved())(
                            [..pieces, between(s, at, found.start, @found.ordered)])
                    | none() => [..pieces, after(s, at)]
                    end,
            At/start(s))(
            [])
    end;

--- Every occurrence of `from` replaced by `to`, left to right; an empty `from` changes nothing.
pub let replace(s: Str, from: Str, to: Str) -> Str =
    match At/try_next(from, At/start(from))
    | none() => s
    | some(first) =>
        At/forward(
            (_) => (written: Str) -> Str,
            (at, again) =>
                (written) =>
                    match occurrence(s, at, from, first)
                    | some(found) =>
                        again(found.past, proved())(
                            concat(
                                concat(written, between(s, at, found.start, @found.ordered)),
                                to))
                    | none() => concat(written, after(s, at))
                    end,
            At/start(s))(
            "")
    end;

--- `s` with each character that `with` maps to `some` replaced by its answer. The runs between are copied as slices of `s`, so the result needs no revalidation. Encoders escape through it.
pub let escape(s: Str, with: (Char) -> Option(Str)) -> Str =
    At/forward(
        (at) => (written: Str, run: At(s), ordered: Holds(run.offset <= at.offset)) -> Str,
        (at, again) =>
            (written, run, ordered) =>
                match At/try_next(s, at)
                | none() => concat(written, between(s, run, at, @ordered))
                | some(n) =>
                    match with(n.char)
                    | none() => again(n.past, n.progress)(written, run, proved())
                    | some(replacement) =>
                        again(n.past, n.progress)(
                            concat(concat(written, between(s, run, at, @ordered)), replacement),
                            n.past,
                            Nat/le/refl(n.past.offset))
                    end
                end,
        At/start(s))(
        "",
        At/start(s),
        Nat/le/refl(0));

--- The lines: split on newlines, one trailing carriage return dropped from each, and a final newline closing the last line rather than opening an empty one.
pub let lines(s: Str) -> List(Str) =
    let strip(line: Str) -> Str =
        match strip_suffix(line, "\r")
        | some(bare) => bare
        | none() => line
        end;
    let newline = At/next("\n", At/start("\n"));
    At/forward(
        (_) => (read: List(Str)) -> List(Str),
        (at, again) =>
            (read) =>
                match occurrence(s, at, "\n", newline)
                | some(found) =>
                    again(found.past, proved())(
                        [..read, strip(between(s, at, found.start, @found.ordered))])
                | none() =>
                    let rest = after(s, at);
                    match is_empty(rest)
                    | true => read
                    | false => [..read, strip(rest)]
                    end
                end,
        At/start(s))(
        []);

--- `s` widened to `n` characters with `c` at the front; a string already that wide is unchanged.
pub let pad_start(s: Str, n: Nat, c: Char) -> Str =
    concat(repeat(of_char(c), n - length(s)), s);

--- `s` widened to `n` characters with `c` at the end; a string already that wide is unchanged.
pub let pad_end(s: Str, n: Nat, c: Char) -> Str =
    concat(s, repeat(of_char(c), n - length(s)));

-- Their bytes are one run by `Bytes`'s own law, and a string is its bytes.
let eq_of_eql(a: Str, b: Str, h: Holds(eql(a, b))) -> Eq()(a, b) =
    eq_of_bytes(a, b, proved());

satisfy Eql(Str) {
    eql = eql,
    eq = eq_of_eql,
    refl(_) = True/qed(),
}

satisfy Show(Str) {
    show(s) = s,
}

--- A string literal, escaped where the literal grammar needs it.
satisfy Spell(Str) {
    spell(s) =
        let body =
            fold(s, "", (c, acc) =>
                concat(
                    acc,
                    match c
                    | '\n' => "\\n"
                    | '\t' => "\\t"
                    | '\r' => "\\r"
                    | '\\' => "\\\\"
                    | '"' => "\\\""
                    | _ => of_char(c)
                    end));
        concat("\"", concat(body, "\"")),
}

-- Each law is `Bytes`'s at the two texts' bytes, which `ord` reads a text through.
satisfy Ord(Str) {
    ord = ord,
    lt(a, b) = Ordering/is_lt(ord(a, b)),
    le(a, b) = Ordering/is_le(ord(a, b)),
    flips(a, b) = Ord/flips(to_bytes(a), to_bytes(b)),
    trans(a, b, c, p, q) = Ord/trans(to_bytes(a), to_bytes(b), to_bytes(c), p, q),
    eq(a, b, h) = eq_of_bytes(a, b, Ord/eq(to_bytes(a), to_bytes(b), h)),
    is_lt(_, _) = Eq/refl(),
    is_le(_, _) = Eq/refl(),
}

--- The UTF-8 bytes.
satisfy Hash(Str) {
    hash = to_bytes,
}

--- The UTF-8 bytes, whose order is a text's.
satisfy Hash/Key(Str) {
    mono(_, _) = Eq/refl(),
}
