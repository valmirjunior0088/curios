use /std/{Str, Nat, Bool, Show, Spell, Fmt};
use /std/ops/{Eql};

--- Why a parser refused.
pub struct Error: pub Type {
    --- What it wanted.
    message: Str,
    --- The byte offset it stopped at.
    offset: Nat,
    --- Whether the input was recognized as the shape the parser was reading, so an enclosing `or` reports the refusal rather than trying an alternative.
    committed: Bool,
}

satisfy Eql(Error) {
    ..
}

satisfy Spell(Error) {
    ..
}

--- A refusal at `offset`, open to an alternative.
pub let declined(message: Str, offset: Nat) -> Error =>
    Error { message = message, offset = offset, committed = false };

--- Of two refusals, the one that got further into the input, or the first on a tie. An `or` reports it when neither alternative committed: the one that got further matched more of the input, and on a tie the alternative written first is the reading the grammar leads with.
pub let further(e: Error, f: Error) -> Error =>
    match e.offset < f.offset | true => f | false => e end;

--- `e` as committed.
pub let commit(e: Error) -> Error =>
    Error { message = e.message, offset = e.offset, committed = true };

--- The refusal as a line: the message, then where.
pub let to_str(e: Error) -> Str =>
    Fmt/render("% at byte %")(e.message)(e.offset);

--- Shown as `to_str` spells it.
satisfy Show(Error) {
    show = to_str,
}
