use /std/{List, Bool, Eq, Ord};
use /std/List/{Member, ordered};
use /std/Bool/{True, Holds};

--- Every element of a list stands in `le` to every element after it.
---
--- `ordered` says it of adjacent elements; the two agree where `le` is transitive (`of_ordered`), and this is the one a proof reads an element and a later one from.
pub induct Pairwise(@T: Type, le: (T, T) -> Bool): (List(T)) -> pub Prop
| empty(): ([])
--- An element in `le` to everything after it, ahead of a list that is pairwise.
| cons(
    @x: T,
    @l: List(T),
    head: (y: T, Member()(y, l)) -> Holds(le(x, y)),
    rest: Pairwise(le)(l)): ([x, ..l])
end

pub use Pairwise/*;

--- The first element stands in `le` to every later one.
pub let head(
    @T: Type,
    @le: (T, T) -> Bool,
    @h: T,
    @t: List(T),
    whole: Pairwise(le)([h, ..t]),
) -> (y: T, Member()(y, t)) -> Holds(le(h, y)) =
    let cons(head, _) = whole;
    head;

--- The tail of a pairwise list is pairwise.
pub let tail(
    @T: Type,
    @le: (T, T) -> Bool,
    @h: T,
    @t: List(T),
    whole: Pairwise(le)([h, ..t]),
) -> Pairwise(le)(t) =
    match whole | cons(_, rest) => rest end;

-- An element that leads a list in order stands in a transitive `le` to each of its members.
let below(
    @T: Type,
    le: (T, T) -> Bool,
    trans: Ord/Trans(le),
    l: List(T),
    a: T,
    lead: Holds(ordered/leads(le, a, l)),
    given: Holds(ordered(l, le)),
    y: T,
    i: Member()(y, l),
) -> Holds(le(a, y)) =
    match l
    | [] => match Member/absent(i) end
    | [k, ..r] =>
        Member/uncons(
            i,
            (e) => Eq/subst((z: T) => Holds(le(a, z)), Eq/sym(e), lead),
            (rest) =>
                trans(
                    a,
                    k,
                    y,
                    lead,
                    below(
                        le,
                        trans,
                        r,
                        k,
                        ordered/head(le, k, r, given),
                        ordered/tail(le, k, r, given),
                        y,
                        rest)))
    end;

--- A list in order by a transitive `le` at adjacent elements is in order at every pair.
pub let of_ordered(
    @T: Type,
    le: (T, T) -> Bool,
    trans: Ord/Trans(le),
    l: List(T),
    given: Holds(ordered(l, le)),
) -> Pairwise(le)(l) =
    match l
    | [] => Pairwise/empty()
    | [h, ..t] =>
        Pairwise/cons(
            (y, i) =>
                below(
                    le,
                    trans,
                    t,
                    h,
                    ordered/head(le, h, t, given),
                    ordered/tail(le, h, t, given),
                    y,
                    i),
            of_ordered(le, trans, t, ordered/tail(le, h, t, given)))
    end;

--- A relation that holds of every pair has every list pairwise in it.
pub let everywhere(
    @T: Type,
    @le: (T, T) -> Bool,
    holds: (a: T, b: T) -> Holds(le(a, b)),
    l: List(T),
) -> Pairwise(le)(l) =
    match l
    | [] => Pairwise/empty()
    | [h, ..t] => Pairwise/cons((y, _) => holds(h, y), everywhere(holds, t))
    end;

--- Two pairwise lists are pairwise joined, where every element of the first stands in `le` to every element of the second.
pub let joined(
    @T: Type,
    @le: (T, T) -> Bool,
    a: List(T),
    @b: List(T),
    first: Pairwise(le)(a),
    second: Pairwise(le)(b),
    across: (x: T, y: T, Member()(x, a), Member()(y, b)) -> Holds(le(x, y)),
) -> Pairwise(le)([..a, ..b]) =
    match a
    | [] => second
    | [h, ..t] =>
        Pairwise/cons(
            (y, i) =>
                Member/split(
                    t,
                    i,
                    (in_first) => head(first)(y, in_first),
                    (in_second) => across(h, y, Member/here(), in_second)),
            joined(t, tail(first), second, (x, y, i, j) => across(x, y, Member/there(i), j)))
    end;

--- A pairwise list is in order at adjacent elements: what `of_ordered` asks transitivity for, the other way round, asks nothing.
pub let adjacent(
    @T: Type,
    le: (T, T) -> Bool,
    l: List(T),
    whole: Pairwise(le)(l),
) -> Holds(ordered(l, le)) =
    match l
    | [] => True/qed()
    | [h, ..t] =>
        ordered/cons(
            le,
            h,
            t,
            match t
            | [] => True/qed()
            | [k, .._] => head(whole)(k, Member/here())
            end,
            adjacent(le, t, tail(whole)))
    end;
