use /std/{Nat, Char, Option, Str, proved};
use /std/Char/{Valid};
use /std/Bool/{Holds};

-- The Hangul syllables, U+AC00 through U+D7A3, decompose and compose by arithmetic (The Unicode Standard, §3.12): the syllable `0xAC00 + (l * 21 + v) * 28 + t` is the leading consonant `0x1100 + l` of 19, the vowel `0x1161 + v` of 21, and, where `t` is not `0`, the trailing consonant `0x11A7 + t` of 27, so 588 syllables share a leading consonant and there are 11,172.
-- The jamo the syllable at `offset` past U+AC00 decomposes to: its leading consonant, its vowel, and its trailing consonant where it has one.
let syllable_decomposed(offset: Nat, @inside: Holds(offset < 11172)) -> Str =>
    let leading_bound: Holds(offset / 588 < 19) =
        Nat/DivMod/div_lt_of_lt_mul(19, offset, 588, proved());
    let trailing_bound = Nat/DivMod/of(offset, 28).bounded;
    let leading = 0x1100 + offset / 588;
    let vowel = 0x1161 + offset % 588 / 28;
    let first =
        Str/concat(
            Str/of_char(
                Char { code = leading, @valid = Valid/below_surrogates(leading, proved()) }),
            Str/of_char(Char { code = vowel, @valid = Valid/below_surrogates(vowel, proved()) }));
    match offset % 28
    | 0 => first
    | _ =>
        let trailing = 0x11A7 + offset % 28;
        Str/concat(
            first,
            Str/of_char(
                Char { code = trailing, @valid = Valid/below_surrogates(trailing, proved()) }))
    end;

-- The jamo `c` decomposes to where it is a Hangul syllable, or `none` where it is none.
pub let decomposed(c: Char) -> Option(Str) =>
    let code = Char/to_nat(c);
    match
    | 0xAC00 <= code && code < 0xAC00 + 11172 => Option/some(syllable_decomposed(code - 0xAC00))
    | _ => Option/none()
    end;

-- The syllable `first` then `second` compose to, the jamo of a leading consonant and a vowel or a syllable of no trailing consonant and a trailing one, or `none` where they are no such pair.
pub let composed(first: Char, second: Char) -> Option(Char) =>
    let a = Char/to_nat(first);
    let b = Char/to_nat(second);
    match
    | 0x1100 <= a && a < 0x1100 + 19 && 0x1161 <= b && b < 0x1161 + 21 =>
        let code = 0xAC00 + ((a - 0x1100) * 21 + (b - 0x1161)) * 28;
        Option/some(Char { code = code, @valid = Valid/below_surrogates(code, proved()) })
    | 0xAC00 <= a && a < 0xAC00 + 11172 && (a - 0xAC00) % 28 == 0 && 0x11A7 < b
        && b < 0x11A7 + 28 =>
        let code = a + (b - 0x11A7);
        Option/some(Char { code = code, @valid = Valid/below_surrogates(code, proved()) })
    | _ => Option/none()
    end;
