mod tests;

mod encode;
pub use encode/{let encode};

mod decode;
pub use decode/{let decode};

--- An exact decimal number, what a document's number is.
pub mod Number;
pub use Number/{let Number};

use /std/{Bool, Str, List, Spell};
use /std/ops/{Eql};

pub induct Json: pub Type
| null()
--- `true` or `false`.
| bool(Bool)
--- A number, exactly as the document writes it.
| num(Number)
--- A string.
| str(Str)
--- An array, in order.
| arr(List(Json))
--- An object: its members, in the order they were written.
| obj(List({Str, Json}))
end

pub use Json/*;

satisfy Eql(Json) {
    ..
}

satisfy Spell(Json) {
    ..
}
