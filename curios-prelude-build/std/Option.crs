pub use /sys/{let Option};
pub use /sys/Option/{some, none};

use /std/{Bool, Eq, Show, Spell, Fmt, Monad, Result, Ordering, Ord, Hash};
use /std/ops/{Eql};

--- `f` on the value, or `none`.
pub let bind(@A: Sort, @B: Sort, m: Option(A), f: (A) -> Option(B)) -> Option(B) =
    match m | some(a) => f(a) | none() => none() end;

--- `f` on the value, kept as an option.
pub let map(@A: Sort, @B: Sort, m: Option(A), f: (A) -> B) -> Option(B) =
    match m | some(a) => some(f(a)) | none() => none() end;

--- The value, or `default` when there is none.
pub let unwrap_or(@A: Sort, m: Option(A), default: A) -> A =
    match m | some(a) => a | none() => default end;

--- Whether a value is present.
pub let is_some(@A: Sort, m: Option(A)) -> Bool =
    match m | some(_) => true | none() => false end;

--- Whether no value is present.
pub let is_none(@A: Sort, m: Option(A)) -> Bool =
    match m | some(_) => false | none() => true end;

--- `m` when it holds a value, `other` otherwise.
pub let or(@A: Sort, m: Option(A), other: Option(A)) -> Option(A) =
    match m | some(a) => some(a) | none() => other end;

--- `m` when it holds a value, otherwise what `other` answers.
pub let or_else(@A: Sort, m: Option(A), other: () -> Option(A)) -> Option(A) =
    match m | some(a) => some(a) | none() => other() end;

--- The value when `pred` accepts it, `none` otherwise or when there is none.
pub let filter(@A: Sort, m: Option(A), pred: (A) -> Bool) -> Option(A) =
    match m
    | some(a), pred(a) => some(a)
    | _ => none()
    end;

--- An option of an option collapsed to one.
pub let flatten(@A: Sort, m: Option(Option(A))) -> Option(A) =
    match m | some(inner) => inner | none() => none() end;

--- The value as a success, or `e` as the failure.
pub let to_result(@A: Type, @E: Type, m: Option(A), e: E) -> Result(E, A) =
    match m
    | some(a) => Result/success(a)
    | none() => Result/failure(e)
    end;

--- The value, or what `default` answers when there is none.
pub let unwrap_or_else(@A: Sort, m: Option(A), default: () -> A) -> A =
    match m | some(a) => a | none() => default() end;

--- Whether `m` holds a value, as a decided proposition: `Bool/True` at `some` and `Bool/False` at `none`.
---
--- A literal discharges it by reduction, and an option a guard has refined discharges it with nothing written.
pub let IsSome(@A: Sort, m: Option(A)) -> Prop =
    match m | some(_) => Bool/True | none() => Bool/False end;

--- The value, under the evidence that there is one.
pub let get(@A: Sort, m: Option(A), @ok: IsSome(m)) -> A =
    match m
    | some(a) => a
    | none() => match ok end
    end;

--- `some` is injective: two equal options that each hold a value hold one value.
---
--- What lets a decoder take an encoding apart without inventing a value: a reader that answers an option is a function, so `Eq/cong` turns an equation between two encodings into one between the options read, and this turns that into one between the values.
pub let some_injective(@A: Sort, @x: A, @y: A, same: Eq()(some(x), some(y))) -> Eq()(x, y) =
    match same | refl() => Eq/refl() end;

satisfy (@A: Type, use Eql(A)) => Eql(Option(A)) {
    ..
}

satisfy (@A: Type, use Show(A)) => Show(Option(A)) {
    show(m) = match m | some(x) => Fmt/render("some(%)")(x) | none() => "none()" end,
}

satisfy (@A: Type, use Spell(A)) => Spell(Option(A)) {
    ..
}

satisfy Monad(Option) {
    pure = some,
    bind = bind,
}

--- `none` below `some`, and two values by `A`'s order.
pub let ord(@A: Type, use Ord(A), a: Option(A), b: Option(A)) -> Ordering =
    match a
    | none() => match b | none() => Ordering/eq() | some(_) => Ordering/lt() end
    | some(x) => match b | none() => Ordering/gt() | some(y) => Ord/ord(x, y) end
    end;

-- Each law by the cases of its values: two `some`s by `A`'s own law, and any other pair by what `ord` answers there. `Eql` of an element type is a premise beside `Ord` of it, which holds one: the witness's own superclass is then built from a premise handed whole, where one built from the superclass inside `Ord` is a use of that premise the totality check does not follow, and a family nested through this witness would have no lawful `Ord`.
satisfy (@A: Type, use Eql(A), use Ord(A)) => Ord(Option(A)) {
    ord = ord,
    lt(a, b) = Ordering/is_lt(ord(a, b)),
    le(a, b) = Ordering/is_le(ord(a, b)),
    flips(a, b) =
        match a
        | none() => match b | none() => Eq/refl() | some(_) => Eq/refl() end
        | some(x) => match b | none() => Eq/refl() | some(y) => Ord/flips(x, y) end
        end,
    transitive(a, b, c, p, q) =
        match a
        | none() => match c | none() => Bool/True/qed() | some(_) => Bool/True/qed() end
        | some(x) =>
            match b
            | none() => match p end
            | some(y) =>
                match c
                | none() => match q end
                | some(z) => Ord/transitive(x, y, z, p, q)
                end
            end
        end,
    eq_of_ord(a, b, h) =
        match a
        | none() =>
            match b
            | none() => Eq/refl()
            | some(_) => match h end
            end
        | some(x) =>
            match b
            | none() => match h end
            | some(y) =>
                let refl() = Ord/eq_of_ord(x, y, h);
                Eq/refl()
            end
        end,
    lt_of_ord(_, _) = Eq/refl(),
    le_of_ord(_, _) = Eq/refl(),
}

satisfy (@A: Type, use Hash(A)) => Hash(Option(A)) {
    hash(value) =
        match value
        | none() => Hash/tagged(0, [])
        | some(inner) => Hash/tagged(1, [Hash/hash(inner)])
        end,
}
