use /std/{Str, Option, Spell, Show};
use /std/ops/{Eql};

--- The request's method.
pub induct Method: pub Type
| get()
| head()
| post()
| put()
| delete()
| patch()
| options()
end

pub use Method/*;

satisfy Eql(Method) {
    ..
}

satisfy Spell(Method) {
    ..
}

--- The method as the wire spells it.
pub let to_str(m: Method) -> Str =>
    match m
    | get() => "GET"
    | head() => "HEAD"
    | post() => "POST"
    | put() => "PUT"
    | delete() => "DELETE"
    | patch() => "PATCH"
    | options() => "OPTIONS"
    end;

--- Shown as the wire spells it.
satisfy Show(Method) {
    show = to_str,
}

--- The method `s` spells, or `none`.
pub let of_str(s: Str) -> Option(Method) =>
    match s
    | "GET" => Option/some(Method/get())
    | "HEAD" => Option/some(Method/head())
    | "POST" => Option/some(Method/post())
    | "PUT" => Option/some(Method/put())
    | "DELETE" => Option/some(Method/delete())
    | "PATCH" => Option/some(Method/patch())
    | "OPTIONS" => Option/some(Method/options())
    | _ => Option/none()
    end;
