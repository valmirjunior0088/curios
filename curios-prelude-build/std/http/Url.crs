--- A URL's scheme, `http` or `https`, and the port it implies.
pub mod Scheme;
pub use Scheme/{let Scheme};

use /std/{Bytes, Byte, Char, Str, Nat, Bool, List, Option, Result, Parse, Spell, Fmt};
use /std/ops/{Eql};
use /std/http/{Field};

--- Where a request goes. A fragment is the client's and is dropped.
pub struct Url: pub Type {
    scheme: Scheme,
    host: Str,
    port: Nat,
    path: Str,
    --- As written after `?`, where there is one.
    query: Option(Str),
}

satisfy Eql(Url) {
    ..
}

satisfy Spell(Url) {
    ..
}

let until(stops: List(Char)) -> (Char) -> Bool =
    (c) => Bool/not(List/any(stops, (stop) => c == stop));

-- Whether the wire carries `b` as it is: visible ASCII.
let visible(b: Byte) -> Bool =
    Nat/in_range(Byte/to_nat(b), 33, 126);

-- One part of a URL. A space, a control octet and an octet past ASCII have no place in one: each is written percent-encoded, and one left bare is refused.
let part(s: Str) -> Parse(Str, Str) =
    match Bytes/all(Str/to_bytes(s), visible)
    | true => Parse/pure(s)
    | false =>
        Parse/fail(
            "a URL holds no space, control octet or octet past ASCII, each of which is written percent-encoded")
    end;

let scheme() -> Parse(Str, Scheme) =
    let name = Parse/str/take_while(until([':']))!;
    let () = Parse/str/literal("://")!;
    match
    | Str/eql_ignoring_ascii_case(name, "http") => Parse/pure(Scheme/http())
    | Str/eql_ignoring_ascii_case(name, "https") => Parse/pure(Scheme/https())
    | _ => Parse/fail(Fmt/render("unknown scheme '%'")(name))
    end;

-- Whether the authority ends here: at the path, the query, the fragment, or the end of the text.
let ends_authority(next: Option(Char)) -> Bool =
    match next
    | some(c) => match c | '/' | '?' | '#' => true | _ => false end
    | none() => true
    end;

-- The port after a `:`: its digits up to where the authority ends. None is the scheme's, as RFC 3986 §3.2.3 reads an empty port, and a number no port holds is refused here rather than at the connection.
let port_number(s: Scheme) -> Parse(Str, Nat) =
    let _ = Parse/str/expect(':')!;
    let digits = Parse/str/take_while(Char/is_ascii_digit)!;
    let next = Parse/str/peek!;
    match
    | Bool/not(ends_authority(next)) => Parse/fail("a port is a number")
    | Str/is_empty(digits) => Parse/pure(Scheme/default_port(s))
    | some(n) = Nat/of_str(digits) =>
        match n <= 65535
        | true => Parse/pure(n)
        | false => Parse/fail("a port is at most 65535")
        end
    | _ => Parse/fail("a port is a number")
    end;

let port_of(s: Scheme) -> Parse(Str, Nat) =
    let next = Parse/str/peek!;
    match next
    | some(c), Char/to_nat(c) == ':' => port_number(s)
    | _ => Parse/pure(Scheme/default_port(s))
    end;

let path() -> Parse(Str, Str) =
    let written = Parse/str/take_while(until(['?', '#']))!;
    let s = part(written)!;
    match Str/is_empty(s)
    | true => Parse/pure("/")
    | false => Parse/pure(s)
    end;

let query_text() -> Parse(Str, Option(Str)) =
    let _ = Parse/str/expect('?')!;
    let written = Parse/str/take_while(until(['#']))!;
    let s = part(written)!;
    Parse/pure(Option/some(s));

let query() -> Parse(Str, Option(Str)) =
    let next = Parse/str/peek!;
    match next
    | some(c), Char/to_nat(c) == '?' => query_text()
    | _ => Parse/pure(Option/none())
    end;

let url() -> Parse(Str, Url) =
    let s = scheme()!;
    let h = Parse/str/take_while(until([':', '/', '?', '#']))!;
    let host = part(h)!;
    let p = port_of(s)!;
    let pa = path()!;
    let q = query()!;
    let _ = Parse/str/rest!;
    match Str/is_empty(host)
    | true => Parse/fail("a URL names a host")
    | false => Parse/pure(Url { scheme = s, host = host, port = p, path = pa, query = q })
    end;

--- `s` read as a URL, or why it is not: a scheme other than `http` and `https`, a missing host, or a port that is no number of at most 65535. A port left empty, as in `http://h:/`, is the scheme's.
pub let of_str(s: Str) -> Result(Parse/Error, Url) =
    Parse/run(url(), s);

--- That `r` is a URL that read.
pub let Read(r: Result(Parse/Error, Url)) -> Prop =
    match r | success(_) => Bool/True | failure(_) => Bool/False end;

--- That `s` reads as a URL, decided by reduction: a literal that does not is refused where it is written.
pub let Valid(s: Str) -> Prop =
    Read(of_str(s));

--- The URL the literal `s` spells, at no cost at run time beyond the read.
pub let lit(s: Str, @ok: Valid(s)) -> Url =
    match of_str(s)
    | success(u) => u
    | failure(_) => match ok end
    end;

let port_str(u: Url) -> Str =
    match u.port == Scheme/default_port(u.scheme)
    | true => ""
    | false => Str/concat(":", Nat/to_str(u.port))
    end;

let query_str(q: Option(Str)) -> Str =
    match q | some(s) => Str/concat("?", s) | none() => "" end;

--- The URL as text.
pub let to_str(u: Url) -> Str =
    Str/flatten([Scheme/to_str(u.scheme), "://", u.host, port_str(u), u.path, query_str(u.query)]);

-- Whether `r` opens with a scheme (RFC 3986 §3.1): a letter, then letters, digits, `+`, `-` and `.`, up to a `:`. A reference that does is a URL of its own.
let has_scheme(r: Str) -> Bool =
    match Str/split_once(r, ":")
    | some((name, _)) =>
        match Str/to_list(name)
        | [first, ..rest] =>
            Char/is_ascii_alpha(first)
                && List/all(rest, (c) =>
                    Char/is_ascii_alpha(c) || Char/is_ascii_digit(c) || c == '+' || c == '-'
                        || c == '.')
        | [] => false
        end
    | none() => false
    end;

-- `path` with its `.` and `..` segments removed, as RFC 3986 §5.2.4 removes them: a `.` is dropped and a `..` drops the segment before it, neither climbing past the root, and either one ending the path leaves it ending in `/`.
let without_dots(path: Str) -> Str =
    let walk(segments: List(Str), kept: List(Str)) -> List(Str) =
        match segments
        | [] => kept
        | [s, ..more] =>
            let closed(k: List(Str)) -> List(Str) = match more | [] => [..k, ""] | _ => k end;
            match s
            | "." => walk(more, closed(kept))
            | ".." =>
                walk(more, closed(match List/len(kept) | 0 => [] | n + 1 => List/take(kept, n) end))
            | _ => walk(more, [..kept, s])
            end
        end;
    let segments = match Str/split(path, "/") | [_, ..rest] => rest | [] => [] end;
    Str/concat("/", Str/join("/", walk(segments, [])));

-- `reference` beside the last segment of `base`, as RFC 3986 §5.2.3 merges a relative path.
let merged(base: Str, reference: Str) -> Str =
    let segments = Str/split(base, "/");
    Str/flatten([Str/join("/", List/take(segments, List/len(segments) - 1)), "/", reference]);

--- `reference` read against `base`, as RFC 3986 §5.2 resolves one and a client follows a `Location`: a reference with a scheme of its own is a URL of its own, `//host…` takes `base`'s scheme, a path from `/` takes `base`'s host and port, a relative path is merged with `base`'s directory, and `?…` alone keeps `base`'s path. `.` and `..` segments are removed, a fragment is dropped, and an empty reference is `base`. What it resolves to is read as `of_str` reads a URL, so a scheme other than `http` and `https` is refused.
pub let resolve(base: Url, reference: Str) -> Result(Parse/Error, Url) =
    let r =
        match Str/split_once(reference, "#")
        | some((before, _)) => before
        | none() => reference
        end;
    match
    | has_scheme(r) => of_str(r)
    | Str/starts_with(r, "//") => of_str(Str/flatten([Scheme/to_str(base.scheme), ":", r]))
    | _ =>
        let (p, q) =
            match Str/split_once(r, "?")
            | some((p, q)) => (p, Option/some(q))
            | none() => (r, Option/none())
            end;
        let path =
            match
            | Str/is_empty(p) => base.path
            | Str/starts_with(p, "/") => without_dots(p)
            | _ => without_dots(merged(base.path, p))
            end;
        let query =
            match q
            | none(), Str/is_empty(p) => base.query
            | _ => q
            end;
        of_str(to_str(Url { ..base, path = path, query = query }))
    end;

-- The sixteen hexadecimal digits, uppercase, each an octet a value may hold.
let hex_octets: List(Field/Value/Octet) =
    [
        Field/Value/Octet { byte = '0' },
        Field/Value/Octet { byte = '1' },
        Field/Value/Octet { byte = '2' },
        Field/Value/Octet { byte = '3' },
        Field/Value/Octet { byte = '4' },
        Field/Value/Octet { byte = '5' },
        Field/Value/Octet { byte = '6' },
        Field/Value/Octet { byte = '7' },
        Field/Value/Octet { byte = '8' },
        Field/Value/Octet { byte = '9' },
        Field/Value/Octet { byte = 'A' },
        Field/Value/Octet { byte = 'B' },
        Field/Value/Octet { byte = 'C' },
        Field/Value/Octet { byte = 'D' },
        Field/Value/Octet { byte = 'E' },
        Field/Value/Octet { byte = 'F' }];

-- The hexadecimal digit of the nibble `n`, read off the sixteen under the bound that makes it one.
let hex_octet(n: Nat, @nibble: Bool/Holds(n < 16)) -> Field/Value/Octet =
    List/get(hex_octets, n);

-- `b` with every octet that is not visible ASCII written as its `%XX`.
let escaped_bytes(b: Bytes) -> Field/Value =
    match b
    | 0x[] => Field/Value/empty
    | 0x[h, ..t] =>
        let rest = escaped_bytes(t);
        let n = Byte/to_nat(h);
        let quoted =
            Field/Value/cons(
                Field/Value/Octet { byte = '%' },
                Field/Value/cons(hex_octet(n / 16), Field/Value/cons(hex_octet(n % 16), rest)));
        match
        | Field/Value/admits(h), visible(h) =>
            Field/Value/cons(Field/Value/Octet { byte = h }, rest)
        | _ => quoted
        end
    end;

--- `s` as the wire carries it, a value a field may hold: every octet that is not visible ASCII is written as `%XX`. Text that `of_str` read comes out unchanged, and text that reached a `Url` another way still cannot end a line.
pub let escaped(s: Str) -> Field/Value =
    escaped_bytes(Str/to_bytes(s));

--- The URL as a field's value, as `Location` carries one.
pub let to_value(u: Url) -> Field/Value =
    escaped(to_str(u));

--- The path's segments, for a server to match on: `/a/b/` is `["a", "b"]`.
pub let segments(u: Url) -> List(Str) =
    List/filter(Str/split(u.path, "/"), (s) => Bool/not(Str/is_empty(s)));

--- The hexadecimal digit of the nibble `n`, uppercase as a percent-encoding is written.
let hex_digit(n: Nat) -> Str =
    Str/of_char(Char/to_ascii_upper(Char/hex_digit(n)));

let unreserved(n: Nat) -> Bool =
    Nat/in_range(n, 'a', 'z') || Nat/in_range(n, 'A', 'Z') || Nat/in_range(n, '0', '9') || n == '-'
        || n == '_'
        || n == '.'
        || n == '~';

--- What a character is written as in a percent-encoded component, when it is not written as itself: each of its UTF-8 bytes as `%XX`.
let percent(c: Char) -> Option(Str) =
    match unreserved(Char/to_nat(c))
    | true => Option/none()
    | false =>
        Option/some(
            Str/flatten(
                Bytes/fold(
                    Char/to_utf8(c),
                    [],
                    (byte, acc) =>
                        let n = Byte/to_nat(byte);
                        [..acc, "%", hex_digit(n / 16), hex_digit(n % 16)])))
    end;

--- `component` percent-encoded: every character but the unreserved ones as the `%XX` of each of its bytes.
pub let encode(component: Str) -> Str =
    Str/escape(component, percent);

-- The digit travels with the evidence that it is below sixteen, because the caller combines two of them into a byte and reduction cannot see a bound a guard established: `Char/of_hex_digit` refuses what is no hex digit, and the comparison below proves the bound its answer meets. Masking the digit instead would state a width this encoding does not have — a hex digit is four bits because of what it is, not because of where it is stored.
let hex_value(byte: Byte) -> Option({v: Nat, ok: Bool/Holds(v < 16)}) =
    let digit = Option/bind(Char/of_ascii(byte), Char/of_hex_digit)!;
    match Bool/holds(digit < 16)
    | some(ok) => Option/some((v = digit, ok = ok))
    | none() => Option/none()
    end;

let decode_at(rest: Bytes, acc: Bytes) -> Option(Bytes) =
    match rest
    | 0x[] => Option/some(acc)
    | 0x['+', ..after] => decode_at(after, 0x[..acc, ' '])
    | 0x['%', high, low, ..onward] =>
        match (hex_value(high), hex_value(low))
        | (some(hi), some(lo)) => decode_at(onward, 0x[..acc, Nat/to_byte(hi.v * 16 + lo.v)])
        | (some(_), none()) | (none(), _) => Option/none()
        end
    | 0x['%', .._] => Option/none()
    | 0x[byte, ..after] => decode_at(after, 0x[..acc, byte])
    end;

--- `component` percent-decoded, `+` read as a space, or `none` when an escape is malformed or the result is not text.
pub let decode(component: Str) -> Option(Str) =
    Option/bind(
        decode_at(Str/to_bytes(component), 0x[]),
        (decoded) => Result/to_option(Str/of_bytes(decoded)));

--- The query as decoded pairs: `a=1&b=x+y` is `[("a", "1"), ("b", "x y")]`. A pair without `=` is a name with an empty value and an empty piece — `a=1&&b=2`, or a query that is empty — is no pair, as the form encoding reads them; `none` where a name or a value does not decode, since a query read short of a pair is not the query that was sent.
pub let query_pairs(u: Url) -> Option(List({Str, Str})) =
    match u.query
    | none() => Option/some([])
    | some(q) =>
        List/traverse(
            List/filter(Str/split(q, "&"), (pair) => Bool/not(Str/is_empty(pair))),
            (pair) =>
                let (name, value) = Option/unwrap_or(Str/split_once(pair, "="), (pair, ""));
                let n = decode(name)!;
                let v = decode(value)!;
                Option/some((n, v)))
    end;

--- `u` with `pairs` as its query, each name and value encoded.
pub let with_query(u: Url, pairs: List({Str, Str})) -> Url =
    match pairs
    | [] => Url { ..u, query = Option/none() }
    | _ =>
        Url {
            ..u,
            query =
                Option/some(
                    Str/join(
                        "&",
                        List/map(pairs, ((name, value)) =>
                            Fmt/render("%=%")(encode(name))(encode(value))))) }
    end;
