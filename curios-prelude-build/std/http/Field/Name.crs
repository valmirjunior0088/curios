use /std/{Str, Bytes, Byte, Nat, Bool, Option, Spell};
use /std/ops/{Eql};

--- Whether `b` may stand in a token (RFC 9110 §5.6.2): a letter, a digit, or one of ``!#$%&'*+-.^_`|~``.
pub let is_tchar(b: Byte) -> Bool =
    let n = Byte/to_nat(b);
    Nat/in_range(n, 'a', 'z') || Nat/in_range(n, 'A', 'Z') || Nat/in_range(n, '0', '9') || n == '!'
        || n == '#'
        || n == '$'
        || n == '%'
        || n == '&'
        || n == '\''
        || n == '*'
        || n == '+'
        || n == '-'
        || n == '.'
        || n == '^'
        || n == '_'
        || n == '`'
        || n == '|'
        || n == '~';

--- Whether `s` is a token: one character or more, each a token's.
pub let is_token(s: Str) -> Bool =
    Bool/not(Str/is_empty(s)) && Bytes/all(Str/to_bytes(s), is_tchar);

--- Whether `s` is a name as a [`Name`] holds one: a token with no capital letter.
pub let is_name(s: Str) -> Bool =
    is_token(s)
        && Bytes/all(
            Str/to_bytes(s),
            (b: Byte) => Bool/not(Nat/in_range(Byte/to_nat(b), 'A', 'Z')));

--- A field's name: a token, so no name a message holds can end its line or its head, and lowercase, so each name has one spelling. A literal's is decided where it is written, and text met at run time is read by `of_str`.
pub struct Name: pub Type {
    --- The name, lowercase: RFC 9110 §5.1 compares names without case, and HTTP/2 and HTTP/3 send them lowercase.
    text: Str,
    --- Why the text is a lowercase token.
    @token: Bool/Holds(is_name(text)),
}

--- Two names are one where their text is, `content-type` written once for every casing of it.
satisfy Eql(Name) {
    ..
}

satisfy Spell(Name) {
    ..
}

--- `host`, the field naming the authority a request is for, which a request's renderer writes.
pub let host: Name =
    Name { text = "host" };

--- `connection`, which a renderer writes as `close`.
pub let connection: Name =
    Name { text = "connection" };

--- `content-length`, the field framing content by its length, which a renderer writes.
pub let content_length: Name =
    Name { text = "content-length" };

--- `transfer-encoding`, the field framing content by its coding: a renderer writes none and sends no caller's.
pub let transfer_encoding: Name =
    Name { text = "transfer-encoding" };

--- The name `s` spells, lowercased, or `none` where it is no token.
pub let of_str(s: Str) -> Option(Name) =
    -- The token is decided as written: a token is ASCII, so `Str/to_lower` lowers it as ASCII does, where lowering first would read the Kelvin sign as `k`.
    match is_token(s)
    | true =>
        let lowered = Str/to_lower(s);
        match is_name(lowered)
        | true => Option/some(Name { text = lowered })
        | false => Option/none()
        end
    | false => Option/none()
    end;

--- Whether `n` is the name `text` spells, compared without case.
pub let is(n: Name, text: Str) -> Bool =
    Str/eql_ignoring_ascii_case(n.text, text);
