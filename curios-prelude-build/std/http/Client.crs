mod tests;

use /std/{Bytes, Str, Nat, Bool, List, Option, Result, Try, Io};
use /std/Io/{Reader};
use /std/time/{Duration};
use /std/tcp/{Socket};
use /std/http/{Error, Method, Url, Request, Response, Limits, read, stream, Field};

--- How a client performs an exchange.
pub struct Client: pub Type {
    --- How long the whole of one exchange may take.
    timeout: Duration,
    --- How many redirects it follows before refusing.
    redirects: Nat,
    --- What a reply may hold: one past them is refused as it arrives, before the rest of it is read.
    limits: Limits,
}

--- Thirty seconds, three redirects, and `Limits/client`'s bounds.
pub let default: Client =
    Client { timeout = Duration/of_secs(30), redirects = 3, limits = Limits/client };

-- The reply to a request of `method`, read through `r` as its framing delimits it: every 1xx reply ahead of the final one is passed over (RFC 9110 §15.2), and the reading stops where the final reply's framing ends.
let reply(limits: Limits, method: Method, r: Reader(Socket)) -> Io(Result(Error, Response)) =
    let first =
        Reader/take(
            r,
            (searched: read/Searched, bytes: Bytes) => read/head(limits, false, searched, bytes),
            read/unsearched)!;
    match first
    | failure(stop) =>
        Io/pure(
            Result/failure(
                match stop
                | refused(why) => Error/refused(why)
                | ended(_) => Error/incomplete(Option/none())
                | failed(_, e) => Error/net(e)
                end))
    | success(lines) =>
        match Response/head_of(lines)
        | failure(why) => Io/pure(Result/failure(Error/refused(why)))
        | success(head) =>
            match head.status.code < 200
            | true => reply(limits, method, r)
            | false =>
                match Response/framing(method, head)
                | failure(why) => Io/pure(Result/failure(Error/refused(why)))
                | success(framing) =>
                    let content = stream/body(limits, r, framing)!;
                    Io/pure(
                        match content
                        | success(body) =>
                            Result/map_failure(
                                Response/from_head(head, body),
                                (why) => Error/refused(why))
                        | failure(stop) =>
                            Result/failure(
                                match stop
                                | refused(why) => Error/refused(why)
                                | ended(arrived) => Error/incomplete(Option/some((head, arrived)))
                                | failed(_, e) => Error/net(e)
                                end)
                        end)
                end
            end
        end
    end;

-- One exchange over a connection of its own. The reply is read whether or not the request was written whole: a peer that answers before it has read its request and then stops reading fails the write, and the reply it sent is still there (RFC 9112 §9.6). The failed write is the exchange's failure only where no reply is.
let exchange(c: Client, request: Request) -> Try(Io, Error, Response) =
    let u = request.url;
    let read =
        Try/map_failure(
            Try/scope((scope) =>
                let s =
                    match u.scheme
                    | http() => Socket/connect(scope, u.host, u.port)
                    | https() => Socket/connect_tls(scope, u.host, u.port)
                    end!;
                let wrote = Try/run(Io/write(s, Request/render(request)))!;
                let r = Reader/new(s)!;
                let answered = reply(c.limits, request.method, r)!;
                match wrote
                | success(()) => Try/pure(answered)
                | failure(unsent) =>
                    match answered
                    | success(_) => Try/pure(answered)
                    | failure(_) => Try/raise(unsent)
                    end
                end),
            (e) => Error/net(e))!;
    Try/attempt(Io/pure(read));

let is_redirect(code: Nat) -> Bool =
    code == 301 || code == 302 || code == 303 || code == 307 || code == 308;

-- Where a redirect points: its `Location`, resolved against the URL the request went to.
let redirect_of(request: Request, response: Response) -> Option(Url) =
    match is_redirect(response.status.code)
    | false => Option/none()
    | true =>
        Option/bind(
            Option/bind(Response/header(response, "Location"), Field/Value/to_str),
            (location) => Result/to_option(Url/resolve(request.url, location)))
    end;

-- Whether `a` and `b` are one origin: RFC 6454's scheme, host and port.
let same_origin(a: Url, b: Url) -> Bool =
    a.scheme == b.scheme && Str/eql_ignoring_ascii_case(a.host, b.host) && a.port == b.port;

-- Whether `f` speaks for the user to the origin it was written for, which another origin is not to be handed.
let credential(f: Field) -> Bool =
    List/any(
        ["Authorization", "Proxy-Authorization", "Cookie"],
        (name) => Field/Name/is(f.name, name));

-- Whether `f` describes the request's content, as RFC 9110 §15.4 lists the fields that go with it.
let describes_content(f: Field) -> Bool =
    List/any(
        ["Content-Encoding", "Content-Language", "Content-Location", "Content-Type",
            "Content-Length", "Digest", "Last-Modified"],
        (name) => Field/Name/is(f.name, name));

--- The request a redirect with status `code` to `target` asks for, as RFC 9110 §15.4 has a user agent rebuild it: a `303` is a `GET` without content, a `HEAD` staying a `HEAD`, as is a `301` or a `302` answering a `POST`; a `307` and a `308` keep the method and the content. The fields that describe content go where it goes, and where `target` is another origin than the request's, a change of scheme included, the request's credentials (`Authorization`, `Proxy-Authorization`, `Cookie`) are not handed on.
let redirected(request: Request, code: Nat, target: Url) -> Request =
    let to_get =
        code == 303 && request.method != Method/head()
            || (code == 301 || code == 302) && request.method == Method/post();
    let within = same_origin(request.url, target);
    let kept =
        List/filter(request.headers, (f) =>
            Bool/not(to_get && describes_content(f)) && (within || Bool/not(credential(f))));
    match to_get
    | true => Request { method = Method/get(), url = target, headers = kept, body = 0x[] }
    | false => Request { ..request, url = target, headers = kept }
    end;

let follow(c: Client, request: Request, left: Nat) -> Try(Io, Error, Response) =
    let response = exchange(c, request)!;
    match redirect_of(request, response)
    | none() => Try/pure(response)
    | some(target) =>
        match left
        | 0 => Try/raise(Error/redirected(c.redirects))
        | rest + 1 => follow(c, redirected(request, response.status.code, target), rest)
        end
    end;

--- One exchange: connect by the scheme, send the request whole, read the reply as its framing delimits it and no further, and follow a redirect while the limit allows — all under the timeout, whose passing is reported as `timeout`. A reply the peer closes on before it is whole is `incomplete` with what arrived of it, and one that is malformed or past `c.limits` is `refused`. A reply a peer sent before it had read the request is the answer even where the request could not then be sent whole.
pub let perform(c: Client, request: Request) -> Try(Io, Error, Response) =
    let outcome = Io/timeout(c.timeout, Try/run(follow(c, request, c.redirects)))!;
    match outcome
    | none() => Try/raise(Error/timeout())
    | some(r) => Try/attempt(Io/pure(r))
    end;
