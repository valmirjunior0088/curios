-- `/std/rand`: what the operating system's generator answers.
use /std/{Bytes, Nat, Bool, List, Io, Test, rand};

-- `bytes` answers as many bytes as it is asked for.
test bytes_answers_as_many_as_it_is_asked_for =
    let drawn = rand/bytes(8)!;
    Test/equal(Bytes/len(drawn), 8);

-- `below` answers every number under its bound and none past it: over six hundred draws of a die each face turns up, which misses one with a chance below one in `10^40`.
test below_answers_every_number_under_its_bound_and_none_past_it =
    let draws(k: Nat, acc: List(Nat)) -> Io(List(Nat)) =
        match k
        | 0 => Io/pure(acc)
        | j + 1 =>
            let d = rand/below(6)!;
            draws(j, [d, ..acc])
        end;
    let faces = draws(600, [])!;
    let one = rand/below(1)!;
    Test/all([
        Test/equal(List/filter(faces, (d) => d >= 6), []),
        Test/equal(List/filter(List/range(0, 6), (f) => Bool/not(List/contains(faces, f))), []),
        Test/equal(one, 0)]);

-- `shuffle` answers a reordering of what it is given, every element kept as often as it was there.
test shuffle_answers_a_reordering_of_its_list =
    let l = [3, 1, 4, 1, 5, 9, 2, 6, 5, 3, 5];
    let none: List(Nat) = [];
    let s = rand/shuffle(l)!;
    let t = rand/shuffle(none)!;
    Test/all([Test/equal(List/sort(s), List/sort(l)), Test/equal(t, none)]);
