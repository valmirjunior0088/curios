-- `Set`, a map from its elements to nothing: its laws read off `Map`'s, its order, and the operations that build one from two.
use /std/{Str, Nat, Bool, List, Ord, Eq, Hash, Set, Test};
use /std/Bool/{True};

-- A `Set(K)` is a structure over `Map(K, {})`, whose leaves hold the keys themselves, so `to_list` hands the elements back typed — `List(Str)` here, joined without a decoder.
test a_set_stores_its_keys_typed_and_unions =
    let s = Set/of_list(["b", "a", "c", "a"]);
    let u = Set/union(s, Set/insert(Set/of_list(["d"]), "a"));
    Test/all([
        Test/equal(Set/length(s), 3),
        Test/assert("`\"a\"` is a member", Set/has(s, "a")),
        Test/assert("`\"z\"` is no member", Bool/not(Set/has(s, "z"))),
        Test/equal(Set/to_list(Set/remove(s, "b")), ["a", "c"]),
        Test/equal(u, Set/of_list(["a", "b", "c", "d"])),
        Test/equal(
            Set/fold(Set/of_list(["x", "yy", "zzz"]), 0, (x: Str, acc: Nat) => Str/length(x) + acc),
            6)]);

-- An intersection keeps the first set's elements the second has, and a difference the rest, as their maps' do.
test intersection_and_difference_part_the_first_set_by_the_seconds_elements =
    let s = Set/of_list(["a", "b", "c"]);
    let t = Set/of_list(["b", "c", "d"]);
    Test/all([
        Test/equal(Set/intersection(s, t), Set/of_list(["b", "c"])),
        Test/equal(Set/difference(s, t), Set/of_list(["a"]))]);

-- The elements of a set are in their type's own order at every pair.
let _a_sets_elements_are_in_their_order(
    @K: Type,
    use Hash/Key(K),
    s: Set(K),
) -> List/Pairwise(Ord/lt_by((a: K, b: K) => Ord/ord(a, b)))(Set/to_list(s)) =
    Set/to_list/pairwise(s);

-- Inserting an element twice is inserting it once, for every set: the two have the same elements, which `Set/has/extensional` takes to the sets.
let _an_element_inserted_twice_is_inserted_once(
    @K: Type,
    use Hash/Key(K),
    s: Set(K),
    k: K,
) -> Eq()(Set/insert(Set/insert(s, k), k), Set/insert(s, k)) =
    Set/has/extensional(
        Set/insert(Set/insert(s, k), k),
        Set/insert(s, k),
        (key) =>
            match Hash/hash(k) == Hash/hash(key)
            | true =>
                Eq/subst(
                    (y: K) =>
                        Eq()(
                            Set/has(Set/insert(Set/insert(s, k), k), y),
                            Set/has(Set/insert(s, k), y)),
                    Hash/Key/same(k, key, True/qed()),
                    Eq/trans(
                        Set/has/of_insert(Set/insert(s, k), k),
                        Eq/sym(Set/has/of_insert(s, k))))
            | false =>
                Set/has/of_insert_other(
                    Set/insert(s, k),
                    k,
                    key,
                    Hash/Key/apart(k, key, True/qed()))
            end);

-- No element of an intersection is an element of the difference by the same set, for every two sets: the laws state each as the two decisions at the key, false together in every case.
let _an_intersection_and_a_difference_share_no_element(
    @K: Type,
    use Hash/Key(K),
    a: Set(K),
    b: Set(K),
    k: K,
) -> Eq()(Set/has(Set/intersection(a, b), k) && Set/has(Set/difference(a, b), k), false) =
    let apart(x: Bool, y: Bool) -> Eq()(x && y && (x && Bool/not(y)), false) =
        match x
        | true | false => match y | true | false => Eq/refl() end
        end;
    Eq/trans(
        Eq/cong(
            (x: Bool) => x && Set/has(Set/difference(a, b), k),
            Set/has/of_intersection(a, b, k)),
        Eq/trans(
            Eq/cong(
                (y: Bool) => Set/has(a, k) && Set/has(b, k) && y,
                Set/has/of_difference(a, b, k)),
            apart(Set/has(a, k), Set/has(b, k))));
