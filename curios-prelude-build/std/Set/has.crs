use /std/{Bool, Option, Eq, Map, Hash};
use /std/Set/{Set, empty, insert, remove, union, intersection, difference};

--- Whether `k` is an element.
pub let has(@K: Type, use Hash/Key(K), s: Set(K), k: K) -> Bool =
    Map/has(s.map, k);

-- Whether an option holds a value, carried across an equation between two options.
let held(
    @A: Type,
    @x: Option(A),
    @y: Option(A),
    e: Eq()(x, y),
) -> Eq()(Option/is_some(x), Option/is_some(y)) =
    Eq/cong((m: Option(A)) => Option/is_some(m), e);

pub let of_empty(@K: Type, use Hash/Key(K), k: K) -> Eq()(has(empty(), k), false) =
    Eq/refl();

pub let of_insert(@K: Type, use Hash/Key(K), s: Set(K), k: K) -> Eq()(has(insert(s, k), k), true) =
    held(Map/try_get/of_insert(s.map, k, ()));

--- `insert` leaves every other key as it was.
pub let of_insert_other(
    @K: Type,
    use Hash/Key(K),
    s: Set(K),
    k: K,
    other: K,
    apart: (Eq()(other, k)) -> Bool/False,
) -> Eq()(has(insert(s, k), other), has(s, other)) =
    held(Map/try_get/of_insert_other(s.map, k, (), other, apart));

pub let of_remove(@K: Type, use Hash/Key(K), s: Set(K), k: K) -> Eq()(has(remove(s, k), k), false) =
    held(Map/try_get/of_remove(s.map, k));

--- `remove` leaves every other key as it was.
pub let of_remove_other(
    @K: Type,
    use Hash/Key(K),
    s: Set(K),
    k: K,
    other: K,
    apart: (Eq()(other, k)) -> Bool/False,
) -> Eq()(has(remove(s, k), other), has(s, other)) =
    held(Map/try_get/of_remove_other(s.map, k, other, apart));

-- Whether the first of two options holding a value answers holds one: whether either does.
let either(
    @A: Type,
    x: Option(A),
    y: Option(A),
) -> Eq()(Option/is_some(Option/or(y, x)), Option/is_some(x) || Option/is_some(y)) =
    match y | some(_) | none() => Eq/refl() end;

--- An element of `union` is an element of either.
pub let of_union(
    @K: Type,
    use Hash/Key(K),
    a: Set(K),
    b: Set(K),
    k: K,
) -> Eq()(has(union(a, b), k), has(a, k) || has(b, k)) =
    Eq/trans(
        held(Map/try_get/of_union(a.map, b.map, k)),
        either(Map/try_get(a.map, k), Map/try_get(b.map, k)));

-- Whether an option a condition filters holds a value: whether it held one and the condition holds.
let kept(
    @A: Type,
    x: Option(A),
    c: Bool,
) -> Eq()(Option/is_some(Option/filter(x, (_: A) => c)), Option/is_some(x) && c) =
    match x
    | some(_) | none() => match c | true | false => Eq/refl() end
    end;

--- An element of `intersection` is an element of both.
pub let of_intersection(
    @K: Type,
    use Hash/Key(K),
    a: Set(K),
    b: Set(K),
    k: K,
) -> Eq()(has(intersection(a, b), k), has(a, k) && has(b, k)) =
    Eq/trans(
        held(Map/try_get/of_intersection(a.map, b.map, k)),
        kept(Map/try_get(a.map, k), Map/has(b.map, k)));

--- An element of `difference` is an element of the first and no element of the second.
pub let of_difference(
    @K: Type,
    use Hash/Key(K),
    a: Set(K),
    b: Set(K),
    k: K,
) -> Eq()(has(difference(a, b), k), has(a, k) && Bool/not(has(b, k))) =
    Eq/trans(
        held(Map/try_get/of_difference(a.map, b.map, k)),
        kept(Map/try_get(a.map, k), Bool/not(Map/has(b.map, k))));

-- Two options of the unit type that agree on whether they hold a value are one option: the value each holds is `()`.
let held_once(
    x: Option({}),
    y: Option({}),
    e: Eq()(Option/is_some(x), Option/is_some(y)),
) -> Eq()(x, y) =
    match x
    | none() =>
        match y
        | none() => Eq/refl()
        | some(()) => match Bool/false_neq_true(e) end
        end
    | some(()) =>
        match y
        | none() => match Bool/false_neq_true(Eq/sym(e)) end
        | some(()) => Eq/refl()
        end
    end;

--- Two sets with the same elements are one set.
pub let extensional(
    @K: Type,
    use Hash/Key(K),
    a: Set(K),
    b: Set(K),
    same: (k: K) -> Eq()(has(a, k), has(b, k)),
) -> Eq()(a, b) =
    Eq/cong(
        (m: Map(K, {})) => Set { map = m },
        Map/try_get/inj(a.map, b.map, (k: K) =>
            held_once(Map/try_get(a.map, k), Map/try_get(b.map, k), same(k))));
