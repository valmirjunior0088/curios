use /std/{Bool, Eq, Ordering};
use /std/ops/{Eql};
use /std/Bool/{True, Holds};

-- Stated with `||`, of which conversion absorbs a `true` operand on either side: what a `gt` settles is settled whatever the other answers are, so a proof at `chains(first, Ordering/gt(), across)`, or at `chains(Ordering/lt(), second, Ordering/lt())`, takes no case of the answers left open.
--- Whether three answers chain: the first is `gt`, or the second is, or the third is the step of the first two ([`Ordering/then`]).
---
--- A comparison's answers at `a` and `b`, at `b` and `c`, and at `a` and `c` chain ([`/std/Ord/chains`]), and [`Ordering/then`] keeps that ([`then`]), so an order built of steps carries across a middle element ([`le`]) where each of its pieces does.
pub let chains(first: Ordering, second: Ordering, across: Ordering) -> Bool =
    Ordering/is_gt(first) || Ordering/is_gt(second) || across == Ordering/then(first, second);

-- By cases on the three leading answers. Where all three are `eq` the steps are their second answers, which chain by `piece`; anywhere else the leading answers decide, or `prefix` rules the case out. One case splits an answer to three arms alike: a step's own answer `x` stands on both sides of what is asked there, so nothing reduces until it is known.
--- Three steps chain where their first answers do and their second answers do.
---
--- The second answers' part is owed only where the first two of the leading answers are `eq`, which is where each step consults its second.
pub let then(
    @px: Ordering,
    @py: Ordering,
    @pz: Ordering,
    @x: Ordering,
    @y: Ordering,
    @z: Ordering,
    prefix: Holds(chains(px, py, pz)),
    piece: (Eq()(px, Ordering/eq()), Eq()(py, Ordering/eq())) -> Holds(chains(x, y, z)),
) -> Holds(chains(Ordering/then(px, x), Ordering/then(py, y), Ordering/then(pz, z))) =
    match px
    | lt() =>
        match py
        | lt() =>
            match pz
            | lt() => True/qed()
            | eq() => match prefix end
            | gt() => match prefix end
            end
        | eq() =>
            match pz
            | lt() => True/qed()
            | eq() => match prefix end
            | gt() => match prefix end
            end
        | gt() => True/qed()
        end
    | eq() =>
        match py
        | lt() =>
            match pz
            | lt() => match x | lt() | eq() | gt() => True/qed() end
            | eq() => match prefix end
            | gt() => match prefix end
            end
        | eq() =>
            match pz
            | lt() => match prefix end
            | eq() => piece(Eq/refl(), Eq/refl())
            | gt() => match prefix end
            end
        | gt() => True/qed()
        end
    | gt() => True/qed()
    end;

-- The third part of what is asked is the answer equal to itself, which no reduction decides of an answer not yet known.
--- An answer chains with itself after a tie: where the first answer is `eq`, the second and the third are one.
pub let tied(answer: Ordering) -> Holds(chains(Ordering/eq(), answer, answer)) =
    Bool/or/of_second(Ordering/is_gt(answer), answer == answer, Eql/refl(answer));

--- The third of three answers that chain is `lt` or `eq` where the first two are: what makes an order transitive.
pub let le(
    x: Ordering,
    y: Ordering,
    z: Ordering,
    chained: Holds(chains(x, y, z)),
    below: Holds(Ordering/is_le(x)),
    above: Holds(Ordering/is_le(y)),
) -> Holds(Ordering/is_le(z)) =
    match x
    | lt() =>
        match y
        | lt() =>
            match z
            | lt() => True/qed()
            | eq() => match chained end
            | gt() => match chained end
            end
        | eq() =>
            match z
            | lt() => True/qed()
            | eq() => match chained end
            | gt() => match chained end
            end
        | gt() => match above end
        end
    | eq() =>
        match y
        | lt() =>
            match z
            | lt() => True/qed()
            | eq() => match chained end
            | gt() => match chained end
            end
        | eq() =>
            match z
            | lt() => match chained end
            | eq() => True/qed()
            | gt() => match chained end
            end
        | gt() => match above end
        end
    | gt() => match below end
    end;
