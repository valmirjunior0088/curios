mod tests;

pub use /sys/{let Bytes};
pub use /sys/Bytes/{get, length, eql, slice, replicate, and, or, xor};

--- The number a minimal encoding denotes, which is `of_nat`'s inverse, with the bound a run's length puts on it.
pub mod to_nat;
pub use to_nat/{let to_nat};

--- The order of two byte strings, bytewise with a proper prefix first, and its laws.
pub mod ord;
pub use ord/{let ord};

use /std/{List, Nat, Byte, Bool, Option, Eq, Char, Str, Show, Spell, Fmt, Hash, proved};
use /std/ops/{Eql};
use /std/Bool/{True, False, Holds};

--- The byte at `i`, or `none` past the end.
pub let try_get(b: Bytes, i: Nat) -> Option(Byte) =
    match i < length(b)
    | true => Option/some(get(b, i))
    | false => Option/none()
    end;

-- A direct cons, which is the shape `0x[h, ..t]` builds and the shape `to_nat` folds back, so taking one apart is the eliminator's own seam rather than the window at the far one a big-endian snoc would need.
--- The minimal encoding of `n`, least-significant byte first as the carrier reads: empty for zero, no trailing zero otherwise, so distinct numbers encode distinctly.
pub let of_nat(n: Nat) -> Bytes =
    match n == 0
    | true => 0x[]
    | false => 0x[Nat/to_byte(n % 256), ..of_nat(n / 256)]
    end;

-- A cons has no length of zero: the comparison that decides the two lengths refutes the equation.
let no_cons(k: Byte, p: Bytes, e: Eq()(0, length(0x[k, ..p]))) -> False =
    Eq/subst((m: Nat) => Holds(0 == m), e, True/qed());

-- By induction on both runs: the tails' numbers are the quotients by `256` and the heads the remainders, each of which conversion reads off a byte beside a multiple.
--- Two runs of one length that denote one number are one run: [`to_nat`] is injective at a fixed width.
---
--- Across lengths it is not, a trailing zero byte adding nothing, which is why [`of_nat`] is the minimal encoding.
pub let to_nat_inj(
    a: Bytes,
    b: Bytes,
    same: Eq()(length(a), length(b)),
    e: Eq()(to_nat(a), to_nat(b)),
) -> Eq()(a, b) =
    match a
    | 0x[] =>
        match b
        | 0x[] => Eq/refl()
        | 0x[k, ..p] => match no_cons(k, p, same) end
        end
    | 0x[h, ..t] =>
        match b
        | 0x[] => match no_cons(h, t, Eq/sym(same)) end
        | 0x[k, ..p] =>
            let tails: Eq()(to_nat(t), to_nat(p)) = Eq/cong((n: Nat) => n / 256, e);
            let heads: Eq()(h, k) = Eq/cong((n: Nat) => Nat/to_byte(n % 256), e);
            let lens: Eq()(length(t), length(p)) = Eq/cong((n: Nat) => n - 1, same);
            let rest: Eq()(t, p) = to_nat_inj(t, p, lens, tails);
            Eq/trans(
                Eq/cong((y: Byte) => 0x[y, ..t], heads),
                Eq/cong((q: Bytes) => 0x[k, ..q], rest))
        end
    end;

-- The recursion `of_nat` performs terminates, which is what lets injectivity recurse the same way.
let high_below(n: Nat, positive: Holds(0 < n)) -> Holds(n / 256 < n) =
    proved();

-- A cons taken apart, or `none` for no bytes: one function of the whole value, which congruence needs, and no half invented for the run that has none.
let uncons(z: Bytes) -> Option({Byte, Bytes}) =
    match z
    | 0x[] => Option/none()
    | 0x[k, ..p] => Option/some((k, p))
    end;

-- Read through the cons taken apart above — what lets an encoding built by consing be taken apart again.
--- A cons is injective in its head.
pub let cons_inj_head(
    @k1: Byte,
    @p1: Bytes,
    @k2: Byte,
    @p2: Bytes,
    e: Eq()(0x[k1, ..p1], 0x[k2, ..p2]),
) -> Eq()(k1, k2) =
    Eq/cong((halves: {Byte, Bytes}) => halves.0, Option/some_inj(Eq/cong(uncons, e)));

--- A cons is injective in its tail.
pub let cons_inj_tail(
    @k1: Byte,
    @p1: Bytes,
    @k2: Byte,
    @p2: Bytes,
    e: Eq()(0x[k1, ..p1], 0x[k2, ..p2]),
) -> Eq()(p1, p2) =
    Eq/cong((halves: {Byte, Bytes}) => halves.1, Option/some_inj(Eq/cong(uncons, e)));

-- `Eql`'s law at `Bytes`, by recursion on both runs, since the comparison of two conses is their heads' and their tails', and of a cons and no bytes is `false`.
let eq_of_eql(a: Bytes, b: Bytes, h: Holds(eql(a, b))) -> Eq()(a, b) =
    match a
    | 0x[] =>
        match b
        | 0x[] => Eq/refl()
        | 0x[_, .._] => match h end
        end
    | 0x[y, ..t] =>
        match b
        | 0x[] => match h end
        | 0x[k, ..p] =>
            match Byte/to_nat(y) == Byte/to_nat(k)
            | true =>
                Eq/trans(
                    Eq/cong((c: Byte) => 0x[c, ..t], proved(@Eq()(y, k))),
                    Eq/cong((q: Bytes) => 0x[k, ..q], eq_of_eql(t, p, h)))
            | false => match h end
            end
        end
    end;

-- An empty encoding is no encoding of a positive number: the lengths differ, and a length of zero against a successor is refuted by the comparison that decides it.
let no_empty(k: Byte, p: Bytes, e: Eq()(0x[], 0x[k, ..p])) -> False =
    Eq/subst((m) => Holds(0 == m), Eq/cong(length, e), True/qed());

-- Course-of-values induction, because the recursion divides rather than decrements. Each step takes the encoding apart at its first byte, the digit and the rest by the cons's two injections, recovers the two numbers' high parts from the induction hypothesis and their low digits from the byte round trip, and rejoins both by Euclid's recombination.
--- Distinct numbers encode distinctly.
pub let of_nat_inj(a: Nat, b: Nat, same: Eq()(of_nat(a), of_nat(b))) -> Eq()(a, b) =
    Nat/descend(
        (m: Nat) => m,
        (m) => (d: Nat, e: Eq()(of_nat(m), of_nat(d))) -> Eq()(m, d),
        (n, ih) =>
            (d, e) =>
                match n
                | 0 =>
                    match d
                    | 0 => Eq/refl()
                    | dp + 1 =>
                        match no_empty(Nat/to_byte((dp + 1) % 256), of_nat((dp + 1) / 256), e)
                        end
                    end
                | np + 1 =>
                    match d
                    | 0 =>
                        match no_empty(
                            Nat/to_byte((np + 1) % 256),
                            of_nat((np + 1) / 256),
                            Eq/sym(e))
                        end
                    | dq + 1 =>
                        let heads: Eq()(of_nat((np + 1) / 256), of_nat((dq + 1) / 256)) =
                            cons_inj_tail(e);
                        let digits: Eq()((np + 1) % 256, (dq + 1) % 256) =
                            Eq/cong(Byte/to_nat, cons_inj_head(e));
                        let highs: Eq()((np + 1) / 256, (dq + 1) / 256) =
                            ih((np + 1) / 256, high_below(np + 1, True/qed()))(
                                (dq + 1) / 256,
                                heads);
                        let rejoined: Eq()(
                            256 * ((np + 1) / 256) + (np + 1) % 256,
                            256 * ((dq + 1) / 256) + (dq + 1) % 256) =
                            Eq/subst(
                                (y) =>
                                    Eq()(
                                        256 * ((np + 1) / 256) + (np + 1) % 256,
                                        256 * ((dq + 1) / 256) + y),
                                digits,
                                Eq/subst(
                                    (x) =>
                                        Eq()(
                                            256 * ((np + 1) / 256) + (np + 1) % 256,
                                            256 * x + (np + 1) % 256),
                                    highs,
                                    Eq/refl()));
                        rejoined
                    end
                end,
        a)(
        b,
        same);

--- Everything from `k` on, under the evidence that `k` is within the length.
pub let drop(b: Bytes, k: Nat, @ok: Holds(k <= length(b))) -> Bytes =
    slice(b, k, length(b) - k);

-- An `xor` against a run of all-ones bytes as long as this one, so the width is a fact about the operand rather than a number written here. `Bytes/length` reduces a fill to its own count, so the equal-length bound the `xor` states discharges without a guard.
--- Every bit of every byte flipped.
pub let not(b: Bytes) -> Bytes =
    xor(b, replicate(length(b), 0xFF));

--- `b` moved `count` bytes toward the high end, zero bytes entering at the low end and whatever passes the top discarded.
---
--- Read least significant byte first, as `of_nat` writes, it multiplies by `256^count` at the run's own width. A count past the length gives all zeros rather than a shorter run: the width belongs to the value.
---
--- Whole bytes, not bits: a byte string has no finer position, and a bit shift is `Nat`'s.
pub let shl(b: Bytes, count: Nat) -> Bytes =
    match count <= length(b)
    | true => 0x[..replicate(count, 0x00), ..slice(b, 0, length(b) - count)]
    | false => replicate(length(b), 0x00)
    end;

--- `b` moved `count` bytes toward the low end, zero bytes entering at the high end.
pub let shr(b: Bytes, count: Nat) -> Bytes =
    match count <= length(b)
    | true => 0x[..drop(b, count), ..replicate(count, 0x00)]
    | false => replicate(length(b), 0x00)
    end;

-- The count is taken modulo the width, which is what makes this total without a guard on the count itself; the empty run is the one case with no width to take it modulo.
--- `b` rotated `count` bytes toward the high end, what passes the top re-entering at the bottom; rotating the empty run is the identity.
pub let rotl(b: Bytes, count: Nat) -> Bytes =
    match 0 < length(b)
    | true =>
        let keep = length(b) - count % length(b);
        0x[..drop(b, keep), ..slice(b, 0, keep)]
    | false => b
    end;

--- `b` rotated `count` bytes toward the low end.
pub let rotr(b: Bytes, count: Nat) -> Bytes =
    match 0 < length(b)
    | true =>
        let places = count % length(b);
        0x[..drop(b, places), ..slice(b, 0, places)]
    | false => b
    end;

--- The concatenation, in order.
pub let flatten(parts: List(Bytes)) -> Bytes =
    List/fold(parts, 0x[], (b, acc) => 0x[..acc, ..b]);

--- Left to right with `f(byte, acc)`.
pub let fold(@A: Type, b: Bytes, init: A, f: (Byte, A) -> A) -> A =
    let go(z: Bytes, acc: A) -> A =
        match z | 0x[] => acc | 0x[h, ..t] => go(t, f(h, acc)) end;
    go(b, init);

--- Where the first byte `pred` accepts is, with the proof that it lies within `b`, or `none`.
pub let find_index(
    b: Bytes,
    pred: (Byte) -> Bool,
) -> Option({at: Nat, within: Holds(at < length(b))}) =
    Nat/descend(
        (i: Nat) => length(b) - i,
        (_) => Option({at: Nat, within: Holds(at < length(b))}),
        (i, ih) =>
            match Bool/holds(i < length(b))
            | none() => Option/none()
            | some(inside) =>
                match pred(get(b, i, @inside))
                | true => Option/some((at = i, within = inside))
                | false => ih(i + 1, proved())
                end
            end,
        0);

--- Where the first `x` is, with the proof that it lies within `b`, or `none`.
pub let index_of(b: Bytes, x: Byte) -> Option({at: Nat, within: Holds(at < length(b))}) =
    find_index(b, (y) => y == x);

--- Whether `x` occurs in `b`.
pub let contains(b: Bytes, x: Byte) -> Bool =
    Option/is_some(index_of(b, x));

--- Whether `pred` accepts every byte of `b`; true of the empty run. It recurs on `b` itself, so on a byte followed by more it reduces to that byte's answer and the rest's, which is what a proof about a prepended byte reads.
pub let all(b: Bytes, pred: (Byte) -> Bool) -> Bool =
    match b | 0x[] => true | 0x[h, ..t] => pred(h) && all(t, pred) end;

--- `parts` with `sep` between each pair.
pub let join(sep: Bytes, parts: List(Bytes)) -> Bytes =
    List/balanced(
        List/length(parts),
        0x[],
        (i, ok) => List/get(@Bytes, parts, i, @ok),
        (l, r) => 0x[..l, ..sep, ..r]);

-- What `split` has left to cut, and the pieces cut so far, the last first.
struct Cutting: Type {
    rest: Bytes,
    found: List(Bytes),
}

--- The pieces of `b` between each `sep`, in order: one more than the separators it holds.
pub let split(b: Bytes, sep: Byte) -> List(Bytes) =
    Nat/descend(
        (c: Cutting) => length(c.rest),
        (_) => List(Bytes),
        (c, ih) =>
            match index_of(c.rest, sep)
            | none() => List/reverse([c.rest, ..c.found])
            | some(cut) =>
                ih(
                    Cutting {
                        rest = drop(c.rest, cut.at + 1),
                        found = [slice(c.rest, 0, cut.at), ..c.found] },
                    proved())
            end,
        Cutting { rest = b, found = [] });

satisfy Eql(Bytes) {
    eql = eql,
    eq = eq_of_eql,
    refl(_) = True/qed(),
}

--- Hexadecimal, two digits per byte.
satisfy Show(Bytes) {
    show(b) =
        Str/flatten(
            fold(
                b,
                [],
                (byte, acc) =>
                    let n = Byte/to_nat(byte);
                    [
                        ..acc,
                        Str/of_char(Char/hex_digit(n / 0x10)),
                        Str/of_char(Char/hex_digit(n % 0x10))])),
}

satisfy Spell(Bytes) {
    spell(b) =
        let parts = fold(b, [], (byte, acc) => [..acc, Nat/to_str(Byte/to_nat(byte))]);
        Fmt/render("0x[%]")(Str/join(", ", parts)),
}

--- The identity encoding.
satisfy Hash(Bytes) {
    hash(b) = b,
}

--- The identity encoding, in the order of bytes.
satisfy Hash/Key(Bytes) {
    mono(_, _) = Eq/refl(),
}
