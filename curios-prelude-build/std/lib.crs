mod tests;

-- Core: what performs nothing.
--- The concepts the infix operators dispatch through, each supplying the method its operator calls.
pub mod ops;

--- Propositional equality, with `refl` as its one constructor. The value-level decision behind `==` is `Eql`.
pub mod Eq;
pub use Eq/{let Eq};

--- The two-valued type.
---
--- `Holds` beneath reflects a decision into a proposition: `True`, inhabited by `qed`, where it is `true`, and `False`, whose elimination proves anything, where it is not.
pub mod Bool;
pub use Bool/{let Bool};

--- A total order, over an `Eql` superclass: what sorting and ordered collections ask for, the three-way answer it gives, and the laws a theorem may ask of a comparator, each named once.
pub mod Ord;
pub use Ord/{let Ord, Ordering};

--- A value's encoding as the bytes that identify it, and the digest of one.
---
--- The encoding is stable and is what `Map/Key` proves injective and in its type's own order; the digest over it is not, and is for dedup and cache keys rather than for anything written down.
pub mod Hash;
pub use Hash/{let Hash};

--- A value's rendering for a reader.
pub mod Show;
pub use Show/{let Show};

--- A value's rendering as source that reads back: a literal, or a constructor spelled by its type's own name.
---
--- The text re-parses wherever the type's name is visible unqualified, and a test report spells a value with it.
pub mod Spell;
pub use Spell/{let Spell};

--- Sequencing: the concept postfix `!` is a call to, in the monad of its region.
---
--- A region's monad is read from the region's type, never from an action sequenced in it. An action of another monad reaches the region through `Monad/Lift`.
pub mod Monad;
pub use Monad/{let Monad};

--- The witnesses for the positional tuple shapes, up to eight fields. A labelled product wanting the same is a `struct`.
pub mod Tuple;

--- One octet, `0` through `255`.
pub mod Byte;
pub use Byte/{let Byte};

--- Natural numbers, unbounded: a machine word while a value is small, and a run of limbs once it outgrows one.
---
--- Subtraction truncates at zero. Division and remainder require `Nat/NonZero(b)`, which is `Bool/Holds(0 < b)`. `Nat/lt` and `Nat/le` hold the order lemmas bounds are proved with.
pub mod Nat;
pub use Nat/{let Nat};

--- Signed integers, unbounded as `Nat` is, with `NonNeg` as the decided bound the narrowing to `Nat` carries.
pub mod Int;
pub use Int/{let Int};

--- IEEE binary64 floating point.
---
--- There is no `==`, since IEEE's equality calls the two zeros equal and a NaN unequal to itself, which no equivalence does: `eql` is that equality, and `identical` compares bit patterns, as `Eq` does. Every ordering is IEEE's, so a NaN fails them all. Division is total. The narrowings to `Int` and `Nat` carry the decided bounds `Finite` and `NonNeg`, and the decimal conversions round-trip: text is read correctly rounded, and written as the shortest decimal that reads back.
pub mod Flt;
pub use Flt/{let Flt};

--- A packed byte string, least-significant first, written `0x[...]`: what every host operation hands over and takes.
pub mod Bytes;
pub use Bytes/{let Bytes};

--- One Unicode scalar value, certified against the surrogate range.
---
--- A conversion to `Char` either proves its result a scalar value or returns an `Option`: nothing is silently replaced. Classification and case conversion follow the Unicode Character Database the toolchain pins; the `is_ascii_*` and `to_ascii_*` forms consider ASCII alone.
pub mod Char;
pub use Char/{let Char};

--- Text as certified UTF-8.
---
--- A position is a byte offset proved to fall between characters (`Str/At`), so a slice is always whole characters; a count is in Unicode scalar values. Validity is checked once, when `of_bytes` turns bytes into text and reports where they stop being UTF-8 if they do; every operation preserves it, so nothing checks it again. Strings compare in code-point order.
pub mod Str;
pub use Str/{let Str};

--- A run of values of one type, written `[...]` with `..` spreads.
---
--- `fold` walks left to right with `f(elem, acc)`. `sort` and `sort_by` are stable merge sorts with their theorem beneath them, stated in `Permutation`, `Member`, `ordered` and `Pairwise`.
pub mod List;
pub use List/{let List};

--- A list that carries its length in its type.
pub mod Vec;
pub use Vec/{let Vec};

--- A value that may be absent, with `IsSome` as the decided proposition that says which.
pub mod Option;
pub use Option/{let Option};

--- Success or failure, the failure first, so the family is its own short-circuiting monad: `!` on one is early return.
---
--- A `Result` region performs nothing; a fallible action is a `Try`.
pub mod Result;
pub use Result/{let Result};

--- Pure state threading: a computation that reads and writes a state and performs nothing.
---
--- The value parameter sits last so the family partially applies as a monad. There is no edge from `Io` into a `State` region.
pub mod State;
pub use State/{let State};

--- A map from keys of one type to values, built and read under the `Map/Key` dictionary its type names.
---
--- Keys are stored as given and come back in their own order. Three proofs carry that: a `Map/Key` witness proves its encoding injective and order-preserving, every map holds the proof that its trie is sound, and the order of `keys` is a theorem beside it. The dictionary is part of the type, so maps under two dictionaries are two types; `rekey` converts between them.
pub mod Map;
pub use Map/{let Map};

--- A set of keys, with the surface of `Map` and the value elided.
pub mod Set;
pub use Set/{let Set};

--- A host path as the host holds it: bytes with `/` as the separator, never decoded on the way. `to_str` is where a program decodes one or refuses it.
pub mod Path;
pub use Path/{let Path};

--- A parser monad over an input's bytes or its text.
---
--- One parser type, `Parse(I, A)`, for either carrier: `Parse(Bytes, A)` reads bytes, and `Parse(Str, A)` reads text, its positions always between characters. The combinators and `run` are shared; each carrier's primitives are under `Parse/bytes` and `Parse/str`. A parser declines input that is not its shape, and `or` then tries the alternative, reporting whichever refusal got further when neither fits; after `commit`, a refusal is final. End with `eof()` to require the whole input. A refusal is a `Parse/Error`: what was expected, and at which byte offset.
pub mod Parse;
pub use Parse/{let Parse};

-- Host: what describes work the host does.
-- What every host module stands on and no program sees: a `pub` inside it reaches all of `/std` and no further, so no program holds a raw handle.
mod internal;

--- A description of a computation that touches the host, never its result.
---
--- Calling a host operation builds a description; only a program's tail performs one, and nothing takes an `Io(A)` to an `A`. A description that waits suspends, so it holds only the branch it runs in, and the host alone waits: `sleep`, `sleep_until` and `yield` suspend, `both` and `all` run descriptions side by side and answer once all have answered, `select` answers with the first of them to finish and cancels the rest, `timeout` is a `select` against a sleep, and `scope` runs a body with a `Scope`, the children it spawns beside it, joined one by one or all at once, and releases what was opened into it however it ends. A `Future`'s value and a `/std/Channel`'s items are waited on by their own `wait`, `receive` and `send`. `Read` and `Write` are what a stream is read and written through — the concepts a file, a socket, a child's pipe and this process's standard streams satisfy — with `copy` written once over them, `Finish` ends what a stream sends without closing it, and `Close` closes a resource before its scope does; `Reader` is a stream with the bytes read ahead of what was asked of it, kept where a cancel cannot lose them, through which a line, the rest of the stream or any other piece is cut from them. `Error` is the failure every host operation reports and `Chunk` what one read answers with.
pub mod Io;
pub use Io/{let Io};

--- A write-once cell in `Io`: initially empty, with the first fill kept.
pub mod Cell;
pub use Cell/{let Cell};

--- A bounded queue: a push waits while it is full, and a take while it is empty.
pub mod Channel;
pub use Channel/{let Channel};

--- One value kept for whoever holds the box, changed only by a pure function of it.
pub mod Box;
pub use Box/{let Box};

--- The error channel over a monad: an `M(Result(E, A))` sequenced so that a failure stops the region.
---
--- Inside a `Try` region, `!` sequences a `Result`, an action of the base monad, or an `Io` action where the base lifts one. Every host operation that can fail returns a `Try`. `both` and `all` run fallible actions side by side, the first failure failing them all.
pub mod Try;
pub use Try/{let Try};

--- What may close a program.
---
--- The concept the compiler executes a program's closing term through, witnessed by a description that yields nothing, by one over `Io` that may fail, and by a `Test`.
pub mod Program;
pub use Program/{let Program};

--- Checks `curios test` runs: the description a `test name = body;` declaration's body builds, with `assert`, `equal`, `all`, `perform` and `try`.
---
--- A test takes no parameters; a claim about every instantiation is a proof, a `let` whose type states it. `main` is the tail that runs a unit's tests and reports each as passed or failed, and `curios test` reports one that traps or exits as trapped or exited.
pub mod Test;
pub use Test/{let Test};

--- Interpolation against a format string, checked at the call.
---
--- A place takes one argument, shown at a `%` by any type's `Show` and spelled at a `#` by its `Spell`, with `\%` and `\#` for the literal characters. A missing or surplus argument is refused where the call is written.
pub mod Fmt;
pub use Fmt/{let Fmt};

--- Clocks and the calendar.
---
--- `Instant`, `Timestamp` and the `Duration` between two of either; `Date`, `Time`, `DateTime` and `Offset`, and the `OffsetDateTime` where the calendar meets the timeline.
---
--- `Instant` reads the monotonic clock and is for measuring; `Timestamp` is a moment on the wall clock; `Duration` is the signed distance between two of either. Each is a count of nanoseconds, and the two kinds of moment do not convert. The civil types hold their fields with proofs that they are in range, in the proleptic Gregorian calendar with a year 0, and a civil value names a moment only at an offset: `OffsetDateTime/of_timestamp` and `to_timestamp` convert. An `Offset` follows RFC 9557: so many seconds east of UTC, or the local offset unknown, which `Z` writes.
pub mod time;

--- Randomness from the host, in `Io`.
pub mod rand;

--- A universally unique identifier (RFC 9562): drawn at random or ordered by when it was made, and read and written as its canonical text or its sixteen bytes.
pub mod Uuid;
pub use Uuid/{let Uuid};

--- A program to run, the `Child` it runs as, and this process's own arguments, environment, working directory, exit and standard streams.
---
--- A child is spawned into a scope, which kills it when the scope ends, however it ends.
pub mod Proc;
pub use Proc/{let Proc};

--- The filesystem beyond a file's contents: what is at a path, a directory's entries, and making, moving and removing things.
---
--- Every operation is `Io`, and `Try` over it where it can fail.
pub mod fs;

--- A regular file the program opened.
---
--- Every operation is `Io`, since the disk answers at once, and what can fail is `Try` over `Io`. A file is a stream like any other, opened into a scope that closes it however the scope ends.
pub mod File;
pub use File/{let File};

--- The terminal a handle is attached to: raw mode for the rest of a scope, and its size.
pub mod Tty;
pub use Tty/{let Tty};

--- A serial device: a port opened at its speed and frame, and the devices the host has listed.
---
--- The port is read and written as a stream and drained, its DTR and RTS lines driven and its unread input dropped.
pub mod Serial;
pub use Serial/{let Serial};

--- TCP over the host's sockets: connections and listeners as streams, waiting by suspending wherever a peer decides.
pub mod tcp;

-- Formats: codecs that reach no host operation.
--- JSON, decoded from text and encoded as text.
---
--- Numbers are binary64 `Flt` and finite: an integer past `2^53` may decode inexactly, a number past binary64's range is refused, and a float that is not finite has no JSON value.
pub mod Json;
pub use Json/{let Json};

--- A TOML 1.0.0 codec over native `Int` and binary64 `Flt`.
---
--- `decode` reads one whole document under the table-construction rules; `encode` writes one deterministic document, which decodes back to the same value.
pub mod Toml;
pub use Toml/{let Toml};

--- An HTML tree, rendered escaped and read back as its renderer writes it.
pub mod Html;
pub use Html/{let Html};

-- Applications: protocols and frameworks.
--- HTTP/1.1 over `tcp`: the vocabulary of an exchange as data, a client that performs one and a server that answers one.
---
--- Messages are parsed as RFC 9112 frames them, by readers that hold no stream, and every message the types admit can be sent: a field name is a token, a field value holds no control octet, and the renderer writes the framing fields. Each end handles one message per connection, with whole bodies, within limits it states: the client has a deadline and a redirect limit, and the server answers a malformed request with its status and closes only once the peer has the reply.
pub mod http;

--- A command line described as data: the commands, options and positionals a program declares, and the parse a line reads into.
---
--- A malformed declaration, such as two options sharing a name, is refused where it is written, and the declaration determines the parsed result's type. Arguments and commands are read by name, and reading a name the declaration lacks is refused where it is written. Tokens follow GNU's conventions.
pub mod Cli;
pub use Cli/{let Cli};

--- A terminal interface: a screen is a view whose size is in its type, and a program is a model, an `update` and a `view` that the loop drives.
---
--- A view that does not fill its pane is refused where it is written; `View/fit` is the one coercion where a runtime size meets a typed one. `drive` is the loop with no terminal, for a test.
pub mod Tui;
pub use Tui/{let Tui};

--- `P`, a fact a term needs that no bound demands: the elaborator proves it from the facts in scope, or the program is refused naming them.
---
--- The proposition is written — `proved(@Bool/Holds(i < n))` — or pinned by the expectation, where the bound waits until it is and is proved then, from the facts the expression's own scope holds.
---
--- At `Bool/False` it is the contradiction a zero-arm match eliminates, `match proved(@Bool/False) end`, where the facts refute each other past what a match's cases state: a case of a match they rule out takes no arm at all. A producer, not an eliminator: the zero-arm match stays the one way a contradiction is discharged.
pub let proved(@P: Prop, @p: P) -> P =
    p;

-- What a write to `name` answered, taken as the printers take it: nothing where it succeeded, and otherwise the program ended, with 141 where the reader has gone and with 1 once standard error is told why, a failure there discarded so that it cannot recurse.
let answered(name: Str, r: Result(Io/Error, {})) -> Io({}) =
    match r
    | success(()) => Io/pure(())
    | failure(e) =>
        match e
        | broken_pipe() => Proc/exit(141)
        | _ =>
            let why = Str/flatten([name, " could not be written: ", Show/show(e), "\n"]);
            let _ = Try/run(Io/write(Proc/stderr, Str/to_bytes(why)))!;
            Proc/exit(1)
        end
    end;

--- `s` to standard output. A failed write ends the program: 141 where the reader has gone, 1 otherwise.
pub let print(s: Str) -> Io({}) =
    answered("standard output", Try/run(Io/write(Proc/stdout, Str/to_bytes(s)))!);

--- `s` to standard error. A failed write ends the program as `print`'s does.
pub let print_err(s: Str) -> Io({}) =
    answered("standard error", Try/run(Io/write(Proc/stderr, Str/to_bytes(s)))!);
