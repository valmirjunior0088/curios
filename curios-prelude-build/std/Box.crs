mod tests;

pub use /sys/{let Box};
pub use /sys/Box/{new, held};

use /std/{Io};

-- `/sys/Box/set` is spelled here alone: a program changes a box only through `change`, by a function of what it holds.
--- What `f` answers beside the value it leaves in `b`, given the value `b` holds.
pub let change(@A: Type, @B: Type, b: Box(A), f: (A) -> {A, B}) -> Io(B) =
    let a = held(b)!;
    let (left, answer) = f(a);
    let () = /sys/Box/set(b, left)!;
    Io/pure(answer);
