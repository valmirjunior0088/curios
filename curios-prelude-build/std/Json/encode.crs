use /std/{Str, Bool, Char, Nat, Int, Option, List, Json, Fmt};

-- `Int/to_str` signs every integer, which an exponent JSON writes does not need when it is positive.
--- `e` as an exponent is written: its digits, a minus before a negative one.
let exponent_text(e: Int) -> Str =
    Option/unwrap_or(Str/strip_prefix(Int/to_str(e), "+"), Int/to_str(e));

-- With `point` the place of the decimal point counted from the first digit, `n · 10^(point - k)` for the mantissa's `k` digits, these are ECMA-262's four layouts of `Number::toString`.
--- `n` as JavaScript's `Number.prototype.toString` lays out its digits, which `JSON.stringify` writes: positional from `1e-6` up to below `1e21`, `1.5`, `100`, `0.000001`, and past those one digit, the rest after a point and an exponent, `1e21`, `1.5e-7`.
let encode_num(n: Json/Number) -> Str =
    let magnitude = Int/abs(n.mantissa);
    let digits = Nat/to_str(magnitude);
    let k = Str/length(digits);
    let point = n.exponent + Nat/to_int(k);
    -- The first `at` digits and the rest, the rest keeping its leading zeros.
    let split(at: Nat) -> {Str, Str} =
        let scale = Nat/pow(10, k - at);
        let rest =
            match k - at
            | 0 => ""
            | width => Str/pad_start(Nat/to_str(magnitude % scale), width, '0')
            end;
        (Nat/to_str(magnitude / scale), rest);
    let laid =
        match
        | Nat/to_int(k) <= point && point <= +21 =>
            Str/concat(digits, Str/repeat("0", Int/to_nat(point - Nat/to_int(k))))
        | +0 < point && point <= +21 =>
            let (whole, fraction) = split(Int/to_nat(point));
            Str/flatten([whole, ".", fraction])
        | -6 < point && point <= +0 =>
            Str/flatten(["0.", Str/repeat("0", Int/to_nat(+0 - point)), digits])
        | _ =>
            let (first, rest) = split(1);
            let mark = match k | 1 => "" | _ => "." end;
            Str/flatten([first, mark, rest, "e", exponent_text(point - +1)])
        end;
    match n.mantissa < +0
    | true => Str/concat("-", laid)
    | false => laid
    end;

--- What a character is written as inside a string, when it is not written as itself: the quote, the backslash and the control characters, which JSON escapes.
let escaped(c: Char) -> Option(Str) =
    let n = Char/to_nat(c);
    match n
    | '"' => Option/some("\\\"")
    | '\\' => Option/some("\\\\")
    | '\n' => Option/some("\\n")
    | '\r' => Option/some("\\r")
    | '\t' => Option/some("\\t")
    | '\u{8}' => Option/some("\\b")
    | '\u{C}' => Option/some("\\f")
    | _ =>
        match n < ' '
        | true =>
            Option/some(
                Str/flatten([
                    "\\u00",
                    Str/of_char(Char/hex_digit(n / 0x10)),
                    Str/of_char(Char/hex_digit(n % 0x10))]))
        | false => Option/none()
        end
    end;

let encode_str(s: Str) -> Str =
    Str/flatten(["\"", Str/escape(s, escaped), "\""]);

--- `v` as a document on one line.
pub let encode(v: Json) -> Str =
    match v
    | null() => "null"
    | bool(b) => Bool/to_str(b)
    | num(n) => encode_num(n)
    | str(s) => encode_str(s)
    | arr(xs) => Fmt/render("[%]")(Str/join(",", List/map(xs, encode)))
    | obj(ps) =>
        Fmt/render("{%}")(
            Str/join(
                ",",
                List/map(ps, (pair: {Str, Json}) =>
                    Fmt/render("%:%")(encode_str(pair.0))(encode(pair.1)))))
    end;
