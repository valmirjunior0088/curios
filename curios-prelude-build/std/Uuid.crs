mod tests;

use /std/{Nat, Int, Byte, Bytes, Bool, Char, Option, List, Str, Eq, Ordering, Ord, Hash, Map, Show,
    Spell, Fmt, Io, rand, proved};
use /std/ops/{Eql};
use /std/time/{Timestamp};

--- A universally unique identifier (RFC 9562): sixteen bytes, laid out as the RFC lays them out, of any version and variant.
pub struct Uuid: pub Type {
    bytes: Bytes,
    --- That there are sixteen.
    @sixteen: Bool/Holds(Bytes/length(bytes) == 16),
}

--- The UUID the sixteen bytes `b` spell, in the order RFC 9562 lays them out: any sixteen bytes, of any version and variant, as a UUID read off a wire or out of a store is. Their count is decided where `b` is written, so a literal needs nothing more.
pub let of_bytes(b: Bytes, @sixteen: Bool/Holds(Bytes/length(b) == 16)) -> Uuid =
    Uuid { bytes = b };

--- The sixteen bytes, in the order RFC 9562 lays them out.
pub let to_bytes(u: Uuid) -> Bytes =
    u.bytes;

-- The byte of `b` at `i`, or `0` past its end: what a UUID is made of where `b` holds fewer bytes than were drawn.
let byte_at(b: Bytes, i: Nat) -> Byte =
    match Bytes/try_get(b, i) | some(byte) => byte | none() => 0 end;

-- `byte` with its high bits `high` in place of its own, as many of them as `mask` clears: a version's nibble or a variant's two bits.
let marked(byte: Byte, mask: Byte, high: Byte) -> Byte =
    Byte/or(Byte/and(byte, mask), high);

-- The sixteen bytes of `drawn` as a UUID of version `version`, its version's nibble and its variant's bits, `10`, set.
let versioned(drawn: Bytes, version: Byte) -> Uuid =
    Uuid {
        bytes =
            0x[
                byte_at(drawn, 0),
                byte_at(drawn, 1),
                byte_at(drawn, 2),
                byte_at(drawn, 3),
                byte_at(drawn, 4),
                byte_at(drawn, 5),
                marked(byte_at(drawn, 6), 0x0F, version),
                byte_at(drawn, 7),
                marked(byte_at(drawn, 8), 0x3F, 0x80),
                byte_at(drawn, 9),
                byte_at(drawn, 10),
                byte_at(drawn, 11),
                byte_at(drawn, 12),
                byte_at(drawn, 13),
                byte_at(drawn, 14),
                byte_at(drawn, 15)] };

--- A random UUID, version 4 (RFC 9562 §5.4): 122 random bits beside its version and variant.
pub let random() -> Io(Uuid) =
    let drawn = rand/bytes(16)!;
    Io/pure(versioned(drawn, 0x40));

-- The byte of `n` at `place`, counted from its least significant.
let byte_of(n: Nat, place: Nat) -> Byte =
    Nat/to_byte(n / Nat/pow(256, place) % 256);

-- The UUID of version 7 `nanos` nanoseconds after 1970 makes of `drawn`: the milliseconds in the first 48 bits, the fraction of the millisecond in twelve, and the 62 bits after the variant drawn. A moment before 1970 is read as 1970, which RFC 9562's unsigned timestamp has no earlier moment than.
let at_time(nanos: Int, drawn: Bytes) -> Uuid =
    let since = Int/to_nat(Int/max(nanos, +0));
    let millis = since / 1000000 % Nat/pow(2, 48);
    let fraction = since % 1000000 * 4096 / 1000000;
    Uuid {
        bytes =
            0x[
                byte_of(millis, 5),
                byte_of(millis, 4),
                byte_of(millis, 3),
                byte_of(millis, 2),
                byte_of(millis, 1),
                byte_of(millis, 0),
                marked(byte_of(fraction, 1), 0x0F, 0x70),
                byte_of(fraction, 0),
                marked(byte_at(drawn, 0), 0x3F, 0x80),
                byte_at(drawn, 1),
                byte_at(drawn, 2),
                byte_at(drawn, 3),
                byte_at(drawn, 4),
                byte_at(drawn, 5),
                byte_at(drawn, 6),
                byte_at(drawn, 7)] };

--- A UUID ordered by when it was made, version 7 (RFC 9562 §5.7): the milliseconds since 1970 in its first 48 bits, the fraction of the millisecond in the twelve after its version, read off the nanosecond clock as §6.2's third method reads it, and 62 random bits after its variant, so the UUIDs a program makes sort by when it made them to about a quarter of a microsecond, as far as the wall clock moves forward. A clock before 1970 is read as 1970.
pub let now() -> Io(Uuid) =
    let at = Timestamp/now()!;
    let drawn = rand/bytes(8)!;
    Io/pure(at_time(Timestamp/to_unix_nanos(at), drawn));

--- The canonical text (RFC 9562 §4): 32 lowercase hexadecimal digits in groups of eight, four, four, four and twelve, a hyphen between each, `919108f7-52d1-4320-9bac-f847db4148a8`.
pub let to_str(u: Uuid) -> Str =
    let written =
        Bytes/fold(
            u.bytes,
            ("", 0),
            (byte, (text, i)) =>
                let digits =
                    Str/concat(
                        Str/of_char(Char/hex_digit(Byte/to_nat(byte) / 16)),
                        Str/of_char(Char/hex_digit(Byte/to_nat(byte) % 16)));
                let hyphen =
                    match i == 4 || i == 6 || i == 8 || i == 10
                    | true => "-"
                    | false => ""
                    end;
                (Str/concat(text, Str/concat(hyphen, digits)), i + 1));
    written.0;

-- The bytes the hexadecimal digits `digits` spell, two a byte, or `none` where one is no digit or one is left over.
let of_digits(digits: List(Char)) -> Option(Bytes) =
    match digits
    | [] => Option/some(0x[])
    | [high, low, ..rest] =>
        let h = Char/of_hex_digit(high)!;
        let l = Char/of_hex_digit(low)!;
        let after = of_digits(rest)!;
        -- Two digits below sixteen make a byte, which the remainder only states.
        Option/some(0x[Nat/to_byte((h * 16 + l) % 256), ..after])
    | _ => Option/none()
    end;

-- Whether `chars`, the `i`th of the text on, end at its thirty-sixth and hold a hyphen exactly where the canonical text does.
let hyphened(chars: List(Char), i: Nat) -> Bool =
    match chars
    | [] => i == 36
    | [c, ..rest] => c == '-' == (i == 8 || i == 13 || i == 18 || i == 23) && hyphened(rest, i + 1)
    end;

--- The UUID the canonical text `s` writes (RFC 9562 §4), its digits in either case as the RFC reads them, or `none` where `s` is not 36 characters, its hyphens after the eighth, twelfth, sixteenth and twentieth digit, and the rest hexadecimal.
pub let of_str(s: Str) -> Option(Uuid) =
    let chars = Str/to_list(s);
    match hyphened(chars, 0)
    | false => Option/none()
    | true =>
        let b = of_digits(List/filter(chars, (c) => c != '-'))!;
        match Bool/holds(Bytes/length(b) == 16)
        | some(sixteen) => Option/some(Uuid { bytes = b, @sixteen = sixteen })
        | none() => Option/none()
        end
    end;

--- Two UUIDs of the same bytes are one UUID: the count of sixteen is a proof, and any two of it are one.
pub let eq_of_bytes(a: Uuid, b: Uuid, p: Eq()(a.bytes, b.bytes)) -> Eq()(a, b) =
    Eq/subst(
        (bytes: Bytes) =>
            (sixteen: Bool/Holds(Bytes/length(bytes) == 16)) -> Eq()(
                a,
                Uuid { bytes = bytes, @sixteen = sixteen }),
        p,
        (_: Bool/Holds(Bytes/length(a.bytes) == 16)) => Eq/refl())(
        b.sixteen);

satisfy Eql(Uuid) {
    eql(a, b) = a.bytes == b.bytes,
    eq(a, b, h) = eq_of_bytes(a, b, proved()),
    refl(a) = Eql/refl(a.bytes),
}

--- The order of their bytes, which is the order a version 7's were made in.
satisfy Ord(Uuid) {
    ord(a, b) = Bytes/ord(a.bytes, b.bytes),
    lt(a, b) = Ordering/is_lt(Bytes/ord(a.bytes, b.bytes)),
    le(a, b) = Ordering/is_le(Bytes/ord(a.bytes, b.bytes)),
    flips(a, b) = Ord/flips(a.bytes, b.bytes),
    trans(a, b, c, p, q) = Ord/trans(a.bytes, b.bytes, c.bytes, p, q),
    eq(a, b, h) = eq_of_bytes(a, b, Ord/eq(a.bytes, b.bytes, h)),
    is_lt(_, _) = Eq/refl(),
    is_le(_, _) = Eq/refl(),
}

--- The sixteen bytes.
satisfy Hash(Uuid) {
    hash = to_bytes,
}

--- The sixteen bytes, whose order is the UUIDs'.
satisfy Map/Key(Uuid) {
    inj(a, b, same) = eq_of_bytes(a, b, same),
    monotone(_, _) = Eq/refl(),
}

--- The canonical text.
satisfy Show(Uuid) {
    show = to_str,
}

--- As the call over its bytes that makes it: `Uuid/of_bytes(0x[145, 145, …])`.
satisfy Spell(Uuid) {
    spell(u) = Fmt/render("Uuid/of_bytes(#)")(u.bytes),
}
