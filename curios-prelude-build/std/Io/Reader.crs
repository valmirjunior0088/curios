--- The pieces the named reads ask for.
pub mod piece;

use /std/{Nat, Bytes, Byte, Bool, Str, Option, Result, Spell, Box, Io, Try};
use /std/ops/{Eql};
use /std/Io/{Error};

--- What a piece made of the bytes it was asked of.
---
--- A piece holds no stream: a reader asks it again once more bytes have arrived, and whoever asked the reader decides what a stream that ended means.
pub induct Step(St: Type, R: Type, A: Type): pub Type
--- Not all of it has arrived: where to resume, and the bytes still held, so the next look reads none of them twice.
| more(St, Bytes)
--- The piece, and the bytes after it.
| took(A, Bytes)
| refused(R)
end

satisfy (
    @St: Type,
    @R: Type,
    @A: Type,
    use Eql(St),
    use Eql(R),
    use Eql(A),
) => Eql(Step(St, R, A)) {
    ..
}

satisfy (
    @St: Type,
    @R: Type,
    @A: Type,
    use Spell(St),
    use Spell(R),
    use Spell(A),
) => Spell(Step(St, R, A)) {
    ..
}

--- How a piece went unread. The bytes held stay in the reader each time.
pub induct Stop(St: Type, R: Type): pub Type
--- It refused what arrived.
| refused(R)
--- The stream ended first: where the piece stood.
| ended(St)
--- The stream failed: where the piece stood, and the failure.
| failed(St, Error)
end

-- What a reader keeps: the bytes read past the last piece, and how many pieces have been cut from them.
struct Held: Type {
    cuts: Nat,
    bytes: Bytes,
}

--- A stream with the bytes read ahead of what was asked of it, kept beside the stream: a read answers its piece, and the reader it was asked of is the reader after it. A read that a deadline abandons has put back what it took, and two branches reading one reader each get whole pieces.
pub struct Reader(S: Type): Type {
    stream: S,
    limit: Nat,
    ahead: Box(Held),
}

--- A reader over `stream` whose named reads refuse a piece past `limit` bytes.
pub let within(@S: Type, stream: S, limit: Nat) -> Io(Reader(S)) =
    let ahead = Box/new(Held { cuts = 0, bytes = 0x[] })!;
    Io/pure(Reader { stream = stream, limit = limit, ahead = ahead });

--- A reader over `stream` whose named reads refuse a piece past 1 MiB.
pub let new(@S: Type, stream: S) -> Io(Reader(S)) =
    within(stream, 1048576);

--- The bytes `r` holds, left where they are.
pub let held(@S: Type, r: Reader(S)) -> Io(Bytes) =
    Box/change(r.ahead, (now: Held) => (now, now.bytes));

-- Everything `r` holds, taken as one piece.
let drained(@S: Type, r: Reader(S)) -> Io(Bytes) =
    Box/change(r.ahead, (now: Held) => (Held { cuts = now.cuts + 1, bytes = 0x[] }, now.bytes));

-- Whether `r` holds other than the `bytes` a piece left at `cuts`: what another reader cut or took in meanwhile, which the piece has not been asked of.
let touched(@S: Type, r: Reader(S), cuts: Nat, bytes: Bytes) -> Io(Bool) =
    Box/change(r.ahead, (now: Held) =>
        (now, Bool/not(now.cuts == cuts && Bytes/len(now.bytes) == Bytes/len(bytes))));

-- `piece` asked of what `now` holds, from `from` where no other reader has cut since `seen` and from `state` where one has: what it answers, beside what the reader keeps after it and how many pieces it has cut by then. A piece that kept fewer bytes than it was asked of has cut some.
let looked(
    @St: Type,
    @R: Type,
    @A: Type,
    piece: (St, Bytes) -> Step(St, R, A),
    state: St,
    from: St,
    seen: Nat,
    now: Held,
) -> {Held, {Step(St, R, A), Nat}} =
    let at = match seen == now.cuts | true => from | false => state end;
    let step = piece(at, now.bytes);
    match step
    | took(_, rest) => (Held { cuts = now.cuts + 1, bytes = rest }, (step, now.cuts + 1))
    | refused(_) => (now, (step, now.cuts))
    | more(_, bytes) =>
        let cuts =
            match Bytes/len(bytes) == Bytes/len(now.bytes)
            | true => now.cuts
            | false => now.cuts + 1
            end;
        (Held { cuts = cuts, bytes = bytes }, (step, cuts))
    end;

--- `piece` asked of the bytes `r` holds, and asked again each time its stream yields more, until it answers: the piece, or how it went unread. The bytes after the piece, and all of them where there is none, stay in `r`.
---
--- The bytes are put back before every read of the stream, so a read abandoned while it waits has lost nothing. A piece another reader cut meanwhile is seen by its count, and the search starts over from `state`.
pub let take(
    @S: Type,
    @St: Type,
    @R: Type,
    @A: Type,
    use Io/Read(S),
    r: Reader(S),
    piece: (St, Bytes) -> Step(St, R, A),
    state: St,
) -> Io(Result(Stop(St, R), A)) =
    let go(from: St, seen: Nat) -> Io(Result(Stop(St, R), A)) =
        let (step, cuts) =
            Box/change(r.ahead, (now: Held) => looked(piece, state, from, seen, now))!;
        match step
        | took(a, _) => Io/pure(Result/success(a))
        | refused(why) => Io/pure(Result/failure(Stop/refused(why)))
        | more(next, bytes) =>
            let arrived = Try/run(Io/read(@S, r.stream, 65536))!;
            match arrived
            | success(bytes(fresh)) =>
                let () =
                    Box/change(r.ahead, (then: Held) =>
                        (Held { cuts = then.cuts, bytes = 0x[..then.bytes, ..fresh] }, ()))!;
                go(next, cuts)
            | success(ended()) =>
                let moved = touched(r, cuts, bytes)!;
                match moved
                | true => go(next, cuts)
                | false => Io/pure(Result/failure(Stop/ended(next)))
                end
            | failure(e) =>
                let moved = touched(r, cuts, bytes)!;
                match moved
                | true => go(next, cuts)
                | false => Io/pure(Result/failure(Stop/failed(next, e)))
                end
            end
        end;
    go(state, 0);

-- A named read's answer where its piece went unread: the refusal or the failure raised, and `at_end` of what `r` held where its stream ended.
let settled(
    @S: Type,
    @St: Type,
    @A: Type,
    @B: Type,
    r: Reader(S),
    got: Result(Stop(St, Error), A),
    whole: (A) -> B,
    at_end: (Bytes) -> B,
) -> Io(Result(Error, B)) =
    match got
    | success(a) => Io/pure(Result/success(whole(a)))
    | failure(stop) =>
        match stop
        | refused(why) => Io/pure(Result/failure(why))
        | failed(_, e) => Io/pure(Result/failure(e))
        | ended(_) =>
            let last = drained(r)!;
            Io/pure(Result/success(at_end(last)))
        end
    end;

--- One line without its line ending — a newline, or a carriage return and a newline. Where the stream ends, what is held is the last line, and `none` where nothing is. A line past `r`'s bound is `too_long`, and its bytes stay held.
pub let line(@S: Type, use Io/Read(S), r: Reader(S)) -> Try(Io, Error, Option(Bytes)) =
    let read() -> Io(Result(Error, Option(Bytes))) =
        let got =
            take(r, (searched: Nat, bytes: Bytes) => piece/line(r.limit, searched, bytes), 0)!;
        settled(
            r,
            got,
            (found: Bytes) => Option/some(found),
            (last: Bytes) =>
                match Bytes/len(last) == 0
                | true => Option/none()
                | false => Option/some(last)
                end);
    Try/attempt(read());

--- One line as text: `line`, its bytes read as UTF-8. A line that is not text is `not_text` with the length of its longest prefix that is, and is taken as the bytes it was.
pub let line_text(@S: Type, use Io/Read(S), r: Reader(S)) -> Try(Io, Error, Option(Str)) =
    let found = line(r)!;
    match found
    | none() => Try/pure(Option/none())
    | some(bytes) =>
        match Str/of_bytes(bytes)
        | success(text) => Try/pure(Option/some(text))
        | failure(valid) => Try/raise(Error/not_text(valid))
        end
    end;

--- The bytes before the first `delimiter`, which is taken and dropped, and whether it was met: where the stream ends first, what is held and `false`. Bytes past `r`'s bound with no delimiter among them are `too_long`, and stay held.
pub let until(
    @S: Type,
    use Io/Read(S),
    r: Reader(S),
    delimiter: Byte,
) -> Try(Io, Error, {bytes: Bytes, met: Bool}) =
    let read() -> Io(Result(Error, {bytes: Bytes, met: Bool})) =
        let got =
            take(
                r,
                (searched: Nat, bytes: Bytes) => piece/until(r.limit, delimiter, searched, bytes),
                0)!;
        settled(
            r,
            got,
            (found: Bytes) => (bytes = found, met = true),
            (last: Bytes) => (bytes = last, met = false));
    Try/attempt(read());

--- `n` bytes, and whether there were that many: where the stream ends short of them, what arrived and `false`. A count past `r`'s bound is `too_long` before any of it is read.
pub let exactly(
    @S: Type,
    use Io/Read(S),
    r: Reader(S),
    n: Nat,
) -> Try(Io, Error, {bytes: Bytes, whole: Bool}) =
    let read() -> Io(Result(Error, {bytes: Bytes, whole: Bool})) =
        let got = take(r, ((): {}, bytes: Bytes) => piece/exactly(r.limit, n, bytes), ())!;
        settled(
            r,
            got,
            (found: Bytes) => (bytes = found, whole = true),
            (last: Bytes) => (bytes = last, whole = false));
    Try/attempt(read());

--- Everything up to the end of the stream, the bytes held first. More than `r`'s bound is `too_long`, and stays held.
pub let rest(@S: Type, use Io/Read(S), r: Reader(S)) -> Try(Io, Error, Bytes) =
    let read() -> Io(Result(Error, Bytes)) =
        let got = take(r, ((): {}, bytes: Bytes) => piece/rest(r.limit, bytes), ())!;
        settled(r, got, (found: Bytes) => found, (last: Bytes) => last);
    Try/attempt(read());
