--- Waiting for a task's answer.
pub mod Task;

use /std/{Nat, List, Channel, Io};
use /std/Io/{Ended, Future, Branch, drive, into, answered, using};

-- How many children of a scope have not ended, in a `/sys` channel of one slot nothing waits on, and a channel notified as each ends, whose notifications coalesce while one is unread: what `join_all` waits on, a count rather than the tasks, so a scope that spawns without end holds nothing of the children that have ended.
struct Live: Type {
    count: /sys/Channel(Nat),
    ended: Channel({}),
}

-- `change` applied to the count of `live`.
let counted(live: Live, change: (Nat) -> Nat) -> Io({}) =
    let held = /sys/Channel/take(live.count)!;
    let n = match held | item(n) => n | _ => 0 end;
    let _ = /sys/Channel/push(live.count, change(n))!;
    Io/pure(());

-- One child of `live` ended.
let ended(live: Live) -> Io({}) =
    let () = counted(live, (n) => match n | 0 => 0 | m + 1 => m end)!;
    let _ = Channel/try_send(live.ended, ())!;
    Io/pure(());

-- The children spawned since the driver last took them, the latest first, and the releases deferred so far, each a list in a `/sys` channel of one slot: nothing waits on either, so neither needs a `Channel`'s wakes, and a spawn never waits on a full queue.
--- What a scope's body spawns its children into and defers its releases to.
pub struct Scope: Type {
    children: /sys/Channel(List(Io({}))),
    live: Live,
    releases: /sys/Channel(List((Ended) -> Io({}))),
}

-- `Task` is declared here and not in its module, so that `spawn` builds it and nothing outside this subtree does.
--- A child a scope runs: its answer once it has one.
pub struct Task(A: Type): Type {
    Future(A),
}

--- `child` run beside the body of the scope `s`, answering at once with the task `Task/join` waits on. A child still running when the body of its scope answers is cancelled where it waits, and one spawned once the scope has answered never runs. What it answers, a failure as much as a value, is read only by a join: a child nobody joins fails without anyone hearing it.
pub let spawn(@A: Type, s: Scope, child: Io(A)) -> Io(Task(A)) =
    let f = Future/new()!;
    let () = counted(s.live, (n) => n + 1)!;
    let finished = Io/bind(child, (a) => Io/bind(Future/fill(f, a), (()) => ended(s.live)));
    let held = /sys/Channel/take(s.children)!;
    let earlier = match held | item(cs) => cs | _ => [] end;
    let _ = /sys/Channel/push(s.children, [finished, ..earlier])!;
    Io/pure(Task { f });

--- Until every child spawned into `s` has ended, those spawned meanwhile among them: what a body that needs all of its children finished asks before it answers.
pub let join_all(s: Scope) -> Io({}) =
    let held = /sys/Channel/take(s.live.count)!;
    let n = match held | item(n) => n | _ => 0 end;
    let _ = /sys/Channel/push(s.live.count, n)!;
    match n
    | 0 => Io/pure(())
    | _ =>
        let _ = Channel/receive(s.live.ended)!;
        join_all(s)
    end;

--- `release` run when `s` ends, told how it ended: after its children are cancelled, and before every release deferred to it earlier. What a scope's resources are closed by, so nothing opened into a scope outlives it.
pub let defer(s: Scope, release: (Ended) -> Io({})) -> Io({}) =
    let held = /sys/Channel/take(s.releases)!;
    let earlier = match held | item(rs) => rs | _ => [] end;
    let _ = /sys/Channel/push(s.releases, [release, ..earlier])!;
    Io/pure(());

-- Each of `releases` told `how`, in its order.
let each(releases: List((Ended) -> Io({})), how: Ended) -> Io({}) =
    match releases
    | [] => Io/pure(())
    | [r, ..more] => Io/bind(r(how), (()) => each(more, how))
    end;

-- Every release deferred to `s`, the latest first, told `how` it ended.
let released(s: Scope, how: Ended) -> Io({}) =
    let held = /sys/Channel/take(s.releases)!;
    match held | item(rs) => each(rs, how) | _ => Io/pure(()) end;

-- Every child spawned into `slot` since the last time it was asked, in the order they were spawned.
let spawned(slot: /sys/Channel(List(Io({})))) -> Io(List(Branch)) =
    let taken = /sys/Channel/take(slot)!;
    match taken
    | item(children) => Io/pure(List/map(List/reverse(children), Branch/fresh))
    | _ => Io/pure([])
    end;

--- `body` run with a scope it spawns children into and opens resources into, and its answer once it has one. The children run beside the body, and those still running when the body answers are cancelled where they wait: a description's answer is all it yields, so a child the body needs is joined before it answers. Then every release deferred to the scope runs, the latest first, told whether the scope `finished` or was `cancelled` where it waited — however it ends, its children are cancelled before its resources are released.
pub let run(@A: Type, body: (Scope) -> Io(A)) -> Io(A) =
    let children = /sys/Channel/new(@List(Io({})), 1)!;
    let count = /sys/Channel/new(@Nat, 1)!;
    let ended = Channel/new(@{}, 1)!;
    let releases = /sys/Channel/new(@List((Ended) -> Io({})), 1)!;
    let s =
        Scope {
            children = children,
            live = Live { count = count, ended = ended },
            releases = releases };
    let answer: Future(A) = Future/new()!;
    let driven() -> Io(A) =
        let () = drive([into(body(s), answer)], spawned(children), answered(answer))!;
        let () = /sys/Channel/close(children)!;
        Future/wait(answer);
    using((how) => released(s, how), driven());
