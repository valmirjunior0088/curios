--- Waiting for a task's answer.
pub mod Task;

use /std/{Nat, List, Option, Channel, Box, Io};
use /std/Io/{let Scope, Live, Future};

--- How a scope ended, as each release deferred to it is told.
pub induct Ended: pub Type
--- It ran to its end.
| finished()
--- What advanced it dropped it while it waited.
| cancelled()
end

-- `by` applied to the count of `live`.
let counted(live: Live, by: (Nat) -> Nat) -> Io({}) =
    Box/change(live.count, (n: Nat) => (by(n), ()));

-- One child of `live` ended.
let ended(live: Live) -> Io({}) =
    let () = counted(live, (n) => match n | 0 => 0 | m + 1 => m end)!;
    let _ = Channel/try_push(live.ended, ())!;
    Io/pure(());

-- `Task` is declared here and not in its module, so that `spawn` builds it and nothing outside this subtree does.
--- A child a scope runs: its answer once it has one.
pub struct Task(A: Type): Type {
    Future(A),
}

--- `child` run beside the body of the scope `s`, answering at once with the task `Task/join` waits on. A child still running when the body of its scope answers is cancelled where it waits, and one spawned once the scope has answered never runs. What it answers, a failure as much as a value, is read only by a join: a child nobody joins fails without anyone hearing it.
pub let spawn(@A: Type, s: Scope, child: Io(A)) -> Io(Task(A)) =
    let f = Future/new()!;
    let () = counted(s.live, (n) => n + 1)!;
    let finished = Io/bind(child, (a) => Io/bind(Future/fill(f, a), (()) => ended(s.live)));
    let () =
        Box/change(s.children, (held: Option(List(Io({})))) =>
            match held
            | some(earlier) => (Option/some([finished, ..earlier]), ())
            | none() => (Option/none(), ())
            end)!;
    Io/pure(Task { f });

--- Until every child spawned into `s` has ended, those spawned meanwhile among them: what a body that needs all of its children finished asks before it answers.
pub let join_all(s: Scope) -> Io({}) =
    let n = Box/held(s.live.count)!;
    match n
    | 0 => Io/pure(())
    | _ =>
        let _ = Channel/take(s.live.ended)!;
        join_all(s)
    end;

--- `release` run when `s` ends, told how it ended: after its children are cancelled, and before every release deferred to it earlier. What a scope's resources are closed by, so nothing opened into a scope outlives it.
pub let defer(s: Scope, release: (Ended) -> Io({})) -> Io({}) =
    Box/change(s.releases, (earlier: List((Ended) -> Io({}))) => ([release, ..earlier], ()));
