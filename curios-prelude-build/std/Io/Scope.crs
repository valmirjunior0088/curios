--- Waiting for a task's answer.
pub mod Task;

use /std/{List, Option, Box, Io};
use /std/Io/{Latch};
use /std/Io/{let Scope, Live, Future};
use /std/internal/{Waiting, on_tripped, until};

--- How a scope ended, as each release deferred to it is told.
pub induct Ended: pub Type
--- It ran to its end.
| finished()
--- What advanced it dropped it while it waited.
| cancelled()
end

-- One more child of `live`.
let started(live: Box(Live)) -> Io({}) =
    Box/update(live, (l: Live) => Live { ..l, count = l.count + 1 });

-- One child of `live` ended: the count lowered, and every join waiting woken where none is left.
let ended(live: Box(Live)) -> Io({}) =
    let idle =
        Box/change(live, (l: Live) =>
            match l.count
            | m + 2 => (Live { ..l, count = m + 1 }, Option/none())
            | _ => (Live { count = 0, idle = Option/none() }, l.idle)
            end)!;
    match idle
    | some(latch) => Latch/trip(latch)
    | none() => Io/pure(())
    end;

-- A join's attempt: done where no child of `live` is left.
let none_left(live: Box(Live)) -> Io(Option({})) =
    let l = Box/get(live)!;
    Io/pure(match l.count | 0 => Option/some(()) | _ => Option/none() end);

-- The latch a join waits on while children are left: the one there, or a fresh one left there. The latch is made before the change that leaves it, since a change cannot make one, and only where none is there.
let idle_latch(live: Box(Live)) -> Io(Latch) =
    let there = Box/get(live)!;
    match there.idle
    | some(latch) => Io/pure(latch)
    | none() =>
        let fresh = Latch/new()!;
        Box/change(live, (l: Live) =>
            match l.idle
            | some(latch) => (l, latch)
            | none() => (Live { ..l, idle = Option/some(fresh) }, fresh)
            end)
    end;

-- What a join suspends on.
let idled(live: Box(Live)) -> Io(Waiting) =
    let latch = idle_latch(live)!;
    Io/pure(on_tripped([latch]));

-- `Task` is declared here and not in its module, so that `spawn` builds it and nothing outside this subtree does.
--- A child a scope runs: its answer once it has one.
pub struct Task(A: Type): Type {
    Future(A),
}

--- `child` run beside the body of the scope `s`, answering at once with the task `Task/join` waits on. A child still running when the body of its scope answers is cancelled where it waits, and one spawned once the scope has answered never runs. What it answers, a failure as much as a value, is read only by a join: a child nobody joins fails without anyone hearing it.
pub let spawn(@A: Type, s: Scope, child: Io(A)) -> Io(Task(A)) =
    let f = Future/new()!;
    let () = started(s.live)!;
    let finished = Io/bind(child, (a) => Io/bind(Future/fill(f, a), (()) => ended(s.live)));
    let () =
        Box/update(s.children, (held: Option(List(Io({})))) =>
            match held
            | some(earlier) => Option/some([finished, ..earlier])
            | none() => Option/none()
            end)!;
    Io/pure(Task { f });

--- Until every child spawned into `s` has ended, those spawned meanwhile among them: what a body that needs all of its children finished asks before it answers.
pub let join_all(s: Scope) -> Io({}) =
    until(none_left(s.live), idled(s.live));

--- `release` run when `s` ends, told how it ended: after its children are cancelled, and before every release deferred to it earlier. What a scope's resources are closed by, so nothing opened into a scope outlives it.
pub let defer(s: Scope, release: (Ended) -> Io({})) -> Io({}) =
    Box/update(s.releases, (earlier: List((Ended) -> Io({}))) => [release, ..earlier]);
