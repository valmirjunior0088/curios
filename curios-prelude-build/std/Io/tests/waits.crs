-- Waiting in `Io`: what a wait holds of the branch beside it, what a scope tells its releases, and what a fulfilment, a push, a selection, a notification and a cancellation wake.
use /std/{Bool, Io, Nat, Option, Test, Channel};
use /std/Io/{Future, Latch};
use /std/time/{Duration};

-- A finalizer that leaves how its body ended where a take finds it.
let told(c: Channel(Io/Scope/Ended), ended: Io/Scope/Ended) -> Io({}) =>
    let _ = Channel/try_push(c, ended)!;
    Io/pure(());

-- Whether the next take is `finished`, where `finished` says so, or `cancelled` otherwise.
let heard(c: Channel(Io/Scope/Ended), finished: Bool) -> Io(Bool) =>
    let taken = Channel/try_take(c)!;
    Io/pure(
        match taken
        | item(ended) =>
            match ended
            | finished() => finished
            | cancelled() => Bool/not(finished)
            end
        | _ => false
        end);

test a_yield_at_the_top_of_a_program_goes_on =>
    let () = Io/yield()!;
    Test/assert("the program goes on past the yield", true);

test a_sleep_holds_only_its_own_branch =>
    let n = Io/select([Io/bind(Io/sleep(Duration/of_secs(3600)), (()) => Io/pure(1)), Io/pure(2)])!;
    Test/assert("the branch that does not sleep wins", n == 2);

test a_wait_on_a_future_goes_on_once_the_branch_beside_it_fills_it =>
    let f = Future/new(@{})!;
    let (waited, ()) = Io/both(Io/bind(Future/wait(f), (()) => Io/pure(true)), Future/fill(f, ()))!;
    Test/assert("the wait goes on once the future is filled", waited);

test a_scope_tells_its_release_a_body_ran_to_its_end =>
    let endings = Channel/new(@Io/Scope/Ended, 1)!;
    let n =
        Io/scope((scope) =>
            Io/bind(Io/Scope/defer(scope, (ended) => told(endings, ended)), (()) => Io/pure(3)))!;
    let finished = heard(endings, true)!;
    Test/assert("the body ran to its end and its release was told so", n == 3 && finished);

test a_scope_tells_its_release_a_body_was_dropped_while_it_waited =>
    let endings = Channel/new(@Io/Scope/Ended, 1)!;
    let never = Future/new(@{})!;
    let body =
        Io/scope((scope) =>
            Io/bind(
                Io/Scope/defer(scope, (ended) => told(endings, ended)),
                (()) => Io/bind(Future/wait(never), (()) => Io/pure(3))));
    let _ = Io/select([body, Io/pure(4)])!;
    let cancelled = heard(endings, false)!;
    Test/assert("the release was told the body was dropped", cancelled);

-- Two branches of a body each wait for the scope's children: the child's end wakes both, where a wake one of them took would leave the other waiting for good.
test every_join_of_a_scope_answers_once_its_children_have_ended =>
    let joined =
        Io/scope((scope) =>
            let _ = Io/Scope/spawn(scope, Io/yield())!;
            let _ = Io/both(Io/Scope/join_all(scope), Io/Scope/join_all(scope))!;
            Io/pure(true))!;
    Test/assert("both joins answered", joined);

-- The value a take found, where it found one.
let found(@A: Type, taken: Channel/Take(A)) -> Option(A) =>
    match taken | item(a) => Option/some(a) | _ => Option/none() end;

-- One fulfilment answers a selection once, however many of its actions wait on the same future.
test a_fulfilment_answers_a_selection_once_across_actions_waiting_on_it =>
    let wakes = Channel/new(@Nat, 2)!;
    let n =
        Io/scope((s) =>
            let f = Future/new(@Nat)!;
            let waiter() -> Io(Nat) =>
                let n = Io/select([Future/wait(f), Future/wait(f)])!;
                let _ = Channel/try_push(wakes, 1)!;
                Io/pure(n);
            let task = Io/Scope/spawn(s, waiter())!;
            let () = Io/yield()!;
            let () = Future/fill(f, 7)!;
            Io/Scope/Task/join(task))!;
    let first = Channel/try_take(wakes)!;
    let second = Channel/try_take(wakes)!;
    Test/all([
        Test/equal(n, 7),
        Test/equal([found(first), found(second)], [Option/some(1), Option/none()])]);

-- A push wakes every taker waiting on the channel, and the one that does not get the value waits again: the second push reaches it.
test two_woken_takers_retry_after_only_one_can_take =>
    let (x, y) =
        Io/scope((s) =>
            let c = Channel/new(@Nat, 1)!;
            let first = Future/new(@{})!;
            let taker() -> Io(Nat) =>
                let got = Channel/take(c)!;
                let () = Future/fill(first, ())!;
                Io/pure(Option/unwrap_or(got, 0));
            let a = Io/Scope/spawn(s, taker())!;
            let b = Io/Scope/spawn(s, taker())!;
            let () = Io/yield()!;
            let _ = Channel/push(c, 1)!;
            let () = Future/wait(first)!;
            let _ = Channel/push(c, 2)!;
            let x = Io/Scope/Task/join(a)!;
            let y = Io/Scope/Task/join(b)!;
            Io/pure((x, y)))!;
    Test/equal([x, y], [1, 2]);

-- A take that loses a selection has taken nothing and waits on nothing after it: a message pushed once the selection has answered stays in its channel, unacknowledged, for the next take.
test a_losing_take_neither_takes_a_later_message_nor_acknowledges_it =>
    let (acknowledged, n) =
        Io/scope((s) =>
            let messages = Channel/new(@{Nat, Latch}, 1)!;
            let other = Channel/new(@Nat, 1)!;
            let select_one() -> Io({}) =>
                Io/select([
                    Io/bind(Channel/take(messages), (_) => Io/pure(())),
                    Io/bind(Channel/take(other), (_) => Io/pure(()))]);
            let selecting = Io/Scope/spawn(s, select_one())!;
            let () = Io/yield()!;
            let _ = Channel/push(other, 1)!;
            let () = Io/Scope/Task/join(selecting)!;
            let ack = Latch/new()!;
            let _ = Channel/push(messages, (7, ack))!;
            let () = Io/yield()!;
            let acknowledged = Latch/tripped(ack)!;
            let got = Channel/take(messages)!;
            Io/pure((acknowledged, Option/map(got, (message: {Nat, Latch}) => message.0))))!;
    Test/all([
        Test/assert("the message the losing take left is not acknowledged", Bool/not(acknowledged)),
        Test/equal(n, Option/some(7))]);

-- Notifications a capacity-one channel has not been read for coalesce into one, and a future keeps the first answer it was filled with.
test notifications_coalesce_and_futures_preserve_their_first_answer =>
    let s = Channel/new(@{}, 1)!;
    let _ = Channel/try_push(s, ())!;
    let _ = Channel/try_push(s, ())!;
    let _ = Channel/take(s)!;
    let again = Channel/try_take(s)!;
    let coalesced = match again | empty() => true | _ => false end;
    let f = Future/new(@Nat)!;
    let () = Future/fill(f, 7)!;
    let () = Future/fill(f, 99)!;
    let answer = Future/wait(f)!;
    Test/all([
        Test/assert("the two notifications coalesced into one", coalesced),
        Test/equal(answer, 7)]);

-- A branch waiting on a future is cancelled where it waits once another branch wins, and its bracket is released then, once: the future filled afterwards wakes nothing.
test a_waiter_cancelled_on_a_future_is_released_once =>
    let releases = Channel/new(@Nat, 2)!;
    let c = Future/new(@{})!;
    let release(_: Io/Scope/Ended) -> Io({}) =>
        let _ = Channel/try_push(releases, 1)!;
        Io/pure(());
    let waiting =
        Io/scope((scope) => Io/bind(Io/Scope/defer(scope, release), (()) => Future/wait(c)));
    let () = Io/select([waiting, Io/pure(())])!;
    let () = Future/fill(c, ())!;
    let () = Future/wait(c)!;
    let first = Channel/try_take(releases)!;
    let second = Channel/try_take(releases)!;
    Test/equal([found(first), found(second)], [Option/some(1), Option/none()]);
