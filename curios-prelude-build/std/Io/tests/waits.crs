-- Waiting in `Io`: what a wait holds of the branch beside it, what a scope tells its releases, and what a fulfilment, a send, a selection, a signal and a cancellation wake.
use /std/{Bool, Cell, Io, Nat, Option, Test, Channel};
use /std/Io/{Future, Offer, Signal};
use /std/time/{Duration};

-- A finalizer that leaves how its body ended where a take finds it.
let told(c: Channel(Io/Ended), ended: Io/Ended) -> Io({}) =
    let _ = Channel/try_send(c, ended)!;
    Io/pure(());

-- Whether the next take is `finished`, where `finished` says so, or `cancelled` otherwise.
let heard(c: Channel(Io/Ended), finished: Bool) -> Io(Bool) =
    let taken = Channel/try_receive(c)!;
    Io/pure(
        match taken
        | item(ended) =>
            match ended
            | finished() => finished
            | cancelled() => Bool/not(finished)
            end
        | _ => false
        end);

test a_yield_at_the_top_of_a_program_goes_on =
    let () = Io/yield()!;
    Test/assert("the program goes on past the yield", true);

test a_sleep_holds_only_its_own_branch =
    let n = Io/race([Io/bind(Io/sleep(Duration/of_secs(3600)), (()) => Io/pure(1)), Io/pure(2)])!;
    Test/assert("the branch that does not sleep wins", n == 2);

test a_wait_on_a_cell_goes_on_once_the_branch_beside_it_fills_it =
    let cell = Cell/new()!;
    let (waited, filled) =
        Io/both(Io/bind(Io/wait_filled([cell]), (()) => Io/pure(true)), Cell/fill(cell, ()))!;
    Test/assert("the wait goes on once the cell is filled", waited && filled);

test a_scope_tells_its_release_a_body_ran_to_its_end =
    let endings = Channel/new(@Io/Ended, 1)!;
    let n =
        Io/scope((scope) =>
            Io/bind(Io/Scope/defer(scope, (ended) => told(endings, ended)), (()) => Io/pure(3)))!;
    let finished = heard(endings, true)!;
    Test/assert("the body ran to its end and its release was told so", n == 3 && finished);

test a_scope_tells_its_release_a_body_was_dropped_while_it_waited =
    let endings = Channel/new(@Io/Ended, 1)!;
    let never = Cell/new()!;
    let body =
        Io/scope((scope) =>
            Io/bind(
                Io/Scope/defer(scope, (ended) => told(endings, ended)),
                (()) => Io/bind(Io/wait_filled([never]), (()) => Io/pure(3))));
    let _ = Io/race([body, Io/pure(4)])!;
    let cancelled = heard(endings, false)!;
    Test/assert("the release was told the body was dropped", cancelled);

-- The value a take found, where it found one.
let found(@A: Type, taken: Channel/Take(A)) -> Option(A) =
    match taken | item(a) => Option/some(a) | _ => Option/none() end;

-- One fulfilment wakes a waiter once, however many of its offers wait on the same future.
test a_fulfilment_wakes_a_waiter_once_across_duplicate_offers =
    let wakes = Channel/new(@Nat, 2)!;
    let n =
        Io/Scope/run((s) =>
            let f = Future/new(@Nat)!;
            let waiter() -> Io(Nat) =
                let n = Io/select([Future/offer(f), Future/offer(f)])!;
                let _ = Channel/try_send(wakes, 1)!;
                Io/pure(n);
            let task = Io/Scope/spawn(s, waiter())!;
            let () = Io/yield()!;
            let () = Future/fill(f, 7)!;
            Io/Scope/Task/join(task))!;
    let first = Channel/try_receive(wakes)!;
    let second = Channel/try_receive(wakes)!;
    Test/all([
        Test/equal(n, 7),
        Test/equal([found(first), found(second)], [Option/some(1), Option/none()])]);

-- A send wakes every receiver waiting on the channel, and the one that does not take waits again: the second send reaches it.
test two_woken_receivers_retry_after_only_one_can_take =
    let (x, y) =
        Io/Scope/run((s) =>
            let c = Channel/new(@Nat, 1)!;
            let first = Cell/new(@{})!;
            let receive() -> Io(Nat) =
                let got = Channel/receive(c)!;
                let _ = Cell/fill(first, ())!;
                Io/pure(Option/unwrap_or(got, 0));
            let a = Io/Scope/spawn(s, receive())!;
            let b = Io/Scope/spawn(s, receive())!;
            let () = Io/yield()!;
            let _ = Channel/send(c, 1)!;
            let () = Io/wait_filled([first])!;
            let _ = Channel/send(c, 2)!;
            let x = Io/Scope/Task/join(a)!;
            let y = Io/Scope/Task/join(b)!;
            Io/pure((x, y)))!;
    Test/equal([x, y], [1, 2]);

-- An offer that loses a selection has taken nothing and waits on nothing after it: a message sent once the selection has answered stays in its channel, unacknowledged, for the next receive.
test a_losing_offer_neither_takes_a_later_message_nor_acknowledges_it =
    let (acknowledged, n) =
        Io/Scope/run((s) =>
            let messages = Channel/new(@{Nat, Cell({})}, 1)!;
            let other = Channel/new(@Nat, 1)!;
            let select_one() -> Io({}) =
                Io/select([
                    Offer/map(Channel/offer_receive(messages), (_) => ()),
                    Offer/map(Channel/offer_receive(other), (_) => ())]);
            let selecting = Io/Scope/spawn(s, select_one())!;
            let () = Io/yield()!;
            let _ = Channel/send(other, 1)!;
            let () = Io/Scope/Task/join(selecting)!;
            let ack = Cell/new(@{})!;
            let _ = Channel/send(messages, (7, ack))!;
            let () = Io/yield()!;
            let polled = Cell/poll(ack)!;
            let got = Channel/receive(messages)!;
            let acknowledged = match polled | none() => false | some(()) => true end;
            Io/pure((acknowledged, Option/map(got, (message: {Nat, Cell({})}) => message.0))))!;
    Test/all([
        Test/assert(
            "the message the losing offer left is not acknowledged",
            Bool/not(acknowledged)),
        Test/equal(n, Option/some(7))]);

-- What a signal's offer finds without waiting.
let tried(s: Signal) -> Io(Option({})) =
    Signal/offer(s).try;

-- Notifications a signal has not been waited on for coalesce into one, and a future keeps the first answer it was filled with.
test signals_coalesce_and_futures_preserve_their_first_answer =
    let s = Signal/new()!;
    let () = Signal/notify(s)!;
    let () = Signal/notify(s)!;
    let () = Signal/wait(s)!;
    let again = tried(s)!;
    let coalesced = match again | none() => true | some(()) => false end;
    let f = Future/new(@Nat)!;
    let () = Future/fill(f, 7)!;
    let () = Future/fill(f, 99)!;
    let answer = Future/wait(f)!;
    Test/all([
        Test/assert("the two notifications coalesced into one", coalesced),
        Test/equal(answer, 7)]);

-- A branch waiting on a cell is cancelled where it waits once another branch wins, and its bracket is released then, once: the cell filled afterwards wakes nothing.
test a_waiter_cancelled_on_a_cell_is_released_once =
    let releases = Channel/new(@Nat, 2)!;
    let c = Cell/new(@{})!;
    let release(_: Io/Ended) -> Io({}) =
        let _ = Channel/try_send(releases, 1)!;
        Io/pure(());
    let waiting =
        Io/Scope/run((scope) =>
            Io/bind(Io/Scope/defer(scope, release), (()) => Io/wait_filled([c])));
    let () = Io/race([waiting, Io/pure(())])!;
    let _ = Cell/fill(c, ())!;
    let () = Io/wait_filled([c])!;
    let first = Channel/try_receive(releases)!;
    let second = Channel/try_receive(releases)!;
    Test/equal([found(first), found(second)], [Option/some(1), Option/none()]);
