-- `/std/Io/Latch`: a latch is untripped until it is tripped, and stays tripped.
use /std/{Bool, Io, Test};
use /std/Io/{Latch};

-- A latch answers untripped until it is tripped.
test a_latch_is_untripped_until_it_is_tripped =>
    let latch = Latch/new()!;
    let before = Latch/tripped(latch)!;
    let () = Latch/trip(latch)!;
    let after = Latch/tripped(latch)!;
    Test/all([
        Test/assert("a new latch is untripped", Bool/not(before)),
        Test/assert("a tripped latch is tripped", after)]);

-- A latch tripped again stays tripped.
test a_latch_tripped_again_stays_tripped =>
    let latch = Latch/new()!;
    let () = Latch/trip(latch)!;
    let () = Latch/trip(latch)!;
    let tripped = Latch/tripped(latch)!;
    Test/assert("a second trip changes nothing", tripped);

-- Tripping one latch leaves another untripped.
test tripping_one_latch_leaves_another_untripped =>
    let a = Latch/new()!;
    let b = Latch/new()!;
    let () = Latch/trip(a)!;
    let other = Latch/tripped(b)!;
    Test/assert("the other latch is untripped", Bool/not(other));

-- A wait on a latch nothing has tripped does not go on: beside a branch that only yields, the yielding branch answers first.
test a_wait_does_not_go_on_before_the_latch_is_tripped =>
    let latch = Latch/new()!;
    let first =
        Io/select([
            Io/bind(Latch/wait(latch), (()) => Io/pure(1)),
            Io/bind(Io/yield(), (()) => Io/pure(2))])!;
    Test/equal(first, 2);

-- A wait on a latch goes on once another branch trips it, and at once where it is tripped already.
test a_wait_goes_on_once_the_latch_is_tripped =>
    let latch = Latch/new()!;
    let ((), ()) = Io/both(Latch/wait(latch), Latch/trip(latch))!;
    let () = Latch/wait(latch)!;
    let tripped = Latch/tripped(latch)!;
    Test/assert("the wait went on with the latch tripped", tripped);
