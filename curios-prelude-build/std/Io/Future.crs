use /std/{Option, Box, Io};
use /std/Io/{Latch};
use /std/internal/{on_tripped, until};

--- A value filled once and read as often as asked: the value in a box, empty until the filling, beside the latch the filling trips for whatever waits on it.
pub struct Future(A: Type): Type {
    value: Box(Option(A)),
    filled: Latch,
}

--- A future nothing has filled yet.
pub let new(@A: Type) -> Io(Future(A)) =
    let value = Box/new(@Option(A), Option/none())!;
    let filled = Latch/new()!;
    Io/pure(Future { value = value, filled = filled });

--- The value, once there is one.
pub let poll(@A: Type, f: Future(A)) -> Io(Option(A)) =
    Box/held(f.value);

--- Fill `f` with `a`, and wake whatever waits on it. A second filling is dropped, so the first value stands.
pub let fill(@A: Type, f: Future(A), a: A) -> Io({}) =
    let first =
        Box/change(f.value, (held: Option(A)) =>
            match held
            | some(_) => (held, false)
            | none() => (Option/some(a), true)
            end)!;
    match first | true => Latch/trip(f.filled) | false => Io/pure(()) end;

--- The value, waiting until there is one.
pub let wait(@A: Type, f: Future(A)) -> Io(A) =
    until(poll(f), Io/pure(on_tripped([f.filled])));
