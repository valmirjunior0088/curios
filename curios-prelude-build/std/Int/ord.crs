use /std/{Int, Bool, Eq, Ordering, Ord};
use /std/Bool/{True, False, Holds};

--- The order of the two.
pub let ord(x: Int, y: Int) -> Ordering =
    match
    | Int/lt(x, y) => Ordering/lt()
    | x == y => Ordering/eq()
    | _ => Ordering/gt()
    end;

-- By the two decisions `ord` reads, each by name, as every law `Ord`'s witness at `Int` names is: `a < b` would read that witness back.
--- `ord(a, b)` is `eq` only where `a` is `b`: the order agrees with equality.
let eq(a: Int, b: Int, h: Eq()(ord(a, b), Ordering/eq())) -> Eq()(a, b) =
    match Int/lt(a, b)
    | true => match h end
    | false =>
        match Int/eql(a, b)
        | true => Int/eq_of_eql(a, b, True/qed())
        | false => match h end
        end
    end;

-- No two integers are each below the other: `a < b` is `a + 1 <= b`, and the two bounds in a row put `a + 1` at most `a - 1`.
let apart(a: Int, b: Int, p: Holds(Int/lt(a, b)), q: Holds(Int/lt(b, a))) -> False =
    Int/le/trans(@a + 1, @b, @a - 1, p, q);

-- Two integers neither of which is below the other are one: a comparison that failed is the dual one holding.
let level(
    a: Int,
    b: Int,
    p: Holds(Bool/not(Int/lt(a, b))),
    q: Holds(Bool/not(Int/lt(b, a))),
) -> Eq()(a, b) =
    Int/le/antisym(a, b, q, p);

-- By the decisions `ord` reads on each side. Where both sides are decided alike the answers are read off; the arms no two integers reach are closed by [`apart`], by [`level`], and by an equation carried into the decision that failed.
--- `ord` answers the flipped answer with its operands swapped.
let flips: Ord/Flips(ord) =
    (a, b) =>
        match Int/lt(a, b)
        | true =>
            match Int/lt(b, a)
            | true => match apart(a, b, True/qed(), True/qed()) end
            | false =>
                match Int/eql(b, a)
                | true =>
                    let same = Int/eq_of_eql(b, a, True/qed());
                    match Eq/subst((x: Int) => Holds(Int/lt(x, b)), Eq/sym(same), True/qed())
                    end
                | false => Eq/refl()
                end
            end
        | false =>
            match Int/eql(a, b)
            | true =>
                let refl() = Int/eq_of_eql(a, b, True/qed());
                Eq/refl()
            | false =>
                match Int/lt(b, a)
                | true => Eq/refl()
                | false =>
                    let same = level(a, b, True/qed(), True/qed());
                    match Eq/subst(
                        (x: Int) => Holds(Bool/not(Int/eql(a, x))),
                        Eq/sym(same),
                        True/qed())
                    end
                end
            end
        end;

--- `a < b` is `ord` answering `lt`.
let is_lt(a: Int, b: Int) -> Eq()(Int/lt(a, b), Ordering/is_lt(ord(a, b))) =
    match Int/lt(a, b)
    | true => Eq/refl()
    | false => match Int/eql(a, b) | true | false => Eq/refl() end
    end;

--- `a <= b` is `ord` answering `lt` or `eq`.
let is_le(a: Int, b: Int) -> Eq()(Int/le(a, b), Ordering/is_le(ord(a, b))) =
    match Int/lt(a, b)
    | true =>
        match Int/le(a, b)
        | true => Eq/refl()
        | false => match apart(a, b, True/qed(), True/qed()) end
        end
    | false =>
        match Int/eql(a, b)
        | true =>
            let refl() = Int/eq_of_eql(a, b, True/qed());
            Eq/refl()
        | false =>
            match Int/le(a, b)
            | true =>
                let same = level(a, b, True/qed(), True/qed());
                match Eq/subst((x: Int) => Holds(Bool/not(Int/eql(a, x))), Eq/sym(same), True/qed())
                end
            | false => Eq/refl()
            end
        end
    end;

-- `Int/le/trans`, each bound read through [`is_le`].
--- `ord` as a relation carries across a middle element.
let trans: Ord/Trans(Ord/le_by(ord)) =
    (a, b, c, p, q) =>
        let below: Holds(Int/le(a, b)) = Eq/subst((x: Bool) => Holds(x), Eq/sym(is_le(a, b)), p);
        let above: Holds(Int/le(b, c)) = Eq/subst((x: Bool) => Holds(x), Eq/sym(is_le(b, c)), q);
        Eq/subst((x: Bool) => Holds(x), is_le(a, c), Int/le/trans(below, above));

satisfy Ord(Int) {
    ord = ord,
    lt = Int/lt,
    le = Int/le,
    flips = flips,
    trans = trans,
    eq = eq,
    is_lt = is_lt,
    is_le = is_le,
}
