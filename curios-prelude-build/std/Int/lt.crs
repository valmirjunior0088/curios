pub use /sys/Int/{lt};

use /std/{Int, Bool, Eq};
use /std/Bool/{True, Holds};

--- `a < b` gives `n + a < n + b`: a dividend is below its quotient's multiple raised by its divisor's magnitude, as the elaborator's proofs read an `Int` quotient's bound from above.
pub let add_mono_l(n: Int, @a: Int, @b: Int, p: Holds(a < b)) -> Holds(n + a < n + b) =>
    p;

--- A bound whose two sides differ is strict: `a <= b` and `a == b` failing give `a < b`.
---
--- The case of a disequality its loose bound holds in.
pub let of_le_ne(a: Int, b: Int, p: Holds(a <= b), q: Holds(Bool/not(a == b))) -> Holds(a < b) =>
    match a < b
    | true => True/qed()
    | false =>
        let back: Holds(b <= a) = True/qed();
        let same: Eq()(a, b) = Int/le/antisym(a, b, p, back);
        let absurd: Holds(Bool/not(a == a)) =
            Eq/subst((x: Int) => Holds(Bool/not(a == x)), Eq/sym(same), q);
        match absurd end
    end;
