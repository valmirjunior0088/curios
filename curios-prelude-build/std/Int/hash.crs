use /std/{Nat, Int, Byte, Bytes, Eq, Ordering, proved};
use /std/ops/{Ord};
use /std/Bool/{True, Holds};

-- A run with every byte complemented, a byte at a time so that conversion carries it across a cons.
let flipped(b: Bytes) -> Bytes =
    match b
    | 0x[] => 0x[]
    | 0x[h, ..t] => 0x[Byte/not(h), ..flipped(t)]
    end;

-- A complement reverses two runs that part at a byte.
let reversed(
    a: Bytes,
    b: Bytes,
    parted: Holds(Bytes/ord/below(a, b)),
) -> Holds(Bytes/ord/below(flipped(b), flipped(a))) =
    match a
    | 0x[] => match parted end
    | 0x[h, ..t] =>
        match b
        | 0x[] => match parted end
        | 0x[k, ..r] =>
            let (hn, kn) = (Byte/to_nat(h), Byte/to_nat(k));
            match Nat/ord(hn, kn)
            | gt() => match parted end
            | lt() =>
                let under: Holds(hn < kn) = Ord/below(hn, kn, Eq/refl());
                Bytes/ord/below/of_heads(Byte/not(k), Byte/not(h), flipped(r), flipped(t), proved())
            | eq() =>
                let same: Eq()(hn, kn) = Ord/eq(hn, kn, Eq/refl());
                Eq/subst(
                    (o: Ordering) =>
                        Holds(
                            match o
                            | eq() => Bytes/ord/below(flipped(r), flipped(t))
                            | lt() => true
                            | gt() => false
                            end),
                    Eq/sym(
                        Ord/of_eq(255 - kn, 255 - hn, Eq/cong((v: Nat) => 255 - v, Eq/sym(same)))),
                    reversed(t, r, parted))
            end
        end
    end;

-- Of two runs that lead with a byte in the upper half, the complement of one is below the other.
let halves(
    a: Bytes,
    b: Bytes,
    upper_a: Holds(Bytes/ord/below(0x[0x7F], a)),
    upper_b: Holds(Bytes/ord/below(0x[0x7F], b)),
) -> Holds(Bytes/ord/below(flipped(a), b)) =
    match a
    | 0x[] => match upper_a end
    | 0x[h, ..t] =>
        match b
        | 0x[] => match upper_b end
        | 0x[k, ..r] =>
            let (hn, kn) = (Byte/to_nat(h), Byte/to_nat(k));
            match Nat/ord(127, hn)
            | lt() =>
                let over_h: Holds(127 < hn) = Ord/below(127, hn, Eq/refl());
                match Nat/ord(127, kn)
                | lt() =>
                    let over_k: Holds(127 < kn) = Ord/below(127, kn, Eq/refl());
                    Bytes/ord/below/of_heads(Byte/not(h), k, flipped(t), r, proved())
                | eq() | gt() => match upper_b end
                end
            | eq() | gt() => match upper_a end
            end
        end
    end;

--- An integer's encoding, in the order of the numbers: a smaller integer's is before a larger one's as `Bytes/ord` reads them, and no integer's begins another's.
---
--- At or above zero it is its natural's, [`Nat/hash`]; below zero it is the complement, byte by byte, of the encoding of `-1 - i`. No byte is spent on the sign: a natural's encoding leads with a byte in the upper half and a complement's with one in the lower, so every integer below zero is before every other, and the more negative of two comes first.
pub let hash(i: Int) -> Bytes =
    match i >= +0
    | true => Nat/hash(Int/abs(i))
    | false => flipped(Nat/hash(Int/abs(i) - 1))
    end;

--- `a < b` gives `a`'s encoding below `b`'s at a byte: by the naturals' law where both are at or above zero, by that law reversed where both are below, and by the half each leads in where zero is between them.
pub let of_lt(a: Int, b: Int, under: Holds(a < b)) -> Holds(Bytes/ord/below(hash(a), hash(b))) =
    match a >= +0
    | true =>
        match b >= +0
        | true => Nat/hash/of_lt(Int/abs(a), Int/abs(b), proved())
        end
    | false =>
        match b >= +0
        | true =>
            halves(
                Nat/hash(Int/abs(a) - 1),
                Nat/hash(Int/abs(b)),
                Nat/hash/leads(Int/abs(a) - 1),
                Nat/hash/leads(Int/abs(b)))
        | false =>
            reversed(
                Nat/hash(Int/abs(b) - 1),
                Nat/hash(Int/abs(a) - 1),
                Nat/hash/of_lt(Int/abs(b) - 1, Int/abs(a) - 1, proved()))
        end
    end;

--- The order of two integers is the order of their encodings.
pub let mono(a: Int, b: Int) -> Eq()(Int/ord(a, b), Bytes/ord(hash(a), hash(b))) =
    match
    | a < b => Eq/sym(Bytes/ord/below/lt(hash(a), hash(b), of_lt(a, b, True/qed())))
    | b < a =>
        Eq/trans(
            Ord/of_gt(a, b, True/qed()),
            Eq/sym(
                Eq/trans(
                    Ord/flips(hash(b), hash(a)),
                    Eq/cong(
                        Ordering/flip,
                        Bytes/ord/below/lt(hash(b), hash(a), of_lt(b, a, True/qed()))))))
    | _ =>
        Eq/subst(
            (y: Int) => Eq()(Int/ord(a, y), Bytes/ord(hash(a), hash(y))),
            Int/le/antisym(a, b, proved(), proved()),
            Eq/sym(Ord/refl(hash(a))))
    end;
