use /std/{Str, Nat, Bool, List, Option, Io, Cli};
use /std/Cli/{Field, Kind, Presence, Positional, Positionals, Command};
use /std/Bool/{True, False, Holds};

--- What a parse fills and `get` reads by name.
pub struct Slot: pub Type {
    --- An option's long name, or a positional's name.
    name: Str,
    --- The type it is read into.
    T: Type,
}

--- The type a value read as `A` is held at under `presence`: an `Option` where it may be absent, and `A` itself where it is required or has a default.
pub let Presented(A: Type, presence: Presence(A)) -> Type =
    match presence
    | required() => A
    | optional() => Option(A)
    | default(_) => A
    end;

--- The type an option is read into: `Bool` for a flag and a toggle, `Nat` for a count, the reader's type for an option that is required or has a default, an `Option` for one that may be absent, and a list for `many`.
pub let Carrier(k: Kind) -> Type =
    match k
    | flag() => Bool
    | count() => Nat
    | toggle(_) => Bool
    | option(v, presence) => Presented(v.A, presence)
    | many(v) => List(v.A)
    | choice(A, _, presence) => Presented(A, presence)
    end;

--- What a group's parse holds: its options, in order.
pub let option_slots(fields: List(Field)) -> List(Slot) =
    List/map(fields, (f) => Slot { name = f.long, T = Carrier(f.kind) });

pub let required_slots(ps: List(Positional)) -> List(Slot) =
    List/map(ps, (p) => Slot { name = p.name, T = p.v.A });

pub let optional_slots(ps: List(Positional)) -> List(Slot) =
    List/map(ps, (p) => Slot { name = p.name, T = Option(p.v.A) });

pub let rest_slots(p: Option(Positional)) -> List(Slot) =
    match p
    | none() => []
    | some(r) => [Slot { name = r.name, T = List(r.v.A) }]
    end;

--- What a leaf's parse holds, in order: every option, then every positional.
pub let slots(options: List(Field), positionals: Positionals) -> List(Slot) =
    [
        ..option_slots(options),
        ..required_slots(positionals.required),
        ..optional_slots(positionals.optional),
        ..rest_slots(positionals.rest)];

--- What a command's parse holds by name: a leaf's options and positionals, and a group's options.
pub let Slots(c: Command) -> List(Slot) =
    match c
    | leaf(_, _, options, ps) => slots(options, ps)
    | group(_, _, options, _) => option_slots(options)
    end;

--- A value for each slot, in order.
pub induct Values: (List(Slot)) -> pub Type
--- No slot is left.
| nil(): ([])
--- One slot's value, then the rest.
| cons(@s: Slot, @rest: List(Slot), head: s.T, tail: Values(rest)): ([s, ..rest])
end

pub let appended(@a: List(Slot), @b: List(Slot), x: Values(a), y: Values(b)) -> Values([..a, ..b]) =
    match x
    | nil() => y
    | cons(head, tail) => Values/cons(head, appended(tail, y))
    end;

--- What a line parsed into against a command: a leaf's values, or a group's values and the parse of the command the line chose.
pub induct Parsed: (Command) -> pub Type
--- A leaf's values.
| leaf(
    @name: Str,
    @about: Str,
    @options: List(Field),
    @positionals: Positionals,
    values: Values(slots(options, positionals))): (Command/leaf(name, about, options, positionals))
--- A group's values, and the command the line chose among its commands.
| group(
    @name: Str,
    @about: Str,
    @options: List(Field),
    @commands: List(Command),
    values: Values(option_slots(options)),
    chosen: Chosen(commands)): (Command/group(name, about, options, commands))
--- Which of a group's commands a line chose, and what it parsed into against it.
pub and Chosen: (List(Command)) -> pub Type
--- The first of the commands, and its parse.
| here(@c: Command, @rest: List(Command), parsed: Parsed(c)): ([c, ..rest])
--- One of the commands after the first.
| there(@c: Command, @rest: List(Command), chosen: Chosen(rest)): ([c, ..rest])
end

pub use Parsed/*;

let values(@c: Command, p: Parsed(c)) -> Values(Slots(c)) =
    match p | leaf(v) | group(v, _) => v end;

--- The type `get` answers for `name` among `spec`.
pub let Lookup(spec: List(Slot), name: Str) -> Type =
    match spec
    | [] => {}
    | [s, ..rest] =>
        match s.name == name | true => s.T | false => Lookup(rest, name) end
    end;

--- That no option or positional, or no command, is named `name`: what a read of a name the declaration lacks reduces to, with the name there nearest to it, as the line's own refusal names one, and the names there are. Nothing proves it, so the read is refused where it is written.
pub induct Unknown: (name: Str, nearest: Option(Str), names: List(Str)) -> pub Prop
end

-- What a search that found no `name` among `names` reduces to.
let missing(name: Str, names: List(Str)) -> Prop =
    Unknown(name, Cli/scan/closest(name, names), names);

--- That `name` is one of `spec`'s, decided by reduction: a name the declaration lacks reduces to `Unknown` of it, refused where it is written.
pub let Has(spec: List(Slot), name: Str) -> Prop =
    match List/any(spec, (s) => s.name == name)
    | true => True
    | false => missing(name, List/map(spec, (s) => s.name))
    end;

-- The search a read hands down the list, which a known name holds.
let Present(spec: List(Slot), name: Str) -> Prop =
    Holds(List/any(spec, (s) => s.name == name));

let present(@spec: List(Slot), name: Str, @ok: Has(spec, name)) -> Present(spec, name) =
    match List/any(spec, (s) => s.name == name)
    | true => True/qed()
    | false => match ok end
    end;

let read(
    @spec: List(Slot),
    v: Values(spec),
    name: Str,
    @ok: Present(spec, name),
) -> Lookup(spec, name) =
    match v
    | nil() => match ok end
    | cons(@s, @rest, head, tail) =>
        match s.name == name
        | true => head
        | false => read(@rest, tail, name, @ok)
        end
    end;

--- The option or positional named `name` of the command `p` was parsed against, at the type its declaration decides.
pub let get(
    @c: Command,
    p: Parsed(c),
    name: Str,
    @ok: Has(Slots(c), name),
) -> Lookup(Slots(c), name) =
    read(values(p), name, @present(name, @ok));

--- That `name` is one of `commands`', decided by reduction: a name the group lacks reduces to `Unknown` of it.
pub let HasIn(commands: List(Command), name: Str) -> Prop =
    match List/any(commands, (c) => /std/Cli/name(c) == name)
    | true => True
    | false => missing(name, List/map(commands, /std/Cli/name))
    end;

-- The search a pick hands down the list, which a known name holds.
let PresentIn(commands: List(Command), name: Str) -> Prop =
    Holds(List/any(commands, (c) => /std/Cli/name(c) == name));

let present_in(
    @commands: List(Command),
    name: Str,
    @ok: HasIn(commands, name),
) -> PresentIn(commands, name) =
    match List/any(commands, (c) => /std/Cli/name(c) == name)
    | true => True/qed()
    | false => match ok end
    end;

--- The first of `commands` named `name`.
pub let NamedIn(commands: List(Command), name: Str) -> Command =
    match commands
    | [] => Command/leaf(name, "", [], Cli/positionals([]))
    | [c, ..rest] =>
        match /std/Cli/name(c) == name
        | true => c
        | false => NamedIn(rest, name)
        end
    end;

--- That `c` is a group with a command named `name`.
pub let HasCommand(c: Command, name: Str) -> Prop =
    match c
    | leaf(_, _, _, _) => False
    | group(_, _, _, commands) => HasIn(commands, name)
    end;

--- The command of `c` named `name`.
pub let Named(c: Command, name: Str) -> Command =
    match c
    | leaf(_, _, _, _) => c
    | group(_, _, _, commands) => NamedIn(commands, name)
    end;

let pick(
    @commands: List(Command),
    chosen: Chosen(commands),
    name: Str,
    @ok: PresentIn(commands, name),
) -> Option(Parsed(NamedIn(commands, name))) =
    match chosen
    | here(@c, @_, parsed) =>
        match /std/Cli/name(c) == name
        | true => Option/some(parsed)
        | false => Option/none()
        end
    | there(@c, @_, more) =>
        match /std/Cli/name(c) == name
        | true => Option/none()
        | false => pick(more, name, @ok)
        end
    end;

-- The parse of the command `name` of the group `p` was parsed against, where the line chose it, and `none` where it chose another: what a handler is run on.
let command(
    @c: Command,
    p: Parsed(c),
    name: Str,
    @ok: HasCommand(c, name),
) -> Option(Parsed(Named(c, name))) =
    match p
    | leaf(_) => match ok end
    | group(_, chosen) => pick(chosen, name, @present_in(name, @ok))
    end;

--- What runs where the line chose the command of the group `c` named `name`: `run`, handed that command's parse.
pub struct Handler(c: Command): pub Type {
    name: Str,
    @known: HasCommand(c, name),
    run: (Parsed(Named(c, name))) -> Io({}),
}

--- The handler of the command of `c` named `name`: `run`, handed that command's parse where the line chose it. A name the group lacks is refused where it is written, as `get` refuses one.
pub let on(
    @c: Command,
    name: Str,
    @known: HasCommand(c, name),
    run: (Parsed(Named(c, name))) -> Io({}),
) -> Handler(c) =
    Handler { name = name, @known = known, run = run };

--- That no command of `names` is left unhandled: what a dispatch that leaves some out reduces to, those names in the group's order. Nothing proves it, so the dispatch is refused where it is written.
pub induct Uncovered: (names: List(Str)) -> pub Prop
end

-- The names of `c`'s commands, in the order the group lists them.
let commands_of(c: Command) -> List(Str) =
    match c
    | leaf(_, _, _, _) => []
    | group(_, _, _, commands) => List/map(commands, /std/Cli/name)
    end;

--- That `handled` names every command of the group `c`, decided by reduction: a list that leaves some out reduces to `Uncovered` of them.
pub let Covered(c: Command, handled: List(Str)) -> Prop =
    match List/filter(commands_of(c), (n) => Bool/not(List/contains(handled, n)))
    | [] => True
    | [n, ..more] => Uncovered([n, ..more])
    end;

-- The first of `handlers` whose command the line chose, run on that command's parse; a list that covers every command leaves none of the line's unrun.
let run_chosen(@c: Command, p: Parsed(c), handlers: List(Handler(c))) -> Io({}) =
    match handlers
    | [] => Io/pure(())
    | [h, ..more] =>
        match command(p, h.name, @h.known)
        | some(parsed) => h.run(parsed)
        | none() => run_chosen(p, more)
        end
    end;

--- The handler of the command the line chose among the group `p` was parsed against, run on that command's parse. Every command of the group needs one: a list that leaves some out is refused where it is written, naming them, as an `on` naming no command is.
pub let dispatch(
    @c: Command,
    p: Parsed(c),
    handlers: List(Handler(c)),
    @_: Covered(c, List/map(handlers, (h) => h.name)),
) -> Io({}) =
    run_chosen(p, handlers);
