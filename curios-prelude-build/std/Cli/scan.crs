use /std/{Str, Byte, Bytes, Nat, Bool, Char, List, Option, Map};
use /std/Cli/{Failure, Field};

--- What one occurrence of an option on the line was.
pub induct Seen: pub Type
--- A name given alone.
| given()
--- A switch's `--no-` name.
| negated()
--- A name given with this value, as the bytes the line holds.
| value(bytes: Bytes)
--- The alternative of a choice at this index.
| picked(index: Nat)
end

-- How a name on the line reads: a built-in, or one of the options at its index.
induct Claim: Type
| help()
| version()
| switch(field: Nat)
| negation(field: Nat)
| valued(field: Nat)
| alternative(field: Nat, index: Nat)
end

--- What a scan of a command's tokens found: each option's occurrences by its index, newest first, the positionals in order, what a group hands its command, and what was asked or refused.
pub struct Raw: pub Type {
    seen: Map(Nat, List(Seen)),
    positionals: List(Bytes),
    rest: List(Bytes),
    help: Bool,
    version: Bool,
    failure: Option(Failure),
}

-- Every name the option `f` at `i` answers to, with how each reads.
let claims_of(f: Field, i: Nat) -> List({Str, Claim}) =>
    let names = [f.long, ..f.aliases];
    let short =
        match f.short
        | none() => []
        | some(c) => [Str/concat("-", Str/of_char(c))]
        end;
    let as(spelled: List(Str), claim: Claim) -> List({Str, Claim}) =>
        List/map(spelled, (s) => (s, claim));
    match f.kind
    | flag() | count() =>
        as([..List/map(names, (n) => Str/concat("--", n)), ..short], Claim/switch(i))
    | toggle(_) =>
        [
            ..as([..List/map(names, (n) => Str/concat("--", n)), ..short], Claim/switch(i)),
            ..as(List/map(names, (n) => Str/concat("--no-", n)), Claim/negation(i))]
    | option(_, _) | many(_) =>
        as([..List/map(names, (n) => Str/concat("--", n)), ..short], Claim/valued(i))
    | choice(_, alternatives, _) =>
        List/map(
            List/zip(List/range(0, List/length(alternatives)), alternatives),
            (entry) => (Str/concat("--", entry.1.long), Claim/alternative(i, entry.0)))
    end;

let claims(fields: List(Field), version: Option(Str)) -> Map(Str, Claim) =>
    Map/of_list([
        ("--help", Claim/help()),
        ("-h", Claim/help()),
        ..match version
        | none() => []
        | some(_) => [("--version", Claim/version())]
        end,
        ..List/concat_map(
            List/zip(List/range(0, List/length(fields)), fields),
            (entry) => claims_of(entry.1, entry.0))]);

-- `s` recorded against the option at `i`.
let seen(raw: Raw, i: Nat, s: Seen) -> Raw =>
    Raw {
        ..raw,
        seen = Map/update(raw.seen, i, (old) => Option/some([s, ..Option/unwrap_or(old, [])])) };

-- The line refused by `failure`, unless it already was: the first refusal is the one reported, and help asked later still answers.
let refuse(raw: Raw, failure: Failure) -> Raw =>
    Raw {
        ..raw,
        failure =
            match raw.failure
            | some(_) => raw.failure
            | none() => Option/some(failure)
            end };

let flagged(raw: Raw, claim: Claim) -> Raw =>
    match claim
    | help() => Raw { ..raw, help = true }
    | version() => Raw { ..raw, version = true }
    | switch(i) => seen(raw, i, Seen/given())
    | negation(i) => seen(raw, i, Seen/negated())
    | alternative(i, k) => seen(raw, i, Seen/picked(k))
    | valued(_) => raw
    end;

-- A name read off the line with what it claims: a value-taking option takes the value glued to it, or the next token whatever it looks like.
let take(
    raw: Raw,
    claim: Claim,
    spelled: Str,
    attached: Option(Bytes),
    more: List(Bytes),
) -> {Raw, List(Bytes)} =>
    match claim
    | valued(i) =>
        match attached
        | some(value) => (seen(raw, i, Seen/value(value)), more)
        | none() =>
            match more
            | [] => (refuse(raw, Failure/missing_value(spelled)), [])
            | [value, ..rest] => (seen(raw, i, Seen/value(value)), rest)
            end
        end
    | _ =>
        match attached
        | some(_) => (refuse(raw, Failure/bad_value(spelled, "this flag takes no value")), more)
        | none() => (flagged(raw, claim), more)
        end
    end;

-- Whether `b` begins with the bytes `p`.
let leads(p: Bytes, b: Bytes) -> Bool =>
    let matched =
        Bytes/fold(
            p,
            (0, true),
            (x: Byte, at: {Nat, Bool}) =>
                (
                    at.0 + 1,
                    at.1
                        && match Bytes/try_get(b, at.0)
                        | some(y) => y == x
                        | none() => false
                        end));
    matched.1;

-- The bytes of `b` after its first `k`, or none where it holds no more.
let after(b: Bytes, k: Nat) -> Bytes =>
    match Bool/holds(k <= Bytes/length(b))
    | some(ok) => Bytes/drop(b, k, @ok)
    | none() => 0x[]
    end;

-- The short names `lookup` holds, `-c`, each by the bytes of its character beside its spelling and its claim.
let shorts(lookup: Map(Str, Claim)) -> List({Bytes, Str, Claim}) =>
    List/concat_map(
        Map/to_list(lookup),
        (entry: {Str, Claim}) =>
            match Str/strip_prefix(entry.0, "-")
            | some(c), Bool/not(Str/starts_with(c, "-")) => [(Str/to_bytes(c), entry.0, entry.1)]
            | _ => []
            end);

-- The short names glued in `body`, each read off its front by the bytes of its character: a switch read and the rest read on, and a name taking a value taking what follows it. A byte no name begins is refused as the token `whole` and stepped over, so a name after it, help's among them, is still read.
let cluster(
    names: List({Bytes, Str, Claim}),
    raw: Raw,
    body: Bytes,
    whole: Bytes,
    more: List(Bytes),
) -> {Raw, List(Bytes)} =>
    match Bytes/length(body) == 0
    | true => (raw, more)
    | false =>
        match List/find(names, (name: {Bytes, Str, Claim}) => leads(name.0, body))
        | none() =>
            cluster(
                names,
                refuse(raw, Failure/unknown_option(Str/of_bytes_lossy(whole), Option/none())),
                after(body, 1),
                whole,
                more)
        | some((character, spelled, claim)) =>
            let rest = after(body, Bytes/length(character));
            match claim
            | valued(_) =>
                let attached =
                    match Bytes/length(rest) == 0
                    | true => Option/none()
                    | false => Option/some(rest)
                    end;
                take(raw, claim, spelled, attached, more)
            | _ => cluster(names, flagged(raw, claim), rest, whole, more)
            end
        end
    end;

-- A token read as a value rather than a cluster: a dash and a digit, as a negative number is, which no short name can be.
let numeric(token: Bytes) -> Bool =>
    match (Bytes/try_get(token, 0), Bytes/try_get(token, 1))
    | (some(dash), some(digit)) => dash == '-' && Nat/in_range(Byte/to_nat(digit), 0x30, 0x39)
    | _ => false
    end;

let step(
    lookup: Map(Str, Claim),
    raw: Raw,
    literal: Bool,
    tokens: List(Bytes),
    group: Bool,
) -> Raw =>
    match tokens
    | [] => Raw { ..raw, positionals = List/reverse(raw.positionals) }
    | [token, ..more] =>
        let positional() -> Raw =>
            match group
            | true => Raw { ..raw, positionals = List/reverse(raw.positionals), rest = tokens }
            | false =>
                step(
                    lookup,
                    Raw { ..raw, positionals = [token, ..raw.positionals] },
                    literal,
                    more,
                    group)
            end;
        match
        | literal || token == 0x['-'] || numeric(token) => positional()
        | token == 0x['-', '-'] => step(lookup, raw, true, more, group)
        | leads(0x['-', '-'], token) =>
            let (name, attached) =
                match Bytes/split(after(token, 2), '=')
                | [n, v, ..vs] => (n, Option/some(Bytes/join(0x['='], [v, ..vs])))
                | [n] => (n, Option/none())
                | [] => (0x[], Option/none())
                end;
            let unknown(near: Option(Str)) -> Raw =>
                step(
                    lookup,
                    refuse(raw, Failure/unknown_option(Str/of_bytes_lossy(token), near)),
                    false,
                    more,
                    group);
            match Str/of_bytes(name)
            | failure(_) => unknown(Option/none())
            | success(text) =>
                let spelled = Str/concat("--", text);
                match Map/try_get(lookup, spelled)
                | none() =>
                    let known =
                        List/filter(
                            List/map(Map/to_list(lookup), (entry: {Str, Claim}) => entry.0),
                            (s) => Str/starts_with(s, "--"));
                    unknown(closest(spelled, known))
                | some(claim) =>
                    let (next, remaining) = take(raw, claim, spelled, attached, more);
                    step(lookup, next, false, remaining, group)
                end
            end
        | leads(0x['-'], token) =>
            let (next, remaining) = cluster(shorts(lookup), raw, after(token, 1), token, more);
            step(lookup, next, false, remaining, group)
        | _ => positional()
        end
    end;

--- `tokens` read against `fields` and the built-ins. A group stops at its first positional, the word that names its command, and hands it and what follows to the command.
pub let line(fields: List(Field), version: Option(Str), tokens: List(Bytes), group: Bool) -> Raw =>
    step(
        claims(fields, version),
        Raw {
            seen = Map/empty(),
            positionals = [],
            rest = [],
            help = false,
            version = false,
            failure = Option/none() },
        false,
        tokens,
        group);

-- How many single-character edits turn `a` into `b`: each row the distances of a longer prefix of `a` to every prefix of `b`.
let distance(a: Str, b: Str) -> Nat =>
    let bs = Str/to_list(b);
    let advance(prev: List(Nat), rest: List(Char), c: Char, left: Nat) -> List(Nat) =>
        match prev
        | [diagonal, ..above] =>
            match (above, rest)
            | ([up, .._], [d, ..more]) =>
                let here =
                    Nat/min(
                        Nat/min(up + 1, left + 1),
                        diagonal + match c == d | true => 0 | false => 1 end);
                [here, ..advance(above, more, c, here)]
            | _ => []
            end
        | [] => []
        end;
    let last =
        List/fold(
            Str/to_list(a),
            (List/range(0, List/length(bs) + 1), 1),
            (c, state: {List(Nat), Nat}) =>
                ([state.1, ..advance(state.0, bs, c, state.1)], state.1 + 1));
    Option/unwrap_or(List/last(last.0), 0);

--- The name of `known` nearest to `word`, where one is within two edits and closer than the word is long.
pub let closest(word: Str, known: List(Str)) -> Option(Str) =>
    let near =
        List/fold(
            known,
            Option/none(),
            (candidate, best: Option({Str, Nat})) =>
                let d = distance(word, candidate);
                match best
                | some(held), held.1 <= d => best
                | _ => Option/some((candidate, d))
                end);
    match near
    | some(found), found.1 <= 2 && found.1 < Str/length(word) => Option/some(found.0)
    | _ => Option/none()
    end;
