use /std/{Str, Bytes, Nat, Bool, List, Option, Result, Map, Fmt};
use /std/Cli/{Value, nat, Field, Presence, Positional, Positionals, Command, Failure, Reading,
    Carrier, Values, Parsed, Chosen, option_slots, slots, scan};
use /std/Cli/Parsed/{presented, required_slots, optional_slots, rest_slots, appended};
use /std/Cli/scan/{Seen, Raw};

let lifted(@A: Type, @B: Type, r: Reading(A), f: (A) -> B) -> Reading(B) =
    match r
    | parsed(a) => Reading/parsed(f(a))
    | help(path) => Reading/help(path)
    | version(text) => Reading/version(text)
    | refused(path, failure) => Reading/refused(path, failure)
    end;

let reading(v: Value, name: Str, value: Bytes) -> Result(Failure, v.A) =
    match v.read(value)
    | success(a) => Result/success(a)
    | failure(reason) => Result/failure(Failure/bad_value(name, reason))
    end;

let readings(v: Value, name: Str, values: List(Bytes)) -> Result(Failure, List(v.A)) =
    match values
    | [] => Result/success([])
    | [t, ..more] =>
        let a = reading(v, name, t)!;
        let rest = readings(v, name, more)!;
        Result/success([a, ..rest])
    end;

-- The variable `f` declares, as a refusal names it, and its value, where the environment sets it: an empty variable is unset, as a shell reads one.
let variable(f: Field, env: Map(Str, Bytes)) -> Option({Str, Bytes}) =
    match f.env
    | some(name) =>
        match Map/try_get(env, name)
        | some(value), Bytes/length(value) > 0 => Option/some((Str/concat("$", name), value))
        | _ => Option/none()
        end
    | none() => Option/none()
    end;

-- A flag's or a toggle's variable, read as clap reads one: these twelve words in any case, and anything else refused.
let switch(name: Str, value: Bytes) -> Result(Failure, Bool) =
    match Str/of_bytes(value)
    | failure(_) => Result/failure(Failure/bad_value(name, "not valid UTF-8"))
    | success(text) => switch_word(name, text)
    end;

-- The twelve words a switch reads, in any case, and anything else refused.
let switch_word(name: Str, text: Str) -> Result(Failure, Bool) =
    match Str/to_lower(text)
    | "y" | "yes" | "t" | "true" | "on" | "1" => Result/success(true)
    | "n" | "no" | "f" | "false" | "off" | "0" => Result/success(false)
    | _ =>
        Result/failure(
            Failure/bad_value(
                name,
                Fmt/render("expected true or false, yes or no, on or off, or 1 or 0, found '%'")(
                    text)))
    end;

let given(seen: List(Seen)) -> Nat =
    List/length(List/filter(seen, (s) => match s | given() => true | _ => false end));

let given_values(seen: List(Seen)) -> List(Bytes) =
    List/concat_map(seen, (s) => match s | value(b) => [b] | _ => [] end);

let switched(seen: List(Seen)) -> Option(Bool) =
    List/fold(
        seen,
        Option/none(),
        (s, held) =>
            match s
            | given() => Option/some(true)
            | negated() => Option/some(false)
            | _ => held
            end);

let picks(seen: List(Seen)) -> List(Nat) =
    List/fold(
        List/reverse(seen),
        [],
        (s, held) =>
            match s
            | picked(k), Bool/not(List/contains(held, k)) => [k, ..held]
            | _ => held
            end);

let present(@A: Type, presence: Presence(A), a: A) -> presented(A, presence) =
    match presence
    | required() => a
    | optional() => Option/some(a)
    | default(_) => a
    end;

let absent(@A: Type, presence: Presence(A), name: Str) -> Result(Failure, presented(A, presence)) =
    match presence
    | required() => Result/failure(Failure/missing_required(name))
    | optional() => Result/success(Option/none())
    | default(a) => Result/success(a)
    end;

-- A variable stands for its option where the line leaves the option out, and is read by the reader the line's text for that option takes, a refusal naming the variable.
let read_field(
    f: Field,
    seen: List(Seen),
    env: Map(Str, Bytes),
) -> Result(Failure, Carrier(f.kind)) =
    let name = Str/concat("--", f.long);
    let set = variable(f, env);
    match f.kind
    | flag() =>
        match given(seen) > 0
        | true => Result/success(true)
        | false =>
            match set
            | some((var, text)) => switch(var, text)
            | none() => Result/success(false)
            end
        end
    | count() =>
        match given(seen) == 0
        | true =>
            match set
            | some((var, text)) => reading(nat, var, text)
            | none() => Result/success(0)
            end
        | false => Result/success(given(seen))
        end
    | toggle(fallback) =>
        match switched(seen)
        | some(b) => Result/success(b)
        | none() =>
            match set
            | some((var, text)) => switch(var, text)
            | none() => Result/success(fallback)
            end
        end
    | option(v, presence) =>
        match List/last(given_values(seen))
        | some(t) => Result/map(reading(v, name, t), (a) => present(presence, a))
        | none() =>
            match set
            | some((var, text)) => Result/map(reading(v, var, text), (a) => present(presence, a))
            | none() => absent(presence, name)
            end
        end
    | many(v) =>
        match given_values(seen)
        | [] =>
            match set
            | some((var, text)) => readings(v, var, [text])
            | none() => Result/success([])
            end
        | _ => readings(v, name, given_values(seen))
        end
    | choice(_, alternatives, presence) =>
        let spelled = List/map(alternatives, (a) => Str/concat("--", a.long));
        match picks(seen)
        | [] =>
            match set
            | some((var, text)) =>
                match List/find(alternatives, (a) => Str/to_bytes(a.long) == text)
                | some(a) => Result/success(present(presence, a.value))
                | none() =>
                    Result/failure(
                        Failure/bad_value(
                            var,
                            Fmt/render("expected one of %, found '%'")(
                                Str/join(", ", List/map(alternatives, (a) => a.long)))(
                                Str/of_bytes_lossy(text))))
                end
            | none() => absent(presence, Str/join(" | ", spelled))
            end
        | [k] =>
            match List/try_get(alternatives, k)
            | some(a) => Result/success(present(presence, a.value))
            | none() => absent(presence, Str/join(" | ", spelled))
            end
        | [_, _, .._] =>
            Result/failure(
                Failure/conflict(
                    List/concat_map(
                        picks(seen),
                        (i) => match List/try_get(spelled, i) | some(s) => [s] | none() => [] end)))
        end
    end;

let read_options(
    fields: List(Field),
    at: Nat,
    seen: Map(Nat, List(Seen)),
    env: Map(Str, Bytes),
) -> Result(Failure, Values(option_slots(fields))) =
    match fields
    | [] => Result/success(Values/nil())
    | [f, ..more] =>
        let head = read_field(f, List/reverse(Option/unwrap_or(Map/try_get(seen, at), [])), env)!;
        let tail = read_options(more, at + 1, seen, env)!;
        Result/success(Values/cons(head, tail))
    end;

let read_required(
    ps: List(Positional),
    tokens: List(Bytes),
) -> Result(Failure, {Values(required_slots(ps)), List(Bytes)}) =
    match ps
    | [] => Result/success((Values/nil(), tokens))
    | [p, ..more] =>
        match tokens
        | [] => Result/failure(Failure/missing_required(Str/to_upper(p.name)))
        | [t, ..rest] =>
            let a = reading(p.v, Str/to_upper(p.name), t)!;
            let (tail, left) = read_required(more, rest)!;
            Result/success((Values/cons(a, tail), left))
        end
    end;

let read_optional(
    ps: List(Positional),
    tokens: List(Bytes),
) -> Result(Failure, {Values(optional_slots(ps)), List(Bytes)}) =
    match ps
    | [] => Result/success((Values/nil(), tokens))
    | [p, ..more] =>
        match tokens
        | [] =>
            let (tail, left) = read_optional(more, [])!;
            Result/success((Values/cons(Option/none(), tail), left))
        | [t, ..rest] =>
            let a = reading(p.v, Str/to_upper(p.name), t)!;
            let (tail, left) = read_optional(more, rest)!;
            Result/success((Values/cons(Option/some(a), tail), left))
        end
    end;

let read_rest(
    p: Option(Positional),
    tokens: List(Bytes),
) -> Result(Failure, Values(rest_slots(p))) =
    match p
    | none() =>
        match tokens
        | [] => Result/success(Values/nil())
        | [t, .._] => Result/failure(Failure/unexpected(Str/of_bytes_lossy(t)))
        end
    | some(r) =>
        let all = readings(r.v, Str/to_upper(r.name), tokens)!;
        Result/success(Values/cons(all, Values/nil()))
    end;

let leaf_values(
    options: List(Field),
    ps: Positionals,
    raw: Raw,
    env: Map(Str, Bytes),
) -> Result(Failure, Values(slots(options, ps))) =
    let o = read_options(options, 0, raw.seen, env)!;
    let (r, after_required) = read_required(ps.required, raw.positionals)!;
    let (q, after_optional) = read_optional(ps.optional, after_required)!;
    let t = read_rest(ps.rest, after_optional)!;
    Result/success(appended(o, appended(r, appended(q, t))));

-- What `raw` asks before the line is read further: help, then the version, then the first refusal.
let asked(@A: Type, raw: Raw, path: List(Str), version: Option(Str)) -> Option(Reading(A)) =
    match
    | raw.help => Option/some(Reading/help(path))
    | raw.version, some(text) = version => Option/some(Reading/version(text))
    | some(f) = raw.failure => Option/some(Reading/refused(path, f))
    | _ => Option/none()
    end;

pub let command(
    c: Command,
    tokens: List(Bytes),
    path: List(Str),
    version: Option(Str),
    env: Map(Str, Bytes),
) -> Reading(Parsed(c)) =
    match c
    | leaf(name, _, options, ps) =>
        let here = [..path, name];
        let raw = scan/line(options, version, tokens, false);
        match asked(raw, here, version)
        | some(early) => early
        | none() =>
            match leaf_values(options, ps, raw, env)
            | success(v) => Reading/parsed(Parsed/leaf(v))
            | failure(f) => Reading/refused(here, f)
            end
        end
    | group(name, _, options, commands) =>
        let here = [..path, name];
        let raw = scan/line(options, version, tokens, true);
        let known = List/map(commands, /std/Cli/name);
        match asked(raw, here, version)
        | some(early) => early
        | none() =>
            match raw.rest
            | [] => Reading/refused(here, Failure/missing_command(known))
            | [word, ..more] =>
                match read_options(options, 0, raw.seen, env)
                | failure(f) => Reading/refused(here, f)
                | success(v) =>
                    match chosen(commands, word, more, here, version, env)
                    | some(r) => lifted(r, (ch) => Parsed/group(v, ch))
                    | none() =>
                        let written = Str/of_bytes_lossy(word);
                        Reading/refused(
                            here,
                            Failure/unknown_command(written, scan/closest(written, known), known))
                    end
                end
            end
        end
    end
and chosen(
    commands: List(Command),
    word: Bytes,
    tokens: List(Bytes),
    path: List(Str),
    version: Option(Str),
    env: Map(Str, Bytes),
) -> Option(Reading(Chosen(commands))) =
    match commands
    | [] => Option/none()
    | [c, ..rest] =>
        match Str/to_bytes(/std/Cli/name(c)) == word
        | true => Option/some(lifted(command(c, tokens, path, version, env), Chosen/here))
        | false =>
            Option/map(
                chosen(rest, word, tokens, path, version, env),
                (r) => lifted(r, Chosen/there))
        end
    end;
