use /std/{Nat, Int, Eq, Ord, Ordering, Hash, Spell, Str, Option, Show};
use /std/ops/{Eql};
use /std/time/{Date, Time, DateTime, Offset, Timestamp, iso8601};

--- A date and a time of day at an offset from UTC: RFC 3339's `date-time`, a moment that keeps the offset it was written with.
pub struct OffsetDateTime: pub Type {
    date_time: DateTime,
    offset: Offset,
}

satisfy Eql(OffsetDateTime) {
    ..
}

--- The moment's encoding, then the local date-time's, then the offset's: the order's own sequence, which its key's law reads.
satisfy Hash(OffsetDateTime) {
    hash(odt) =
        0x[
            ..Hash/delimited(Hash/hash(to_timestamp(odt))),
            ..Hash/delimited(Hash/hash(odt.date_time)),
            ..Hash/hash(odt.offset)],
}

satisfy Spell(OffsetDateTime) {
    ..
}

-- A function of its own, so the witness states `lt` and `le` over it and the laws read all three by reduction.
let ord(a: OffsetDateTime, b: OffsetDateTime) -> Ordering =
    Ord/lexicographic([
        Ord/ord(to_timestamp(a), to_timestamp(b)),
        Ord/ord(a.date_time, b.date_time),
        Ord/ord(a.offset, b.offset)]);

-- The laws are the step's ([`Ordering/then`]), a piece at a time, each piece's part by its own type's law. Two that compare `eq` are one by their last two pieces, which are the two fields: a congruence written over them, where an equation between two projections solves nothing.
--- By the moment first, as java.time compares, then the local date-time, then the offset, `unknown()` first: two compare equal exactly where they are one value.
satisfy Ord(OffsetDateTime) {
    ord = ord,
    lt(a, b) = Ordering/is_lt(ord(a, b)),
    le(a, b) = Ordering/is_le(ord(a, b)),
    flips(a, b) =
        Ordering/then/flips(
            Ordering/then/flips(
                Ord/flips(to_timestamp(a), to_timestamp(b)),
                (_) => Ord/flips(a.date_time, b.date_time)),
            (_) => Ord/flips(a.offset, b.offset)),
    trans(a, b, c, p, q) =
        Ordering/chains/le(
            ord(a, b),
            ord(b, c),
            ord(a, c),
            Ordering/chains/then(
                Ordering/chains/then(
                    Ord/chains(to_timestamp(a), to_timestamp(b), to_timestamp(c)),
                    (_, _) => Ord/chains(a.date_time, b.date_time, c.date_time)),
                (_, _) => Ord/chains(a.offset, b.offset, c.offset)),
            p,
            q),
    eq(a, b, h) =
        let fields(
            date_time1: DateTime,
            offset1: Offset,
            date_time2: DateTime,
            offset2: Offset,
            date_time: Eq()(date_time1, date_time2),
            offset: Eq()(offset1, offset2),
        ) -> Eq()(
            OffsetDateTime { date_time = date_time1, offset = offset1 },
            OffsetDateTime { date_time = date_time2, offset = offset2 }) =
            let refl() = date_time;
            let refl() = offset;
            Eq/refl();
        let leading =
            Ordering/then/first(
                Ordering/then(
                    Ord/ord(to_timestamp(a), to_timestamp(b)),
                    Ord/ord(a.date_time, b.date_time)),
                Ord/ord(a.offset, b.offset),
                h);
        fields(
            a.date_time,
            a.offset,
            b.date_time,
            b.offset,
            Ord/eq(
                a.date_time,
                b.date_time,
                Ordering/then/second(
                    Ord/ord(to_timestamp(a), to_timestamp(b)),
                    Ord/ord(a.date_time, b.date_time),
                    leading)),
            Ord/eq(
                a.offset,
                b.offset,
                Ordering/then/second(
                    Ordering/then(
                        Ord/ord(to_timestamp(a), to_timestamp(b)),
                        Ord/ord(a.date_time, b.date_time)),
                    Ord/ord(a.offset, b.offset),
                    h))),
    is_lt(_, _) = Eq/refl(),
    is_le(_, _) = Eq/refl(),
}

-- Its order folds the moment's, the date-time's and the offset's from the left, so its law is `Hash/Key/then` at the moment with the rest's below it, `Hash/Key/then` again at the date-time, and `Hash/Key/last` at the offset.
satisfy Hash/Key(OffsetDateTime) {
    mono(a, b) =
        Hash/Key/then(
            Ordering/eq(),
            Ord/ord(to_timestamp(a), to_timestamp(b)),
            Hash/hash(to_timestamp(a)),
            Hash/hash(to_timestamp(b)),
            0x[..Hash/delimited(Hash/hash(a.date_time)), ..Hash/hash(a.offset)],
            0x[..Hash/delimited(Hash/hash(b.date_time)), ..Hash/hash(b.offset)],
            Hash/Key/mono(to_timestamp(a), to_timestamp(b)),
            ord(a, b),
            Hash/Key/then(
                Ordering/then(Ordering/eq(), Ord/ord(to_timestamp(a), to_timestamp(b))),
                Ord/ord(a.date_time, b.date_time),
                Hash/hash(a.date_time),
                Hash/hash(b.date_time),
                Hash/hash(a.offset),
                Hash/hash(b.offset),
                Hash/Key/mono(a.date_time, b.date_time),
                ord(a, b),
                Hash/Key/last(
                    Ordering/then(
                        Ordering/then(Ordering/eq(), Ord/ord(to_timestamp(a), to_timestamp(b))),
                        Ord/ord(a.date_time, b.date_time)),
                    Ord/ord(a.offset, b.offset),
                    Hash/hash(a.offset),
                    Hash/hash(b.offset),
                    Hash/Key/mono(a.offset, b.offset)))),
}

--- The moment the date-time names at its offset: its seconds counted as POSIX counts a date and a time, less how far ahead of UTC the offset is, so a second of `60` counts as the next minute's first.
pub let to_timestamp(odt: OffsetDateTime) -> Timestamp =
    let date = odt.date_time.date;
    let time = odt.date_time.time;
    let seconds =
        Date/to_days(date) * 86400 + Nat/to_int(time.hour * 3600 + time.minute * 60 + time.second)
            - Offset/ahead(odt.offset);
    Timestamp/of_unix_nanos(seconds * 1000000000 + Nat/to_int(time.nanosecond));

--- The moment `t` as the calendar and the clock name it at `o`. It never answers a second of `60`.
pub let of_timestamp(t: Timestamp, o: Offset) -> OffsetDateTime =
    let nanos = Timestamp/to_unix_nanos(t) + Offset/ahead(o) * 1000000000;
    let seconds = nanos / 1000000000;
    OffsetDateTime {
        date_time =
            DateTime {
                date = Date/of_days(seconds / 86400),
                time = Time/of_seconds(Int/rem(seconds, 86400), Int/rem(nanos, 1000000000)) },
        offset = o };

--- The moment as ISO 8601's extended format writes it, at the offset it holds: `2024-02-29T08:49:37+05:30`.
pub let to_str(odt: OffsetDateTime) -> Str =
    iso8601/write_offset_date_time(odt);

--- The OffsetDateTime ISO 8601's extended format writes as `s`, or `none` for text that writes none.
pub let of_str(s: Str) -> Option(OffsetDateTime) =
    iso8601/whole(iso8601/offset_date_time(), s);

satisfy Show(OffsetDateTime) {
    show = to_str,
}
