mod tests;

pub use /sys/{let Io};
pub use /sys/Io/{pure, bind};

--- The failure every host operation reports.
pub mod Error;
pub use Error/{let Error};

--- A value filled once, which whatever waits on it waits for until it is.
pub mod Future;
pub use Future/{let Future};

--- A mark tripped once that stays tripped, which a branch waits on until another trips it.
pub mod Latch;
pub use Latch/{let Latch};

--- A stream with the bytes read ahead of what was asked of it, and the reads that cut a piece from them.
pub mod Reader;
pub use Reader/{let Reader};

--- What a body does with the scope `scope` runs it in: spawning children into it and joining them, deferring releases to it, and how it ended as each release is told.
pub mod Scope;

use /std/{Monad, Bytes, Nat, Int, Bool, List, Option, Box, Program, Try, Vec};
use /std/Io/Scope/{Ended};
use /std/internal/{Handle, Waiting, suspend_on, wait_tripped};
use /std/time/{Duration, Instant};
use /std/Bool/{Holds};

satisfy Monad(Io) {
    pure = pure,
    bind = bind,
}

--- The identity edge, for a witness whose premise is `Monad/Lift(Io, M)` at `M = Io`.
satisfy Monad/Lift(Io, Io) {
    lift(@_, m) => m,
}

--- A description that yields nothing is the program it describes.
satisfy Program(Io({})) {
    execute(program) => program,
}

-- How many children of a scope have not ended, and the latch those waiting for none to be left wait on, kept until the last child's end trips it and the next waiter makes another: what `join_all` waits on, a count rather than the tasks, so a scope that spawns without end holds nothing of the children that have ended.
struct Live: Type {
    count: Nat,
    idle: Option(Latch),
}

-- Declared here and not in its module, so that `scope` builds it and nothing outside `Io` does: its children spawned since the driver last took them, the latest first, and none once the scope has answered, so a child spawned after it never runs; and its releases, the latest first.
--- What a scope's body spawns its children into and defers its releases to.
pub struct Scope: Type {
    children: Box(Option(List(Io({})))),
    live: Box(Live),
    releases: Box(List((Ended) -> Io({}))),
}

--- `body` run with a scope it spawns children into and opens resources into, and its answer once it has one. The children run beside the body, and those still running when the body answers are cancelled where they wait: a description's answer is all it yields, so a child the body needs is joined before it answers. Then every release deferred to the scope runs, the latest first, told whether the scope `finished` or was `cancelled` where it waited — however it ends, its children are cancelled before its resources are released.
pub let scope(@A: Type, body: (Scope) -> Io(A)) -> Io(A) =>
    let children = Box/new(@Option(List(Io({}))), Option/some([]))!;
    let live = Box/new(Live { count = 0, idle = Option/none() })!;
    let releases = Box/new(@List((Ended) -> Io({})), [])!;
    let s = Scope { children = children, live = live, releases = releases };
    let answer: Future(A) = Future/new()!;
    let driven() -> Io(A) =>
        let () = drive([into(body(s), answer)], spawned(children), answered(answer))!;
        let () = Box/set(children, Option/none())!;
        Future/wait(answer);
    using((how) => released(s, how), driven());

-- Every child spawned into `children` since the last time it was asked, in the order they were spawned.
let spawned(children: Box(Option(List(Io({}))))) -> Io(List(Branch)) =>
    Box/change(children, (held: Option(List(Io({})))) =>
        match held
        | some(waiting) => (Option/some([]), List/map(List/reverse(waiting), Branch/fresh))
        | none() => (Option/none(), [])
        end);

-- Each of `releases` told `how`, in its order.
let each(releases: List((Ended) -> Io({})), how: Ended) -> Io({}) =>
    match releases
    | [] => pure(())
    | [r, ..more] => bind(r(how), (()) => each(more, how))
    end;

-- Every release deferred to `s`, the latest first, told `how` it ended.
let released(s: Scope, how: Ended) -> Io({}) =>
    let rs = Box/change(s.releases, (rs: List((Ended) -> Io({}))) => ([], rs))!;
    each(rs, how);

--- A handle ready once the monotonic clock reads at least so many seconds and nanoseconds.
foreign clock_deadline(Int, Nat) -> Handle;

-- The most seconds the wire carries: a deadline past them is one no clock reaches, and is waited on as the furthest the wire states.
let furthest: Int =
    Int/shl(+1, 63) - +1;

--- A handle ready once the monotonic clock has reached `i`: what a description suspends on to wait until then. One already past is ready at once; one before the clock's origin crosses as the origin, which has passed too.
let deadline(i: Instant) -> Io(Handle) =>
    let (seconds, nanos) =
        (Instant/to_nanos(i) / 1000000000, Int/rem(Instant/to_nanos(i), 1000000000));
    match
    | seconds < +0 => clock_deadline(+0, 0)
    | seconds > furthest => clock_deadline(furthest, 0)
    | _ => clock_deadline(seconds, nanos)
    end;

--- Until the monotonic clock has reached `i`, on a deadline of its own, closed whether the wait ends or is cancelled. An instant already past ends the wait at once.
pub let sleep_until(i: Instant) -> Io({}) =>
    let h = deadline(i)!;
    suspend_on(Waiting { on = [h], tripped = [], release = Close/close(h) });

--- Until `d` has passed from now: the clock read once, and a wait until then. A length of no time, or of less, ends at once.
pub let sleep(d: Duration) -> Io({}) =>
    let now = Instant/now()!;
    sleep_until(Instant/add(now, d));

-- A latch tripped already: what a suspension that may go on at once waits on. Private to the subtree, which is where every such suspension is made.
let ready() -> Io(Latch) =>
    let latch = Latch/new()!;
    let () = Latch/trip(latch)!;
    pure(latch);

--- Let what waits beside this run, and go on: a suspension on a latch tripped already, which whatever advances it may go on from at once, and which the top of a program goes on from without waiting.
pub let yield() -> Io({}) =>
    let latch = ready()!;
    wait_tripped([latch]);

-- `body`, and then `release` told how it ended: `finished` where it ran to its end, and `cancelled` where whatever advances it drops it while it waits, which `release` hears as the cancel of every suspension the body passes out. The scope's machinery: a program defers a release to a scope instead.
let using(@A: Type, release: (Ended) -> Io({}), body: Io(A)) -> Io(A) =>
    /sys/Io/advance(
        body,
        (a) => bind(release(Ended/finished()), (()) => pure(a)),
        (on, tripped, cancel, rest) =>
            /sys/Io/suspend(
                on,
                tripped,
                bind(cancel, (()) => release(Ended/cancelled())),
                using(release, rest)));

--- One read's answer: bytes, or the end of the stream. A read that fails says so in its `Try`.
---
--- A chunk holds at least one byte, and says so: a read asks for a positive count, and a stream with nothing more to give has ended. So a reader takes a chunk's first byte by its proof rather than by a default, and a loop over chunks advances with every one.
pub induct Chunk: pub Type
--- Bytes were read: at least one.
| bytes(bytes: Bytes, @some: Holds(0 < Bytes/length(bytes)))
--- The stream is finished.
| ended()
end

--- What a stream is read through. A read asks for a positive count and answers a chunk of between one byte and that count or the end of the stream, or fails; a read the host cannot answer yet waits until it can, by suspending, so it holds only the branch that reads.
---
--- The lower bound is the chunk's own, stated in its type, so a witness for a stream of its own proves every chunk it hands out holds a byte — `Bool/holds` decides it of a length the witness cannot see. The upper bound is the witness's promise, which the host's rows hold `Handle` to.
pub concept Read(S: Type): pub Type {
    read(s: S, n: Nat, @positive: Holds(0 < n)) -> Try(Io, Error, Chunk),
}

pub use Read/*;

--- What a stream is written through.
pub concept Write(S: Type): pub Type {
    --- Writes the whole of the bytes: taken whole before anything waits, then handed on. A write cancelled where it waits leaves its bytes whole in what the stream holds, which the next write, flush or finish of the stream hands on first, so `select` and `timeout` never leave part of a write on a stream.
    write(S, Bytes) -> Try(Io, Error, {}),
    --- Hand on what the stream still holds of the writes it took: what a write cancelled where it waited left, and a TLS stream's records. A serial port then waits until the device has sent it.
    flush(S) -> Try(Io, Error, {}),
}

pub use Write/*;

--- What a stream's sending half is ended through, on its own: the reader at the other end reads the end of the stream, and whatever it sends back is still read. Ending it is not closing it, which the scope the stream was opened into does.
pub concept Finish(S: Type): pub Type {
    finish(S) -> Try(Io, Error, {}),
}

pub use Finish/*;

--- What a resource is closed through before the scope it was opened into closes it. Closing one already closed does nothing, so the scope's own close after an early one is harmless.
pub concept Close(S: Type): pub Type {
    close(S) -> Io({}),
}

pub use Close/*;

--- Every chunk of `from` written to `to` until `from` ends; the first failure on either side is the answer. A chunk read is taken by the write before anything waits, so a copy cancelled where it waits has moved whole chunks and lost none.
pub let copy(@S: Type, @T: Type, use Read(S), use Write(T), from: S, to: T) -> Try(Io, Error, {}) =>
    let go() -> Try(Io, Error, {}) =>
        let c = Read/read(from, 4096)!;
        match c
        | bytes(b) =>
            let () = Write/write(to, b)!;
            go()
        | ended() => Try/pure(())
        end;
    go();

-- Descriptions run side by side under one: each runs until it suspends, and the one that holds them waits on what all of them wait on. A branch no longer needed — a loser, a timed-out action, a child of a scope whose body has answered — is cancelled where it waits.
-- A branch the driver holds: one still to start, or one suspended on what its suspension named, with what cancels it and the rest of it. A branch that ran to its end is dropped, its answer in whatever it wrote to.
induct Branch: Type
| fresh(Io({}))
| waiting(on: List(Handle), tripped: List(Latch), cancel: Io({}), rest: Io({}))
end

-- `b` advanced until it ends or suspends: nothing where it ended, or the branch it suspended as.
let step(b: Io({})) -> Io(Option(Branch)) =>
    /sys/Io/advance(
        b,
        (()) => pure(Option/none()),
        (on, tripped, cancel, rest) =>
            pure(Option/some(Branch/waiting(on, tripped, cancel, rest))));

-- Whether a latch of `latches` is tripped.
let any_tripped(latches: List(Latch)) -> Io(Bool) =>
    match latches
    | [] => pure(false)
    | [latch, ..more] =>
        let tripped = Latch/tripped(latch)!;
        match tripped | true => pure(true) | false => any_tripped(more) end
    end;

-- Whether any of the first `n` of `flags` holds, and the flags after them.
let split(flags: List(Bool), n: Nat) -> {Bool, List(Bool)} =>
    match n
    | 0 => (false, flags)
    | m + 1 =>
        match flags
        | [] => (false, [])
        | [f, ..more] =>
            let (any, rest) = split(more, m);
            (f || any, rest)
        end
    end;

-- The handles the waiting branches of `branches` wait on, in their order.
let handles(branches: List(Branch)) -> List(Handle) =>
    List/concat_map(branches, (b: Branch) =>
        match b | waiting(on, _, _, _) => on | fresh(_) => [] end);

-- The latches the waiting branches of `branches` wait on, in their order.
let latches(branches: List(Branch)) -> List(Latch) =>
    List/concat_map(branches, (b: Branch) =>
        match b | waiting(_, tripped, _, _) => tripped | fresh(_) => [] end);

-- Every waiting branch's cancel, in their order. A branch that never started has nothing to cancel.
let cancel_all(branches: List(Branch)) -> Io({}) =>
    match branches
    | [] => pure(())
    | [b, ..more] =>
        let () =
            match b
            | waiting(_, _, cancel, _) => cancel
            | fresh(_) => pure(())
            end!;
        cancel_all(more)
    end;

let kept(stepped: Option(Branch), after: List(Branch)) -> List(Branch) =>
    match stepped | some(b) => [b, ..after] | none() => after end;

-- One pass over `branches`, `flags` saying which of their handles are ready, in their order: a fresh branch is started, a waiting one whose handle is ready or whose latch is tripped advanced, and any other kept as it waits. A pass advances nothing more once `settled` holds. Answers the branches after the pass, and whether any moved.
let pass(
    branches: List(Branch),
    flags: List(Bool),
    settled: Io(Bool),
) -> Io({List(Branch), Bool}) =>
    match branches
    | [] => pure(([], false))
    | [b, ..more] =>
        let done = settled!;
        match done
        | true => pure((branches, false))
        | false =>
            match b
            | fresh(start) =>
                let stepped = step(start)!;
                let (after, _) = pass(more, flags, settled)!;
                pure((kept(stepped, after), true))
            | waiting(on, tripped, _, rest) =>
                let (ready, later) = split(flags, List/length(on));
                let woken = any_tripped(tripped)!;
                match ready || woken
                | true =>
                    let stepped = step(rest)!;
                    let (after, _) = pass(more, later, settled)!;
                    pure((kept(stepped, after), true))
                | false =>
                    let (after, moved) = pass(more, later, settled)!;
                    pure(([b, ..after], moved))
                end
            end
        end
    end;

-- `branches`, with whatever `intake` hands over before each pass, advanced pass after pass until `settled` holds or none is left: the one place `/std` holds a branch's rest and performs a dropped branch's cancel, under every combinator. A pass that moved something yields outward on a latch tripped already, so whatever advances this description runs its own branches between passes; a pass that moved nothing suspends outward on every handle and latch its branches wait on, and on nothing where they wait on nothing. The branches still waiting when it ends are cancelled, each once, and so is every one of them where whatever advances it cancels it.
let drive(held: List(Branch), intake: Io(List(Branch)), settled: Io(Bool)) -> Io({}) =>
    let incoming = intake!;
    let branches = [..held, ..incoming];
    let done = settled!;
    match done
    | true => cancel_all(branches)
    | false =>
        match branches
        | [] => pure(())
        | _ =>
            let on = handles(branches);
            let flags = match on | [] => pure([]) | _ => Handle/ready_now(on) end!;
            let (next, moved) = pass(branches, flags, settled)!;
            let ended = settled!;
            match ended
            | true => cancel_all(next)
            | false =>
                match next
                | [] => drive([], intake, settled)
                | _ =>
                    let rest = drive(next, intake, settled);
                    match moved
                    | true =>
                        let latch = ready()!;
                        /sys/Io/suspend([], [latch], cancel_all(next), rest)
                    | false => /sys/Io/suspend(handles(next), latches(next), cancel_all(next), rest)
                    end
                end
            end
        end
    end;

-- A driver over a fixed set of branches.
let nothing_more() -> Io(List(Branch)) =>
    pure([]);

-- Whether `f` has been filled.
let answered(@A: Type, f: Future(A)) -> Io(Bool) =>
    bind(Future/poll(f), (held) => pure(Option/is_some(held)));

-- `a` as a branch that fills `f` with its answer.
let into(@A: Type, a: Io(A), f: Future(A)) -> Branch =>
    Branch/fresh(bind(a, (x) => Future/fill(f, x)));

--- `a` and `b` side by side, and both answers once both have them.
pub let both(@A: Type, @B: Type, a: Io(A), b: Io(B)) -> Io({A, B}) =>
    let fa = Future/new()!;
    let fb = Future/new()!;
    let () = drive([into(a, fa), into(b, fb)], nothing_more(), pure(false))!;
    let x = Future/wait(fa)!;
    let y = Future/wait(fb)!;
    pure((x, y));

-- A future for each action of `actions`, beside it.
let promised(@A: Type, actions: List(Io(A))) -> Io(Vec({Io(A), Future(A)}, List/length(actions))) =>
    match actions
    | [] => pure(Vec/nil())
    | [a, ..more] =>
        let f = Future/new()!;
        let rest = promised(more)!;
        pure(Vec/cons((a, f), rest))
    end;

-- The answer of each future of `fs`, in their order.
let awaited(@A: Type, fs: List(Future(A))) -> Io(Vec(A, List/length(fs))) =>
    match fs
    | [] => pure(Vec/nil())
    | [f, ..more] =>
        let a = Future/wait(f)!;
        let rest = awaited(more)!;
        pure(Vec/cons(a, rest))
    end;

--- Every action of `actions` side by side, and their answers in their order once all have them, one for each action: an answer is read by its position, with no case for one missing, whatever the actions do.
pub let all(@A: Type, actions: List(Io(A))) -> Io(Vec(A, List/length(actions))) =>
    let pairs = promised(actions)!;
    let () =
        drive(
            List/map(pairs.list, (p: {Io(A), Future(A)}) => into(p.0, p.1)),
            nothing_more(),
            pure(false))!;
    let answers = awaited(List/map(pairs.list, (p: {Io(A), Future(A)}) => p.1))!;
    pure(Vec { list = answers.list });

--- The answer of the first of `actions` to finish; every other one is cancelled where it waits. They are stepped in list order, so of two that can answer at once the earlier wins: `select([a, Io/pure(d)])` tries `a` and answers `d` rather than wait, and in a loop an action that is always ready starves the ones after it. Which action answered is its answer's to say. With no action, nothing answers.
---
--- Every action of `/std` cancelled where it waits has lost nothing: what it took before it waited is answered already or kept where the drop cannot reach it, so a take, a read, a join, a `Future`'s wait, a sleep, a `write`, a `copy` and a `Reader`'s reads can be dropped and run again without loss. A write takes its whole message before it waits, which the stream then holds and hands on whole; a reader keeps what it read ahead in itself. Keep what must not be lost as the last step of its action, and do what follows after `select` answers. An action of your own that holds something across a wait of its own keeps it where a drop cannot lose it: in a `Box` before it waits, as `Io/Reader` keeps the bytes it read ahead, or in a release deferred to its scope, which is told the scope was `cancelled`.
pub let select(@A: Type, actions: List(Io(A))) -> Io(A) =>
    let won: Future(A) = Future/new()!;
    let () = drive(List/map(actions, (a: Io(A)) => into(a, won)), nothing_more(), answered(won))!;
    Future/wait(won);

--- `a`'s answer, or `none` where `d` passes first, `a` then cancelled where it waits: a `select` against a sleep. An answer that lands after `d` is dropped, which is what a timeout means.
pub let timeout(@A: Type, d: Duration, a: Io(A)) -> Io(Option(A)) =>
    select([bind(a, (x) => pure(Option/some(x))), bind(sleep(d), (()) => pure(Option/none()))]);
