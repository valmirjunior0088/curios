mod tests;

--- Why a document did not decode.
pub mod Error;
pub use Error/{let Error};

mod build;

mod scan;

mod strings;

mod keys;

mod numbers;

mod date_time;

mod values;

mod decode;
pub use decode/{let decode};

mod encode;
pub use encode/{let encode};

use /std/{Int, Flt, Bool, Str, List, Map, Eq, Spell, proved};
use /std/ops/{Eql};
use /std/time/{Date, Time, DateTime, OffsetDateTime, rfc3339};

pub induct Toml: pub Type
--- A string.
| str(Str)
--- An integer.
| int(Int)
--- A float.
| flt(Flt)
--- `true` or `false`.
| bool(Bool)
--- A date and time with an offset from UTC. Its year has the four digits and its offset the whole minutes RFC 3339 writes, the only ones TOML reads, so that a value encodes to a document that decodes.
| offset_date_time(
    value: OffsetDateTime,
    @four_digits: rfc3339/FourDigits(value.date_time.date),
    @whole_minutes: rfc3339/WholeMinutes(value.offset))
--- A date and time with no offset.
| local_date_time(value: DateTime, @four_digits: rfc3339/FourDigits(value.date))
--- A date alone.
| local_date(value: Date, @four_digits: rfc3339/FourDigits(value))
--- A time of day alone.
| local_time(Time)
--- An array, in order.
| arr(List(Toml))
--- A table, by key.
| table(Map(Str, Toml))
end

pub use Toml/*;

--- Whether two values are one: the same case holding the same value, an array's elements in order and a table's entries alike, and a float the same bit pattern, so a `nan` a document holds equals itself and `+0.0` stands apart from `-0.0`, as a document's values are told apart, where IEEE's equality is a float's.
---
--- Written in the witness, which may read its own methods: an array and a table are compared by `==`, which asks this witness of `List`'s and of `Map`'s, each applying it below what it holds.
satisfy Eql(Toml) {
    eql(a, b) =
        match a
        | str(x) => match b | str(y) => x == y | _ => false end
        | int(x) => match b | int(y) => x == y | _ => false end
        | flt(x) => match b | flt(y) => Flt/identical(x, y) | _ => false end
        | bool(x) => match b | bool(y) => x == y | _ => false end
        | offset_date_time(x) => match b | offset_date_time(y) => x == y | _ => false end
        | local_date_time(x) => match b | local_date_time(y) => x == y | _ => false end
        | local_date(x) => match b | local_date(y) => x == y | _ => false end
        | local_time(x) => match b | local_time(y) => x == y | _ => false end
        | arr(x) => match b | arr(y) => x == y | _ => false end
        | table(x) => match b | table(y) => x == y | _ => false end
        end,
    -- An arm for every pair of cases: at two different ones `eql` answered `false`, and at the same one the values are one by their own law.
    eq(a, b, h) =
        match a
        | str(x) =>
            match b
            | str(y) =>
                let refl() = proved(@Eq()(x, y));
                Eq/refl()
            | int(_) => match h end
            | flt(_) => match h end
            | bool(_) => match h end
            | offset_date_time(_) => match h end
            | local_date_time(_) => match h end
            | local_date(_) => match h end
            | local_time(_) => match h end
            | arr(_) => match h end
            | table(_) => match h end
            end
        | int(x) =>
            match b
            | str(_) => match h end
            | int(y) =>
                let refl() = proved(@Eq()(x, y));
                Eq/refl()
            | flt(_) => match h end
            | bool(_) => match h end
            | offset_date_time(_) => match h end
            | local_date_time(_) => match h end
            | local_date(_) => match h end
            | local_time(_) => match h end
            | arr(_) => match h end
            | table(_) => match h end
            end
        | flt(x) =>
            match b
            | str(_) => match h end
            | int(_) => match h end
            | flt(y) =>
                let refl() = Flt/eq_of_identical(x, y, h);
                Eq/refl()
            | bool(_) => match h end
            | offset_date_time(_) => match h end
            | local_date_time(_) => match h end
            | local_date(_) => match h end
            | local_time(_) => match h end
            | arr(_) => match h end
            | table(_) => match h end
            end
        | bool(x) =>
            match b
            | str(_) => match h end
            | int(_) => match h end
            | flt(_) => match h end
            | bool(y) =>
                let refl() = proved(@Eq()(x, y));
                Eq/refl()
            | offset_date_time(_) => match h end
            | local_date_time(_) => match h end
            | local_date(_) => match h end
            | local_time(_) => match h end
            | arr(_) => match h end
            | table(_) => match h end
            end
        | offset_date_time(x) =>
            match b
            | str(_) => match h end
            | int(_) => match h end
            | flt(_) => match h end
            | bool(_) => match h end
            | offset_date_time(y) =>
                let refl() = proved(@Eq()(x, y));
                Eq/refl()
            | local_date_time(_) => match h end
            | local_date(_) => match h end
            | local_time(_) => match h end
            | arr(_) => match h end
            | table(_) => match h end
            end
        | local_date_time(x) =>
            match b
            | str(_) => match h end
            | int(_) => match h end
            | flt(_) => match h end
            | bool(_) => match h end
            | offset_date_time(_) => match h end
            | local_date_time(y) =>
                let refl() = proved(@Eq()(x, y));
                Eq/refl()
            | local_date(_) => match h end
            | local_time(_) => match h end
            | arr(_) => match h end
            | table(_) => match h end
            end
        | local_date(x) =>
            match b
            | str(_) => match h end
            | int(_) => match h end
            | flt(_) => match h end
            | bool(_) => match h end
            | offset_date_time(_) => match h end
            | local_date_time(_) => match h end
            | local_date(y) =>
                let refl() = proved(@Eq()(x, y));
                Eq/refl()
            | local_time(_) => match h end
            | arr(_) => match h end
            | table(_) => match h end
            end
        | local_time(x) =>
            match b
            | str(_) => match h end
            | int(_) => match h end
            | flt(_) => match h end
            | bool(_) => match h end
            | offset_date_time(_) => match h end
            | local_date_time(_) => match h end
            | local_date(_) => match h end
            | local_time(y) =>
                let refl() = proved(@Eq()(x, y));
                Eq/refl()
            | arr(_) => match h end
            | table(_) => match h end
            end
        | arr(x) =>
            match b
            | str(_) => match h end
            | int(_) => match h end
            | flt(_) => match h end
            | bool(_) => match h end
            | offset_date_time(_) => match h end
            | local_date_time(_) => match h end
            | local_date(_) => match h end
            | local_time(_) => match h end
            | arr(y) =>
                let refl() = proved(@Eq()(x, y));
                Eq/refl()
            | table(_) => match h end
            end
        | table(x) =>
            match b
            | str(_) => match h end
            | int(_) => match h end
            | flt(_) => match h end
            | bool(_) => match h end
            | offset_date_time(_) => match h end
            | local_date_time(_) => match h end
            | local_date(_) => match h end
            | local_time(_) => match h end
            | arr(_) => match h end
            | table(y) =>
                let refl() = proved(@Eq()(x, y));
                Eq/refl()
            end
        end,
    refl(a) =
        match a
        | str(x) => Eql/refl(x)
        | int(x) => Eql/refl(x)
        | flt(x) => Eql/refl(Flt/to_le_bytes(x))
        | bool(x) => Eql/refl(x)
        | offset_date_time(x) => Eql/refl(x)
        | local_date_time(x) => Eql/refl(x)
        | local_date(x) => Eql/refl(x)
        | local_time(x) => Eql/refl(x)
        | arr(x) => Eql/refl(x)
        | table(x) => Eql/refl(x)
        end,
}

satisfy Spell(Toml) {
    ..
}
