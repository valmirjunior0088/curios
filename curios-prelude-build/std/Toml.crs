mod tests;

--- Why a document did not decode.
pub mod Error;
pub use Error/{let Error};

mod build;

mod scan;

mod strings;

mod keys;

mod numbers;

mod date_time;

mod values;

mod decode;
pub use decode/{let decode};

mod encode;
pub use encode/{let encode};

use /std/{Int, Flt, Bool, Str, List, Map, Spell};
use /std/ops/{Eql};
use /std/time/{Date, Time, DateTime, OffsetDateTime, rfc3339};

pub induct Toml: pub Type
--- A string.
| str(Str)
--- An integer.
| int(Int)
--- A float.
| flt(Flt)
--- `true` or `false`.
| bool(Bool)
--- A date and time with an offset from UTC. Its year has the four digits and its offset the whole minutes RFC 3339 writes, the only ones TOML reads, so that a value encodes to a document that decodes.
| offset_date_time(
    value: OffsetDateTime,
    @four_digits: rfc3339/FourDigits(value.date_time.date),
    @whole_minutes: rfc3339/WholeMinutes(value.offset))
--- A date and time with no offset.
| local_date_time(value: DateTime, @four_digits: rfc3339/FourDigits(value.date))
--- A date alone.
| local_date(value: Date, @four_digits: rfc3339/FourDigits(value))
--- A time of day alone.
| local_time(Time)
--- An array, in order.
| arr(List(Toml))
--- A table, by key.
| table(Map(Str, Toml))
end

pub use Toml/*;

-- A table is compared entry by entry rather than with `==`, which would ask `Eql(Toml)` of `Map`'s witness from inside its own, a declaration and a witness that need each other; a map lists its entries in one order for one set of keys.
--- Whether `a` and `b` are one value: the same case holding the same value, an array's elements in order and a table's entries alike, and a float the same bit pattern, so a `nan` a document holds equals itself and `+0.0` stands apart from `-0.0`, as a document's values are told apart, where IEEE's equality is a float's.
let same(a: Toml, b: Toml) -> Bool =
    match (a, b)
    | (str(x), str(y)) => x == y
    | (int(x), int(y)) => x == y
    | (flt(x), flt(y)) => Flt/identical(x, y)
    | (bool(x), bool(y)) => x == y
    | (offset_date_time(x), offset_date_time(y)) => x == y
    | (local_date_time(x), local_date_time(y)) => x == y
    | (local_date(x), local_date(y)) => x == y
    | (local_time(x), local_time(y)) => x == y
    | (arr(xs), arr(ys)) =>
        List/length(xs) == List/length(ys)
            && List/all(List/zip(xs, ys), (p: {Toml, Toml}) => same(p.0, p.1))
    | (table(x), table(y)) =>
        let xs = Map/to_list(x);
        let ys = Map/to_list(y);
        List/length(xs) == List/length(ys)
            && List/all(
                List/zip(xs, ys),
                (p: {{Str, Toml}, {Str, Toml}}) => p.0.0 == p.1.0 && same(p.0.1, p.1.1))
    | _ => false
    end;

satisfy Eql(Toml) {
    eql = same,
    neq = (a, b) => Bool/not(same(a, b)),
}

satisfy Spell(Toml) {
    ..
}
