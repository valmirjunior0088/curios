pub use /sys/Nat/{lt};

use /std/{Nat, Bool, Eq};
use /std/Bool/{True, Holds};

--- A bound whose two sides differ is strict: `a <= b` and `a == b` failing give `a < b`.
---
--- The case of a disequality its loose bound holds in.
pub let of_le_ne(a: Nat, b: Nat, p: Holds(a <= b), q: Holds(Bool/not(a == b))) -> Holds(a < b) =>
    match a < b
    | true => True/qed()
    | false =>
        let back: Holds(b <= a) = True/qed();
        let same: Eq()(a, b) = Nat/le/antisym(a, b, p, back);
        let absurd: Holds(Bool/not(a == a)) =
            Eq/subst((x: Nat) => Holds(Bool/not(a == x)), Eq/sym(same), q);
        match absurd end
    end;

--- A strict bound composed with a loose one stays strict.
pub let of_lt_le(a: Nat, b: Nat, c: Nat, p: Holds(a < b), q: Holds(b <= c)) -> Holds(a < c) =>
    Nat/le/trans(p, q);

--- Two bounded digits in adjacent places stay under the product of their radices: `a < m` and `b < n` give `a * n + b < m * n`.
---
--- The bound every positional encoding needs, and the one a quotient's upper bound `x < (x / d + 1) * d` rests on.
pub let add_mul_lt(
    a: Nat,
    b: Nat,
    m: Nat,
    n: Nat,
    pa: Holds(a < m),
    pb: Holds(b < n),
) -> Holds(a * n + b < m * n) =>
    of_lt_le(a * n + b, a * n + n, m * n, pb, Nat/le/mul_mono_r(n, pa));
