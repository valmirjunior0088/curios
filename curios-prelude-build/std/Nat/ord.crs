use /std/{Nat, Eq, Ordering};
use /std/ops/{Ord};
use /std/Bool/{True};

--- The order of the two.
pub let ord(x: Nat, y: Nat) -> Ordering =>
    match
    | Nat/lt(x, y) => Ordering/lt()
    | x == y => Ordering/eq()
    | _ => Ordering/gt()
    end;

-- By recursion on both sides, as [`flips`] is.
--- `ord(a, b)` is `eq` only where `a` is `b`: the order agrees with equality.
let eq(a: Nat, b: Nat, h: Eq()(ord(a, b), Ordering/eq())) -> Eq()(a, b) =>
    match a
    | 0 =>
        match b
        | 0 => Eq/refl()
        | _ + 1 => match h end
        end
    | ap + 1 =>
        match b
        | 0 => match h end
        | bp + 1 => Eq/cong((x) => x + 1, eq(ap, bp, h))
        end
    end;

-- By recursion on both sides: a successor on each cancels in the two comparisons `ord` reads, so `ord` of two successors is `ord` of their predecessors. It reads no lemma, and none typed through `<` or `<=`: `Ord`'s witness at `Nat`, below, names this law and the others here, and an operator would read that witness back.
--- `ord` answers the flipped answer with its operands swapped.
let flips: Ord/Flips(ord) =
    (a, b) =>
        match a
        | 0 => match b | 0 | _ + 1 => Eq/refl() end
        | ap + 1 => match b | 0 => Eq/refl() | bp + 1 => flips(ap, bp) end
        end;

-- By recursion on the three, as [`flips`] is on its two.
--- `ord` as a relation carries across a middle element.
let trans: Ord/Trans(Ord/le_by(ord)) =
    (a, b, c, p, q) =>
        match a
        | 0 => match c | 0 | _ + 1 => True/qed() end
        | ap + 1 =>
            match b
            | 0 => match p end
            | bp + 1 =>
                match c
                | 0 => match q end
                | cp + 1 => trans(ap, bp, cp, p, q)
                end
            end
        end;

-- Stated over `Nat/lt` by name, as [`is_le`] is over `Nat/le`: `a < b` would read the witness that names this.
--- `a < b` is `ord` answering `lt`.
let is_lt(a: Nat, b: Nat) -> Eq()(Nat/lt(a, b), Ordering/is_lt(ord(a, b))) =>
    match a
    | 0 => match b | 0 | _ + 1 => Eq/refl() end
    | ap + 1 => match b | 0 => Eq/refl() | bp + 1 => is_lt(ap, bp) end
    end;

--- `a <= b` is `ord` answering `lt` or `eq`.
let is_le(a: Nat, b: Nat) -> Eq()(Nat/le(a, b), Ordering/is_le(ord(a, b))) =>
    match a
    | 0 => match b | 0 | _ + 1 => Eq/refl() end
    | ap + 1 => match b | 0 => Eq/refl() | bp + 1 => is_le(ap, bp) end
    end;

satisfy Ord(Nat) {
    ord = ord,
    lt = Nat/lt,
    le = Nat/le,
    flips = flips,
    trans = trans,
    eq = eq,
    is_lt = is_lt,
    is_le = is_le,
}
