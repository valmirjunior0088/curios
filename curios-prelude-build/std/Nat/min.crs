pub use /sys/Nat/{min};

use /std/{Nat, Eq};
use /std/Bool/{Holds};

-- With `b` read as `a + (b - a)`, which [`Nat/le/add_sub_cancel`] states under `p`, the greater operand is dropped.
--- Conversion decides `min` where it can compare the two operands from their terms alone; it reads no hypothesis, so under one a proof takes this lemma or [`of_ge`].
pub let of_le(a: Nat, b: Nat, p: Holds(a <= b)) -> Eq()(min(a, b), a) =
    Eq/sym(Eq/cong((x) => min(a, x), Nat/le/add_sub_cancel(a, b, p)));

pub let of_ge(a: Nat, b: Nat, p: Holds(b <= a)) -> Eq()(min(a, b), b) =
    Eq/sym(Eq/cong((x) => min(x, b), Nat/le/add_sub_cancel(b, a, p)));
