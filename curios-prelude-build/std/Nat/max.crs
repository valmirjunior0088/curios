pub use /sys/Nat/{max};

use /std/{Nat, Eq};
use /std/Bool/{Holds};

-- With `b` read as `a + (b - a)`, which [`Nat/le/add_sub_cancel`] states under `p`, the lesser operand is dropped.
--- Conversion decides `max` where it can compare the two operands from their terms alone; it reads no hypothesis, so under one a proof takes this lemma or [`of_ge`].
pub let of_le(a: Nat, b: Nat, p: Holds(a <= b)) -> Eq()(max(a, b), b) =>
    let raised = Nat/le/add_sub_cancel(a, b, p);
    Eq/trans(Eq/sym(Eq/cong((x) => max(a, x), raised)), raised);

pub let of_ge(a: Nat, b: Nat, p: Holds(b <= a)) -> Eq()(max(a, b), a) =>
    let raised = Nat/le/add_sub_cancel(b, a, p);
    Eq/trans(Eq/sym(Eq/cong((x) => max(x, b), raised)), raised);
