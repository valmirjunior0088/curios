use /std/{Nat, Bool, Eq, proved};
use /std/Bool/{True, Holds};

--- Whether `p` accepts every number below `k`.
---
--- A decision, so at a literal `k`, `Holds(all_below(k, p))` is discharged by reduction, running `p` on each number. That is how a fact about every byte is proved where the logic cannot see inside the operation it concerns.
pub let all_below(k: Nat, p: (Nat) -> Bool) -> Bool =>
    match k | 0 => true | j + 1 => p(j) && all_below(j, p) end;

--- What the decision says of one number below the bound.
pub let at(
    k: Nat,
    p: (Nat) -> Bool,
    n: Nat,
    all: Holds(all_below(k, p)),
    under: Holds(n < k),
) -> Holds(p(n)) =>
    match k
    | 0 => match under end
    | j + 1 =>
        match n < j
        | true => at(j, p, n, Bool/and/second(p(j), all_below(j, p), all), True/qed())
        | false =>
            Eq/subst(
                (m: Nat) => Holds(p(m)),
                Nat/le/antisym(j, n, proved(), proved()),
                Bool/and/first(p(j), all_below(j, p), all))
        end
    end;
