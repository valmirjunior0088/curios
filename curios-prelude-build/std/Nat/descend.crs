use /std/{Nat, proved};
use /std/Bool/{False, Holds};

-- Nothing lies below a measure that a bound of zero holds.
let none_below(m: Nat, k: Nat, below: Holds(m < k), within: Holds(k <= 0)) -> False =
    proved();

-- The loop is local to a wrapper that does not recurse, so inlining the wrapper at a call fuses `step` into the loop. A `descend` that passed `step` to itself would keep an indirect call at every level, and run out of stack sooner.
--- Recursion on a measure: `step` handles `s` and may recurse at any state whose measure is smaller, given the proof. With `P` a family of propositions it is induction on the measure.
---
--- It is total as written and reduces inside types. The step never sees the bound; the proof that a state's measure is smaller is usually written by the elaborator from the facts in scope. With the identity measure it is course-of-values recursion on `Nat`.
pub let descend(
    @S: Type,
    measure: (S) -> Nat,
    P: (S) -> Sort,
    step: (s: S, ih: (t: S, r: Holds(measure(t) < measure(s))) -> P(t)) -> P(s),
    s: S,
) -> P(s) =
    let go(k: Nat, s: S, within: Holds(measure(s) <= k)) -> P(s) =
        match k
        | 0 => step(s, (t, r) =>
            match none_below(measure(t), measure(s), r, within) end)
        | kp + 1 => step(s, (t, r) => go(kp, t, proved()))
        end;
    go(measure(s), s, Nat/le/refl(measure(s)));
