use /std/{Nat, Bytes, Eq, Ord, Ordering, proved, Bool};

-- How many bytes follow a number's first.
let rank(n: Nat) -> Nat =
    match n < 16 | true => 0 | false => 1 + rank(n / 256) end;

-- What a number's `rank` bytes leave of it: its top four bits.
let top(n: Nat) -> Nat =
    match n < 16 | true => n | false => top(n / 256) end;

let top_below(n: Nat) -> Bool/Holds(top(n) < 16) =
    Nat/descend(
        (m: Nat) => m,
        (m) => Bool/Holds(top(m) < 16),
        (m, ih) => match m < 16 | true => proved() | false => ih(m / 256, proved()) end,
        n);

-- The first byte of a number of rank `l` and top `t`, behind a `0xFF` for every seven of its rank past six.
let first(l: Nat, t: Nat, @fits: Bool/Holds(t < 16)) -> Bytes =
    match l < 7
    | true => 0x[Nat/to_byte(0x80 + 16 * l + t)]
    | false => 0x[0xFF, ..first(l - 7, t)]
    end;

-- The bytes after a number's first, most significant first.
let rest(n: Nat) -> Bytes =
    match n < 16
    | true => 0x[]
    | false => 0x[..rest(n / 256), Nat/to_byte(n % 256)]
    end;

-- The encoding in one walk: the rank counted on the way down, the first byte written where the top is left, and the bytes appended on the way back.
let from(n: Nat, l: Nat) -> Bytes =
    match n < 16
    | true => first(l, n)
    | false => 0x[..from(n / 256, l + 1), Nat/to_byte(n % 256)]
    end;

--- A natural's encoding, in the order of the numbers: a smaller number's is before a larger one's as `Bytes/ord` reads them, and no number's begins another's.
---
--- The first byte is `0x80 + 16 * rank + top`, where `rank` is how many bytes follow it, below seven, and `top` the number those bytes leave, below sixteen; then the `rank` bytes, most significant first. A rank of seven or more writes a `0xFF` for every seven and then the same. So a number below 16 is one byte, below 4 096 two and below `2^20` three.
pub let hash(n: Nat) -> Bytes =
    from(n, 0);

-- The walk from a count writes the first byte of that count past the number's rank, and then the number's bytes.
let from_count(
    n: Nat,
    l: Nat,
) -> Eq()(from(n, l), 0x[..first(l + rank(n), top(n), @top_below(n)), ..rest(n)]) =
    Nat/descend(
        (m: Nat) => m,
        (m) =>
            (l: Nat) -> Eq()(
                from(m, l),
                0x[..first(l + rank(m), top(m), @top_below(m)), ..rest(m)]),
        (m, ih) =>
            (l) =>
                match m < 16
                | true => Eq/refl()
                | false =>
                    Eq/cong(
                        (z: Bytes) => 0x[..z, Nat/to_byte(m % 256)],
                        ih(m / 256, proved())(l + 1))
                end,
        n)(
        l);

-- A smaller number has no more bytes.
let rank_mono(a: Nat, b: Nat, le: Bool/Holds(a <= b)) -> Bool/Holds(rank(a) <= rank(b)) =
    Nat/descend(
        (m: Nat) => m,
        (m) => (b: Nat, le: Bool/Holds(m <= b)) -> Bool/Holds(rank(m) <= rank(b)),
        (m, ih) =>
            (b, le) =>
                match
                | m < 16 => proved()
                | b < 16 => match proved(@Bool/False) end
                | _ =>
                    let inner: Bool/Holds(rank(m / 256) <= rank(b / 256)) =
                        ih(m / 256, proved())(b / 256, proved());
                    proved()
                end,
        a)(
        b,
        le);

-- Of two numbers of one rank, the smaller has no greater a top.
let top_mono(
    a: Nat,
    b: Nat,
    le: Bool/Holds(a <= b),
    ranks: Bool/Holds(rank(a) == rank(b)),
) -> Bool/Holds(top(a) <= top(b)) =
    Nat/descend(
        (m: Nat) => m,
        (m) =>
            (b: Nat, le: Bool/Holds(m <= b), ranks: Bool/Holds(rank(m) == rank(b))) -> Bool/Holds(
                top(m) <= top(b)),
        (m, ih) =>
            (b, le, ranks) =>
                match m < 16
                | true =>
                    match b < 16
                    | true => proved()
                    | false => match ranks end
                    end
                | false =>
                    match b < 16
                    | false => ih(m / 256, proved())(b / 256, proved(), proved())
                    end
                end,
        a)(
        b,
        le,
        ranks);

-- A first byte of a lower rank is below one of a higher, whatever follows each.
let first_ranks(
    la: Nat,
    ta: Nat,
    lb: Nat,
    tb: Nat,
    s: Bytes,
    u: Bytes,
    @fa: Bool/Holds(ta < 16),
    @fb: Bool/Holds(tb < 16),
    under: Bool/Holds(la < lb),
) -> Bool/Holds(Bytes/ord/below(0x[..first(la, ta), ..s], 0x[..first(lb, tb), ..u])) =
    Nat/descend(
        (m: Nat) => m,
        (l) =>
            (lb: Nat, under: Bool/Holds(l < lb)) -> Bool/Holds(
                Bytes/ord/below(0x[..first(l, ta), ..s], 0x[..first(lb, tb), ..u])),
        (l, ih) =>
            (lb, under) =>
                match l < 7
                | true =>
                    match lb < 7
                    | true =>
                        Bytes/ord/below/of_heads(
                            Nat/to_byte(0x80 + 16 * l + ta),
                            Nat/to_byte(0x80 + 16 * lb + tb),
                            s,
                            u,
                            proved())
                    | false =>
                        Bytes/ord/below/of_heads(
                            Nat/to_byte(0x80 + 16 * l + ta),
                            0xFF,
                            s,
                            0x[..first(lb - 7, tb), ..u],
                            proved())
                    end
                | false => match lb < 7 | false => ih(l - 7, proved())(lb - 7, proved()) end
                end,
        la)(
        lb,
        under);

-- Of two first bytes of one rank, the one of the lower top is below the other, whatever follows each.
let first_tops(
    la: Nat,
    ta: Nat,
    lb: Nat,
    tb: Nat,
    s: Bytes,
    u: Bytes,
    @fa: Bool/Holds(ta < 16),
    @fb: Bool/Holds(tb < 16),
    ranks: Bool/Holds(la == lb),
    under: Bool/Holds(ta < tb),
) -> Bool/Holds(Bytes/ord/below(0x[..first(la, ta), ..s], 0x[..first(lb, tb), ..u])) =
    Nat/descend(
        (m: Nat) => m,
        (l) =>
            (lb: Nat, ranks: Bool/Holds(l == lb)) -> Bool/Holds(
                Bytes/ord/below(0x[..first(l, ta), ..s], 0x[..first(lb, tb), ..u])),
        (l, ih) =>
            (lb, ranks) =>
                match l < 7
                | true =>
                    match lb < 7
                    | true =>
                        Bytes/ord/below/of_heads(
                            Nat/to_byte(0x80 + 16 * l + ta),
                            Nat/to_byte(0x80 + 16 * lb + tb),
                            s,
                            u,
                            proved())
                    end
                | false =>
                    match lb < 7
                    | false =>
                        ih(l - 7, proved())(
                            lb - 7,
                            Eq/subst(
                                (v: Nat) => Bool/Holds(l - 7 == v - 7),
                                proved(@Eq()(l, lb)),
                                Bool/True/qed()))
                    end
                end,
        la)(
        lb,
        ranks);

-- Two first bytes of one rank and one top are one, so what follows them decides.
let first_same(
    la: Nat,
    ta: Nat,
    lb: Nat,
    tb: Nat,
    s: Bytes,
    u: Bytes,
    @fa: Bool/Holds(ta < 16),
    @fb: Bool/Holds(tb < 16),
    ranks: Bool/Holds(la == lb),
    tops: Bool/Holds(ta == tb),
    parted: Bool/Holds(Bytes/ord/below(s, u)),
) -> Bool/Holds(Bytes/ord/below(0x[..first(la, ta), ..s], 0x[..first(lb, tb), ..u])) =
    Nat/descend(
        (m: Nat) => m,
        (l) =>
            (lb: Nat, ranks: Bool/Holds(l == lb)) -> Bool/Holds(
                Bytes/ord/below(0x[..first(l, ta), ..s], 0x[..first(lb, tb), ..u])),
        (l, ih) =>
            (lb, ranks) =>
                match l < 7
                | true =>
                    match lb < 7
                    | true =>
                        Eq/subst(
                            (o: Ordering) =>
                                Bool/Holds(
                                    match o
                                    | eq() => Bytes/ord/below(s, u)
                                    | lt() => true
                                    | gt() => false
                                    end),
                            Eq/sym(
                                Ord/of_eq(
                                    0x80 + 16 * l + ta,
                                    0x80 + 16 * lb + tb,
                                    Nat/le/antisym(
                                        0x80 + 16 * l + ta,
                                        0x80 + 16 * lb + tb,
                                        proved(),
                                        proved()))),
                            parted)
                    end
                | false =>
                    match lb < 7
                    | false =>
                        ih(l - 7, proved())(
                            lb - 7,
                            Eq/subst(
                                (v: Nat) => Bool/Holds(l - 7 == v - 7),
                                proved(@Eq()(l, lb)),
                                Bool/True/qed()))
                    end
                end,
        la)(
        lb,
        ranks);

-- Of two numbers of one rank and one top, the smaller's bytes are below the larger's.
let tails(
    a: Nat,
    b: Nat,
    under: Bool/Holds(a < b),
    ranks: Bool/Holds(rank(a) == rank(b)),
    tops: Bool/Holds(top(a) == top(b)),
) -> Bool/Holds(Bytes/ord/below(rest(a), rest(b))) =
    Nat/descend(
        (m: Nat) => m,
        (m) =>
            (
                b: Nat,
                under: Bool/Holds(m < b),
                ranks: Bool/Holds(rank(m) == rank(b)),
                tops: Bool/Holds(top(m) == top(b))) -> Bool/Holds(
                Bytes/ord/below(rest(m), rest(b))),
        (m, ih) =>
            (b, under, ranks, tops) =>
                match m < 16
                | true =>
                    match b < 16
                    | false => match ranks end
                    end
                | false =>
                    match
                    | b < 16 => match proved(@Bool/False) end
                    | m / 256 < b / 256 =>
                        Bytes/ord/below/onto(
                            rest(m / 256),
                            rest(b / 256),
                            0x[Nat/to_byte(m % 256)],
                            0x[Nat/to_byte(b % 256)],
                            ih(m / 256, proved())(b / 256, Bool/True/qed(), proved(), tops))
                    | _ =>
                        Eq/subst(
                            (q: Nat) =>
                                Bool/Holds(
                                    Bytes/ord/below(
                                        0x[..rest(m / 256), Nat/to_byte(m % 256)],
                                        0x[..rest(q), Nat/to_byte(b % 256)])),
                            Nat/le/antisym(m / 256, b / 256, proved(), proved()),
                            Bytes/ord/below/past(
                                rest(m / 256),
                                0x[Nat/to_byte(m % 256)],
                                0x[Nat/to_byte(b % 256)],
                                Bytes/ord/below/of_heads(
                                    Nat/to_byte(m % 256),
                                    Nat/to_byte(b % 256),
                                    0x[],
                                    0x[],
                                    proved())))
                    end
                end,
        a)(
        b,
        under,
        ranks,
        tops);

-- Two numbers each at most the other are equal, as the decision an arithmetic fact is read from.
let level(x: Nat, y: Nat, le: Bool/Holds(x <= y), ge: Bool/Holds(y <= x)) -> Bool/Holds(x == y) =
    Eq/subst((v: Nat) => Bool/Holds(x == v), Nat/le/antisym(x, y, le, ge), Bool/True/qed());

-- An encoding read as its first byte and then its bytes, on both sides of a comparison.
let split(
    a: Nat,
    b: Nat,
    parted: Bool/Holds(
        Bytes/ord/below(
            0x[..first(rank(a), top(a), @top_below(a)), ..rest(a)],
            0x[..first(rank(b), top(b), @top_below(b)), ..rest(b)])),
) -> Bool/Holds(Bytes/ord/below(hash(a), hash(b))) =
    Eq/subst(
        (z: Bytes) => Bool/Holds(Bytes/ord/below(z, hash(b))),
        Eq/sym(from_count(a, 0)),
        Eq/subst(
            (z: Bytes) =>
                Bool/Holds(
                    Bytes/ord/below(0x[..first(rank(a), top(a), @top_below(a)), ..rest(a)], z)),
            Eq/sym(from_count(b, 0)),
            parted));

--- `a < b` gives `a`'s encoding below `b`'s at a byte: by their first bytes where the ranks or the tops differ, and by the bytes after them where both agree.
pub let of_lt(
    a: Nat,
    b: Nat,
    under: Bool/Holds(a < b),
) -> Bool/Holds(Bytes/ord/below(hash(a), hash(b))) =
    let top_a: Bool/Holds(top(a) < 16) = top_below(a);
    let top_b: Bool/Holds(top(b) < 16) = top_below(b);
    let ranks: Bool/Holds(rank(a) <= rank(b)) = rank_mono(a, b, proved());
    split(
        a,
        b,
        match rank(a) < rank(b)
        | true => first_ranks(rank(a), top(a), rank(b), top(b), rest(a), rest(b), Bool/True/qed())
        | false =>
            let same_rank: Bool/Holds(rank(a) == rank(b)) =
                level(rank(a), rank(b), ranks, proved());
            let tops: Bool/Holds(top(a) <= top(b)) = top_mono(a, b, proved(), same_rank);
            match top(a) < top(b)
            | true =>
                first_tops(
                    rank(a),
                    top(a),
                    rank(b),
                    top(b),
                    rest(a),
                    rest(b),
                    proved(),
                    Bool/True/qed())
            | false =>
                let same_top: Bool/Holds(top(a) == top(b)) = level(top(a), top(b), tops, proved());
                first_same(
                    rank(a),
                    top(a),
                    rank(b),
                    top(b),
                    rest(a),
                    rest(b),
                    proved(),
                    proved(),
                    tails(a, b, under, proved(), proved()))
            end
        end);

--- The order of two numbers is the order of their encodings.
pub let monotone(a: Nat, b: Nat) -> Eq()(Nat/ord(a, b), Bytes/ord(hash(a), hash(b))) =
    match
    | a < b => Eq/sym(Bytes/ord/below/lt(hash(a), hash(b), of_lt(a, b, Bool/True/qed())))
    | b < a =>
        Eq/trans(
            Ord/of_gt(a, b, Bool/True/qed()),
            Eq/sym(
                Eq/trans(
                    Ord/flips(hash(b), hash(a)),
                    Eq/cong(
                        Ordering/flip,
                        Bytes/ord/below/lt(hash(b), hash(a), of_lt(b, a, Bool/True/qed()))))))
    | _ =>
        Eq/subst(
            (y: Nat) => Eq()(Nat/ord(a, y), Bytes/ord(hash(a), hash(y))),
            Nat/le/antisym(a, b, proved(), proved()),
            Eq/sym(Ord/refl(hash(a))))
    end;

--- An encoding leads with a byte in the upper half: the one byte `0x7F` is below every encoding, which is what leaves the lower half to the complements an integer below zero is written as.
pub let leads(n: Nat) -> Bool/Holds(Bytes/ord/below(0x[0x7F], hash(n))) =
    let fits: Bool/Holds(top(n) < 16) = top_below(n);
    Eq/subst(
        (z: Bytes) => Bool/Holds(Bytes/ord/below(0x[0x7F], z)),
        Eq/sym(from_count(n, 0)),
        match rank(n) < 7
        | true =>
            Bytes/ord/below/of_heads(
                0x7F,
                Nat/to_byte(0x80 + 16 * rank(n) + top(n)),
                0x[],
                rest(n),
                proved())
        | false =>
            Bytes/ord/below/of_heads(
                0x7F,
                0xFF,
                0x[],
                0x[..first(rank(n) - 7, top(n)), ..rest(n)],
                Bool/True/qed())
        end);
