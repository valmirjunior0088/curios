pub use /sys/Nat/{shl};

use /std/{Nat, Eq};
use /std/Bool/{Holds};

--- A shift by `i` is a shift by `i - j` and then by `j`, where `j <= i`.
---
--- It aligns two magnitudes held at different counts: written as shifts by the smaller count, the shifted values compare as the originals do, which the elaborator proves from the facts in scope. Conversion splits a count that is a sum, but `i` is `j + (i - j)` only under the hypothesis.
pub let split(
    x: Nat,
    i: Nat,
    j: Nat,
    fits: Holds(j <= i),
) -> Eq()(shl(x, i), shl(shl(x, i - j), j)) =>
    Eq/cong((count: Nat) => shl(x, count), Eq/sym(Nat/le/add_sub_cancel(j, i, fits)));
