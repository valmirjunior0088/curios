--- Two constructors ordered by declaration position, with the laws of that order.
pub mod by_tag;
pub use by_tag/{let by_tag};

use /std/{List, Bool, Eq, Ordering};
use /std/ops/{Eql};
use /std/Bool/{True, Holds};

--- A total order: `ord` decides `lt`, `eq` or `gt`, and `Eql` is its superclass. `<` and `<=` dispatch through `lt` and `le`, and `>` and `>=` through them with their operands swapped.
---
--- A witness proves the order's laws beside its methods, so `<` is a total order wherever a type has one: `ord` flips with its operands, carries across a middle element, and answers `eq` only at one value, and `lt` and `le` are what `ord` answers. A type whose comparison is no total order, as `Flt`'s is none, has no witness and names its comparisons.
pub concept Ord(A: Type): pub Type {
    use Eql(A),
    ord(A, A) -> Ordering,
    --- Whether the first is below the second: a method of its own, so a carrier states the comparison its bounds are read in.
    lt(A, A) -> Bool,
    --- Whether the first is below the second or equal to it.
    le(A, A) -> Bool,
    --- `ord` answers the flipped answer with its operands swapped: [`Flips`] of `ord`.
    flips(a: A, b: A) -> Eq()(ord(b, a), Ordering/flip(ord(a, b))),
    --- `ord` carries across a middle element: [`Trans`] of `ord` as a relation.
    trans(
        a: A,
        b: A,
        c: A,
        Holds(Ordering/is_le(ord(a, b))),
        Holds(Ordering/is_le(ord(b, c)))) -> Holds(Ordering/is_le(ord(a, c))),
    --- Two values `ord` answers `eq` at are one.
    eq(a: A, b: A, h: Eq()(ord(a, b), Ordering/eq())) -> Eq()(a, b),
    --- `lt` is `ord` answering `lt`.
    is_lt(a: A, b: A) -> Eq()(lt(a, b), Ordering/is_lt(ord(a, b))),
    --- `le` is `ord` answering `lt` or `eq`.
    is_le(a: A, b: A) -> Eq()(le(a, b), Ordering/is_le(ord(a, b))),
}

pub use Ord/*;

--- The first answer that is not `eq`, or `eq` where they all agree.
pub let lexicographic(pieces: List(Ordering)) -> Ordering =
    List/fold(pieces, Ordering/eq(), (piece, acc) => Ordering/then(acc, piece));

--- The law that `ord` answers the flipped answer with its operands swapped: `gt` one way exactly where `lt` the other, and `eq` both ways or neither.
---
--- `Ord` carries it of its own `ord` ([`flips`]); a theorem over a comparator it is handed takes it as a hypothesis.
pub let Flips(@T: Type, ord: (T, T) -> Ordering) -> Prop =
    (a: T, b: T) -> Eq()(ord(b, a), Ordering/flip(ord(a, b)));

--- The law that `le` carries across a middle element.
pub let Trans(@T: Type, le: (T, T) -> Bool) -> Prop =
    (a: T, b: T, c: T, Holds(le(a, b)), Holds(le(b, c))) -> Holds(le(a, c));

--- `ord` as a relation: what it does not answer `gt` at.
pub let le_by(@T: Type, ord: (T, T) -> Ordering) -> (T, T) -> Bool =
    (a, b) => Ordering/is_le(ord(a, b));

--- `ord` as a strict relation: what it answers `lt` at.
pub let lt_by(@T: Type, ord: (T, T) -> Ordering) -> (T, T) -> Bool =
    (a, b) => Ordering/is_lt(ord(a, b));

--- `ord`, and `second` among what `ord` ties: the relation that holds where `ord` answers `lt`, and where it answers `eq` and `second` holds.
---
--- At a `second` that always holds it is `le_by(ord)`. It is the order two sorts in a row leave a list in, the later sort's comparator first.
pub let then(@T: Type, ord: (T, T) -> Ordering, second: (T, T) -> Bool) -> (T, T) -> Bool =
    (a, b) =>
        match ord(a, b)
        | lt() => true
        | eq() => second(a, b)
        | gt() => false
        end;

-- By cases on the three answers. Two that tie are one value, so the third answer is the other's; two that are `lt` leave the third `lt`, since `eq` there would make the second the first's flip, and `gt` is what [`trans`] rules out. It takes the three values and nothing else: a law that recurses through its witness hands this the witness, and the witness's laws are applied here at parameters alone.
--- The answers of one order at `p` and `q`, at `q` and `r`, and at `p` and `r` chain ([`Ordering/chains`]).
pub let chains(
    @T: Type,
    use Ord(T),
    p: T,
    q: T,
    r: T,
) -> Holds(Ordering/chains(ord(p, q), ord(q, r), ord(p, r))) =
    match ord(p, q)
    | lt() =>
        match ord(q, r)
        | lt() =>
            match ord(p, r)
            | lt() => True/qed()
            | eq() =>
                let refl() = eq(p, r, Eq/refl());
                match flips(p, q) end
            | gt() => match trans(p, q, r, True/qed(), True/qed()) end
            end
        | eq() =>
            let refl() = eq(q, r, Eq/refl());
            True/qed()
        | gt() => True/qed()
        end
    | eq() =>
        let refl() = eq(p, q, Eq/refl());
        Ordering/chains/tied(ord(p, r))
    | gt() => True/qed()
    end;

-- Of the three answers `eq` alone is its own flip.
--- A value is `eq` to itself in its order.
pub let refl(@T: Type, use Ord(T), a: T) -> Eq()(ord(a, a), Ordering/eq()) =
    match ord(a, a)
    | lt() => match flips(a, a) end
    | eq() => Eq/refl()
    | gt() => match flips(a, a) end
    end;

--- `ord` answers `eq` at two values that are one.
pub let of_eq(@T: Type, use Ord(T), a: T, b: T, e: Eq()(a, b)) -> Eq()(ord(a, b), Ordering/eq()) =
    Eq/subst((x: T) => Eq()(ord(a, x), Ordering/eq()), e, refl(a));

--- `ord` answers `lt` where the first is below the second.
pub let of_lt(@T: Type, use Ord(T), a: T, b: T, p: Holds(a < b)) -> Eq()(ord(a, b), Ordering/lt()) =
    match ord(a, b)
    | lt() => Eq/refl()
    | eq() | gt() => match Eq/subst((x: Bool) => Holds(x), is_lt(a, b), p) end
    end;

--- `ord` answers `gt` where the second is below the first.
pub let of_gt(@T: Type, use Ord(T), a: T, b: T, p: Holds(b < a)) -> Eq()(ord(a, b), Ordering/gt()) =
    Eq/trans(flips(b, a), Eq/cong(Ordering/flip, of_lt(b, a, p)));

--- The first is below the second where `ord` answers `lt`.
pub let below(@T: Type, use Ord(T), a: T, b: T, h: Eq()(ord(a, b), Ordering/lt())) -> Holds(a < b) =
    Eq/subst(
        (x: Bool) => Holds(x),
        Eq/sym(Eq/trans(is_lt(a, b), Eq/cong(Ordering/is_lt, h))),
        True/qed());

--- The second is below the first where `ord` answers `gt`.
pub let above(@T: Type, use Ord(T), a: T, b: T, h: Eq()(ord(a, b), Ordering/gt())) -> Holds(b < a) =
    below(b, a, Eq/trans(flips(a, b), Eq/cong(Ordering/flip, h)));
