--- A column and a row of a view, where the terminal's cursor is asked for.
pub mod Point;
pub use Point/{let Point};

use /std/{Nat, Str, Option};
use /std/Tui/{Style, Glyph, Line};

--- What a terminal shows, as a description every reading folds over (what it draws, `Frame/of_view`, and where it puts the cursor, `cursor`), so the two cannot disagree.
pub induct View: pub Type
--- `w` by `h` of one glyph in `style`.
| filled(glyph: Glyph, style: Style, w: Nat, h: Nat)
--- A line in `style`, as wide as its glyphs.
| line(style: Style, l: Line)
--- `left` then `right`, left to right, the shorter padded to the taller.
| beside(left: View, right: View)
--- `top` then `bottom`, top to bottom, the narrower padded to the wider.
| above(top: View, bottom: View)
--- `inner` at `w` by `h`: cropped where it overflows, padded with blanks where it falls short.
| sized(inner: View, w: Nat, h: Nat)
--- `inner` from column `x` and row `y` on.
| crop(inner: View, x: Nat, y: Nat)
--- `top` painted onto `base` with its upper-left corner at `x`, `y`, clipped to `base`.
| over(base: View, top: View, x: Nat, y: Nat)
--- `inner` with every style it draws in passed through `f`.
| styled(f: (Style) -> Style, inner: View)
--- `inner`, asking for the terminal's cursor at `at`.
| with_cursor(inner: View, at: Point)
end

pub use View/*;

--- How many columns `v` takes.
pub let width(v: View) -> Nat =
    match v
    | filled(_, _, w, _) => w
    | line(_, l) => Line/width(l)
    | beside(left, right) => width(left) + width(right)
    | above(top, bottom) => Nat/max(width(top), width(bottom))
    | sized(_, w, _) => w
    | crop(inner, x, _) => width(inner) - x
    | over(base, _, _, _) => width(base)
    | styled(_, inner) => width(inner)
    | with_cursor(inner, _) => width(inner)
    end;

--- How many rows `v` takes.
pub let height(v: View) -> Nat =
    match v
    | filled(_, _, _, h) => h
    | line(_, _) => 1
    | beside(left, right) => Nat/max(height(left), height(right))
    | above(top, bottom) => height(top) + height(bottom)
    | sized(_, _, h) => h
    | crop(inner, _, y) => height(inner) - y
    | over(base, _, _, _) => height(base)
    | styled(_, inner) => height(inner)
    | with_cursor(inner, _) => height(inner)
    end;

--- `w` by `h` of blanks.
pub let blank(w: Nat, h: Nat) -> View =
    View/filled(Glyph/space, Style/plain, w, h);

--- `s` as one line in `style`, every character it holds shown, as `Line/of_str` shows it.
pub let text(style: Style, s: Str) -> View =
    View/line(style, Line/of_str(s));

--- A view of exactly `w` by `h`, built by `fit`: what a pane answers for the room it is given.
pub struct Sized(w: Nat, h: Nat): Type {
    view: View,
}

--- `v` at `w` by `h`, cropped where it overflows and padded with blanks where it falls short.
pub let fit(v: View, w: Nat, h: Nat) -> Sized(w, h) =
    Sized(w, h) { view = View/sized(v, w, h) };

--- What `s` shows.
pub let shown(@w: Nat, @h: Nat, s: Sized(w, h)) -> View =
    s.view;

-- `p`, moved by `dx` and `dy`.
let shifted(p: Point, dx: Nat, dy: Nat) -> Point =
    Point { x = p.x + dx, y = p.y + dy };

-- The first of the two that holds a value.
let either(@A: Type, first: Option(A), second: Option(A)) -> Option(A) =
    match first | some(_) => first | none() => second end;

--- Where `v` asks for the terminal's cursor, or `none`. A request belongs to the view it is made over; an overlay's wins over its base's, and of two views beside or above each other, the later one's is taken.
pub let cursor(v: View) -> Option(Point) =
    match v
    | filled(_, _, _, _) | line(_, _) => Option/none()
    | beside(left, right) =>
        either(Option/map(cursor(right), (p) => shifted(p, width(left), 0)), cursor(left))
    | above(top, bottom) =>
        either(Option/map(cursor(bottom), (p) => shifted(p, 0, height(top))), cursor(top))
    | sized(inner, _, _) | styled(_, inner) => cursor(inner)
    | crop(inner, x, y) =>
        Option/bind(
            cursor(inner),
            (p) =>
                match x <= p.x && y <= p.y
                | true => Option/some(Point { x = p.x - x, y = p.y - y })
                | false => Option/none()
                end)
    | over(base, top, x, y) =>
        either(Option/map(cursor(top), (p) => shifted(p, x, y)), cursor(base))
    | with_cursor(_, at) => Option/some(at)
    end;
