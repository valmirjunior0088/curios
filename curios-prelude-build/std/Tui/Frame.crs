use /std/{Nat, Str, List, Vec, Option, proved};
use /std/Tui/{Style, Glyph, Line, Tile, View};
use /std/Bool/{Holds};

--- `h` rows of `w` tiles: what a view is drawn as, and what the renderer compares from one frame to the next.
pub let Frame(w: Nat, h: Nat) -> Type =
    Vec(Vec(Tile, w), h);

-- Pad with `fill` or cut, whichever the count calls for: fitting a frame into a box is this at both axes.
let padded(@T: Type, fill: T, m: Nat) -> (List(T)) -> List(T) =
    match m
    | 0 => (_) => []
    | k + 1 =>
        (l) =>
            match l
            | [] => [fill, ..padded(fill, k)([])]
            | [h, ..t] => [h, ..padded(fill, k)(t)]
            end
    end;

-- Either arm adds exactly one element to a run the shorter padding already counted, so the count is the one asked for whatever the input was.
let padded_length(@T: Type, fill: T, m: Nat) -> (l: List(T)) -> Vec/Counted(padded(fill, m)(l), m) =
    match m
    | 0 => (_) => proved()
    | k + 1 =>
        (l) =>
            match l
            | [] =>
                let shorter = padded_length(fill, k)([]);
                proved()
            | [_, ..t] =>
                let shorter = padded_length(fill, k)(t);
                proved()
            end
    end;

-- The elements at exactly `m`, which is where a frame's index is re-established after a list has carried it.
let resize(@T: Type, fill: T, m: Nat, l: List(T)) -> Vec(T, m) =
    Vec { list = padded(fill, m)(l), @counted = padded_length(fill, m)(l) };

let drop_upto(@T: Type, l: List(T), k: Nat) -> List(T) =
    match k
    | 0 => l
    | j + 1 => match drop_upto(l, j) | [] => [] | [_, ..rest] => rest end
    end;

-- What a run of tiles keeps of its wide glyphs: a wide glyph keeps its second column and that column its glyph, and a cut that parted the two shows a blank where either stood. Every tile answers one, so the run keeps its length.
let mended(row: List(Tile)) -> List(Tile) =
    let blank: Tile = Tile/blank;
    let start: {done: List(Tile), waiting: Option(Tile)} = (done = [], waiting = Option/none());
    let settled =
        List/fold(row, start, (tile, acc) =>
            let done =
                match acc.waiting
                | some(_) => [blank, ..acc.done]
                | none() => acc.done
                end;
            match tile
            | continuation() =>
                match acc.waiting
                | some(wide) => (done = [tile, wide, ..acc.done], waiting = Option/none())
                | none() => (done = [blank, ..acc.done], waiting = Option/none())
                end
            | glyph(g, _) =>
                match Glyph/width(g) == 2
                | true => (done = done, waiting = Option/some(tile))
                | false => (done = [tile, ..done], waiting = Option/none())
                end
            end);
    List/reverse(
        match settled.waiting
        | some(_) => [blank, ..settled.done]
        | none() => settled.done
        end);

-- A row of exactly `w` tiles from `tiles`, cut or padded with blanks, its wide glyphs mended where the cut parted one.
let row(w: Nat, tiles: List(Tile)) -> List(Tile) =
    mended(padded(Tile/blank, w)(tiles));

-- `row`, its length carried in its type.
let row_of(w: Nat, tiles: List(Tile)) -> Vec(Tile, w) =
    resize(Tile/blank, w, row(w, tiles));

-- `rows` at exactly `w` by `h`: each row cut or padded, and rows of blanks beneath where they fall short.
let boxed(rows: List(List(Tile)), w: Nat, h: Nat) -> List(List(Tile)) =
    padded(row(w, []), h)(List/map(rows, (r) => row(w, r)));

-- `top`'s rows spliced into `base`'s from column `x` and row `y`, each row of `base` keeping its length.
let overlaid(base: List(List(Tile)), top: List(List(Tile)), x: Nat, y: Nat) -> List(List(Tile)) =
    List/map(
        List/zip(List/range(0, List/length(base)), base),
        (r: {Nat, List(Tile)}) =>
            match y <= r.0
            | false => r.1
            | true =>
                match List/try_get(top, r.0 - y)
                | none() => r.1
                | some(patch) =>
                    row(
                        List/length(r.1),
                        List/flatten([
                            List/take(r.1, x),
                            patch,
                            drop_upto(r.1, x + List/length(patch))]))
                end
            end);

-- `tile` with its style passed through `f`.
let restyled(f: (Style) -> Style, tile: Tile) -> Tile =
    match tile
    | glyph(g, s) => Tile/glyph(g, f(s))
    | continuation() => tile
    end;

-- `v` drawn as rows of tiles: `View/height(v)` rows of `View/width(v)` tiles each.
let drawn(v: View) -> List(List(Tile)) =
    match v
    | filled(g, style, fw, fh) =>
        List/replicate(fh, row(fw, List/flatten(List/replicate(fw, Tile/of_glyph(g, style)))))
    | line(style, l) =>
        [row(Line/width(l), List/flatten(List/map(l.glyphs, (g) => Tile/of_glyph(g, style))))]
    | beside(left, right) =>
        let tall = View/height(v);
        List/map(
            List/zip(
                boxed(drawn(left), View/width(left), tall),
                boxed(drawn(right), View/width(right), tall)),
            (r) => [..r.0, ..r.1])
    | above(top, bottom) =>
        let wide = View/width(v);
        [
            ..boxed(drawn(top), wide, View/height(top)),
            ..boxed(drawn(bottom), wide, View/height(bottom))]
    | sized(inner, fw, fh) => boxed(drawn(inner), fw, fh)
    | crop(inner, x, y) => List/map(drop_upto(drawn(inner), y), (r) => drop_upto(r, x))
    | over(base, top, x, y) => overlaid(drawn(base), drawn(top), x, y)
    | styled(f, inner) => List/map(drawn(inner), (r) => List/map(r, (tile) => restyled(f, tile)))
    | with_cursor(inner, _) => drawn(inner)
    end;

--- `s` drawn: the tiles every reading of a view agrees on.
pub let of_view(@w: Nat, @h: Nat, s: View/Sized(w, h)) -> Frame(w, h) =
    resize(row_of(w, []), h, List/map(drawn(View/shown(s)), (r) => row_of(w, r)));

--- `w` by `h` of blanks.
pub let blank(w: Nat, h: Nat) -> Frame(w, h) =
    resize(row_of(w, []), h, []);

--- The frame as text, one string per row. A continuation contributes nothing, so a wide glyph reads back as itself.
pub let to_lines(@w: Nat, @h: Nat, frame: Frame(w, h)) -> List(Str) =
    List/map(frame.list, (r) =>
        Str/flatten(
            List/map(r.list, (tile) =>
                match tile | glyph(g, _) => Glyph/text(g) | continuation() => "" end)));

--- The tile at `x`, `y`, under the evidence that both are within the frame.
pub let get(
    @w: Nat,
    @h: Nat,
    frame: Frame(w, h),
    x: Nat,
    y: Nat,
    @ok_x: Holds(x < w),
    @ok_y: Holds(y < h),
) -> Tile =
    let row = List/get(frame.list, y);
    List/get(row.list, x);
