use /std/{Nat, Str, Bool, List, Option};
use /std/Tui/{Style, View, Pane, Key};
use /std/Bool/{Holds};

--- Items of any type, one selected when there are any, and the first one shown: when the selection leaves the visible rows, they scroll just enough to bring it back, and a move within them leaves them still.
pub struct Listing(A: Type): pub Type {
    items: List(A),
    --- The selected item, none where there are no items.
    cursor: Option({i: Nat, ok: Holds(i < List/length(items))}),
    --- The first item shown.
    first: Nat,
}

let at(@A: Type, items: List(A), i: Nat) -> Option({i: Nat, ok: Holds(i < List/length(items))}) =
    match Bool/holds(i < List/length(items))
    | none() => Option/none()
    | some(ok) => Option/some((i = i, ok = ok))
    end;

--- `items` with the first selected and shown first.
pub let new(@A: Type, items: List(A)) -> Listing(A) =
    Listing { items = items, cursor = at(items, 0), first = 0 };

--- The selected index, or `none`.
pub let index(@A: Type, l: Listing(A)) -> Option(Nat) =
    Option/map(l.cursor, (c) => c.i);

--- The selected item, or `none`.
pub let selected(@A: Type, l: Listing(A)) -> Option(A) =
    Option/map(l.cursor, (c) => List/get(@A, l.items, c.i, @c.ok));

-- The first row shown once `i` is selected among `rows` of them: `first`, moved as little as keeps `i` among them.
let kept(first: Nat, i: Nat, rows: Nat) -> Nat =
    match
    | i < first => i
    | first + rows <= i => i + 1 - rows
    | _ => first
    end;

--- What `k` does to the listing shown `rows` high: up and down move the selection an item, page up and page down a page, home and end to either end, and the rows shown scroll so the selection stays among them. A move past either end goes no further than the end; a key with a modifier, and any other, leaves the listing.
pub let handle(@A: Type, l: Listing(A), k: Key, rows: Nat) -> Listing(A) =
    match l.cursor
    | none() => l
    | some(c) =>
        let last = List/length(l.items) - 1;
        let to(i: Nat) -> Listing(A) =
            match at(l.items, i)
            | none() => l
            | some(next) =>
                Listing {
                    items = l.items,
                    cursor = Option/some(next),
                    first = kept(l.first, i, rows) }
            end;
        match k.shift || k.alt || k.ctrl || k.super
        | true => l
        | false =>
            match k.code
            | up() => match c.i | 0 => l | p + 1 => to(p) end
            | down() => to(c.i + 1)
            | page_up() => to(c.i - rows)
            | page_down() => to(Nat/min(c.i + rows, last))
            | home() => to(0)
            | end_key() => to(last)
            | _ => l
            end
        end
    end;

--- The items as rows, each as `show` writes it, the selected one in `highlight`, from the listing's first shown row, moved as little as keeps the selection visible at the given height. With nothing selected, no row is highlighted.
pub let view(@A: Type, l: Listing(A), show: (A) -> Str, style: Style, highlight: Style) -> Pane =
    (w, h) =>
        let chosen = index(l);
        let first =
            match chosen | some(i) => kept(l.first, i, h) | none() => l.first end;
        let shown =
            List/take(
                List/drop_while(
                    List/zip(List/range(0, List/length(l.items)), l.items),
                    (e) => e.0 < first),
                h);
        let row(entry: {Nat, A}) -> View =
            let s =
                match chosen == Option/some(entry.0)
                | true => highlight
                | false => style
                end;
            View/sized(View/text(s, show(entry.1)), w, 1);
        let stacked = List/fold(List/reverse(List/map(shown, row)), View/blank(w, 0), View/above);
        View/fit(stacked, w, h);
