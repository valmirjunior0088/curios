use /std/{Nat, Bool, Byte, Str, Bytes, List, Vec, Option};
use /std/Tui/{Style, Glyph, Tile, Frame, View, Mode, ansi};

struct Pen: Type {
    out: Bytes,
    style: Option(Style),
    at: Option({Nat, Nat}),
}

-- Whether every terminal agrees on how far `text` moves the cursor: text of ASCII alone.
let agreed(text: Bytes) -> Bool =
    Bytes/all(text, (b) => Byte/to_nat(b) < 0x80);

-- The pen once `tile` is written at `x`, `y`, unless it is what `before` shows there. After a glyph whose width terminals may disagree on the pen forgets where it stands, so the next tile it writes moves there first: a terminal that measures a glyph otherwise misplaces that glyph alone.
let paint(pen: Pen, x: Nat, y: Nat, tile: Tile, before: Option(Tile)) -> Pen =
    match before == Option/some(tile)
    | true => pen
    | false =>
        match tile
        | continuation() => pen
        | glyph(g, style) =>
            let there = match pen.at | some(p) => p.0 == x && p.1 == y | none() => false end;
            let move = match there | true => 0x[] | false => ansi/move_to(x, y) end;
            let kept = match pen.style | some(s) => s == style | none() => false end;
            let sgr = match kept | true => 0x[] | false => ansi/sgr(style) end;
            let text = Str/to_bytes(Glyph/text(g));
            Pen {
                out = 0x[..pen.out, ..move, ..sgr, ..text],
                style = Option/some(style),
                at =
                    match agreed(text)
                    | true => Option/some((x + Glyph/width(g), y))
                    | false => Option/none()
                    end }
        end
    end;

let paint_row(@w: Nat, pen: Pen, y: Nat, row: Vec(Tile, w), before: Option(Vec(Tile, w))) -> Pen =
    let tiles = List/zip(List/range(0, w), row.list);
    let previous =
        match before
        | some(b) => List/map(b.list, Option/some)
        | none() => List/replicate(w, Option/none())
        end;
    List/fold(
        List/zip(tiles, previous),
        pen,
        (entry, acc) => paint(acc, entry.0.0, y, entry.0.1, entry.1));

--- The bytes that take the terminal from `previous` to `next`: tiles written only where they differ, inside one synchronized update where `synchronized` says the terminal shows one whole, and the cursor placed at `cursor` where it stands within the frame, and hidden otherwise. With no previous frame the screen is cleared and every tile written.
pub let render(
    @w: Nat,
    @h: Nat,
    previous: Option(Frame(w, h)),
    next: Frame(w, h),
    cursor: Option(View/Point),
    synchronized: Bool,
) -> Bytes =
    let bracket(b: Bytes) -> Bytes = match synchronized | true => b | false => 0x[] end;
    let clear = match previous | some(_) => 0x[] | none() => ansi/clear end;
    let rows = List/zip(List/range(0, h), next.list);
    let before =
        match previous
        | some(p) => List/map(p.list, Option/some)
        | none() => List/replicate(h, Option/none())
        end;
    let start =
        Pen {
            out = 0x[..bracket(ansi/on(Mode/synchronized_output())), ..ansi/cursor_hide, ..clear],
            style = Option/none(),
            at = Option/none() };
    let painted =
        List/fold(
            List/zip(rows, before),
            start,
            (entry, acc) => paint_row(acc, entry.0.0, entry.0.1, entry.1));
    let place =
        match cursor
        | some(c), c.x < w && c.y < h => 0x[..ansi/move_to(c.x, c.y), ..ansi/cursor_show]
        | _ => 0x[]
        end;
    0x[..painted.out, ..ansi/reset, ..place, ..bracket(ansi/off(Mode/synchronized_output()))];
