use /std/{Nat, Byte, Bytes, Bool, Eq, Ordering, proved};
use /std/ops/{Ord};
use /std/Bool/{True, Holds};

--- Whether `a` and `b` part at a byte where `a`'s is the smaller, neither running out before it.
---
--- It is `ord`'s `lt` decided at a byte rather than by one run ending first, so it holds whatever follows either run. That is what one value's encoding must guarantee against another's where encodings are concatenated, and what complementing every byte reverses.
pub let below(a: Bytes, b: Bytes) -> Bool =
    match a
    | 0x[] => false
    | 0x[h, ..t] =>
        match b
        | 0x[] => false
        | 0x[k, ..r] =>
            match Nat/ord(Byte/to_nat(h), Byte/to_nat(k))
            | eq() => below(t, r)
            | lt() => true
            | gt() => false
            end
        end
    end;

--- Two runs whose heads are in order part there.
pub let of_heads(
    h: Byte,
    k: Byte,
    t: Bytes,
    r: Bytes,
    under: Holds(h < k),
) -> Holds(below(0x[h, ..t], 0x[k, ..r])) =
    Eq/subst(
        (o: Ordering) => Holds(match o | eq() => below(t, r) | lt() => true | gt() => false end),
        Eq/sym(Ord/of_lt(Byte/to_nat(h), Byte/to_nat(k), proved())),
        True/qed());

--- A run below another at a byte is `lt` to it.
pub let lt(a: Bytes, b: Bytes, parted: Holds(below(a, b))) -> Eq()(Bytes/ord(a, b), Ordering/lt()) =
    match a
    | 0x[] => match parted end
    | 0x[h, ..t] =>
        match b
        | 0x[] => match parted end
        | 0x[k, ..r] =>
            match Nat/ord(Byte/to_nat(h), Byte/to_nat(k))
            | eq() => lt(t, r, parted)
            | lt() => Eq/refl()
            | gt() => match parted end
            end
        end
    end;

--- Two runs that part at a byte still do with anything after each.
pub let onto(
    a: Bytes,
    b: Bytes,
    s: Bytes,
    u: Bytes,
    parted: Holds(below(a, b)),
) -> Holds(below(0x[..a, ..s], 0x[..b, ..u])) =
    match a
    | 0x[] => match parted end
    | 0x[h, ..t] =>
        match b
        | 0x[] => match parted end
        | 0x[k, ..r] =>
            match Nat/ord(Byte/to_nat(h), Byte/to_nat(k))
            | eq() => onto(t, r, s, u, parted)
            | lt() => True/qed()
            | gt() => match parted end
            end
        end
    end;

--- Two runs that part at a byte still do behind a shared prefix.
pub let past(
    p: Bytes,
    a: Bytes,
    b: Bytes,
    parted: Holds(below(a, b)),
) -> Holds(below(0x[..p, ..a], 0x[..p, ..b])) =
    match p | 0x[] => parted | 0x[_, ..t] => past(t, a, b, parted) end;
