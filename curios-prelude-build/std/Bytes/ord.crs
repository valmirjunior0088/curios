--- Whether two runs part at a byte where the first's is the smaller, with the laws of what stands past that byte.
pub mod below;
pub use below/{let below};

use /std/{Nat, Byte, Bytes, Bool, Eq, Ordering, Ord, proved};

--- Bytewise, a proper prefix first.
---
--- A walk over both runs' structure, so a type may name it and its laws are recursions of the same shape.
pub let ord(a: Bytes, b: Bytes) -> Ordering =
    match a
    | 0x[] => match b | 0x[] => Ordering/eq() | _ => Ordering/lt() end
    | 0x[h, ..t] =>
        match b
        | 0x[] => Ordering/gt()
        | 0x[k, ..r] =>
            match Nat/ord(Byte/to_nat(h), Byte/to_nat(k))
            | eq() => ord(t, r)
            | lt() => Ordering/lt()
            | gt() => Ordering/gt()
            end
        end
    end;

--- `ord` answers through a shared prefix as it does past it.
pub let past(p: Bytes, a: Bytes, b: Bytes) -> Eq()(ord(0x[..p, ..a], 0x[..p, ..b]), ord(a, b)) =
    match p | 0x[] => Eq/refl() | 0x[_, ..t] => past(t, a, b) end;

-- A recursion over both runs: `ord` at two conses is a step, its heads' answer and then its tails', so both are `eq`, the heads one byte by `Ord/eq` on their values.
--- `ord(a, b)` is `eq` only where `a` is `b`: the order agrees with equality.
let eq(a: Bytes, b: Bytes, h: Eq()(ord(a, b), Ordering/eq())) -> Eq()(a, b) =
    match a
    | 0x[] =>
        match b
        | 0x[] => Eq/refl()
        | 0x[_, .._] => match h end
        end
    | 0x[x, ..t] =>
        match b
        | 0x[] => match h end
        | 0x[y, ..r] =>
            let heads = Nat/ord(Byte/to_nat(x), Byte/to_nat(y));
            let values =
                Ord/eq(Byte/to_nat(x), Byte/to_nat(y), Ordering/then/first(heads, ord(t, r), h));
            let head: Eq()(x, y) = Eq/cong((n) => Nat/to_byte(n % 256), values);
            let refl() = head;
            let refl() = eq(t, r, Ordering/then/second(heads, ord(t, r), h));
            Eq/refl()
        end
    end;

-- A recursion over both runs: where the two heads differ the answer is theirs, which `Ord/flips` flips, and where they tie it is the tails'.
--- `ord` answers the flipped answer with its operands swapped.
let flips: Ord/Flips(ord) =
    (a, b) =>
        match a
        | 0x[] => match b | 0x[] | 0x[_, .._] => Eq/refl() end
        | 0x[h, ..t] =>
            match b
            | 0x[] => Eq/refl()
            | 0x[k, ..r] =>
                let swapped = Ord/flips(Byte/to_nat(h), Byte/to_nat(k));
                match Nat/ord(Byte/to_nat(h), Byte/to_nat(k))
                | lt() =>
                    Eq/subst(
                        (o: Ordering) =>
                            Eq()(
                                match o
                                | eq() => ord(r, t)
                                | lt() => Ordering/lt()
                                | gt() => Ordering/gt()
                                end,
                                Ordering/gt()),
                        Eq/sym(swapped),
                        Eq/refl())
                | gt() =>
                    Eq/subst(
                        (o: Ordering) =>
                            Eq()(
                                match o
                                | eq() => ord(r, t)
                                | lt() => Ordering/lt()
                                | gt() => Ordering/gt()
                                end,
                                Ordering/lt()),
                        Eq/sym(swapped),
                        Eq/refl())
                | eq() =>
                    Eq/subst(
                        (o: Ordering) =>
                            Eq()(
                                match o
                                | eq() => ord(r, t)
                                | lt() => Ordering/lt()
                                | gt() => Ordering/gt()
                                end,
                                Ordering/flip(ord(t, r))),
                        Eq/sym(swapped),
                        flips(t, r))
                end
            end
        end;

-- Whether two conses whose heads answer `o` are in order: what `ord` as a relation reduces to once its heads are compared.
let after(o: Ordering, t: Bytes, r: Bytes) -> Bool =
    Ordering/is_le(
        match o
        | eq() => ord(t, r)
        | lt() => Ordering/lt()
        | gt() => Ordering/gt()
        end);

-- A recursion over the three runs: the heads' answers are `Nat/ord`'s, which carries across the middle head, and where all three heads tie the answer is the tails'.
--- `ord` as a relation carries across a middle run.
let trans: Ord/Trans(Ord/le_by(ord)) =
    (a, b, c, p, q) =>
        match a
        | 0x[] => match c | 0x[] | 0x[_, .._] => Bool/True/qed() end
        | 0x[h, ..t] =>
            match b
            | 0x[] => match p end
            | 0x[k, ..r] =>
                match c
                | 0x[] => match q end
                | 0x[j, ..s] =>
                    let (hn, kn, jn) = (Byte/to_nat(h), Byte/to_nat(k), Byte/to_nat(j));
                    match Nat/ord(hn, kn)
                    | gt() => match p end
                    | lt() =>
                        let first: Bool/Holds(hn < kn) = Ord/below(hn, kn, Eq/refl());
                        match Nat/ord(kn, jn)
                        | gt() => match q end
                        | lt() =>
                            let second: Bool/Holds(kn < jn) = Ord/below(kn, jn, Eq/refl());
                            Eq/subst(
                                (o: Ordering) => Bool/Holds(after(o, t, s)),
                                Eq/sym(Ord/of_lt(hn, jn, proved())),
                                Bool/True/qed())
                        | eq() =>
                            let second: Eq()(kn, jn) = Ord/eq(kn, jn, Eq/refl());
                            Eq/subst(
                                (o: Ordering) => Bool/Holds(after(o, t, s)),
                                Eq/sym(
                                    Ord/of_lt(
                                        hn,
                                        jn,
                                        Eq/subst((x: Nat) => Bool/Holds(hn < x), second, first))),
                                Bool/True/qed())
                        end
                    | eq() =>
                        let first: Eq()(hn, kn) = Ord/eq(hn, kn, Eq/refl());
                        match Nat/ord(kn, jn)
                        | gt() => match q end
                        | lt() =>
                            let second: Bool/Holds(kn < jn) = Ord/below(kn, jn, Eq/refl());
                            Eq/subst(
                                (o: Ordering) => Bool/Holds(after(o, t, s)),
                                Eq/sym(
                                    Ord/of_lt(
                                        hn,
                                        jn,
                                        Eq/subst(
                                            (x: Nat) => Bool/Holds(x < jn),
                                            Eq/sym(first),
                                            second))),
                                Bool/True/qed())
                        | eq() =>
                            let second: Eq()(kn, jn) = Ord/eq(kn, jn, Eq/refl());
                            Eq/subst(
                                (o: Ordering) => Bool/Holds(after(o, t, s)),
                                Eq/sym(Ord/of_eq(hn, jn, Eq/trans(first, second))),
                                trans(t, r, s, p, q))
                        end
                    end
                end
            end
        end;

satisfy Ord(Bytes) {
    ord = ord,
    lt(a, b) = Ordering/is_lt(ord(a, b)),
    le(a, b) = Ordering/is_le(ord(a, b)),
    flips = flips,
    trans = trans,
    eq = eq,
    lt_of_ord(_, _) = Eq/refl(),
    le_of_ord(_, _) = Eq/refl(),
}
