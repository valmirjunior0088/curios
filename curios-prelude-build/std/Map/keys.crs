use /std/{List, Eq, Ord, Bool};
use /std/List/{Pairwise};
use /std/Map/{Map, Key};
use /std/Map/internal/{Node};

--- The keys, in their type's own order: each is before every one after it, by [`pairwise`].
pub let keys(@K: Type, use Key(K), @V: Type, m: Map(K, V)) -> List(K) =
    Node/collect(m.root, []);

-- A map's trie is sound, so a key under a branch's twig is before every key under the twigs after it as `Bytes/ord` reads their encodings, and `Key/monotone` makes that the keys' own order. It asks nothing beyond the map's `Key(K)`.
--- The keys of a map are in strict order by their type's own order, each before every one after it.
pub let pairwise(
    @K: Type,
    use Key(K),
    @V: Type,
    m: Map(K, V),
) -> Pairwise(Ord/lt((a: K, b: K) => Ord/ord(a, b)))(keys(m)) =
    Eq/subst(
        (l: List(K)) => Pairwise(Ord/lt((a: K, b: K) => Ord/ord(a, b)))(l),
        Eq/sym(Node/collected(m.root, [])),
        Node/ascending(m.root, m.sound));

--- The keys of a map are in strict order at adjacent elements, as a decision.
pub let ordered(
    @K: Type,
    use Key(K),
    @V: Type,
    m: Map(K, V),
) -> Bool/Holds(List/ordered(keys(m), Ord/lt((a: K, b: K) => Ord/ord(a, b)))) =
    Pairwise/adjacent(Ord/lt((a: K, b: K) => Ord/ord(a, b)), keys(m), pairwise(m));
