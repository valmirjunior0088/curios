use /std/{Nat, Bool, Option, List, Vec, Eq, Hash, Bytes, Map, proved};
use /std/List/{Member};
use /std/Map/internal/{Node};
use /std/Map/digits/{digit, small, Apart};
use /std/Bool/{True, False, Holds};

--- The value at `key`, or `none`.
pub let try_get(@K: Type, use Hash/Key(K), @V: Type, m: Map(K, V), key: K) -> Option(V) =
    Node/find(m.root, Hash/hash(key));

-- Two keys the one is not the other of encode apart.
let apart_codes(
    @K: Type,
    use Hash/Key(K),
    key: K,
    other: K,
    apart: (Eq()(other, key)) -> False,
) -> Eq()(Hash/hash(key) == Hash/hash(other), false) =
    match Hash/hash(key) == Hash/hash(other)
    | false => Eq/refl()
    | true => match apart(Eq/sym(Hash/Key/inj(key, other, proved()))) end
    end;

-- What a node answering `x` at `key`'s encoding in place of `n` answers at another key's: what `n` does.
let elsewhere(
    @K: Type,
    use Hash/Key(K),
    @V: Type,
    n: Node(K, V),
    n2: Node(K, V),
    key: K,
    x: Option(V),
    other: K,
    codes: Eq()(Hash/hash(key) == Hash/hash(other), false),
    answers: Node/Answers(n2, n, Hash/hash(key), x),
) -> Eq()(Node/find(n2, Hash/hash(other)), Node/find(n, Hash/hash(other))) =
    Eq/trans(
        answers(Hash/hash(other)),
        Eq/subst(
            (b: Bool) =>
                Eq()(
                    match b | true => x | false => Node/find(n, Hash/hash(other)) end,
                    Node/find(n, Hash/hash(other))),
            Eq/sym(codes),
            Eq/refl()));

-- The leaf an insertion wedges in beside the node it parted from answers its value at its key in that node's place.
let parted_answers(
    @K: Type,
    use Hash/Key(K),
    @V: Type,
    n: Node(K, V),
    n2: Node(K, V),
    key: K,
    v: V,
    c: Nat,
    d: Nat,
    @small_d: Holds(d < 16),
    back: Eq()(n2, n),
    sound: Node/Sound(n),
    apart: Apart(Hash/hash(key), Node/first(n), c),
    past: Holds(Node/deeper(n, c)),
    at_d: Eq()(digit(Node/first(n), c), d),
) -> Node/Answers(
    Node/wedge(c, d, n2, key, Hash/hash(key), v, @small_d),
    n,
    Hash/hash(key),
    Option/some(v)) =
    Eq/subst(
        (t: Node(K, V)) =>
            Node/Answers(
                Node/wedge(c, d, t, key, Hash/hash(key), v, @small_d),
                n,
                Hash/hash(key),
                Option/some(v)),
        Eq/sym(back),
        Node/wedge_answers(
            c,
            d,
            n,
            key,
            Hash/hash(key),
            v,
            @small_d,
            Eq/refl(),
            sound,
            apart,
            past,
            at_d));

--- The Map/empty Map/map Map/has no value at any key.
pub let of_empty(
    @K: Type,
    use Hash/Key(K),
    @V: Type,
    key: K,
) -> Eq()(try_get(Map/empty(), key), Option/none(@V)) =
    Eq/refl();

--- `Map/insert` sets the value at its key.
pub let of_insert(
    @K: Type,
    use Hash/Key(K),
    @V: Type,
    m: Map(K, V),
    key: K,
    v: V,
) -> Eq()(try_get(Map/insert(m, key, v), key), Option/some(v)) =
    match Node/insert(m.root, key, Hash/hash(key), v, @Eq/refl(), @m.sound)
    | vacant(_) => Eq/refl()
    | added(_, @_, @answers, @_) | replaced(_, @_, @answers, @_) => answers(Hash/hash(key))
    | parted(n2, c, d, @back, @_, @apart, @past, @at_d, @small_d) =>
        parted_answers(m.root, n2, key, v, c, d, @small_d, back, m.sound, apart, past, at_d)(
            Hash/hash(key))
    end;

--- `Map/insert` leaves the value at every other key as it was.
pub let of_insert_other(
    @K: Type,
    use Hash/Key(K),
    @V: Type,
    m: Map(K, V),
    key: K,
    v: V,
    other: K,
    apart: (Eq()(other, key)) -> False,
) -> Eq()(try_get(Map/insert(m, key, v), other), try_get(m, other)) =
    let codes = apart_codes(key, other, apart);
    match Node/insert(m.root, key, Hash/hash(key), v, @Eq/refl(), @m.sound)
    | vacant(gap) =>
        Eq/subst(
            (t: Node(K, V)) =>
                Eq()(
                    Node/find(Node/leaf(key, v), Hash/hash(other)),
                    Node/find(t, Hash/hash(other))),
            Eq/sym(gap),
            Eq/subst(
                (b: Bool) =>
                    Eq()(
                        match b | true => Option/some(v) | false => Option/none() end,
                        Option/none(@V)),
                Eq/sym(codes),
                Eq/refl()))
    | added(n2, @_, @answers, @_) | replaced(n2, @_, @answers, @_) =>
        elsewhere(m.root, n2, key, Option/some(v), other, codes, answers)
    | parted(n2, c, d, @back, @_, @apart, @past, @at_d, @small_d) =>
        elsewhere(
            m.root,
            Node/wedge(c, d, n2, key, Hash/hash(key), v, @small_d),
            key,
            Option/some(v),
            other,
            codes,
            parted_answers(m.root, n2, key, v, c, d, @small_d, back, m.sound, apart, past, at_d))
    end;

--- `Map/remove` leaves no value at its key.
pub let of_remove(
    @K: Type,
    use Hash/Key(K),
    @V: Type,
    m: Map(K, V),
    key: K,
) -> Eq()(try_get(Map/remove(m, key), key), Option/none(@V)) =
    match Node/remove(m.root, Hash/hash(key), @m.sound)
    | gone(_) => Eq/refl()
    | kept(_, @_, @answers, @_) => answers(Hash/hash(key))
    | absent(_, @back, answers) =>
        Eq/subst(
            (t: Node(K, V)) => Eq()(Node/find(t, Hash/hash(key)), Option/none(@V)),
            Eq/sym(back),
            answers(Hash/hash(key)))
    end;

--- `Map/remove` leaves the value at every other key as it was.
pub let of_remove_other(
    @K: Type,
    use Hash/Key(K),
    @V: Type,
    m: Map(K, V),
    key: K,
    other: K,
    apart: (Eq()(other, key)) -> False,
) -> Eq()(try_get(Map/remove(m, key), other), try_get(m, other)) =
    let codes = apart_codes(key, other, apart);
    match Node/remove(m.root, Hash/hash(key), @m.sound)
    | gone(nothing) =>
        Eq/sym(
            Eq/subst(
                (b: Bool) =>
                    Eq()(
                        match b
                        | true => Option/none()
                        | false => Node/find(m.root, Hash/hash(other))
                        end,
                        Option/none(@V)),
                codes,
                nothing(Hash/hash(other))))
    | kept(n2, @_, @answers, @_) => elsewhere(m.root, n2, key, Option/none(), other, codes, answers)
    | absent(_, @back, _) =>
        Eq/subst(
            (t: Node(K, V)) =>
                Eq()(Node/find(t, Hash/hash(other)), Node/find(m.root, Hash/hash(other))),
            Eq/sym(back),
            Eq/refl())
    end;

--- `Map/map` rewrites the value at every key.
pub let of_map(
    @K: Type,
    use Hash/Key(K),
    @V: Type,
    @W: Type,
    m: Map(K, V),
    f: (V) -> W,
    key: K,
) -> Eq()(try_get(Map/map(m, f), key), Option/map(try_get(m, key), f)) =
    Node/mapped_find(m.root, f, Hash/hash(key));

-- Two maps with one root are one map: what else a Map/map holds is the proof about its root.
let of_root(
    @K: Type,
    use Hash/Key(K),
    @V: Type,
    a: Map(K, V),
    b: Map(K, V),
    e: Eq()(a.root, b.root),
) -> Eq()(a, b) =
    Eq/subst(
        (r: Node(K, V)) => (w: Node/Sound(r)) -> Eq()(a, Map { root = r, @sound = w }),
        e,
        (_) => Eq/refl())(
        b.sound);

-- A Map/map's trie is a function of its entries: the position a sound branch forks at is the first its keys differ at, and which twig holds a key is that key's digit there. So a proof about a Map/map binds to what it holds, and two maps built in different orders, or by different operations, are equal where they agree at every key.
--- Two maps with the same value at every key are one Map/map.
pub let inj(
    @K: Type,
    use Hash/Key(K),
    @V: Type,
    a: Map(K, V),
    b: Map(K, V),
    same: (key: K) -> Eq()(try_get(a, key), try_get(b, key)),
) -> Eq()(a, b) =
    of_root(a, b, Node/canonical(a.root, b.root, a.sound, b.sound, same));

-- Two keys whose encodings compare equal, as an equation, are one key.
let same_key(
    @K: Type,
    use Hash/Key(K),
    a: K,
    b: K,
    e: Eq()(Hash/hash(a) == Hash/hash(b), true),
) -> Eq()(a, b) =
    Hash/Key/same(a, b, Bool/holds_of_eq(Hash/hash(a) == Hash/hash(b), e));

-- Two keys whose encodings compare unequal, as an equation, are two keys.
let other_key(
    @K: Type,
    use Hash/Key(K),
    a: K,
    b: K,
    e: Eq()(Hash/hash(a) == Hash/hash(b), false),
) -> (Eq()(b, a)) -> False =
    Hash/Key/apart(a, b, Eq/subst((c: Bool) => Holds(Bool/not(c)), Eq/sym(e), True/qed()));

-- What a sound branch's twigs answer at `k`, asked in turn by a combination that `none` leaves as it was, is what the branch answers there.
let either(
    @K: Type,
    use Hash/Key(K),
    @V: Type,
    @R: Type,
    at: Nat,
    tw: Vec(Node(K, V), 16),
    sound: Node/Sound(Node/branch(at, tw)),
    k: Bytes,
    f: (Option(V), R) -> R,
    keeps: (r: R) -> Eq()(f(Option/none(), r), r),
    r: R,
) -> Eq()(Node/folded(tw.list, k, f, r), f(Node/find(Node/branch(at, tw), k), r)) =
    let s = small(k, at);
    Eq/trans(
        Node/either_in(
            tw.list,
            at,
            0,
            Node/first_in(tw.list),
            sound.twigs,
            k,
            proved(),
            f,
            keeps,
            r),
        Eq/cong(
            (n: Node(K, V)) => f(Node/find(n, k), r),
            Eq/sym(Node/picked(tw.list, digit(k, at), @proved()))));

-- Inserting a sound node's entries into a Map/map one by one leaves at a key the node's value there, and the Map/map's where the node Map/has none.
let inserted_all(
    @K: Type,
    use Hash/Key(K),
    @V: Type,
    n: Node(K, V),
    sound: Node/Sound(n),
    acc: Map(K, V),
    key: K,
) -> Eq()(
    try_get(Node/fold(n, acc, (k: K, v: V, m: Map(K, V)) => Map/insert(m, k, v)), key),
    Option/or(Node/find(n, Hash/hash(key)), try_get(acc, key))) =
    match n
    | empty() => Eq/refl()
    | leaf(k0, v0) =>
        let cases(
            b: Bool,
            e: Eq()(Hash/hash(k0) == Hash/hash(key), b),
        ) -> Eq()(
            try_get(Map/insert(acc, k0, v0), key),
            Option/or(
                match b | true => Option/some(v0) | false => Option/none() end,
                try_get(acc, key))) =
            match b
            | true =>
                Eq/subst(
                    (y: K) => Eq()(try_get(Map/insert(acc, k0, v0), y), Option/some(v0)),
                    same_key(k0, key, e),
                    of_insert(acc, k0, v0))
            | false => of_insert_other(acc, k0, v0, key, other_key(k0, key, e))
            end;
        cases(Hash/hash(k0) == Hash/hash(key), Eq/refl())
    | branch(at, tw) =>
        Eq/trans(
            inserted_in(tw.list, at, 0, Node/first_in(tw.list), sound.twigs, acc, key),
            either(
                at,
                tw,
                sound,
                Hash/hash(key),
                (x: Option(V), r: Option(V)) => Option/or(x, r),
                (_) => Eq/refl(),
                try_get(acc, key)))
    end
-- Inserting placed twigs' entries into a Map/map one by one leaves at a key what the twigs answer there, asked in turn.
and inserted_in(
    @K: Type,
    use Hash/Key(K),
    @V: Type,
    l: List(Node(K, V)),
    at: Nat,
    d: Nat,
    a: Bytes,
    twigs: Node/Twigs(l, at, d, a),
    acc: Map(K, V),
    key: K,
) -> Eq()(
    try_get(Node/fold_in(l, acc, (k: K, v: V, m: Map(K, V)) => Map/insert(m, k, v)), key),
    Node/folded(
        l,
        Hash/hash(key),
        (x: Option(V), r: Option(V)) => Option/or(x, r),
        try_get(acc, key))) =
    match l
    | [] => Eq/refl()
    | [h, ..r] =>
        Eq/trans(
            inserted_in(
                r,
                at,
                d + 1,
                a,
                twigs.1,
                Node/fold(h, acc, (k: K, v: V, m: Map(K, V)) => Map/insert(m, k, v)),
                key),
            Eq/cong(
                (o: Option(V)) =>
                    Node/folded(
                        r,
                        Hash/hash(key),
                        (x: Option(V), s: Option(V)) => Option/or(x, s),
                        o),
                inserted_all(h, Node/twig_sound(h, at, d, a, twigs.0), acc, key)))
    end;

--- `Map/union` Map/has at every key the second Map/map's value, and the first's where the second Map/has none.
pub let of_union(
    @K: Type,
    use Hash/Key(K),
    @V: Type,
    a: Map(K, V),
    b: Map(K, V),
    key: K,
) -> Eq()(try_get(Map/union(a, b), key), Option/or(try_get(b, key), try_get(a, key))) =
    inserted_all(b.root, b.sound, a, key);

-- What `Map/filter`'s step keeps of a value found at `key`, over what the Map/map it began with Map/has there.
let kept(
    @V: Type,
    @K: Type,
    pred: (K, V) -> Bool,
    key: K,
    found: Option(V),
    rest: Option(V),
) -> Option(V) =
    match found
    | some(v), pred(key, v) => Option/some(v)
    | _ => rest
    end;

-- Inserting the entries of a sound node `pred` accepts into a Map/map one by one leaves at a key the node's value there where `pred` accepts it, and the Map/map's otherwise.
let kept_all(
    @K: Type,
    use Hash/Key(K),
    @V: Type,
    n: Node(K, V),
    sound: Node/Sound(n),
    pred: (K, V) -> Bool,
    acc: Map(K, V),
    key: K,
) -> Eq()(
    try_get(
        Node/fold(n, acc, (k: K, v: V, m: Map(K, V)) =>
            match pred(k, v) | true => Map/insert(m, k, v) | false => m end),
        key),
    kept(pred, key, Node/find(n, Hash/hash(key)), try_get(acc, key))) =
    match n
    | empty() => Eq/refl()
    | leaf(k0, v0) =>
        let cases(
            b: Bool,
            e: Eq()(Hash/hash(k0) == Hash/hash(key), b),
        ) -> Eq()(
            try_get(
                match pred(k0, v0)
                | true => Map/insert(acc, k0, v0)
                | false => acc
                end,
                key),
            kept(
                pred,
                key,
                match b | true => Option/some(v0) | false => Option/none() end,
                try_get(acc, key))) =
            match b
            | true =>
                let at_key: Eq()(
                    try_get(
                        match pred(key, v0)
                        | true => Map/insert(acc, key, v0)
                        | false => acc
                        end,
                        key),
                    kept(pred, key, Option/some(v0), try_get(acc, key))) =
                    match pred(key, v0)
                    | true => of_insert(acc, key, v0)
                    | false => Eq/refl()
                    end;
                Eq/subst(
                    (y: K) =>
                        Eq()(
                            try_get(
                                match pred(y, v0)
                                | true => Map/insert(acc, y, v0)
                                | false => acc
                                end,
                                key),
                            kept(pred, key, Option/some(v0), try_get(acc, key))),
                    Eq/sym(same_key(k0, key, e)),
                    at_key)
            | false =>
                match pred(k0, v0)
                | true => of_insert_other(acc, k0, v0, key, other_key(k0, key, e))
                | false => Eq/refl()
                end
            end;
        cases(Hash/hash(k0) == Hash/hash(key), Eq/refl())
    | branch(at, tw) =>
        Eq/trans(
            kept_in(tw.list, at, 0, Node/first_in(tw.list), sound.twigs, pred, acc, key),
            either(
                at,
                tw,
                sound,
                Hash/hash(key),
                (x: Option(V), r: Option(V)) => kept(pred, key, x, r),
                (_) => Eq/refl(),
                try_get(acc, key)))
    end
-- Inserting the entries of placed twigs `pred` accepts into a Map/map one by one leaves at a key what the twigs keep there, asked in turn.
and kept_in(
    @K: Type,
    use Hash/Key(K),
    @V: Type,
    l: List(Node(K, V)),
    at: Nat,
    d: Nat,
    a: Bytes,
    twigs: Node/Twigs(l, at, d, a),
    pred: (K, V) -> Bool,
    acc: Map(K, V),
    key: K,
) -> Eq()(
    try_get(
        Node/fold_in(l, acc, (k: K, v: V, m: Map(K, V)) =>
            match pred(k, v) | true => Map/insert(m, k, v) | false => m end),
        key),
    Node/folded(
        l,
        Hash/hash(key),
        (x: Option(V), r: Option(V)) => kept(pred, key, x, r),
        try_get(acc, key))) =
    match l
    | [] => Eq/refl()
    | [h, ..r] =>
        Eq/trans(
            kept_in(
                r,
                at,
                d + 1,
                a,
                twigs.1,
                pred,
                Node/fold(h, acc, (k: K, v: V, m: Map(K, V)) =>
                    match pred(k, v) | true => Map/insert(m, k, v) | false => m end),
                key),
            Eq/cong(
                (o: Option(V)) =>
                    Node/folded(
                        r,
                        Hash/hash(key),
                        (x: Option(V), s: Option(V)) => kept(pred, key, x, s),
                        o),
                kept_all(h, Node/twig_sound(h, at, d, a, twigs.0), pred, acc, key)))
    end;

--- `Map/filter` Map/has at every key the value there where `pred` accepts it, and none otherwise.
pub let of_filter(
    @K: Type,
    use Hash/Key(K),
    @V: Type,
    m: Map(K, V),
    pred: (K, V) -> Bool,
    key: K,
) -> Eq()(
    try_get(Map/filter(m, pred), key),
    Option/filter(try_get(m, key), (v: V) => pred(key, v))) =
    kept_all(m.root, m.sound, pred, Map/empty(), key);

--- `Map/intersection` Map/has at every key the first Map/map's value where the second Map/has an entry there, and none otherwise.
pub let of_intersection(
    @K: Type,
    use Hash/Key(K),
    @V: Type,
    @W: Type,
    a: Map(K, V),
    b: Map(K, W),
    key: K,
) -> Eq()(
    try_get(Map/intersection(a, b), key),
    Option/filter(try_get(a, key), (_: V) => Map/has(b, key))) =
    of_filter(a, (k: K, _: V) => Map/has(b, k), key);

--- `Map/difference` Map/has at every key the first Map/map's value where the second Map/has no entry there, and none otherwise.
pub let of_difference(
    @K: Type,
    use Hash/Key(K),
    @V: Type,
    @W: Type,
    a: Map(K, V),
    b: Map(K, W),
    key: K,
) -> Eq()(
    try_get(Map/difference(a, b), key),
    Option/filter(try_get(a, key), (_: V) => Bool/not(Map/has(b, key)))) =
    of_filter(a, (k: K, _: V) => Bool/not(Map/has(b, k)), key);

--- `Map/update` sets the value at its key to what `f` answers of the value there.
pub let of_update(
    @K: Type,
    use Hash/Key(K),
    @V: Type,
    m: Map(K, V),
    key: K,
    f: (Option(V)) -> Option(V),
) -> Eq()(try_get(Map/update(m, key, f), key), f(try_get(m, key))) =
    match f(try_get(m, key))
    | some(v) => of_insert(m, key, v)
    | none() => of_remove(m, key)
    end;

--- `Map/update` leaves the value at every other key as it was.
pub let of_update_other(
    @K: Type,
    use Hash/Key(K),
    @V: Type,
    m: Map(K, V),
    key: K,
    f: (Option(V)) -> Option(V),
    other: K,
    apart: (Eq()(other, key)) -> False,
) -> Eq()(try_get(Map/update(m, key, f), other), try_get(m, other)) =
    match f(try_get(m, key))
    | some(v) => of_insert_other(m, key, v, other, apart)
    | none() => of_remove_other(m, key, other, apart)
    end;

--- An entry `Map/to_list` holds is the value at its key.
pub let of_listed(
    @K: Type,
    use Hash/Key(K),
    @V: Type,
    m: Map(K, V),
    key: K,
    v: V,
    listed: Member()((key, v), Map/to_list(m)),
) -> Eq()(try_get(m, key), Option/some(v)) =
    Node/entry_found(
        m.root,
        m.sound,
        (key, v),
        Eq/subst((l: List({K, V})) => Member()((key, v), l), Node/listed(m.root, []), listed));

--- The value at a key is an entry `Map/to_list` holds.
pub let listed(
    @K: Type,
    use Hash/Key(K),
    @V: Type,
    m: Map(K, V),
    key: K,
    v: V,
    found: Eq()(try_get(m, key), Option/some(v)),
) -> Member()((key, v), Map/to_list(m)) =
    Eq/subst(
        (l: List({K, V})) => Member()((key, v), l),
        Eq/sym(Node/listed(m.root, [])),
        Node/found_entry(m.root, key, v, found));
