use /std/{Nat, Byte, Bytes, Bool, Eq, Ordering, proved};
use /std/ops/{Ord};
use /std/Bool/{True, Holds};

-- A byte's high nibble.
let high(x: Nat) -> Nat =>
    Nat/shr(x, 4);

-- A byte's low nibble.
let low(x: Nat) -> Nat =>
    Nat/and(x, 15);

--- The digit of `k` at byte `g`, place `o` of four: place zero says whether the byte exists, the next two are its high and low nibble, and no fork reads the fourth. A missing byte has every digit zero, so a run that ends sorts before every run that continues.
let at_place(k: Bytes, g: Nat, o: Nat) -> Nat =>
    match g < Bytes/length(k)
    | false => 0
    | true =>
        match o
        | 0 => 1
        | 1 => high(Byte/to_nat(Bytes/get(k, g)))
        | 2 => low(Byte/to_nat(Bytes/get(k, g)))
        | _ + 3 => 0
        end
    end;

--- The digit of `k` at `p`, four to a byte.
pub let digit(k: Bytes, p: Nat) -> Nat =>
    at_place(k, p / 4, p % 4);

--- Where two runs part: nowhere, or at a position.
pub induct Parted: pub Type
| same()
| at(Nat)
end

-- Where `a` and `b` first differ, their bytes counted from `g`.
let parts(a: Bytes, b: Bytes, g: Nat) -> Parted =>
    match (a, b)
    | (0x[], 0x[]) => Parted/same()
    | (0x[], 0x[_, .._]) | (0x[_, .._], 0x[]) => Parted/at(4 * g)
    | (0x[h, ..t], 0x[k, ..r]) =>
        match h == k
        | true => parts(t, r, g + 1)
        | false =>
            match high(Byte/to_nat(h)) == high(Byte/to_nat(k))
            | false => Parted/at(4 * g + 1)
            | true => Parted/at(4 * g + 2)
            end
        end
    end;

--- The first position at which two runs differ, or that they are one run: where a byte exists in one and not the other, or the nibble at which two bytes first differ.
---
--- It recurs on the runs' structure, so a type may mention it.
pub let crit(a: Bytes, b: Bytes) -> Parted =>
    parts(a, b, 0);

--- A digit is below sixteen, so it indexes a fork's twigs.
pub let small(k: Bytes, p: Nat) -> Holds(digit(k, p) < 16) =>
    match p / 4 < Bytes/length(k)
    | false => True/qed()
    | true =>
        match p % 4
        | 0 => True/qed()
        | 1 | 2 => proved()
        | _ + 3 => True/qed()
        end
    end;

--- Two runs apart at the position `c`: the first position they differ at.
pub struct Apart(a: Bytes, b: Bytes, c: Nat): pub Prop {
    --- They agree at every position below it.
    below: (j: Nat, under: Holds(j < c)) -> Eq()(digit(a, j), digit(b, j)),
    --- They differ at it.
    differs: Holds(digit(a, c) != digit(b, c)),
}

-- What a walk that began at byte `g` found at `c`: a position at or past the walk's start, the runs apart at it counted from there.
struct Shifted(a: Bytes, b: Bytes, g: Nat, c: Nat): Prop {
    over: Holds(4 * g <= c),
    apart: Apart(a, b, c - 4 * g),
}

-- What `parts` answers is true of the runs: nowhere says they are one run, and a position that they are apart at it.
let Found(a: Bytes, b: Bytes, g: Nat, found: Parted) -> Prop =>
    match found | same() => Eq()(a, b) | at(c) => Shifted(a, b, g, c) end;

-- A position four on or more is a position of the run past its first byte.
let onward(
    h: Byte,
    t: Bytes,
    j: Nat,
    over: Holds(4 <= j),
) -> Eq()(digit(0x[h, ..t], j), digit(t, j - 4)) =>
    Eq/subst(
        (v: Nat) => Eq()(digit(0x[h, ..t], v), digit(t, j - 4)),
        Nat/le/add_sub_cancel(4, j, over),
        Eq/refl());

-- A position below four is its place in the first byte.
let inward(k: Bytes, j: Nat, under: Holds(j < 4)) -> Eq()(digit(k, j), at_place(k, 0, j)) =>
    let first: Holds(j / 4 < 1) = Nat/DivMod/div_lt_of_lt_mul(1, j, 4, proved());
    Eq/subst(
        (v: Nat) => Eq()(at_place(k, j / 4, v), at_place(k, 0, j)),
        Nat/le/antisym(j, j % 4, proved(), proved()),
        Eq/subst(
            (v: Nat) => Eq()(at_place(k, v, j), at_place(k, 0, j)),
            Nat/le/antisym(0, j / 4, True/qed(), proved()),
            Eq/refl()));

-- Two runs led by one byte agree at every position of it.
let led(
    h: Byte,
    t: Bytes,
    r: Bytes,
    j: Nat,
    under: Holds(j < 4),
) -> Eq()(digit(0x[h, ..t], j), digit(0x[h, ..r], j)) =>
    Eq/trans(inward(0x[h, ..t], j, under), Eq/sym(inward(0x[h, ..r], j, under)));

-- Two runs apart past a shared first byte are apart four positions on.
let lifted(
    h: Byte,
    t: Bytes,
    r: Bytes,
    p: Nat,
    apart: Apart(t, r, p),
) -> Apart(0x[h, ..t], 0x[h, ..r], p + 4) =>
    Apart {
        below =
            (j, under) =>
                match j < 4
                | true => led(h, t, r, j, True/qed())
                | false =>
                    Eq/trans(
                        onward(h, t, j, proved()),
                        Eq/trans(apart.below(j - 4, proved()), Eq/sym(onward(h, r, j, proved()))))
                end,
        differs = apart.differs };

-- Two runs apart four positions on or more past one first byte are apart past it.
let lowered(
    h: Byte,
    t: Bytes,
    r: Bytes,
    c: Nat,
    apart: Apart(0x[h, ..t], 0x[h, ..r], c),
    over: Holds(4 <= c),
) -> Apart(t, r, c - 4) =>
    Apart {
        below = (j, under) => apart.below(j + 4, proved()),
        differs =
            Eq/subst(
                (v: Nat) => Holds(digit(0x[h, ..t], v) != digit(0x[h, ..r], v)),
                Eq/sym(Nat/le/add_sub_cancel(4, c, over)),
                apart.differs) };

let ended(k: Byte, r: Bytes) -> Apart(0x[], 0x[k, ..r], 0) =>
    Apart { below = (_, under) => match under end, differs = True/qed() };

let outlasted(h: Byte, t: Bytes) -> Apart(0x[h, ..t], 0x[], 0) =>
    Apart { below = (_, under) => match under end, differs = True/qed() };

-- Two bytes alike in both nibbles are one byte.
let joined(
    h: Byte,
    k: Byte,
    up: Eq()(high(Byte/to_nat(h)), high(Byte/to_nat(k))),
    down: Eq()(low(Byte/to_nat(h)), low(Byte/to_nat(k))),
) -> Eq()(h, k) =>
    let (hn, kn) = (Byte/to_nat(h), Byte/to_nat(k));
    Eq/cong((n: Nat) => Nat/to_byte(n % 256), proved(@Eq()(hn, kn)));

-- Two bytes that differ, alike in their high nibble, differ in their low one.
let low_differs(
    h: Byte,
    k: Byte,
    differs: Holds(Bool/not(h == k)),
    up: Holds(high(Byte/to_nat(h)) == high(Byte/to_nat(k))),
) -> Holds(low(Byte/to_nat(h)) != low(Byte/to_nat(k))) =>
    match low(Byte/to_nat(h)) == low(Byte/to_nat(k))
    | false => True/qed()
    | true =>
        let same = joined(h, k, proved(), proved());
        match Eq/subst((y: Byte) => Holds(Bool/not(h == y)), Eq/sym(same), differs)
        end
    end;

-- What `parts` answers is true of the two runs.
let spec(a: Bytes, b: Bytes, g: Nat) -> Found(a, b, g, parts(a, b, g)) =>
    match (a, b)
    | (0x[], 0x[]) => Eq/refl()
    | (0x[], 0x[k, ..r]) => Shifted { over = proved(), apart = ended(k, r) }
    | (0x[h, ..t], 0x[]) => Shifted { over = proved(), apart = outlasted(h, t) }
    | (0x[h, ..t], 0x[k, ..r]) =>
        match h == k
        | true =>
            let inner = spec(t, r, g + 1);
            Eq/subst(
                (y: Byte) => Found(0x[h, ..t], 0x[y, ..r], g, parts(t, r, g + 1)),
                proved(),
                match parts(t, r, g + 1)
                | same() => Eq/cong((z: Bytes) => 0x[h, ..z], inner)
                | at(c) =>
                    Shifted {
                        over = proved(),
                        apart =
                            Eq/subst(
                                (p: Nat) => Apart(0x[h, ..t], 0x[h, ..r], p),
                                Nat/le/antisym(c - 4 * (g + 1) + 4, c - 4 * g, proved(), proved()),
                                lifted(h, t, r, c - 4 * (g + 1), inner.apart)) }
                end)
        | false =>
            match high(Byte/to_nat(h)) == high(Byte/to_nat(k))
            | false =>
                Shifted {
                    over = proved(),
                    apart =
                        Eq/subst(
                            (p: Nat) => Apart(0x[h, ..t], 0x[k, ..r], p),
                            Nat/le/antisym(1, 4 * g + 1 - 4 * g, proved(), proved()),
                            Apart {
                                below =
                                    (j, under) =>
                                        match j
                                        | 0 => Eq/refl()
                                        | _ + 1 => match under end
                                        end,
                                differs = True/qed() }) }
            | true =>
                Shifted {
                    over = proved(),
                    apart =
                        Eq/subst(
                            (p: Nat) => Apart(0x[h, ..t], 0x[k, ..r], p),
                            Nat/le/antisym(2, 4 * g + 2 - 4 * g, proved(), proved()),
                            Apart {
                                below =
                                    (j, under) =>
                                        match j
                                        | 0 => Eq/refl()
                                        | 1 => proved()
                                        | _ + 2 => match under end
                                        end,
                                differs = low_differs(h, k, True/qed(), True/qed()) }) }
            end
        end
    end;

--- What an answer of `crit` says of two runs: that they are one run, or that they are apart at a position.
pub let Parting(a: Bytes, b: Bytes, found: Parted) -> Prop =>
    match found | same() => Eq()(a, b) | at(c) => Apart(a, b, c) end;

--- What `crit` answers is true of the two runs.
pub let parting(a: Bytes, b: Bytes) -> Parting(a, b, crit(a, b)) =>
    let inner = spec(a, b, 0);
    match parts(a, b, 0)
    | same() => inner
    | at(c) =>
        Eq/subst(
            (p: Nat) => Apart(a, b, p),
            Nat/le/antisym(c - 4 * 0, c, proved(), proved()),
            inner.apart)
    end;

--- Two runs apart at a position are apart at it either way round.
pub let turned(a: Bytes, b: Bytes, c: Nat, apart: Apart(a, b, c)) -> Apart(b, a, c) =>
    Apart { below = (j, under) => Eq/sym(apart.below(j, under)), differs = proved() };

--- A run that agrees with another through a position is apart at that position from whatever the other is.
pub let reheaded(
    a: Bytes,
    n: Bytes,
    b: Bytes,
    c: Nat,
    apart: Apart(a, b, c),
    agree: (j: Nat, within: Holds(j <= c)) -> Eq()(digit(n, j), digit(a, j)),
) -> Apart(n, b, c) =>
    Apart {
        below = (j, under) => Eq/trans(agree(j, proved()), apart.below(j, under)),
        differs =
            Eq/subst(
                (v: Nat) => Holds(v != digit(b, c)),
                Eq/sym(agree(c, True/qed())),
                apart.differs) };

-- A number whose high nibble is below another's is below it.
let higher(x: Nat, y: Nat, up: Holds(high(x) < high(y))) -> Holds(x < y) =>
    proved();

-- A number alike in its high nibble with another and below it in its low one is below it.
let lower(
    x: Nat,
    y: Nat,
    up: Eq()(high(x), high(y)),
    down: Holds(low(x) < low(y)),
) -> Holds(x < y) =>
    proved();

-- Two runs whose first bytes are in order are in order.
let headed(
    h: Byte,
    k: Byte,
    t: Bytes,
    r: Bytes,
    ordered: Holds(Byte/to_nat(h) < Byte/to_nat(k)),
) -> Eq()(Bytes/ord(0x[h, ..t], 0x[k, ..r]), Ordering/lt()) =>
    Eq/subst(
        (o: Ordering) =>
            Eq()(
                match o
                | eq() => Bytes/ord(t, r)
                | lt() => Ordering/lt()
                | gt() => Ordering/gt()
                end,
                Ordering/lt()),
        Eq/sym(Ord/of_lt(Byte/to_nat(h), Byte/to_nat(k), ordered)),
        Eq/refl());

--- A run whose digit is the smaller at the first position where it differs from another is before it in byte order: the digits are each byte's nibbles from the top, after a digit marking that the byte exists, so that position is where `Bytes/ord` decides.
pub let before(
    a: Bytes,
    b: Bytes,
    c: Nat,
    apart: Apart(a, b, c),
    less: Holds(digit(a, c) < digit(b, c)),
) -> Eq()(Bytes/ord(a, b), Ordering/lt()) =>
    match (a, b)
    | (0x[], 0x[]) => match apart.differs end
    | (0x[], 0x[_, .._]) => Eq/refl()
    | (0x[_, .._], 0x[]) => match less end
    | (0x[h, ..t], 0x[k, ..r]) =>
        let (hn, kn) = (Byte/to_nat(h), Byte/to_nat(k));
        match c
        | 0 => match less end
        | 1 => headed(h, k, t, r, higher(hn, kn, less))
        | 2 => headed(h, k, t, r, lower(hn, kn, apart.below(1, True/qed()), less))
        | 3 => match less end
        | _ + 4 =>
            let same: Eq()(h, k) = joined(h, k, apart.below(1, proved()), apart.below(2, proved()));
            Eq/subst(
                (y: Byte) =>
                    (apart: Apart(0x[h, ..t], 0x[y, ..r], c)) -> (
                        less: Holds(digit(0x[h, ..t], c) < digit(0x[y, ..r], c))) -> Eq()(
                        Bytes/ord(0x[h, ..t], 0x[y, ..r]),
                        Ordering/lt()),
                same,
                (apart) =>
                    (less) =>
                        before(
                            t,
                            r,
                            c - 4,
                            lowered(h, t, r, c, apart, proved()),
                            Eq/subst(
                                (v: Nat) => Holds(v < digit(r, c - 4)),
                                onward(h, t, c, proved()),
                                Eq/subst(
                                    (v: Nat) => Holds(digit(0x[h, ..t], c) < v),
                                    onward(h, r, c, proved()),
                                    less))))(
                apart)(
                less)
        end
    end;
