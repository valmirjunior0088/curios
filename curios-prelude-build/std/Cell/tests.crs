-- `/std/Cell`: a cell is empty until it is filled, and stays filled.
use /std/{Bool, Cell, Test};

-- A cell polls empty until it is filled.
test a_cell_polls_empty_until_it_is_filled =
    let cell = Cell/new()!;
    let before = Cell/poll(cell)!;
    let () = Cell/fill(cell)!;
    let after = Cell/poll(cell)!;
    Test/all([
        Test/assert("a new cell is empty", Bool/not(before)),
        Test/assert("a filled cell is filled", after)]);

-- A cell filled again stays filled.
test a_cell_filled_again_stays_filled =
    let cell = Cell/new()!;
    let () = Cell/fill(cell)!;
    let () = Cell/fill(cell)!;
    let filled = Cell/poll(cell)!;
    Test/assert("a second fill changes nothing", filled);

-- Filling one cell leaves another empty.
test filling_one_cell_leaves_another_empty =
    let a = Cell/new()!;
    let b = Cell/new()!;
    let () = Cell/fill(a)!;
    let polled = Cell/poll(b)!;
    Test/assert("the other cell is empty", Bool/not(polled));
