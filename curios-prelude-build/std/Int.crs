mod tests;

pub use /sys/{let Int};
pub use /sys/Int/{eql, add, sub, div, rem, gt, ge, and, or, xor, shr, to_nat, to_flt};

-- Each law names the difference a hypothesis makes non-negative as a natural, with `to_nat`, and concludes from `Nat`'s own floor read through the widening — the order on `Int` is `Nat`'s, carried along the embedding.
--- The laws of `a < b`, and its crossings with `a <= b`.
pub mod lt;
pub use lt/{let lt};

--- The laws of `a <= b`.
pub mod le;
pub use le/{let le};

--- The smaller of two integers, and its laws under a hypothesis.
---
--- Conversion decides `min` from its operands alone, as `Nat`'s does, and reads no hypothesis, so under a guard on `a <= b` these laws do the rewriting.
pub mod min;
pub use min/{let min};

--- The larger of two integers, and its laws under a hypothesis.
pub mod max;
pub use max/{let max};

--- The magnitude of an integer, as a `Nat`, and what it widens back to under a hypothesis on the integer's sign.
---
--- Conversion decides `abs` from its operand alone: a negation or a literal factor passes through it, and a non-negative combination of widened naturals is its own preimage. It reads no hypothesis, so under a guard on `+0 <= a` these laws do the rewriting.
pub mod abs;
pub use abs/{let abs};

--- `-1`, `+0` or `+1` by the sign of an integer, and its laws under a hypothesis.
pub mod sign;
pub use sign/{let sign};

--- A product, and the cancellation of a nonzero factor.
---
--- Conversion decides a product as a polynomial in its factors and cancels nothing: without the premise that a factor is nonzero, `a * k = b * k` says nothing of `a` and `b`.
pub mod mul;
pub use mul/{let mul};

--- A left shift, the split of its count, and the one odd mantissa a value has at one count.
pub mod shl;
pub use shl/{let shl};

--- The order of two integers as an `Ordering`, and the laws that tie each answer to the comparison it stands for.
pub mod ord;
pub use ord/{let ord};

--- An integer's encoding in the order of the numbers, with the laws that say so.
pub mod hash;
pub use hash/{let hash};

use /std/{Nat, Bool, Str, Option, Show, Spell, Ord, Hash, Map, Eq};
use /std/ops/{Eql, Add, Sub, Mul, Div, Rem};

--- That `a` is not zero, decided — what `/` and `%` on `Int` ask of a divisor.
pub let NonZero(a: Int) -> Prop =
    Bool/Holds(a != +0);

--- That `a` is zero or above, decided.
pub let NonNeg(a: Int) -> Prop =
    Bool/Holds(a >= +0);

--- An integer is a widened natural, or one below the negation of one: its two canonical forms, as the family's indices.
---
--- Matching on [`view`] refines `i` to its form in each arm, which is how a proof takes an integer apart: `Int` has no constructors of its own, and this is the case split they would give. Nothing here is primitive: the view is built from `Int/to_nat`, and the order laws in `lt` and `le` go through it and through `Nat`.
pub induct Sign: (Int) -> pub Type
--- `i` is the natural `n`, widened.
| nonneg(n: Nat): (Nat/to_int(n))
--- `i` is `-1 - n` for the natural `n`.
| neg(n: Nat): (-1 - Nat/to_int(n))
end

--- `i`'s form: the natural it is, or the natural one below its negation is.
pub let view(i: Int) -> Sign(i) =
    match i >= +0
    | true => Sign/nonneg(to_nat(i))
    | false => Sign/neg(to_nat(-1 - i))
    end;

let absurd_succ(@P: Sort, x: Nat, h: Bool/Holds(eql(+0, Nat/to_int(x) + 1))) -> P =
    match h end;

-- Stated over `eql`, and decided through `lt` and `le`, each by name: an operator here would read the witness that names this. Public for the elaborator's own proofs alone, which name it where a bound follows from an `==` guard, before any witness is elaborated: a program crosses by `Eql/eq_of_eql`.
--- `Eql`'s law at `Int`: a decided equality is an equation.
pub let eq_of_eql(a: Int, b: Int, h: Bool/Holds(eql(a, b))) -> Eq()(a, b) =
    match lt(a, b)
    | true =>
        let below: Bool/Holds(lt(a, b)) = Bool/True/qed();
        absurd_succ(to_nat(b - a - 1, @below), h)
    | false =>
        let at_least: Bool/Holds(le(b, a)) = Bool/True/qed();
        match lt(b, a)
        | true =>
            let above: Bool/Holds(lt(b, a)) = Bool/True/qed();
            absurd_succ(to_nat(a - b - 1, @above), h)
        | false =>
            let at_most: Bool/Holds(le(a, b)) = Bool/True/qed();
            le/antisym(a, b, at_most, at_least)
        end
    end;

--- The value with its sign written, `+3` or `-3`, so the text re-parses as an `Int` without context.
pub let to_str(n: Int) -> Str =
    let mag = Nat/to_str(abs(n));
    match n >= +0
    | true => Str/concat("+", mag)
    | false => Str/concat("-", mag)
    end;

--- The bitwise complement.
pub let not(x: Int) -> Int =
    xor(x, -1);

--- The number an optional sign and a nonempty run of decimal digits spell, or `none` for any other text.
pub let of_str(s: Str) -> Option(Int) =
    let (negative, digits): {Bool, Str} =
        match Str/strip_prefix(s, "-")
        | some(rest) => (true, rest)
        | none() =>
            match Str/strip_prefix(s, "+")
            | some(rest) => (false, rest)
            | none() => (false, s)
            end
        end;
    let n = Nat/of_str(digits)!;
    match negative
    | true => Option/some(+0 - Nat/to_int(n))
    | false => Option/some(Nat/to_int(n))
    end;

--- The procedure that decides `0 <= n`: the evidence when it holds, `none` otherwise.
pub let non_neg(n: Int) -> Option(NonNeg(n)) =
    Bool/holds(n >= +0);

satisfy Eql(Int) {
    eql = eql,
    eq_of_eql = eq_of_eql,
    refl(_) = Bool/True/qed(),
}

satisfy Add(Int) {
    add = add,
}

satisfy Sub(Int) {
    sub = sub,
}

satisfy Mul(Int) {
    mul = mul,
}

--- The divisor must be nonzero.
satisfy Div(Int) {
    Ok(b) = NonZero(b),
    div = div,
}

--- The divisor must be nonzero.
satisfy Rem(Int) {
    Ok(b) = NonZero(b),
    rem(a, b, @ok) = Nat/to_int(rem(a, b, @ok)),
}

satisfy Show(Int) {
    show = to_str,
}

satisfy Spell(Int) {
    spell = to_str,
}

satisfy Ord(Int) {
    ord = ord,
    lt = lt,
    le = le,
    flips = ord/flips,
    transitive = ord/transitive,
    eq_of_ord = ord/eq,
    lt_of_ord = ord/is_lt,
    le_of_ord = ord/is_le,
}

--- The encoding [`hash`] writes: its natural's at or above zero and a complement below, so a smaller integer's is before a larger one's.
satisfy Hash(Int) {
    hash = hash,
}

--- The encoding in the order of the numbers, whose injectivity is that order's.
satisfy Map/Key(Int) {
    injective = hash/injective,
    monotone = hash/monotone,
}
