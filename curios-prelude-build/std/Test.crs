use /std/{Nat, Bool, Str, List, Result, Try, Io, Monad, Spell, Show};
use /std/ops/{Eql};
use /std/time/{Duration};

--- What a check that failed found, as the runner presents it: the steps that reached it, the outermost first, what it states, and the values it compared, each behind its label and spelled as Curios writes it.
pub struct Failure: Type {
    steps: List(Str),
    statement: Str,
    facts: List({Str, Str}),
}

-- What a test found crosses to its runner as the text this writes, which the runner reads back as Curios.
satisfy Spell(Failure) {
    ..
}

-- Its private representation keeps interpretation inside this module: a runner is handed what a test found by `run`, and the resource combinators release before a failure goes on.
--- A computation that succeeds with an `A` or ends the current test with what it found: the checks that failed, one at least.
pub induct Test(A: Type): Type
| success(A)
| failure(List(Failure))
| perform(Io(Test(A)))
end

--- Succeed with `a` without performing an effect.
pub let pure(@A: Type, a: A) -> Test(A) =
    Test/success(a);

-- End the current test with a check that failed, stating `statement` beside the values `facts` spell.
let failing(@A: Type, statement: Str, facts: List({Str, Str})) -> Test(A) =
    Test/failure([Failure { steps = [], statement = statement, facts = facts }]);

--- End the current test with `message`, skipping its remaining continuations.
pub let fail(@A: Type, message: Str) -> Test(A) =
    failing(message, []);

--- Continue a successful computation; a failure skips `next`.
pub let bind(@A: Type, @B: Type, test: Test(A), next: (A) -> Test(B)) -> Test(B) =
    match test
    | success(a) => next(a)
    | failure(failures) => Test/failure(failures)
    | perform(io) => Test/perform(Io/bind(io, (inner) => Io/pure(bind(inner, next))))
    end;

satisfy Monad(Test) {
    pure(@_, a) = pure(a),
    bind(@_, @_, test, next) = bind(test, next),
}

satisfy Monad/Lift(Io, Test) {
    lift(@_, action) = Test/perform(Io/bind(action, (a) => Io/pure(pure(a)))),
}

satisfy Monad/Lift(Test, Test) {
    lift(@_, test) = test,
}

satisfy (
    @M: (Type) -> Type,
    @E: Type,
    use Monad(M),
    use Monad/Lift(M, Test),
    use Show(E),
) => Monad/Lift((A: Type) => Try(M, E, A), Test) {
    lift(@_, action) =
        bind(
            Monad/lift(Try/run(action)),
            (result) =>
                match result
                | success(a) => pure(a)
                | failure(e) => fail(Show/show(e))
                end),
}

--- The test that holds when `condition` is true, stating `label` where it does not: what the condition claims, in its author's words, since a condition has no sides to show.
pub let assert(label: Str, condition: Bool) -> Test({}) =
    match condition | true => pure(()) | false => fail(label) end;

--- The test that holds when the two are equal, reporting both when they are not.
pub let equal(@A: Type, use Eql(A), use Spell(A), actual: A, expected: A) -> Test({}) =
    match actual == expected
    | true => pure(())
    | false =>
        failing("not equal", [
            ("obtained", Spell/spell(actual)),
            ("expected", Spell/spell(expected))])
    end;

--- The test `thunk` builds, where it builds one; where it fails, its error is the test's failure.
pub let try(@E: Type, @A: Type, use Show(E), thunk: () -> Try(Io, E, Test(A))) -> Test(A) =
    bind(Monad/lift(thunk()), (inner) => inner);

--- `test` as a named step: `label` leads the path of each failure it reports, ahead of the steps within it, as `Test/all` names each of its cases by its position.
pub let step(@A: Type, label: Str, test: Test(A)) -> Test(A) =
    match test
    | success(_) => test
    | failure(failures) =>
        Test/failure(
            List/map(failures, (failure) =>
                Failure { ..failure, steps = [label, ..failure.steps] }))
    | perform(io) => Test/perform(Io/bind(io, (inner) => Io/pure(step(label, inner))))
    end;

-- The failures `found` holds, then those `next` ends with: `next` runs whatever `found` held, after its actions.
let gathered(found: Test(List(Failure)), next: Test({})) -> Test(List(Failure)) =
    match found
    | success(failures) =>
        match next
        | success(()) => found
        | failure(more) => Test/success([..failures, ..more])
        | perform(io) => Test/perform(Io/bind(io, (inner) => Io/pure(gathered(found, inner))))
        end
    | failure(_) => found
    | perform(io) => Test/perform(Io/bind(io, (inner) => Io/pure(gathered(inner, next))))
    end;

--- Check each test in order, reporting every one that fails under its zero-based case index: the cases are independent, so each runs whatever the others found, where `bind` stops at the first failure of steps that depend on one another.
pub let all(tests: List(Test({}))) -> Test({}) =
    let found =
        List/fold(
            tests,
            (found = pure([]), index = 0),
            (next, state: {found: Test(List(Failure)), index: Nat}) =>
                (
                    found =
                        gathered(
                            state.found,
                            step(Str/concat("case ", Nat/to_str(state.index)), next)),
                    index = state.index + 1)).found;
    bind(found, (failures) =>
        match failures | [] => pure(()) | _ => Test/failure(failures) end);

-- Keeping an outcome inside Io lets a scope release before the failure resumes propagating through Test.
let finish(@A: Type, test: Test(A)) -> Io(Result(List(Failure), A)) =
    match test
    | success(a) => Io/pure(Result/success(a))
    | failure(failures) => Io/pure(Result/failure(failures))
    | perform(io) => Io/bind(io, (inner) => finish(inner))
    end;

let from_result(@A: Type, result: Result(List(Failure), A)) -> Test(A) =
    match result
    | success(a) => pure(a)
    | failure(failures) => Test/failure(failures)
    end;

--- `body` run with a scope, as `Io/scope` runs one: its children cancelled and its releases run after a success or an assertion failure, and when a suspended body is cancelled.
pub let scope(@A: Type, body: (Io/Scope) -> Test(A)) -> Test(A) =
    let result = Io/scope((s) => finish(body(s)))!;
    from_result(result);

--- Fail if the deadline wins, after cancelling the suspended body and running its releases.
pub let timeout(@A: Type, d: Duration, body: () -> Test(A)) -> Test(A) =
    let result = Io/timeout(d, finish(body()))!;
    match result
    | some(outcome) => from_result(outcome)
    | none() => failing("timed out", [("after", Spell/spell(d))])
    end;

--- Run `test` to its end and answer each check that failed, in the order it met them, and none where it held: what a runner reports of a test, since nothing else takes one apart.
pub let run(@A: Type, test: Test(A)) -> Io(List(Failure)) =
    let result = finish(test)!;
    match result
    | success(_) => Io/pure([])
    | failure(failures) => Io/pure(failures)
    end;
