use /std/{Nat, Int, Bool, List, Option, Path, Str, Try, Io, Show};
use /std/ops/{Eql};
use /std/time/{Timestamp};
use /std/internal/{Status, temporary_path};
use /std/Bool/{Holds};

--- What is at a path.
pub induct Kind: pub Type
| file()
| directory()
--- A symbolic link.
| symlink()
--- Anything else the host holds at a path.
| other()
end

satisfy Eql(Kind) {
    ..
}

satisfy Show(Kind) {
    show(k) =
        match k
        | file() => "file"
        | directory() => "directory"
        | symlink() => "symlink"
        | other() => "other"
        end,
}

--- The kind a code of `file_stat`'s names, where it names one.
let kind_of(code: Nat) -> Option(Kind) =
    match
    | code == /sys/file_kind/file => Option/some(Kind/file())
    | code == /sys/file_kind/directory => Option/some(Kind/directory())
    | code == /sys/file_kind/symlink => Option/some(Kind/symlink())
    | code == /sys/file_kind/other => Option/some(Kind/other())
    | _ => Option/none()
    end;

--- What `stat` reports.
pub struct Metadata: pub Type {
    kind: Kind,
    --- The size in bytes.
    size: Nat,
    --- When the contents last changed.
    mtime: Timestamp,
}

--- What is at this path: `ok` beside its kind, one of `/sys/file_kind`'s codes, its size in bytes and when its contents last changed, or the status of the failure.
foreign file_stat(Bytes) -> {status: Nat, kind: Nat, size: Nat, mtime_secs: Int, mtime_nanos: Nat};

--- What is at this path itself, a symbolic link reported as one and never followed: `ok` beside its kind, one of `/sys/file_kind`'s codes, its size in bytes and when its contents last changed, or the status of the failure.
foreign file_link_stat(Bytes) -> {
    status: Nat,
    kind: Nat,
    size: Nat,
    mtime_secs: Int,
    mtime_nanos: Nat};

-- What a reply of `file_stat` or `file_link_stat` reports. A kind the host names by no code this library knows is a reply its row rules out.
let metadata_of(
    reply: {status: Nat, kind: Nat, size: Nat, mtime_secs: Int, mtime_nanos: Nat},
) -> Try(Io, Io/Error, Metadata) =
    let () = Status/succeeded(reply.status)!;
    match kind_of(reply.kind)
    | some(kind) =>
        Try/pure(
            Metadata {
                kind = kind,
                size = reply.size,
                mtime =
                    Timestamp/of_unix_nanos(
                        reply.mtime_secs * 1000000000 + Nat/to_int(reply.mtime_nanos)) })
    | none() => Try/raise(Io/Error/invalid_reply())
    end;

--- What is at `path`, following a symbolic link to what it names: a link to a directory is a `directory()`, and only a link that names nothing is a `symlink()`. POSIX's `stat(2)`.
pub let stat(path: Path) -> Try(Io, Io/Error, Metadata) =
    let reply = file_stat(Path/to_bytes(path))!;
    metadata_of(reply);

--- What is at `path` itself, a symbolic link never followed: a link is a `symlink()` whatever it names, its size and time the link's own. What a program reads before acting on a path it must not act through, as a walk does; POSIX's `lstat(2)`.
pub let lstat(path: Path) -> Try(Io, Io/Error, Metadata) =
    let reply = file_link_stat(Path/to_bytes(path))!;
    metadata_of(reply);

let kind_is(path: Path, want: (Kind) -> Bool) -> Try(Io, Io/Error, Bool) =
    let r = Try/run(stat(path))!;
    match r
    | success(m) => Try/pure(want(m.kind))
    | failure(not_found()) => Try/pure(false)
    | failure(e) => Try/raise(e)
    end;

--- Whether anything is at `path`.
pub let exists(path: Path) -> Try(Io, Io/Error, Bool) =
    kind_is(path, (_) => true);

--- Whether a regular file is at `path`.
pub let is_file(path: Path) -> Try(Io, Io/Error, Bool) =
    kind_is(path, (k) => k == Kind/file());

--- Whether a directory is at `path`.
pub let is_dir(path: Path) -> Try(Io, Io/Error, Bool) =
    kind_is(path, (k) => k == Kind/directory());

--- The names in the directory at this path: `ok` beside them, or the status of the failure.
foreign dir_list(Bytes) -> {status: Nat, names: List(Bytes)};

--- The entries' names, each a `Path` that `Path/join` puts back under `path`.
pub let list(path: Path) -> Try(Io, Io/Error, List(Path)) =
    let reply = dir_list(Path/to_bytes(path))!;
    let () = Status/succeeded(reply.status)!;
    Try/pure(List/map(reply.names, Path/of_bytes));

--- Create the directory at this path, its owner's alone where the flag is set: `ok`, or the status of the failure.
foreign dir_create(Bytes, Bool) -> Nat;

--- A directory at `path`, whose parent must exist.
pub let create_dir(path: Path) -> Try(Io, Io/Error, {}) =
    let status = dir_create(Path/to_bytes(path), false)!;
    Status/succeeded(status);

-- What is at `path` removed, a failure to remove it dropped: what a temporary directory's scope does as it ends, whether or not the program removed it first.
let removed(path: Path) -> Io({}) =
    let _ = Try/run(remove_all(path))!;
    Io/pure(());

--- A new empty directory under the system's temporary directory — the one `TMPDIR` names, or `/tmp` — its name `prefix` and sixteen random hexadecimal digits, which `s` removes with all it holds when it ends, and its owner's alone. A name something holds already is drawn again, and `prefix` holds no `/`, which would name another directory: decided where it is written, so a literal one needs nothing more. Python's `tempfile.mkdtemp` and Go's `os.MkdirTemp`.
pub let temp_dir(
    s: Io/Scope,
    prefix: Str,
    @plain: Holds(Bool/not(Str/contains(prefix, '/'))),
) -> Try(Io, Io/Error, Path) =
    let path = temporary_path(prefix)!;
    let status = dir_create(Path/to_bytes(path), true)!;
    let created = Try/run(Status/succeeded(status))!;
    match created
    | success(()) =>
        let () = Io/Scope/defer(s, (_) => removed(path))!;
        Try/pure(path)
    | failure(already_exists()) => temp_dir(s, prefix)
    | failure(failed) => Try/raise(failed)
    end;

--- Remove the directory at this path: `ok`, or the status of the failure.
foreign dir_remove(Bytes) -> Nat;

--- Remove the empty directory at `path`.
pub let remove_dir(path: Path) -> Try(Io, Io/Error, {}) =
    let status = dir_remove(Path/to_bytes(path))!;
    Status/succeeded(status);

--- Remove the file at this path: `ok`, or the status of the failure.
foreign file_remove(Bytes) -> Nat;

--- Remove the file at `path`.
pub let remove_file(path: Path) -> Try(Io, Io/Error, {}) =
    let status = file_remove(Path/to_bytes(path))!;
    Status/succeeded(status);

--- Rename what is at the first path to the second: `ok`, or the status of the failure.
foreign file_rename(Bytes, Bytes) -> Nat;

--- Move what is at `from` to `to`.
pub let rename(from: Path, to: Path) -> Try(Io, Io/Error, {}) =
    let status = file_rename(Path/to_bytes(from), Path/to_bytes(to))!;
    Status/succeeded(status);

--- A directory at `path` and every missing parent; one that already exists is left as it is.
pub let create_dir_all(path: Path) -> Try(Io, Io/Error, {}) =
    let r = Try/run(create_dir(path))!;
    match r
    | success(()) => Try/pure(())
    | failure(e) =>
        match e
        | already_exists() => Try/pure(())
        | not_found() =>
            match Path/parent(path)
            | some(parent) =>
                let () = create_dir_all(parent)!;
                create_dir(path)
            | none() => Try/raise(e)
            end
        | _ => Try/raise(e)
        end
    end;

--- Every path beneath the directory at `path`, each joined onto it: a directory before what it holds, and each directory's entries in the order `list` gives them, which sorts them. A symbolic link is listed and never followed, so a walk ends however the links point, and the first failure ends the walk.
pub let walk(path: Path) -> Try(Io, Io/Error, List(Path)) =
    let entries = list(path)!;
    walked(path, entries)
and walked(directory: Path, entries: List(Path)) -> Try(Io, Io/Error, List(Path)) =
    match entries
    | [] => Try/pure([])
    | [entry, ..rest] =>
        let joined = Path/join(directory, entry);
        let found = lstat(joined)!;
        let beneath =
            match found.kind | directory() => walk(joined) | _ => Try/pure([]) end;
        let inner = beneath!;
        let after = walked(directory, rest)!;
        Try/pure([joined, ..inner, ..after])
    end;

--- Remove what is at `path`, a directory's entries first. A symbolic link is removed as itself and never followed, so nothing outside the tree at `path` is removed through one, as `rm -r` removes a tree.
pub let remove_all(path: Path) -> Try(Io, Io/Error, {}) =
    let m = lstat(path)!;
    match m.kind
    | directory() =>
        let entries = list(path)!;
        let () = remove_each(path, entries)!;
        remove_dir(path)
    | _ => remove_file(path)
    end
and remove_each(dir: Path, entries: List(Path)) -> Try(Io, Io/Error, {}) =
    match entries
    | [] => Try/pure(())
    | [entry, ..rest] =>
        let () = remove_all(Path/join(dir, entry))!;
        remove_each(dir, rest)
    end;
