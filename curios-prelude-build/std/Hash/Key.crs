use /std/{Bytes, Bool, Eq, Hash, Ordering, proved};
use /std/ops/{Ord};
use /std/Bool/{False, Holds};

--- How a key type encodes to the byte string that identifies it, with the proof that the encodings stand in the keys' own order.
---
--- The encoding is `/std/Hash`'s and the order `/std/ops/Ord`'s, reached through the concept's parents rather than restated, so a type has one identity as bytes and one order. The concept adds the one law neither parent carries, `mono`, so a walk of the trie, which follows the encodings, follows the keys' order; that distinct keys encode distinctly, so the trie never merges two keys into one entry, follows from it ([`inj`]). A witness whose encoding collides or breaks the order is refused where it is declared.
---
--- A type with an encoding and no order of its own takes its encoding's, and its `mono` is `Eq/refl()`.
pub concept Key(K: Type): pub Type {
    use Hash(K),
    use Ord(K),
    --- The order of two keys is the order of their encodings, as `Bytes/ord` reads them.
    mono(a: K, b: K) -> Eq()(Ord/ord(a, b), Bytes/ord(Hash/hash(a), Hash/hash(b))),
}

pub use Key/*;

-- Two keys of one encoding are `eq` in the encodings' order, so in their own by `mono`, and two keys their order ties are one.
--- Distinct keys encode distinctly.
pub let inj(
    @K: Type,
    use Key(K),
    a: K,
    b: K,
    same: Eq()(Hash/hash(a), Hash/hash(b)),
) -> Eq()(a, b) =
    Ord/eq(
        a,
        b,
        Eq/trans(
            mono(a, b),
            Eq/subst(
                (z: Bytes) => Eq()(Bytes/ord(Hash/hash(a), z), Ordering/eq()),
                same,
                Ord/refl(Hash/hash(a)))));

--- Two keys whose encodings compare equal are one key: the encodings are one run, and [`inj`] takes that to the keys.
pub let same(
    @K: Type,
    use Key(K),
    a: K,
    b: K,
    h: Holds(Hash/hash(a) == Hash/hash(b)),
) -> Eq()(a, b) =
    inj(a, b, proved());

--- Two keys whose encodings compare unequal are two keys: one key encodes as itself.
pub let apart(
    @K: Type,
    use Key(K),
    a: K,
    b: K,
    h: Holds(Bool/not(Hash/hash(a) == Hash/hash(b))),
) -> (Eq()(b, a)) -> False =
    (same) => Eq/subst((y: K) => Holds(Bool/not(Hash/hash(a) == Hash/hash(y))), same, h);

-- The part's answer read off its encodings, the encodings' delimited order read as their step, and the two steps taken in turn.
--- A derived key's comparison stepped through a part before its last: where the comparison so far `acc` stepped by the part's answer `o`, which `part` reads off the part's encodings `x` and `y`, and then by what follows, `s` against `u`, is the whole comparison, so is `acc` stepped by the delimited part and what follows it. What a derived `mono` is written through, a part at a time from the last back.
pub let then(
    acc: Ordering,
    o: Ordering,
    x: Bytes,
    y: Bytes,
    s: Bytes,
    u: Bytes,
    part: Eq()(o, Bytes/ord(x, y)),
    whole: Ordering,
    later: Eq()(whole, Ordering/then(Ordering/then(acc, o), Bytes/ord(s, u))),
) -> Eq()(
    whole,
    Ordering/then(acc, Bytes/ord(0x[..Hash/delimited(x), ..s], 0x[..Hash/delimited(y), ..u]))) =
    Eq/trans(
        later,
        Eq/trans(
            Eq/cong((p: Ordering) => Ordering/then(Ordering/then(acc, p), Bytes/ord(s, u)), part),
            Eq/trans(
                Ordering/then/assoc(acc, Bytes/ord(x, y), Bytes/ord(s, u)),
                Eq/cong(
                    (p: Ordering) => Ordering/then(acc, p),
                    Eq/sym(Hash/delimited/ord(x, y, s, u))))));

--- A derived key's comparison stepped through its last part, which stands undelimited: the comparison so far `acc` stepped by the part's answer `o` is `acc` stepped by its encodings' order, which `part` reads it as.
pub let last(
    acc: Ordering,
    o: Ordering,
    x: Bytes,
    y: Bytes,
    part: Eq()(o, Bytes/ord(x, y)),
) -> Eq()(Ordering/then(acc, o), Ordering/then(acc, Bytes/ord(x, y))) =
    Eq/cong((p: Ordering) => Ordering/then(acc, p), part);
