use /std/{Bytes, Bool, Str, Path, Try, Io, fs};
use /std/internal/{Handle, read_to_end, temporary_path};

--- An open file.
pub struct File: Type {
    Handle,
}

--- How a file is opened: to read, to write from the start, to append, to read and write, or to create.
pub induct Mode: pub Type
--- Opened to read.
| read()
--- Opened to write, created if absent and emptied if present.
| write()
--- Opened to write after what is there, created if absent.
| append()
--- Opened to read and to write where it stands, neither created nor truncated.
| read_write()
--- Opened to write a file this open creates, refused with `already_exists` where anything is at the path: how a lock file, or a name no other process holds, is taken with no race between looking and creating.
| create()
--- Opened to write a file this open creates, as `create()` is, readable and writable by its owner alone: how a temporary file no other user of the machine reads is taken.
| create_private()
end

--- The file at `path`, opened in `mode` into `s`, which closes it when it ends.
pub let open(s: Io/Scope, path: Path, mode: Mode) -> Try(Io, Io/Error, File) =
    let h = Handle/open(Path/to_bytes(path), mode)!;
    let f = File { h };
    let () = Io/Scope/defer(s, (_) => Io/close(f))!;
    Try/pure(f);

--- A new empty file under the system's temporary directory — the one `TMPDIR` names, or `/tmp` — its name `prefix` and sixteen random hexadecimal digits, opened to write into `s`, which closes and removes it when it ends, and readable by its owner alone: its path beside it. A name another file holds already is drawn again, and `prefix` holds no `/`, which would name another directory: decided where it is written, so a literal one needs nothing more. Python's `tempfile.NamedTemporaryFile` and Go's `os.CreateTemp`.
pub let temp(
    s: Io/Scope,
    prefix: Str,
    @plain: Bool/Holds(Bool/not(Str/contains(prefix, '/'))),
) -> Try(Io, Io/Error, {path: Path, file: File}) =
    let path = temporary_path(prefix)!;
    let opened = Try/run(open(s, path, Mode/create_private()))!;
    match opened
    | success(file) =>
        let () = Io/Scope/defer(s, (_) => closed_and_removed(file, path))!;
        Try/pure((path = path, file = file))
    | failure(already_exists()) => temp(s, prefix)
    | failure(failed) => Try/raise(failed)
    end;

-- `file` closed and the file at `path` removed, a failure to remove it dropped: what a temporary file's scope does as it ends, whether or not the program moved or removed it first.
let closed_and_removed(file: File, path: Path) -> Io({}) =
    let () = Io/close(file)!;
    let _ = Try/run(fs/remove_file(path))!;
    Io/pure(());

--- Close `f` before its scope ends. The scope's own close then finds nothing to close.
satisfy Io/Close(File) {
    close(f) = Io/close(f.0),
}

satisfy Io/Read(File) {
    read(f, n, @positive) = Io/read(@Handle, f.0, n, @positive),
}

satisfy Io/Write(File) {
    write(f, b) = Io/write(f.0, b),
    flush(f) = Io/flush(f.0),
}

--- The whole file at `path`.
pub let read_all(path: Path) -> Try(Io, Io/Error, Bytes) =
    Try/scope((s) => Try/bind(open(s, path, Mode/read()), read_to_end));

--- The whole file at `path` as text: `read_all`, its bytes read as UTF-8. Bytes that are not text are `not_text` with the length of their longest prefix that is.
pub let read_all_text(path: Path) -> Try(Io, Io/Error, Str) =
    let bytes = read_all(path)!;
    match Str/of_bytes(bytes)
    | success(text) => Try/pure(text)
    | failure(valid) => Try/raise(Io/Error/not_text(valid))
    end;

--- `b` as the whole file at `path`: created if absent, replaced if present.
pub let write_all(path: Path, b: Bytes) -> Try(Io, Io/Error, {}) =
    Try/scope((s) => Try/bind(open(s, path, Mode/write()), (f) => Io/write(f, b)));
