satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    @F: Type,
    @G: Type,
    @H: Type,
    use Spell(A),
    use Spell(B),
    use Spell(C),
    use Spell(D),
    use Spell(E),
    use Spell(F),
    use Spell(G),
    use Spell(H),
) => Spell({A, B, C, D, E, F, G, H}) {
    spell(t) =
        parens([
            Spell/spell(t.0),
            Spell/spell(t.1),
            Spell/spell(t.2),
            Spell/spell(t.3),
            Spell/spell(t.4),
            Spell/spell(t.5),
            Spell/spell(t.6),
            Spell/spell(t.7)]),
}

-- Two tuples whose fields are one by one equal are one tuple, for each number of fields: a congruence written over field variables and applied at the projections, where an equation between two projections solves nothing. A law is applied outside it, at the projections: a field is below its record, so a family nested through a tuple descends through the law as it does through the method. `Eql`'s law and `Ord`'s both read it, each from its own equations of the fields.
let same1(@A: Type, x0: A, y0: A, e0: Eq()(x0, y0)) -> Eq()((x0,), (y0,)) =
    let refl() = e0;
    Eq/refl();

let same2(
    @A: Type,
    @B: Type,
    x0: A,
    x1: B,
    y0: A,
    y1: B,
    e0: Eq()(x0, y0),
    e1: Eq()(x1, y1),
) -> Eq()((x0, x1), (y0, y1)) =
    let refl() = e0;
    let refl() = e1;
    Eq/refl();

let same3(
    @A: Type,
    @B: Type,
    @C: Type,
    x0: A,
    x1: B,
    x2: C,
    y0: A,
    y1: B,
    y2: C,
    e0: Eq()(x0, y0),
    e1: Eq()(x1, y1),
    e2: Eq()(x2, y2),
) -> Eq()((x0, x1, x2), (y0, y1, y2)) =
    let refl() = e0;
    let refl() = e1;
    let refl() = e2;
    Eq/refl();

let same4(
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    x0: A,
    x1: B,
    x2: C,
    x3: D,
    y0: A,
    y1: B,
    y2: C,
    y3: D,
    e0: Eq()(x0, y0),
    e1: Eq()(x1, y1),
    e2: Eq()(x2, y2),
    e3: Eq()(x3, y3),
) -> Eq()((x0, x1, x2, x3), (y0, y1, y2, y3)) =
    let refl() = e0;
    let refl() = e1;
    let refl() = e2;
    let refl() = e3;
    Eq/refl();

let same5(
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    x0: A,
    x1: B,
    x2: C,
    x3: D,
    x4: E,
    y0: A,
    y1: B,
    y2: C,
    y3: D,
    y4: E,
    e0: Eq()(x0, y0),
    e1: Eq()(x1, y1),
    e2: Eq()(x2, y2),
    e3: Eq()(x3, y3),
    e4: Eq()(x4, y4),
) -> Eq()((x0, x1, x2, x3, x4), (y0, y1, y2, y3, y4)) =
    let refl() = e0;
    let refl() = e1;
    let refl() = e2;
    let refl() = e3;
    let refl() = e4;
    Eq/refl();

let same6(
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    @F: Type,
    x0: A,
    x1: B,
    x2: C,
    x3: D,
    x4: E,
    x5: F,
    y0: A,
    y1: B,
    y2: C,
    y3: D,
    y4: E,
    y5: F,
    e0: Eq()(x0, y0),
    e1: Eq()(x1, y1),
    e2: Eq()(x2, y2),
    e3: Eq()(x3, y3),
    e4: Eq()(x4, y4),
    e5: Eq()(x5, y5),
) -> Eq()((x0, x1, x2, x3, x4, x5), (y0, y1, y2, y3, y4, y5)) =
    let refl() = e0;
    let refl() = e1;
    let refl() = e2;
    let refl() = e3;
    let refl() = e4;
    let refl() = e5;
    Eq/refl();

let same7(
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    @F: Type,
    @G: Type,
    x0: A,
    x1: B,
    x2: C,
    x3: D,
    x4: E,
    x5: F,
    x6: G,
    y0: A,
    y1: B,
    y2: C,
    y3: D,
    y4: E,
    y5: F,
    y6: G,
    e0: Eq()(x0, y0),
    e1: Eq()(x1, y1),
    e2: Eq()(x2, y2),
    e3: Eq()(x3, y3),
    e4: Eq()(x4, y4),
    e5: Eq()(x5, y5),
    e6: Eq()(x6, y6),
) -> Eq()((x0, x1, x2, x3, x4, x5, x6), (y0, y1, y2, y3, y4, y5, y6)) =
    let refl() = e0;
    let refl() = e1;
    let refl() = e2;
    let refl() = e3;
    let refl() = e4;
    let refl() = e5;
    let refl() = e6;
    Eq/refl();

let same8(
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    @F: Type,
    @G: Type,
    @H: Type,
    x0: A,
    x1: B,
    x2: C,
    x3: D,
    x4: E,
    x5: F,
    x6: G,
    x7: H,
    y0: A,
    y1: B,
    y2: C,
    y3: D,
    y4: E,
    y5: F,
    y6: G,
    y7: H,
    e0: Eq()(x0, y0),
    e1: Eq()(x1, y1),
    e2: Eq()(x2, y2),
    e3: Eq()(x3, y3),
    e4: Eq()(x4, y4),
    e5: Eq()(x5, y5),
    e6: Eq()(x6, y6),
    e7: Eq()(x7, y7),
) -> Eq()((x0, x1, x2, x3, x4, x5, x6, x7), (y0, y1, y2, y3, y4, y5, y6, y7)) =
    let refl() = e0;
    let refl() = e1;
    let refl() = e2;
    let refl() = e3;
    let refl() = e4;
    let refl() = e5;
    let refl() = e6;
    let refl() = e7;
    Eq/refl();

satisfy Eql({}) {
    eql((), ()) = true,
    -- The unit has one value, so any two are one.
    eq((), (), _) = Eq/refl(),
    refl(()) = Bool/True/qed(),
}

satisfy (@A: Type, use Eql(A)) => Eql({A}) {
    eql(a, b) = a.0 == b.0,
    eq(a, b, h) = same1(a.0, b.0, proved()),
    refl(a) = Eql/refl(a.0),
}

satisfy (@A: Type, @B: Type, use Eql(A), use Eql(B)) => Eql({A, B}) {
    eql(a, b) = a.0 == b.0 && a.1 == b.1,
    eq(a, b, h) = same2(a.0, a.1, b.0, b.1, proved(), proved()),
    refl(a) = Bool/and/both(a.0 == a.0, a.1 == a.1, Eql/refl(a.0), Eql/refl(a.1)),
}

satisfy (@A: Type, @B: Type, @C: Type, use Eql(A), use Eql(B), use Eql(C)) => Eql({A, B, C}) {
    eql(a, b) = a.0 == b.0 && a.1 == b.1 && a.2 == b.2,
    eq(a, b, h) = same3(a.0, a.1, a.2, b.0, b.1, b.2, proved(), proved(), proved()),
    refl(a) =
        Bool/and/both(
            a.0 == a.0 && a.1 == a.1,
            a.2 == a.2,
            Bool/and/both(a.0 == a.0, a.1 == a.1, Eql/refl(a.0), Eql/refl(a.1)),
            Eql/refl(a.2)),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    use Eql(A),
    use Eql(B),
    use Eql(C),
    use Eql(D),
) => Eql({A, B, C, D}) {
    eql(a, b) = a.0 == b.0 && a.1 == b.1 && a.2 == b.2 && a.3 == b.3,
    eq(a, b, h) =
        same4(a.0, a.1, a.2, a.3, b.0, b.1, b.2, b.3, proved(), proved(), proved(), proved()),
    refl(a) =
        Bool/and/both(
            a.0 == a.0 && a.1 == a.1 && a.2 == a.2,
            a.3 == a.3,
            Bool/and/both(
                a.0 == a.0 && a.1 == a.1,
                a.2 == a.2,
                Bool/and/both(a.0 == a.0, a.1 == a.1, Eql/refl(a.0), Eql/refl(a.1)),
                Eql/refl(a.2)),
            Eql/refl(a.3)),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    use Eql(A),
    use Eql(B),
    use Eql(C),
    use Eql(D),
    use Eql(E),
) => Eql({A, B, C, D, E}) {
    eql(a, b) = a.0 == b.0 && a.1 == b.1 && a.2 == b.2 && a.3 == b.3 && a.4 == b.4,
    eq(a, b, h) =
        same5(
            a.0,
            a.1,
            a.2,
            a.3,
            a.4,
            b.0,
            b.1,
            b.2,
            b.3,
            b.4,
            proved(),
            proved(),
            proved(),
            proved(),
            proved()),
    refl(a) =
        Bool/and/both(
            a.0 == a.0 && a.1 == a.1 && a.2 == a.2 && a.3 == a.3,
            a.4 == a.4,
            Bool/and/both(
                a.0 == a.0 && a.1 == a.1 && a.2 == a.2,
                a.3 == a.3,
                Bool/and/both(
                    a.0 == a.0 && a.1 == a.1,
                    a.2 == a.2,
                    Bool/and/both(a.0 == a.0, a.1 == a.1, Eql/refl(a.0), Eql/refl(a.1)),
                    Eql/refl(a.2)),
                Eql/refl(a.3)),
            Eql/refl(a.4)),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    @F: Type,
    use Eql(A),
    use Eql(B),
    use Eql(C),
    use Eql(D),
    use Eql(E),
    use Eql(F),
) => Eql({A, B, C, D, E, F}) {
    eql(a, b) = a.0 == b.0 && a.1 == b.1 && a.2 == b.2 && a.3 == b.3 && a.4 == b.4 && a.5 == b.5,
    eq(a, b, h) =
        same6(
            a.0,
            a.1,
            a.2,
            a.3,
            a.4,
            a.5,
            b.0,
            b.1,
            b.2,
            b.3,
            b.4,
            b.5,
            proved(),
            proved(),
            proved(),
            proved(),
            proved(),
            proved()),
    refl(a) =
        Bool/and/both(
            a.0 == a.0 && a.1 == a.1 && a.2 == a.2 && a.3 == a.3 && a.4 == a.4,
            a.5 == a.5,
            Bool/and/both(
                a.0 == a.0 && a.1 == a.1 && a.2 == a.2 && a.3 == a.3,
                a.4 == a.4,
                Bool/and/both(
                    a.0 == a.0 && a.1 == a.1 && a.2 == a.2,
                    a.3 == a.3,
                    Bool/and/both(
                        a.0 == a.0 && a.1 == a.1,
                        a.2 == a.2,
                        Bool/and/both(a.0 == a.0, a.1 == a.1, Eql/refl(a.0), Eql/refl(a.1)),
                        Eql/refl(a.2)),
                    Eql/refl(a.3)),
                Eql/refl(a.4)),
            Eql/refl(a.5)),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    @F: Type,
    @G: Type,
    use Eql(A),
    use Eql(B),
    use Eql(C),
    use Eql(D),
    use Eql(E),
    use Eql(F),
    use Eql(G),
) => Eql({A, B, C, D, E, F, G}) {
    eql(a, b) =
        a.0 == b.0 && a.1 == b.1 && a.2 == b.2 && a.3 == b.3 && a.4 == b.4 && a.5 == b.5
            && a.6 == b.6,
    eq(a, b, h) =
        same7(
            a.0,
            a.1,
            a.2,
            a.3,
            a.4,
            a.5,
            a.6,
            b.0,
            b.1,
            b.2,
            b.3,
            b.4,
            b.5,
            b.6,
            proved(),
            proved(),
            proved(),
            proved(),
            proved(),
            proved(),
            proved()),
    refl(a) =
        Bool/and/both(
            a.0 == a.0 && a.1 == a.1 && a.2 == a.2 && a.3 == a.3 && a.4 == a.4 && a.5 == a.5,
            a.6 == a.6,
            Bool/and/both(
                a.0 == a.0 && a.1 == a.1 && a.2 == a.2 && a.3 == a.3 && a.4 == a.4,
                a.5 == a.5,
                Bool/and/both(
                    a.0 == a.0 && a.1 == a.1 && a.2 == a.2 && a.3 == a.3,
                    a.4 == a.4,
                    Bool/and/both(
                        a.0 == a.0 && a.1 == a.1 && a.2 == a.2,
                        a.3 == a.3,
                        Bool/and/both(
                            a.0 == a.0 && a.1 == a.1,
                            a.2 == a.2,
                            Bool/and/both(a.0 == a.0, a.1 == a.1, Eql/refl(a.0), Eql/refl(a.1)),
                            Eql/refl(a.2)),
                        Eql/refl(a.3)),
                    Eql/refl(a.4)),
                Eql/refl(a.5)),
            Eql/refl(a.6)),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    @F: Type,
    @G: Type,
    @H: Type,
    use Eql(A),
    use Eql(B),
    use Eql(C),
    use Eql(D),
    use Eql(E),
    use Eql(F),
    use Eql(G),
    use Eql(H),
) => Eql({A, B, C, D, E, F, G, H}) {
    eql(a, b) =
        a.0 == b.0 && a.1 == b.1 && a.2 == b.2 && a.3 == b.3 && a.4 == b.4 && a.5 == b.5
            && a.6 == b.6
            && a.7 == b.7,
    eq(a, b, h) =
        same8(
            a.0,
            a.1,
            a.2,
            a.3,
            a.4,
            a.5,
            a.6,
            a.7,
            b.0,
            b.1,
            b.2,
            b.3,
            b.4,
            b.5,
            b.6,
            b.7,
            proved(),
            proved(),
            proved(),
            proved(),
            proved(),
            proved(),
            proved(),
            proved()),
    refl(a) =
        Bool/and/both(
            a.0 == a.0 && a.1 == a.1 && a.2 == a.2 && a.3 == a.3 && a.4 == a.4 && a.5 == a.5
                && a.6 == a.6,
            a.7 == a.7,
            Bool/and/both(
                a.0 == a.0 && a.1 == a.1 && a.2 == a.2 && a.3 == a.3 && a.4 == a.4 && a.5 == a.5,
                a.6 == a.6,
                Bool/and/both(
                    a.0 == a.0 && a.1 == a.1 && a.2 == a.2 && a.3 == a.3 && a.4 == a.4,
                    a.5 == a.5,
                    Bool/and/both(
                        a.0 == a.0 && a.1 == a.1 && a.2 == a.2 && a.3 == a.3,
                        a.4 == a.4,
                        Bool/and/both(
                            a.0 == a.0 && a.1 == a.1 && a.2 == a.2,
                            a.3 == a.3,
                            Bool/and/both(
                                a.0 == a.0 && a.1 == a.1,
                                a.2 == a.2,
                                Bool/and/both(a.0 == a.0, a.1 == a.1, Eql/refl(a.0), Eql/refl(a.1)),
                                Eql/refl(a.2)),
                            Eql/refl(a.3)),
                        Eql/refl(a.4)),
                    Eql/refl(a.5)),
                Eql/refl(a.6)),
            Eql/refl(a.7)),
}

satisfy Ord({}) {
    ord((), ()) = Ordering/eq(),
    lt((), ()) = false,
    le((), ()) = true,
    flips((), ()) = Eq/refl(),
    trans((), (), (), _, _) = Bool/True/qed(),
    -- The unit has one value, so any two are one.
    eq((), (), _) = Eq/refl(),
    is_lt((), ()) = Eq/refl(),
    is_le((), ()) = Eq/refl(),
}

satisfy (@A: Type, use Ord(A)) => Ord({A}) {
    ord(a, b) = Ord/ord(a.0, b.0),
    lt(a, b) = Ordering/is_lt(Ord/ord(a.0, b.0)),
    le(a, b) = Ordering/is_le(Ord/ord(a.0, b.0)),
    flips(a, b) = Ord/flips(a.0, b.0),
    trans(a, b, c, p, q) = Ord/trans(a.0, b.0, c.0, p, q),
    eq(a, b, h) = same1(a.0, b.0, Ord/eq(a.0, b.0, h)),
    is_lt(_, _) = Eq/refl(),
    is_le(_, _) = Eq/refl(),
}

-- The order of two tuples of each number of fields past one: by the first field, and by the rest where it ties. Each is a function of its own, so its witness states `lt` and `le` over it and the laws read all three by reduction. The laws are the step's ([`Ordering/then`]), a field at a time: `flips` and the chaining `trans` closes on through each field's own, each step's answers written at its call, and the two tuples one where each step's two answers are `eq`.
let ord2(@A: Type, @B: Type, use Ord(A), use Ord(B), a: {A, B}, b: {A, B}) -> Ordering =
    then(Ord/ord(a.0, b.0), (()) => Ord/ord(a.1, b.1));

satisfy (@A: Type, @B: Type, use Ord(A), use Ord(B)) => Ord({A, B}) {
    ord = ord2,
    lt(a, b) = Ordering/is_lt(ord2(a, b)),
    le(a, b) = Ordering/is_le(ord2(a, b)),
    flips(a, b) = Ordering/then/flips(Ord/flips(a.0, b.0), (_) => Ord/flips(a.1, b.1)),
    trans(a, b, c, p, q) =
        Ordering/chains/le(
            ord2(a, b),
            ord2(b, c),
            ord2(a, c),
            Ordering/chains/then(Ord/chains(a.0, b.0, c.0), (_, _) => Ord/chains(a.1, b.1, c.1)),
            p,
            q),
    eq(a, b, h) =
        let h1 = Ordering/then/second(Ord/ord(a.0, b.0), Ord/ord(a.1, b.1), h);
        same2(
            a.0,
            a.1,
            b.0,
            b.1,
            Ord/eq(a.0, b.0, Ordering/then/first(Ord/ord(a.0, b.0), Ord/ord(a.1, b.1), h)),
            Ord/eq(a.1, b.1, h1)),
    is_lt(_, _) = Eq/refl(),
    is_le(_, _) = Eq/refl(),
}

let ord3(
    @A: Type,
    @B: Type,
    @C: Type,
    use Ord(A),
    use Ord(B),
    use Ord(C),
    a: {A, B, C},
    b: {A, B, C},
) -> Ordering =
    then(Ord/ord(a.0, b.0), (()) => then(Ord/ord(a.1, b.1), (()) => Ord/ord(a.2, b.2)));

satisfy (@A: Type, @B: Type, @C: Type, use Ord(A), use Ord(B), use Ord(C)) => Ord({A, B, C}) {
    ord = ord3,
    lt(a, b) = Ordering/is_lt(ord3(a, b)),
    le(a, b) = Ordering/is_le(ord3(a, b)),
    flips(a, b) =
        Ordering/then/flips(
            Ord/flips(a.0, b.0),
            (_) => Ordering/then/flips(Ord/flips(a.1, b.1), (_) => Ord/flips(a.2, b.2))),
    trans(a, b, c, p, q) =
        Ordering/chains/le(
            ord3(a, b),
            ord3(b, c),
            ord3(a, c),
            Ordering/chains/then(
                Ord/chains(a.0, b.0, c.0),
                (_, _) =>
                    Ordering/chains/then(
                        Ord/chains(a.1, b.1, c.1),
                        (_, _) => Ord/chains(a.2, b.2, c.2))),
            p,
            q),
    eq(a, b, h) =
        let h1 =
            Ordering/then/second(
                Ord/ord(a.0, b.0),
                Ordering/then(Ord/ord(a.1, b.1), Ord/ord(a.2, b.2)),
                h);
        let h2 = Ordering/then/second(Ord/ord(a.1, b.1), Ord/ord(a.2, b.2), h1);
        same3(
            a.0,
            a.1,
            a.2,
            b.0,
            b.1,
            b.2,
            Ord/eq(
                a.0,
                b.0,
                Ordering/then/first(
                    Ord/ord(a.0, b.0),
                    Ordering/then(Ord/ord(a.1, b.1), Ord/ord(a.2, b.2)),
                    h)),
            Ord/eq(a.1, b.1, Ordering/then/first(Ord/ord(a.1, b.1), Ord/ord(a.2, b.2), h1)),
            Ord/eq(a.2, b.2, h2)),
    is_lt(_, _) = Eq/refl(),
    is_le(_, _) = Eq/refl(),
}

let ord4(
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    use Ord(A),
    use Ord(B),
    use Ord(C),
    use Ord(D),
    a: {A, B, C, D},
    b: {A, B, C, D},
) -> Ordering =
    then(
        Ord/ord(a.0, b.0),
        (()) =>
            then(Ord/ord(a.1, b.1), (()) => then(Ord/ord(a.2, b.2), (()) => Ord/ord(a.3, b.3))));

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    use Ord(A),
    use Ord(B),
    use Ord(C),
    use Ord(D),
) => Ord({A, B, C, D}) {
    ord = ord4,
    lt(a, b) = Ordering/is_lt(ord4(a, b)),
    le(a, b) = Ordering/is_le(ord4(a, b)),
    flips(a, b) =
        Ordering/then/flips(
            Ord/flips(a.0, b.0),
            (_) =>
                Ordering/then/flips(
                    Ord/flips(a.1, b.1),
                    (_) => Ordering/then/flips(Ord/flips(a.2, b.2), (_) => Ord/flips(a.3, b.3)))),
    trans(a, b, c, p, q) =
        Ordering/chains/le(
            ord4(a, b),
            ord4(b, c),
            ord4(a, c),
            Ordering/chains/then(
                Ord/chains(a.0, b.0, c.0),
                (_, _) =>
                    Ordering/chains/then(
                        Ord/chains(a.1, b.1, c.1),
                        (_, _) =>
                            Ordering/chains/then(
                                Ord/chains(a.2, b.2, c.2),
                                (_, _) => Ord/chains(a.3, b.3, c.3)))),
            p,
            q),
    eq(a, b, h) =
        let h1 =
            Ordering/then/second(
                Ord/ord(a.0, b.0),
                Ordering/then(
                    Ord/ord(a.1, b.1),
                    Ordering/then(Ord/ord(a.2, b.2), Ord/ord(a.3, b.3))),
                h);
        let h2 =
            Ordering/then/second(
                Ord/ord(a.1, b.1),
                Ordering/then(Ord/ord(a.2, b.2), Ord/ord(a.3, b.3)),
                h1);
        let h3 = Ordering/then/second(Ord/ord(a.2, b.2), Ord/ord(a.3, b.3), h2);
        same4(
            a.0,
            a.1,
            a.2,
            a.3,
            b.0,
            b.1,
            b.2,
            b.3,
            Ord/eq(
                a.0,
                b.0,
                Ordering/then/first(
                    Ord/ord(a.0, b.0),
                    Ordering/then(
                        Ord/ord(a.1, b.1),
                        Ordering/then(Ord/ord(a.2, b.2), Ord/ord(a.3, b.3))),
                    h)),
            Ord/eq(
                a.1,
                b.1,
                Ordering/then/first(
                    Ord/ord(a.1, b.1),
                    Ordering/then(Ord/ord(a.2, b.2), Ord/ord(a.3, b.3)),
                    h1)),
            Ord/eq(a.2, b.2, Ordering/then/first(Ord/ord(a.2, b.2), Ord/ord(a.3, b.3), h2)),
            Ord/eq(a.3, b.3, h3)),
    is_lt(_, _) = Eq/refl(),
    is_le(_, _) = Eq/refl(),
}

let ord5(
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    use Ord(A),
    use Ord(B),
    use Ord(C),
    use Ord(D),
    use Ord(E),
    a: {A, B, C, D, E},
    b: {A, B, C, D, E},
) -> Ordering =
    then(
        Ord/ord(a.0, b.0),
        (()) =>
            then(
                Ord/ord(a.1, b.1),
                (()) =>
                    then(
                        Ord/ord(a.2, b.2),
                        (()) => then(Ord/ord(a.3, b.3), (()) => Ord/ord(a.4, b.4)))));

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    use Ord(A),
    use Ord(B),
    use Ord(C),
    use Ord(D),
    use Ord(E),
) => Ord({A, B, C, D, E}) {
    ord = ord5,
    lt(a, b) = Ordering/is_lt(ord5(a, b)),
    le(a, b) = Ordering/is_le(ord5(a, b)),
    flips(a, b) =
        Ordering/then/flips(
            Ord/flips(a.0, b.0),
            (_) =>
                Ordering/then/flips(
                    Ord/flips(a.1, b.1),
                    (_) =>
                        Ordering/then/flips(
                            Ord/flips(a.2, b.2),
                            (_) =>
                                Ordering/then/flips(
                                    Ord/flips(a.3, b.3),
                                    (_) => Ord/flips(a.4, b.4))))),
    trans(a, b, c, p, q) =
        Ordering/chains/le(
            ord5(a, b),
            ord5(b, c),
            ord5(a, c),
            Ordering/chains/then(
                Ord/chains(a.0, b.0, c.0),
                (_, _) =>
                    Ordering/chains/then(
                        Ord/chains(a.1, b.1, c.1),
                        (_, _) =>
                            Ordering/chains/then(
                                Ord/chains(a.2, b.2, c.2),
                                (_, _) =>
                                    Ordering/chains/then(
                                        Ord/chains(a.3, b.3, c.3),
                                        (_, _) => Ord/chains(a.4, b.4, c.4))))),
            p,
            q),
    eq(a, b, h) =
        let h1 =
            Ordering/then/second(
                Ord/ord(a.0, b.0),
                Ordering/then(
                    Ord/ord(a.1, b.1),
                    Ordering/then(
                        Ord/ord(a.2, b.2),
                        Ordering/then(Ord/ord(a.3, b.3), Ord/ord(a.4, b.4)))),
                h);
        let h2 =
            Ordering/then/second(
                Ord/ord(a.1, b.1),
                Ordering/then(
                    Ord/ord(a.2, b.2),
                    Ordering/then(Ord/ord(a.3, b.3), Ord/ord(a.4, b.4))),
                h1);
        let h3 =
            Ordering/then/second(
                Ord/ord(a.2, b.2),
                Ordering/then(Ord/ord(a.3, b.3), Ord/ord(a.4, b.4)),
                h2);
        let h4 = Ordering/then/second(Ord/ord(a.3, b.3), Ord/ord(a.4, b.4), h3);
        same5(
            a.0,
            a.1,
            a.2,
            a.3,
            a.4,
            b.0,
            b.1,
            b.2,
            b.3,
            b.4,
            Ord/eq(
                a.0,
                b.0,
                Ordering/then/first(
                    Ord/ord(a.0, b.0),
                    Ordering/then(
                        Ord/ord(a.1, b.1),
                        Ordering/then(
                            Ord/ord(a.2, b.2),
                            Ordering/then(Ord/ord(a.3, b.3), Ord/ord(a.4, b.4)))),
                    h)),
            Ord/eq(
                a.1,
                b.1,
                Ordering/then/first(
                    Ord/ord(a.1, b.1),
                    Ordering/then(
                        Ord/ord(a.2, b.2),
                        Ordering/then(Ord/ord(a.3, b.3), Ord/ord(a.4, b.4))),
                    h1)),
            Ord/eq(
                a.2,
                b.2,
                Ordering/then/first(
                    Ord/ord(a.2, b.2),
                    Ordering/then(Ord/ord(a.3, b.3), Ord/ord(a.4, b.4)),
                    h2)),
            Ord/eq(a.3, b.3, Ordering/then/first(Ord/ord(a.3, b.3), Ord/ord(a.4, b.4), h3)),
            Ord/eq(a.4, b.4, h4)),
    is_lt(_, _) = Eq/refl(),
    is_le(_, _) = Eq/refl(),
}

let ord6(
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    @F: Type,
    use Ord(A),
    use Ord(B),
    use Ord(C),
    use Ord(D),
    use Ord(E),
    use Ord(F),
    a: {A, B, C, D, E, F},
    b: {A, B, C, D, E, F},
) -> Ordering =
    then(
        Ord/ord(a.0, b.0),
        (()) =>
            then(
                Ord/ord(a.1, b.1),
                (()) =>
                    then(
                        Ord/ord(a.2, b.2),
                        (()) =>
                            then(
                                Ord/ord(a.3, b.3),
                                (()) => then(Ord/ord(a.4, b.4), (()) => Ord/ord(a.5, b.5))))));

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    @F: Type,
    use Ord(A),
    use Ord(B),
    use Ord(C),
    use Ord(D),
    use Ord(E),
    use Ord(F),
) => Ord({A, B, C, D, E, F}) {
    ord = ord6,
    lt(a, b) = Ordering/is_lt(ord6(a, b)),
    le(a, b) = Ordering/is_le(ord6(a, b)),
    flips(a, b) =
        Ordering/then/flips(
            Ord/flips(a.0, b.0),
            (_) =>
                Ordering/then/flips(
                    Ord/flips(a.1, b.1),
                    (_) =>
                        Ordering/then/flips(
                            Ord/flips(a.2, b.2),
                            (_) =>
                                Ordering/then/flips(
                                    Ord/flips(a.3, b.3),
                                    (_) =>
                                        Ordering/then/flips(
                                            Ord/flips(a.4, b.4),
                                            (_) => Ord/flips(a.5, b.5)))))),
    trans(a, b, c, p, q) =
        Ordering/chains/le(
            ord6(a, b),
            ord6(b, c),
            ord6(a, c),
            Ordering/chains/then(
                Ord/chains(a.0, b.0, c.0),
                (_, _) =>
                    Ordering/chains/then(
                        Ord/chains(a.1, b.1, c.1),
                        (_, _) =>
                            Ordering/chains/then(
                                Ord/chains(a.2, b.2, c.2),
                                (_, _) =>
                                    Ordering/chains/then(
                                        Ord/chains(a.3, b.3, c.3),
                                        (_, _) =>
                                            Ordering/chains/then(
                                                Ord/chains(a.4, b.4, c.4),
                                                (_, _) => Ord/chains(a.5, b.5, c.5)))))),
            p,
            q),
    eq(a, b, h) =
        let h1 =
            Ordering/then/second(
                Ord/ord(a.0, b.0),
                Ordering/then(
                    Ord/ord(a.1, b.1),
                    Ordering/then(
                        Ord/ord(a.2, b.2),
                        Ordering/then(
                            Ord/ord(a.3, b.3),
                            Ordering/then(Ord/ord(a.4, b.4), Ord/ord(a.5, b.5))))),
                h);
        let h2 =
            Ordering/then/second(
                Ord/ord(a.1, b.1),
                Ordering/then(
                    Ord/ord(a.2, b.2),
                    Ordering/then(
                        Ord/ord(a.3, b.3),
                        Ordering/then(Ord/ord(a.4, b.4), Ord/ord(a.5, b.5)))),
                h1);
        let h3 =
            Ordering/then/second(
                Ord/ord(a.2, b.2),
                Ordering/then(
                    Ord/ord(a.3, b.3),
                    Ordering/then(Ord/ord(a.4, b.4), Ord/ord(a.5, b.5))),
                h2);
        let h4 =
            Ordering/then/second(
                Ord/ord(a.3, b.3),
                Ordering/then(Ord/ord(a.4, b.4), Ord/ord(a.5, b.5)),
                h3);
        let h5 = Ordering/then/second(Ord/ord(a.4, b.4), Ord/ord(a.5, b.5), h4);
        same6(
            a.0,
            a.1,
            a.2,
            a.3,
            a.4,
            a.5,
            b.0,
            b.1,
            b.2,
            b.3,
            b.4,
            b.5,
            Ord/eq(
                a.0,
                b.0,
                Ordering/then/first(
                    Ord/ord(a.0, b.0),
                    Ordering/then(
                        Ord/ord(a.1, b.1),
                        Ordering/then(
                            Ord/ord(a.2, b.2),
                            Ordering/then(
                                Ord/ord(a.3, b.3),
                                Ordering/then(Ord/ord(a.4, b.4), Ord/ord(a.5, b.5))))),
                    h)),
            Ord/eq(
                a.1,
                b.1,
                Ordering/then/first(
                    Ord/ord(a.1, b.1),
                    Ordering/then(
                        Ord/ord(a.2, b.2),
                        Ordering/then(
                            Ord/ord(a.3, b.3),
                            Ordering/then(Ord/ord(a.4, b.4), Ord/ord(a.5, b.5)))),
                    h1)),
            Ord/eq(
                a.2,
                b.2,
                Ordering/then/first(
                    Ord/ord(a.2, b.2),
                    Ordering/then(
                        Ord/ord(a.3, b.3),
                        Ordering/then(Ord/ord(a.4, b.4), Ord/ord(a.5, b.5))),
                    h2)),
            Ord/eq(
                a.3,
                b.3,
                Ordering/then/first(
                    Ord/ord(a.3, b.3),
                    Ordering/then(Ord/ord(a.4, b.4), Ord/ord(a.5, b.5)),
                    h3)),
            Ord/eq(a.4, b.4, Ordering/then/first(Ord/ord(a.4, b.4), Ord/ord(a.5, b.5), h4)),
            Ord/eq(a.5, b.5, h5)),
    is_lt(_, _) = Eq/refl(),
    is_le(_, _) = Eq/refl(),
}

let ord7(
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    @F: Type,
    @G: Type,
    use Ord(A),
    use Ord(B),
    use Ord(C),
    use Ord(D),
    use Ord(E),
    use Ord(F),
    use Ord(G),
    a: {A, B, C, D, E, F, G},
    b: {A, B, C, D, E, F, G},
) -> Ordering =
    then(
        Ord/ord(a.0, b.0),
        (()) =>
            then(
                Ord/ord(a.1, b.1),
                (()) =>
                    then(
                        Ord/ord(a.2, b.2),
                        (()) =>
                            then(
                                Ord/ord(a.3, b.3),
                                (()) =>
                                    then(
                                        Ord/ord(a.4, b.4),
                                        (()) =>
                                            then(Ord/ord(a.5, b.5), (()) => Ord/ord(a.6, b.6)))))));

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    @F: Type,
    @G: Type,
    use Ord(A),
    use Ord(B),
    use Ord(C),
    use Ord(D),
    use Ord(E),
    use Ord(F),
    use Ord(G),
) => Ord({A, B, C, D, E, F, G}) {
    ord = ord7,
    lt(a, b) = Ordering/is_lt(ord7(a, b)),
    le(a, b) = Ordering/is_le(ord7(a, b)),
    flips(a, b) =
        Ordering/then/flips(
            Ord/flips(a.0, b.0),
            (_) =>
                Ordering/then/flips(
                    Ord/flips(a.1, b.1),
                    (_) =>
                        Ordering/then/flips(
                            Ord/flips(a.2, b.2),
                            (_) =>
                                Ordering/then/flips(
                                    Ord/flips(a.3, b.3),
                                    (_) =>
                                        Ordering/then/flips(
                                            Ord/flips(a.4, b.4),
                                            (_) =>
                                                Ordering/then/flips(
                                                    Ord/flips(a.5, b.5),
                                                    (_) => Ord/flips(a.6, b.6))))))),
    trans(a, b, c, p, q) =
        Ordering/chains/le(
            ord7(a, b),
            ord7(b, c),
            ord7(a, c),
            Ordering/chains/then(
                Ord/chains(a.0, b.0, c.0),
                (_, _) =>
                    Ordering/chains/then(
                        Ord/chains(a.1, b.1, c.1),
                        (_, _) =>
                            Ordering/chains/then(
                                Ord/chains(a.2, b.2, c.2),
                                (_, _) =>
                                    Ordering/chains/then(
                                        Ord/chains(a.3, b.3, c.3),
                                        (_, _) =>
                                            Ordering/chains/then(
                                                Ord/chains(a.4, b.4, c.4),
                                                (_, _) =>
                                                    Ordering/chains/then(
                                                        Ord/chains(a.5, b.5, c.5),
                                                        (_, _) => Ord/chains(a.6, b.6, c.6))))))),
            p,
            q),
    eq(a, b, h) =
        let h1 =
            Ordering/then/second(
                Ord/ord(a.0, b.0),
                Ordering/then(
                    Ord/ord(a.1, b.1),
                    Ordering/then(
                        Ord/ord(a.2, b.2),
                        Ordering/then(
                            Ord/ord(a.3, b.3),
                            Ordering/then(
                                Ord/ord(a.4, b.4),
                                Ordering/then(Ord/ord(a.5, b.5), Ord/ord(a.6, b.6)))))),
                h);
        let h2 =
            Ordering/then/second(
                Ord/ord(a.1, b.1),
                Ordering/then(
                    Ord/ord(a.2, b.2),
                    Ordering/then(
                        Ord/ord(a.3, b.3),
                        Ordering/then(
                            Ord/ord(a.4, b.4),
                            Ordering/then(Ord/ord(a.5, b.5), Ord/ord(a.6, b.6))))),
                h1);
        let h3 =
            Ordering/then/second(
                Ord/ord(a.2, b.2),
                Ordering/then(
                    Ord/ord(a.3, b.3),
                    Ordering/then(
                        Ord/ord(a.4, b.4),
                        Ordering/then(Ord/ord(a.5, b.5), Ord/ord(a.6, b.6)))),
                h2);
        let h4 =
            Ordering/then/second(
                Ord/ord(a.3, b.3),
                Ordering/then(
                    Ord/ord(a.4, b.4),
                    Ordering/then(Ord/ord(a.5, b.5), Ord/ord(a.6, b.6))),
                h3);
        let h5 =
            Ordering/then/second(
                Ord/ord(a.4, b.4),
                Ordering/then(Ord/ord(a.5, b.5), Ord/ord(a.6, b.6)),
                h4);
        let h6 = Ordering/then/second(Ord/ord(a.5, b.5), Ord/ord(a.6, b.6), h5);
        same7(
            a.0,
            a.1,
            a.2,
            a.3,
            a.4,
            a.5,
            a.6,
            b.0,
            b.1,
            b.2,
            b.3,
            b.4,
            b.5,
            b.6,
            Ord/eq(
                a.0,
                b.0,
                Ordering/then/first(
                    Ord/ord(a.0, b.0),
                    Ordering/then(
                        Ord/ord(a.1, b.1),
                        Ordering/then(
                            Ord/ord(a.2, b.2),
                            Ordering/then(
                                Ord/ord(a.3, b.3),
                                Ordering/then(
                                    Ord/ord(a.4, b.4),
                                    Ordering/then(Ord/ord(a.5, b.5), Ord/ord(a.6, b.6)))))),
                    h)),
            Ord/eq(
                a.1,
                b.1,
                Ordering/then/first(
                    Ord/ord(a.1, b.1),
                    Ordering/then(
                        Ord/ord(a.2, b.2),
                        Ordering/then(
                            Ord/ord(a.3, b.3),
                            Ordering/then(
                                Ord/ord(a.4, b.4),
                                Ordering/then(Ord/ord(a.5, b.5), Ord/ord(a.6, b.6))))),
                    h1)),
            Ord/eq(
                a.2,
                b.2,
                Ordering/then/first(
                    Ord/ord(a.2, b.2),
                    Ordering/then(
                        Ord/ord(a.3, b.3),
                        Ordering/then(
                            Ord/ord(a.4, b.4),
                            Ordering/then(Ord/ord(a.5, b.5), Ord/ord(a.6, b.6)))),
                    h2)),
            Ord/eq(
                a.3,
                b.3,
                Ordering/then/first(
                    Ord/ord(a.3, b.3),
                    Ordering/then(
                        Ord/ord(a.4, b.4),
                        Ordering/then(Ord/ord(a.5, b.5), Ord/ord(a.6, b.6))),
                    h3)),
            Ord/eq(
                a.4,
                b.4,
                Ordering/then/first(
                    Ord/ord(a.4, b.4),
                    Ordering/then(Ord/ord(a.5, b.5), Ord/ord(a.6, b.6)),
                    h4)),
            Ord/eq(a.5, b.5, Ordering/then/first(Ord/ord(a.5, b.5), Ord/ord(a.6, b.6), h5)),
            Ord/eq(a.6, b.6, h6)),
    is_lt(_, _) = Eq/refl(),
    is_le(_, _) = Eq/refl(),
}

let ord8(
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    @F: Type,
    @G: Type,
    @H: Type,
    use Ord(A),
    use Ord(B),
    use Ord(C),
    use Ord(D),
    use Ord(E),
    use Ord(F),
    use Ord(G),
    use Ord(H),
    a: {A, B, C, D, E, F, G, H},
    b: {A, B, C, D, E, F, G, H},
) -> Ordering =
    then(
        Ord/ord(a.0, b.0),
        (()) =>
            then(
                Ord/ord(a.1, b.1),
                (()) =>
                    then(
                        Ord/ord(a.2, b.2),
                        (()) =>
                            then(
                                Ord/ord(a.3, b.3),
                                (()) =>
                                    then(
                                        Ord/ord(a.4, b.4),
                                        (()) =>
                                            then(
                                                Ord/ord(a.5, b.5),
                                                (()) =>
                                                    then(
                                                        Ord/ord(a.6, b.6),
                                                        (()) => Ord/ord(a.7, b.7))))))));

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    @F: Type,
    @G: Type,
    @H: Type,
    use Ord(A),
    use Ord(B),
    use Ord(C),
    use Ord(D),
    use Ord(E),
    use Ord(F),
    use Ord(G),
    use Ord(H),
) => Ord({A, B, C, D, E, F, G, H}) {
    ord = ord8,
    lt(a, b) = Ordering/is_lt(ord8(a, b)),
    le(a, b) = Ordering/is_le(ord8(a, b)),
    flips(a, b) =
        Ordering/then/flips(
            Ord/flips(a.0, b.0),
            (_) =>
                Ordering/then/flips(
                    Ord/flips(a.1, b.1),
                    (_) =>
                        Ordering/then/flips(
                            Ord/flips(a.2, b.2),
                            (_) =>
                                Ordering/then/flips(
                                    Ord/flips(a.3, b.3),
                                    (_) =>
                                        Ordering/then/flips(
                                            Ord/flips(a.4, b.4),
                                            (_) =>
                                                Ordering/then/flips(
                                                    Ord/flips(a.5, b.5),
                                                    (_) =>
                                                        Ordering/then/flips(
                                                            Ord/flips(a.6, b.6),
                                                            (_) => Ord/flips(a.7, b.7)))))))),
    trans(a, b, c, p, q) =
        Ordering/chains/le(
            ord8(a, b),
            ord8(b, c),
            ord8(a, c),
            Ordering/chains/then(
                Ord/chains(a.0, b.0, c.0),
                (_, _) =>
                    Ordering/chains/then(
                        Ord/chains(a.1, b.1, c.1),
                        (_, _) =>
                            Ordering/chains/then(
                                Ord/chains(a.2, b.2, c.2),
                                (_, _) =>
                                    Ordering/chains/then(
                                        Ord/chains(a.3, b.3, c.3),
                                        (_, _) =>
                                            Ordering/chains/then(
                                                Ord/chains(a.4, b.4, c.4),
                                                (_, _) =>
                                                    Ordering/chains/then(
                                                        Ord/chains(a.5, b.5, c.5),
                                                        (_, _) =>
                                                            Ordering/chains/then(
                                                                Ord/chains(a.6, b.6, c.6),
                                                                (_, _) =>
                                                                    Ord/chains(
                                                                        a.7,
                                                                        b.7,
                                                                        c.7)))))))),
            p,
            q),
    eq(a, b, h) =
        let h1 =
            Ordering/then/second(
                Ord/ord(a.0, b.0),
                Ordering/then(
                    Ord/ord(a.1, b.1),
                    Ordering/then(
                        Ord/ord(a.2, b.2),
                        Ordering/then(
                            Ord/ord(a.3, b.3),
                            Ordering/then(
                                Ord/ord(a.4, b.4),
                                Ordering/then(
                                    Ord/ord(a.5, b.5),
                                    Ordering/then(Ord/ord(a.6, b.6), Ord/ord(a.7, b.7))))))),
                h);
        let h2 =
            Ordering/then/second(
                Ord/ord(a.1, b.1),
                Ordering/then(
                    Ord/ord(a.2, b.2),
                    Ordering/then(
                        Ord/ord(a.3, b.3),
                        Ordering/then(
                            Ord/ord(a.4, b.4),
                            Ordering/then(
                                Ord/ord(a.5, b.5),
                                Ordering/then(Ord/ord(a.6, b.6), Ord/ord(a.7, b.7)))))),
                h1);
        let h3 =
            Ordering/then/second(
                Ord/ord(a.2, b.2),
                Ordering/then(
                    Ord/ord(a.3, b.3),
                    Ordering/then(
                        Ord/ord(a.4, b.4),
                        Ordering/then(
                            Ord/ord(a.5, b.5),
                            Ordering/then(Ord/ord(a.6, b.6), Ord/ord(a.7, b.7))))),
                h2);
        let h4 =
            Ordering/then/second(
                Ord/ord(a.3, b.3),
                Ordering/then(
                    Ord/ord(a.4, b.4),
                    Ordering/then(
                        Ord/ord(a.5, b.5),
                        Ordering/then(Ord/ord(a.6, b.6), Ord/ord(a.7, b.7)))),
                h3);
        let h5 =
            Ordering/then/second(
                Ord/ord(a.4, b.4),
                Ordering/then(
                    Ord/ord(a.5, b.5),
                    Ordering/then(Ord/ord(a.6, b.6), Ord/ord(a.7, b.7))),
                h4);
        let h6 =
            Ordering/then/second(
                Ord/ord(a.5, b.5),
                Ordering/then(Ord/ord(a.6, b.6), Ord/ord(a.7, b.7)),
                h5);
        let h7 = Ordering/then/second(Ord/ord(a.6, b.6), Ord/ord(a.7, b.7), h6);
        same8(
            a.0,
            a.1,
            a.2,
            a.3,
            a.4,
            a.5,
            a.6,
            a.7,
            b.0,
            b.1,
            b.2,
            b.3,
            b.4,
            b.5,
            b.6,
            b.7,
            Ord/eq(
                a.0,
                b.0,
                Ordering/then/first(
                    Ord/ord(a.0, b.0),
                    Ordering/then(
                        Ord/ord(a.1, b.1),
                        Ordering/then(
                            Ord/ord(a.2, b.2),
                            Ordering/then(
                                Ord/ord(a.3, b.3),
                                Ordering/then(
                                    Ord/ord(a.4, b.4),
                                    Ordering/then(
                                        Ord/ord(a.5, b.5),
                                        Ordering/then(Ord/ord(a.6, b.6), Ord/ord(a.7, b.7))))))),
                    h)),
            Ord/eq(
                a.1,
                b.1,
                Ordering/then/first(
                    Ord/ord(a.1, b.1),
                    Ordering/then(
                        Ord/ord(a.2, b.2),
                        Ordering/then(
                            Ord/ord(a.3, b.3),
                            Ordering/then(
                                Ord/ord(a.4, b.4),
                                Ordering/then(
                                    Ord/ord(a.5, b.5),
                                    Ordering/then(Ord/ord(a.6, b.6), Ord/ord(a.7, b.7)))))),
                    h1)),
            Ord/eq(
                a.2,
                b.2,
                Ordering/then/first(
                    Ord/ord(a.2, b.2),
                    Ordering/then(
                        Ord/ord(a.3, b.3),
                        Ordering/then(
                            Ord/ord(a.4, b.4),
                            Ordering/then(
                                Ord/ord(a.5, b.5),
                                Ordering/then(Ord/ord(a.6, b.6), Ord/ord(a.7, b.7))))),
                    h2)),
            Ord/eq(
                a.3,
                b.3,
                Ordering/then/first(
                    Ord/ord(a.3, b.3),
                    Ordering/then(
                        Ord/ord(a.4, b.4),
                        Ordering/then(
                            Ord/ord(a.5, b.5),
                            Ordering/then(Ord/ord(a.6, b.6), Ord/ord(a.7, b.7)))),
                    h3)),
            Ord/eq(
                a.4,
                b.4,
                Ordering/then/first(
                    Ord/ord(a.4, b.4),
                    Ordering/then(
                        Ord/ord(a.5, b.5),
                        Ordering/then(Ord/ord(a.6, b.6), Ord/ord(a.7, b.7))),
                    h4)),
            Ord/eq(
                a.5,
                b.5,
                Ordering/then/first(
                    Ord/ord(a.5, b.5),
                    Ordering/then(Ord/ord(a.6, b.6), Ord/ord(a.7, b.7)),
                    h5)),
            Ord/eq(a.6, b.6, Ordering/then/first(Ord/ord(a.6, b.6), Ord/ord(a.7, b.7), h6)),
            Ord/eq(a.7, b.7, h7)),
    is_lt(_, _) = Eq/refl(),
    is_le(_, _) = Eq/refl(),
}
