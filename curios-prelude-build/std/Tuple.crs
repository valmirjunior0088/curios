use /std/{Bool, Eq, Show, Spell, Fmt, Ord, Ordering, Str, List, proved};
use /std/ops/{Eql};

let parens(parts: List(Str)) -> Str =
    Fmt/render("(%)")(Str/join(", ", parts));

-- `Ordering/then` with its second answer computed only where the first is `eq`. It is written with an arm for each answer, as that step is, so conversion holds the two one and the step's laws are this one's.
let then(first: Ordering, rest: ({}) -> Ordering) -> Ordering =
    match first
    | lt() => Ordering/lt()
    | eq() => rest(())
    | gt() => Ordering/gt()
    end;

satisfy Show({}) {
    show(()) = "()",
}

satisfy (@A: Type, use Show(A)) => Show({A}) {
    show(t) = Fmt/render("(%,)")(t.0),
}

satisfy (@A: Type, @B: Type, use Show(A), use Show(B)) => Show({A, B}) {
    show(t) = parens([Show/show(t.0), Show/show(t.1)]),
}

satisfy (@A: Type, @B: Type, @C: Type, use Show(A), use Show(B), use Show(C)) => Show({A, B, C}) {
    show(t) = parens([Show/show(t.0), Show/show(t.1), Show/show(t.2)]),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    use Show(A),
    use Show(B),
    use Show(C),
    use Show(D),
) => Show({A, B, C, D}) {
    show(t) = parens([Show/show(t.0), Show/show(t.1), Show/show(t.2), Show/show(t.3)]),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    use Show(A),
    use Show(B),
    use Show(C),
    use Show(D),
    use Show(E),
) => Show({A, B, C, D, E}) {
    show(t) =
        parens([Show/show(t.0), Show/show(t.1), Show/show(t.2), Show/show(t.3), Show/show(t.4)]),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    @F: Type,
    use Show(A),
    use Show(B),
    use Show(C),
    use Show(D),
    use Show(E),
    use Show(F),
) => Show({A, B, C, D, E, F}) {
    show(t) =
        parens([
            Show/show(t.0),
            Show/show(t.1),
            Show/show(t.2),
            Show/show(t.3),
            Show/show(t.4),
            Show/show(t.5)]),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    @F: Type,
    @G: Type,
    use Show(A),
    use Show(B),
    use Show(C),
    use Show(D),
    use Show(E),
    use Show(F),
    use Show(G),
) => Show({A, B, C, D, E, F, G}) {
    show(t) =
        parens([
            Show/show(t.0),
            Show/show(t.1),
            Show/show(t.2),
            Show/show(t.3),
            Show/show(t.4),
            Show/show(t.5),
            Show/show(t.6)]),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    @E: Type,
    @F: Type,
    @G: Type,
    @H: Type,
    use Show(A),
    use Show(B),
    use Show(C),
    use Show(D),
    use Show(E),
    use Show(F),
    use Show(G),
    use Show(H),
) => Show({A, B, C, D, E, F, G, H}) {
    show(t) =
        parens([
            Show/show(t.0),
            Show/show(t.1),
            Show/show(t.2),
            Show/show(t.3),
            Show/show(t.4),
            Show/show(t.5),
            Show/show(t.6),
            Show/show(t.7)]),
}

satisfy Spell({}) {
    spell(()) = "()",
}

satisfy (@A: Type, use Spell(A)) => Spell({A}) {
    spell(t) = Fmt/render("(#,)")(t.0),
}

satisfy (@A: Type, @B: Type, use Spell(A), use Spell(B)) => Spell({A, B}) {
    spell(t) = parens([Spell/spell(t.0), Spell/spell(t.1)]),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    use Spell(A),
    use Spell(B),
    use Spell(C),
) => Spell({A, B, C}) {
    spell(t) = parens([Spell/spell(t.0), Spell/spell(t.1), Spell/spell(t.2)]),
}

satisfy (
    @A: Type,
    @B: Type,
    @C: Type,
    @D: Type,
    use Spell(A),
    use Spell(B),
    use Spell(C),
    use Spell(D),
