use /std/{Str, Char, Bool, Bytes, Nat, Option, Eq, proved};
use /std/ops/{Eql};
use /std/Str/{At};

--- The first character at or after `from` that `pred` accepts, and where it is, or `none`: one walk over the bytes from `from`, which stops before it.
pub let seek(s: Str, from: At(s), pred: (Char) -> Bool) -> Option({at: At(s), char: Char}) =
    let rest = Str/after(s, from);
    let walked =
        Str/leading(
            rest.bytes,
            rest.valid,
            (c) => Bool/not(pred(c)),
            0,
            @rest.bytes,
            @proved(),
            @Eq/refl());
    match walked.stop
    | some(c) =>
        Option/some((
            at = At { offset = from.offset + walked.taken, @_, @boundary = walked.boundary },
            char = c))
    | none() => Option/none()
    end;

--- An occurrence of a needle at or after `from`: where it starts, which is not before `from`, and the position past it, which is past the start — the needle holds a character.
pub let Found(s: Str, from: At(s)) -> Type =
    {
        start: At(s),
        past: At(s),
        ordered: Bool/Holds(from.offset <= start.offset),
        progress: Bool/Holds(start.offset < past.offset)};

--- A character may begin at the front of bytes that begin with bytes, not empty, at whose front one may.
let starts_concat(
    a: Bytes,
    r: Bytes,
    some: Bool/Holds(0 < Bytes/length(a)),
    at: Bool/Holds(At/starts(a)),
) -> Bool/Holds(At/starts(0x[..a, ..r])) =
    match a
    | 0x[] => match some end
    | 0x[_, .._] => at
    end;

-- Searched as bytes, one walk over what follows `from`: a valid needle begins with a byte no character continues, so where its bytes stand they stand where a character begins, and valid text that holds them goes on past them as valid text. No character is decoded.
--- The first occurrence at or after `from` of the needle whose first character `first` reads, or `none`.
pub let occurrence(
    s: Str,
    from: At(s),
    needle: Str,
    first: {char: Char, past: At(needle), progress: Bool/Holds(0 < past.offset)},
) -> Option(Found(s, from)) =
    let n = Bytes/length(needle.bytes);
    let some: Bool/Holds(0 < n) =
        Nat/lt/of_lt_le(0, first.past.offset, n, first.progress, first.past.within);
    let lead_byte = Bytes/get(needle.bytes, 0, @some);
    let rest = Str/after(s, from);
    let go(
        b: Bytes,
        k: Nat,
        @w: Bool/Holds(k <= Bytes/length(rest.bytes)),
        @e: Eq()(Bytes/drop(rest.bytes, k, @w), b),
    ) -> Option(Found(s, from)) =
        match b
        | 0x[] => Option/none()
        | 0x[h, ..t] =>
            let onward = Str/passing(@rest.bytes, @0x[h], @t, k, w, e);
            match h == lead_byte
            | false => go(t, k + 1, @onward.within, @onward.cut)
            | true =>
                match Bool/holds(k + n <= Bytes/length(rest.bytes))
                | none() => go(t, k + 1, @onward.within, @onward.cut)
                | some(inside) =>
                    match Bytes/slice(rest.bytes, k, n, @inside) == needle.bytes
                    | false => go(t, k + 1, @onward.within, @onward.cut)
                    | true =>
                        let fits: Bool/Holds(n <= Bytes/length(b)) =
                            Eq/subst((x: Bytes) => Bool/Holds(n <= Bytes/length(x)), e, proved());
                        let held: Eq()(Bytes/slice(b, 0, n, @fits), needle.bytes) =
                            Eq/subst(
                                (x: Bytes) =>
                                    (q: Bool/Holds(n <= Bytes/length(x))) -> Eq()(
                                        Bytes/slice(x, 0, n, @q),
                                        needle.bytes),
                                e,
                                (_) =>
                                    Eql/eq_of_eql(
                                        Bytes/slice(rest.bytes, k, n, @inside),
                                        needle.bytes,
                                        proved()))(
                                fits);
                        let split: Eq()(b, 0x[..needle.bytes, ..Bytes/drop(b, n, @fits)]) =
                            Eq/trans(
                                Str/split_at(b, n, fits),
                                Eq/cong((p: Bytes) => 0x[..p, ..Bytes/drop(b, n, @fits)], held));
                        let begins: Bool/Holds(At/starts(Bytes/drop(rest.bytes, k, @w))) =
                            Eq/subst(
                                (w: Bytes) => Bool/Holds(At/starts(w)),
                                Eq/sym(e),
                                Eq/subst(
                                    (w: Bytes) => Bool/Holds(At/starts(w)),
                                    Eq/sym(split),
                                    starts_concat(
                                        needle.bytes,
                                        Bytes/drop(b, n, @fits),
                                        some,
                                        Str/Valid/begins(needle.valid))));
                        let valid_b: Str/Valid(b) =
                            Eq/subst(
                                (w: Bytes) => Str/Valid(w),
                                e,
                                Str/Valid/after(rest.valid, k, w, begins));
                        let past_valid: Str/Valid(Bytes/drop(b, n, @fits)) =
                            Str/Valid/after_prefix(
                                needle.valid,
                                Eq/subst((w: Bytes) => Str/Valid(w), split, valid_b));
                        let room: Bool/Holds(n <= Bytes/length(Bytes/drop(rest.bytes, k, @w))) =
                            Eq/subst(
                                (w: Bytes) => Bool/Holds(n <= Bytes/length(w)),
                                Eq/sym(e),
                                fits);
                        let ends: Bool/Holds(
                            At/starts(Bytes/drop(Bytes/drop(rest.bytes, k, @w), n, @room))) =
                            Eq/subst(
                                (w: Bytes) =>
                                    (q: Bool/Holds(n <= Bytes/length(w))) -> Bool/Holds(
                                        At/starts(Bytes/drop(w, n, @q))),
                                Eq/sym(e),
                                (_) => Str/Valid/begins(past_valid))(
                                room);
                        Option/some((
                            start = At { offset = from.offset + k, @_, @boundary = begins },
                            past = At { offset = from.offset + k + n, @_, @boundary = ends },
                            ordered = proved(),
                            progress = proved()))
                    end
                end
            end
        end;
    go(rest.bytes, 0, @proved(), @Eq/refl());

--- The first occurrence of `needle` in `s`: where it starts and the position past it, or `none`. An empty needle occurs at the start.
pub let first_occurrence(s: Str, needle: Str) -> Option({start: At(s), past: At(s)}) =
    match At/try_next(needle, At/start(needle))
    | none() => Option/some((start = At/start(s), past = At/start(s)))
    | some(first) =>
        match occurrence(s, At/start(s), needle, first)
        | some(found) => Option/some((start = found.start, past = found.past))
        | none() => Option/none()
        end
    end;

--- The last position at or before `from` past which `s` holds only characters `pred` accepts: one walk back.
pub let back_over(s: Str, from: At(s), pred: (Char) -> Bool) -> At(s) =
    At/backward(
        (_) => At(s),
        (at, again) =>
            match 0 < at.offset
            | true =>
                let p = At/prev(s, at);
                match pred(p.char)
                | true => again(p.past, p.progress)
                | false => at
                end
            | false => at
            end,
        from);
