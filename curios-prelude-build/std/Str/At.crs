--- The rules of UAX #29 that decide where an extended grapheme cluster ends.
mod grapheme;

use /std/{Nat, Bytes, Bool, Char, Option, Str, Eq, Ord, proved};
use /std/Char/{GraphemeBreak};
use /std/Str/{utf8};
use /std/ops/{Eql};

--- Whether a character may begin at the front of `rest`: it is empty, or its first byte continues none.
---
--- One byte decides it, which keeps a position cheap to check. One byte suffices because UTF-8 self-synchronizes: valid text cut where a character may begin is valid on both sides, as `Str/Valid/before` and `Str/Valid/after` prove.
pub let starts(rest: Bytes) -> Bool =
    match rest
    | 0x[] => true
    | 0x[h, .._] => Bool/not(utf8/continues(h))
    end;

--- A position in `s`: a byte offset at which a character may begin, with the bound and the boundary that say so, both erased.
pub struct At(s: Str): pub Type {
    --- The byte offset.
    offset: Nat,
    --- Why it lies within `s`.
    @within: Bool/Holds(offset <= Bytes/length(s.bytes)),
    --- Why a character may begin there.
    @boundary: Bool/Holds(starts(Bytes/drop(s.bytes, offset, @within))),
}

--- The start of `s`.
pub let start(s: Str) -> At(s) =
    At { offset = 0, @_, @boundary = Str/Valid/begins(s.valid) };

--- The end of `s`, past its last character.
pub let finish(s: Str) -> At(s) =
    At { offset = Bytes/length(s.bytes) };

--- The position `k` bytes into `s`, where `k` is known to lie within it and a character to begin there. Both discharge by reduction at a literal.
pub let of_offset(
    s: Str,
    k: Nat,
    @within: Bool/Holds(k <= Bytes/length(s.bytes)),
    @boundary: Bool/Holds(starts(Bytes/drop(s.bytes, k, @within))),
) -> At(s) =
    At { offset = k };

--- The position `k` bytes into `s`, or `none` when `k` is past the end or inside a character. Decided by the one byte at `k`.
pub let try_of_offset(s: Str, k: Nat) -> Option(At(s)) =
    match Bool/holds(k <= Bytes/length(s.bytes))
    | some(within), starts(Bytes/drop(s.bytes, k, @within)) => Option/some(At { offset = k })
    | _ => Option/none()
    end;

--- The byte offset of `at`.
pub let to_offset(@s: Str, at: At(s)) -> Nat =
    at.offset;

--- A position in the text after `at` as the position in `s` it is.
pub let of_after(s: Str, at: At(s), p: At(Str/after(s, at))) -> At(s) =
    At { offset = at.offset + p.offset };

-- The boundary is `p`'s own once the offset is read back: the text after `at`, dropped by `p.offset - at.offset`, is `s` dropped by `at.offset + (p.offset - at.offset)`, which is `p.offset` because `at` comes first.
--- A position at or after `at` as the position in the text after `at` it is: [`of_after`] read backwards.
pub let to_after(
    s: Str,
    at: At(s),
    p: At(s),
    @ordered: Bool/Holds(at.offset <= p.offset),
) -> At(Str/after(s, at)) =
    let back = Eq/sym(Nat/le/add_sub_cancel(at.offset, p.offset, ordered));
    At {
        offset = p.offset - at.offset,
        @_,
        @boundary =
            Eq/subst(
                (n: Nat) =>
                    (within: Bool/Holds(n <= Bytes/length(s.bytes))) -> Bool/Holds(
                        starts(Bytes/drop(s.bytes, n, @within))),
                back,
                (_) => p.boundary)(
                proved()) };

--- How many bytes continuing a character open `rest`.
let run(rest: Bytes) -> Nat =
    match rest
    | 0x[h, ..t], utf8/continues(h) => run(t) + 1
    | _ => 0
    end;

-- Not grouped with `run_starts`: a group's signatures elaborate together, and `run_starts` would read this bound before its comparison is settled.
--- The continuing bytes that open `rest` lie within it.
let run_within(rest: Bytes) -> Bool/Holds(run(rest) <= Bytes/length(rest)) =
    match rest
    | 0x[] => Bool/True/qed()
    | 0x[h, ..t] =>
        match utf8/continues(h)
        | true => run_within(t)
        | false => Bool/True/qed()
        end
    end;

--- Past the continuing bytes that open `rest`, a character may begin.
let run_starts(rest: Bytes) -> Bool/Holds(starts(Bytes/drop(rest, run(rest), @run_within(rest)))) =
    match rest
    | 0x[] => Bool/True/qed()
    | 0x[h, ..t] =>
        match utf8/continues(h)
        | true => run_starts(t)
        | false => Bool/True/qed()
        end
    end;

--- How many bytes the first character of `b` takes — its lead and the bytes continuing it — with the bound and the boundary past them. The character is not decoded: the one-byte rule is all a step needs.
let hop(
    @b: Bytes,
    some: Bool/Holds(0 < Bytes/length(b)),
) -> {
    width: Nat,
    positive: Bool/Holds(0 < width),
    within: Bool/Holds(width <= Bytes/length(b)),
    boundary: Bool/Holds(starts(Bytes/drop(b, width, @within)))} =
    match b
    | 0x[] => match some end
    | 0x[_, ..t] =>
        (
            width = 1 + run(t),
            positive = Bool/True/qed(),
            within = run_within(t),
            boundary = run_starts(t))
    end;

--- The first character of valid bytes that hold one.
let lead(@b: Bytes, v: Str/Valid(b), some: Bool/Holds(0 < Bytes/length(b))) -> Char =
    match b
    | 0x[] => match some end
    | 0x[c, ..t] => Str/Valid/decode_head(c, @t, v)
    end;

--- The position past the character at `at`, found without decoding it, and the proof that it lies past — what a walk forward recurs with, through [`forward`].
pub let skip(
    s: Str,
    at: At(s),
    @here: Bool/Holds(at.offset < Bytes/length(s.bytes)),
) -> {past: At(s), progress: Bool/Holds(at.offset < past.offset)} =
    let rest = Str/after(s, at);
    let hopped = hop(@rest.bytes, proved());
    (
        past = At { offset = at.offset + hopped.width, @_, @boundary = hopped.boundary },
        progress = hopped.positive);

--- The character at `at`, the position past it, and the proof that it lies past.
pub let next(
    s: Str,
    at: At(s),
    @here: Bool/Holds(at.offset < Bytes/length(s.bytes)),
) -> {char: Char, past: At(s), progress: Bool/Holds(at.offset < past.offset)} =
    let rest = Str/after(s, at);
    let hopped = hop(@rest.bytes, proved());
    (
        char = lead(rest.valid, proved()),
        past = At { offset = at.offset + hopped.width, @_, @boundary = hopped.boundary },
        progress = hopped.positive);

--- The character at `at`, the position past it and the proof that it lies past, or `none` at the end of `s`.
pub let try_next(
    s: Str,
    at: At(s),
) -> Option({char: Char, past: At(s), progress: Bool/Holds(at.offset < past.offset)}) =
    match at.offset < Bytes/length(s.bytes)
    | true => Option/some(next(s, at))
    | false => Option/none()
    end;

--- The last position of `s` at or before offset `k`, which a byte that does not continue a character marks within three bytes of valid text.
let floor(
    s: Str,
    k: Nat,
    within: Bool/Holds(k <= Bytes/length(s.bytes)),
) -> {at: At(s), below: Bool/Holds(at.offset <= k)} =
    match k
    | 0 => (at = start(s), below = Bool/True/qed())
    | j + 1 =>
        match starts(Bytes/drop(s.bytes, j + 1, @within))
        | true => (at = At { offset = j + 1 }, below = Nat/le/refl(j + 1))
        | false =>
            let back = floor(s, j, proved());
            (at = back.at, below = proved())
        end
    end;

--- The character before `at`, the position before it, and the proof that it lies before.
pub let prev(
    s: Str,
    at: At(s),
    @here: Bool/Holds(0 < at.offset),
) -> {char: Char, past: At(s), progress: Bool/Holds(past.offset < at.offset)} =
    match at.offset
    | 0 => match here end
    | j + 1 =>
        let back = floor(s, j, proved());
        (char = lead(Str/after(s, back.at).valid, proved()), past = back.at, progress = back.below)
    end;

--- The character before `at`, the position before it and the proof that it lies before, or `none` at the start of `s`.
pub let try_prev(
    s: Str,
    at: At(s),
) -> Option({char: Char, past: At(s), progress: Bool/Holds(past.offset < at.offset)}) =
    match 0 < at.offset
    | true => Option/some(prev(s, at))
    | false => Option/none()
    end;

--- The position past the extended grapheme cluster that begins at `at`, with the proof that it is past. A cluster is what a reader sees as one character, and may be several characters of `s`: a letter and its marks, an emoji sequence, a flag. Boundaries follow UAX #29, over the Unicode Character Database the toolchain pins.
pub let next_grapheme(
    s: Str,
    at: At(s),
    @here: Bool/Holds(at.offset < Bytes/length(s.bytes)),
) -> {past: At(s), progress: Bool/Holds(at.offset < past.offset)} =
    let first = next(s, at);
    let opening = GraphemeBreak/of_char(first.char);
    forward(
        (p: At(s)) =>
            (
                before: GraphemeBreak,
                run: grapheme/Run,
                @beyond: Bool/Holds(at.offset < p.offset)) -> {
                past: At(s),
                progress: Bool/Holds(at.offset < past.offset)},
        (p, again) =>
            (before, run, @beyond) =>
                match try_next(s, p)
                | none() => (past = p, progress = beyond)
                | some(step) =>
                    let class = GraphemeBreak/of_char(step.char);
                    match grapheme/breaks(before, step.char, class, run)
                    | true => (past = p, progress = beyond)
                    | false =>
                        again(step.past, step.progress)(
                            class,
                            grapheme/after(run, step.char, class))
                    end
                end,
        first.past)(
        opening,
        grapheme/opening(first.char, opening));

--- The position past the extended grapheme cluster that begins at `at` and the proof that it lies past, or `none` at the end of `s`.
pub let try_next_grapheme(
    s: Str,
    at: At(s),
) -> Option({past: At(s), progress: Bool/Holds(at.offset < past.offset)}) =
    match at.offset < Bytes/length(s.bytes)
    | true => Option/some(next_grapheme(s, at))
    | false => Option/none()
    end;

--- The position where the extended grapheme cluster before `at` begins, with the proof that it is before, or `none` at the start of `s`. A boundary depends on the text before it, so the clusters are walked from the start of `s`: the cost grows with `at`'s offset.
pub let try_prev_grapheme(
    s: Str,
    at: At(s),
) -> Option({past: At(s), progress: Bool/Holds(past.offset < at.offset)}) =
    forward(
        (_: At(s)) => Option({past: At(s), progress: Bool/Holds(past.offset < at.offset)}),
        (p, again) =>
            match p.offset < at.offset
            | false => Option/none()
            | true =>
                let cluster = next_grapheme(s, p);
                match cluster.past.offset < at.offset
                | true => again(cluster.past, cluster.progress)
                | false => Option/some((past = p, progress = proved()))
                end
            end,
        start(s));

--- A total walk forward through the positions of `s`. `step` computes `P(at)` and may continue at any later position, given the proof that it is later, which [`next`] and [`skip`] return. The walk needs no recursion of its own, so it also reduces inside a type.
---
--- Use it when the walk must stop at every position, as grapheme breaking does. A walk that only stops where a predicate fails is cheaper as [`Str/span`], which reads bytes and builds one position at the end.
pub let forward(
    @s: Str,
    P: (At(s)) -> Type,
    step: (at: At(s), again: (p: At(s), progress: Bool/Holds(at.offset < p.offset)) -> P(p)) -> P(
        at),
    at: At(s),
) -> P(at) =
    Nat/descend(
        (p: At(s)) => Bytes/length(s.bytes) - p.offset,
        P,
        (at, again) => step(at, (p, progress) => again(p, proved())),
        at);

--- Recursion back through the positions of `s`: `step` may recur at any position before `at`, with the proof that it lies before, which is what [`prev`] answers. [`forward`] read the other way, the offset itself the measure that descends.
pub let backward(
    @s: Str,
    P: (At(s)) -> Type,
    step: (at: At(s), again: (p: At(s), progress: Bool/Holds(p.offset < at.offset)) -> P(p)) -> P(
        at),
    at: At(s),
) -> P(at) =
    Nat/descend((p: At(s)) => p.offset, P, step, at);

--- A position in `a` stays one with `rest` appended, when a character may begin at the front of `rest`.
let starts_before(
    @a: Bytes,
    rest: Bytes,
    k: Nat,
    within: Bool/Holds(k <= Bytes/length(a)),
    at: Bool/Holds(starts(Bytes/drop(a, k, @within))),
    begins: Bool/Holds(starts(rest)),
) -> Bool/Holds(starts(Bytes/drop(0x[..a, ..rest], k))) =
    match k
    | 0 => match a | 0x[] => begins | 0x[_, .._] => at end
    | j + 1 =>
        match a
        | 0x[] => match within end
        | 0x[_, ..r] => starts_before(@r, rest, j, within, at, begins)
        end
    end;

--- A position in `s` as the position it is in `s` followed by `t`.
pub let of_left(s: Str, t: Str, at: At(s)) -> At(Str/concat(s, t)) =
    At {
        offset = at.offset,
        @_,
        @boundary =
            starts_before(
                @s.bytes,
                t.bytes,
                at.offset,
                at.within,
                at.boundary,
                Str/Valid/begins(t.valid)) };

--- A position in `t` as the position it is in `s` followed by `t`.
pub let of_right(s: Str, t: Str, at: At(t)) -> At(Str/concat(s, t)) =
    At { offset = Bytes/length(s.bytes) + at.offset };

--- Two positions are equal when their offsets are.
satisfy (@s: Str) => Eql(At(s)) {
    eql(a, b) = a.offset == b.offset,
    -- A congruence written over the fields and applied at the projections, where an equation between two projections solves nothing. The law is applied outside it, at the projections: a field is below its record, so a family nested through this one descends through the law as it does through `eql`. Once the offsets are one, the two proofs of each bound are.
    eq_of_eql(a, b, h) =
        let fields(
            offset1: Nat,
            within1: Bool/Holds(offset1 <= Bytes/length(s.bytes)),
            boundary1: Bool/Holds(starts(Bytes/drop(s.bytes, offset1, @within1))),
            offset2: Nat,
            within2: Bool/Holds(offset2 <= Bytes/length(s.bytes)),
            boundary2: Bool/Holds(starts(Bytes/drop(s.bytes, offset2, @within2))),
            offset: Eq()(offset1, offset2),
        ) -> Eq(@At(s))(
            At { offset = offset1, @within = within1, @boundary = boundary1 },
            At { offset = offset2, @within = within2, @boundary = boundary2 }) =
            let refl() = offset;
            Eq/refl();
        fields(
            a.offset,
            a.within,
            a.boundary,
            b.offset,
            b.within,
            b.boundary,
            Eql/eq_of_eql(a.offset, b.offset, h)),
    refl(a) = Eql/refl(a.offset),
}

--- Positions are ordered by their offsets, so a guard between two decides the bound [`Str/between`] takes.
satisfy (@s: Str) => Ord(At(s)) {
    ord(a, b) = Nat/ord(a.offset, b.offset),
    lt(a, b) = a.offset < b.offset,
    le(a, b) = a.offset <= b.offset,
}
