-- UTF-8 validity, and the scalar boundaries `Char` admits.
use /std/{Str, Char, Nat, Bool, Bytes, List, Test};

-- Whether `of_bytes` refuses these bytes, which is what every rejection below asks.
let rejected(bytes: Bytes) -> Bool =>
    match Str/of_bytes(bytes)
    | success(_) => false
    | failure(_) => true
    end;

test of_bytes_accepts_multibyte_utf8 =>
    match Str/of_bytes(0x[0xC3, 0xA9])
    | success(s) => Test/equal(s, "é")
    | failure(_) => Test/fail("the bytes of `é` are refused")
    end;

-- An invalid lead byte fails `is_utf8`, so `of_bytes` answers `none`.
test of_bytes_rejects_an_invalid_lead_byte =>
    Test/assert("an invalid lead byte is rejected", rejected(0x[0xFF]));

-- A truncated sequence — a two-byte lead with no continuation — fails the continuation check.
test of_bytes_rejects_a_truncated_multibyte =>
    Test/assert("a truncated sequence is rejected", rejected(0x[0xC3]));

-- Overlong encodings, a surrogate, a scalar past `U+10FFFF`, a bare continuation byte, and three truncations: every shape the automaton must refuse.
test of_bytes_rejects_every_invalid_shape =>
    Test/assert(
        "every invalid shape is rejected",
        List/fold(
            [
                0x[0xC0, 0xAF],
                0x[0xE0, 0x80, 0x80],
                0x[0xED, 0xA0, 0x80],
                0x[0xF4, 0x90, 0x80, 0x80],
                0x[0x80],
                0x[0xC2],
                0x[0xE2, 0x82],
                0x[0xF0, 0x9F, 0x98]],
            true,
            (bytes, ok) => ok && rejected(bytes)));

-- Where text stops: `of_bytes` answers the length of the longest valid prefix, which is where the first character that is not text begins, as Rust's `Utf8Error::valid_up_to` does. Each shape — a truncated sequence, two overlong ones, a surrogate, a value past `U+10FFFF` and a stray continuation byte — stands at the start, between two characters and at the end, after a two-byte character; two more cut a four-byte character short and run one byte past it.
test of_bytes_answers_where_text_stops =>
    let stops(bytes: Bytes) -> Str =>
        match Str/of_bytes(bytes)
        | success(_) => "text"
        | failure(at) => Nat/to_str(at)
        end;
    let around(bad: Bytes) -> Str =>
        Str/join(",", [stops(bad), stops(0x['a', ..bad, 'b']), stops(0x[0xC3, 0xA9, 'b', ..bad])]);
    let truncated = around(0x[0xE2, 0x82]);
    let overlong_two = around(0x[0xC0, 0xAF]);
    let overlong_three = around(0x[0xE0, 0x80, 0x80]);
    let surrogate = around(0x[0xED, 0xA0, 0x80]);
    let past_the_last = around(0x[0xF4, 0x90, 0x80, 0x80]);
    let continuation = around(0x[0x80]);
    let cut_short = stops(0x['a', 0xF0, 0x9F, 0x98, 'b']);
    let one_past = stops(0x[0xF0, 0x9F, 0x98, 0x80, 0x80]);
    let whole = stops(0x['a', 0xC3, 0xA9]);
    Test/equal(
        Str/join("|", [truncated, overlong_two, overlong_three, surrogate, past_the_last,
            continuation, cut_short, one_past, whole]),
        "0,1,3|0,1,3|0,1,3|0,1,3|0,1,3|0,1,3|1|4|text");

-- The surrogate range and everything above `U+10FFFF` are excluded, and the scalars either side of each boundary are admitted.
test char_of_nat_accepts_exact_unicode_scalar_boundaries =>
    let render(n: Nat) -> Str =>
        match Char/of_nat(n)
        | some(c) => Nat/to_str(Char/to_nat(c))
        | none() => "x"
        end;
    Test/equal(
        Str/join(",", List/map([0, 0xD7FF, 0xD800, 0xDFFF, 0xE000, 0x10FFFF, 0x110000], render)),
        "0,55295,x,x,57344,1114111,x");

-- Unicode's own example of maximal subparts (Table 3-8): a four-byte character cut short by a three-byte one, which a two-byte one cuts short, which `b` cuts short, then a lone continuation, and two more: each run that begins a character and is cut short is one U+FFFD, and each byte that begins none is one.
test lossy_decoding_replaces_each_maximal_subpart_once =>
    Test/equal(
        Str/of_bytes_lossy(0x[0x61, 0xF1, 0x80, 0x80, 0xE1, 0x80, 0xC2, 0x62, 0x80, 0x63, 0x80,
            0xBF, 0x64]),
        "a\u{FFFD}\u{FFFD}\u{FFFD}b\u{FFFD}c\u{FFFD}\u{FFFD}d");

-- Well-formed bytes are the text they are; a surrogate's encoding, which no character has, is three U+FFFD, its lead holding no byte after it and the two after it beginning no character; and a character the bytes end inside is one.
test lossy_decoding_keeps_text_and_replaces_a_surrogate_and_a_cut_end =>
    Test/all([
        Test/equal(Str/of_bytes_lossy(0x[0xC3, 0xA9]), "é"),
        Test/equal(Str/of_bytes_lossy(0x[0xED, 0xA0, 0x80]), "\u{FFFD}\u{FFFD}\u{FFFD}"),
        Test/equal(Str/of_bytes_lossy(0x[0x61, 0xE2, 0x82]), "a\u{FFFD}")]);
