// lcg: iterate a small LCG `x = (75 * x) mod 65537` N times.
// Small constants keep every intermediate within Curios's i31 runtime ints,
// so all languages compute identical values (see README).
// Grain -> wasm (its own linear-memory GC), run on wasmtime.
// APIs verified against the grain-v0.7.2 stdlib; confirm `grain compile` at build.
module Lcg

from "wasi/process" include Process
from "array" include Array
from "number" include Number
from "result" include Result

let args = Result.unwrap(Process.argv())
let s = args[Array.length(args) - 1]
let n = Result.unwrap(Number.parseInt(s, 10))

let mut x = 1
let mut i = 0
while (i < n) {
  x = (75 * x) % 65537
  i = i + 1
}
print(x)
