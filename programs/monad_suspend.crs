-- The suspension arm of the comparison begun in `state_monad.crs`: `monad_io.crs`'s loop with a yield at every step, run as one branch of `Io/both` beside one that answers at once,
-- so every step suspends out of the loop, through the driver every combinator is written over, and back in — the cost of a suspension, beside the cost of `bind`.
-- N is read from the command line so the loop survives constant folding; output is 3N.
use /std/{Str, Nat, List, Option, Result, Try, Io, Process, Fmt};

let loop(n: Nat, acc: Nat) -> Io(Nat) =
    match n
    | 0 => Io/pure(acc)
    | m + 1 =>
        let _ = Io/yield()!;
        let a = Io/pure(acc + 3)!;
        loop(m, a)
    end;

let measured(n: Nat) -> Io({}) =
    let (total, _) = Io/both(loop(n, 0), Io/pure(()))!;
    Fmt/print("%\n")(total);

let execute() -> Try(Io, Str, {}) =
    let arguments = Process/args()!;
    let bytes = Option/to_result(List/try_get(arguments, 1), "no input")!;
    let s = Result/map_failure(Str/of_bytes(bytes), (_) => "invalid utf-8")!;
    let n = Option/to_result(Nat/of_str(Str/trim(s)), "bad input")!;
    measured(n);

execute()
