-- Thread a counter through N steps using the `State` monad, and print it.
-- The paired `state_manual.crs` computes the identical result by threading the state by hand, so the two differ in abstraction and in nothing else: whatever separates their emitted code is what the `State` abstraction costs.
-- N is read from the command line so the loop survives constant folding; output is 3N.
use /std/{Str, Nat, State, List, Option, Result, Try, Io, Process, Fmt, Monad};

let loop(n: Nat) -> State(Nat, {}) =
    match n
    | 0 => State/pure(())
    | m + 1 =>
        let _ = State/modify((s) => s + 3)!;
        loop(m)
    end;

let total(n: Nat) -> Nat =
    State/run(loop(n), 0).1;

let execute() -> Try(Io, Str, {}) =
    let arguments = Process/args()!;
    let bytes = Option/to_result(List/try_get(arguments, 1), "no input")!;
    let s = Result/map_failure(Str/of_bytes(bytes), (_) => "invalid utf-8")!;
    let n = Option/to_result(Nat/of_str(Str/trim(s)), "bad input")!;
    Monad/lift(Fmt/print("%\n")(total(n)));

execute()
