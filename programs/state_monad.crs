-- Thread a counter through N steps using the `State` monad, and print it.
-- The paired `state_manual.crs` computes the identical result by threading the state by hand, so the two differ in abstraction and in nothing else: whatever separates their emitted code is what the `State` abstraction costs.
-- N is read from stdin so the loop survives constant folding; output is 3N.
use /std/{Str, Nat, State, Io};

let loop(n: Nat) -> State(Nat, {}) =
    match n: (_) => State(Nat, {})
    | 0 => State/pure(())
    | m + 1 =>
        let _ = State/modify((s) => s + 3)!;
        loop(m)
    end;

let total(n: Nat) -> Nat =
    State/run(loop(n), 0).1;

let standard_input = /std/Io/Reader/new(/std/Io/stdin)!;
let input =
    /std/Result/unwrap_or(/std/Try/run(/std/Io/Reader/line(standard_input))!, /std/Option/none());
match input: (_) => Io({})
| some(bytes) =>
    match Str/of_bytes(bytes): (_) => Io({})
    | success(s) =>
        match Nat/of_str(Str/trim(s)): (_) => Io({})
        | some(n) => /std/print(Str/concat(Nat/to_str(total(n)), "\n"))
        | none() => /std/print("bad input\n")
        end
    | failure(_) => /std/print("invalid utf-8\n")
    end
| none() => /std/print("no input\n")
end
