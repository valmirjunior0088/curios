-- The middle point between `parse_digits.crs` and `parse_manual.crs`: the same `Str/fold` over the same codepoints, so the UTF-8 scan is held constant, with `let n = acc!` written out as an explicit match so the walk generates no `/std/Monad/bind`. The fold's step function is still a closure invoked per character.
-- So the three programs separate what one gap could not: against `parse_digits.crs` this isolates the bind, and against `parse_manual.crs` it isolates the closure plus the scan.
-- N is read from the command line so the loop survives constant folding; the output matches the other two exactly for the same input.
use /std/{Str, Nat, Char, List, Option, Result, Try, Io, Process, Fmt};

let decode(s: Str) -> Option(Nat) =
    match Str/is_empty(s)
    | true => Option/none()
    | false =>
        Str/fold(
            s,
            Option/some(0),
            (cp, acc) =>
                match acc
                | some(n) =>
                    match Char/is_ascii_digit(cp)
                    | true => Option/some(n * 10 + (Char/to_nat(cp) - 0x30))
                    | false => Option/none()
                    end
                | none() => Option/none()
                end)
    end;

let loop(k: Nat, digits: Str, acc: Nat) -> Nat =
    match k
    | 0 => acc
    | m + 1 =>
        match decode(digits)
        | some(n) => loop(m, digits, (acc + n) % 1000003)
        | none() => loop(m, digits, acc)
        end
    end;

let total(n: Nat) -> Nat =
    loop(n, Nat/to_str(n), 0);

let execute() -> Try(Io, Str, {}) =
    let arguments = Process/args()!;
    let bytes = Option/to_result(List/try_get(arguments, 1), "no input")!;
    let s = Result/map_failure(Str/of_bytes(bytes), (_) => "invalid utf-8")!;
    let n = Option/to_result(Nat/of_str(Str/trim(s)), "bad input")!;
    let _ = Fmt/print("%\n")(total(n))!;
    Try/pure(());

execute()
