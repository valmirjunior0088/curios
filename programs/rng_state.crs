-- A realistic monadic workload: N steps of an LCG whose seed is threaded
-- through `State`, summing the sequence. Unlike `state_monad.crs` and the
-- `monad_*.crs` set -- which bind trivial work and so measure sequencing
-- overhead in isolation -- each step here does real arithmetic (a multiply, two
-- remainders, an add) around a genuine `get`/`put` pair. That is the ratio worth
-- deciding an optimization on: microbenchmarks maximize the visible overhead by
-- construction, and this does not.
--
-- `rng_manual.crs` computes the identical sum with the seed as an ordinary
-- parameter. N is read from stdin; output is the sum mod 1000003.
use /std/{Str, Nat, Option, State, Io};

let next() -> State(Nat, Nat) =
    let s = State/get()!;
    let n = 75 * s % 65537;
    let _ = State/put(n)!;
    State/pure(n);

rec run(k: Nat, acc: Nat) -> State(Nat, Nat) =
    match k: (_) => State(Nat, Nat)
    | 0 => State/pure(acc)
    | m + 1 =>
        let x = next()!;
        run(m, (acc + x) % 1000003)
    end;

let total(n: Nat) -> Nat =
    State/run(run(n, 0), 1).0;

let input = /std/read()!;
match input: (_) => Io({})
| some(bytes) =>
    match Str/of_bytes(bytes): (_) => Io({})
    | some(s) =>
        match Nat/of_str(Str/trim(s)): (_) => Io({})
        | some(n) => /std/print(Str/concat(Nat/to_str(total(n)), "\n"))
        | none() => /std/print("bad input\n")
        end
    | none() => /std/print("invalid utf-8\n")
    end
| none() => /std/print("no input\n")
end
