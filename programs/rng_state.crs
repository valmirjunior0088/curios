-- A realistic monadic workload: N steps of an LCG whose seed is threaded through `State`, summing the sequence. Unlike `state_monad.crs` and the `monad_*.crs` set -- which bind trivial work and so measure sequencing overhead in isolation -- each step here does real arithmetic (a multiply, two remainders, an add) around a genuine `get`/`set` pair. That is the ratio worth deciding an optimization on: microbenchmarks maximize the visible overhead by construction, and this does not.
--
-- `rng_manual.crs` computes the identical sum with the seed as an ordinary parameter. N is read from the command line; output is the sum mod 1000003.
use /std/{Str, Nat, State, List, Option, Result, Try, Io, Process, Fmt, Monad};

let next() -> State(Nat, Nat) =
    let s = State/get()!;
    let n = 75 * s % 65537;
    let _ = State/set(n)!;
    State/pure(n);

let run(k: Nat, acc: Nat) -> State(Nat, Nat) =
    match k
    | 0 => State/pure(acc)
    | m + 1 =>
        let x = next()!;
        run(m, (acc + x) % 1000003)
    end;

let total(n: Nat) -> Nat =
    State/run(run(n, 0), 1).0;

let execute() -> Try(Io, Str, {}) =
    let arguments = Process/args()!;
    let bytes = Option/to_result(List/try_get(arguments, 1), "no input")!;
    let s = Result/map_failure(Str/of_bytes(bytes), (_) => "invalid utf-8")!;
    let n = Option/to_result(Nat/of_str(Str/trim(s)), "bad input")!;
    Monad/lift(Fmt/print("%\n")(total(n)));

execute()
