-- lcg: iterate a small LCG `x = (75 * x) mod 65537` N times.
-- Small constants keep every intermediate within Curios's i31 runtime integers.
-- N is read from the command line as the Rust spelling reads it.
-- Pure integer ALU + a tail-recursive counted loop. Output matches the Rust spelling.
use /std/{Str, Nat, Io};

let loop(k: Nat, x: Nat) -> Nat =
    match k: (_) => Nat | 0 => x | kp + 1; _ih => loop(kp, 75 * x % 65537) end;

let arguments = /std/proc/args()!;
let input = /std/List/try_get(arguments, 1);
match input: (_) => Io({})
| some(bytes) =>
    match Str/of_bytes(bytes): (_) => Io({})
    | success(s) =>
        match Nat/of_str(Str/trim(s)): (_) => Io({})
        | some(n) => /std/print(Str/concat(Nat/to_str(loop(n, 1)), "\n"))
        | none() => /std/print("bad input\n")
        end
    | failure(_) => /std/print("invalid utf-8\n")
    end
| none() => /std/print("no input\n")
end
