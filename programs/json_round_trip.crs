-- Decode a JSON document of N entries built from N, encode it back, and print the encoding's length.
-- Each entry holds a string, an integer, a float, a list of booleans and a list of strings. The document is built from the command line's N, so no closed term folds it away; at 820 it is about 100 KB.
use /std/{Str, Nat, List, Option, Result, Try, Io, Proc, Fmt, Json};

let entry(i: Nat) -> Str =
    Str/join(", ", [
        Fmt/render("{\"name\": \"entry number %\"")(i),
        Fmt/render("\"count\": %")(7919 * i % 100000),
        Fmt/render("\"ratio\": %.%")(i)(i % 100),
        Fmt/render("\"flags\": [true, false, %]")(i % 2 == 1),
        Fmt/render("\"tags\": [\"a%\", \"b%\", \"c\"]}")(i)(i % 13)]);

let execute() -> Try(Io, Str, {}) =
    let arguments = Proc/args()!;
    let bytes = Option/to_result(List/try_get(arguments, 1), "no input")!;
    let s = Result/map_failure(Str/of_bytes(bytes), (_) => "invalid utf-8")!;
    let n = Option/to_result(Nat/of_str(Str/trim(s)), "bad input")!;
    let entries = Str/join(", ", List/map(List/range(0, n), entry));
    let document = Str/concat(Str/concat("{\"entries\": [", entries), "]}");
    let decoded = Result/map_failure(Json/decode(document), (_) => "bad json")!;
    let () = Fmt/print("%\n")(Str/len(Json/encode(decoded)))!;
    Try/pure(());

execute()
