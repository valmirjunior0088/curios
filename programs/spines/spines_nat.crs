-- spines_nat: `spines` with its keys entering as `Nat` rather than through `Bytes/of_nat`, and identical in every other respect — same LCG, same live set, same values, same printed sum. The pair is what isolates the encoding: `spines` pays a division and a byte per digit at the boundary because `/std/Map` had no `Key(Nat)` to key on, and this one pays nothing, so the difference between the two columns is that boundary and nothing else. It is a Curios-only instrument beside the cross-language workload rather than a ninth spelling of it: the other seven contestants key their maps on a machine integer already, so there is no counterpart to write, and `spines` keeps its `Bytes` keys so the published table stays comparable with the runs it was published from. N is read from stdin; the seed derives from N so nothing is a closed term. Values are the step index, so later writes to a returning key are observable in the printed sum.
use /std/{Str, Nat, Map, Io};

let walk(n: Nat, i: Nat, x: Nat, m: Map(Nat)) -> Map(Nat) =
    match n: (_) => Map(Nat)
    | 0 => m
    | k + 1; _ih =>
        let y = 75 * x % 65537;
        walk(k, i + 1, y, Map/insert(m, y, i % 1000003))
    end;

let input = /std/read()!;
match input: (_) => Io({})
| some(bytes) =>
    match Str/of_bytes(bytes): (_) => Io({})
    | some(s) =>
        match Nat/of_str(Str/trim(s)): (_) => Io({})
        | some(n) =>
            let m = walk(n, 0, (n + 1) % 65537, Map/empty());
            /std/print(
                Str/concat(Nat/to_str(Map/fold(m, 0, (_, v, acc) => (acc + v) % 1000003)), "\n"))
        | none() => /std/print("bad input\n")
        end
    | none() => /std/print("invalid utf-8\n")
    end
| none() => /std/print("no input\n")
end
