-- spines: N LCG-keyed inserts into /std/Map, then fold the values — death-birth churn on a persistent map's spine, under a live set that plateaus at the LCG's key population (at most 65536 entries) while inserts keep rebuilding root-to-leaf paths that die with the operation. The table compares map algorithms as much as memory management (a crit-bit trie here, hash maps in the imperative contestants, balanced trees in the functional ones), so it orients rather than proves. Keys enter as the Nat they are, as every contestant's enter as its machine integer; the runs published through 09 keyed through Bytes/of_nat instead, and the next benchmark run mentions the change. N is read from the command line; the seed derives from N so nothing is a closed term. Values are the step index, so later writes to a returning key are observable in the printed sum.
use /std/{Str, Nat, Map, List, Option, Result, Try, Io, Process, Fmt};

let walk(n: Nat, i: Nat, x: Nat, m: Map(Nat, Nat)) -> Map(Nat, Nat) =
    match n
    | 0 => m
    | k + 1; _ =>
        let y = 75 * x % 65537;
        walk(k, i + 1, y, Map/insert(m, y, i % 1000003))
    end;

let execute() -> Try(Io, Str, {}) =
    let arguments = Process/args()!;
    let bytes = Option/to_result(List/try_get(arguments, 1), "no input")!;
    let s = Result/map_failure(Str/of_bytes(bytes), (_) => "invalid utf-8")!;
    let n = Option/to_result(Nat/of_str(Str/trim(s)), "bad input")!;
    let m = walk(n, 0, (n + 1) % 65537, Map/empty());
    let _ = Fmt/print("%\n")(Map/fold(m, 0, (_, v, acc) => (acc + v) % 1000003))!;
    Try/pure(());

execute()
