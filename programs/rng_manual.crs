-- The control for `rng_state.crs`: the same LCG sum with the seed threaded as an ordinary parameter. Identical arithmetic, identical output, no monad.
-- N is read from the command line; output is the sum mod 1000003.
use /std/{Str, Nat, Io};

let run(k: Nat, s: Nat, acc: Nat) -> Nat =
    match k: (_) => Nat
    | 0 => acc
    | m + 1 =>
        let n = 75 * s % 65537;
        run(m, n, (acc + n) % 1000003)
    end;

let total(n: Nat) -> Nat =
    run(n, 1, 0);

let arguments = /std/proc/args()!;
let input = /std/List/try_get(arguments, 1);
match input: (_) => Io({})
| some(bytes) =>
    match Str/of_bytes(bytes): (_) => Io({})
    | success(s) =>
        match Nat/of_str(Str/trim(s)): (_) => Io({})
        | some(n) => /std/print(Str/concat(Nat/to_str(total(n)), "\n"))
        | none() => /std/print("bad input\n")
        end
    | failure(_) => /std/print("invalid utf-8\n")
    end
| none() => /std/print("no input\n")
end
