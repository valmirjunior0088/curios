-- The control for `rng_state.crs`: the same LCG sum with the seed threaded as an ordinary parameter. Identical arithmetic, identical output, no monad.
-- N is read from the command line; output is the sum mod 1000003.
use /std/{Str, Nat, List, Option, Result, Try, Io, Process, Fmt};

let run(k: Nat, s: Nat, acc: Nat) -> Nat =
    match k
    | 0 => acc
    | m + 1 =>
        let n = 75 * s % 65537;
        run(m, n, (acc + n) % 1000003)
    end;

let total(n: Nat) -> Nat =
    run(n, 1, 0);

let execute() -> Try(Io, Str, {}) =
    let arguments = Process/args()!;
    let bytes = Option/to_result(List/try_get(arguments, 1), "no input")!;
    let s = Result/map_failure(Str/of_bytes(bytes), (_) => "invalid utf-8")!;
    let n = Option/to_result(Nat/of_str(Str/trim(s)), "bad input")!;
    let _ = Fmt/print("%\n")(total(n))!;
    Try/pure(());

execute()
