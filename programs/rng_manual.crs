-- The control for `rng_state.crs`: the same LCG sum with the seed threaded as an
-- ordinary parameter. Identical arithmetic, identical output, no monad.
-- N is read from stdin; output is the sum mod 1000003.
use /std/{Str, Nat, Option, Io};

rec run(k: Nat, s: Nat, acc: Nat) -> Nat =
    match k: (_) => Nat
    | 0 => acc
    | m + 1 =>
        let n = 75 * s % 65537;
        run(m, n, (acc + n) % 1000003)
    end;

let total(n: Nat) -> Nat =
    run(n, 1, 0);

let input = /std/read()!;
match input: (_) => Io({})
| some(bytes) =>
    match Str/of_bytes(bytes): (_) => Io({})
    | some(s) =>
        match Nat/of_str(Str/trim(s)): (_) => Io({})
        | some(n) => /std/print(Str/concat(Nat/to_str(total(n)), "\n"))
        | none() => /std/print("bad input\n")
        end
    | none() => /std/print("invalid utf-8\n")
    end
| none() => /std/print("no input\n")
end
