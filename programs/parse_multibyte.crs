-- Fold a mixed-width UTF-8 string N times, summing code points mod 1000003.
-- The digit-parsing rungs never leave the ASCII arm of `/std/Str/fold`, so the two `Scan` obligations — the scan state returned by `/std/Str/step` and the argument reconstruction in the `cont` arm — execute zero times there. This fixture walks 1-, 2-, 3- and 4-byte characters so those obligations run once per continuation byte and their shares are measurable rather than absent.
-- The text is derived from the command line rather than written as a literal, so closed-term evaluation cannot fold the walk away.
-- N is read from the command line so the loop survives constant folding; output stays bounded well inside i31.
use /std/{Str, Char, Nat, List, Option, Result, Try, Io, Process, Fmt};

let loop(k: Nat, text: Str, acc: Nat) -> Nat =
    match k
    | 0 => acc
    | m + 1 => loop(m, text, (acc + Str/fold(text, 0, (c, a) => a + Char/to_nat(c))) % 1000003)
    end;

let total(n: Nat) -> Nat =
    loop(n, Str/concat(Nat/to_str(n), "é→𝄞é→𝄞"), 0);

let execute() -> Try(Io, Str, {}) =
    let arguments = Process/args()!;
    let bytes = Option/to_result(List/try_get(arguments, 1), "no input")!;
    let s = Result/map_failure(Str/of_bytes(bytes), (_) => "invalid utf-8")!;
    let n = Option/to_result(Nat/of_str(Str/trim(s)), "bad input")!;
    let _ = Fmt/print("%\n")(total(n))!;
    Try/pure(());

execute()
