-- One of four programs running the *same* N-step monadic loop in a different monad, to find whether the cost `state_monad.crs` measures is a fact about `bind` or about the carrier `bind` builds. `Result(E, A)` is plain data,
-- so its `bind` is a `match` over data and allocates no closure — this is the control the function-carrier monads are read against.
-- N is read from the command line so the loop survives constant folding; output is 3N.
use /std/{Str, Nat, List, Option, Result, Try, Io, Process, Fmt};

let loop(n: Nat, acc: Nat) -> Result(Str, Nat) =
    match n
    | 0 => Result/pure(acc)
    | m + 1 =>
        let a = Result/pure(acc + 3)!;
        loop(m, a)
    end;

let total(n: Nat) -> Nat =
    match loop(n, 0) | success(v) => v | failure(_) => 0 end;

let execute() -> Try(Io, Str, {}) =
    let arguments = Process/args()!;
    let bytes = Option/to_result(List/try_get(arguments, 1), "no input")!;
    let s = Result/map_failure(Str/of_bytes(bytes), (_) => "invalid utf-8")!;
    let n = Option/to_result(Nat/of_str(Str/trim(s)), "bad input")!;
    let _ = Fmt/print("%\n")(total(n))!;
    Try/pure(());

execute()
