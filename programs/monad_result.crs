-- One of four programs running the *same* N-step monadic loop in a different monad, to find whether the cost `state_monad.crs` measures is a fact about `bind` or about the carrier `bind` builds. `Result(E, A)` is plain data,
-- so its `bind` is a `match` over data and allocates no closure — this is the control the function-carrier monads are read against.
-- N is read from stdin so the loop survives constant folding; output is 3N.
use /std/{Str, Nat, Result, Io};

let loop(n: Nat, acc: Nat) -> Result(Str, Nat) =
    match n: (_) => Result(Str, Nat)
    | 0 => Result/pure(acc)
    | m + 1 =>
        let a = Result/pure(acc + 3)!;
        loop(m, a)
    end;

let total(n: Nat) -> Nat =
    match loop(n, 0): (_) => Nat | success(v) => v | failure(_) => 0 end;

let input = /std/read()!;
match input: (_) => Io({})
| some(bytes) =>
    match Str/of_bytes(bytes): (_) => Io({})
    | some(s) =>
        match Nat/of_str(Str/trim(s)): (_) => Io({})
        | some(n) => /std/print(Str/concat(Nat/to_str(total(n)), "\n"))
        | none() => /std/print("bad input\n")
        end
    | none() => /std/print("invalid utf-8\n")
    end
| none() => /std/print("no input\n")
end
