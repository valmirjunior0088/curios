-- binary-trees: build a perfect tree of depth D with unique per-node payloads (heap-numbered: root 1, children 2v / 2v+1), then sum every payload.
-- The distinct payloads make every node structurally unique, so Curios's pure
-- IR cannot share/CSE the two subtrees -> 2^(D+1)-1 real allocations.
-- D is read from the command line; output is the payload sum mod 1000003 (bounded to i31).
use /std/{Str, Nat, List, Option, Result, Try, Io, Process, Fmt};

induct Tree: Type
| leaf(Nat)
| node(Nat, Tree, Tree)
end

let build(d: Nat, v: Nat) -> Tree =
    match d
    | 0 => Tree/leaf(v)
    | dp + 1; _ => Tree/node(v, build(dp, v * 2), build(dp, v * 2 + 1))
    end;

let sum(t: Tree) -> Nat =
    match t | leaf(n) => n % 1000003 | node(n, l, r) => (n + sum(l) + sum(r)) % 1000003 end;

let execute() -> Try(Io, Str, {}) =
    let arguments = Process/args()!;
    let bytes = Option/to_result(List/try_get(arguments, 1), "no input")!;
    let s = Result/map_failure(Str/of_bytes(bytes), (_) => "invalid utf-8")!;
    let d = Option/to_result(Nat/of_str(Str/trim(s)), "bad input")!;
    let _ = Fmt/print("%\n")(sum(build(d, 1)))!;
    Try/pure(());

execute()
