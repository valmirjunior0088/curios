-- Push, then drop the first: one append and one window past the first element per step, over a list that grows to N. A window of a node never flattened flattens it, so every step flattens the run: where a flattening copies its whole run, the program's time grows with the square of N, and where it writes into the room the run's first piece left, it copies the element appended.
-- N is read from the command line; output is the sum of the windows' lengths, N(N - 1)/2, mod 1000003. `rope_push_peek.crs` is the control: the same appends, each read the element just appended.
use /std/{Str, Nat, List, Option, Result, Try, Io, Process, Fmt};

let run(k: Nat, s: Nat, built: List(Nat), acc: Nat) -> Nat =
    match k
    | 0 => acc
    | m + 1 =>
        let n = 75 * s % 65537;
        let grown = [..built, n];
        let past = List/drop(grown, 1);
        run(m, n, grown, (acc + List/len(past)) % 1000003)
    end;

let total(n: Nat) -> Nat =
    run(n, 1, [], 0);

let execute() -> Try(Io, Str, {}) =
    let arguments = Process/args()!;
    let bytes = Option/to_result(List/try_get(arguments, 1), "no input")!;
    let s = Result/map_failure(Str/of_bytes(bytes), (_) => "invalid utf-8")!;
    let n = Option/to_result(Nat/of_str(Str/trim(s)), "bad input")!;
    let _ = Fmt/print("%\n")(total(n))!;
    Try/pure(());

execute()
