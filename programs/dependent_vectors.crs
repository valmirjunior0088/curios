use /std/{Nat, Fmt};

induct Vec(T: Type): (n: Nat) -> Type
| nil(): (0)
| cons(@m: Nat, x: T, xs: Vec(T)(m)): (Nat/succ(m))
end

let append(@T: Type, @n: Nat, @m: Nat, v: Vec(T)(n), w: Vec(T)(m)) -> Vec(T)(Nat/add(n, m)) =
    match v | nil() => w | cons(@_, x, xs) => Vec/cons(x, append(xs, w)) end;

let total(@n: Nat, v: Vec(Nat)(n), acc: Nat) -> Nat =
    match v | nil() => acc | cons(@_, x, xs) => total(xs, Nat/add(acc, x)) end;

let a: Vec(Nat)(2) =
    Vec/cons(1, Vec/cons(2, Vec/nil()));

let b: Vec(Nat)(1) =
    Vec/cons(4, Vec/nil());

let c: Vec(Nat)(3) =
    append(a, b);

Fmt/print("%\n")(total(c, 0))
