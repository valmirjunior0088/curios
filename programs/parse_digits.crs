-- Decode a digit string N times, summing the results mod 1000003.
-- `Nat/of_str` folds an `Option(Nat)` accumulator through postfix `!`, so every character allocates a transient `Option` that the next fold step immediately destructs and drops. Those sums are returned, matched, and never stored --
-- unlike `trees/trees.crs`, whose allocations are the data structure itself and are therefore semantically necessary. What separates the two is what a transient sum costs.
-- The parsed string is derived from the command line rather than written as a literal, so closed-term evaluation cannot fold the parse away.
-- N is read from the command line so the loop survives constant folding; output stays bounded well inside i31.
use /std/{Str, Nat, List, Option, Result, Try, Io, Process, Fmt, Monad};

let loop(k: Nat, digits: Str, acc: Nat) -> Nat =
    match k
    | 0 => acc
    | m + 1 =>
        match Nat/of_str(digits)
        | some(n) => loop(m, digits, (acc + n) % 1000003)
        | none() => loop(m, digits, acc)
        end
    end;

let total(n: Nat) -> Nat =
    loop(n, Nat/to_str(n), 0);

let execute() -> Try(Io, Str, {}) =
    let arguments = Process/args()!;
    let bytes = Option/to_result(List/try_get(arguments, 1), "no input")!;
    let s = Result/map_failure(Str/of_bytes(bytes), (_) => "invalid utf-8")!;
    let n = Option/to_result(Nat/of_str(Str/trim(s)), "bad input")!;
    Monad/lift(Fmt/print("%\n")(total(n)));

execute()
