-- Decode a digit string N times, summing the results mod 1000003.
-- `Nat/of_str` folds an `Option(Nat)` accumulator through postfix `!`, so every
-- character allocates a transient `Option` that the next fold step immediately
-- destructs and drops. Those sums are returned, matched, and never stored --
-- unlike `binary_trees.crs`, whose allocations are the data structure itself
-- and are therefore semantically necessary. What separates the two is what a
-- transient sum costs.
-- The parsed string is derived from stdin rather than written as a literal, so
-- closed-term evaluation cannot fold the parse away.
-- N is read from stdin so the loop survives constant folding; output stays
-- bounded well inside i31.
use /std/{Str, Nat, Option, Io};

rec loop(k: Nat, digits: Str, acc: Nat) -> Nat =
    match k: (_) => Nat
    | 0 => acc
    | m + 1 =>
        match Nat/of_str(digits): (_) => Nat
        | some(n) => loop(m, digits, (acc + n) % 1000003)
        | none() => loop(m, digits, acc)
        end
    end;

let total(n: Nat) -> Nat =
    loop(n, Nat/to_str(n), 0);

let input = /std/read()!;
match input: (_) => Io({})
| some(bytes) =>
    match Str/of_bytes(bytes): (_) => Io({})
    | some(s) =>
        match Nat/of_str(Str/trim(s)): (_) => Io({})
        | some(n) => /std/print(Str/concat(Nat/to_str(total(n)), "\n"))
        | none() => /std/print("bad input\n")
        end
    | none() => /std/print("invalid utf-8\n")
    end
| none() => /std/print("no input\n")
end
