-- chain: build a cons list of 10 000 cells once, then transform it K times.
-- Every round rebuilds every cell from a predecessor that dies with the operation
-- — the death-birth overlap Perceus reuses in place and a tracing collector must
-- re-allocate. Unlike `trees`, nothing here survives the step that replaces it.
-- Each round reverses the order, which the final sum ignores, so a contestant is
-- free to walk the chain either way; the reverse-accumulate spelling is used
-- everywhere because it is the one that is tail-recursive in every language.
-- K is read from the command line; the seed is derived from it so nothing is a closed term.
use /std/{Str, Nat, List, Option, Result, Try, Io, Process, Fmt, Monad};

induct Chain: Type
| nil()
| cons(Nat, Chain)
end

-- Long enough that a round's live set is real, short enough that a contestant
-- without tail-call elimination still walks it without overflowing its stack.
let cells: Nat =
    10000;

let build(n: Nat, x: Nat, acc: Chain) -> Chain =
    match n | 0 => acc | m + 1; _ => build(m, 75 * x % 65537, Chain/cons(x, acc)) end;

let step(rest: Chain, acc: Chain) -> Chain =
    match rest
    | nil() => acc
    | cons(v, tail) => step(tail, Chain/cons((75 * v + 13) % 65537, acc))
    end;

let rounds(k: Nat, c: Chain) -> Chain =
    match k | 0 => c | m + 1; _ => rounds(m, step(c, Chain/nil())) end;

let total(c: Chain, acc: Nat) -> Nat =
    match c | nil() => acc | cons(v, tail) => total(tail, (acc + v) % 1000003) end;

let execute() -> Try(Io, Str, {}) =
    let arguments = Process/args()!;
    let bytes = Option/to_result(List/try_get(arguments, 1), "no input")!;
    let s = Result/map_failure(Str/of_bytes(bytes), (_) => "invalid utf-8")!;
    let k = Option/to_result(Nat/of_str(Str/trim(s)), "bad input")!;
    let chain = rounds(k, build(cells, (k + 1) % 65537, Chain/nil()));
    Monad/lift(Fmt/print("%\n")(total(chain, 0)));

execute()
