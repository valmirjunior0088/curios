-- The `Io` arm of the four-monad comparison begun in `state_monad.crs`. `Io` is not a library struct at all but a compiler intrinsic (`Io.pure`/`Io.bind`), so its carrier is erasure's choice rather than a written one — and it is the monad every Curios program's tail is written in, which makes it the arm that matters most if the per-`bind` cost turns out to be general.
-- N is read from the command line so the loop survives constant folding; output is 3N.
use /std/{Str, Nat, List, Option, Result, Try, Io, Process, Fmt};

let loop(n: Nat, acc: Nat) -> Io(Nat) =
    match n
    | 0 => Io/pure(acc)
    | m + 1 =>
        let a = Io/pure(acc + 3)!;
        loop(m, a)
    end;

let execute() -> Try(Io, Str, {}) =
    let arguments = Process/args()!;
    let bytes = Option/to_result(List/try_get(arguments, 1), "no input")!;
    let s = Result/map_failure(Str/of_bytes(bytes), (_) => "invalid utf-8")!;
    let n = Option/to_result(Nat/of_str(Str/trim(s)), "bad input")!;
    let total = loop(n, 0)!;
    let _ = Fmt/print("%\n")(total)!;
    Try/pure(());

execute()
