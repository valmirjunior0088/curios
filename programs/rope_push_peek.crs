-- Push, then peek: one append and one indexed read per step, over a list that grows to N. A `List` is a rope whose append is one node, and a read of a node that was never flattened answers from the child that holds its index where that child is flat, so each peek here reads the leaf just appended and copies nothing: the alternation of an append with a read of the newest part, which `curios-emit`'s read keeps linear and a read that flattened its node would make quadratic.
-- N is read from stdin; output is the sum of the peeked elements mod 1000003. Each peek reads the element just pushed, so the output is `rng_manual.crs`'s for the same N, which is the control: the same arithmetic with no list.
use /std/{Str, Nat, List, Io};

let run(k: Nat, s: Nat, built: List(Nat), acc: Nat) -> Nat =
    match k: (_) => Nat
    | 0 => acc
    | m + 1 =>
        let n = 75 * s % 65537;
        let grown = [..built, n];
        let peeked = match List/try_get(grown, List/len(built)) | some(x) => x | none() => 0 end;
        run(m, n, grown, (acc + peeked) % 1000003)
    end;

let total(n: Nat) -> Nat =
    run(n, 1, [], 0);

let standard_input = /std/Io/Reader/new(/std/Io/stdin)!;
let input =
    /std/Result/unwrap_or(/std/Try/run(/std/Io/Reader/line(standard_input))!, /std/Option/none());
match input: (_) => Io({})
| some(bytes) =>
    match Str/of_bytes(bytes): (_) => Io({})
    | success(s) =>
        match Nat/of_str(Str/trim(s)): (_) => Io({})
        | some(n) => /std/print(Str/concat(Nat/to_str(total(n)), "\n"))
        | none() => /std/print("bad input\n")
        end
    | failure(_) => /std/print("invalid utf-8\n")
    end
| none() => /std/print("no input\n")
end
