use /std/{Nat, Int, Flt, Bln, Str, BigNat, BigInt};

pub concept Show(A : Type) : Type {
    show(A) -> Str
}

pub use Show/*;

satisfy Show(Nat) {
    show(n) = Nat/to_str(n)
}

satisfy Show(Int) {
    show(n) = Int/to_str(n)
}

satisfy Show(Flt) {
    show(f) = Flt/to_str(f)
}

satisfy Show(Bln) {
    show(b) = Bln/to_str(b)
}

satisfy Show(Str) {
    show(s) = s
}

satisfy Show(BigNat) {
    show(n) = BigNat/to_str(n)
}

satisfy Show(BigInt) {
    show(n) = BigInt/to_str(n)
}
