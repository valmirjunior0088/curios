use /std/{Nat, Bool, Byte, Option, Bytes, Parse};

let is_ws_byte(b: Byte) -> Bool =
    let n = Byte/to_nat(b);
    n == ' ' || n == '\t';

--- Whether `b` may appear in a bare key: an ASCII letter or digit, `-`, or `_`.
pub let is_bare_byte(b: Byte) -> Bool =
    let n = Byte/to_nat(b);
    Nat/in_range(n, 'A', 'Z') || Nat/in_range(n, 'a', 'z') || Nat/in_range(n, '0', '9') || n == '-'
        || n == '_';

let is_comment_byte(b: Byte) -> Bool =
    let n = Byte/to_nat(b);
    n == '\t' || Nat/in_range(n, ' ', '~') || n >= 0x80;

--- The value of the hexadecimal digit at code point `n`, or `none` where `n` is not one.
pub let hex_val(n: Nat) -> Option(Nat) =
    choose
    | Nat/in_range(n, '0', '9') => Option/some(n - '0')
    | Nat/in_range(n, 'a', 'f') => Option/some(n - 'a' + 10)
    | Nat/in_range(n, 'A', 'F') => Option/some(n - 'A' + 10)
    | _ => Option/none()
    end;

--- Spaces and tabs, as many as there are.
pub let ws: Parse(Bytes, {}) =
    Parse/map(Parse/bytes/take_while(is_ws_byte), (_) => ());

let comment: Parse(Bytes, {}) =
    let _ = Parse/bytes/expect('#')!;
    Parse/map(Parse/bytes/take_while(is_comment_byte), (_) => ());

--- One line break, either `\r\n` or a bare `\n`.
pub let newline: Parse(Bytes, {}) =
    Parse/or(
        Parse/map(Parse/and(Parse/bytes/expect('\r'), Parse/bytes/expect('\n')), (_) => ()),
        Parse/map(Parse/bytes/expect('\n'), (_) => ()));

--- Whitespace, line breaks and comments, as much as there is: what may sit between two items.
pub let trivia: Parse(Bytes, {}) =
    Parse/map(
        Parse/many0(
            Parse/or(
                Parse/map(Parse/bytes/expect(' '), (_) => ()),
                Parse/or(
                    Parse/map(Parse/bytes/expect('\t'), (_) => ()),
                    Parse/or(newline, comment)))),
        (_) => ());

--- The end of a line: trailing whitespace, an optional comment, then a line break or the end of the input.
pub let line_end: Parse(Bytes, {}) =
    let _ = ws!;
    let _ = Parse/or(comment, Parse/pure(()))!;
    Parse/label(Parse/or(newline, Parse/eof()), "expected end of line");
