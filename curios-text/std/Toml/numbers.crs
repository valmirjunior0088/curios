use /std/{Nat, Flt, Bool, Byte, Option, Bytes, Parse, Toml};
use /std/Toml/scan/{hex_val};

let dec_digit(n: Nat) -> Option(Nat) =
    match Nat/in_range(n, '0', '9') | true => Option/some(n - '0') | false => Option/none() end;

let oct_digit(n: Nat) -> Option(Nat) =
    match Nat/in_range(n, '0', '7') | true => Option/some(n - '0') | false => Option/none() end;

let bin_digit(n: Nat) -> Option(Nat) =
    match Nat/in_range(n, '0', '1') | true => Option/some(n - '0') | false => Option/none() end;

let is_dec_byte(b: Byte) -> Bool =
    Nat/in_range(Byte/to_nat(b), '0', '9');

let magnitude_stop(acc: Nat, seen: Bool, pend: Bool) -> Parse(Bytes, Nat) =
    match pend
    | true => Parse/commit(Parse/fail("malformed underscore"))
    | false => match seen | true => Parse/pure(acc) | false => Parse/fail("expected digit") end
    end;

--- The largest magnitude a TOML integer has: `2⁶³`, which only the most negative 64-bit integer reaches. TOML 1.0 asks for every 64-bit signed integer and an error past them, and a magnitude is refused the digit it passes this, so no longer numeral is read to its end.
let magnitude_limit: Nat =
    9223372036854775808;

let magnitude(radix: Nat, digit_of: (Nat) -> Option(Nat)) -> Parse(Bytes, Nat) =
    let go(acc: Nat, seen: Bool, pend: Bool) -> Parse(Bytes, Nat) =
        let next = Parse/bytes/peek!;
        match next
        | none() => magnitude_stop(acc, seen, pend)
        | some(b) =>
            let n = Byte/to_nat(b);
            match n == '_'
            | true =>
                match seen && Bool/not(pend)
                | true =>
                    let _ = Parse/bytes/byte!;
                    go(acc, seen, true)
                | false => Parse/commit(Parse/fail("malformed underscore"))
                end
            | false =>
                match digit_of(n)
                | some(d) =>
                    let next = acc * radix + d;
                    match next > magnitude_limit
                    | true => Parse/fail("integer out of range")
                    | false =>
                        let _ = Parse/bytes/byte!;
                        go(next, true, false)
                    end
                | none() => magnitude_stop(acc, seen, pend)
                end
            end
        end;
    go(0, false, false);

let leading_zero: Parse(Bytes, Bool) =
    Parse/lookahead(
        Parse/or(
            Parse/map(
                Parse/and(
                    Parse/bytes/expect('0'),
                    Parse/bytes/byte_if((b) => is_dec_byte(b) || Byte/to_nat(b) == '_')),
                (_) => true),
            Parse/pure(false)));

let sign: Parse(Bytes, {Bool, Bool}) =
    let s = Parse/optional(Parse/bytes/byte_if((b) => b == '+' || b == '-'))!;
    match s | some(b) => Parse/pure((b == '-', true)) | none() => Parse/pure((false, false)) end;

let is_radix_marker(b: Byte) -> Bool =
    match Byte/to_nat(b)
    | 'x' => true
    | 'o' => true
    | 'b' => true
    | _ => false
    end;

let prefixed: Parse(Bytes, Nat) =
    let _ = Parse/bytes/expect('0')!;
    let marker = Parse/bytes/byte!;
    match Byte/to_nat(marker)
    | 'x' => magnitude(16, hex_val)
    | 'o' => magnitude(8, oct_digit)
    | 'b' => magnitude(2, bin_digit)
    | _ => Parse/fail("expected digit")
    end;

--- Refuse a leading zero past the digits it opens. Its callers commit to the refusal: a date or a time was offered the same digits first and declined, so what is left is a number written with a leading zero, and the reason is not one a later alternative may displace.
let refuse_leading_zero(@A: Type) -> Parse(Bytes, A) =
    let _ = Parse/bytes/take_while((b) => is_dec_byte(b) || Byte/to_nat(b) == '_')!;
    Parse/fail("leading zero");

let decimal: Parse(Bytes, Nat) =
    let leading = leading_zero!;
    match leading
    | true => Parse/commit(refuse_leading_zero())
    | false => magnitude(10, dec_digit)
    end;

let int_magnitude(signed: Bool) -> Parse(Bytes, Nat) =
    match signed
    | true => decimal
    | false =>
        let marked =
            Parse/optional(
                Parse/lookahead(
                    Parse/and(Parse/bytes/expect('0'), Parse/bytes/byte_if(is_radix_marker))))!;
        match marked | some(_) => prefixed | none() => decimal end
    end;

--- An integer in any of the bases TOML writes, refused past the range an `Int` holds.
pub let int_value: Parse(Bytes, Toml) =
    let (negative, signed) = sign!;
    let mag = int_magnitude(signed)!;
    -- `magnitude` already refused past `2⁶³`, the most negative integer's magnitude and one past the most positive's.
    match negative
    | true => Parse/pure(Toml/int(+0 - Nat/to_int(mag)))
    | false =>
        match mag == magnitude_limit
        | true => Parse/fail("integer out of range")
        | false => Parse/pure(Toml/int(Nat/to_int(mag)))
        end
    end;

let flt_digits_stop(
    sig: Nat,
    count: Nat,
    shift: Nat,
    seen: Bool,
    pend: Bool,
) -> Parse(Bytes, {Nat, Nat, Nat}) =
    match pend
    | true => Parse/commit(Parse/fail("malformed underscore"))
    | false =>
        match seen
        | true => Parse/pure((sig, count, shift))
        | false => Parse/fail("expected digit")
        end
    end;

let flt_digits(sig0: Nat, count0: Nat, frac: Bool) -> Parse(Bytes, {Nat, Nat, Nat}) =
    let go(
        sig: Nat,
        count: Nat,
        shift: Nat,
        seen: Bool,
        pend: Bool,
    ) -> Parse(Bytes, {Nat, Nat, Nat}) =
        let next = Parse/bytes/peek!;
        match next
        | none() => flt_digits_stop(sig, count, shift, seen, pend)
        | some(b) =>
            let n = Byte/to_nat(b);
            choose
            | n == '_' =>
                match seen && Bool/not(pend)
                | true =>
                    let _ = Parse/bytes/byte!;
                    go(sig, count, shift, seen, true)
                | false => Parse/commit(Parse/fail("malformed underscore"))
                end
            | Nat/in_range(n, '0', '9') =>
                let _ = Parse/bytes/byte!;
                let shift2 = match frac | true => shift + 1 | false => shift end;
                go(sig * 10 + (n - '0'), count + 1, shift2, true, false)
            | _ => flt_digits_stop(sig, count, shift, seen, pend)
            end
        end;
    go(sig0, count0, 0, false, false);

let exp_stop(acc: Nat, seen: Bool, pend: Bool) -> Parse(Bytes, Nat) =
    match pend
    | true => Parse/commit(Parse/fail("malformed underscore"))
    | false => match seen | true => Parse/pure(acc) | false => Parse/fail("expected digit") end
    end;

let exp_digits: Parse(Bytes, Nat) =
    let go(acc: Nat, seen: Bool, pend: Bool) -> Parse(Bytes, Nat) =
        let next = Parse/bytes/peek!;
        match next
        | none() => exp_stop(acc, seen, pend)
        | some(b) =>
            let n = Byte/to_nat(b);
            choose
            | n == '_' =>
                match seen && Bool/not(pend)
                | true =>
                    let _ = Parse/bytes/byte!;
                    go(acc, seen, true)
                | false => Parse/commit(Parse/fail("malformed underscore"))
                end
            | Nat/in_range(n, '0', '9') =>
                let _ = Parse/bytes/byte!;
                go(Nat/min(acc * 10 + (n - '0'), 2000), true, false)
            | _ => exp_stop(acc, seen, pend)
            end
        end;
    go(0, false, false);

--- A float's named values, `inf` and `nan`, under either sign.
pub let flt_special: Parse(Bytes, Toml) =
    let (negative, _) = sign!;
    Parse/or(
        Parse/map(
            Parse/bytes/literal("inf"),
            (_) => Toml/flt(match negative | true => -inf.0 | false => +inf.0 end)),
        Parse/map(
            Parse/bytes/literal("nan"),
            (_) => Toml/flt(match negative | true => -nan.0 | false => +nan.0 end)));

let frac_fields(sig0: Nat, count0: Nat) -> Parse(Bytes, {Nat, Nat, Nat, Bool}) =
    let (sig, count, down) = flt_digits(sig0, count0, true)!;
    Parse/pure((sig, count, down, true));

let frac_part(sig0: Nat, count0: Nat) -> Parse(Bytes, {Nat, Nat, Nat, Bool}) =
    let dot = Parse/optional(Parse/bytes/expect('.'))!;
    match dot
    | none() => Parse/pure((sig0, count0, 0, false))
    | some(_) => Parse/commit(frac_fields(sig0, count0))
    end;

let exp_fields: Parse(Bytes, {Nat, Bool, Bool}) =
    let (eneg, _) = sign!;
    let emag = exp_digits!;
    Parse/pure((emag, eneg, true));

let exp_part: Parse(Bytes, {Nat, Bool, Bool}) =
    let marker = Parse/optional(Parse/bytes/byte_if((b) => b == 'e' || b == 'E'))!;
    match marker
    | none() => Parse/pure((0, false, false))
    | some(_) => Parse/commit(exp_fields)
    end;

--- A float written out: digits, an optional fraction and an optional exponent, with a leading zero refused.
pub let flt_number: Parse(Bytes, Toml) =
    let (negative, _) = sign!;
    let leading = leading_zero!;
    match leading
    | true => Parse/commit(refuse_leading_zero())
    | false =>
        let (sig1, count1, _) = flt_digits(0, 0, false)!;
        let (sig2, count2, down2, has_frac) = frac_part(sig1, count1)!;
        let (emag, eneg, has_exp) = exp_part!;
        match has_frac || has_exp
        | true =>
            let exponent =
                match eneg | true => +0 - Nat/to_int(emag) | false => Nat/to_int(emag) end;
            let scale = exponent - Nat/to_int(down2);
            Parse/pure(Toml/flt(Flt/of_decimal(negative, sig2, scale, count2)))
        | false => Parse/fail("expected float")
        end
    end;
