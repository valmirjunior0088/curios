use /std/{Nat, Bool, Byte, Bytes, Char, Str, Option, Parse};
use /std/Toml/scan/{hex_val};

let hex_digit: Parse(Bytes, Nat) =
    let next = Parse/bytes/peek!;
    match next
    | none() => Parse/fail("unterminated escape")
    | some(b) =>
        match hex_val(Byte/to_nat(b))
        | some(v) =>
            let _ = Parse/bytes/byte!;
            Parse/pure(v)
        | none() => Parse/fail("invalid hex digit in escape")
        end
    end;

let hex_digits(count: Nat, acc: Nat) -> Parse(Bytes, Nat) =
    match count
    | 0 => Parse/pure(acc)
    | pred + 1 =>
        let v = hex_digit!;
        hex_digits(pred, acc * 0x10 + v)
    end;

let scalar_utf8(code: Nat) -> Parse(Bytes, Bytes) =
    match Char/of_nat(code)
    | some(c) => Parse/pure(Char/to_utf8(c))
    | none() => Parse/fail("invalid Unicode scalar in escape")
    end;

let escape: Parse(Bytes, Bytes) =
    let next = Parse/bytes/peek!;
    match next
    | none() => Parse/fail("unterminated escape")
    | some(b) =>
        let _ = Parse/bytes/byte!;
        match Byte/to_nat(b)
        | 'b' => Parse/pure(x['\u{8}'])
        | 't' => Parse/pure(x['\t'])
        | 'n' => Parse/pure(x['\n'])
        | 'f' => Parse/pure(x['\u{C}'])
        | 'r' => Parse/pure(x['\r'])
        | '"' => Parse/pure(x['"'])
        | '\\' => Parse/pure(x['\\'])
        | 'u' =>
            let code = hex_digits(4, 0)!;
            scalar_utf8(code)
        | 'U' =>
            let code = hex_digits(8, 0)!;
            scalar_utf8(code)
        | _ => Parse/fail("unknown escape")
        end
    end;

let crlf: Parse(Bytes, Option({Byte, Byte})) =
    Parse/optional(Parse/and(Parse/bytes/expect('\r'), Parse/bytes/expect('\n')));

let basic_body(acc: Bytes) -> Parse(Bytes, Bytes) =
    let next = Parse/bytes/peek!;
    match next
    | none() => Parse/fail("unterminated string")
    | some(b) =>
        let n = Byte/to_nat(b);
        choose
        | n == '"' =>
            let _ = Parse/bytes/byte!;
            Parse/pure(acc)
        | n == '\\' =>
            let _ = Parse/bytes/byte!;
            let chunk = escape!;
            basic_body(x[..acc, ..chunk])
        | n == '\t' =>
            let _ = Parse/bytes/byte!;
            basic_body(x[..acc, b])
        | n < 0x20 => Parse/fail("control character in string")
        | n == 0x7F => Parse/fail("control character in string")
        | _ =>
            let _ = Parse/bytes/byte!;
            basic_body(x[..acc, b])
        end
    end;

let basic_str_scan: Parse(Bytes, Bytes) =
    let _ = Parse/label(Parse/bytes/expect('"'), "expected string")!;
    basic_body(x[]);

let literal_body(acc: Bytes) -> Parse(Bytes, Bytes) =
    let next = Parse/bytes/peek!;
    match next
    | none() => Parse/fail("unterminated string")
    | some(b) =>
        let n = Byte/to_nat(b);
        choose
        | n == '\'' =>
            let _ = Parse/bytes/byte!;
            Parse/pure(acc)
        | n == '\t' =>
            let _ = Parse/bytes/byte!;
            literal_body(x[..acc, b])
        | n < 0x20 => Parse/fail("control character in string")
        | n == 0x7F => Parse/fail("control character in string")
        | _ =>
            let _ = Parse/bytes/byte!;
            literal_body(x[..acc, b])
        end
    end;

let literal_str_scan: Parse(Bytes, Bytes) =
    let _ = Parse/label(Parse/bytes/expect('\''), "expected string")!;
    literal_body(x[]);

let trim_run(seen_nl: Bool) -> Parse(Bytes, {}) =
    let stop: Parse(Bytes, {}) =
        match seen_nl | true => Parse/pure(()) | false => Parse/fail("invalid escape") end;
    let next = Parse/bytes/peek!;
    match next
    | none() => stop
    | some(b) =>
        let n = Byte/to_nat(b);
        choose
        | n == ' ' =>
            let _ = Parse/bytes/byte!;
            trim_run(seen_nl)
        | n == '\t' =>
            let _ = Parse/bytes/byte!;
            trim_run(seen_nl)
        | n == '\n' =>
            let _ = Parse/bytes/byte!;
            trim_run(true)
        | n == '\r' =>
            let pair = crlf!;
            match pair
            | some(_) => trim_run(true)
            | none() => Parse/fail("bare carriage return")
            end
        | _ => stop
        end
    end;

let skip_opening_newline: Parse(Bytes, {}) =
    let lf = Parse/optional(Parse/bytes/expect('\n'))!;
    match lf
    | some(_) => Parse/pure(())
    | none() =>
        let _ = crlf!;
        Parse/pure(())
    end;

let ml_basic_body(acc: Bytes) -> Parse(Bytes, Bytes) =
    let next = Parse/bytes/peek!;
    match next
    | none() => Parse/fail("unterminated string")
    | some(b) =>
        let n = Byte/to_nat(b);
        choose
        | n == '"' =>
            let run = Parse/bytes/take_while((c) => Byte/to_nat(c) == '"')!;
            let q = Bytes/len(run);
            choose
            | q >= 6 => Parse/fail("too many quotes")
            | q >= 3 => Parse/pure(x[..acc, ..Bytes/replicate(q - 3, b)])
            | _ => ml_basic_body(x[..acc, ..Bytes/replicate(q, b)])
            end
        | n == '\\' =>
            let _ = Parse/bytes/byte!;
            let folded = Parse/bytes/peek!;
            match folded
            | some(w) =>
                let m = Byte/to_nat(w);
                match m == ' ' || m == '\t' || m == '\n' || m == '\r'
                | true =>
                    let _ = trim_run(false)!;
                    ml_basic_body(acc)
                | false =>
                    let chunk = escape!;
                    ml_basic_body(x[..acc, ..chunk])
                end
            | none() =>
                let chunk = escape!;
                ml_basic_body(x[..acc, ..chunk])
            end
        | n == '\n' =>
            let _ = Parse/bytes/byte!;
            ml_basic_body(x[..acc, b])
        | n == '\r' =>
            let pair = crlf!;
            match pair
            | some(_) => ml_basic_body(x[..acc, '\r', '\n'])
            | none() => Parse/fail("bare carriage return")
            end
        | n == '\t' =>
            let _ = Parse/bytes/byte!;
            ml_basic_body(x[..acc, b])
        | n < 0x20 => Parse/fail("control character in string")
        | n == 0x7F => Parse/fail("control character in string")
        | _ =>
            let _ = Parse/bytes/byte!;
            ml_basic_body(x[..acc, b])
        end
    end;

let ml_literal_body(acc: Bytes) -> Parse(Bytes, Bytes) =
    let next = Parse/bytes/peek!;
    match next
    | none() => Parse/fail("unterminated string")
    | some(b) =>
        let n = Byte/to_nat(b);
        choose
        | n == '\'' =>
            let run = Parse/bytes/take_while((c) => Byte/to_nat(c) == '\'')!;
            let q = Bytes/len(run);
            choose
            | q >= 6 => Parse/fail("too many quotes")
            | q >= 3 => Parse/pure(x[..acc, ..Bytes/replicate(q - 3, b)])
            | _ => ml_literal_body(x[..acc, ..Bytes/replicate(q, b)])
            end
        | n == '\n' =>
            let _ = Parse/bytes/byte!;
            ml_literal_body(x[..acc, b])
        | n == '\r' =>
            let pair = crlf!;
            match pair
            | some(_) => ml_literal_body(x[..acc, '\r', '\n'])
            | none() => Parse/fail("bare carriage return")
            end
        | n == '\t' =>
            let _ = Parse/bytes/byte!;
            ml_literal_body(x[..acc, b])
        | n < 0x20 => Parse/fail("control character in string")
        | n == 0x7F => Parse/fail("control character in string")
        | _ =>
            let _ = Parse/bytes/byte!;
            ml_literal_body(x[..acc, b])
        end
    end;

let str_of(b: Bytes) -> Parse(Bytes, Str) =
    match Str/of_bytes(b)
    | some(s) => Parse/pure(s)
    | none() => Parse/fail("invalid UTF-8 in string")
    end;

--- A basic string, delimited by `"`, with its escapes resolved.
pub let str_basic: Parse(Bytes, Str) =
    let b = basic_str_scan!;
    str_of(b);

--- A literal string, delimited by `'`, taken as written.
pub let str_literal: Parse(Bytes, Str) =
    let b = literal_str_scan!;
    str_of(b);

--- A multi-line basic string, delimited by `"""`, with its escapes resolved and the opening line break dropped.
pub let str_ml_basic: Parse(Bytes, Str) =
    let _ = Parse/bytes/literal("\"\"\"")!;
    let _ = skip_opening_newline!;
    let b = ml_basic_body(x[])!;
    str_of(b);

--- A multi-line literal string, delimited by `'''`, taken as written with the opening line break dropped.
pub let str_ml_literal: Parse(Bytes, Str) =
    let _ = Parse/bytes/literal("'''")!;
    let _ = skip_opening_newline!;
    let b = ml_literal_body(x[])!;
    str_of(b);
