use /std/{Byte, Str, List, Map, Bytes, Parse};
use /std/Toml/{Toml};
use /std/Toml/build/{inline_fold};
use /std/Toml/scan/{trivia, ws};
use /std/Toml/strings/{str_basic, str_literal, str_ml_basic, str_ml_literal};
use /std/Toml/keys/{key_dotted};
use /std/Toml/numbers/{flt_number, flt_special, int_value};
use /std/Toml/datetime/{datetime_value};

let val_str_basic: Parse(Bytes, Toml) =
    Parse/map(Parse/or(str_ml_basic, str_basic), (s) => Toml/str(s));

let val_str_literal: Parse(Bytes, Toml) =
    Parse/map(Parse/or(str_ml_literal, str_literal), (s) => Toml/str(s));

let val_true: Parse(Bytes, Toml) =
    Parse/map(Parse/bytes/literal("true"), (_) => Toml/bool(true));

let val_false: Parse(Bytes, Toml) =
    Parse/map(Parse/bytes/literal("false"), (_) => Toml/bool(false));

let val_number_signed: Parse(Bytes, Toml) =
    Parse/or(flt_special, Parse/or(flt_number, int_value));

let val_number_digit: Parse(Bytes, Toml) =
    Parse/or(datetime_value, Parse/or(flt_number, int_value));

let array_parse: Parse(Bytes, Toml) =
    let _ = Parse/label(Parse/bytes/expect(0x5B), "expected array")!;
    array_items([])
and array_items(acc: List(Toml)) -> Parse(Bytes, Toml) =
    let _ = trivia!;
    let closed = Parse/optional(Parse/bytes/expect(0x5D))!;
    match closed
    | some(_) => Parse/pure(Toml/arr(acc))
    | none() =>
        let v = value_parse!;
        let _ = trivia!;
        let acc2 = [..acc, v];
        let comma = Parse/optional(Parse/bytes/expect(0x2C))!;
        match comma
        | some(_) => array_items(acc2)
        | none() =>
            let stop = Parse/optional(Parse/bytes/expect(0x5D))!;
            match stop
            | some(_) => Parse/pure(Toml/arr(acc2))
            | none() => Parse/fail("expected ',' or ']' in array")
            end
        end
    end
and inline_parse: Parse(Bytes, Toml) =
    let _ = Parse/label(Parse/bytes/expect(0x7B), "expected inline table")!;
    let _ = ws!;
    let empty = Parse/optional(Parse/bytes/expect(0x7D))!;
    match empty | some(_) => Parse/pure(Toml/table(Map/empty())) | none() => inline_items([]) end
and inline_items(acc: List({List(Str), Toml})) -> Parse(Bytes, Toml) =
    let path = key_dotted!;
    let _ = ws!;
    let _ = Parse/label(Parse/bytes/expect(0x3D), "expected '=' in inline table")!;
    let _ = ws!;
    let v = value_parse!;
    let _ = ws!;
    let acc2 = [..acc, (path, v)];
    let comma = Parse/optional(Parse/bytes/expect(0x2C))!;
    match comma
    | some(_) =>
        let _ = ws!;
        inline_items(acc2)
    | none() =>
        let stop = Parse/optional(Parse/bytes/expect(0x7D))!;
        match stop
        | some(_) =>
            match inline_fold(acc2)
            | success(m) => Parse/pure(Toml/table(m))
            | failure(e) => Parse/fail(/std/Toml/Error/message(e))
            end
        | none() => Parse/fail("expected ',' or '}' in inline table")
        end
    end
pub and value_parse: Parse(Bytes, Toml) =
    let next = Parse/bytes/peek!;
    match next
    | none() => Parse/fail("expected value")
    | some(b) =>
        match Byte/to_nat(b)
        | 34 => val_str_basic
        | 39 => val_str_literal
        | 116 => val_true
        | 102 => val_false
        | 91 => array_parse
        | 123 => inline_parse
        | 43 => val_number_signed
        | 45 => val_number_signed
        | 105 => flt_special
        | 110 => flt_special
        | _ => val_number_digit
        end
    end;
