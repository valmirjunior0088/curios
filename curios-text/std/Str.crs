pub use /syn/{Str};
pub use /syn/Str/{Class, classify, Scan, step, Utf8, Valid};
use /std/{Char, Nat, Bin, Bln, Arr, Lst, Option, True, False};


rec seq(@s : Scan, @a : Bin, @b : Bin, va : Utf8(s, a), vb : Valid(b))
    -> Utf8(s, Bin/concat(a, b)) =
    match va : (w : Utf8(q, x)) => Utf8(q, Bin/concat(x, b))
    | stop() => vb
    | more(c, st, t, rest) => Utf8/more(c, st, Bin/concat(t, b), seq(rest, vb))
    end;

let concat_closed(@a : Bin, @b : Bin, va : Valid(a), vb : Valid(b))
    -> Valid(Bin/concat(a, b)) =
    seq(va, vb);

let check(b : Bin) -> ((s : Scan) -> Option(Utf8(s, b))) =
    match b
    | \\ => (s) =>
        match s
        | lead() => Option/some(Utf8/stop())
        | cont(rem, lo, hi) => Option/none()
        | bad() => Option/none()
        end
    | h, ..t; ih => (s) =>
        match ih(step(h, s))
        | some(rest) => Option/some(Utf8/more(h, s, t, rest))
        | none() => Option/none()
        end
    end;

pub let to_bin(s : Str) -> Bin =
    s.bytes;

pub let of_bin(b : Bin) -> Option(Str) =
    match check(b)(Scan/lead())
    | some(v) => Option/some(Str { bytes = b, valid = v })
    | none() => Option/none()
    end;

pub let concat(a : Str, b : Str) -> Str =
    Str { bytes = Bin/concat(a.bytes, b.bytes),
          valid = concat_closed(@a.bytes, @b.bytes, a.valid, b.valid) };

rec drop_width(n : Nat, s : Scan, b : Bin) -> Nat =
    match b
    | \\ => 0
    | h, ..t; ih =>
        match s
        | lead() =>
            match n
            | 0 => 0
            | pred + 1; ih2 => 1 + drop_width(pred, step(h, Scan/lead()), t)
            end
        | cont(rem, lo, hi) => 1 + drop_width(n, step(h, Scan/cont(rem, lo, hi)), t)
        | bad() => 1 + drop_width(n, step(h, Scan/bad()), t)
        end
    end;

rec drop_valid(n : Nat, s : Scan, @b : Bin, d : Utf8(s, b))
    -> Valid(Bin/slice(b, drop_width(n, s, b), Bin/len(b))) =
    match s
    | lead() =>
        match d
        | stop() => Utf8/stop()
        | more(c, st, t, rest) =>
            match n
            | 0 => Utf8/more(c, Scan/lead(), t, rest)
            | pred + 1; ih => drop_valid(pred, step(c, Scan/lead()), @t, rest)
            end
        end
    | cont(rem, lo, hi) =>
        match d
        | more(c, st, t, rest) => drop_valid(n, step(c, Scan/cont(rem, lo, hi)), @t, rest)
        end
    | bad() =>
        match d
        | more(c, st, t, rest) => drop_valid(n, step(c, Scan/bad()), @t, rest)
        end
    end;

rec take_valid(n : Nat, s : Scan, @b : Bin, d : Utf8(s, b))
    -> Utf8(s, Bin/slice(b, 0, drop_width(n, s, b))) =
    match s
    | lead() =>
        match d
        | stop() => Utf8/stop()
        | more(c, st, t, rest) =>
            match n
            | 0 => Utf8/stop()
            | pred + 1; ih =>
                Utf8/more(c, Scan/lead(), Bin/slice(t, 0, drop_width(pred, step(c, Scan/lead()), t)),
                    take_valid(pred, step(c, Scan/lead()), @t, rest))
            end
        end
    | cont(rem, lo, hi) =>
        match d
        | more(c, st, t, rest) =>
            Utf8/more(c, Scan/cont(rem, lo, hi),
                Bin/slice(t, 0, drop_width(n, step(c, Scan/cont(rem, lo, hi)), t)),
                take_valid(n, step(c, Scan/cont(rem, lo, hi)), @t, rest))
        end
    | bad() =>
        match d
        | more(c, st, t, rest) =>
            Utf8/more(c, Scan/bad(),
                Bin/slice(t, 0, drop_width(n, step(c, Scan/bad()), t)),
                take_valid(n, step(c, Scan/bad()), @t, rest))
        end
    end;

let drop_n(n : Nat, s : Str) -> Str =
    Str { bytes = Bin/slice(s.bytes, drop_width(n, Scan/lead(), s.bytes), Bin/len(s.bytes)),
          valid = drop_valid(n, Scan/lead(), @s.bytes, s.valid) };

let take_n(n : Nat, s : Str) -> Str =
    Str { bytes = Bin/slice(s.bytes, 0, drop_width(n, Scan/lead(), s.bytes)),
          valid = take_valid(n, Scan/lead(), @s.bytes, s.valid) };

pub let slice(s : Str, x : Nat, y : Nat) -> Str =
    take_n(y - x, drop_n(x, s));

pub let flatten(parts : Lst(Str)) -> Str =
    Lst/fold(parts, "", (p, acc) => concat(acc, p));

pub let eql(a : Str, b : Str) -> Bln =
    Bin/eql(to_bin(a), to_bin(b));

let lower_bytes(b : Bin) -> Bin =
    Bin/fold(b, \\, (byte, acc) => Bin/append(acc, Char/to_lower(byte)));

pub let eql_ci(a : Str, b : Str) -> Bln =
    Bin/eql(lower_bytes(to_bin(a)), lower_bytes(to_bin(b)));

pub let repeat(s : Str, n : Nat) -> Str =
    Arr/balanced(n, "", (i) => s, (l, r) => concat(l, r));

pub rec bad_uninhabited(@x : Bin, w : Utf8(Scan/bad(), x)) -> False =
    match w : (w : Utf8(q, y)) => False
    | more(c, st, t, rest) => bad_uninhabited(@t, rest)
    end;

pub rec cont_len(k : Nat, @lo : Nat, @hi : Nat, @t : Bin, w : Utf8(Scan/cont(k, lo, hi), t))
    -> Nat/Lte(k, Bin/len(t)) =
    match k
    | 0 => Nat/Lte/z()
    | kp + 1; ih =>
        match w
        | more(c, st, tt, rest) =>
            match kp
            | 0 => Nat/Lte/s(Nat/Lte/z())
            | kpp + 1; ih2 =>
                -- Matching `Nat/in_range(c, lo, hi)` directly refines `rest`'s
                -- type: `step(c, Scan/cont(kp + 1, lo, hi))` reduces to
                -- `Scan/cont(kpp + 1, 0x80, 0xBF)` (true) or `Scan/bad()` (false).
                Nat/Lte/s(
                    match Nat/in_range(c, lo, hi)
                    | true => cont_len(kpp + 1, @0x80, @0xBF, @tt, rest)
                    | false =>
                        False/absurd(@Nat/Lte(kpp + 1, Bin/len(tt)),
                            bad_uninhabited(@tt, rest))
                    end)
            end
        end
    end;

pub rec cont0_uninhabited(@lo : Nat, @hi : Nat, @t : Bin, w : Utf8(Scan/cont(0, lo, hi), t)) -> False =
    match w : (w : Utf8(q, y)) => False
    | more(c, st, t2, rest) =>
        match Nat/in_range(c, lo, hi)
        | false => bad_uninhabited(@t2, rest)
        | true => cont0_uninhabited(@0x80, @0xBF, @t2, rest)
        end
    end;

pub rec take_conts(b : Bin, off : Nat, remaining : Nat, acc : Nat,
    bound : Nat/Lte(off + remaining, Bin/len(b))) -> {Nat, Nat} =
    match remaining
    | 0 => (acc, off)
    | pred + 1; ih =>
        take_conts(b, off + 1, pred,
            acc * 0x40 + (Bin/at(b, off,
                Nat/lt_of_lte_succ(Nat/lte_trans(Nat/Lte/s(Nat/lte_add_r(off, pred)), bound))) - 0x80),
            bound)
    end;

pub rec peel_byte(@s : Scan, @b : Bin, nz : Nat/Lt(0, Bin/len(b)), w : Utf8(s, b))
    -> Utf8(step(Bin/at(b, 0, nz), s), Bin/slice(b, 1, Bin/len(b))) =
    -- Matching `w` directly refines the goal: the type checker generalizes the
    -- dependent hypothesis `nz` into the motive automatically (no convoy needed).
    match w
    | stop() =>
        False/absurd(@Utf8(step(Bin/at(\\, 0, nz), Scan/lead()), Bin/slice(\\, 1, Bin/len(\\))), nz)
    | more(c, st, t, rest) => rest
    end;

pub rec count_w(s : Scan, b : Bin) -> Nat =
    match b
    | \\ => 0
    | h, ..t; ih =>
        match s
        | lead() => count_w(step(h, Scan/lead()), t) + 1
        | cont(rem, lo, hi) => count_w(step(h, Scan/cont(rem, lo, hi)), t)
        | bad() => count_w(step(h, Scan/bad()), t)
        end
    end;

pub let decode_head(c : Nat, @t : Bin, w : Utf8(Scan/lead(), Bin/cons(c, t))) -> Nat =
    -- `peel_byte(...)` has type `Utf8(step(c, Scan/lead()), t)`. Matching
    -- `classify(c)` directly refines that type: `step(c, Scan/lead())` reduces
    -- to the arm's `Scan` (`Scan/cont(k, lo, hi)` / `Scan/bad()`), so no `Eq`
    -- transport is needed to retype `w`.
    match classify(c)
    | ascii() => c
    | lead(k, lo, hi, payload) =>
        take_conts(t, 0, k, payload,
            cont_len(k, @lo, @hi, @t,
                peel_byte(@Scan/lead(), @Bin/cons(c, t), True/qed(), w))).0
    | bad() =>
        False/absurd(@Nat,
            bad_uninhabited(@t,
                peel_byte(@Scan/lead(), @Bin/cons(c, t), True/qed(), w)))
    end;

pub let fold(@A : Type, s : Str, init : A, f : (Nat, A) -> A) -> A =
    (match s.bytes : (b) => (sc : Scan, valid : Utf8(sc, b), acc : {A, Nat}) -> {A, Nat}
    | \\ => (sc, valid, acc) => acc
    | h, ..t; ih => (sc, valid, acc) =>
        match sc
        | lead() =>
            ih(step(h, Scan/lead()),
                peel_byte(@Scan/lead(), @Bin/cons(h, t), True/qed(), valid),
                match classify(h)
                | ascii() => (f(h, acc.0), 0)
                | lead(width, lo, hi, payload) => (acc.0, payload)
                | bad() => acc
                end)
        | cont(rem, lo, hi) =>
            let partial = acc.1 * 0x40 + (h - 0x80);
            ih(step(h, Scan/cont(rem, lo, hi)),
                peel_byte(@Scan/cont(rem, lo, hi), @Bin/cons(h, t), True/qed(), valid),
                match rem == 1
                | true => (f(partial, acc.0), 0)
                | false => (acc.0, partial)
                end)
        | bad() =>
            ih(step(h, Scan/bad()),
                peel_byte(@Scan/bad(), @Bin/cons(h, t), True/qed(), valid), acc)
        end
    end)(Scan/lead(), s.valid, (init, 0)).0;

pub let len(s : Str) -> Nat =
    count_w(Scan/lead(), s.bytes);

pub let find_index(s : Str, pred : (Nat) -> Bln) -> Option(Nat) =
    let r : {Nat, Option(Nat)} =
        fold(s, (0, Option/none()), (codepoint, acc) =>
            match acc.1
            | some(_) => acc
            | none() =>
                (acc.0 + 1,
                    match pred(codepoint)
                    | true => Option/some(acc.0)
                    | false => Option/none()
                    end)
            end);
    r.1;

pub let find(s : Str, target : Nat) -> Option(Nat) =
    find_index(s, (codepoint) => codepoint == target);

pub let get(s : Str, i : Nat) -> Option(Nat) =
    let r : {Nat, Option(Nat)} =
        fold(s, (0, Option/none()), (codepoint, acc) =>
            match acc.1
            | some(_) => acc
            | none() =>
                match acc.0 == i
                | true => (acc.0 + 1, Option/some(codepoint))
                | false => (acc.0 + 1, Option/none())
                end
            end);
    r.1;

rec lte_succ_of_lt(i : Nat, n : Nat, p : Nat/Lt(i, n)) -> Nat/Lte(i + 1, n) =
    match n
    | 0 => False/absurd(@Nat/Lte(i + 1, 0), p)
    | np + 1; ihn =>
        match i
        | 0 => Nat/Lte/s(Nat/Lte/z())
        | ip + 1; ihi => Nat/Lte/s(lte_succ_of_lt(ip, np, p))
        end
    end;

pub let at(s : Str, i : Nat, ok : Nat/Lt(i, len(s))) -> Nat =
    rec go(sc : Scan, b : Bin, valid : Utf8(sc, b), i : Nat,
        le : Nat/Lte(i + 1, count_w(sc, b))) -> Nat =
        match b
        | \\ => match le : Nat end
        | h, ..t; ih =>
            match sc
            | lead() =>
                match i
                | 0 => decode_head(h, @t, valid)
                | pred + 1; ih2 =>
                    go(step(h, Scan/lead()), t,
                        peel_byte(@Scan/lead(), @Bin/cons(h, t), True/qed(), valid), pred,
                        (match le : (le : Nat/Lte(x, y)) => Nat/Lte(x - 1, y - 1)
                         | s(a, c, prev) => prev
                         end))
                end
            | cont(rem, lo, hi) =>
                go(step(h, Scan/cont(rem, lo, hi)), t,
                    peel_byte(@Scan/cont(rem, lo, hi), @Bin/cons(h, t), True/qed(), valid), i, le)
            | bad() =>
                go(step(h, Scan/bad()), t,
                    peel_byte(@Scan/bad(), @Bin/cons(h, t), True/qed(), valid), i, le)
            end
        end;
    go(Scan/lead(), s.bytes, s.valid, i,
        lte_succ_of_lt(i, count_w(Scan/lead(), s.bytes), ok));

pub let join(sep : Str, parts : Lst(Str)) -> Str =
    let pa = Lst/to_arr(parts);
    Arr/balanced(Arr/len(pa), "", (i) => Option/unwrap_or(Arr/get(pa, i), ""),
        (l, r) => concat(concat(l, sep), r));

let trim_bounds(s : Str) -> {Nat, Nat} =
    let n = len(s);
    let r : {Nat, Nat, Nat} =
        fold(s, (0, n, 0), (codepoint, acc) =>
            match Char/is_whitespace(codepoint)
            | true => (acc.0 + 1, acc.1, acc.2)
            | false =>
                let start =
                    match acc.1 < n
                    | true => acc.1
                    | false => acc.0
                    end;
                (acc.0 + 1, start, acc.0 + 1)
            end);
    (r.1, r.2);

pub let trim(s : Str) -> Str =
    let b = trim_bounds(s);
    match b.0 < b.1
    | false => ""
    | true => slice(s, b.0, b.1)
    end;
