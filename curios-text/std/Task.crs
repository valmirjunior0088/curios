use /std/{Io, Bin, Nat, Bln, Arr, Lst, Option, Result, Cell, Monad};

induct Pause : Type
| wait(Io, Nat)
| fork(() -> Task({}), Cell(Bln))
| park((() -> {}) -> {})
| acquire(Io, () -> {})
| release(Io)
| defer()
pub and Task(A : Type) : Type
| done(A)
| step(Pause, () -> Task(A))
end

use Task/*;

pub let Finalizer : Type =
    () -> {};

pub let Fiber : Type =
    () -> Task({});

pub let Waker : Type =
    () -> {};

pub let Token : Type =
    Cell(Bln);

let Guard : Type =
    {Io, Finalizer};

pub let pure(@A : Type, a : A) -> Task(A) =
    Task/done(a);

pub rec bind(@A : Type, @B : Type) -> (Task(A), (A) -> Task(B)) -> Task(B) =
    (m, f) =>
        match m : Task(B)
        | done(a) => f(a)
        | step(p, k) => Task/step(p, () => bind(k(), f))
        end;

pub let map(@A : Type, @B : Type, f : (A) -> B, m : Task(A)) -> Task(B) =
    bind(m, (a) => pure(f(a)));

let fork_with(child : Fiber, t : Token) -> Task({}) =
    Task/step(Pause/fork(child, t), () => pure(()));

pub let defer(@A : Type, body : () -> Task(A)) -> Task(A) =
    Task/step(Pause/defer(), body);

pub let wait(h : Io, ev : Nat) -> Task({}) =
    Task/step(Pause/wait(h, ev), () => pure(()));

pub let park(register : (Waker) -> {}) -> Task({}) =
    Task/step(Pause/park(register), () => pure(()));

pub let acquire(h : Io, fin : Finalizer) -> Task({}) =
    Task/step(Pause/acquire(h, fin), () => pure(()));

pub let release(h : Io) -> Task({}) =
    Task/step(Pause/release(h), () => pure(()));

pub let using(@A : Type, h : Io, fin : Finalizer, body : Task(A)) -> Task(A) =
    bind(acquire(h, fin), (_) =>
        bind(body, (a) =>
            bind(release(h), (_) => pure(a))));

pub let go(body : Fiber) -> Task({}) =
    defer(() => fork_with(body, Cell/new(false)));

pub let nonblocking(h : Io) -> {} =
    let _ = /sys/Io/set_nonblocking(h, true);
    ();

pub rec read(h : Io, n : Nat) -> Task(Io/Read) =
    defer(() =>
        let r = /sys/Io/read(h, n);
        match r.status == /sys/Io/Status/would_block : Task(Io/Read)
        | true => bind(wait(h, /sys/Io/Poll/read), (_) => read(h, n))
        | false =>
            match r.status == /sys/Io/Status/eof : Task(Io/Read)
            | true => pure(Io/Read/eof())
            | false =>
                match r.status == /sys/Io/Status/ok : Task(Io/Read)
                | true => pure(Io/Read/chunk(r.bytes))
                | false => pure(Io/Read/error(Io/error_of(r.status)))
                end
            end
        end);

pub rec write(h : Io, b : Bin) -> Task(Result({}, Io/Error)) =
    defer(() =>
        let r = /sys/Io/write(h, b);
        match r.status == /sys/Io/Status/would_block : Task(Result({}, Io/Error))
        | true => bind(wait(h, /sys/Io/Poll/write), (_) => write(h, b))
        | false =>
            match r.status == /sys/Io/Status/ok : Task(Result({}, Io/Error))
            | true =>
                match r.written < Bin/len(b) : Task(Result({}, Io/Error))
                | true => bind(wait(h, /sys/Io/Poll/write), (_) => write(h, Bin/slice(b, r.written, Bin/len(b))))
                | false => pure(Result/success(()))
                end
            | false => pure(Result/failure(Io/error_of(r.status)))
            end
        end);

pub rec accept(l : Io) -> Task(Result(Io, Io/Error)) =
    defer(() =>
        let r = /sys/Io/accept(l);
        match r.status == /sys/Io/Status/would_block : Task(Result(Io, Io/Error))
        | true => bind(wait(l, /sys/Io/Poll/read), (_) => accept(l))
        | false =>
            match r.status == /sys/Io/Status/ok : Task(Result(Io, Io/Error))
            | true => pure(Result/success(r.handle))
            | false => pure(Result/failure(Io/error_of(r.status)))
            end
        end);

pub let drain(read : (Nat) -> Task(Io/Read)) -> Task(Bin) =
    rec go(acc : Lst(Bin)) -> Task(Bin) =
        let finish = () => Bin/flatten(Lst/to_arr(Lst/rev(acc)));
        bind(read(4096), (r) =>
            match r : Task(Bin)
            | chunk(bytes) => go(Lst/cons(bytes, acc))
            | eof() => pure(finish())
            | error(_) => pure(finish())
            end);
    go(Lst/nil(@Bin));

pub induct Fut(A : Type) : Type
| pending(Lst(Waker))
| ready(A)
end

pub let Future(A : Type) -> Type =
    Cell(Fut(A));

pub let new_future(@A : Type) -> Future(A) =
    Cell/new(Fut/pending(@A, Lst/nil(@Waker)));

let wake_all(ws : Lst(Waker)) -> {} =
    Lst/each(ws, (w) => w());

pub let fulfill(@A : Type, f : Future(A), a : A) -> {} =
    match Cell/get(f) : {}
    | ready(_) => ()
    | pending(ws) =>
        let _ = Cell/set(f, Fut/ready(@A, a));
        wake_all(ws)
    end;

pub rec await(@A : Type, f : Future(A)) -> Task(A) =
    match Cell/get(f) : Task(A)
    | ready(a) => pure(a)
    | pending(ws) =>
        bind(park((w) => Cell/set(f, Fut/pending(@A, Lst/cons(w, ws)))), (_) => await(f))
    end;

record Job : Type {
    resume : Fiber,
    token : Token,
    fins : Lst(Guard)
}

let Slot : Type =
    Cell(Option(Job));

record Parked : Type {
    handle : Io,
    interest : Nat,
    resume : Fiber,
    token : Token,
    fins : Lst(Guard)
}

let run_fins(gs : Lst(Guard)) -> {} =
    Lst/each(gs, (g) => g.1());

let release_guard(h : Io, gs : Lst(Guard)) -> Lst(Guard) =
    rec each(rest : Lst(Guard)) -> Lst(Guard) =
        match rest : Lst(Guard)
        | nil() => Lst/nil(@Guard)
        | cons(g, more) =>
            match /sys/Io/eql(g.0, h) : Lst(Guard)
            | true => let _ = g.1(); more
            | false => Lst/cons(g, each(more))
            end
        end;
    each(gs);

let drain_jobs(js : Lst(Job)) -> {} =
    Lst/each(js, (j) => run_fins(j.fins));

let drain_parked(ps : Lst(Parked)) -> {} =
    Lst/each(ps, (p) => run_fins(p.fins));

let drain_slots(ss : Lst(Slot)) -> {} =
    rec each(rest : Lst(Slot)) -> {} =
        match rest : {}
        | nil() => ()
        | cons(s, more) =>
            match Cell/get(s) : {}
            | none() => each(more)
            | some(j) => let _ = run_fins(j.fins); each(more)
            end
        end;
    each(ss);

let sweep_parked(ss : Lst(Slot)) -> Lst(Slot) =
    rec each(rest : Lst(Slot)) -> Lst(Slot) =
        match rest : Lst(Slot)
        | nil() => Lst/nil(@Slot)
        | cons(s, more) =>
            match Cell/get(s) : Lst(Slot)
            | none() => each(more)
            | some(j) =>
                match Cell/get(j.token) : Lst(Slot)
                | true => let _ = run_fins(j.fins); let _ = Cell/set(s, Option/none(@Job)); each(more)
                | false => Lst/cons(s, each(more))
                end
            end
        end;
    each(ss);

let is_ready(results : Nat, interest : Nat) -> Bln =
    Nat/and(results, Nat/or(Nat/or(interest, /sys/Io/Poll/err), /sys/Io/Poll/hup)) > 0;

let poll_ready(blocked : Lst(Parked)) -> {Lst(Job), Lst(Parked)} =
    let handles = Lst/to_arr(Lst/map((p) => p.handle, blocked));
    let events = Lst/to_arr(Lst/map((p) => p.interest, blocked));
    let results = /sys/Io/poll(handles, events, -1);
    rec walk(rest : Lst(Parked), i : Nat, woken : Lst(Job), still : Lst(Parked)) -> {Lst(Job), Lst(Parked)} =
        match rest : {Lst(Job), Lst(Parked)}
        | nil() => (woken, still)
        | cons(p, tail) =>
            match Cell/get(p.token) : {Lst(Job), Lst(Parked)}
            | true => let _ = run_fins(p.fins); walk(tail, i + 1, woken, still)
            | false =>
                match is_ready(/sys/Arr/get(results, i), p.interest) : {Lst(Job), Lst(Parked)}
                | true => walk(tail, i + 1, Lst/cons(Job { resume = p.resume, token = p.token, fins = p.fins }, woken), still)
                | false => walk(tail, i + 1, woken, Lst/cons(p, still))
                end
            end
        end;
    walk(blocked, 0, Lst/nil(@Job), Lst/nil(@Parked));

pub let block_on(@A : Type, root : Task(A)) -> A =
    let runq : Cell(Lst(Job)) = Cell/new(Lst/nil(@Job));
    let blocked : Cell(Lst(Parked)) = Cell/new(Lst/nil(@Parked));
    let parked : Cell(Lst(Slot)) = Cell/new(Lst/nil(@Slot));
    let result : Cell(Option(A)) = Cell/new(Option/none(@A));
    let enqueue = (j : Job) =>
        Cell/set(runq, Lst/cons(j, Cell/get(runq)));
    let _ = enqueue(Job {
        resume = () => bind(root, (a) => let _ = Cell/set(result, Option/some(@A, a)); pure(())),
        token = Cell/new(false),
        fins = Lst/nil(@Guard)
    });
    rec serve(job : Job) -> {} =
        match Cell/get(job.token) : {}
        | true => run_fins(job.fins)
        | false =>
            match job.resume() : {}
            | done(_) => run_fins(job.fins)
            | step(p, k) =>
                match p : {}
                | wait(h, ev) =>
                    Cell/set(blocked, Lst/cons(Parked { handle = h, interest = ev, resume = k, token = job.token, fins = job.fins }, Cell/get(blocked)))
                | fork(child, ct) =>
                    let _ = enqueue(Job { resume = k, token = job.token, fins = job.fins });
                    enqueue(Job { resume = child, token = ct, fins = Lst/nil(@Guard) })
                | park(reg) =>
                    let slot : Slot = Cell/new(Option/some(@Job, Job { resume = k, token = job.token, fins = job.fins }));
                    let _ = Cell/set(parked, Lst/cons(slot, Cell/get(parked)));
                    let wake = () =>
                        match Cell/get(slot) : {}
                        | none() => ()
                        | some(j) => let _ = Cell/set(slot, Option/none(@Job)); enqueue(j)
                        end;
                    reg(wake)
                | acquire(h, fin) =>
                    serve(Job { resume = k, token = job.token, fins = Lst/cons((h, fin), job.fins) })
                | release(h) =>
                    serve(Job { resume = k, token = job.token, fins = release_guard(h, job.fins) })
                | defer() =>
                    serve(Job { resume = k, token = job.token, fins = job.fins })
                end
            end
        end;
    let drain_all = () =>
        let _ = drain_jobs(Cell/get(runq));
        let _ = drain_parked(Cell/get(blocked));
        drain_slots(Cell/get(parked));
    rec drive() -> A =
        match Cell/get(result) : A
        | some(a) =>
            let _ = drain_all();
            a
        | none() =>
            match Cell/get(runq) : A
            | cons(job, rest) =>
                let _ = Cell/set(runq, rest);
                let _ = serve(job);
                drive()
            | nil() =>
                let _ = Cell/set(parked, sweep_parked(Cell/get(parked)));
                match Cell/get(blocked) : A
                | cons(_, _) =>
                    let split = poll_ready(Cell/get(blocked));
                    let _ = Cell/set(runq, split.0);
                    let _ = Cell/set(blocked, split.1);
                    drive()
                | nil() =>
                    let _ = drain_all();
                    /sys/Io/exit(@A, 1)
                end
            end
        end;
    drive();

pub let run(main : Task({})) -> {} =
    let _ = block_on(main);
    ();

pub let Handle(A : Type) -> Type =
    {result : Future(A), token : Token};

pub let spawn(@A : Type, body : () -> Task(A)) -> Task(Handle(A)) =
    defer(() =>
        let f = new_future(@A);
        let t : Token = Cell/new(false);
        bind(fork_with(() => bind(body(), (a) => let _ = fulfill(f, a); pure(())), t), (_) => pure((f, t))));

pub let cancel(t : Token) -> {} =
    Cell/set(t, true);

let cancel_all(ts : Lst(Token)) -> {} =
    Lst/each(ts, cancel);

pub let join_all(@A : Type, tasks : Lst(() -> Task(A))) -> Task(Arr(A)) =
    let ta = Lst/to_arr(tasks);
    rec go(i : Nat) -> Task(Lst(A)) =
        let ! = bind;
        match Nat/try_lt(i, Arr/len(ta)) : Task(Lst(A))
        | none() => pure(Lst/nil(@A))
        | some(ok) =>
            let h = spawn(Arr/at(ta, i, ok))!;
            let rest = go(i + 1)!;
            let a = await(h.result)!;
            pure(Lst/cons(a, rest))
        end;
    bind(go(0), (xs) => pure(Lst/to_arr(xs)));

pub let select(@A : Type, tasks : Lst(() -> Task(A))) -> Task({Nat, A}) =
    defer(() =>
        let ta = Lst/to_arr(tasks);
        let winner : Future({Nat, A}) = new_future(@{Nat, A});
        rec arm(i : Nat) -> Task(Lst(Token)) =
            let ! = bind;
            match Nat/try_lt(i, Arr/len(ta)) : Task(Lst(Token))
            | none() => pure(Lst/nil(@Token))
            | some(ok) =>
                let t : Token = Cell/new(false);
                let _ = fork_with(() => bind((Arr/at(ta, i, ok))(), (a) => let _ = fulfill(winner, (i, a)); pure(())), t)!;
                let rest = arm(i + 1)!;
                pure(Lst/cons(t, rest))
            end;
        let ! = bind;
        let tokens = arm(0)!;
        let w = await(winner)!;
        let _ = cancel_all(tokens);
        pure(w));

pub let race(@A : Type, tasks : Lst(() -> Task(A))) -> Task(A) =
    bind(select(tasks), (w) => pure(w.1));

pub witness monad_task : Monad(Task) {
    pure(A, x) = pure(@A, x),
    bind(A, B, m, f) = bind(@A, @B)(m, f)
}
