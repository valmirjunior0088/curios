use /std/{Nat, Int, Bln, Str, Order, Eq, False, True, BigNat};
use /std/BigNat/{Pos, pos_succ, pos_add, pos_cmp, pos_mul, pos_pred_dbl};
use /std/BigNat/{pos_add_comm, pos_add_assoc, pos_mul_comm, pos_mul_assoc, pos_distrib_l};
use /std/BigNat/{pos_cmp_refl, pos_cmp_eq, pos_cmp_flip, pos_cmp_trans, pos_cmp_gt_to_lt};
use /std/BigNat/{pos_lt_witness, pos_mul_cancel_l};
use /std/Order/{lt_neq_eq, gt_neq_eq, eq_neq_lt, gt_neq_lt};

pub induct BigInt : Type
| neg(Pos)
| zero()
| pos(Pos)
end

pub let zero : BigInt =
    BigInt/zero();

pub let is_zero(a : BigInt) -> Bln =
    match a
    | neg(_) => false
    | zero() => true
    | pos(_) => false
    end;

let dbl(z : BigInt) -> BigInt =
    match z
    | neg(p) => BigInt/neg(Pos/o(p))
    | zero() => BigInt/zero()
    | pos(p) => BigInt/pos(Pos/o(p))
    end;

let dbl_succ(z : BigInt) -> BigInt =
    match z
    | neg(p) => BigInt/neg(pos_pred_dbl(p))
    | zero() => BigInt/pos(Pos/one())
    | pos(p) => BigInt/pos(Pos/i(p))
    end;

let dbl_pred(z : BigInt) -> BigInt =
    match z
    | neg(p) => BigInt/neg(Pos/i(p))
    | zero() => BigInt/neg(Pos/one())
    | pos(p) => BigInt/pos(pos_pred_dbl(p))
    end;

pub rec pos_sub(x : Pos, y : Pos) -> BigInt =
    match (x, y)
    | (one(), one()) => BigInt/zero()
    | (one(), o(yt)) => BigInt/neg(pos_pred_dbl(yt))
    | (one(), i(yt)) => BigInt/neg(Pos/o(yt))
    | (o(xt), one()) => BigInt/pos(pos_pred_dbl(xt))
    | (o(xt), o(yt)) => dbl(pos_sub(xt, yt))
    | (o(xt), i(yt)) => dbl_pred(pos_sub(xt, yt))
    | (i(xt), one()) => BigInt/pos(Pos/o(xt))
    | (i(xt), o(yt)) => dbl_succ(pos_sub(xt, yt))
    | (i(xt), i(yt)) => dbl(pos_sub(xt, yt))
    end;

pub let add(a : BigInt, b : BigInt) -> BigInt =
    match (a, b)
    | (neg(p), neg(q)) => BigInt/neg(pos_add(p, q))
    | (neg(p), zero()) => BigInt/neg(p)
    | (neg(p), pos(q)) => pos_sub(q, p)
    | (zero(), y) => y
    | (pos(p), neg(q)) => pos_sub(p, q)
    | (pos(p), zero()) => BigInt/pos(p)
    | (pos(p), pos(q)) => BigInt/pos(pos_add(p, q))
    end;

pub let neg(a : BigInt) -> BigInt =
    match a
    | neg(p) => BigInt/pos(p)
    | zero() => BigInt/zero()
    | pos(p) => BigInt/neg(p)
    end;

pub let sub(a : BigInt, b : BigInt) -> BigInt =
    add(a, neg(b));

pub let abs(a : BigInt) -> BigInt =
    match a
    | neg(p) => BigInt/pos(p)
    | zero() => BigInt/zero()
    | pos(p) => BigInt/pos(p)
    end;

pub let magnitude(a : BigInt) -> BigNat =
    match a
    | neg(p) => BigNat/pos(p)
    | zero() => BigNat/zero
    | pos(p) => BigNat/pos(p)
    end;

pub let mul(a : BigInt, b : BigInt) -> BigInt =
    match (a, b)
    | (neg(p), neg(q)) => BigInt/pos(pos_mul(p, q))
    | (neg(_), zero()) => BigInt/zero()
    | (neg(p), pos(q)) => BigInt/neg(pos_mul(p, q))
    | (zero(), _) => BigInt/zero()
    | (pos(p), neg(q)) => BigInt/neg(pos_mul(p, q))
    | (pos(_), zero()) => BigInt/zero()
    | (pos(p), pos(q)) => BigInt/pos(pos_mul(p, q))
    end;

pub let cmp(a : BigInt, b : BigInt) -> Order =
    match (a, b)
    | (neg(p), neg(q)) => pos_cmp(q, p)
    | (neg(_), zero()) => Order/lt()
    | (neg(_), pos(_)) => Order/lt()
    | (zero(), neg(_)) => Order/gt()
    | (zero(), zero()) => Order/eq()
    | (zero(), pos(_)) => Order/lt()
    | (pos(_), neg(_)) => Order/gt()
    | (pos(_), zero()) => Order/gt()
    | (pos(p), pos(q)) => pos_cmp(p, q)
    end;

pub let eql(a : BigInt, b : BigInt) -> Bln =
    match cmp(a, b)
    | eq() => true
    | _ => false
    end;

pub let lt(a : BigInt, b : BigInt) -> Bln =
    match cmp(a, b)
    | lt() => true
    | _ => false
    end;

pub let lte(a : BigInt, b : BigInt) -> Bln =
    match cmp(a, b)
    | gt() => false
    | _ => true
    end;

pub let gt(a : BigInt, b : BigInt) -> Bln =
    match cmp(a, b)
    | gt() => true
    | _ => false
    end;

pub let gte(a : BigInt, b : BigInt) -> Bln =
    match cmp(a, b)
    | lt() => false
    | _ => true
    end;

pub let of_big_nat(a : BigNat) -> BigInt =
    match a
    | zero() => BigInt/zero()
    | pos(p) => BigInt/pos(p)
    end;

pub let of_nat(n : Nat) -> BigInt =
    of_big_nat(BigNat/of_nat(n));

pub let of_int(n : Int) -> BigInt =
    let mag = of_big_nat(BigNat/of_nat(Int/abs(n)));
    match n < +0
    | true => neg(mag)
    | false => mag
    end;

pub let is_even(a : BigInt) -> Bln =
    BigNat/is_even(magnitude(a));

pub let div2(a : BigInt) -> BigInt =
    match a
    | neg(p) => neg(of_big_nat(BigNat/div2(BigNat/pos(p))))
    | zero() => BigInt/zero()
    | pos(p) => of_big_nat(BigNat/div2(BigNat/pos(p)))
    end;

pub let to_str(a : BigInt) -> Str =
    match a
    | neg(p) => Str/concat("-", BigNat/to_str(BigNat/pos(p)))
    | zero() => "+0"
    | pos(p) => Str/concat("+", BigNat/to_str(BigNat/pos(p)))
    end;

let qed(@A : Type, x : A) -> Eq(x, x) =
    Eq/refl();

let cong_posz(@s : Pos, @t : Pos, p : Eq(s, t)) -> Eq(BigInt/pos(s), BigInt/pos(t)) =
    match p : (q : Eq(Pos, a, b)) => Eq(BigInt/pos(a), BigInt/pos(b))
    | refl(z) => Eq/refl()
    end;

let cong_negz(@s : Pos, @t : Pos, p : Eq(s, t)) -> Eq(BigInt/neg(s), BigInt/neg(t)) =
    match p : (q : Eq(Pos, a, b)) => Eq(BigInt/neg(a), BigInt/neg(b))
    | refl(z) => Eq/refl()
    end;

let cong_dbl(@s : BigInt, @t : BigInt, p : Eq(s, t)) -> Eq(dbl(s), dbl(t)) =
    match p : (q : Eq(BigInt, a, b)) => Eq(dbl(a), dbl(b))
    | refl(z) => Eq/refl()
    end;

let cong_dbl_succ(@s : BigInt, @t : BigInt, p : Eq(s, t)) -> Eq(dbl_succ(s), dbl_succ(t)) =
    match p : (q : Eq(BigInt, a, b)) => Eq(dbl_succ(a), dbl_succ(b))
    | refl(z) => Eq/refl()
    end;

let cong_dbl_pred(@s : BigInt, @t : BigInt, p : Eq(s, t)) -> Eq(dbl_pred(s), dbl_pred(t)) =
    match p : (q : Eq(BigInt, a, b)) => Eq(dbl_pred(a), dbl_pred(b))
    | refl(z) => Eq/refl()
    end;

let cong_neg(@s : BigInt, @t : BigInt, p : Eq(s, t)) -> Eq(neg(s), neg(t)) =
    match p : (q : Eq(BigInt, a, b)) => Eq(neg(a), neg(b))
    | refl(z) => Eq/refl()
    end;

let cong_add_l(w : BigInt, @s : BigInt, @t : BigInt, p : Eq(s, t)) -> Eq(add(w, s), add(w, t)) =
    match p : (q : Eq(BigInt, a, b)) => Eq(add(w, a), add(w, b))
    | refl(z) => Eq/refl()
    end;

let cong_add_r(w : BigInt, @s : BigInt, @t : BigInt, p : Eq(s, t)) -> Eq(add(s, w), add(t, w)) =
    match p : (q : Eq(BigInt, a, b)) => Eq(add(a, w), add(b, w))
    | refl(z) => Eq/refl()
    end;

let cong_mul_l(w : BigInt, @s : BigInt, @t : BigInt, p : Eq(s, t)) -> Eq(mul(w, s), mul(w, t)) =
    match p : (q : Eq(BigInt, a, b)) => Eq(mul(w, a), mul(w, b))
    | refl(z) => Eq/refl()
    end;

let cong_psub_l(w : Pos, @s : Pos, @t : Pos, p : Eq(s, t)) -> Eq(pos_sub(w, s), pos_sub(w, t)) =
    match p : (q : Eq(Pos, a, b)) => Eq(pos_sub(w, a), pos_sub(w, b))
    | refl(z) => Eq/refl()
    end;

let cong_psub_r(w : Pos, @s : Pos, @t : Pos, p : Eq(s, t)) -> Eq(pos_sub(s, w), pos_sub(t, w)) =
    match p : (q : Eq(Pos, a, b)) => Eq(pos_sub(a, w), pos_sub(b, w))
    | refl(z) => Eq/refl()
    end;

let cong_padd_l(w : Pos, @s : Pos, @t : Pos, p : Eq(s, t)) -> Eq(pos_add(w, s), pos_add(w, t)) =
    match p : (q : Eq(Pos, a, b)) => Eq(pos_add(w, a), pos_add(w, b))
    | refl(z) => Eq/refl()
    end;

let cong_padd_r(w : Pos, @s : Pos, @t : Pos, p : Eq(s, t)) -> Eq(pos_add(s, w), pos_add(t, w)) =
    match p : (q : Eq(Pos, a, b)) => Eq(pos_add(a, w), pos_add(b, w))
    | refl(z) => Eq/refl()
    end;

let cong_pmul_l(w : Pos, @s : Pos, @t : Pos, p : Eq(s, t)) -> Eq(pos_mul(w, s), pos_mul(w, t)) =
    match p : (q : Eq(Pos, a, b)) => Eq(pos_mul(w, a), pos_mul(w, b))
    | refl(z) => Eq/refl()
    end;

let neg_dbl(z : BigInt) -> Eq(neg(dbl(z)), dbl(neg(z))) =
    match z : (a) => Eq(@BigInt, neg(dbl(a)), dbl(neg(a)))
    | neg(p) => qed(BigInt/pos(Pos/o(p)))
    | zero() => qed(BigInt/zero())
    | pos(p) => qed(BigInt/neg(Pos/o(p)))
    end;

let neg_dbl_succ(z : BigInt) -> Eq(neg(dbl_succ(z)), dbl_pred(neg(z))) =
    match z : (a) => Eq(@BigInt, neg(dbl_succ(a)), dbl_pred(neg(a)))
    | neg(p) => qed(BigInt/pos(pos_pred_dbl(p)))
    | zero() => qed(BigInt/neg(Pos/one()))
    | pos(p) => qed(BigInt/neg(Pos/i(p)))
    end;

let neg_dbl_pred(z : BigInt) -> Eq(neg(dbl_pred(z)), dbl_succ(neg(z))) =
    match z : (a) => Eq(@BigInt, neg(dbl_pred(a)), dbl_succ(neg(a)))
    | neg(p) => qed(BigInt/pos(Pos/i(p)))
    | zero() => qed(BigInt/pos(Pos/one()))
    | pos(p) => qed(BigInt/neg(pos_pred_dbl(p)))
    end;

rec pos_sub_flip(x : Pos, y : Pos) -> Eq(pos_sub(y, x), neg(pos_sub(x, y))) =
    match x : (a) => Eq(@BigInt, pos_sub(y, a), neg(pos_sub(a, y)))
    | one() =>
        match y : (b) => Eq(@BigInt, pos_sub(b, Pos/one()), neg(pos_sub(Pos/one(), b)))
        | one() => qed(BigInt/zero())
        | o(yt) => qed(BigInt/pos(pos_pred_dbl(yt)))
        | i(yt) => qed(BigInt/pos(Pos/o(yt)))
        end
    | o(xt) =>
        match y : (b) => Eq(@BigInt, pos_sub(b, Pos/o(xt)), neg(pos_sub(Pos/o(xt), b)))
        | one() => qed(BigInt/neg(pos_pred_dbl(xt)))
        | o(yt) =>
            Eq/trans(cong_dbl(pos_sub_flip(xt, yt)),
                Eq/sym(neg_dbl(pos_sub(xt, yt))))
        | i(yt) =>
            Eq/trans(cong_dbl_succ(pos_sub_flip(xt, yt)),
                Eq/sym(neg_dbl_pred(pos_sub(xt, yt))))
        end
    | i(xt) =>
        match y : (b) => Eq(@BigInt, pos_sub(b, Pos/i(xt)), neg(pos_sub(Pos/i(xt), b)))
        | one() => qed(BigInt/neg(Pos/o(xt)))
        | o(yt) =>
            Eq/trans(cong_dbl_pred(pos_sub_flip(xt, yt)),
                Eq/sym(neg_dbl_succ(pos_sub(xt, yt))))
        | i(yt) =>
            Eq/trans(cong_dbl(pos_sub_flip(xt, yt)),
                Eq/sym(neg_dbl(pos_sub(xt, yt))))
        end
    end;

rec pos_sub_diag(x : Pos) -> Eq(pos_sub(x, x), BigInt/zero()) =
    match x : (a) => Eq(@BigInt, pos_sub(a, a), BigInt/zero())
    | one() => qed(BigInt/zero())
    | o(t) => cong_dbl(pos_sub_diag(t))
    | i(t) => cong_dbl(pos_sub_diag(t))
    end;

rec pos_sub_succ(t : Pos) -> Eq(pos_sub(pos_succ(t), t), BigInt/pos(Pos/one())) =
    match t : (a) => Eq(@BigInt, pos_sub(pos_succ(a), a), BigInt/pos(Pos/one()))
    | one() => qed(BigInt/pos(Pos/one()))
    | o(u) => cong_dbl_succ(pos_sub_diag(u))
    | i(u) => cong_dbl_pred(pos_sub_succ(u))
    end;

rec pos_sub_add_l(x : Pos, d : Pos) -> Eq(pos_sub(pos_add(x, d), x), BigInt/pos(d)) =
    match x : (a) => Eq(@BigInt, pos_sub(pos_add(a, d), a), BigInt/pos(d))
    | one() =>
        match d : (c) => Eq(@BigInt, pos_sub(pos_add(Pos/one(), c), Pos/one()), BigInt/pos(c))
        | one() => qed(BigInt/pos(Pos/one()))
        | o(dt) => qed(BigInt/pos(Pos/o(dt)))
        | i(dt) => cong_posz(BigNat/pos_pred_dbl_succ(dt))
        end
    | o(xt) =>
        match d : (c) => Eq(@BigInt, pos_sub(pos_add(Pos/o(xt), c), Pos/o(xt)), BigInt/pos(c))
        | one() => cong_dbl_succ(pos_sub_diag(xt))
        | o(dt) => cong_dbl(pos_sub_add_l(xt, dt))
        | i(dt) => cong_dbl_succ(pos_sub_add_l(xt, dt))
        end
    | i(xt) =>
        match d : (c) => Eq(@BigInt, pos_sub(pos_add(Pos/i(xt), c), Pos/i(xt)), BigInt/pos(c))
        | one() => cong_dbl_pred(pos_sub_succ(xt))
        | o(dt) => cong_dbl(pos_sub_add_l(xt, dt))
        | i(dt) =>
            let step : Eq(pos_sub(BigNat/pos_add_carry(xt, dt), xt), BigInt/pos(pos_succ(dt))) =
                Eq/trans(
                    cong_psub_r(xt, BigNat/pos_add_carry_spec(xt, dt)),
                    pos_sub_succ_add(xt, dt));
            Eq/trans(@BigInt,
                @(dbl_pred(pos_sub(BigNat/pos_add_carry(xt, dt), xt))),
                @(BigInt/pos(pos_pred_dbl(pos_succ(dt)))),
                @(BigInt/pos(Pos/i(dt))),
                cong_dbl_pred(step),
                cong_posz(BigNat/pos_pred_dbl_succ(dt)))
        end
    end
and pos_sub_succ_add(x : Pos, d : Pos)
    -> Eq(pos_sub(pos_succ(pos_add(x, d)), x), BigInt/pos(pos_succ(d))) =
    match x : (a) => Eq(@BigInt, pos_sub(pos_succ(pos_add(a, d)), a), BigInt/pos(pos_succ(d)))
    | one() =>
        match d : (c) => Eq(@BigInt,
            pos_sub(pos_succ(pos_add(Pos/one(), c)), Pos/one()), BigInt/pos(pos_succ(c)))
        | one() => qed(BigInt/pos(Pos/o(Pos/one())))
        | o(dt) => cong_posz(BigNat/pos_pred_dbl_succ(dt))
        | i(dt) => qed(BigInt/pos(Pos/o(pos_succ(dt))))
        end
    | o(xt) =>
        match d : (c) => Eq(@BigInt,
            pos_sub(pos_succ(pos_add(Pos/o(xt), c)), Pos/o(xt)), BigInt/pos(pos_succ(c)))
        | one() => cong_dbl(pos_sub_succ(xt))
        | o(dt) => cong_dbl_succ(pos_sub_add_l(xt, dt))
        | i(dt) => cong_dbl(pos_sub_succ_add(xt, dt))
        end
    | i(xt) =>
        match d : (c) => Eq(@BigInt,
            pos_sub(pos_succ(pos_add(Pos/i(xt), c)), Pos/i(xt)), BigInt/pos(pos_succ(c)))
        | one() => cong_dbl(pos_sub_succ(xt))
        | o(dt) =>
            Eq/trans(@BigInt,
                @(dbl_pred(pos_sub(pos_succ(pos_add(xt, dt)), xt))),
                @(BigInt/pos(pos_pred_dbl(pos_succ(dt)))),
                @(BigInt/pos(Pos/i(dt))),
                cong_dbl_pred(pos_sub_succ_add(xt, dt)),
                cong_posz(BigNat/pos_pred_dbl_succ(dt)))
        | i(dt) =>
            cong_dbl(Eq/trans(
                cong_psub_r(xt, BigNat/pos_add_carry_spec(xt, dt)),
                pos_sub_succ_add(xt, dt)))
        end
    end;

let pos_sub_add_r(x : Pos, d : Pos) -> Eq(pos_sub(x, pos_add(x, d)), BigInt/neg(d)) =
    Eq/trans(@BigInt,
        @(pos_sub(x, pos_add(x, d))),
        @(neg(pos_sub(pos_add(x, d), x))),
        @(BigInt/neg(d)),
        pos_sub_flip(pos_add(x, d), x),
        cong_neg(pos_sub_add_l(x, d)));

let pos_sub_of_lt(x : Pos, y : Pos, d : Pos, e : Eq(pos_add(x, d), y))
    -> Eq(pos_sub(x, y), BigInt/neg(d)) =
    Eq/trans(cong_psub_l(x, Eq/sym(e)), pos_sub_add_r(x, d));

let pos_sub_of_gt(x : Pos, y : Pos, d : Pos, e : Eq(pos_add(y, d), x))
    -> Eq(pos_sub(x, y), BigInt/pos(d)) =
    Eq/trans(cong_psub_r(y, Eq/sym(e)), pos_sub_add_l(y, d));

pub let add_zero_r(a : BigInt) -> Eq(add(a, BigInt/zero()), a) =
    match a : (x) => Eq(@BigInt, add(x, BigInt/zero()), x)
    | neg(p) => qed(BigInt/neg(p))
    | zero() => qed(BigInt/zero())
    | pos(p) => qed(BigInt/pos(p))
    end;

pub let add_neg_r(a : BigInt) -> Eq(add(a, neg(a)), BigInt/zero()) =
    match a : (x) => Eq(@BigInt, add(x, neg(x)), BigInt/zero())
    | neg(p) => pos_sub_diag(p)
    | zero() => qed(BigInt/zero())
    | pos(p) => pos_sub_diag(p)
    end;

pub let add_neg_l(a : BigInt) -> Eq(add(neg(a), a), BigInt/zero()) =
    match a : (x) => Eq(@BigInt, add(neg(x), x), BigInt/zero())
    | neg(p) => pos_sub_diag(p)
    | zero() => qed(BigInt/zero())
    | pos(p) => pos_sub_diag(p)
    end;

pub let neg_neg(a : BigInt) -> Eq(neg(neg(a)), a) =
    match a : (x) => Eq(@BigInt, neg(neg(x)), x)
    | neg(p) => qed(BigInt/neg(p))
    | zero() => qed(BigInt/zero())
    | pos(p) => qed(BigInt/pos(p))
    end;

pub let add_comm(a : BigInt, b : BigInt) -> Eq(add(a, b), add(b, a)) =
    match a : (x) => Eq(@BigInt, add(x, b), add(b, x))
    | neg(p) =>
        match b : (y) => Eq(@BigInt, add(BigInt/neg(p), y), add(y, BigInt/neg(p)))
        | neg(q) => cong_negz(pos_add_comm(p, q))
        | zero() => qed(BigInt/neg(p))
        | pos(q) => qed(pos_sub(q, p))
        end
    | zero() =>
        match b : (y) => Eq(@BigInt, add(BigInt/zero(), y), add(y, BigInt/zero()))
        | neg(q) => qed(BigInt/neg(q))
        | zero() => qed(BigInt/zero())
        | pos(q) => qed(BigInt/pos(q))
        end
    | pos(p) =>
        match b : (y) => Eq(@BigInt, add(BigInt/pos(p), y), add(y, BigInt/pos(p)))
        | neg(q) => qed(pos_sub(p, q))
        | zero() => qed(BigInt/pos(p))
        | pos(q) => cong_posz(pos_add_comm(p, q))
        end
    end;

pub let neg_add(a : BigInt, b : BigInt) -> Eq(neg(add(a, b)), add(neg(a), neg(b))) =
    match a : (x) => Eq(@BigInt, neg(add(x, b)), add(neg(x), neg(b)))
    | neg(p) =>
        match b : (y) => Eq(@BigInt, neg(add(BigInt/neg(p), y)), add(neg(BigInt/neg(p)), neg(y)))
        | neg(q) => qed(BigInt/pos(pos_add(p, q)))
        | zero() => qed(BigInt/pos(p))
        | pos(q) => Eq/trans(cong_neg(pos_sub_flip(p, q)), neg_neg(pos_sub(p, q)))
        end
    | zero() => qed(neg(b))
    | pos(p) =>
        match b : (y) => Eq(@BigInt, neg(add(BigInt/pos(p), y)), add(neg(BigInt/pos(p)), neg(y)))
        | neg(q) => Eq/sym(pos_sub_flip(p, q))
        | zero() => qed(BigInt/neg(p))
        | pos(q) => qed(BigInt/neg(pos_add(p, q)))
        end
    end;

let pos_add_perm(x : Pos, d : Pos, c : Pos)
    -> Eq(pos_add(pos_add(x, d), c), pos_add(pos_add(x, c), d)) =
    let s1 : Eq(pos_add(pos_add(x, d), c), pos_add(x, pos_add(d, c))) =
        pos_add_assoc(x, d, c);
    let s2 : Eq(pos_add(x, pos_add(d, c)), pos_add(x, pos_add(c, d))) =
        cong_padd_l(x, pos_add_comm(d, c));
    let s3 : Eq(pos_add(x, pos_add(c, d)), pos_add(pos_add(x, c), d)) =
        Eq/sym(pos_add_assoc(x, c, d));
    let t1 : Eq(pos_add(pos_add(x, d), c), pos_add(x, pos_add(c, d))) =
        Eq/trans(s1, s2);
    Eq/trans(t1, s3);

let pos_sub_cancel(x : Pos, y : Pos, c : Pos)
    -> Eq(pos_sub(pos_add(x, c), pos_add(y, c)), pos_sub(x, y)) =
    (match pos_cmp(x, y) : (r) => (w : Eq(pos_cmp(x, y), r))
        -> Eq(@BigInt, pos_sub(pos_add(x, c), pos_add(y, c)), pos_sub(x, y))
     | eq() => (w) =>
         let e : Eq(x, y) = pos_cmp_eq(x, y, w);
         let l1 : Eq(pos_sub(pos_add(x, c), pos_add(y, c)),
                     pos_sub(pos_add(x, c), pos_add(x, c))) =
             cong_psub_l(pos_add(x, c), cong_padd_r(c, Eq/sym(e)));
         let l2 : Eq(pos_sub(pos_add(x, c), pos_add(y, c)), BigInt/zero()) =
             Eq/trans(l1, pos_sub_diag(pos_add(x, c)));
         let r1 : Eq(pos_sub(x, y), BigInt/zero()) =
             Eq/trans(cong_psub_l(x, Eq/sym(e)), pos_sub_diag(x));
         Eq/trans(l2, Eq/sym(r1))
     | lt() => (w) =>
         let (d, e) = pos_lt_witness(x, y, w);
         let l1 : Eq(pos_sub(pos_add(x, c), pos_add(y, c)),
                     pos_sub(pos_add(x, c), pos_add(pos_add(x, d), c))) =
             cong_psub_l(pos_add(x, c), cong_padd_r(c, Eq/sym(e)));
         let l2 : Eq(pos_sub(pos_add(x, c), pos_add(pos_add(x, d), c)),
                     pos_sub(pos_add(x, c), pos_add(pos_add(x, c), d))) =
             cong_psub_l(pos_add(x, c), pos_add_perm(x, d, c));
         let l3 : Eq(pos_sub(pos_add(x, c), pos_add(pos_add(x, c), d)), BigInt/neg(d)) =
             pos_sub_add_r(pos_add(x, c), d);
         let t1 : Eq(pos_sub(pos_add(x, c), pos_add(y, c)),
                     pos_sub(pos_add(x, c), pos_add(pos_add(x, c), d))) =
             Eq/trans(l1, l2);
         let t2 : Eq(pos_sub(pos_add(x, c), pos_add(y, c)), BigInt/neg(d)) =
             Eq/trans(t1, l3);
         Eq/trans(t2, Eq/sym(pos_sub_of_lt(x, y, d, e)))
     | gt() => (w) =>
         let (d, e) = pos_lt_witness(y, x, pos_cmp_gt_to_lt(x, y, w));
         let l1 : Eq(pos_sub(pos_add(x, c), pos_add(y, c)),
                     pos_sub(pos_add(pos_add(y, d), c), pos_add(y, c))) =
             cong_psub_r(pos_add(y, c), cong_padd_r(c, Eq/sym(e)));
         let l2 : Eq(pos_sub(pos_add(pos_add(y, d), c), pos_add(y, c)),
                     pos_sub(pos_add(pos_add(y, c), d), pos_add(y, c))) =
             cong_psub_r(pos_add(y, c), pos_add_perm(y, d, c));
         let l3 : Eq(pos_sub(pos_add(pos_add(y, c), d), pos_add(y, c)), BigInt/pos(d)) =
             pos_sub_add_l(pos_add(y, c), d);
         let t1 : Eq(pos_sub(pos_add(x, c), pos_add(y, c)),
                     pos_sub(pos_add(pos_add(y, c), d), pos_add(y, c))) =
             Eq/trans(l1, l2);
         let t2 : Eq(pos_sub(pos_add(x, c), pos_add(y, c)), BigInt/pos(d)) =
             Eq/trans(t1, l3);
         Eq/trans(t2, Eq/sym(pos_sub_of_gt(x, y, d, e)))
     end)(qed(pos_cmp(x, y)));

let pos_sub_add(p : Pos, q : Pos, r : Pos)
    -> Eq(pos_sub(pos_add(p, q), r), add(BigInt/pos(p), pos_sub(q, r))) =
    (match pos_cmp(q, r) : (s) => (w : Eq(pos_cmp(q, r), s))
        -> Eq(@BigInt, pos_sub(pos_add(p, q), r), add(BigInt/pos(p), pos_sub(q, r)))
     | eq() => (w) =>
         let e : Eq(q, r) = pos_cmp_eq(q, r, w);
         let l1 : Eq(pos_sub(pos_add(p, q), r), pos_sub(pos_add(p, q), q)) =
             cong_psub_l(pos_add(p, q), Eq/sym(e));
         let l2 : Eq(pos_sub(pos_add(p, q), q), pos_sub(pos_add(q, p), q)) =
             cong_psub_r(q, pos_add_comm(p, q));
         let l3 : Eq(pos_sub(pos_add(q, p), q), BigInt/pos(p)) =
             pos_sub_add_l(q, p);
         let rq : Eq(pos_sub(q, r), BigInt/zero()) =
             Eq/trans(cong_psub_l(q, Eq/sym(e)), pos_sub_diag(q));
         let r1 : Eq(add(BigInt/pos(p), pos_sub(q, r)), BigInt/pos(p)) =
             cong_add_l(BigInt/pos(p), rq);
         let t1 : Eq(pos_sub(pos_add(p, q), r), pos_sub(pos_add(q, p), q)) =
             Eq/trans(l1, l2);
         let t2 : Eq(pos_sub(pos_add(p, q), r), BigInt/pos(p)) =
             Eq/trans(t1, l3);
         let r1s : Eq(BigInt/pos(p), add(BigInt/pos(p), pos_sub(q, r))) =
             Eq/sym(@BigInt, @(add(BigInt/pos(p), pos_sub(q, r))), @(BigInt/pos(p)), r1);
         Eq/trans(@BigInt,
             @(pos_sub(pos_add(p, q), r)),
             @(BigInt/pos(p)),
             @(add(BigInt/pos(p), pos_sub(q, r))),
             t2, r1s)
     | lt() => (w) =>
         let (d, e) = pos_lt_witness(q, r, w);
         let l1 : Eq(pos_sub(pos_add(p, q), r), pos_sub(pos_add(p, q), pos_add(q, d))) =
             cong_psub_l(pos_add(p, q), Eq/sym(e));
         let l2 : Eq(pos_sub(pos_add(p, q), pos_add(q, d)),
                     pos_sub(pos_add(p, q), pos_add(d, q))) =
             cong_psub_l(pos_add(p, q), pos_add_comm(q, d));
         let l3 : Eq(pos_sub(pos_add(p, q), pos_add(d, q)), pos_sub(p, d)) =
             pos_sub_cancel(p, d, q);
         let r1 : Eq(add(BigInt/pos(p), pos_sub(q, r)), pos_sub(p, d)) =
             cong_add_l(BigInt/pos(p), pos_sub_of_lt(q, r, d, e));
         let t1 : Eq(pos_sub(pos_add(p, q), r), pos_sub(pos_add(p, q), pos_add(d, q))) =
             Eq/trans(l1, l2);
         let t2 : Eq(pos_sub(pos_add(p, q), r), pos_sub(p, d)) =
             Eq/trans(t1, l3);
         let r1s : Eq(pos_sub(p, d), add(BigInt/pos(p), pos_sub(q, r))) =
             Eq/sym(@BigInt, @(add(BigInt/pos(p), pos_sub(q, r))), @(pos_sub(p, d)), r1);
         Eq/trans(@BigInt,
             @(pos_sub(pos_add(p, q), r)),
             @(pos_sub(p, d)),
             @(add(BigInt/pos(p), pos_sub(q, r))),
             t2, r1s)
     | gt() => (w) =>
         let (d, e) = pos_lt_witness(r, q, pos_cmp_gt_to_lt(q, r, w));
         let l1 : Eq(pos_sub(pos_add(p, q), r), pos_sub(pos_add(p, pos_add(r, d)), r)) =
             cong_psub_r(r, cong_padd_l(p, Eq/sym(e)));
         let l2 : Eq(pos_sub(pos_add(p, pos_add(r, d)), r),
                     pos_sub(pos_add(p, pos_add(d, r)), r)) =
             cong_psub_r(r, cong_padd_l(p, pos_add_comm(r, d)));
         let l3 : Eq(pos_sub(pos_add(p, pos_add(d, r)), r),
                     pos_sub(pos_add(pos_add(p, d), r), r)) =
             cong_psub_r(r, Eq/sym(pos_add_assoc(p, d, r)));
         let l4 : Eq(pos_sub(pos_add(pos_add(p, d), r), r),
                     pos_sub(pos_add(r, pos_add(p, d)), r)) =
             cong_psub_r(r, pos_add_comm(pos_add(p, d), r));
         let l5 : Eq(pos_sub(pos_add(r, pos_add(p, d)), r), BigInt/pos(pos_add(p, d))) =
             pos_sub_add_l(r, pos_add(p, d));
         let r1 : Eq(add(BigInt/pos(p), pos_sub(q, r)), BigInt/pos(pos_add(p, d))) =
             cong_add_l(BigInt/pos(p), pos_sub_of_gt(q, r, d, e));
         let t1 : Eq(pos_sub(pos_add(p, q), r), pos_sub(pos_add(p, pos_add(d, r)), r)) =
             Eq/trans(l1, l2);
         let t2 : Eq(pos_sub(pos_add(p, q), r), pos_sub(pos_add(pos_add(p, d), r), r)) =
             Eq/trans(t1, l3);
         let t3 : Eq(pos_sub(pos_add(p, q), r), pos_sub(pos_add(r, pos_add(p, d)), r)) =
             Eq/trans(t2, l4);
         let t4 : Eq(pos_sub(pos_add(p, q), r), BigInt/pos(pos_add(p, d))) =
             Eq/trans(t3, l5);
         let r1s : Eq(BigInt/pos(pos_add(p, d)), add(BigInt/pos(p), pos_sub(q, r))) =
             Eq/sym(@BigInt, @(add(BigInt/pos(p), pos_sub(q, r))),
                 @(BigInt/pos(pos_add(p, d))), r1);
         Eq/trans(@BigInt,
             @(pos_sub(pos_add(p, q), r)),
             @(BigInt/pos(pos_add(p, d))),
             @(add(BigInt/pos(p), pos_sub(q, r))),
             t4, r1s)
     end)(qed(pos_cmp(q, r)));

let pos_sub_sub(x : Pos, y : Pos, z : Pos)
    -> Eq(pos_sub(x, pos_add(y, z)), add(pos_sub(x, y), BigInt/neg(z))) =
    let s1 : Eq(pos_sub(x, pos_add(y, z)), neg(pos_sub(pos_add(y, z), x))) =
        pos_sub_flip(pos_add(y, z), x);
    let s2a : Eq(pos_sub(pos_add(y, z), x), pos_sub(pos_add(z, y), x)) =
        cong_psub_r(x, pos_add_comm(y, z));
    let s2 : Eq(pos_sub(pos_add(y, z), x), add(BigInt/pos(z), pos_sub(y, x))) =
        Eq/trans(@BigInt,
            @(pos_sub(pos_add(y, z), x)),
            @(pos_sub(pos_add(z, y), x)),
            @(add(BigInt/pos(z), pos_sub(y, x))),
            s2a, pos_sub_add(z, y, x));
    let s3 : Eq(neg(add(BigInt/pos(z), pos_sub(y, x))),
                add(BigInt/neg(z), neg(pos_sub(y, x)))) =
        neg_add(BigInt/pos(z), pos_sub(y, x));
    let s4 : Eq(add(BigInt/neg(z), neg(pos_sub(y, x))), add(BigInt/neg(z), pos_sub(x, y))) =
        cong_add_l(BigInt/neg(z),
            Eq/sym(@BigInt, @(pos_sub(x, y)), @(neg(pos_sub(y, x))), pos_sub_flip(y, x)));
    let s5 : Eq(add(BigInt/neg(z), pos_sub(x, y)), add(pos_sub(x, y), BigInt/neg(z))) =
        add_comm(BigInt/neg(z), pos_sub(x, y));
    let t1 : Eq(pos_sub(x, pos_add(y, z)), neg(add(BigInt/pos(z), pos_sub(y, x)))) =
        Eq/trans(@BigInt,
            @(pos_sub(x, pos_add(y, z))),
            @(neg(pos_sub(pos_add(y, z), x))),
            @(neg(add(BigInt/pos(z), pos_sub(y, x)))),
            s1,
            cong_neg(@(pos_sub(pos_add(y, z), x)), @(add(BigInt/pos(z), pos_sub(y, x))), s2));
    let t2 : Eq(pos_sub(x, pos_add(y, z)), add(BigInt/neg(z), neg(pos_sub(y, x)))) =
        Eq/trans(@BigInt,
            @(pos_sub(x, pos_add(y, z))),
            @(neg(add(BigInt/pos(z), pos_sub(y, x)))),
            @(add(BigInt/neg(z), neg(pos_sub(y, x)))),
            t1, s3);
    let t3 : Eq(pos_sub(x, pos_add(y, z)), add(BigInt/neg(z), pos_sub(x, y))) =
        Eq/trans(@BigInt,
            @(pos_sub(x, pos_add(y, z))),
            @(add(BigInt/neg(z), neg(pos_sub(y, x)))),
            @(add(BigInt/neg(z), pos_sub(x, y))),
            t2, s4);
    Eq/trans(@BigInt,
        @(pos_sub(x, pos_add(y, z))),
        @(add(BigInt/neg(z), pos_sub(x, y))),
        @(add(pos_sub(x, y), BigInt/neg(z))),
        t3, s5);

pub let add_assoc(a : BigInt, b : BigInt, c : BigInt)
    -> Eq(add(add(a, b), c), add(a, add(b, c))) =
    match a : (x) => Eq(@BigInt, add(add(x, b), c), add(x, add(b, c)))
    | neg(p) =>
        match b : (y) => Eq(@BigInt, add(add(BigInt/neg(p), y), c), add(BigInt/neg(p), add(y, c)))
        | neg(q) =>
            match c : (z) => Eq(@BigInt,
                add(add(BigInt/neg(p), BigInt/neg(q)), z),
                add(BigInt/neg(p), add(BigInt/neg(q), z)))
            | neg(r) => cong_negz(pos_add_assoc(p, q, r))
            | zero() => qed(BigInt/neg(pos_add(p, q)))
            | pos(r) =>
                let s1 : Eq(pos_sub(r, pos_add(p, q)), pos_sub(r, pos_add(q, p))) =
                    cong_psub_l(r, pos_add_comm(p, q));
                let s2 : Eq(pos_sub(r, pos_add(q, p)), add(pos_sub(r, q), BigInt/neg(p))) =
                    pos_sub_sub(r, q, p);
                let s3 : Eq(add(pos_sub(r, q), BigInt/neg(p)),
                            add(BigInt/neg(p), pos_sub(r, q))) =
                    add_comm(pos_sub(r, q), BigInt/neg(p));
                let t1 : Eq(pos_sub(r, pos_add(p, q)), add(pos_sub(r, q), BigInt/neg(p))) =
                    Eq/trans(@BigInt,
                        @(pos_sub(r, pos_add(p, q))),
                        @(pos_sub(r, pos_add(q, p))),
                        @(add(pos_sub(r, q), BigInt/neg(p))),
                        s1, s2);
                Eq/trans(@BigInt,
                    @(pos_sub(r, pos_add(p, q))),
                    @(add(pos_sub(r, q), BigInt/neg(p))),
                    @(add(BigInt/neg(p), pos_sub(r, q))),
                    t1, s3)
            end
        | zero() => qed(add(BigInt/neg(p), c))
        | pos(q) =>
            match c : (z) => Eq(@BigInt,
                add(add(BigInt/neg(p), BigInt/pos(q)), z),
                add(BigInt/neg(p), add(BigInt/pos(q), z)))
            | neg(r) =>
                let l1 : Eq(add(pos_sub(q, p), BigInt/neg(r)), pos_sub(q, pos_add(p, r))) =
                    Eq/sym(@BigInt,
                        @(pos_sub(q, pos_add(p, r))),
                        @(add(pos_sub(q, p), BigInt/neg(r))),
                        pos_sub_sub(q, p, r));
                let s1 : Eq(add(BigInt/neg(p), pos_sub(q, r)),
                            add(pos_sub(q, r), BigInt/neg(p))) =
                    add_comm(BigInt/neg(p), pos_sub(q, r));
                let s2 : Eq(add(pos_sub(q, r), BigInt/neg(p)), pos_sub(q, pos_add(r, p))) =
                    Eq/sym(@BigInt,
                        @(pos_sub(q, pos_add(r, p))),
                        @(add(pos_sub(q, r), BigInt/neg(p))),
                        pos_sub_sub(q, r, p));
                let s3 : Eq(pos_sub(q, pos_add(r, p)), pos_sub(q, pos_add(p, r))) =
                    cong_psub_l(q, pos_add_comm(r, p));
                let t1 : Eq(add(BigInt/neg(p), pos_sub(q, r)), pos_sub(q, pos_add(r, p))) =
                    Eq/trans(@BigInt,
                        @(add(BigInt/neg(p), pos_sub(q, r))),
                        @(add(pos_sub(q, r), BigInt/neg(p))),
                        @(pos_sub(q, pos_add(r, p))),
                        s1, s2);
                let rhs : Eq(add(BigInt/neg(p), pos_sub(q, r)), pos_sub(q, pos_add(p, r))) =
                    Eq/trans(@BigInt,
                        @(add(BigInt/neg(p), pos_sub(q, r))),
                        @(pos_sub(q, pos_add(r, p))),
                        @(pos_sub(q, pos_add(p, r))),
                        t1, s3);
                Eq/trans(@BigInt,
                    @(add(pos_sub(q, p), BigInt/neg(r))),
                    @(pos_sub(q, pos_add(p, r))),
                    @(add(BigInt/neg(p), pos_sub(q, r))),
                    l1,
                    Eq/sym(@BigInt,
                        @(add(BigInt/neg(p), pos_sub(q, r))),
                        @(pos_sub(q, pos_add(p, r))),
                        rhs))
            | zero() => add_zero_r(pos_sub(q, p))
            | pos(r) =>
                let s1 : Eq(add(pos_sub(q, p), BigInt/pos(r)),
                            add(BigInt/pos(r), pos_sub(q, p))) =
                    add_comm(pos_sub(q, p), BigInt/pos(r));
                let s2 : Eq(add(BigInt/pos(r), pos_sub(q, p)), pos_sub(pos_add(r, q), p)) =
                    Eq/sym(@BigInt,
                        @(pos_sub(pos_add(r, q), p)),
                        @(add(BigInt/pos(r), pos_sub(q, p))),
                        pos_sub_add(r, q, p));
                let s3 : Eq(pos_sub(pos_add(r, q), p), pos_sub(pos_add(q, r), p)) =
                    cong_psub_r(p, pos_add_comm(r, q));
                let t1 : Eq(add(pos_sub(q, p), BigInt/pos(r)), pos_sub(pos_add(r, q), p)) =
                    Eq/trans(@BigInt,
                        @(add(pos_sub(q, p), BigInt/pos(r))),
                        @(add(BigInt/pos(r), pos_sub(q, p))),
                        @(pos_sub(pos_add(r, q), p)),
                        s1, s2);
                Eq/trans(@BigInt,
                    @(add(pos_sub(q, p), BigInt/pos(r))),
                    @(pos_sub(pos_add(r, q), p)),
                    @(pos_sub(pos_add(q, r), p)),
                    t1, s3)
            end
        end
    | zero() => qed(add(b, c))
    | pos(p) =>
        match b : (y) => Eq(@BigInt, add(add(BigInt/pos(p), y), c), add(BigInt/pos(p), add(y, c)))
        | neg(q) =>
            match c : (z) => Eq(@BigInt,
                add(add(BigInt/pos(p), BigInt/neg(q)), z),
                add(BigInt/pos(p), add(BigInt/neg(q), z)))
            | neg(r) =>
                Eq/sym(@BigInt,
                    @(pos_sub(p, pos_add(q, r))),
                    @(add(pos_sub(p, q), BigInt/neg(r))),
                    pos_sub_sub(p, q, r))
            | zero() => add_zero_r(pos_sub(p, q))
            | pos(r) =>
                let s1 : Eq(add(pos_sub(p, q), BigInt/pos(r)),
                            add(BigInt/pos(r), pos_sub(p, q))) =
                    add_comm(pos_sub(p, q), BigInt/pos(r));
                let s2 : Eq(add(BigInt/pos(r), pos_sub(p, q)), pos_sub(pos_add(r, p), q)) =
                    Eq/sym(@BigInt,
                        @(pos_sub(pos_add(r, p), q)),
                        @(add(BigInt/pos(r), pos_sub(p, q))),
                        pos_sub_add(r, p, q));
                let s3 : Eq(pos_sub(pos_add(r, p), q), pos_sub(pos_add(p, r), q)) =
                    cong_psub_r(q, pos_add_comm(r, p));
                let t1 : Eq(add(pos_sub(p, q), BigInt/pos(r)), pos_sub(pos_add(r, p), q)) =
                    Eq/trans(@BigInt,
                        @(add(pos_sub(p, q), BigInt/pos(r))),
                        @(add(BigInt/pos(r), pos_sub(p, q))),
                        @(pos_sub(pos_add(r, p), q)),
                        s1, s2);
                let t2 : Eq(add(pos_sub(p, q), BigInt/pos(r)), pos_sub(pos_add(p, r), q)) =
                    Eq/trans(@BigInt,
                        @(add(pos_sub(p, q), BigInt/pos(r))),
                        @(pos_sub(pos_add(r, p), q)),
                        @(pos_sub(pos_add(p, r), q)),
                        t1, s3);
                Eq/trans(@BigInt,
                    @(add(pos_sub(p, q), BigInt/pos(r))),
                    @(pos_sub(pos_add(p, r), q)),
                    @(add(BigInt/pos(p), pos_sub(r, q))),
                    t2, pos_sub_add(p, r, q))
            end
        | zero() => qed(add(BigInt/pos(p), c))
        | pos(q) =>
            match c : (z) => Eq(@BigInt,
                add(add(BigInt/pos(p), BigInt/pos(q)), z),
                add(BigInt/pos(p), add(BigInt/pos(q), z)))
            | neg(r) => pos_sub_add(p, q, r)
            | zero() => qed(BigInt/pos(pos_add(p, q)))
            | pos(r) => cong_posz(pos_add_assoc(p, q, r))
            end
        end
    end;

pub let add_cancel_l(a : BigInt, b : BigInt, c : BigInt, w : Eq(add(a, b), add(a, c)))
    -> Eq(b, c) =
    let lb : Eq(add(add(neg(a), a), b), b) =
        cong_add_r(b, @(add(neg(a), a)), @(BigInt/zero()), add_neg_l(a));
    let lc : Eq(add(add(neg(a), a), c), c) =
        cong_add_r(c, @(add(neg(a), a)), @(BigInt/zero()), add_neg_l(a));
    let m1 : Eq(add(add(neg(a), a), b), add(neg(a), add(a, b))) =
        add_assoc(neg(a), a, b);
    let m2 : Eq(add(neg(a), add(a, b)), add(neg(a), add(a, c))) =
        cong_add_l(neg(a), @(add(a, b)), @(add(a, c)), w);
    let m3 : Eq(add(neg(a), add(a, c)), add(add(neg(a), a), c)) =
        Eq/sym(@BigInt,
            @(add(add(neg(a), a), c)),
            @(add(neg(a), add(a, c))),
            add_assoc(neg(a), a, c));
    let t1 : Eq(add(add(neg(a), a), b), add(neg(a), add(a, c))) =
        Eq/trans(@BigInt,
            @(add(add(neg(a), a), b)),
            @(add(neg(a), add(a, b))),
            @(add(neg(a), add(a, c))),
            m1, m2);
    let t2 : Eq(add(add(neg(a), a), b), add(add(neg(a), a), c)) =
        Eq/trans(@BigInt,
            @(add(add(neg(a), a), b)),
            @(add(neg(a), add(a, c))),
            @(add(add(neg(a), a), c)),
            t1, m3);
    let t3 : Eq(add(add(neg(a), a), b), c) =
        Eq/trans(@BigInt,
            @(add(add(neg(a), a), b)),
            @(add(add(neg(a), a), c)),
            @c,
            t2, lc);
    Eq/trans(@BigInt, @b, @(add(add(neg(a), a), b)), @c,
        Eq/sym(@BigInt, @(add(add(neg(a), a), b)), @b, lb),
        t3);

pub let add_cancel_r(a : BigInt, b : BigInt, c : BigInt, w : Eq(add(b, a), add(c, a)))
    -> Eq(b, c) =
    let w2 : Eq(add(a, b), add(a, c)) =
        Eq/trans(@BigInt,
            @(add(a, b)),
            @(add(c, a)),
            @(add(a, c)),
            Eq/trans(@BigInt, @(add(a, b)), @(add(b, a)), @(add(c, a)), add_comm(a, b), w),
            add_comm(c, a));
    add_cancel_l(a, b, c, w2);

pub let mul_comm(a : BigInt, b : BigInt) -> Eq(mul(a, b), mul(b, a)) =
    match a : (x) => Eq(@BigInt, mul(x, b), mul(b, x))
    | neg(p) =>
        match b : (y) => Eq(@BigInt, mul(BigInt/neg(p), y), mul(y, BigInt/neg(p)))
        | neg(q) => cong_posz(pos_mul_comm(p, q))
        | zero() => qed(BigInt/zero())
        | pos(q) => cong_negz(pos_mul_comm(p, q))
        end
    | zero() =>
        match b : (y) => Eq(@BigInt, mul(BigInt/zero(), y), mul(y, BigInt/zero()))
        | neg(q) => qed(BigInt/zero())
        | zero() => qed(BigInt/zero())
        | pos(q) => qed(BigInt/zero())
        end
    | pos(p) =>
        match b : (y) => Eq(@BigInt, mul(BigInt/pos(p), y), mul(y, BigInt/pos(p)))
        | neg(q) => cong_negz(pos_mul_comm(p, q))
        | zero() => qed(BigInt/zero())
        | pos(q) => cong_posz(pos_mul_comm(p, q))
        end
    end;

pub let neg_mul_l(a : BigInt, b : BigInt) -> Eq(mul(neg(a), b), neg(mul(a, b))) =
    match a : (x) => Eq(@BigInt, mul(neg(x), b), neg(mul(x, b)))
    | neg(p) =>
        match b : (y) => Eq(@BigInt, mul(neg(BigInt/neg(p)), y), neg(mul(BigInt/neg(p), y)))
        | neg(q) => qed(BigInt/neg(pos_mul(p, q)))
        | zero() => qed(BigInt/zero())
        | pos(q) => qed(BigInt/pos(pos_mul(p, q)))
        end
    | zero() => qed(BigInt/zero())
    | pos(p) =>
        match b : (y) => Eq(@BigInt, mul(neg(BigInt/pos(p)), y), neg(mul(BigInt/pos(p), y)))
        | neg(q) => qed(BigInt/pos(pos_mul(p, q)))
        | zero() => qed(BigInt/zero())
        | pos(q) => qed(BigInt/neg(pos_mul(p, q)))
        end
    end;

pub let mul_assoc(a : BigInt, b : BigInt, c : BigInt)
    -> Eq(mul(mul(a, b), c), mul(a, mul(b, c))) =
    match a : (x) => Eq(@BigInt, mul(mul(x, b), c), mul(x, mul(b, c)))
    | neg(p) =>
        match b : (y) => Eq(@BigInt, mul(mul(BigInt/neg(p), y), c), mul(BigInt/neg(p), mul(y, c)))
        | neg(q) =>
            match c : (z) => Eq(@BigInt,
                mul(mul(BigInt/neg(p), BigInt/neg(q)), z),
                mul(BigInt/neg(p), mul(BigInt/neg(q), z)))
            | neg(r) => cong_negz(pos_mul_assoc(p, q, r))
            | zero() => qed(BigInt/zero())
            | pos(r) => cong_posz(pos_mul_assoc(p, q, r))
            end
        | zero() => qed(BigInt/zero())
        | pos(q) =>
            match c : (z) => Eq(@BigInt,
                mul(mul(BigInt/neg(p), BigInt/pos(q)), z),
                mul(BigInt/neg(p), mul(BigInt/pos(q), z)))
            | neg(r) => cong_posz(pos_mul_assoc(p, q, r))
            | zero() => qed(BigInt/zero())
            | pos(r) => cong_negz(pos_mul_assoc(p, q, r))
            end
        end
    | zero() => qed(BigInt/zero())
    | pos(p) =>
        match b : (y) => Eq(@BigInt, mul(mul(BigInt/pos(p), y), c), mul(BigInt/pos(p), mul(y, c)))
        | neg(q) =>
            match c : (z) => Eq(@BigInt,
                mul(mul(BigInt/pos(p), BigInt/neg(q)), z),
                mul(BigInt/pos(p), mul(BigInt/neg(q), z)))
            | neg(r) => cong_posz(pos_mul_assoc(p, q, r))
            | zero() => qed(BigInt/zero())
            | pos(r) => cong_negz(pos_mul_assoc(p, q, r))
            end
        | zero() => qed(BigInt/zero())
        | pos(q) =>
            match c : (z) => Eq(@BigInt,
                mul(mul(BigInt/pos(p), BigInt/pos(q)), z),
                mul(BigInt/pos(p), mul(BigInt/pos(q), z)))
            | neg(r) => cong_negz(pos_mul_assoc(p, q, r))
            | zero() => qed(BigInt/zero())
            | pos(r) => cong_posz(pos_mul_assoc(p, q, r))
            end
        end
    end;

let neg_mul_r(a : BigInt, b : BigInt) -> Eq(mul(a, neg(b)), neg(mul(a, b))) =
    match a : (x) => Eq(@BigInt, mul(x, neg(b)), neg(mul(x, b)))
    | neg(p) =>
        match b : (y) => Eq(@BigInt, mul(BigInt/neg(p), neg(y)), neg(mul(BigInt/neg(p), y)))
        | neg(q) => qed(BigInt/neg(pos_mul(p, q)))
        | zero() => qed(BigInt/zero())
        | pos(q) => qed(BigInt/pos(pos_mul(p, q)))
        end
    | zero() => qed(BigInt/zero())
    | pos(p) =>
        match b : (y) => Eq(@BigInt, mul(BigInt/pos(p), neg(y)), neg(mul(BigInt/pos(p), y)))
        | neg(q) => qed(BigInt/pos(pos_mul(p, q)))
        | zero() => qed(BigInt/zero())
        | pos(q) => qed(BigInt/neg(pos_mul(p, q)))
        end
    end;

let mul_pos_sub_eq(p : Pos, x : Pos, y : Pos, w : Eq(pos_cmp(x, y), Order/eq()))
    -> Eq(mul(BigInt/pos(p), pos_sub(x, y)), pos_sub(pos_mul(p, x), pos_mul(p, y))) =
    let e : Eq(x, y) = pos_cmp_eq(x, y, w);
    let i1 : Eq(pos_sub(x, y), BigInt/zero()) =
        Eq/trans(cong_psub_l(x, Eq/sym(e)), pos_sub_diag(x));
    let lhs : Eq(mul(BigInt/pos(p), pos_sub(x, y)), BigInt/zero()) =
        cong_mul_l(BigInt/pos(p), @(pos_sub(x, y)), @(BigInt/zero()), i1);
    let rhs : Eq(pos_sub(pos_mul(p, x), pos_mul(p, y)), BigInt/zero()) =
        Eq/trans(
            cong_psub_l(pos_mul(p, x), cong_pmul_l(p, Eq/sym(e))),
            pos_sub_diag(pos_mul(p, x)));
    Eq/trans(@BigInt,
        @(mul(BigInt/pos(p), pos_sub(x, y))),
        @(BigInt/zero()),
        @(pos_sub(pos_mul(p, x), pos_mul(p, y))),
        lhs,
        Eq/sym(@BigInt, @(pos_sub(pos_mul(p, x), pos_mul(p, y))), @(BigInt/zero()), rhs));

let mul_pos_sub_lt(p : Pos, x : Pos, y : Pos, w : Eq(pos_cmp(x, y), Order/lt()))
    -> Eq(mul(BigInt/pos(p), pos_sub(x, y)), pos_sub(pos_mul(p, x), pos_mul(p, y))) =
    let (d, e) = pos_lt_witness(x, y, w);
    let lhs : Eq(mul(BigInt/pos(p), pos_sub(x, y)), BigInt/neg(pos_mul(p, d))) =
        cong_mul_l(BigInt/pos(p), @(pos_sub(x, y)), @(BigInt/neg(d)),
            pos_sub_of_lt(x, y, d, e));
    let r1 : Eq(pos_sub(pos_mul(p, x), pos_mul(p, y)),
                pos_sub(pos_mul(p, x), pos_mul(p, pos_add(x, d)))) =
        cong_psub_l(pos_mul(p, x), cong_pmul_l(p, Eq/sym(e)));
    let r2 : Eq(pos_sub(pos_mul(p, x), pos_mul(p, pos_add(x, d))),
                pos_sub(pos_mul(p, x), pos_add(pos_mul(p, x), pos_mul(p, d)))) =
        cong_psub_l(pos_mul(p, x), pos_distrib_l(p, x, d));
    let r3 : Eq(pos_sub(pos_mul(p, x), pos_add(pos_mul(p, x), pos_mul(p, d))),
                BigInt/neg(pos_mul(p, d))) =
        pos_sub_add_r(pos_mul(p, x), pos_mul(p, d));
    let r12 : Eq(pos_sub(pos_mul(p, x), pos_mul(p, y)),
                 pos_sub(pos_mul(p, x), pos_add(pos_mul(p, x), pos_mul(p, d)))) =
        Eq/trans(r1, r2);
    let rt : Eq(pos_sub(pos_mul(p, x), pos_mul(p, y)), BigInt/neg(pos_mul(p, d))) =
        Eq/trans(r12, r3);
    Eq/trans(@BigInt,
        @(mul(BigInt/pos(p), pos_sub(x, y))),
        @(BigInt/neg(pos_mul(p, d))),
        @(pos_sub(pos_mul(p, x), pos_mul(p, y))),
        lhs,
        Eq/sym(@BigInt, @(pos_sub(pos_mul(p, x), pos_mul(p, y))),
            @(BigInt/neg(pos_mul(p, d))), rt));

let mul_pos_sub_gt(p : Pos, x : Pos, y : Pos, w : Eq(pos_cmp(y, x), Order/lt()))
    -> Eq(mul(BigInt/pos(p), pos_sub(x, y)), pos_sub(pos_mul(p, x), pos_mul(p, y))) =
    let g1 : Eq(mul(BigInt/pos(p), pos_sub(x, y)), mul(BigInt/pos(p), neg(pos_sub(y, x)))) =
        cong_mul_l(BigInt/pos(p), @(pos_sub(x, y)), @(neg(pos_sub(y, x))),
            pos_sub_flip(y, x));
    let g2 : Eq(mul(BigInt/pos(p), neg(pos_sub(y, x))), neg(mul(BigInt/pos(p), pos_sub(y, x)))) =
        neg_mul_r(BigInt/pos(p), pos_sub(y, x));
    let g3 : Eq(neg(mul(BigInt/pos(p), pos_sub(y, x))),
                neg(pos_sub(pos_mul(p, y), pos_mul(p, x)))) =
        cong_neg(@(mul(BigInt/pos(p), pos_sub(y, x))),
            @(pos_sub(pos_mul(p, y), pos_mul(p, x))),
            mul_pos_sub_lt(p, y, x, w));
    let g4 : Eq(neg(pos_sub(pos_mul(p, y), pos_mul(p, x))),
                pos_sub(pos_mul(p, x), pos_mul(p, y))) =
        Eq/sym(@BigInt,
            @(pos_sub(pos_mul(p, x), pos_mul(p, y))),
            @(neg(pos_sub(pos_mul(p, y), pos_mul(p, x)))),
            pos_sub_flip(pos_mul(p, y), pos_mul(p, x)));
    let t1 : Eq(mul(BigInt/pos(p), pos_sub(x, y)), neg(mul(BigInt/pos(p), pos_sub(y, x)))) =
        Eq/trans(@BigInt,
            @(mul(BigInt/pos(p), pos_sub(x, y))),
            @(mul(BigInt/pos(p), neg(pos_sub(y, x)))),
            @(neg(mul(BigInt/pos(p), pos_sub(y, x)))),
            g1, g2);
    let t2 : Eq(mul(BigInt/pos(p), pos_sub(x, y)),
                neg(pos_sub(pos_mul(p, y), pos_mul(p, x)))) =
        Eq/trans(@BigInt,
            @(mul(BigInt/pos(p), pos_sub(x, y))),
            @(neg(mul(BigInt/pos(p), pos_sub(y, x)))),
            @(neg(pos_sub(pos_mul(p, y), pos_mul(p, x)))),
            t1, g3);
    Eq/trans(@BigInt,
        @(mul(BigInt/pos(p), pos_sub(x, y))),
        @(neg(pos_sub(pos_mul(p, y), pos_mul(p, x)))),
        @(pos_sub(pos_mul(p, x), pos_mul(p, y))),
        t2, g4);

let mul_pos_sub(p : Pos, x : Pos, y : Pos)
    -> Eq(mul(BigInt/pos(p), pos_sub(x, y)), pos_sub(pos_mul(p, x), pos_mul(p, y))) =
    (match pos_cmp(x, y) : (r) => (w : Eq(pos_cmp(x, y), r))
        -> Eq(@BigInt, mul(BigInt/pos(p), pos_sub(x, y)), pos_sub(pos_mul(p, x), pos_mul(p, y)))
     | eq() => (w) => mul_pos_sub_eq(p, x, y, w)
     | lt() => (w) => mul_pos_sub_lt(p, x, y, w)
     | gt() => (w) => mul_pos_sub_gt(p, x, y, pos_cmp_gt_to_lt(x, y, w))
     end)(qed(pos_cmp(x, y)));

let distrib_l_pos(p : Pos, b : BigInt, c : BigInt)
    -> Eq(mul(BigInt/pos(p), add(b, c)),
          add(mul(BigInt/pos(p), b), mul(BigInt/pos(p), c))) =
    match b : (y) => Eq(@BigInt,
        mul(BigInt/pos(p), add(y, c)),
        add(mul(BigInt/pos(p), y), mul(BigInt/pos(p), c)))
    | neg(q) =>
        match c : (z) => Eq(@BigInt,
            mul(BigInt/pos(p), add(BigInt/neg(q), z)),
            add(mul(BigInt/pos(p), BigInt/neg(q)), mul(BigInt/pos(p), z)))
        | neg(r) => cong_negz(pos_distrib_l(p, q, r))
        | zero() => qed(BigInt/neg(pos_mul(p, q)))
        | pos(r) => mul_pos_sub(p, r, q)
        end
    | zero() => qed(mul(BigInt/pos(p), c))
    | pos(q) =>
        match c : (z) => Eq(@BigInt,
            mul(BigInt/pos(p), add(BigInt/pos(q), z)),
            add(mul(BigInt/pos(p), BigInt/pos(q)), mul(BigInt/pos(p), z)))
        | neg(r) => mul_pos_sub(p, q, r)
        | zero() => qed(BigInt/pos(pos_mul(p, q)))
        | pos(r) => cong_posz(pos_distrib_l(p, q, r))
        end
    end;

pub let distrib_l(a : BigInt, b : BigInt, c : BigInt)
    -> Eq(mul(a, add(b, c)), add(mul(a, b), mul(a, c))) =
    match a : (x) => Eq(@BigInt, mul(x, add(b, c)), add(mul(x, b), mul(x, c)))
    | neg(p) =>
        let s1 : Eq(mul(BigInt/neg(p), add(b, c)), neg(mul(BigInt/pos(p), add(b, c)))) =
            neg_mul_l(BigInt/pos(p), add(b, c));
        let s2 : Eq(neg(mul(BigInt/pos(p), add(b, c))),
                    neg(add(mul(BigInt/pos(p), b), mul(BigInt/pos(p), c)))) =
            cong_neg(@(mul(BigInt/pos(p), add(b, c))),
                @(add(mul(BigInt/pos(p), b), mul(BigInt/pos(p), c))),
                distrib_l_pos(p, b, c));
        let s3 : Eq(neg(add(mul(BigInt/pos(p), b), mul(BigInt/pos(p), c))),
                    add(neg(mul(BigInt/pos(p), b)), neg(mul(BigInt/pos(p), c)))) =
            neg_add(mul(BigInt/pos(p), b), mul(BigInt/pos(p), c));
        let s4 : Eq(add(neg(mul(BigInt/pos(p), b)), neg(mul(BigInt/pos(p), c))),
                    add(mul(BigInt/neg(p), b), neg(mul(BigInt/pos(p), c)))) =
            cong_add_r(neg(mul(BigInt/pos(p), c)),
                @(neg(mul(BigInt/pos(p), b))), @(mul(BigInt/neg(p), b)),
                Eq/sym(@BigInt, @(mul(BigInt/neg(p), b)), @(neg(mul(BigInt/pos(p), b))),
                    neg_mul_l(BigInt/pos(p), b)));
        let s5 : Eq(add(mul(BigInt/neg(p), b), neg(mul(BigInt/pos(p), c))),
                    add(mul(BigInt/neg(p), b), mul(BigInt/neg(p), c))) =
            cong_add_l(mul(BigInt/neg(p), b),
                @(neg(mul(BigInt/pos(p), c))), @(mul(BigInt/neg(p), c)),
                Eq/sym(@BigInt, @(mul(BigInt/neg(p), c)), @(neg(mul(BigInt/pos(p), c))),
                    neg_mul_l(BigInt/pos(p), c)));
        let t1 : Eq(mul(BigInt/neg(p), add(b, c)),
                    neg(add(mul(BigInt/pos(p), b), mul(BigInt/pos(p), c)))) =
            Eq/trans(@BigInt,
                @(mul(BigInt/neg(p), add(b, c))),
                @(neg(mul(BigInt/pos(p), add(b, c)))),
                @(neg(add(mul(BigInt/pos(p), b), mul(BigInt/pos(p), c)))),
                s1, s2);
        let t2 : Eq(mul(BigInt/neg(p), add(b, c)),
                    add(neg(mul(BigInt/pos(p), b)), neg(mul(BigInt/pos(p), c)))) =
            Eq/trans(@BigInt,
                @(mul(BigInt/neg(p), add(b, c))),
                @(neg(add(mul(BigInt/pos(p), b), mul(BigInt/pos(p), c)))),
                @(add(neg(mul(BigInt/pos(p), b)), neg(mul(BigInt/pos(p), c)))),
                t1, s3);
        let t3 : Eq(mul(BigInt/neg(p), add(b, c)),
                    add(mul(BigInt/neg(p), b), neg(mul(BigInt/pos(p), c)))) =
            Eq/trans(@BigInt,
                @(mul(BigInt/neg(p), add(b, c))),
                @(add(neg(mul(BigInt/pos(p), b)), neg(mul(BigInt/pos(p), c)))),
                @(add(mul(BigInt/neg(p), b), neg(mul(BigInt/pos(p), c)))),
                t2, s4);
        Eq/trans(@BigInt,
            @(mul(BigInt/neg(p), add(b, c))),
            @(add(mul(BigInt/neg(p), b), neg(mul(BigInt/pos(p), c)))),
            @(add(mul(BigInt/neg(p), b), mul(BigInt/neg(p), c))),
            t3, s5)
    | zero() => qed(BigInt/zero())
    | pos(p) => distrib_l_pos(p, b, c)
    end;

pub let distrib_r(a : BigInt, b : BigInt, c : BigInt)
    -> Eq(mul(add(a, b), c), add(mul(a, c), mul(b, c))) =
    let s1 : Eq(mul(add(a, b), c), mul(c, add(a, b))) =
        mul_comm(add(a, b), c);
    let s2 : Eq(mul(c, add(a, b)), add(mul(c, a), mul(c, b))) =
        distrib_l(c, a, b);
    let s3 : Eq(add(mul(c, a), mul(c, b)), add(mul(a, c), mul(c, b))) =
        cong_add_r(mul(c, b), @(mul(c, a)), @(mul(a, c)), mul_comm(c, a));
    let s4 : Eq(add(mul(a, c), mul(c, b)), add(mul(a, c), mul(b, c))) =
        cong_add_l(mul(a, c), @(mul(c, b)), @(mul(b, c)), mul_comm(c, b));
    let t1 : Eq(mul(add(a, b), c), add(mul(c, a), mul(c, b))) =
        Eq/trans(@BigInt,
            @(mul(add(a, b), c)),
            @(mul(c, add(a, b))),
            @(add(mul(c, a), mul(c, b))),
            s1, s2);
    let t2 : Eq(mul(add(a, b), c), add(mul(a, c), mul(c, b))) =
        Eq/trans(@BigInt,
            @(mul(add(a, b), c)),
            @(add(mul(c, a), mul(c, b))),
            @(add(mul(a, c), mul(c, b))),
            t1, s3);
    Eq/trans(@BigInt,
        @(mul(add(a, b), c)),
        @(add(mul(a, c), mul(c, b))),
        @(add(mul(a, c), mul(b, c))),
        t2, s4);

let bigint_is_neg(z : BigInt) -> Bln =
    match z
    | neg(_) => true
    | zero() => false
    | pos(_) => false
    end;

let bigint_is_pos(z : BigInt) -> Bln =
    match z
    | neg(_) => false
    | zero() => false
    | pos(_) => true
    end;

let bln_clash(p : Eq(false, true)) -> False =
    Eq/subst((b : Bln) => match b : Prop | false => True | true => False end, p, True/qed());

let negz_neq_zero(@a : Pos, p : Eq(BigInt/neg(a), BigInt/zero())) -> False =
    bln_clash(match p : (q : Eq(BigInt, s, t)) => Eq(is_zero(s), is_zero(t))
        | refl(z) => Eq/refl()
        end);

let posz_neq_zero(@a : Pos, p : Eq(BigInt/pos(a), BigInt/zero())) -> False =
    bln_clash(match p : (q : Eq(BigInt, s, t)) => Eq(is_zero(s), is_zero(t))
        | refl(z) => Eq/refl()
        end);

let zero_neq_negz(@b : Pos, p : Eq(BigInt/zero(), BigInt/neg(b))) -> False =
    bln_clash(match p : (q : Eq(BigInt, s, t)) => Eq(bigint_is_neg(s), bigint_is_neg(t))
        | refl(z) => Eq/refl()
        end);

let zero_neq_posz(@b : Pos, p : Eq(BigInt/zero(), BigInt/pos(b))) -> False =
    bln_clash(match p : (q : Eq(BigInt, s, t)) => Eq(bigint_is_pos(s), bigint_is_pos(t))
        | refl(z) => Eq/refl()
        end);

let negz_neq_posz(@a : Pos, @b : Pos, p : Eq(BigInt/neg(a), BigInt/pos(b))) -> False =
    bln_clash(match p : (q : Eq(BigInt, s, t)) => Eq(bigint_is_pos(s), bigint_is_pos(t))
        | refl(z) => Eq/refl()
        end);

let posz_neq_negz(@a : Pos, @b : Pos, p : Eq(BigInt/pos(a), BigInt/neg(b))) -> False =
    bln_clash(match p : (q : Eq(BigInt, s, t)) => Eq(bigint_is_neg(s), bigint_is_neg(t))
        | refl(z) => Eq/refl()
        end);

let posz_head(d : Pos, z : BigInt) -> Pos =
    match z
    | neg(_) => d
    | zero() => d
    | pos(p) => p
    end;

let negz_head(d : Pos, z : BigInt) -> Pos =
    match z
    | neg(p) => p
    | zero() => d
    | pos(_) => d
    end;

let posz_inj(@a : Pos, @b : Pos, p : Eq(BigInt/pos(a), BigInt/pos(b))) -> Eq(a, b) =
    match p : (q : Eq(BigInt, s, t)) => Eq(posz_head(a, s), posz_head(a, t))
    | refl(z) => Eq/refl()
    end;

let negz_inj(@a : Pos, @b : Pos, p : Eq(BigInt/neg(a), BigInt/neg(b))) -> Eq(a, b) =
    match p : (q : Eq(BigInt, s, t)) => Eq(negz_head(a, s), negz_head(a, t))
    | refl(z) => Eq/refl()
    end;

pub let mul_cancel_l(p : Pos, b : BigInt, c : BigInt,
    w : Eq(mul(BigInt/pos(p), b), mul(BigInt/pos(p), c))) -> Eq(b, c) =
    (match b : (x) => (w2 : Eq(mul(BigInt/pos(p), x), mul(BigInt/pos(p), c)))
        -> Eq(@BigInt, x, c)
     | neg(q) => (w2) =>
         (match c : (y) => (w3 : Eq(mul(BigInt/pos(p), BigInt/neg(q)), mul(BigInt/pos(p), y)))
             -> Eq(@BigInt, BigInt/neg(q), y)
          | neg(r) => (w3) =>
              cong_negz(pos_mul_cancel_l(p, q, r,
                  negz_inj(@(pos_mul(p, q)), @(pos_mul(p, r)), w3)))
          | zero() => (w3) => False/absurd(negz_neq_zero(@(pos_mul(p, q)), w3))
          | pos(r) => (w3) =>
              False/absurd(negz_neq_posz(@(pos_mul(p, q)), @(pos_mul(p, r)), w3))
          end)(w2)
     | zero() => (w2) =>
         (match c : (y) => (w3 : Eq(mul(BigInt/pos(p), BigInt/zero()), mul(BigInt/pos(p), y)))
             -> Eq(@BigInt, BigInt/zero(), y)
          | neg(r) => (w3) => False/absurd(zero_neq_negz(@(pos_mul(p, r)), w3))
          | zero() => (w3) => qed(BigInt/zero())
          | pos(r) => (w3) => False/absurd(zero_neq_posz(@(pos_mul(p, r)), w3))
          end)(w2)
     | pos(q) => (w2) =>
         (match c : (y) => (w3 : Eq(mul(BigInt/pos(p), BigInt/pos(q)), mul(BigInt/pos(p), y)))
             -> Eq(@BigInt, BigInt/pos(q), y)
          | neg(r) => (w3) =>
              False/absurd(posz_neq_negz(@(pos_mul(p, q)), @(pos_mul(p, r)), w3))
          | zero() => (w3) => False/absurd(posz_neq_zero(@(pos_mul(p, q)), w3))
          | pos(r) => (w3) =>
              cong_posz(pos_mul_cancel_l(p, q, r,
                  posz_inj(@(pos_mul(p, q)), @(pos_mul(p, r)), w3)))
          end)(w2)
     end)(w);

pub let mul_cancel_r(p : Pos, b : BigInt, c : BigInt,
    w : Eq(mul(b, BigInt/pos(p)), mul(c, BigInt/pos(p)))) -> Eq(b, c) =
    let w2 : Eq(mul(BigInt/pos(p), b), mul(BigInt/pos(p), c)) =
        Eq/trans(@BigInt,
            @(mul(BigInt/pos(p), b)),
            @(mul(c, BigInt/pos(p))),
            @(mul(BigInt/pos(p), c)),
            Eq/trans(@BigInt,
                @(mul(BigInt/pos(p), b)),
                @(mul(b, BigInt/pos(p))),
                @(mul(c, BigInt/pos(p))),
                mul_comm(BigInt/pos(p), b), w),
            mul_comm(c, BigInt/pos(p)));
    mul_cancel_l(p, b, c, w2);

pub let cmp_refl(a : BigInt) -> Eq(cmp(a, a), Order/eq()) =
    match a : (x) => Eq(@Order, cmp(x, x), Order/eq())
    | neg(p) => pos_cmp_refl(p)
    | zero() => qed(Order/eq())
    | pos(p) => pos_cmp_refl(p)
    end;

pub let cmp_eq(a : BigInt, b : BigInt, w : Eq(cmp(a, b), Order/eq())) -> Eq(a, b) =
    (match a : (x) => (w2 : Eq(cmp(x, b), Order/eq())) -> Eq(@BigInt, x, b)
     | neg(p) => (w2) =>
         (match b : (y) => (w3 : Eq(cmp(BigInt/neg(p), y), Order/eq()))
             -> Eq(@BigInt, BigInt/neg(p), y)
          | neg(q) => (w3) => cong_negz(Eq/sym(pos_cmp_eq(q, p, w3)))
          | zero() => (w3) => False/absurd(lt_neq_eq(w3))
          | pos(q) => (w3) => False/absurd(lt_neq_eq(w3))
          end)(w2)
     | zero() => (w2) =>
         (match b : (y) => (w3 : Eq(cmp(BigInt/zero(), y), Order/eq()))
             -> Eq(@BigInt, BigInt/zero(), y)
          | neg(q) => (w3) => False/absurd(gt_neq_eq(w3))
          | zero() => (w3) => qed(BigInt/zero())
          | pos(q) => (w3) => False/absurd(lt_neq_eq(w3))
          end)(w2)
     | pos(p) => (w2) =>
         (match b : (y) => (w3 : Eq(cmp(BigInt/pos(p), y), Order/eq()))
             -> Eq(@BigInt, BigInt/pos(p), y)
          | neg(q) => (w3) => False/absurd(gt_neq_eq(w3))
          | zero() => (w3) => False/absurd(gt_neq_eq(w3))
          | pos(q) => (w3) => cong_posz(pos_cmp_eq(p, q, w3))
          end)(w2)
     end)(w);

pub let cmp_flip(a : BigInt, b : BigInt) -> Eq(cmp(b, a), Order/flip(cmp(a, b))) =
    match a : (x) => Eq(@Order, cmp(b, x), Order/flip(cmp(x, b)))
    | neg(p) =>
        match b : (y) => Eq(@Order, cmp(y, BigInt/neg(p)), Order/flip(cmp(BigInt/neg(p), y)))
        | neg(q) => pos_cmp_flip(q, p)
        | zero() => qed(Order/gt())
        | pos(q) => qed(Order/gt())
        end
    | zero() =>
        match b : (y) => Eq(@Order, cmp(y, BigInt/zero()), Order/flip(cmp(BigInt/zero(), y)))
        | neg(q) => qed(Order/lt())
        | zero() => qed(Order/eq())
        | pos(q) => qed(Order/gt())
        end
    | pos(p) =>
        match b : (y) => Eq(@Order, cmp(y, BigInt/pos(p)), Order/flip(cmp(BigInt/pos(p), y)))
        | neg(q) => qed(Order/lt())
        | zero() => qed(Order/lt())
        | pos(q) => pos_cmp_flip(p, q)
        end
    end;

pub let cmp_trans(a : BigInt, b : BigInt, c : BigInt,
    u : Eq(cmp(a, b), Order/lt()), v : Eq(cmp(b, c), Order/lt()))
    -> Eq(cmp(a, c), Order/lt()) =
    (match a : (x) => (u2 : Eq(cmp(x, b), Order/lt())) -> Eq(@Order, cmp(x, c), Order/lt())
     | neg(p) => (u2) =>
         (match b : (y) => (u3 : Eq(cmp(BigInt/neg(p), y), Order/lt()))
             -> (v3 : Eq(cmp(y, c), Order/lt()))
             -> Eq(@Order, cmp(BigInt/neg(p), c), Order/lt())
          | neg(q) => (u3) => (v3) =>
              (match c : (z) => (v4 : Eq(cmp(BigInt/neg(q), z), Order/lt()))
                  -> Eq(@Order, cmp(BigInt/neg(p), z), Order/lt())
               | neg(r) => (v4) => pos_cmp_trans(r, q, p, v4, u3)
               | zero() => (v4) => qed(Order/lt())
               | pos(r) => (v4) => qed(Order/lt())
               end)(v3)
          | zero() => (u3) => (v3) =>
              (match c : (z) => (v4 : Eq(cmp(BigInt/zero(), z), Order/lt()))
                  -> Eq(@Order, cmp(BigInt/neg(p), z), Order/lt())
               | neg(r) => (v4) => False/absurd(gt_neq_lt(v4))
               | zero() => (v4) => False/absurd(eq_neq_lt(v4))
               | pos(r) => (v4) => qed(Order/lt())
               end)(v3)
          | pos(q) => (u3) => (v3) =>
              (match c : (z) => (v4 : Eq(cmp(BigInt/pos(q), z), Order/lt()))
                  -> Eq(@Order, cmp(BigInt/neg(p), z), Order/lt())
               | neg(r) => (v4) => False/absurd(gt_neq_lt(v4))
               | zero() => (v4) => False/absurd(gt_neq_lt(v4))
               | pos(r) => (v4) => qed(Order/lt())
               end)(v3)
          end)(u2)(v)
     | zero() => (u2) =>
         (match b : (y) => (u3 : Eq(cmp(BigInt/zero(), y), Order/lt()))
             -> (v3 : Eq(cmp(y, c), Order/lt()))
             -> Eq(@Order, cmp(BigInt/zero(), c), Order/lt())
          | neg(q) => (u3) => (v3) => False/absurd(gt_neq_lt(u3))
          | zero() => (u3) => (v3) => False/absurd(eq_neq_lt(u3))
          | pos(q) => (u3) => (v3) =>
              (match c : (z) => (v4 : Eq(cmp(BigInt/pos(q), z), Order/lt()))
                  -> Eq(@Order, cmp(BigInt/zero(), z), Order/lt())
               | neg(r) => (v4) => False/absurd(gt_neq_lt(v4))
               | zero() => (v4) => False/absurd(gt_neq_lt(v4))
               | pos(r) => (v4) => qed(Order/lt())
               end)(v3)
          end)(u2)(v)
     | pos(p) => (u2) =>
         (match b : (y) => (u3 : Eq(cmp(BigInt/pos(p), y), Order/lt()))
             -> (v3 : Eq(cmp(y, c), Order/lt()))
             -> Eq(@Order, cmp(BigInt/pos(p), c), Order/lt())
          | neg(q) => (u3) => (v3) => False/absurd(gt_neq_lt(u3))
          | zero() => (u3) => (v3) => False/absurd(gt_neq_lt(u3))
          | pos(q) => (u3) => (v3) =>
              (match c : (z) => (v4 : Eq(cmp(BigInt/pos(q), z), Order/lt()))
                  -> Eq(@Order, cmp(BigInt/pos(p), z), Order/lt())
               | neg(r) => (v4) => False/absurd(gt_neq_lt(v4))
               | zero() => (v4) => False/absurd(gt_neq_lt(v4))
               | pos(r) => (v4) => pos_cmp_trans(p, q, r, u3, v4)
               end)(v3)
          end)(u2)(v)
     end)(u);
