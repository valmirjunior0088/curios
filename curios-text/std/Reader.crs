use /std/{Io, Bin, Nat, Option, Monad};

pub let Buffer : Type =
    {Io, Bin};

-- Nominal (not a bare function type) so the constructor has a rigid head:
-- witness resolution keys on it (`Monad(Reader)`) and the elaborator can
-- infer `M := Reader` from an applied occurrence.
pub record Reader(A : Type) : Type {
    run(b : Buffer) -> {Buffer, A}
}

pub let buffer(h : Io) -> Buffer =
    (h, \\);

pub let pure(@A : Type, a : A) -> Reader(A) =
    Reader { run(b) = (b, a) };

pub let bind(@A : Type, @B : Type) -> (Reader(A), (A) -> Reader(B)) -> Reader(B) =
    (m, f) => Reader { run(b) =
        let p = m.run(b);
        f(p.1).run(p.0) };

pub let run(@A : Type, m : Reader(A), h : Io) -> A =
    m.run(buffer(h)).1;

pub rec read_line : Reader(Option(Bin)) =
    Reader { run(b) =
        match Bin/find_index(b.1, (byte) => byte == '\n') : {Buffer, Option(Bin)}
        | some(i) =>
            let stop = i + 1;
            let line = Bin/slice(b.1, 0, stop);
            let rest = Bin/slice(b.1, stop, Bin/len(b.1));
            ((b.0, rest), Option/some(line))
        | none() =>
            let flush = () =>
                match Bin/len(b.1) == 0
                | true => (b, Option/none())
                | false => ((b.0, \\), Option/some(b.1))
                end;
            match Io/read(b.0, 4096) : {Buffer, Option(Bin)}
            | chunk(bytes) => read_line.run((b.0, Bin/concat(b.1, bytes)))
            | eof() => flush()
            | error(_) => flush()
            end
        end };

pub witness monad_reader : Monad(Reader) {
    pure(A, x) = pure(@A, x),
    bind(A, B, m, f) = bind(@A, @B)(m, f)
}
