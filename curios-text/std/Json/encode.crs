use /std/{Str, Bool, Char, Flt, Option, List, Json};

let encode_num(n: Flt) -> Str =
    match Flt/is_finite(n)
    | false => "null"
    | true =>
        let raw = Flt/to_str(n);
        match Str/strip_prefix(raw, "+") | some(unsigned) => unsigned | none() => raw end
    end;

--- What a character is written as inside a string, when it is not written as itself: the quote, the backslash and the control characters, which JSON escapes.
let escaped(c: Char) -> Option(Str) =
    let n = Char/to_nat(c);
    match n
    | '"' => Option/some("\\\"")
    | '\\' => Option/some("\\\\")
    | '\n' => Option/some("\\n")
    | '\r' => Option/some("\\r")
    | '\t' => Option/some("\\t")
    | '\u{8}' => Option/some("\\b")
    | '\u{C}' => Option/some("\\f")
    | _ =>
        match n < 0x20
        | true =>
            Option/some(
                Str/flatten([
                    "\\u00",
                    Str/of_char(Char/hex_digit(n / 0x10)),
                    Str/of_char(Char/hex_digit(n % 0x10))]))
        | false => Option/none()
        end
    end;

let encode_str(s: Str) -> Str =
    Str/flatten(["\"", Str/escape(s, escaped), "\""]);

--- `v` as a document on one line. A non-finite number is written as `null`.
pub let encode(v: Json) -> Str =
    match v
    | null() => "null"
    | bool(b) => Bool/to_str(b)
    | num(n) => encode_num(n)
    | str(s) => encode_str(s)
    | arr(xs) => Str/concat(Str/concat("[", Str/join(",", List/map(xs, encode))), "]")
    | obj(ps) =>
        Str/concat(
            Str/concat(
                "{",
                Str/join(
                    ",",
                    List/map(ps, (pair: {Str, Json}) =>
                        Str/concat(Str/concat(encode_str(pair.0), ":"), encode(pair.1))))),
            "}")
    end;
