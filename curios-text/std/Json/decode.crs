use /std/{Bytes, Byte, Str, Bool, Char, Flt, Nat, Parse, Option, List};
use /std/Json/{Json};

let is_num_byte(byte: Byte) -> Bool =
    match Byte/to_nat(byte)
    | 45 => true
    | 43 => true
    | 46 => true
    | 101 => true
    | 69 => true
    | _ => Nat/in_range(Byte/to_nat(byte), 0x30, 0x39)
    end;

let parse_null: Parse(Bytes, Json) =
    Parse/map(Parse/bytes/literal("null"), (_) => Json/null());

let parse_true_val: Parse(Bytes, Json) =
    Parse/map(Parse/bytes/literal("true"), (_) => Json/bool(true));

let parse_false_val: Parse(Bytes, Json) =
    Parse/map(Parse/bytes/literal("false"), (_) => Json/bool(false));

let parse_num: Parse(Bytes, Json) =
    let chunk = Parse/bytes/take_while(is_num_byte)!;
    match Flt/of_str(Option/unwrap_or(Str/of_bytes(chunk), ""))
    | some(value) => Parse/pure(Json/num(value))
    | none() => Parse/fail("expected number")
    end;

--- Whether `byte` may stand in a string as written: any but the quote, the backslash and the control characters below `0x20`, which the grammar has escaped.
let is_unescaped(byte: Byte) -> Bool =
    match Byte/to_nat(byte) | 34 => false | 92 => false | _ => Byte/to_nat(byte) >= 0x20 end;

let hex_digit: Parse(Bytes, Nat) =
    let byte = Parse/bytes/byte!;
    match Option/bind(Char/of_ascii(byte), Char/of_hex_digit)
    | some(v) => Parse/pure(v)
    | none() => Parse/fail("invalid hex digit")
    end;

let hex4: Parse(Bytes, Nat) =
    let a = hex_digit!;
    let b = hex_digit!;
    let c = hex_digit!;
    let d = hex_digit!;
    Parse/pure(a * 0x1000 + b * 0x100 + c * 0x10 + d);

--- `code` as its UTF-8 bytes, declining a value that is no Unicode scalar.
let scalar_utf8(code: Nat) -> Parse(Bytes, Bytes) =
    match Char/of_nat(code)
    | some(c) => Parse/pure(Char/to_utf8(c))
    | none() => Parse/fail("invalid Unicode scalar")
    end;

let parse_unicode: Parse(Bytes, Bytes) =
    let hi = hex4!;
    match hi >= 0xD800 && hi <= 0xDBFF
    | false => scalar_utf8(hi)
    | true =>
        let _ = Parse/label(Parse/bytes/expect(0x5C), "expected low surrogate")!;
        let _ = Parse/label(Parse/bytes/expect(0x75), "expected low surrogate")!;
        let lo = hex4!;
        match lo >= 0xDC00 && lo <= 0xDFFF
        | true => scalar_utf8(0x10000 + (hi - 0xD800) * 0x400 + (lo - 0xDC00))
        | false => Parse/fail("invalid low surrogate")
        end
    end;

let escape_fields: Parse(Bytes, Bytes) =
    let byte = Parse/bytes/byte!;
    match Byte/to_nat(byte)
    | 34 => Parse/pure(Str/to_bytes("\""))
    | 92 => Parse/pure(Str/to_bytes("\\"))
    | 47 => Parse/pure(Str/to_bytes("/"))
    | 98 => Parse/pure(x[0x8])
    | 102 => Parse/pure(x[0xC])
    | 110 => Parse/pure(Str/to_bytes("\n"))
    | 114 => Parse/pure(Str/to_bytes("\r"))
    | 116 => Parse/pure(Str/to_bytes("\t"))
    | 117 => parse_unicode
    | _ => Parse/fail("unknown escape")
    end;

let parse_str_escape: Parse(Bytes, Bytes) =
    let _ = Parse/bytes/expect(0x5C)!;
    Parse/commit(escape_fields);

let parse_str_segment: Parse(Bytes, Bytes) =
    Parse/bytes/take_while(is_unescaped);

--- A raw control character, refused where it stands: declining here would end the string's body, and the report would name the closing quote the string never reached.
let parse_str_control: Parse(Bytes, Bytes) =
    let next = Parse/bytes/peek!;
    match next
    | some(byte) =>
        match Byte/to_nat(byte) < 0x20
        | true => Parse/commit(Parse/fail("unescaped control character"))
        | false => Parse/fail("no control character")
        end
    | none() => Parse/fail("no control character")
    end;

let parse_str_body: Parse(Bytes, List(Bytes)) =
    Parse/many0(Parse/or(parse_str_escape, Parse/or(parse_str_control, parse_str_segment)));

let parse_raw_str: Parse(Bytes, Str) =
    let _ = Parse/bytes/expect(0x22)!;
    let chunks = parse_str_body!;
    let _ = Parse/bytes/expect(0x22)!;
    match Str/of_bytes(Bytes/flatten(chunks))
    | some(s) => Parse/pure(s)
    | none() => Parse/fail("invalid UTF-8 in string")
    end;

let parse_str_value: Parse(Bytes, Json) =
    Parse/map(parse_raw_str, (s) => Json/str(s));

let is_ws(byte: Byte) -> Bool =
    match Byte/to_nat(byte)
    | 32 => true
    | 9 => true
    | 10 => true
    | 13 => true
    | _ => false
    end;

let ws: Parse(Bytes, {}) =
    Parse/map(Parse/bytes/take_while(is_ws), (_) => ());

let symbol(b: Byte) -> Parse(Bytes, Byte) =
    let _ = ws!;
    Parse/bytes/expect(b);

let after_comma(@A: Type, elem: Parse(Bytes, A)) -> Parse(Bytes, A) =
    let _ = symbol(0x2C)!;
    Parse/commit(elem);

let elements(@A: Type, elem: Parse(Bytes, A)) -> Parse(Bytes, List(A)) =
    Parse/bind(elem, (first) =>
        Parse/map(Parse/many0(after_comma(elem)), (rest) => [first, ..rest]));

let bracketed(
    @A: Type,
    open: Byte,
    elem: Parse(Bytes, A),
    close: Byte,
    after: Str,
) -> Parse(Bytes, List(A)) =
    let _ = symbol(open)!;
    let _ = ws!;
    let byte = Parse/bytes/peek_byte!;
    match byte == close
    | true => Parse/map(Parse/bytes/byte, (_) => [])
    | false =>
        let elems = Parse/commit(elements(elem))!;
        let _ = Parse/label(symbol(close), after)!;
        Parse/pure(elems)
    end;

let is_num_start(byte: Byte) -> Bool =
    match Byte/to_nat(byte) | 45 => true | _ => Nat/in_range(Byte/to_nat(byte), 0x30, 0x39) end;

let value: Parse(Bytes, Json) =
    let _ = ws!;
    let byte = Parse/bytes/peek_byte!;
    match Byte/to_nat(byte)
    | 110 => parse_null
    | 116 => parse_true_val
    | 102 => parse_false_val
    | 34 => parse_str_value
    | 91 => parse_arr
    | 123 => parse_obj
    | _ => match is_num_start(byte) | true => parse_num | false => Parse/fail("expected value") end
    end
and parse_arr: Parse(Bytes, Json) =
    Parse/map(bracketed(0x5B, value, 0x5D, "expected ',' or ']'"), (elems) => Json/arr(elems))
and parse_obj: Parse(Bytes, Json) =
    Parse/map(bracketed(0x7B, parse_pair, 0x7D, "expected ',' or '}'"), (pairs) => Json/obj(pairs))
and parse_pair: Parse(Bytes, {Str, Json}) =
    let _ = ws!;
    let key = parse_raw_str!;
    Parse/commit(member_value(key))
and member_value(key: Str) -> Parse(Bytes, {Str, Json}) =
    let _ = symbol(0x3A)!;
    let val = value!;
    Parse/pure((key, val));

--- A whole document, surrounding whitespace included; anything after the value is refused.
pub let decode: Parse(Bytes, Json) =
    let parsed = value!;
    let _ = ws!;
    let _ = Parse/eof()!;
    Parse/pure(parsed);
