use /std/{Option, Lst};

-- The concept lives in `/syn` — the `!` operator desugars to
-- `/syn/Monad/bind`, so it must be resolvable without imports — and this
-- module is the user-facing facade (the `std/Eql.crs` pattern). Witnesses
-- stay in `/std`: here for the pervasive containers, and in `Task.crs` /
-- `Parse.crs` / `Reader.crs` beside those monads.
pub use /syn/{Monad};
pub use /syn/Monad/{pure, bind};

-- Witness fields bind every binder of the field's declared type, implicit
-- type binders included — lambdas carry no plicities, so the spelled-out
-- shape is the one that checks.
pub witness monad_option : Monad(Option) {
    pure(A, x) = Option/some(x),
    bind(A, B, m, f) =
        match m
        | some(a) => f(a)
        | none() => Option/none()
        end
}

pub witness monad_lst : Monad(Lst) {
    pure(A, x) = Lst/cons(x, Lst/nil()),
    bind(A, B, m, f) =
        rec go(rest : Lst(A)) -> Lst(B) =
            match rest
            | nil() => Lst/nil()
            | cons(x, tail) => Lst/append(f(x), go(tail))
            end;
        go(m)
}
