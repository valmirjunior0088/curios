pub use /sys/{Bin};
pub use /sys/Bin/{len, eql, slice, append, concat};
use /std/{Lst, Nat, Bln, Option, Eq};

pub let at(b : Bin, i : Nat, ok : Nat/Lt(i, len(b))) -> Nat =
    /sys/Bin/get(b, i);

pub let get(b : Bin, i : Nat) -> Option(Nat) =
    match i < len(b)
    | true => Option/some(/sys/Bin/get(b, i))
    | false => Option/none()
    end;

pub let cons(head : Nat, tail : Bin) -> Bin =
    \..append(\\, head)\..tail;

pub let flatten(parts : Lst(Bin)) -> Bin =
    Lst/fold(parts, \\, (b, acc) => \..acc\..b);

pub let fold(@A : Type, b : Bin, init : A, f : (Nat, A) -> A) -> A =
    let n = len(b);
    rec go(k : Nat, i : Nat, acc : A, inv : Eq(i + k, n)) -> A =
        match k
        | 0 => acc
        | kp + 1; ih =>
            go(kp, i + 1,
                f(at(b, i, Eq/subst((x) => Nat/Lt(i, x), inv, Nat/lte_to_lt_succ(Nat/lte_add_r(i, kp)))), acc),
                inv)
        end;
    go(n, 0, init, Eq/refl());

pub let find_index(b : Bin, pred : (Nat) -> Bln) -> Option(Nat) =
    let (_, found) : {Nat, Option(Nat)} =
        fold(b, (0, Option/none()), (byte, (i, found)) =>
            match found
            | some(_) => (i, found)
            | none() =>
                (i + 1,
                    match pred(byte)
                    | true => Option/some(i)
                    | false => Option/none()
                    end)
            end);
    found;

pub let join(sep : Bin, parts : Lst(Bin)) -> Bin =
    Lst/balanced(Lst/len(parts), \\, (i) => Option/unwrap_or(Lst/get(parts, i), \\),
        (l, r) => \..l\..sep\..r);
