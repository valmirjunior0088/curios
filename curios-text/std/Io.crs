pub use /sys/{Io};
pub use /sys/Io/{stdin, stdout, stderr};
use /std/{Bin, Str, Nat, Option, Result, Lst};

pub induct Error : Type
| not_found()
| permission_denied()
| exists()
| refused()
| tls()
| would_block()
| other(Nat)
end

let errors : Lst({Nat, Error}) =
    [
        (/sys/Io/Status/not_found, Error/not_found()),
        (/sys/Io/Status/permission_denied, Error/permission_denied()),
        (/sys/Io/Status/exists, Error/exists()),
        (/sys/Io/Status/refused, Error/refused()),
        (/sys/Io/Status/tls, Error/tls()),
        (/sys/Io/Status/would_block, Error/would_block())
    ];

pub let error_of(status : Nat) -> Error =
    Lst/fold(errors, Error/other(status), (entry, acc) =>
        match status == entry.0 : Error
        | true => entry.1
        | false => acc
        end);

pub induct Mode : Type
| read()
| write()
| append()
end

pub let of_mode(mode : Mode) -> Nat =
    match mode : Nat
    | read() => /sys/Io/Mode/read
    | write() => /sys/Io/Mode/write
    | append() => /sys/Io/Mode/append
    end;

pub induct Read : Type
| chunk(Bin)
| eof()
| error(Error)
end

pub let read(h : Io, n : Nat) -> Read =
    let r = /sys/Io/read(h, n);
    match r.status == /sys/Io/Status/ok : Read
    | true => Read/chunk(r.bytes)
    | false =>
        match r.status == /sys/Io/Status/eof : Read
        | true => Read/eof()
        | false => Read/error(error_of(r.status))
        end
    end;

pub rec write(h : Io, b : Bin) -> Result({}, Error) =
    let r = /sys/Io/write(h, b);
    match r.status == /sys/Io/Status/ok : Result({}, Error)
    | true =>
        match r.written < Bin/len(b) : Result({}, Error)
        | true => write(h, Bin/slice(b, r.written, Bin/len(b)))
        | false => Result/success(())
        end
    | false => Result/failure(error_of(r.status))
    end;

pub let print(s : Str) -> {} =
    let _ = write(stdout, Str/to_bin(s));
    ();

pub let print_err(s : Str) -> {} =
    let _ = write(stderr, Str/to_bin(s));
    ();

pub let input() -> Option(Bin) =
    rec go(acc : Bin) -> Option(Bin) =
        let r = /sys/Io/read(stdin, 1);
        match r.status == /sys/Io/Status/ok : Option(Bin)
        | false =>
            match Bin/len(acc) == 0 : Option(Bin)
            | true => Option/none()
            | false => Option/some(acc)
            end
        | true =>
            match Option/unwrap_or(Bin/get(r.bytes, 0), 0) == '\n' : Option(Bin)
            | true => Option/some(acc)
            | false => go(Bin/concat(acc, r.bytes))
            end
        end;
    go(\\);
