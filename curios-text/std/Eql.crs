pub use /syn/{Eql};
pub use /syn/Eql/{eql};
use /std/{Nat, Byte, Int, Flt, Bln, Bits, Bytes, Str, BigNat, BigInt};

satisfy Eql(Nat) {
    eql(a, b) = Nat/eql(a, b)
}

satisfy Eql(Byte) {
    eql(a, b) = Byte/eql(a, b)
}

satisfy Eql(Int) {
    eql(a, b) = Int/eql(a, b)
}

satisfy Eql(Flt) {
    eql(a, b) = Flt/eql(a, b)
}

satisfy Eql(Bln) {
    eql(a, b) = Bln/eql(a, b)
}

satisfy Eql(Bits) {
    eql(a, b) = Bits/eql(a, b)
}

satisfy Eql(Bytes) {
    eql(a, b) = Bytes/eql(a, b)
}

satisfy Eql(Str) {
    eql(a, b) = Str/eql(a, b)
}

satisfy Eql(BigNat) {
    eql(a, b) = BigNat/eql(a, b)
}

satisfy Eql(BigInt) {
    eql(a, b) = BigInt/eql(a, b)
}
