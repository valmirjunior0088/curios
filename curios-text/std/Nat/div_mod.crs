use /std/{Nat, Eq};
use /std/Bool/{True, Holds};

--- `n` divided by `d`: the quotient and remainder, with Euclid's identity and the remainder's bound beside them.
pub struct DivMod(n: Nat, d: Nat): pub Type {
    --- How many whole `d`s `n` holds.
    quotient: Nat,
    --- What is left over.
    remainder: Nat,
    --- `n` is the quotient's multiple of `d` and the remainder.
    joined: Eq()(n, quotient * d + remainder),
    --- The remainder is below `d`.
    bounded: Holds(remainder < d),
}

--- Division with remainder, certified: the quotient and remainder `/` and `%` compute, with their equation and bound.
---
--- Both proofs are the reducer's own: Euclid's identity recombines the quotient and remainder into `n`, and a remainder sits below its divisor by definition.
pub let div_mod(n: Nat, d: Nat, @ok: Holds(0 < d)) -> DivMod(n, d) =
    DivMod {
        quotient = Nat/div(n, d, @ok),
        remainder = Nat/rem(n, d, @ok),
        joined = Eq/refl(),
        bounded = True/qed(),
    };

--- `m * d <= n` gives `m <= n / d`: the quotient is the largest multiplier that fits.
---
--- A quotient below `m` would put `n` under `(n / d + 1) * d`, which the quotient's own bound puts above `n` — a product of the negated bound with `0 <= d`, which the elaborator proves from the facts in scope.
pub let le_div_of_mul_le(
    m: Nat,
    n: Nat,
    d: Nat,
    @ok: Holds(0 < d),
    p: Holds(m * d <= n),
) -> Holds(m <= Nat/div(n, d, @ok)) =
    True/proved();

--- `n < m * d` gives `n / d < m`: a quotient of at least `m` would scale past `n`, since the quotient's multiple of `d` is at most `n` — a product the elaborator proves from the facts in scope.
pub let div_lt_of_lt_mul(
    m: Nat,
    n: Nat,
    d: Nat,
    @ok: Holds(0 < d),
    p: Holds(n < m * d),
) -> Holds(Nat/div(n, d, @ok) < m) =
    True/proved();
