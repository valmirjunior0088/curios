pub use /sys/{Flt};
pub use /sys/Flt/{add, sub, mul, div, rem, min, max, eql, neq, lt, gt, lte, gte, neg, abs, sqrt, floor, ceil, trunc, nearest, to_nat, to_int, to_le_bin};
use /std/{Nat, Int, Str, Bln, Option, Bin, Lst, Order, BigNat};

let pow2(k : Nat) -> BigNat =
    BigNat/mul_pow2(BigNat/of_nat(1), k);

rec divmod(r : BigNat, s : BigNat, d : Nat) -> {Nat, BigNat} =
    match BigNat/lt(r, s)
    | true => (d, r)
    | false => divmod(BigNat/sub(r, s), s, d + 1)
    end;

rec scale_up(rpm : BigNat, s : BigNat, k : Int) -> {BigNat, Int} =
    match BigNat/gt(rpm, s)
    | true => scale_up(rpm, BigNat/mul_small(s, 10), k + 1)
    | false => (s, k)
    end;

rec scale_down(r : BigNat, mp : BigNat, mm : BigNat, s : BigNat, k : Int) -> {BigNat, BigNat, BigNat, Int} =
    match BigNat/lte(BigNat/mul_small(BigNat/add(r, mp), 10), s)
    | true =>
        scale_down(
            BigNat/mul_small(r, 10),
            BigNat/mul_small(mp, 10),
            BigNat/mul_small(mm, 10),
            s,
            k - 1)
    | false => (r, mp, mm, k)
    end;

rec generate(r : BigNat, s : BigNat, mp : BigNat, mm : BigNat, even : Bln) -> Lst(Nat) =
    let r10 = BigNat/mul_small(r, 10);
    let mp10 = BigNat/mul_small(mp, 10);
    let mm10 = BigNat/mul_small(mm, 10);
    let dr = divmod(r10, s, 0);
    let d = dr.0;
    let rem = dr.1;
    let low =
        match even
        | true => BigNat/lte(rem, mm10)
        | false => BigNat/lt(rem, mm10)
        end;
    let high =
        match even
        | true => BigNat/gte(BigNat/add(rem, mp10), s)
        | false => BigNat/gt(BigNat/add(rem, mp10), s)
        end;
    match low || high
    | false => Lst/cons(d, generate(rem, s, mp10, mm10, even))
    | true =>
        let last =
            match low
            | false => d + 1
            | true =>
                match high
                | false => d
                | true =>
                    match BigNat/lt(BigNat/mul_small(rem, 2), s)
                    | true => d
                    | false => d + 1
                    end
                end
            end;
        Lst/cons(last, Lst/nil())
    end;

rec digits_to_str(ds : Lst(Nat)) -> Str =
    match ds
    | nil() => ""
    | cons(h, t) => Str/concat(Nat/to_str(h), digits_to_str(t))
    end;

rec normalize(ds : Lst(Nat)) -> {Lst(Nat), Bln} =
    match ds
    | nil() => (Lst/nil(), false)
    | cons(h, t) =>
        match t
        | nil() =>
            match h == 10
            | true => (Lst/cons(0, Lst/nil()), true)
            | false => (Lst/cons(h, Lst/nil()), false)
            end
        | cons(_, _) =>
            let rest = normalize(t);
            match rest.1
            | false => (Lst/cons(h, rest.0), false)
            | true =>
                match h == 9
                | true => (Lst/cons(0, rest.0), true)
                | false => (Lst/cons(h + 1, rest.0), false)
                end
            end
        end
    end;

let setup(f_mant : Nat, exp_field : Nat) -> {BigNat, BigNat, BigNat, BigNat} =
    match exp_field >= 150
    | true =>
        let ep = exp_field - 150;
        match f_mant == 0x800000
        | false =>
            (BigNat/mul_pow2(BigNat/of_nat(f_mant), ep + 1),
             BigNat/of_nat(2),
             pow2(ep),
             pow2(ep))
        | true =>
            (BigNat/mul_pow2(BigNat/of_nat(f_mant), ep + 2),
             BigNat/of_nat(4),
             pow2(ep + 1),
             pow2(ep))
        end
    | false =>
        let abs_e = 150 - Nat/max(exp_field, 1);
        match exp_field < 2 || Bln/not(f_mant == 0x800000)
        | true =>
            (BigNat/mul_small(BigNat/of_nat(f_mant), 2),
             pow2(abs_e + 1),
             BigNat/of_nat(1),
             BigNat/of_nat(1))
        | false =>
            (BigNat/mul_small(BigNat/of_nat(f_mant), 4),
             pow2(abs_e + 2),
             BigNat/of_nat(2),
             BigNat/of_nat(1))
        end
    end;

let layout(digits_str : Str, k : Int) -> Str =
    let len = Str/len(digits_str);
    match k <= 0
    | true => Str/concat(Str/concat("0.", Str/repeat("0", Int/abs(k))), digits_str)
    | false =>
        let kn = Int/to_nat(k);
        match kn < len
        | true =>
            Str/concat(
                Str/concat(Str/slice(digits_str, 0, kn), "."),
                Str/slice(digits_str, kn, len))
        | false => Str/concat(digits_str, Str/repeat("0", kn - len))
        end
    end;

let render(f_mant : Nat, exp_field : Nat, even : Bln) -> Str =
    let init = setup(f_mant, exp_field);
    let r0 = init.0;
    let s0 = init.1;
    let mp0 = init.2;
    let mm0 = init.3;
    let up = scale_up(BigNat/add(r0, mp0), s0, +0);
    let s1 = up.0;
    let k1 = up.1;
    let down = scale_down(r0, mp0, mm0, s1, k1);
    let digits = generate(down.0, s1, down.1, down.2, even);
    let norm = normalize(digits);
    match norm.1
    | true => layout(digits_to_str(Lst/cons(1, norm.0)), down.3 + 1)
    | false => layout(digits_to_str(norm.0), down.3)
    end;

pub let to_str(f : Flt) -> Str =
    let b = Flt/to_le_bin(f);
    let b0 = Option/unwrap_or(Bin/get(b, 0), 0);
    let b1 = Option/unwrap_or(Bin/get(b, 1), 0);
    let b2 = Option/unwrap_or(Bin/get(b, 2), 0);
    let b3 = Option/unwrap_or(Bin/get(b, 3), 0);
    let exp_field = b3 % 0x80 * 2 + b2 / 0x80;
    let mant_field = b2 % 0x80 * 0x10000 + b1 * 0x100 + b0;
    let sign =
        match b3 >= 0x80
        | true => "-"
        | false => "+"
        end;
    match exp_field == 0xFF
    | true =>
        match mant_field == 0
        | true => Str/concat(sign, "inf")
        | false => "NaN"
        end
    | false =>
        match exp_field == 0 && mant_field == 0
        | true => Str/concat(sign, "0")
        | false =>
            let f_mant =
                match exp_field == 0
                | true => mant_field
                | false => mant_field + 0x800000
                end;
            let even = f_mant % 2 == 0;
            Str/concat(sign, render(f_mant, exp_field, even))
        end
    end;

let pow10(n : Nat) -> Flt =
    match n
    | 0 => +1.0
    | pred + 1; ih => ih * 10.0
    end;

let digits_or_zero(s : Str) -> Option(Nat) =
    match Str/len(s) == 0
    | true => Option/some(0)
    | false => Nat/of_str(s)
    end;

let exp_factor(exp_int : Int) -> Flt =
    match exp_int >= 0
    | true => pow10(Int/to_nat(exp_int))
    | false => 1.0 / pow10(Int/abs(exp_int))
    end;

let exp_factor_of(s : Str, e_pos : Nat, len : Nat) -> Option(Flt) =
    match e_pos < len
    | false => Option/some(+1.0)
    | true => Option/map(exp_factor, Int/of_str(Str/slice(s, e_pos + 1, len)))
    end;

pub let of_str(s : Str) -> Option(Flt) =
    let ! = Option/bind;
    match Str/len(s) == 0
    | true => Option/none()
    | false =>
        let first = Str/get(s, 0)!;
        let is_neg = first == '-';
        let start =
            match first
            | '+' => 1
            | '-' => 1
            | _ => 0
            end;
        let len = Str/len(s);
        let dot_pos = Option/unwrap_or(Str/find(s, '.'), len);
        let e_pos = Nat/min(
            Option/unwrap_or(Str/find(s, 'e'), len),
            Option/unwrap_or(Str/find(s, 'E'), len));
        let int_end = Nat/min(dot_pos, e_pos);
        let int_slice = Str/slice(s, start, int_end);
        let frac_slice =
            match dot_pos < e_pos
            | true => Str/slice(s, dot_pos + 1, e_pos)
            | false => ""
            end;
        match Str/len(int_slice) > 0 || Str/len(frac_slice) > 0
        | false => Option/none()
        | true =>
            let int_val = digits_or_zero(int_slice)!;
            let frac_val = digits_or_zero(frac_slice)!;
            let factor = exp_factor_of(s, e_pos, len)!;
            let mantissa =
                Nat/to_flt(int_val) + Nat/to_flt(frac_val) / pow10(Str/len(frac_slice));
            let result = mantissa * factor;
            match is_neg
            | true => Option/some(Flt/neg(result))
            | false => Option/some(result)
            end
        end
    end;
