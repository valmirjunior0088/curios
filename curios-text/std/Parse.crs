use /std/{Result, Nat, Bytes, Str, List, Option, Monad};

--- Why a parser refused, and where.
pub mod Error;
pub use Error/{let Error};

--- Parsers over bytes: the carrier whose positions lie within the input, and the primitives that read bytes.
pub mod bytes;

--- Parsers over text: the carrier whose positions are boundaries of valid text, and the primitives that read characters and pieces of the input.
pub mod text;

--- What a parser asks of the carrier it reads: what a position in its bytes knows, the bytes it walks, and that the start is such a position. Sealed: `Bytes` and `Str` are the carriers, each witnessed beside its primitives.
pub concept Input(I: Type): Type {
    --- That the carrier admits `offset` as a position in `input`.
    Admits(Bytes, Nat) -> Prop,
    --- The bytes a parser walks.
    bytes(I) -> Bytes,
    --- Why the start is a position.
    start(i: I) -> Admits(bytes(i), 0),
}

--- A position a parser may stand at in `input`: an offset, and what `P` knows of the input there, erased.
pub struct At(P: (Bytes, Nat) -> Prop, input: Bytes): Type {
    offset: Nat,
    holds: P(input, offset),
}

--- A parser reading an `I`, whose positions know `P`: from a position in the input to a position and a value, or a refusal. Every position it hands on carries `P`, so a primitive reads what its carrier's positions know rather than checking it again. `Parse(I, A)` names it by its carrier alone, which is the spelling everything but a primitive uses.
pub struct Of(I: Type, P: (Bytes, Nat) -> Prop, A: Type): Type {
    run(input: Bytes, at: At(P, input)) -> Result(Error, {At(P, input), A}),
}

--- A parser reading an `I` into an `A` — `Parse(Bytes, A)` over bytes, `Parse(Str, A)` over text. The combinators below are written once for both.
pub let Parse(I: Type, use Input(I), A: Type) -> Type =
    Of(I, (input: Bytes, offset: Nat) => Input/Admits(@I, input, offset), A);

--- A position a parser reading an `I` may stand at in `input`.
pub let Pos(I: Type, use Input(I), input: Bytes) -> Type =
    At((input: Bytes, offset: Nat) => Input/Admits(@I, input, offset), input);

--- `p` from the start of `input`: its value, or the refusal that stopped it, at a byte offset into the input's bytes. A parser that stops early still succeeds, so a parser that must consume everything ends with `eof()`.
pub let run(@I: Type, use Input(I), @A: Type, p: Parse(I, A), input: I) -> Result(Error, A) =
    match p.run(Input/bytes(input), At { offset = 0, holds = Input/start(input) })
    | success((_, a)) => Result/success(a)
    | failure(refusal) => Result/failure(refusal)
    end;

--- `a`, consuming nothing, at any carrier's positions: what `pure` and the `Monad` witness share.
let unit(@I: Type, @P: (Bytes, Nat) -> Prop, @A: Type, a: A) -> Of(I, P, A) =
    Of { run(_, at) = Result/success((at, a)) };

--- `p`, then `f` on its value from where it stopped, at any carrier's positions: what `bind` and the `Monad` witness share.
let chain(
    @I: Type,
    @P: (Bytes, Nat) -> Prop,
    @A: Type,
    @B: Type,
    p: Of(I, P, A),
    f: (A) -> Of(I, P, B),
) -> Of(I, P, B) =
    Of {
        run(input, at) =
            match p.run(input, at)
            | success((next, a)) => f(a).run(input, next)
            | failure(refusal) => Result/failure(refusal)
            end,
    };

--- `a`, consuming nothing.
pub let pure(@I: Type, use Input(I), @A: Type, a: A) -> Parse(I, A) =
    unit(a);

--- Decline with `msg`, consuming nothing.
pub let fail(@I: Type, use Input(I), @A: Type, msg: Str) -> Parse(I, A) =
    Of { run(_, at) = Result/failure(Error/declined(msg, at.offset)) };

--- `f` on the value.
pub let map(
    @I: Type,
    use Input(I),
    @A: Type,
    @B: Type,
    p: Parse(I, A),
    f: (A) -> B,
) -> Parse(I, B) =
    Of {
        run(input, at) =
            match p.run(input, at)
            | success((next, a)) => Result/success((next, f(a)))
            | failure(refusal) => Result/failure(refusal)
            end,
    };

--- `p`, then `f` on its value from where it stopped.
pub let bind(
    @I: Type,
    use Input(I),
    @A: Type,
    @B: Type,
    p: Parse(I, A),
    f: (A) -> Parse(I, B),
) -> Parse(I, B) =
    chain(p, f);

--- `p`, or `q` from the same position when `p` declines. A committed refusal is reported as it is; when both decline, the refusal that reached further is reported, since that alternative read more of the input as its shape.
pub let or(@I: Type, use Input(I), @A: Type, p: Parse(I, A), q: Parse(I, A)) -> Parse(I, A) =
    Of {
        run(input, at) =
            match p.run(input, at)
            | success(pair) => Result/success(pair)
            | failure(e) =>
                match e.committed
                | true => Result/failure(e)
                | false =>
                    match q.run(input, at)
                    | success(pair) => Result/success(pair)
                    | failure(f) =>
                        match f.committed
                        | true => Result/failure(f)
                        | false => Result/failure(Error/further(e, f))
                        end
                    end
                end
            end,
    };

--- `p` as the shape the input has been recognized to have: a refusal inside it is committed, so an enclosing `or` reports it rather than trying an alternative.
pub let commit(@I: Type, use Input(I), @A: Type, p: Parse(I, A)) -> Parse(I, A) =
    Of {
        run(input, at) =
            match p.run(input, at)
            | success(pair) => Result/success(pair)
            | failure(refusal) => Result/failure(Error/commit(refusal))
            end,
    };

--- `p`, declining with `msg` where it started in place of its own reason. A committed refusal is reported as it is.
pub let label(@I: Type, use Input(I), @A: Type, p: Parse(I, A), msg: Str) -> Parse(I, A) =
    Of {
        run(input, at) =
            match p.run(input, at)
            | success(pair) => Result/success(pair)
            | failure(e) =>
                match e.committed
                | true => Result/failure(e)
                | false => Result/failure(Error/declined(msg, at.offset))
                end
            end,
    };

--- `p`'s value, or `none` when it declines, consuming nothing then.
pub let optional(@I: Type, use Input(I), @A: Type, p: Parse(I, A)) -> Parse(I, Option(A)) =
    or(map(p, (a) => Option/some(a)), pure(Option/none()));

--- `p` then `q`, their values paired.
pub let and(
    @I: Type,
    use Input(I),
    @A: Type,
    @B: Type,
    p: Parse(I, A),
    q: Parse(I, B),
) -> Parse(I, {A, B}) =
    Of {
        run(input, at) =
            match p.run(input, at)
            | success((mid, a)) =>
                match q.run(input, mid)
                | success((next, b)) => Result/success((next, (a, b)))
                | failure(refusal) => Result/failure(refusal)
                end
            | failure(refusal) => Result/failure(refusal)
            end,
    };

--- `p` for its value alone: the position is left where `p` started.
pub let lookahead(@I: Type, use Input(I), @A: Type, p: Parse(I, A)) -> Parse(I, A) =
    Of {
        run(input, at) =
            match p.run(input, at)
            | success((_, a)) => Result/success((at, a))
            | failure(refusal) => Result/failure(refusal)
            end,
    };

--- The end of the input; declines while anything remains.
pub let eof(@I: Type, use Input(I)) -> Parse(I, {}) =
    Of {
        run(input, at) =
            match at.offset < Bytes/len(input)
            | true => Result/failure(Error/declined("expected end of input", at.offset))
            | false => Result/success((at, ()))
            end,
    };

--- `p` repeated until it declines or consumes nothing, the values collected.
pub let many0(@I: Type, use Input(I), @A: Type, p: Parse(I, A)) -> Parse(I, List(A)) =
    Of {
        run(input, at) =
            let go(acc: List(A), cur: Pos(I, input)) -> Result(Error, {Pos(I, input), List(A)}) =
                match p.run(input, cur)
                | failure(e) =>
                    match e.committed
                    | false => Result/success((cur, acc))
                    | true => Result/failure(e)
                    end
                | success((next, a)) =>
                    match next.offset == cur.offset
                    | true => Result/success((cur, acc))
                    | false => go([..acc, a], next)
                    end
                end;
            go([], at),
    };

--- `elem` separated by `sep`, zero or more times, the elements collected. A declined element after a separator gives the separator back.
pub let sep_by0(
    @I: Type,
    use Input(I),
    @A: Type,
    @S: Type,
    elem: Parse(I, A),
    sep: Parse(I, S),
) -> Parse(I, List(A)) =
    Of {
        run(input, at) =
            match elem.run(input, at)
            | failure(e) =>
                match e.committed
                | false => Result/success((at, []))
                | true => Result/failure(e)
                end
            | success((first_end, first)) =>
                let go(
                    acc: List(A),
                    cur: Pos(I, input),
                ) -> Result(Error, {Pos(I, input), List(A)}) =
                    match sep.run(input, cur)
                    | failure(e) =>
                        match e.committed
                        | false => Result/success((cur, acc))
                        | true => Result/failure(e)
                        end
                    | success((sep_end, _)) =>
                        match elem.run(input, sep_end)
                        | failure(e) =>
                            match e.committed
                            | false => Result/success((cur, acc))
                            | true => Result/failure(e)
                            end
                        | success((next, x)) =>
                            match next.offset == cur.offset
                            | true => Result/success((cur, acc))
                            | false => go([..acc, x], next)
                            end
                        end
                    end;
                go([first], first_end)
            end,
    };

satisfy (@I: Type, @P: (Bytes, Nat) -> Prop) => Monad((A: Type) => Of(I, P, A)) {
    pure(a) = unit(a),
    bind(p, f) = chain(p, f),
}
