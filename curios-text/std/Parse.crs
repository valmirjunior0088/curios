use /std/{Result, Nat, Bin, Str, Bln, Lst, Monad};

-- A parser is nominal (not a bare function type) so it has a rigid head:
-- witness resolution keys on it (`Monad(Parse)`) and the elaborator can
-- infer `M := Parse` from an applied occurrence.
pub record Parse(A : Type) : Type {
    run(input : Bin, pos : Nat) -> Result({Nat, A}, Str)
}

pub let run(@A : Type, p : Parse(A), input : Bin) -> Result(A, Str) =
    match p.run(input, 0)
    | success(pair) => Result/success(pair.1)
    | failure(msg) => Result/failure(msg)
    end;

pub let pure(@A : Type, a : A) -> Parse(A) =
    Parse { run(input, pos) = Result/success((pos, a)) };

pub let fail(@A : Type, msg : Str) -> Parse(A) =
    Parse { run(input, pos) = Result/failure(msg) };

pub let map(@A : Type, @B : Type, f : (A) -> B, p : Parse(A)) -> Parse(B) =
    Parse {
        run(input, pos) =
            match p.run(input, pos)
            | success(pair) => Result/success((pair.0, f(pair.1)))
            | failure(msg) => Result/failure(msg)
            end
    };

pub let bind(@A : Type, @B : Type, p : Parse(A), f : (A) -> Parse(B)) -> Parse(B) =
    Parse {
        run(input, pos) =
            match p.run(input, pos)
            | success(pair) => f(pair.1).run(input, pair.0)
            | failure(msg) => Result/failure(msg)
            end
    };

pub let or(@A : Type, p : Parse(A), q : Parse(A)) -> Parse(A) =
    Parse {
        run(input, pos) =
            match p.run(input, pos)
            | success(pair) => Result/success(pair)
            | failure(_) => q.run(input, pos)
            end
    };

pub let and(@A : Type, @B : Type, p : Parse(A), q : Parse(B)) -> Parse({A, B}) =
    Parse {
        run(input, pos) =
            match p.run(input, pos)
            | success(rp) =>
                match q.run(input, rp.0)
                | success(sp) => Result/success((sp.0, (rp.1, sp.1)))
                | failure(msg) => Result/failure(msg)
                end
            | failure(msg) => Result/failure(msg)
            end
    };

pub let any_byte : Parse(Nat) =
    Parse {
        run(input, pos) =
            match Nat/try_lt(pos, Bin/len(input))
            | none() => Result/failure("unexpected end of input")
            | some(ok) => Result/success((pos + 1, Bin/at(input, pos, ok)))
            end
    };

pub let peek_byte : Parse(Nat) =
    Parse {
        run(input, pos) =
            match Nat/try_lt(pos, Bin/len(input))
            | none() => Result/failure("unexpected end of input")
            | some(ok) => Result/success((pos, Bin/at(input, pos, ok)))
            end
    };

pub let take_byte(expected : Nat) -> Parse(Nat) =
    Parse {
        run(input, pos) =
            match Nat/try_lt(pos, Bin/len(input))
            | none() => Result/failure("unexpected end of input")
            | some(ok) =>
                let byte = Bin/at(input, pos, ok);
                match byte == expected
                | true => Result/success((pos + 1, byte))
                | false => Result/failure("unexpected byte")
                end
            end
    };

pub let take_while(pred : (Nat) -> Bln) -> Parse(Bin) =
    Parse {
        run(input, pos) =
            let r =
                match Bin/len(input) - pos : {Nat, Bln}
                | 0 => (pos, false)
                | step + 1; ih =>
                    match ih.1
                    | true => ih
                    | false =>
                        match Nat/try_lt(ih.0, Bin/len(input))
                        | none() => (ih.0, true)
                        | some(ok) =>
                            match pred(Bin/at(input, ih.0, ok))
                            | true => (ih.0 + 1, false)
                            | false => (ih.0, true)
                            end
                        end
                    end
                end;
            Result/success((r.0, Bin/slice(input, pos, r.0)))
    };

pub let many0(@A : Type, p : Parse(A)) -> Parse(Lst(A)) =
    Parse {
        run(input, pos) =
            rec go(acc : Lst(A), cur : Nat) -> Result({Nat, Lst(A)}, Str) =
                match p.run(input, cur)
                | failure(_) => Result/success((cur, acc))
                | success(pair) =>
                    match pair.0 == cur
                    | true => Result/success((cur, acc))
                    | false => go(Lst/append(acc, pair.1), pair.0)
                    end
                end;
            go([], pos)
    };

pub let sep_by0(@A : Type, @S : Type, elem : Parse(A), sep : Parse(S)) -> Parse(Lst(A)) =
    Parse {
        run(input, pos) =
            match elem.run(input, pos)
            | failure(_) => Result/success((pos, []))
            | success(rp) =>
                rec go(acc : Lst(A), cur : Nat) -> Result({Nat, Lst(A)}, Str) =
                    match sep.run(input, cur)
                    | failure(_) => Result/success((cur, acc))
                    | success(sp) =>
                        match elem.run(input, sp.0)
                        | failure(_) => Result/success((cur, acc))
                        | success(tp) =>
                            match tp.0 == cur
                            | true => Result/success((cur, acc))
                            | false => go(Lst/append(acc, tp.1), tp.0)
                            end
                        end
                    end;
                go([rp.1], rp.0)
            end
    };

satisfy Monad(Parse) {
    pure(A, x) = pure(@A, x),
    bind(A, B, m, f) = bind(@A, @B, m, f)
}
