use /std/Str/{classify, Scan, step, scan_from, pending, concluded, advanced, begins_scalars_of,
    continues, classify_continues, step_of_continuing};
use /std/{Bool, Byte, Bytes, Char, Eq, Nat, Option, Str};
use /std/Bool/{True, False, Holds};

--- Whether a scan has come to rest between characters.
let at_lead(s: Scan) -> Bool =
    match s | lead() => true | _ => false end;

--- That `b`, read from the scan state `s`, lands back between characters: `Valid` from any state.
---
--- Decided, so it has no constructors to walk. A proof walks the bytes instead: `from(s, x[c, ..t])` *is* `from(step(c, s), t)`, so the evidence for the whole is already the evidence for the tail. A recursive call writes the tail it moves to, as `@t`, since inferring it from the evidence would take the whole.
pub let from(s: Scan, b: Bytes) -> Prop =
    Holds(at_lead(scan_from(s, b)));

--- That `b` is well-formed UTF-8, which is what `Str` carries.
---
--- Decided: reading `b` from the first byte lands back between characters, so a literal discharges it by running the scan.
pub let Valid(b: Bytes) -> Prop =
    from(Scan/lead(), b);

--- A scan at rest is at `lead`.
let lead_of(s: Scan, h: Holds(at_lead(s))) -> Eq()(s, Scan/lead()) =
    match s
    | lead() => Eq/refl()
    | cont(_, _, _) => match h end
    | bad() => match h end
    end;

--- Reading a concatenation is reading its halves in turn.
let append(
    s: Scan,
    a: Bytes,
    b: Bytes,
) -> Eq()(scan_from(s, x[..a, ..b]), scan_from(scan_from(s, a), b)) =
    match a | x[] => Eq/refl() | x[h, ..t] => append(step(h, s), t, b) end;

--- The procedure that decides whether `b` is well-formed from `s`: the evidence when it is, `none` otherwise.
pub let try(s: Scan, b: Bytes) -> Option(from(s, b)) =
    match at_lead(scan_from(s, b)): (r) => Option(Holds(r))
    | true => Option/some(True/qed())
    | false => Option/none()
    end;

--- Valid bytes concatenate to valid bytes.
pub let concat(@a: Bytes, @b: Bytes, va: Valid(a), vb: Valid(b)) -> Valid(x[..a, ..b]) =
    Eq/subst(
        (sc: Scan) => Holds(at_lead(sc)),
        Eq/sym(
            Eq/trans(
                append(Scan/lead(), a, b),
                Eq/cong((sc: Scan) => scan_from(sc, b), lead_of(scan_from(Scan/lead(), a), va)))),
        vb);

--- Nothing is valid from the bad state.
pub let from_bad(@x: Bytes, w: from(Scan/bad(), x)) -> False =
    match x
    | x[] => match w end
    | x[_, ..t] => from_bad(@t, w)
    end;

--- That a scan inside a character asks for continuation bytes: true of every state a scan reaches from `lead`.
let scan_continues(s: Scan) -> Bool =
    match s | lead() => true | cont(_, lo, hi) => 0x80 <= lo && hi <= 0xBF | bad() => true end;

--- Every step leaves a scan asking for continuation bytes, whatever it began in: a lead's range is `classify`'s, and a continuation's is `0x80..=0xBF` itself.
let step_continues(c: Byte, s: Scan) -> Holds(scan_continues(step(c, s))) =
    let n = Byte/to_nat(c);
    match s
    | bad() => True/qed()
    | lead() =>
        let asked = classify_continues(c);
        match classify(c)
        | ascii() => True/qed()
        | lead(_, _, _, _) => asked
        | bad() => True/qed()
        end
    | cont(rem, lo, hi) =>
        match Bool/not(Nat/in_range(n, lo, hi))
        | true => True/qed()
        | false => match rem == 1 | true => True/qed() | false => True/qed() end
        end
    end;

--- A character interrupted by a byte that continues none goes bad: the range it asks for lies inside `0x80..=0xBF`, which the byte is outside.
let interrupted(
    c: Byte,
    rem: Nat,
    lo: Nat,
    hi: Nat,
    h: Holds(scan_continues(Scan/cont(rem, lo, hi))),
    q: Holds(Bool/not(continues(c))),
) -> Eq()(step(c, Scan/cont(rem, lo, hi)), Scan/bad()) =
    let n = Byte/to_nat(c);
    match Nat/in_range(n, lo, hi)
    | false => Eq/refl()
    | true =>
        match 0x80 <= lo
        | false => match h end
        | true =>
            let continuing = Nat/le/to_in_range(n, 0x80, 0xBF, True/proved(), True/proved());
            match Nat/in_range(n, 0x80, 0xBF)
            | true => match q end
            | false => match continuing end
            end
        end
    end;

--- Self-synchronization, first half: bytes valid from `s` and cut where a character may begin are valid up to the cut. A scan reaching the cut inside a character meets either the end, where validity says it must have left, or a byte continuing none, which sends it bad.
let seam_before(
    s: Scan,
    h: Holds(scan_continues(s)),
    @b: Bytes,
    k: Nat,
    within: Holds(k <= Bytes/len(b)),
    at: Holds(Str/At/starts(Bytes/drop(b, k, @within))),
    d: from(s, b),
) -> from(s, Bytes/slice(b, 0, k, @within)) =
    match k
    | 0 =>
        match s
        | lead() => True/qed()
        | bad() => match from_bad(@b, d) end
        | cont(rem, lo, hi) =>
            match b
            | x[] => match d end
            | x[c, ..t] =>
                match from_bad(
                    @t,
                    Eq/subst((sc: Scan) => from(sc, t), interrupted(c, rem, lo, hi, h, at), d))
                end
            end
        end
    | j + 1 =>
        match b
        | x[] => match within end
        | x[c, ..t] => seam_before(step(c, s), step_continues(c, s), @t, j, within, at, d)
        end
    end;

--- Self-synchronization, second half: bytes valid from `s` and cut where a character may begin are valid from the cut, read from between characters.
let seam_after(
    s: Scan,
    h: Holds(scan_continues(s)),
    @b: Bytes,
    k: Nat,
    within: Holds(k <= Bytes/len(b)),
    at: Holds(Str/At/starts(Bytes/drop(b, k, @within))),
    d: from(s, b),
) -> Valid(Bytes/drop(b, k, @within)) =
    match k
    | 0 =>
        match s
        | lead() => d
        | bad() => match from_bad(@b, d) end
        | cont(rem, lo, hi) =>
            match b
            | x[] => match d end
            | x[c, ..t] =>
                match from_bad(
                    @t,
                    Eq/subst((sc: Scan) => from(sc, t), interrupted(c, rem, lo, hi, h, at), d))
                end
            end
        end
    | j + 1 =>
        match b
        | x[] => match within end
        | x[c, ..t] => seam_after(step(c, s), step_continues(c, s), @t, j, within, at, d)
        end
    end;

--- Valid bytes cut where a character may begin are valid before the cut.
pub let before(
    @b: Bytes,
    v: Valid(b),
    k: Nat,
    within: Holds(k <= Bytes/len(b)),
    at: Holds(Str/At/starts(Bytes/drop(b, k, @within))),
) -> Valid(Bytes/slice(b, 0, k, @within)) =
    seam_before(Scan/lead(), True/qed(), k, within, at, v);

--- Valid bytes cut where a character may begin are valid after the cut.
pub let after(
    @b: Bytes,
    v: Valid(b),
    k: Nat,
    within: Holds(k <= Bytes/len(b)),
    at: Holds(Str/At/starts(Bytes/drop(b, k, @within))),
) -> Valid(Bytes/drop(b, k, @within)) =
    seam_after(Scan/lead(), True/qed(), k, within, at, v);

--- Valid bytes begin where a character may: none starts with a byte continuing one.
pub let begins(@b: Bytes, v: Valid(b)) -> Holds(Str/At/starts(b)) =
    match b
    | x[] => True/qed()
    | x[c, ..t] =>
        match continues(c)
        | false => True/qed()
        | true =>
            match from_bad(
                @t,
                Eq/subst((sc: Scan) => from(sc, t), step_of_continuing(c, True/qed()), v))
            end
        end
    end;

--- The rest of a character owed `rem` continuation bytes, the next between `lo` and `hi`, over the bits `partial` has gathered: read off the bytes the evidence says follow, and ended at a scalar value because it can only end at one.
---
--- A walk over the evidence rather than over an offset: each arm is the scan's own step, specialized by its guard, so a byte out of range is the bad state that valid bytes never reach, and a character cut short is a scan left inside it at the end.
let finish(
    rem: Nat,
    lo: Nat,
    hi: Nat,
    partial: Nat,
    @t: Bytes,
    p: Holds(pending(rem, lo, hi, partial)),
    w: from(Scan/cont(rem, lo, hi), t),
) -> Char =
    match t
    | x[] => match w end
    | x[c, ..rest] =>
        match Nat/in_range(Byte/to_nat(c), lo, hi)
        | false => match from_bad(@rest, w) end
        | true =>
            match rem == 1
            | true =>
                let last =
                    Eq/subst(
                        (r: Nat) => Holds(pending(r, lo, hi, partial)),
                        Nat/eq_of_eql(rem, 1, True/qed()),
                        p);
                Char {
                    code = partial * 0x40 + (Byte/to_nat(c) - 0x80),
                    valid = concluded(lo, hi, partial, Byte/to_nat(c), last, True/qed()),
                }
            | false =>
                finish(
                    rem - 1,
                    0x80,
                    0xBF,
                    partial * 0x40 + (Byte/to_nat(c) - 0x80),
                    @rest,
                    advanced(rem, lo, hi, partial, Byte/to_nat(c), p, True/qed(), True/qed()),
                    w)
            end
        end
    end;

--- The first character of bytes valid from the first byte.
pub let decode_head(c: Byte, @t: Bytes, w: from(Scan/lead(), x[c, ..t])) -> Char =
    match classify(c)
    | ascii() => Char { code = Byte/to_nat(c), valid = True/qed() }
    | lead(rem, lo, hi, partial) => finish(rem, lo, hi, partial, @t, begins_scalars_of(c), w)
    | bad() => match from_bad(@t, w) end
    end;

--- A character's UTF-8 encoding is well-formed.
---
--- Walked by the guards `Char/to_utf8` chose its family by, so each arm's goal reduces to that family's bytes read through `classify`. What reduction cannot see is where a lead byte narrows its first continuation's range, and each such edge is one arm: `E0` floors it at `A0`, so a three-byte form cannot spell what two bytes hold; `ED` caps it at `9F`, which excludes the surrogates; `F0` floors it at `90`, lifting a four-byte value past `U+FFFF`; and `F4` caps it at `8F`, at `U+10FFFF`. The code point's own bounds settle each — its guards, and `c.valid` where the ceiling is the scalar values' — and every other byte's range reduction decides.
pub let encoded(c: Char) -> Valid(Char/to_utf8(c)) =
    match c.code < 0x80
    | true => True/qed()
    | false =>
        match c.code < 0x800
        -- `C2..=DF`: the lead byte's payload is at least `2`, since the code point is at least `0x80`, and below `0x20`.
        | true =>
            match c.code / 0x40 >= 2
            | false => match False/refuted() end
            | true =>
                match c.code / 0x40 <= 0x1F
                | true => True/qed()
                | false => match False/refuted() end
                end
            end
        | false =>
            match c.code < 0x10000
            -- `E0..=EF`, the lead byte's payload being below `0x10`.
            | true =>
                match c.code / 0x1000 <= 0xF
                | false => match False/refuted() end
                | true =>
                    match c.code / 0x1000 == 0
                    -- `E0`: the code point is at least `0x800` with nothing above its low twelve bits, so its next six are at least `0x20`.
                    | true =>
                        match c.code / 0x1000 == 0xD
                        | true => match False/refuted() end
                        | false =>
                            match c.code % 0x1000 / 0x40 >= 0x20
                            | true => True/qed()
                            | false => match False/refuted() end
                            end
                        end
                    | false =>
                        match c.code / 0x1000 == 0xD
                        -- `ED`: the code point is below `0xE000`, so validity puts it below the surrogates at `0xD800`, and its next six bits below `0x20`.
                        | true =>
                            match c.code % 0x1000 / 0x40 <= 0x1F
                            | true => True/qed()
                            | false =>
                                let high =
                                    Char/Valid/below_surrogates_of(c.code, c.valid, True/proved());
                                match False/refuted() end
                            end
                        | false => True/qed()
                        end
                    end
                end
            -- `F0..=F4`, the lead byte's payload being at most `4` because a scalar value is at most `U+10FFFF`.
            | false =>
                let top = Char/Valid/at_most(c.code, c.valid);
                match c.code / 0x40000 <= 4
                | false => match False/refuted() end
                | true =>
                    match c.code / 0x40000 == 0
                    -- `F0`: the code point is at least `0x10000` with nothing above its low eighteen bits, so its next six are at least `0x10`.
                    | true =>
                        match c.code / 0x40000 == 4
                        | true => match False/refuted() end
                        | false =>
                            match c.code % 0x40000 / 0x1000 >= 0x10
                            | true => True/qed()
                            | false => match False/refuted() end
                            end
                        end
                    | false =>
                        match c.code / 0x40000 == 4
                        -- `F4`: the code point is at most `U+10FFFF`, so its next six bits are at most `0xF`.
                        | true =>
                            match c.code % 0x40000 / 0x1000 <= 0xF
                            | true => True/qed()
                            | false => match False/refuted() end
                            end
                        | false => True/qed()
                        end
                    end
                end
            end
        end
    end;
