use /std/{Nat, Bytes, Bool, Char, Option, Str, Eq, Ord, WellFounded};
use /std/Bool/{True, Holds};
use /std/ops/{Eql, Cmp};

--- Whether a character may begin at the front of `rest`: it is empty, or its first byte continues none.
---
--- One byte decides it, which is what makes a position cheap to check. What gives the one-byte fact its meaning is UTF-8's self-synchronization, which `Str/Valid/before` and `Str/Valid/after` prove: valid text cut where a character may begin is valid text on both sides.
pub let starts(rest: Bytes) -> Bool =
    match rest | x[] => true | x[h, .._] => Bool/not(Str/continues(h)) end;

--- A position in `s`: a byte offset at which a character may begin, with the bound and the boundary that say so, both erased.
pub struct At(s: Str): pub Type {
    --- The byte offset.
    offset: Nat,
    --- Why it lies within `s`.
    within: Holds(offset <= Bytes/len(s.bytes)),
    --- Why a character may begin there.
    boundary: Holds(starts(Bytes/drop(s.bytes, offset, @within))),
}

--- The start of `s`.
pub let start(s: Str) -> At(s) =
    At { offset = 0, within = True/qed(), boundary = Str/Valid/begins(s.valid) };

--- The end of `s`, past its last character.
pub let finish(s: Str) -> At(s) =
    At {
        offset = Bytes/len(s.bytes),
        within = Nat/le/refl(Bytes/len(s.bytes)),
        boundary = True/qed(),
    };

--- The position `k` bytes into `s`, where `k` is known to lie within it and a character to begin there. Both discharge by reduction at a literal.
pub let of_offset(
    s: Str,
    k: Nat,
    @within: Holds(k <= Bytes/len(s.bytes)),
    @boundary: Holds(starts(Bytes/drop(s.bytes, k, @within))),
) -> At(s) =
    At { offset = k, within = within, boundary = boundary };

--- The position `k` bytes into `s`, or `none` when `k` is past the end or inside a character. Decided by the one byte at `k`.
pub let try_of_offset(s: Str, k: Nat) -> Option(At(s)) =
    match Nat/le/try(k, Bytes/len(s.bytes))
    | none() => Option/none()
    | some(within) =>
        match starts(Bytes/drop(s.bytes, k, @within))
        | true => Option/some(At { offset = k, within = within, boundary = True/qed() })
        | false => Option/none()
        end
    end;

--- The byte offset of `at`.
pub let to_offset(@s: Str, at: At(s)) -> Nat =
    at.offset;

--- A position in the text after `at` as the position in `s` it is.
pub let of_after(s: Str, at: At(s), p: At(Str/after(s, at))) -> At(s) =
    At { offset = at.offset + p.offset, within = True/proved(), boundary = p.boundary };

--- A position at or after `at` as the position in the text after `at` it is: [`of_after`] read backwards.
---
--- The boundary is `p`'s own once the offset is read back: the text after `at`, dropped by `p.offset - at.offset`, is `s` dropped by `at.offset + (p.offset - at.offset)`, which is `p.offset` because `at` comes first.
pub let to_after(
    s: Str,
    at: At(s),
    p: At(s),
    @ordered: Holds(at.offset <= p.offset),
) -> At(Str/after(s, at)) =
    let back = Eq/sym(Nat/le/add_sub_cancel(at.offset, p.offset, ordered));
    At {
        offset = p.offset - at.offset,
        within = True/proved(),
        boundary =
            Eq/subst(
                (n: Nat) =>
                    (within: Holds(n <= Bytes/len(s.bytes))) -> Holds(
                        starts(Bytes/drop(s.bytes, n, @within))),
                back,
                (_) => p.boundary)(True/proved()),
    };

--- How many bytes continuing a character open `rest`.
let run(rest: Bytes) -> Nat =
    match rest
    | x[] => 0
    | x[h, ..t] => match Str/continues(h) | true => run(t) + 1 | false => 0 end
    end;

-- Not grouped with `run_starts`: a group's signatures elaborate together, and `run_starts` would read this bound before its comparison is settled.
--- The continuing bytes that open `rest` lie within it.
let run_within(rest: Bytes) -> Holds(run(rest) <= Bytes/len(rest)) =
    match rest
    | x[] => True/qed()
    | x[h, ..t] => match Str/continues(h) | true => run_within(t) | false => True/qed() end
    end;

--- Past the continuing bytes that open `rest`, a character may begin.
let run_starts(rest: Bytes) -> Holds(starts(Bytes/drop(rest, run(rest), @run_within(rest)))) =
    match rest
    | x[] => True/qed()
    | x[h, ..t] => match Str/continues(h) | true => run_starts(t) | false => True/qed() end
    end;

--- How many bytes the first character of `b` takes — its lead and the bytes continuing it — with the bound and the boundary past them. The character is not decoded: the one-byte rule is all a step needs.
let hop(
    @b: Bytes,
    some: Holds(0 < Bytes/len(b)),
) -> {
    width: Nat,
    positive: Holds(0 < width),
    within: Holds(width <= Bytes/len(b)),
    boundary: Holds(starts(Bytes/drop(b, width, @within)))} =
    match b
    | x[] => match some end
    | x[_, ..t] =>
        (
            width = 1 + run(t),
            positive = True/qed(),
            within = run_within(t),
            boundary = run_starts(t))
    end;

--- The first character of valid bytes that hold one.
let lead(@b: Bytes, v: Str/Valid(b), some: Holds(0 < Bytes/len(b))) -> Char =
    match b
    | x[] => match some end
    | x[c, ..t] => Str/Valid/decode_head(c, @t, v)
    end;

--- The position past the character at `at`, found without decoding it, and the proof that it lies past — what a walk forward recurs with, through [`forward`].
pub let skip(
    s: Str,
    at: At(s),
    @here: Holds(at.offset < Bytes/len(s.bytes)),
) -> {past: At(s), progress: Holds(at.offset < past.offset)} =
    let rest = Str/after(s, at);
    let hopped = hop(@rest.bytes, True/proved());
    (
        past =
            of_after(
                s,
                at,
                At { offset = hopped.width, within = hopped.within, boundary = hopped.boundary }),
        progress = hopped.positive);

--- The character at `at`, the position past it, and the proof that it lies past.
pub let next(
    s: Str,
    at: At(s),
    @here: Holds(at.offset < Bytes/len(s.bytes)),
) -> {char: Char, past: At(s), progress: Holds(at.offset < past.offset)} =
    let rest = Str/after(s, at);
    let stepped = skip(s, at, @here);
    (char = lead(rest.valid, True/proved()), past = stepped.past, progress = stepped.progress);

--- The character at `at`, the position past it and the proof that it lies past, or `none` at the end of `s`.
pub let try_next(
    s: Str,
    at: At(s),
) -> Option({char: Char, past: At(s), progress: Holds(at.offset < past.offset)}) =
    match at.offset < Bytes/len(s.bytes)
    | true => Option/some(next(s, at))
    | false => Option/none()
    end;

--- The last position of `s` at or before offset `k`, which a byte that does not continue a character marks within three bytes of valid text.
let floor(
    s: Str,
    k: Nat,
    within: Holds(k <= Bytes/len(s.bytes)),
) -> {at: At(s), below: Holds(at.offset <= k)} =
    match k
    | 0 => (at = start(s), below = True/qed())
    | j + 1 =>
        match starts(Bytes/drop(s.bytes, j + 1, @within))
        | true =>
            (
                at = At { offset = j + 1, within = within, boundary = True/qed() },
                below = Nat/le/refl(j + 1))
        | false =>
            let back = floor(s, j, True/proved());
            (at = back.at, below = True/proved())
        end
    end;

--- The character before `at`, the position before it, and the proof that it lies before.
pub let prev(
    s: Str,
    at: At(s),
    @here: Holds(0 < at.offset),
) -> {char: Char, past: At(s), progress: Holds(past.offset < at.offset)} =
    match at.offset
    | 0 => match here end
    | j + 1 =>
        let back = floor(s, j, True/proved());
        (char = next(s, back.at).char, past = back.at, progress = back.below)
    end;

--- The character before `at`, the position before it and the proof that it lies before, or `none` at the start of `s`.
pub let try_prev(
    s: Str,
    at: At(s),
) -> Option({char: Char, past: At(s), progress: Holds(past.offset < at.offset)}) =
    match 0 < at.offset | true => Option/some(prev(s, at)) | false => Option/none() end;

--- A position past another is well-founded: what is left of `s` past a position shrinks as the position moves on.
let onward(s: Str) -> WellFounded((p: At(s), q: At(s)) => Holds(q.offset < p.offset)) =
    let left: WellFounded((p: At(s), q: At(s)) =>
        Holds(Bytes/len(s.bytes) - p.offset < Bytes/len(s.bytes) - q.offset)) =
        WellFounded/on((p: At(s)) => Bytes/len(s.bytes) - p.offset, WellFounded/lt);
    WellFounded/narrow(left, (p, q, ahead) => True/proved());

--- Recursion forward through the positions of `s`: `step` answers `P(at)` and may recur at any position past `at` — with the proof that it lies past, which is what [`next`] and [`skip`] answer — so a walk forward is total without recursing on its own, and computes wherever a value is demanded, in a type as at runtime.
pub let forward(
    @s: Str,
    P: (At(s)) -> Type,
    step: (at: At(s), again: (p: At(s), progress: Holds(at.offset < p.offset)) -> P(p)) -> P(at),
    at: At(s),
) -> P(at) =
    WellFounded/recurse(P, step, at, onward(s)(at));

--- Recursion back through the positions of `s`: `step` may recur at any position before `at`, with the proof that it lies before, which is what [`prev`] answers. [`forward`] read the other way, and well-founded as `<` on offsets is.
pub let backward(
    @s: Str,
    P: (At(s)) -> Type,
    step: (at: At(s), again: (p: At(s), progress: Holds(p.offset < at.offset)) -> P(p)) -> P(at),
    at: At(s),
) -> P(at) =
    WellFounded/recurse(P, step, at, WellFounded/on((p: At(s)) => p.offset, WellFounded/lt)(at));

--- A position in `a` stays one with `rest` appended, when a character may begin at the front of `rest`.
let starts_before(
    @a: Bytes,
    rest: Bytes,
    k: Nat,
    within: Holds(k <= Bytes/len(a)),
    at: Holds(starts(Bytes/drop(a, k, @within))),
    begins: Holds(starts(rest)),
) -> Holds(starts(Bytes/drop(x[..a, ..rest], k))) =
    match k
    | 0 => match a | x[] => begins | x[_, .._] => at end
    | j + 1 =>
        match a
        | x[] => match within end
        | x[_, ..r] => starts_before(@r, rest, j, within, at, begins)
        end
    end;

--- A position in `s` as the position it is in `s` followed by `t`.
pub let of_left(s: Str, t: Str, at: At(s)) -> At(Str/concat(s, t)) =
    At {
        offset = at.offset,
        within = True/proved(),
        boundary =
            starts_before(
                @s.bytes,
                t.bytes,
                at.offset,
                at.within,
                at.boundary,
                Str/Valid/begins(t.valid)),
    };

--- A position in `t` as the position it is in `s` followed by `t`.
pub let of_right(s: Str, t: Str, at: At(t)) -> At(Str/concat(s, t)) =
    At { offset = Bytes/len(s.bytes) + at.offset, within = True/proved(), boundary = at.boundary };

--- Two positions are equal when their offsets are.
satisfy (@s: Str) => Eql(At(s)) {
    eql(a, b) = a.offset == b.offset,
    neq(a, b) = a.offset != b.offset,
}

--- Positions are ordered by their offsets, so a guard between two decides the bound [`Str/between`] takes.
satisfy (@s: Str) => Cmp(At(s)) {
    lt(a, b) = a.offset < b.offset,
    le(a, b) = a.offset <= b.offset,
    gt(a, b) = a.offset > b.offset,
    ge(a, b) = a.offset >= b.offset,
}

satisfy (@s: Str) => Ord(At(s)) {
    ord(a, b) = Nat/ord(a.offset, b.offset),
}
