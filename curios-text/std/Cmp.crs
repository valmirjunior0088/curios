pub use /syn/{Cmp};
pub use /syn/Cmp/{lt, lte, gt, gte};
use /std/{Nat, Int, Flt, BigNat, BigInt};

satisfy Cmp(Nat) {
    lt(a, b) = Nat/lt(a, b),
    lte(a, b) = Nat/lte(a, b),
    gt(a, b) = Nat/gt(a, b),
    gte(a, b) = Nat/gte(a, b)
}

satisfy Cmp(Int) {
    lt(a, b) = Int/lt(a, b),
    lte(a, b) = Int/lte(a, b),
    gt(a, b) = Int/gt(a, b),
    gte(a, b) = Int/gte(a, b)
}

satisfy Cmp(Flt) {
    lt(a, b) = Flt/lt(a, b),
    lte(a, b) = Flt/lte(a, b),
    gt(a, b) = Flt/gt(a, b),
    gte(a, b) = Flt/gte(a, b)
}

satisfy Cmp(BigNat) {
    lt(a, b) = BigNat/lt(a, b),
    lte(a, b) = BigNat/lte(a, b),
    gt(a, b) = BigNat/gt(a, b),
    gte(a, b) = BigNat/gte(a, b)
}

satisfy Cmp(BigInt) {
    lt(a, b) = BigInt/lt(a, b),
    lte(a, b) = BigInt/lte(a, b),
    gt(a, b) = BigInt/gt(a, b),
    gte(a, b) = BigInt/gte(a, b)
}
