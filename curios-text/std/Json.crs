use /std/{Bin, Str, Bln, Char, Flt, Nat, Parse, Result, Option, Lst};

pub induct Json : Type
| null()
| bln(Bln)
| num(Flt)
| str(Str)
| arr(Lst(Json))
| obj(Lst({Str, Json}))
end

pub use Json/*;

let encode_num(n : Flt) -> Str =
    let raw = Flt/to_str(n);
    match Option/unwrap_or(Str/get(raw, 0), 0) == '+'
    | true => Str/slice(raw, 1, Str/len(raw))
    | false => raw
    end;

let escape_byte(byte : Nat) -> Bin =
    match byte
    | '"' => Str/to_bin("\\\"")
    | '\\' => Str/to_bin("\\\\")
    | '\n' => Str/to_bin("\\n")
    | '\r' => Str/to_bin("\\r")
    | '\t' => Str/to_bin("\\t")
    | 0x08 => Str/to_bin("\\b")
    | 0x0C => Str/to_bin("\\f")
    | _ =>
        match byte < 0x20
        | true =>
            Bin/append(
                Bin/append(Str/to_bin("\\u00"), Char/hex_digit(byte / 0x10)),
                Char/hex_digit(byte % 0x10))
        | false => Bin/append(\\, byte)
        end
    end;

let encode_str(s : Str) -> Str =
    let body =
        Bin/fold(Str/to_bin(s), \\, (byte, acc) => \..acc\..escape_byte(byte));
    Str/concat(Str/concat("\"", Option/unwrap_or(Str/of_bin(body), "")), "\"");

pub rec encode(v : Json) -> Str =
    match v
    | null() => "null"
    | bln(b) => Bln/to_str(b)
    | num(n) => encode_num(n)
    | str(s) => encode_str(s)
    | arr(xs) =>
        Str/concat(Str/concat("[",
            Str/join(",", Lst/map(encode, xs))), "]")
    | obj(ps) =>
        Str/concat(Str/concat("{",
            Str/join(",", Lst/map(
                (pair : {Str, Json}) => Str/concat(Str/concat(encode_str(pair.0), ":"), encode(pair.1)),
                ps))),
            "}")
    end;

let is_num_byte(byte : Nat) -> Bln =
    match Char/is_digit(byte)
    | true => true
    | false =>
        match byte
        | '-' => true
        | '+' => true
        | '.' => true
        | 'e' => true
        | 'E' => true
        | _ => false
        end
    end;

let take_literal(literal : Str) -> Parse({}) =
    Parse { run(input, pos) =
        let lit = Str/to_bin(literal);
        let r =
            match Bin/len(lit) : {Nat, Bln}
            | 0 => (pos, true)
            | step + 1; ih =>
                match ih.1
                | false => ih
                | true =>
                    match Nat/try_lt(ih.0, Bin/len(input))
                    | none() => (ih.0, false)
                    | some(ok) =>
                        match Option/unwrap_or(Bin/get(lit, step), 0) == Bin/at(input, ih.0, ok)
                        | true => (ih.0 + 1, true)
                        | false => (ih.0, false)
                        end
                    end
                end
            end;
        match r.1
        | true => Result/success((r.0, ()))
        | false => Result/failure("unexpected literal")
        end };

let parse_null : Parse(Json) =
    Parse/map((_) => Json/null(), take_literal("null"));

let parse_true_val : Parse(Json) =
    Parse/map((_) => Json/bln(true), take_literal("true"));

let parse_false_val : Parse(Json) =
    Parse/map((_) => Json/bln(false), take_literal("false"));

let parse_num : Parse(Json) =
    Parse { run(input, pos) =
        match Parse/take_while(is_num_byte).run(input, pos)
        | success(pair) =>
            match Flt/of_str(Option/unwrap_or(Str/of_bin(pair.1), ""))
            | some(value) => Result/success((pair.0, Json/num(value)))
            | none() => Result/failure("expected number")
            end
        | failure(msg) => Result/failure(msg)
        end };

let is_not_string_special(byte : Nat) -> Bln =
    match byte
    | '"' => false
    | '\\' => false
    | _ => true
    end;

let hex_digit : Parse(Nat) =
    let byte = Parse/any_byte!;
    match Char/of_hex_digit(byte) : Parse(Nat)
    | some(v) => Parse/pure(v)
    | none() => Parse/fail("invalid hex digit")
    end;

let hex4 : Parse(Nat) =
    let a = hex_digit!;
    let b = hex_digit!;
    let c = hex_digit!;
    let d = hex_digit!;
    Parse/pure(a * 0x1000 + b * 0x100 + c * 0x10 + d);

let parse_unicode : Parse(Bin) =
    let hi = hex4!;
    match hi >= 0xD800 && hi <= 0xDBFF : Parse(Bin)
    | true =>
        let _ = Parse/take_byte('\\')!;
        let _ = Parse/take_byte('u')!;
        let lo = hex4!;
        Parse/pure(Char/to_utf8(0x10000 + (hi - 0xD800) * 0x400 + (lo - 0xDC00)))
    | false => Parse/pure(Char/to_utf8(hi))
    end;

let parse_str_escape : Parse(Bin) =
    let _ = Parse/take_byte('\\')!;
    let byte = Parse/any_byte!;
    match byte : Parse(Bin)
    | '"' => Parse/pure(Str/to_bin("\""))
    | '\\' => Parse/pure(Str/to_bin("\\"))
    | '/' => Parse/pure(Str/to_bin("/"))
    | 'b' => Parse/pure(Bin/append(\\, 8))
    | 'f' => Parse/pure(Bin/append(\\, 12))
    | 'n' => Parse/pure(Str/to_bin("\n"))
    | 'r' => Parse/pure(Str/to_bin("\r"))
    | 't' => Parse/pure(Str/to_bin("\t"))
    | 'u' => parse_unicode
    | _ => Parse/fail("unknown escape")
    end;

let parse_str_segment : Parse(Bin) =
    Parse/take_while(is_not_string_special);

let parse_str_body : Parse(Lst(Bin)) =
    Parse/many0(Parse/or(parse_str_escape, parse_str_segment));

let parse_raw_str : Parse(Str) =
    let _ = Parse/take_byte('"')!;
    let chunks = parse_str_body!;
    let _ = Parse/take_byte('"')!;
    match Str/of_bin(Bin/flatten(chunks)) : Parse(Str)
    | some(s) => Parse/pure(s)
    | none() => Parse/fail("invalid UTF-8 in string")
    end;

let parse_str_value : Parse(Json) =
    Parse/map((s) => Json/str(s), parse_raw_str);

let is_ws(byte : Nat) -> Bln =
    match byte
    | ' ' => true
    | '\t' => true
    | '\n' => true
    | '\r' => true
    | _ => false
    end;

let ws : Parse({}) =
    Parse/map((_) => (), Parse/take_while(is_ws));

let symbol(b : Nat) -> Parse(Nat) =
    let _ = ws!;
    Parse/take_byte(b);

pub rec decode : Parse(Json) = Parse { run(input, pos) =
    match ws.run(input, pos)
    | failure(msg) => Result/failure(msg)
    | success(skipped) =>
        let start = skipped.0;
        match Nat/try_lt(start, Bin/len(input))
        | none() => Result/failure("unexpected end of input")
        | some(ok) =>
            match Bin/at(input, start, ok)
            | 'n' => parse_null.run(input, start)
            | 't' => parse_true_val.run(input, start)
            | 'f' => parse_false_val.run(input, start)
            | '"' => parse_str_value.run(input, start)
            | '[' => parse_arr.run(input, start)
            | '{' => parse_obj.run(input, start)
            | _ => parse_num.run(input, start)
            end
        end
    end }
and parse_arr : Parse(Json) =
    let _ = symbol('[')!;
    let elems = Parse/sep_by0(decode, symbol(','))!;
    let _ = symbol(']')!;
    Parse/pure(Json/arr(elems))
and parse_obj : Parse(Json) =
    let _ = symbol('{')!;
    let pairs = Parse/sep_by0(parse_pair, symbol(','))!;
    let _ = symbol('}')!;
    Parse/pure(Json/obj(pairs))
and parse_pair : Parse({Str, Json}) =
    let _ = ws!;
    let key = parse_raw_str!;
    let _ = symbol(':')!;
    let val = decode!;
    Parse/pure((key, val));
