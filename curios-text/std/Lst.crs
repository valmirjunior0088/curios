pub use /sys/{Lst};
pub use /sys/Lst/{len, slice, append, concat, map};
use /std/{Nat, Bln, Option, Eq};

pub let nil(@A : Type) -> Lst(A) =
    [];

pub let cons(@A : Type, x : A, l : Lst(A)) -> Lst(A) =
    [x, ..l];

pub let at(@T : Type, a : Lst(T), i : Nat, ok : Nat/Lt(i, len(a))) -> T =
    /sys/Lst/get(a, i);

pub let get(@T : Type, a : Lst(T), i : Nat) -> Option(T) =
    match i < len(a)
    | true => Option/some(/sys/Lst/get(a, i))
    | false => Option/none()
    end;

pub let flatten(@T : Type, parts : Lst(Lst(T))) -> Lst(T) =
    fold(parts, [], (a, acc) => [..acc, ..a]);

pub let fold(@T : Type, @A : Type, l : Lst(T), init : A, f : (T, A) -> A) -> A =
    let n = len(l);
    rec go(k : Nat, i : Nat, acc : A, inv : Eq(i + k, n)) -> A =
        match k
        | 0 => acc
        | kp + 1; ih =>
            go(kp, i + 1,
                f(at(l, i, Eq/subst((x) => Nat/Lt(i, x), inv, Nat/lte_to_lt_succ(Nat/lte_add_r(i, kp)))), acc),
                inv)
        end;
    go(n, 0, init, Eq/refl());

pub let each(@T : Type, l : Lst(T), f : (T) -> {}) -> {} =
    fold(l, (), (x, acc) => f(x));

pub let find(@T : Type, l : Lst(T), pred : (T) -> Bln) -> Option(T) =
    let n = len(l);
    rec go(i : Nat) -> Option(T) =
        match i < n
        | false => Option/none()
        | true =>
            let x = /sys/Lst/get(l, i);
            match pred(x)
            | true => Option/some(x)
            | false => go(i + 1)
            end
        end;
    go(0);

pub let balanced(@A : Type, n : Nat, empty : A, single : (Nat) -> A, combine : (A, A) -> A) -> A =
    rec go(lo : Nat, hi : Nat) -> A =
        match
        | lo + 1 < hi =>
            let mid = (lo + hi) / 2;
            combine(go(lo, mid), go(mid, hi))
        | lo < hi => single(lo)
        | _ => empty
        end;
    go(0, n);
