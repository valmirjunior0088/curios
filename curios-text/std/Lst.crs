pub use /syn/{Lst};
pub use /syn/Lst/{nil, cons};
use /std/{Arr, Nat, Bln, Option, Monad};

pub let len(@A : Type, l : Lst(A)) -> Nat =
    rec go(rest : Lst(A), acc : Nat) -> Nat =
        match rest
        | nil() => acc
        | cons(_, tail) => go(tail, acc + 1)
        end;
    go(l, 0);

pub let rev(@A : Type, l : Lst(A)) -> Lst(A) =
    rec go(rest : Lst(A), acc : Lst(A)) -> Lst(A) =
        match rest
        | nil() => acc
        | cons(x, tail) => go(tail, cons(x, acc))
        end;
    go(l, nil());

pub rec append(@A : Type, a : Lst(A), b : Lst(A)) -> Lst(A) =
    match a : Lst(A)
    | nil() => b
    | cons(x, tail) => cons(x, append(tail, b))
    end;

pub rec map(@A : Type, @B : Type, f : (A) -> B, l : Lst(A)) -> Lst(B) =
    match l : Lst(B)
    | nil() => nil()
    | cons(x, tail) => cons(f(x), map(f, tail))
    end;

pub let fold(@A : Type, @B : Type, l : Lst(A), init : B, f : (A, B) -> B) -> B =
    rec go(rest : Lst(A), acc : B) -> B =
        match rest
        | nil() => acc
        | cons(x, tail) => go(tail, f(x, acc))
        end;
    go(l, init);

pub let each(@A : Type, l : Lst(A), f : (A) -> {}) -> {} =
    rec go(rest : Lst(A)) -> {} =
        match rest
        | nil() => ()
        | cons(x, tail) => let _ = f(x); go(tail)
        end;
    go(l);

pub let find(@A : Type, l : Lst(A), pred : (A) -> Bln) -> Option(A) =
    rec go(rest : Lst(A)) -> Option(A) =
        match rest
        | nil() => Option/none()
        | cons(x, tail) =>
            match pred(x)
            | true => Option/some(x)
            | false => go(tail)
            end
        end;
    go(l);

pub let to_arr(@A : Type, l : Lst(A)) -> Arr(A) =
    rec go(rest : Lst(A), n : Nat) -> {Arr(A), Lst(A)} =
        match n < 2
        | true =>
            match rest
            | nil() => ([||], rest)
            | cons(x, tail) =>
                match n == 0
                | true => ([||], rest)
                | false => ([|x|], tail)
                end
            end
        | false =>
            let half = n / 2;
            let left = go(rest, half);
            let right = go(left.1, n - half);
            (Arr/concat(left.0, right.0), right.1)
        end;
    (go(l, len(l))).0;

pub witness monad_lst : Monad(Lst) {
    pure(A, x) = cons(x, nil()),
    bind(A, B, m, f) =
        rec go(rest : Lst(A)) -> Lst(B) =
            match rest
            | nil() => nil()
            | cons(x, tail) => append(f(x), go(tail))
            end;
        go(m)
}
