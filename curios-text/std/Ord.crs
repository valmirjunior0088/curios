use /std/{Nat, Int, Flt, BigNat, Order, Eql};

pub concept Ord(A : Type) : Type {
    use Eql(A),
    cmp(A, A) -> Order
}

pub use Ord/*;

satisfy Ord(Nat) {
    cmp(a, b) = Nat/cmp(a, b)
}

satisfy Ord(Int) {
    cmp(a, b) = Int/cmp(a, b)
}

satisfy Ord(Flt) {
    cmp(a, b) = Flt/cmp(a, b)
}

satisfy Ord(BigNat) {
    cmp(a, b) = BigNat/cmp(a, b)
}
