use /std/{Nat, Bln, Lst, Str, Option, Order};

pub record BigNat : Type {
    limbs : Lst(Nat)
}

let base : Nat = 10000;

rec limbs_of_nat(n : Nat) -> Lst(Nat) =
    match n == 0
    | true => []
    | false => Lst/cons(n % base, limbs_of_nat(n / base))
    end;

pub let zero : BigNat =
    BigNat { limbs = [] };

pub let of_nat(n : Nat) -> BigNat =
    BigNat { limbs = limbs_of_nat(n) };

pub let is_zero(x : BigNat) -> Bln =
    Lst/len(x.limbs) == 0;

rec cmp(xs : Lst(Nat), ys : Lst(Nat)) -> Order =
    match xs
    | [] =>
        match Lst/len(ys) == 0
        | true => Order/eq()
        | false => Order/lt()
        end
    | x, ..xt =>
        match ys
        | [] => Order/gt()
        | y, ..yt =>
            match cmp(xt, yt)
            | eq() => Nat/compare(x, y)
            | lt() => Order/lt()
            | gt() => Order/gt()
            end
        end
    end;

pub let compare(a : BigNat, b : BigNat) -> Order =
    cmp(a.limbs, b.limbs);

pub let lt(a : BigNat, b : BigNat) -> Bln =
    match compare(a, b)
    | lt() => true
    | eq() => false
    | gt() => false
    end;

pub let lte(a : BigNat, b : BigNat) -> Bln =
    match compare(a, b)
    | lt() => true
    | eq() => true
    | gt() => false
    end;

pub let gt(a : BigNat, b : BigNat) -> Bln =
    match compare(a, b)
    | lt() => false
    | eq() => false
    | gt() => true
    end;

pub let gte(a : BigNat, b : BigNat) -> Bln =
    match compare(a, b)
    | lt() => false
    | eq() => true
    | gt() => true
    end;

rec add_c(xs : Lst(Nat), ys : Lst(Nat), carry : Nat) -> Lst(Nat) =
    match xs
    | [] =>
        match ys
        | [] =>
            match carry == 0
            | true => []
            | false => [carry]
            end
        | y, ..yt =>
            let s = y + carry;
            Lst/cons(s % base, add_c([], yt, s / base))
        end
    | x, ..xt =>
        match ys
        | [] =>
            let s = x + carry;
            Lst/cons(s % base, add_c(xt, [], s / base))
        | y, ..yt =>
            let s = x + y + carry;
            Lst/cons(s % base, add_c(xt, yt, s / base))
        end
    end;

pub let add(a : BigNat, b : BigNat) -> BigNat =
    BigNat { limbs = add_c(a.limbs, b.limbs, 0) };

rec sub_b(xs : Lst(Nat), ys : Lst(Nat), borrow : Nat) -> Lst(Nat) =
    match xs
    | [] => []
    | x, ..xt =>
        match ys
        | [] =>
            match x < borrow
            | true => Lst/cons(x + base - borrow, sub_b(xt, [], 1))
            | false => Lst/cons(x - borrow, sub_b(xt, [], 0))
            end
        | y, ..yt =>
            let need = y + borrow;
            match x < need
            | true => Lst/cons(x + base - need, sub_b(xt, yt, 1))
            | false => Lst/cons(x - need, sub_b(xt, yt, 0))
            end
        end
    end;

rec trim(xs : Lst(Nat)) -> Lst(Nat) =
    match xs
    | [] => []
    | x, ..xt =>
        let rest = trim(xt);
        match Lst/len(rest) == 0
        | true =>
            match x == 0
            | true => []
            | false => [x]
            end
        | false => Lst/cons(x, rest)
        end
    end;

pub let sub(a : BigNat, b : BigNat) -> BigNat =
    BigNat { limbs = trim(sub_b(a.limbs, b.limbs, 0)) };

rec mul_c(xs : Lst(Nat), c : Nat, carry : Nat) -> Lst(Nat) =
    match xs
    | [] =>
        match carry == 0
        | true => []
        | false => limbs_of_nat(carry)
        end
    | x, ..xt =>
        let p = x * c + carry;
        Lst/cons(p % base, mul_c(xt, c, p / base))
    end;

pub let mul_small(a : BigNat, c : Nat) -> BigNat =
    match c == 0
    | true => zero
    | false => BigNat { limbs = mul_c(a.limbs, c, 0) }
    end;

pub rec mul_pow2(a : BigNat, k : Nat) -> BigNat =
    match k == 0
    | true => a
    | false => mul_pow2(mul_small(a, 2), k - 1)
    end;

let pad4(n : Nat) -> Str =
    match n < 10
    | true => Str/concat("000", Nat/to_str(n))
    | false =>
        match n < 100
        | true => Str/concat("00", Nat/to_str(n))
        | false =>
            match n < 1000
            | true => Str/concat("0", Nat/to_str(n))
            | false => Nat/to_str(n)
            end
        end
    end;

-- Limbs are little-endian; print the top limb bare, then the rest
-- most-significant-first, zero-padded to the limb width.
let show(xs : Lst(Nat)) -> Str =
    let n = Lst/len(xs);
    match n == 0
    | true => "0"
    | false =>
        rec go(i : Nat, acc : Str) -> Str =
            match i == 0
            | true => acc
            | false => go(i - 1, Str/concat(acc, pad4(Option/unwrap_or(Lst/get(xs, i - 1), 0))))
            end;
        Str/concat(Nat/to_str(Option/unwrap_or(Lst/get(xs, n - 1), 0)), go(n - 1, ""))
    end;

pub let to_str(a : BigNat) -> Str =
    show(a.limbs);
