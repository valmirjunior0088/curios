pub use /sys/{Bln};
pub use /sys/Bln/{and, or, xor, eql};
use /std/{Str, Option, Eql};

satisfy Eql(Bln) {
    eql(a, b) = /sys/Bln/eql(a, b)
}

pub let not(b : Bln) -> Bln =
    xor(b, true);

pub let to_str(b : Bln) -> Str =
    match b
    | true => "true"
    | false => "false"
    end;

pub let of_str(s : Str) -> Option(Bln) =
    match Str/eql(s, "true")
    | true => Option/some(true)
    | false =>
        match Str/eql(s, "false")
        | true => Option/some(false)
        | false => Option/none()
        end
    end;
