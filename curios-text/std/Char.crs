use /std/{Nat, Bln, Bin, Option};

pub let is_whitespace(c : Nat) -> Bln =
    c == ' ' || Nat/in_range(c, '\t', '\r');

pub let is_digit(c : Nat) -> Bln =
    Nat/in_range(c, '0', '9');

pub let is_lower(c : Nat) -> Bln =
    Nat/in_range(c, 'a', 'z');

pub let is_upper(c : Nat) -> Bln =
    Nat/in_range(c, 'A', 'Z');

pub let is_alpha(c : Nat) -> Bln =
    is_lower(c) || is_upper(c);

pub let is_alphanumeric(c : Nat) -> Bln =
    is_alpha(c) || is_digit(c);

pub let to_lower(c : Nat) -> Nat =
    match is_upper(c)
    | true => c + 0x20
    | false => c
    end;

pub let to_upper(c : Nat) -> Nat =
    match is_lower(c)
    | true => c - 0x20
    | false => c
    end;

pub let hex_digit(nibble : Nat) -> Nat =
    match nibble < 10
    | true => nibble + '0'
    | false => nibble - 10 + 'a'
    end;

pub let of_hex_digit(c : Nat) -> Option(Nat) =
    match is_digit(c)
    | true => Option/some(c - '0')
    | false =>
        match Nat/in_range(c, 'a', 'f')
        | true => Option/some(c - 'a' + 10)
        | false =>
            match Nat/in_range(c, 'A', 'F')
            | true => Option/some(c - 'A' + 10)
            | false => Option/none()
            end
        end
    end;

rec emit_continuations(acc : Bin, codepoint : Nat, shift : Nat) -> Bin =
    match shift == 0
    | true => acc
    | false =>
        let group = codepoint / shift % 0x40;
        emit_continuations(Bin/append(acc, 0x80 + group), codepoint, shift / 0x40)
    end;

pub let to_utf8(codepoint : Nat) -> Bin =
    match codepoint < 0x80
    | true => Bin/append(\\, codepoint)
    | false =>
        match codepoint < 0x800
        | true => emit_continuations(Bin/append(\\, 0xC0 + codepoint / 0x40), codepoint, 1)
        | false =>
            match codepoint < 0x10000
            | true => emit_continuations(Bin/append(\\, 0xE0 + codepoint / 0x1000), codepoint, 0x40)
            | false => emit_continuations(Bin/append(\\, 0xF0 + codepoint / 0x40000), codepoint, 0x1000)
            end
        end
    end;
