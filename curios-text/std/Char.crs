use /std/{Nat, Bln, Bytes, Option};

pub let is_whitespace(c : Nat) -> Bln =
    c == ' ' || Nat/in_range(c, '\t', '\r');

pub let is_digit(c : Nat) -> Bln =
    Nat/in_range(c, '0', '9');

pub let is_lower(c : Nat) -> Bln =
    Nat/in_range(c, 'a', 'z');

pub let is_upper(c : Nat) -> Bln =
    Nat/in_range(c, 'A', 'Z');

pub let is_alpha(c : Nat) -> Bln =
    is_lower(c) || is_upper(c);

pub let is_alphanumeric(c : Nat) -> Bln =
    is_alpha(c) || is_digit(c);

pub let to_lower(c : Nat) -> Nat =
    match is_upper(c)
    | true => c + 0x20
    | false => c
    end;

pub let to_upper(c : Nat) -> Nat =
    match is_lower(c)
    | true => c - 0x20
    | false => c
    end;

pub let hex_digit(nibble : Nat) -> Nat =
    match nibble < 10
    | true => nibble + '0'
    | false => nibble - 10 + 'a'
    end;

pub let of_hex_digit(c : Nat) -> Option(Nat) =
    match
    | is_digit(c) => Option/some(c - '0')
    | Nat/in_range(c, 'a', 'f') => Option/some(c - 'a' + 10)
    | Nat/in_range(c, 'A', 'F') => Option/some(c - 'A' + 10)
    | _ => Option/none()
    end;

rec emit_continuations(acc : Bytes, codepoint : Nat, shift : Nat) -> Bytes =
    match shift == 0
    | true => acc
    | false =>
        let group = codepoint / shift % 0x40;
        emit_continuations(Bytes/append(acc, Nat/to_byte(0x80 + group)), codepoint, shift / 0x40)
    end;

pub let to_utf8(codepoint : Nat) -> Bytes =
    match
    | codepoint < 0x80 => Bytes/append(x\, Nat/to_byte(codepoint))
    | codepoint < 0x800 => emit_continuations(Bytes/append(x\, Nat/to_byte(0xC0 + codepoint / 0x40)), codepoint, 1)
    | codepoint < 0x10000 => emit_continuations(Bytes/append(x\, Nat/to_byte(0xE0 + codepoint / 0x1000)), codepoint, 0x40)
    | _ => emit_continuations(Bytes/append(x\, Nat/to_byte(0xF0 + codepoint / 0x40000)), codepoint, 0x1000)
    end;
