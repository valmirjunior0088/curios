pub use /sys/{Int};
pub use /sys/Int/{eql, neq, add, sub, mul, div, rem, lt, gt, lte, gte, and, or, xor, shl, shr, to_nat, to_flt};
use /std/{Nat, Str, Option, Order};

pub let to_str(n : Int) -> Str =
    let mag = Nat/to_str(abs(n));
    match n >= +0
    | true => Str/concat("+", mag)
    | false => Str/concat("-", mag)
    end;

pub let not(x : Int) -> Int =
    xor(x, -1);

pub let of_str(s : Str) -> Option(Int) =
    match Str/len(s) == 0
    | true => Option/none()
    | false =>
        let first = Str/get(s, 0)!;
        let digits =
            match first == '+' || first == '-'
            | true => Str/slice(s, 1, Str/len(s))
            | false => s
            end;
        let negative = first == '-';
        let n = Nat/of_str(digits)!;
        match negative
        | true => Option/some(+0 - Nat/to_int(n))
        | false => Option/some(Nat/to_int(n))
        end
    end;

pub let abs(n : Int) -> Nat =
    match n >= +0
    | true => to_nat(n)
    | false => to_nat(+0 - n)
    end;

pub let cmp(x : Int, y : Int) -> Order =
    match
    | x < y => Order/lt()
    | x == y => Order/eq()
    | _ => Order/gt()
    end;
