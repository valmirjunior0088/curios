pub use /sys/{Nat};
pub use /sys/Nat/{succ, eql, neq, add, sub, mul, div, rem, lt, gt, lte, gte, and, or, xor, shl, shr, to_int, to_flt};
use /std/{Str, Option, Char, Bin, Bln, Eq, Order, True, False};
use /syn/Str/{Scan, Utf8, step, Valid};

let single(c : Nat, ok : Eq(step(c, Scan/lead()), Scan/lead()))
    -> Valid(Bin/append(\\, c)) =
    let r : Utf8(step(c, Scan/lead()), \\) =
        Eq/subst((sc) => Utf8(sc, \\), Eq/sym(ok), Utf8/stop());
    Utf8/more(c, Scan/lead(), \\, r);

let digit(d : Nat) -> { c : Nat, ok : Eq(step(c, Scan/lead()), Scan/lead()) } =
    match d
    | 0 => ('0', Eq/refl())
    | 1 => ('1', Eq/refl())
    | 2 => ('2', Eq/refl())
    | 3 => ('3', Eq/refl())
    | 4 => ('4', Eq/refl())
    | 5 => ('5', Eq/refl())
    | 6 => ('6', Eq/refl())
    | 7 => ('7', Eq/refl())
    | 8 => ('8', Eq/refl())
    | 9 => ('9', Eq/refl())
    | _ => ('0', Eq/refl())
    end;

let single_digit(d : Nat) -> Str =
    let g = digit(d);
    Str { bytes = Bin/append(\\, g.c), valid = single(g.c, g.ok) };

pub rec to_str(n : Nat) -> Str =
    match n < 10
    | true => single_digit(n)
    | false => Str/concat(to_str(n / 10), single_digit(n % 10))
    end;

pub let of_str(s : Str) -> Option(Nat) =
    match Str/len(s) == 0
    | true => Option/none()
    | false =>
        Str/fold(s, Option/some(0), (cp, acc) =>
            let n = acc!;
            match Char/is_digit(cp)
            | true => Option/some(n * 10 + (cp - '0'))
            | false => Option/none()
            end)
    end;

pub let pred(a : Nat) -> Nat =
    a - 1;

pub let min(a : Nat, b : Nat) -> Nat =
    match a < b
    | true => a
    | false => b
    end;

pub let max(a : Nat, b : Nat) -> Nat =
    match a < b
    | true => b
    | false => a
    end;

pub let in_range(c : Nat, lo : Nat, hi : Nat) -> Bln =
    match c >= lo
    | true => c <= hi
    | false => false
    end;

pub let Lt(a : Nat, b : Nat) -> Prop =
    match a < b : Prop
    | true => True
    | false => False
    end;

pub let try_lt(a : Nat, b : Nat) -> Option(Lt(a, b)) =
    match a < b : (r) => Option(match r : Prop | true => True | false => False end)
    | true => Option/some(True/qed())
    | false => Option/none()
    end;

pub induct Lte : (a : Nat, b : Nat) -> Prop
| z(@n : Nat) : (0, n)
| s(@a : Nat, @b : Nat, prev : Lte(a, b)) : (a + 1, b + 1)
end

pub rec lte_refl(n : Nat) -> Lte(n, n) =
    match n : (m) => Lte(m, m)
    | 0 => Lte/z()
    | pred + 1; ih => Lte/s(ih)
    end;

pub rec lte_succ_r(@a : Nat, @b : Nat, p : Lte(a, b)) -> Lte(a, b + 1) =
    match p : (w : Lte(x, y)) => Lte(x, y + 1)
    | z(_) => Lte/z()
    | s(_, _, prev) => Lte/s(lte_succ_r(prev))
    end;

pub rec lte_add_r(a : Nat, k : Nat) -> Lte(a, a + k) =
    match k : (m) => Lte(a, a + m)
    | 0 => lte_refl(a)
    | pred + 1; ih => lte_succ_r(ih)
    end;

pub rec lte_to_lt_succ(@a : Nat, @b : Nat, p : Lte(a, b)) -> Lt(a, b + 1) =
    match p : (w : Lte(x, y)) => Lt(x, y + 1)
    | z(_) => True/qed()
    | s(_, _, prev) => lte_to_lt_succ(prev)
    end;

pub rec lte_trans(@a : Nat, @b : Nat, @c : Nat, p : Lte(a, b), q : Lte(b, c)) -> Lte(a, c) =
    match p
    | z(_) => Lte/z()
    | s(a2, b2, prev) =>
        match q
        | s(b3, c3, q2) => Lte/s(lte_trans(prev, q2))
        end
    end;

pub let lt_of_lte_succ(@a : Nat, @b : Nat, p : Lte(a + 1, b)) -> Lt(a, b) =
    match p : (w : Lte(x, y)) => Lt(x - 1, y)
    | s(a2, b2, prev) => lte_to_lt_succ(prev)
    end;

pub rec lte_add_mono_l(n : Nat, @a : Nat, @b : Nat, p : Lte(a, b)) -> Lte(n + a, n + b) =
    match n : (m) => Lte(m + a, m + b)
    | 0 => p
    | m + 1; ih => Lte/s(ih)
    end;

pub let compare(x : Nat, y : Nat) -> Order =
    match x < y
    | true => Order/lt()
    | false =>
        match x == y
        | true => Order/eq()
        | false => Order/gt()
        end
    end;
