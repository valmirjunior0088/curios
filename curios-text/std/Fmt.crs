use /std/{Bin, Str, Nat, Option, Io, Bln};

pub induct Fmt : Type
| nil()
| lit(Str, Fmt)
| str(Fmt)
| nat(Fmt)
end

pub rec format_type_with(T: Type, f: Fmt) -> Type =
    match f
    | nil() => T
    | lit(_, rest) => format_type_with(T, rest)
    | str(rest) => (Str) -> format_type_with(T, rest)
    | nat(rest) => (Nat) -> format_type_with(T, rest)
    end;

-- `parse` receives a valid `Str` and splits at ASCII '%', so the sliced
-- segment is always valid UTF-8; the `none` arm is unreachable in practice.
let flush(bytes : Bin, start : Nat, stop : Nat, rest : Fmt) -> Fmt =
    match Str/of_bin(Bin/slice(bytes, start, stop))
    | some(piece) => Fmt/lit(piece, rest)
    | none() => Fmt/nil()
    end;

-- First-order on purpose: no combinator records, no local closures — every
-- call is direct, so the compiler can run a literal format string's parse at
-- compile time (and a runtime format string doesn't drag in /std/Parse).
rec parse_at(bytes : Bin, pos : Nat) -> Fmt =
    match Nat/try_lt(pos, Bin/len(bytes))
    | none() => Fmt/nil()
    | some(ok) =>
        match Bin/at(bytes, pos, ok) == '%'
        | true => parse_spec_at(bytes, pos + 1)
        | false => parse_lit_at(bytes, pos, pos + 1)
        end
    end
and parse_spec_at(bytes : Bin, pos : Nat) -> Fmt =
    match Nat/try_lt(pos, Bin/len(bytes))
    | none() => Fmt/lit("%", Fmt/nil())
    | some(ok) =>
        match Bin/at(bytes, pos, ok)
        | 's' => Fmt/str(parse_at(bytes, pos + 1))
        | 'd' => Fmt/nat(parse_at(bytes, pos + 1))
        | _ => parse_at(bytes, pos + 1)
        end
    end
and parse_lit_at(bytes : Bin, start : Nat, pos : Nat) -> Fmt =
    match Nat/try_lt(pos, Bin/len(bytes))
    | none() => flush(bytes, start, pos, Fmt/nil())
    | some(ok) =>
        match Bin/at(bytes, pos, ok) == '%'
        | true => flush(bytes, start, pos, parse_spec_at(bytes, pos + 1))
        | false => parse_lit_at(bytes, start, pos + 1)
        end
    end;

pub let parse(s : Str) -> Fmt =
    parse_at(Str/to_bin(s), 0);

rec go_with(T : Type, finish : (Str) -> T, f : Fmt, acc : Str) -> format_type_with(T, f) =
    match f : (f) => format_type_with(T, f)
    | nil() => finish(acc)
    | lit(piece, rest) => go_with(T, finish, rest, Str/concat(acc, piece))
    | str(rest) => (s) => go_with(T, finish, rest, Str/concat(acc, s))
    | nat(rest) => (n) => go_with(T, finish, rest, Str/concat(acc, Nat/to_str(n)))
    end;

pub let render(s : Str) -> format_type_with(Str, parse(s)) =
    go_with(Str, (x) => x, parse(s), "");

pub let print(s : Str) -> format_type_with({}, parse(s)) =
    go_with({}, (x) => Io/print(x), parse(s), "");

pub let print_err(s : Str) -> format_type_with({}, parse(s)) =
    go_with({}, (x) => Io/print_err(x), parse(s), "");
