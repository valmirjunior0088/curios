use /std/{Nat, Bin, Bln};

pub induct Class : Type
| ascii()
| lead(Nat, Nat, Nat, Nat)
| bad()
end

pub let classify(c : Nat) -> Class =
    match
    | Nat/in_range(c, 0x00, 0x7F) => Class/ascii()
    | Nat/in_range(c, 0xC2, 0xDF) => Class/lead(1, 0x80, 0xBF, c - 0xC0)
    | Nat/in_range(c, 0xE0, 0xEF) =>
        let lo = match | c == 0xE0 => 0xA0 | _ => 0x80 end;
        let hi = match | c == 0xED => 0x9F | _ => 0xBF end;
        Class/lead(2, lo, hi, c - 0xE0)
    | Nat/in_range(c, 0xF0, 0xF4) =>
        let lo = match | c == 0xF0 => 0x90 | _ => 0x80 end;
        let hi = match | c == 0xF4 => 0x8F | _ => 0xBF end;
        Class/lead(3, lo, hi, c - 0xF0)
    | _ => Class/bad()
    end;

pub induct Scan : Type
| lead()
| cont(Nat, Nat, Nat)
| bad()
end

pub let step(c : Nat, s : Scan) -> Scan =
    match s
    | bad() => Scan/bad()
    | cont(rem, lo, hi) =>
        match
        | Bln/not(Nat/in_range(c, lo, hi)) => Scan/bad()
        | rem == 1 => Scan/lead()
        | _ => Scan/cont(rem - 1, 0x80, 0xBF)
        end
    | lead() =>
        match classify(c)
        | ascii() => Scan/lead()
        | lead(cont, lo, hi, _) => Scan/cont(cont, lo, hi)
        | bad() => Scan/bad()
        end
    end;

pub induct Utf8 : (s : Scan, b : Bin) -> Prop
| stop() : (Scan/lead(), \\)
| more(c : Nat, st : Scan, t : Bin, rest : Utf8(step(c, st), t))
    : (st, Bin/cons(c, t))
end

pub let Valid(b : Bin) -> Prop =
    Utf8(Scan/lead(), b);

pub record Str : Type {
    bytes : Bin,
    valid : Valid(bytes)
}
