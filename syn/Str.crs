use /std/{Nat, Bin};

pub union Scan
| lead()
| cont(Nat, Nat, Nat)
| bad()
end

let classify(c : Nat) -> Scan =
    match Nat/in_range(c, 0x00, 0x7F)
    | true => Scan/lead()
    | false =>
        match Nat/in_range(c, 0xC2, 0xDF)
        | true => Scan/cont(1, 0x80, 0xBF)
        | false =>
            match Nat/in_range(c, 0xE0, 0xEF)
            | true =>
                let lo = match Nat/eql(c, 0xE0) | true => 0xA0 | false => 0x80 end;
                let hi = match Nat/eql(c, 0xED) | true => 0x9F | false => 0xBF end;
                Scan/cont(2, lo, hi)
            | false =>
                match Nat/in_range(c, 0xF0, 0xF4)
                | true =>
                    let lo = match Nat/eql(c, 0xF0) | true => 0x90 | false => 0x80 end;
                    let hi = match Nat/eql(c, 0xF4) | true => 0x8F | false => 0xBF end;
                    Scan/cont(3, lo, hi)
                | false => Scan/bad()
                end
            end
        end
    end;

pub let step(c : Nat, s : Scan) -> Scan =
    match s
    | bad() => Scan/bad()
    | cont(rem, lo, hi) =>
        match Nat/in_range(c, lo, hi)
        | false => Scan/bad()
        | true =>
            match Nat/eql(rem, 1)
            | true => Scan/lead()
            | false => Scan/cont(Nat/pred(rem), 0x80, 0xBF)
            end
        end
    | lead() => classify(c)
    end;

pub union Utf8 : (s : Scan, b : Bin)
| stop() : (Scan/lead(), \\)
| more(c : Nat, st : Scan, t : Bin, rest : Utf8(step(c, st), t))
    : (st, Bin/cons(c, t))
end

pub let Valid(b : Bin) -> Type =
    Utf8(Scan/lead(), b);

pub struct Str pub {
    bytes : Bin,
    valid : @Valid(bytes)
}
