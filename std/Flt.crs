pub use /sys/Flt/*;
pub use /sys/{Flt};
use /std/{Nat, Int, Bin, Bln};

let find_byte(target : Nat, str : Bin) -> Nat =
    match Bin/len(str)
    | 0 => Bin/len(str)
    | pred + 1, ih =>
        match Nat/lt(pred, ih)
        | true =>
            match Nat/eql(Bin/get(str, pred), target)
            | true => pred
            | false => ih
            end
        | false => ih
        end
    end;

let pow10(n : Nat) -> Flt =
    match n
    | 0 => +1.0
    | pred + 1, ih => Flt/mul(ih, +10.0)
    end;

pub let of_str(str : Bin) -> Flt =
    let is_neg = Nat/eql(Bin/get(str, 0), '-');

    let start =
        match Bin/get(str, 0)
        | '+' => 1
        | '-' => 1
        | _ => 0
        end;

    let len = Bin/len(str);
    let dot_pos = find_byte('.', str);
    let e_pos = Nat/min(find_byte('e', str), find_byte('E', str));
    let int_end = Nat/min(dot_pos, e_pos);
    let int_flt = Nat/to_flt(Nat/of_str(Bin/slice(str, start, int_end)));

    let frac_flt =
        match Nat/lt(dot_pos, e_pos)
        | true =>
            let frac_slice = Bin/slice(str, Nat/add(dot_pos, 1), e_pos);
            Flt/div(Nat/to_flt(Nat/of_str(frac_slice)), pow10(Bin/len(frac_slice)))
        | false => +0.0
        end;

    let exp_flt =
        match Nat/lt(e_pos, len)
        | true =>
            let exp_int = Int/of_str(Bin/slice(str, Nat/add(e_pos, 1), len));
            match Int/gte(exp_int, +0)
            | true => pow10(Int/to_nat(exp_int))
            | false => Flt/div(+1.0, pow10(Int/abs(exp_int)))
            end
        | false => +1.0
        end;

    let result = Flt/mul(Flt/add(int_flt, frac_flt), exp_flt);

    match is_neg
    | true => Flt/neg(result)
    | false => result
    end;
