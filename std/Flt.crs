pub use /sys/{Flt};
pub use /sys/Flt/*;
use /std/{Nat, Int, Str, Bln, Option};

pub let to_str(f : Flt) -> Str =
    match Str/of_bin(to_str_bin(f))
    | some(s) => s
    | none() => ""
    end;

let pow10(n : Nat) -> Flt =
    match n
    | 0 => +1.0
    | pred + 1, ih => Flt/mul(ih, +10.0)
    end;

let digits_or_zero(s : Str) -> Option(Nat) =
    match Nat/eql(Str/len(s), 0)
    | true => Option/some(0)
    | false => Nat/of_str(s)
    end;

let exp_factor(exp_int : Int) -> Flt =
    match Int/gte(exp_int, +0)
    | true => pow10(Int/to_nat(exp_int))
    | false => Flt/div(+1.0, pow10(Int/abs(exp_int)))
    end;

let exp_factor_of(s : Str, e_pos : Nat, len : Nat) -> Option(Flt) =
    match Nat/lt(e_pos, len)
    | false => Option/some(+1.0)
    | true => Option/map(exp_factor, Int/of_str(Str/slice(s, Nat/add(e_pos, 1), len)))
    end;

pub let of_str(s : Str) -> Option(Flt) =
    let ! = Option/bind;
    match Nat/eql(Str/len(s), 0)
    | true => Option/none()
    | false =>
        let first = Str/get(s, 0);
        let is_neg = Nat/eql(first, '-');
        let start =
            match first
            | '+' => 1
            | '-' => 1
            | _ => 0
            end;
        let len = Str/len(s);
        let dot_pos = Option/unwrap_or(Str/find(s, '.'), len);
        let e_pos = Nat/min(
            Option/unwrap_or(Str/find(s, 'e'), len),
            Option/unwrap_or(Str/find(s, 'E'), len));
        let int_end = Nat/min(dot_pos, e_pos);
        let int_slice = Str/slice(s, start, int_end);
        let frac_slice =
            match Nat/lt(dot_pos, e_pos)
            | true => Str/slice(s, Nat/add(dot_pos, 1), e_pos)
            | false => ""
            end;
        match Bln/or(Nat/gt(Str/len(int_slice), 0), Nat/gt(Str/len(frac_slice), 0))
        | false => Option/none()
        | true =>
            let int_val = digits_or_zero(int_slice)!;
            let frac_val = digits_or_zero(frac_slice)!;
            let factor = exp_factor_of(s, e_pos, len)!;
            let mantissa =
                Flt/add(
                    Nat/to_flt(int_val),
                    Flt/div(Nat/to_flt(frac_val), pow10(Str/len(frac_slice))));
            let result = Flt/mul(mantissa, factor);
            match is_neg
            | true => Option/some(Flt/neg(result))
            | false => Option/some(result)
            end
        end
    end;
