use /std/{Result, Nat, Bin, Bln, Arr, Lst};

pub let Parse(A : Type) -> Type =
    (Bin, Nat) -> Result({ Nat, A }, Bin);

pub let run(A : Type, p : Parse(A), input : Bin) -> Result(A, Bin) =
    match p(input, 0)
    | success(pair) => Result/success(A, Bin, pair.1)
    | failure(msg) => Result/failure(A, Bin, msg)
    end;

pub let pure(A : Type, a : A) -> Parse(A) =
    (input, pos) =>
        Result/success({ Nat, A }, Bin, (pos, a));

pub let fail(A : Type, msg : Bin) -> Parse(A) =
    (input, pos) =>
        Result/failure({ Nat, A }, Bin, msg);

pub let map(A : Type, B : Type, f : A -> B, p : Parse(A)) -> Parse(B) =
    (input, pos) =>
        match p(input, pos)
        | success(pair) => Result/success({ Nat, B }, Bin, (pair.0, f(pair.1)))
        | failure(msg) => Result/failure({ Nat, B }, Bin, msg)
        end;

pub let bind(A : Type, B : Type) -> (Parse(A), A -> Parse(B)) -> Parse(B) =
    (p, f) => (input, pos) =>
        match p(input, pos)
        | success(pair) => f(pair.1)(input, pair.0)
        | failure(msg) => Result/failure({ Nat, B }, Bin, msg)
        end;

pub let or(A : Type, p : Parse(A), q : Parse(A)) -> Parse(A) =
    (input, pos) =>
        match p(input, pos)
        | success(pair) => Result/success({ Nat, A }, Bin, pair)
        | failure(_) => q(input, pos)
        end;

pub let and(A : Type, B : Type, p : Parse(A), q : Parse(B)) -> Parse({ A, B }) =
    (input, pos) =>
        match p(input, pos)
        | success(rp) =>
            match q(input, rp.0)
            | success(sp) => Result/success({ Nat, { A, B } }, Bin, (sp.0, (rp.1, sp.1)))
            | failure(msg) => Result/failure({ Nat, { A, B } }, Bin, msg)
            end
        | failure(msg) => Result/failure({ Nat, { A, B } }, Bin, msg)
        end;

pub let and_drop(A : Type, B : Type, p : Parse(A), q : Parse(B)) -> Parse(A) =
    (input, pos) =>
        match p(input, pos)
        | success(rp) =>
            match q(input, rp.0)
            | success(sp) => Result/success({ Nat, A }, Bin, (sp.0, rp.1))
            | failure(msg) => Result/failure({ Nat, A }, Bin, msg)
            end
        | failure(msg) => Result/failure({ Nat, A }, Bin, msg)
        end;

pub let and_keep(A : Type, B : Type, p : Parse(A), q : Parse(B)) -> Parse(B) =
    (input, pos) =>
        match p(input, pos)
        | success(pair) => q(input, pair.0)
        | failure(msg) => Result/failure({ Nat, B }, Bin, msg)
        end;

pub let any_byte : Parse(Nat) =
    (input, pos) =>
        match Nat/lt(pos, Bin/len(input))
        | false => Result/failure({ Nat, Nat }, Bin, "unexpected end of input")
        | true => Result/success({ Nat, Nat }, Bin, (Nat/add(pos, 1), Bin/get(input, pos)))
        end;

pub let peek_byte : Parse(Nat) =
    (input, pos) =>
        match Nat/lt(pos, Bin/len(input))
        | false => Result/failure({ Nat, Nat }, Bin, "unexpected end of input")
        | true => Result/success({ Nat, Nat }, Bin, (pos, Bin/get(input, pos)))
        end;

pub let take_byte(expected : Nat) -> Parse(Nat) =
    (input, pos) =>
        match Nat/lt(pos, Bin/len(input))
        | false => Result/failure({ Nat, Nat }, Bin, "unexpected end of input")
        | true =>
            let byte = Bin/get(input, pos);
            match Nat/eql(byte, expected)
            | true => Result/success({ Nat, Nat }, Bin, (Nat/add(pos, 1), byte))
            | false => Result/failure({ Nat, Nat }, Bin, "unexpected byte")
            end
        end;

-- Must stay structurally recursive (the `Nat` recursor on `len(input) - pos`),
-- NOT a general `rec`. `Fmt/parse` runs this combinator at *type-check time* to
-- compute `printf`'s type from the format literal, and the type checker's reducer
-- only normalizes structural recursion — a local `rec` would stay stuck, leaving
-- the format type a neutral `match` ("applied a non-function"). The recursor
-- unrolls every remaining byte (O(remaining) per call), which is the price of
-- compile-time reducibility here.
pub let take_while(pred : Nat -> Bln) -> Parse(Bin) =
    (input, pos) =>
        let r =
            match Nat/sub(Bin/len(input), pos) : { Nat, Bin, Bln }
            | 0 => (pos, "", false)
            | step + 1, ih =>
                match ih.2
                | true => ih
                | false =>
                    let byte = Bin/get(input, ih.0);
                    match pred(byte)
                    | true => (Nat/add(ih.0, 1), Bin/append(ih.1, byte), false)
                    | false => (ih.0, ih.1, true)
                    end
                end
            end;
        Result/success({ Nat, Bin }, Bin, (r.0, r.1));

pub let many0(A : Type, p : Parse(A)) -> Parse(Arr(A)) =
    (input, pos) =>
        rec go(acc : Lst(A), cur : Nat) -> Result({ Nat, Arr(A) }, Bin) =
            match p(input, cur)
            | failure(_) => Result/success({ Nat, Arr(A) }, Bin, (cur, Lst/to_arr(?, Lst/rev(?, acc))))
            | success(pair) =>
                match Nat/eql(pair.0, cur)
                | true => Result/success({ Nat, Arr(A) }, Bin, (cur, Lst/to_arr(?, Lst/rev(?, acc))))
                | false => go(Lst/cons(A, pair.1, acc), pair.0)
                end
            end;
        go(Lst/nil(A), pos);

pub let sep_by0(A : Type, S : Type, elem : Parse(A), sep : Parse(S)) -> Parse(Arr(A)) =
    (input, pos) =>
        match elem(input, pos)
        | failure(_) => Result/success({ Nat, Arr(A) }, Bin, (pos, []))
        | success(rp) =>
            rec go(acc : Lst(A), cur : Nat) -> Result({ Nat, Arr(A) }, Bin) =
                match sep(input, cur)
                | failure(_) => Result/success({ Nat, Arr(A) }, Bin, (cur, Lst/to_arr(?, Lst/rev(?, acc))))
                | success(sp) =>
                    match elem(input, sp.0)
                    | failure(_) => Result/success({ Nat, Arr(A) }, Bin, (cur, Lst/to_arr(?, Lst/rev(?, acc))))
                    | success(tp) => go(Lst/cons(A, tp.1, acc), tp.0)
                    end
                end;
            go(Lst/cons(A, rp.1, Lst/nil(A)), rp.0)
        end;
