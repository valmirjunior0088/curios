use /std/{Nat, Bln};

pub let is_whitespace(c : Nat) -> Bln =
    match Nat/eql(c, ' ')
    | true => true
    | false =>
        match Nat/gte(c, '\t')
        | true => Nat/lte(c, '\r')
        | false => false
        end
    end;

pub let is_digit(c : Nat) -> Bln =
    match Nat/lte('0', c)
    | true => Nat/lte(c, '9')
    | false => false
    end;

pub let is_lower(c : Nat) -> Bln =
    match Nat/lte('a', c)
    | true => Nat/lte(c, 'z')
    | false => false
    end;

pub let is_upper(c : Nat) -> Bln =
    match Nat/lte('A', c)
    | true => Nat/lte(c, 'Z')
    | false => false
    end;

pub let is_alpha(c : Nat) -> Bln =
    match is_lower(c)
    | true => true
    | false => is_upper(c)
    end;

pub let is_alphanumeric(c : Nat) -> Bln =
    match is_alpha(c)
    | true => true
    | false => is_digit(c)
    end;

pub let to_lower(c : Nat) -> Nat =
    match is_upper(c)
    | true => Nat/add(c, 0x20)
    | false => c
    end;

pub let to_upper(c : Nat) -> Nat =
    match is_lower(c)
    | true => Nat/sub(c, 0x20)
    | false => c
    end;
