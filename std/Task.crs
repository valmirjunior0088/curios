use /std/{Io, Bin, Nat, Bln, Arr, Lst, Result};

let READ : Nat = 1;
let WRITE : Nat = 2;
let ERR : Nat = 4;
let HUP : Nat = 8;

let OK : Nat = 0;
let EOF : Nat = 1;
let WOULD_BLOCK : Nat = 6;

pub let Finalizer : Type =
    () -> {};

pub let Guard : Type =
    { Io, Finalizer };

pub union Task(A : Type)
| done(A)
| wait(Io, Nat, (() -> Task(A)))
| spawn(Lst(Guard), Task({}), (() -> Task(A)))
| acquire(Io, (() -> {}), (() -> Task(A)))
| release(Io, (() -> Task(A)))
| scope((() -> Task(A)))
| join((() -> Task(A)))
| cancel((() -> Task(A)))
end

pub use Task/*;

pub let pure(@A : Type, a : A) -> Task(A) =
    Task/done(a);

pub rec bind(@A : Type, @B : Type) -> (Task(A), (A) -> Task(B)) -> Task(B) =
    (m, f) =>
        match m : Task(B)
        | done(a) => f(a)
        | wait(h, ev, k) => Task/wait(h, ev, () => bind(k(), f))
        | spawn(gs, child, k) => Task/spawn(gs, child, () => bind(k(), f))
        | acquire(h, fin, k) => Task/acquire(h, fin, () => bind(k(), f))
        | release(h, k) => Task/release(h, () => bind(k(), f))
        | scope(k) => Task/scope(() => bind(k(), f))
        | join(k) => Task/join(() => bind(k(), f))
        | cancel(k) => Task/cancel(() => bind(k(), f))
        end;

pub let using(@A : Type, h : Io, release : Finalizer, body : Task(A)) -> Task(A) =
    Task/acquire(h, release, () =>
        bind(body, (a) =>
            Task/release(h, () => Task/done(a))));

pub let nonblocking(h : Io) -> {} =
    let _ = /sys/Io/set_nonblocking(h, true);
    ();

pub rec read(h : Io, n : Nat) -> Task(Io/Read) =
    let r = /sys/Io/read(h, n);
    match Nat/eql(r.status, WOULD_BLOCK) : Task(Io/Read)
    | true => Task/wait(h, READ, () => read(h, n))
    | false =>
        match Nat/eql(r.status, EOF) : Task(Io/Read)
        | true => Task/done(Io/Read/eof())
        | false =>
            match Nat/eql(r.status, OK) : Task(Io/Read)
            | true => Task/done(Io/Read/chunk(r.bytes))
            | false => Task/done(Io/Read/error(Io/error_of(r.status)))
            end
        end
    end;

pub rec write(h : Io, b : Bin) -> Task(Result({}, Io/Error)) =
    let r = /sys/Io/write(h, b);
    match Nat/eql(r.status, WOULD_BLOCK) : Task(Result({}, Io/Error))
    | true => Task/wait(h, WRITE, () => write(h, b))
    | false =>
        match Nat/eql(r.status, OK) : Task(Result({}, Io/Error))
        | true =>
            match Nat/lt(r.written, Bin/len(b)) : Task(Result({}, Io/Error))
            | true => Task/wait(h, WRITE, () => write(h, Bin/slice(b, r.written, Bin/len(b))))
            | false => Task/done(Result/success(()))
            end
        | false => Task/done(Result/failure(Io/error_of(r.status)))
        end
    end;

pub rec accept(l : Io) -> Task(Result(Io, Io/Error)) =
    let r = /sys/Io/accept(l);
    match Nat/eql(r.status, WOULD_BLOCK) : Task(Result(Io, Io/Error))
    | true => Task/wait(l, READ, () => accept(l))
    | false =>
        match Nat/eql(r.status, OK) : Task(Result(Io, Io/Error))
        | true => Task/done(Result/success(r.handle))
        | false => Task/done(Result/failure(Io/error_of(r.status)))
        end
    end;

pub let go(child : Task({})) -> Task({}) =
    Task/spawn(Lst/nil(), child, () => Task/done(()));

pub let go_using(h : Io, release : Finalizer, body : Task({})) -> Task({}) =
    Task/spawn(Lst/cons((h, release), Lst/nil()), body, () => Task/done(()));

pub let nursery(@A : Type, body : Task(A)) -> Task(A) =
    Task/scope(() => bind(body, (a) => Task/join(() => Task/done(a))));

pub let scoped(@A : Type, body : Task(A)) -> Task(A) =
    Task/scope(() => bind(body, (a) => Task/cancel(() => Task/done(a))));

pub union Fiber
| fiber(@A : Type, Task(A), Lst(Guard), Lst(Nat))
end

pub use Fiber/*;

struct Parked pub {
    handle : Io,
    interest : Nat,
    guards : Lst(Guard),
    groups : Lst(Nat),
    resume : (() -> Fiber)
}

struct Joined pub {
    awaited : Nat,
    groups : Lst(Nat),
    guards : Lst(Guard),
    resume : (() -> Fiber)
}

struct World pub {
    ready : Lst(Fiber),
    blocked : Lst(Parked),
    joining : Lst(Joined),
    cancelled : Lst(Nat),
    next_id : Nat
}

let is_ready(results : Nat, interest : Nat) -> Bln =
    Nat/gt(Nat/and(results, Nat/add(interest, Nat/add(ERR, HUP))), 0);

let partition(blocked : Lst(Parked), results : Arr(Nat), start : Nat) -> { Lst(Fiber), Lst(Parked) } =
    rec walk(rest : Lst(Parked), i : Nat, woken : Lst(Fiber), still : Lst(Parked)) -> { Lst(Fiber), Lst(Parked) } =
        match rest : { Lst(Fiber), Lst(Parked) }
        | nil() => (woken, still)
        | cons(p, tail) =>
            match is_ready(Arr/get(results, i), p.interest) : { Lst(Fiber), Lst(Parked) }
            | true =>
                let resume = p.resume;
                walk(tail, Nat/add(i, 1), Lst/cons(resume(), woken), still)
            | false => walk(tail, Nat/add(i, 1), woken, Lst/cons(p, still))
            end
        end;
    walk(blocked, start, Lst/nil(), Lst/nil());

let run_all(gs : Lst(Guard)) -> {} =
    rec go(rest : Lst(Guard)) -> {} =
        match rest : {}
        | nil() => ()
        | cons(g, more) => let _ = g.1(); go(more)
        end;
    go(gs);

let release_guard(h : Io, gs : Lst(Guard)) -> Lst(Guard) =
    rec go(rest : Lst(Guard)) -> Lst(Guard) =
        match rest : Lst(Guard)
        | nil() => Lst/nil()
        | cons(g, more) =>
            match /sys/Io/eql(g.0, h) : Lst(Guard)
            | true => let _ = g.1(); more
            | false => Lst/cons(g, go(more))
            end
        end;
    go(gs);

let mem(x : Nat, xs : Lst(Nat)) -> Bln =
    rec go(rest : Lst(Nat)) -> Bln =
        match rest : Bln
        | nil() => false
        | cons(y, more) =>
            match Nat/eql(x, y) : Bln
            | true => true
            | false => go(more)
            end
        end;
    go(xs);

let cancelled_any(groups : Lst(Nat), cancelled : Lst(Nat)) -> Bln =
    rec go(rest : Lst(Nat)) -> Bln =
        match rest : Bln
        | nil() => false
        | cons(g, more) =>
            match mem(g, cancelled) : Bln
            | true => true
            | false => go(more)
            end
        end;
    go(groups);

let group_in_fibers(g : Nat, fs : Lst(Fiber)) -> Bln =
    rec go(rest : Lst(Fiber)) -> Bln =
        match rest : Bln
        | nil() => false
        | cons(f, more) =>
            match f : Bln
            | fiber(_, _, _, fg) =>
                match mem(g, fg) : Bln
                | true => true
                | false => go(more)
                end
            end
        end;
    go(fs);

let group_in_parked(g : Nat, ps : Lst(Parked)) -> Bln =
    rec go(rest : Lst(Parked)) -> Bln =
        match rest : Bln
        | nil() => false
        | cons(p, more) =>
            match mem(g, p.groups) : Bln
            | true => true
            | false => go(more)
            end
        end;
    go(ps);

let group_in_joining(g : Nat, js : Lst(Joined)) -> Bln =
    rec go(rest : Lst(Joined)) -> Bln =
        match rest : Bln
        | nil() => false
        | cons(j, more) =>
            match Nat/eql(j.awaited, g) : Bln
            | true => go(more)
            | false =>
                match mem(g, j.groups) : Bln
                | true => true
                | false => go(more)
                end
            end
        end;
    go(js);

let group_present(g : Nat, ready : Lst(Fiber), blocked : Lst(Parked), joining : Lst(Joined)) -> Bln =
    match group_in_fibers(g, ready) : Bln
    | true => true
    | false =>
        match group_in_parked(g, blocked) : Bln
        | true => true
        | false => group_in_joining(g, joining)
        end
    end;

let sweep_blocked(blocked : Lst(Parked), cancelled : Lst(Nat)) -> Lst(Parked) =
    rec go(rest : Lst(Parked)) -> Lst(Parked) =
        match rest : Lst(Parked)
        | nil() => Lst/nil()
        | cons(p, more) =>
            match cancelled_any(p.groups, cancelled) : Lst(Parked)
            | true => let _ = run_all(p.guards); go(more)
            | false => Lst/cons(p, go(more))
            end
        end;
    go(blocked);

let sweep_joining(joining : Lst(Joined), cancelled : Lst(Nat)) -> Lst(Joined) =
    rec go(rest : Lst(Joined)) -> Lst(Joined) =
        match rest : Lst(Joined)
        | nil() => Lst/nil()
        | cons(j, more) =>
            match cancelled_any(j.groups, cancelled) : Lst(Joined)
            | true => let _ = run_all(j.guards); go(more)
            | false => Lst/cons(j, go(more))
            end
        end;
    go(joining);

let wake(joining : Lst(Joined), ready : Lst(Fiber), blocked : Lst(Parked)) -> { Lst(Fiber), Lst(Joined) } =
    rec go(rest : Lst(Joined), woken : Lst(Fiber), still : Lst(Joined)) -> { Lst(Fiber), Lst(Joined) } =
        match rest : { Lst(Fiber), Lst(Joined) }
        | nil() => (woken, still)
        | cons(j, more) =>
            match group_present(j.awaited, ready, blocked, joining) : { Lst(Fiber), Lst(Joined) }
            | true => go(more, woken, Lst/cons(j, still))
            | false =>
                let resume = j.resume;
                go(more, Lst/cons(resume(), woken), still)
            end
        end;
    go(joining, Lst/nil(), Lst/nil());

let drain_joining(joining : Lst(Joined)) -> {} =
    rec go(rest : Lst(Joined)) -> {} =
        match rest : {}
        | nil() => ()
        | cons(j, more) => let _ = run_all(j.guards); go(more)
        end;
    go(joining);

let app_ids(xs : Lst(Nat), tail : Lst(Nat)) -> Lst(Nat) =
    rec go(rest : Lst(Nat)) -> Lst(Nat) =
        match rest : Lst(Nat)
        | nil() => tail
        | cons(x, more) => Lst/cons(x, go(more))
        end;
    go(xs);

let splice(xs : Lst(Fiber), tail : Lst(Fiber)) -> Lst(Fiber) =
    rec go(rest : Lst(Fiber)) -> Lst(Fiber) =
        match rest : Lst(Fiber)
        | nil() => tail
        | cons(x, more) => Lst/cons(x, go(more))
        end;
    go(xs);

let run_fiber_fins(f : Fiber) -> {} =
    match f : {}
    | fiber(_, _, gs, _) => run_all(gs)
    end;

let fiber_cancelled(f : Fiber, cancelled : Lst(Nat)) -> Bln =
    match f : Bln
    | fiber(_, _, _, fg) => cancelled_any(fg, cancelled)
    end;

union Stepped
| advanced(Lst(Fiber), Nat)
| parked(Parked, Nat)
| joined(Joined, Lst(Nat), Nat)
end

let step(f : Fiber, next_id : Nat) -> Stepped =
    match f : Stepped
    | fiber(_, t, guards, groups) =>
        match t : Stepped
        | done(_) =>
            let _ = run_all(guards);
            Stepped/advanced(Lst/nil(), next_id)
        | spawn(gs, child, k) =>
            Stepped/advanced(
                Lst/cons(Fiber/fiber(k(), guards, groups), Lst/cons(Fiber/fiber(child, gs, groups), Lst/nil())),
                next_id)
        | acquire(h, fin, k) =>
            Stepped/advanced(Lst/cons(Fiber/fiber(k(), Lst/cons((h, fin), guards), groups), Lst/nil()), next_id)
        | release(h, k) =>
            let gs = release_guard(h, guards);
            Stepped/advanced(Lst/cons(Fiber/fiber(k(), gs, groups), Lst/nil()), next_id)
        | wait(h, ev, k) =>
            Stepped/parked(Parked { handle = h, interest = ev, guards = guards, groups = groups, resume = () => Fiber/fiber(k(), guards, groups) }, next_id)
        | scope(k) =>
            Stepped/advanced(Lst/cons(Fiber/fiber(k(), guards, Lst/cons(next_id, groups)), Lst/nil()), Nat/add(next_id, 1))
        | join(k) =>
            match groups : Stepped
            | cons(g, rest) =>
                Stepped/joined(Joined { awaited = g, groups = rest, guards = guards, resume = () => Fiber/fiber(k(), guards, rest) }, Lst/nil(), next_id)
            | nil() => Stepped/advanced(Lst/cons(Fiber/fiber(k(), guards, groups), Lst/nil()), next_id)
            end
        | cancel(k) =>
            match groups : Stepped
            | cons(g, rest) =>
                Stepped/joined(Joined { awaited = g, groups = rest, guards = guards, resume = () => Fiber/fiber(k(), guards, rest) }, Lst/cons(g, Lst/nil()), next_id)
            | nil() => Stepped/advanced(Lst/cons(Fiber/fiber(k(), guards, groups), Lst/nil()), next_id)
            end
        end
    end;

let housekeep(w : World) -> World =
    let blocked1 = sweep_blocked(w.blocked, w.cancelled);
    let joining1 = sweep_joining(w.joining, w.cancelled);
    let woken = wake(joining1, w.ready, blocked1);
    World {
        ready = splice(woken.0, w.ready),
        blocked = blocked1,
        joining = woken.1,
        cancelled = w.cancelled,
        next_id = w.next_id
    };

let drive(w : World) -> World =
    match w.ready : World
    | cons(f, rest) =>
        match fiber_cancelled(f, w.cancelled) : World
        | true =>
            let _ = run_fiber_fins(f);
            World { ready = rest, blocked = w.blocked, joining = w.joining, cancelled = w.cancelled, next_id = w.next_id }
        | false =>
            match step(f, w.next_id) : World
            | advanced(news, nid) =>
                World { ready = splice(news, rest), blocked = w.blocked, joining = w.joining, cancelled = w.cancelled, next_id = nid }
            | parked(p, nid) =>
                World { ready = rest, blocked = Lst/cons(p, w.blocked), joining = w.joining, cancelled = w.cancelled, next_id = nid }
            | joined(j, gc, nid) =>
                World { ready = rest, blocked = w.blocked, joining = Lst/cons(j, w.joining), cancelled = app_ids(gc, w.cancelled), next_id = nid }
            end
        end
    | nil() =>
        match w.blocked : World
        | cons(_, _) =>
            let handles = Lst/to_arr(Lst/map((p) => p.handle, w.blocked));
            let events = Lst/to_arr(Lst/map((p) => p.interest, w.blocked));
            let results = /sys/Io/poll(handles, events, -1);
            let split = partition(w.blocked, results, 0);
            World { ready = split.0, blocked = split.1, joining = w.joining, cancelled = w.cancelled, next_id = w.next_id }
        | nil() => w
        end
    end;

rec schedule(w : World) -> {} =
    let h = housekeep(w);
    match h.ready : {}
    | cons(_, _) => schedule(drive(h))
    | nil() =>
        match h.blocked : {}
        | cons(_, _) => schedule(drive(h))
        | nil() => drain_joining(h.joining)
        end
    end;

pub let block_on(@A : Type, t : Task(A)) -> A =
    rec loop(root : Task(A), rgroups : Lst(Nat), rguards : Lst(Guard), w : World) -> A =
        let h = housekeep(w);
        match root : A
        | done(a) =>
            let _ = run_all(rguards);
            let _ = schedule(World { ready = h.ready, blocked = h.blocked, joining = h.joining, cancelled = Lst/cons(0, h.cancelled), next_id = h.next_id });
            a
        | spawn(gs, child, k) =>
            loop(k(), rgroups, rguards,
                World { ready = Lst/cons(Fiber/fiber(child, gs, rgroups), h.ready), blocked = h.blocked, joining = h.joining, cancelled = h.cancelled, next_id = h.next_id })
        | acquire(gh, fin, k) =>
            loop(k(), rgroups, Lst/cons((gh, fin), rguards), h)
        | release(gh, k) =>
            let gs = release_guard(gh, rguards);
            loop(k(), rgroups, gs, h)
        | scope(k) =>
            let g = h.next_id;
            loop(k(), Lst/cons(g, rgroups), rguards,
                World { ready = h.ready, blocked = h.blocked, joining = h.joining, cancelled = h.cancelled, next_id = Nat/add(g, 1) })
        | cancel(k) =>
            match rgroups : A
            | cons(g, grest) =>
                loop(Task/join(k), rgroups, rguards,
                    World { ready = h.ready, blocked = h.blocked, joining = h.joining, cancelled = Lst/cons(g, h.cancelled), next_id = h.next_id })
            | nil() => loop(k(), rgroups, rguards, h)
            end
        | join(k) =>
            match rgroups : A
            | cons(g, grest) =>
                match group_present(g, h.ready, h.blocked, h.joining) : A
                | false => loop(k(), grest, rguards, h)
                | true =>
                    match h.ready : A
                    | cons(_, _) => loop(Task/join(k), rgroups, rguards, drive(h))
                    | nil() =>
                        match h.blocked : A
                        | cons(_, _) => loop(Task/join(k), rgroups, rguards, drive(h))
                        | nil() => loop(k(), grest, rguards, h)
                        end
                    end
                end
            | nil() => loop(k(), rgroups, rguards, h)
            end
        | wait(rh, rev, rk) =>
            match h.ready : A
            | cons(_, _) => loop(Task/wait(rh, rev, rk), rgroups, rguards, drive(h))
            | nil() =>
                let handles = Lst/to_arr(Lst/cons(rh, Lst/map((p) => p.handle, h.blocked)));
                let events = Lst/to_arr(Lst/cons(rev, Lst/map((p) => p.interest, h.blocked)));
                let results = /sys/Io/poll(handles, events, -1);
                let split = partition(h.blocked, results, 1);
                match is_ready(Arr/get(results, 0), rev) : A
                | true => loop(rk(), rgroups, rguards, World { ready = split.0, blocked = split.1, joining = h.joining, cancelled = h.cancelled, next_id = h.next_id })
                | false => loop(Task/wait(rh, rev, rk), rgroups, rguards, World { ready = split.0, blocked = split.1, joining = h.joining, cancelled = h.cancelled, next_id = h.next_id })
                end
            end
        end;
    loop(t, Lst/cons(0, Lst/nil()), Lst/nil(),
        World { ready = Lst/nil(), blocked = Lst/nil(), joining = Lst/nil(), cancelled = Lst/nil(), next_id = 1 });

pub let run(main : Task({})) -> {} =
    let _ = block_on(main);
    ();
