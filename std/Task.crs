use /std/{Io, Bin, Nat, Bln, Arr, Lst, Result};

let READ : Nat = 1;
let WRITE : Nat = 2;
let ERR : Nat = 4;
let HUP : Nat = 8;

let OK : Nat = 0;
let EOF : Nat = 1;
let WOULD_BLOCK : Nat = 7;

-- The free monad the scheduler interprets. `done`/`wait`/`spawn` are the effect
-- and concurrency surface; `protect`/`unprotect` bracket a resource scope --
-- `protect` registers a synchronous finalizer (`({}) -> {}`, in practice a
-- `close`) on the running fiber, `unprotect` pops and runs the most recent one
-- when its scope exits normally. A fiber dropped or cancelled before reaching
-- its `unprotect` still has its finalizers run by the scheduler, so a resource
-- acquired through `using` is always released.
pub union Task(A : Type)
| done(A)
| wait(Io, Nat, (({}) -> Task(A)))
| spawn(Task({}), (({}) -> Task(A)))
| protect((({}) -> {}), (({}) -> Task(A)))
| unprotect((({}) -> Task(A)))
end

pub use Task/*;

pub let pure(@A : Type, a : A) -> Task(A) =
    Task/done(a);

pub rec bind(@A : Type, @B : Type) -> (Task(A), (A) -> Task(B)) -> Task(B) =
    (m, f) =>
        match m : Task(B)
        | done(a) => f(a)
        | wait(h, ev, k) => Task/wait(h, ev, (u) => bind(k(u), f))
        | spawn(child, k) => Task/spawn(child, (u) => bind(k(u), f))
        | protect(fin, k) => Task/protect(fin, (u) => bind(k(u), f))
        | unprotect(k) => Task/unprotect((u) => bind(k(u), f))
        end;

-- The resource bracket: acquire a resource, run `body` with it, and release it
-- exactly once -- when `body` completes, or when the fiber is dropped/cancelled
-- before it does. `release` is the synchronous finalizer (typically `close`).
pub let using(@R : Type, @A : Type, acquire : Task(R), release : (R) -> {}, body : (R) -> Task(A)) -> Task(A) =
    bind(acquire, (r) =>
        Task/protect((u) => release(r), (u) =>
            bind(body(r), (a) =>
                Task/unprotect((u) => Task/done(a)))));

pub let nonblocking(h : Io) -> {} =
    let status = /sys/Io/set_nonblocking(h, true);
    ();

-- Read up to `n` bytes, yielding on WOULD_BLOCK until the handle is readable.
-- The raw status never escapes: a successful read is `chunk`, end-of-stream is
-- the distinct `eof`, and a failure is `error` carrying a typed `Io/Error`.
pub rec read(h : Io, n : Nat) -> Task(Io/Read) =
    let r = Io/read(h, n);
    match Nat/eql(r.status, WOULD_BLOCK) : Task(Io/Read)
    | true => Task/wait(h, READ, (u) => read(h, n))
    | false =>
        match Nat/eql(r.status, EOF) : Task(Io/Read)
        | true => Task/done(Io/Read/eof())
        | false =>
            match Nat/eql(r.status, OK) : Task(Io/Read)
            | true => Task/done(Io/Read/chunk(r.bytes))
            | false => Task/done(Io/Read/error(Io/decode(r.status)))
            end
        end
    end;

-- Write `b`, yielding on WOULD_BLOCK until the handle is writable. A single
-- non-blocking write may take only a prefix (`written`); we resend exactly the
-- unwritten tail, never the bytes already accepted, so a large write is never
-- duplicated. The raw status never escapes: success is `success(())`, a failure
-- is `failure` carrying a typed `Io/Error`.
pub rec write(h : Io, b : Bin) -> Task(Result({}, Io/Error)) =
    let r = Io/write(h, b);
    match Nat/eql(r.status, WOULD_BLOCK) : Task(Result({}, Io/Error))
    | true => Task/wait(h, WRITE, (u) => write(h, b))
    | false =>
        match Nat/eql(r.status, OK) : Task(Result({}, Io/Error))
        | true =>
            match Nat/lt(r.written, Bin/len(b)) : Task(Result({}, Io/Error))
            | true => Task/wait(h, WRITE, (u) => write(h, Bin/slice(b, r.written, Bin/len(b))))
            | false => Task/done(Result/success(()))
            end
        | false => Task/done(Result/failure(Io/decode(r.status)))
        end
    end;

-- Accept the next inbound connection on listener `l`, yielding until one is
-- pending. Returns the raw connection handle on success; the caller (`/std/Net`)
-- wraps it in a `Socket` and brackets its close.
pub rec accept(l : Io) -> Task(Result(Io, Io/Error)) =
    let r = /sys/Io/accept(l);
    match Nat/eql(r.status, WOULD_BLOCK) : Task(Result(Io, Io/Error))
    | true => Task/wait(l, READ, (u) => accept(l))
    | false =>
        match Nat/eql(r.status, OK) : Task(Result(Io, Io/Error))
        | true => Task/done(Result/success(r.handle))
        | false => Task/done(Result/failure(Io/decode(r.status)))
        end
    end;

pub let go(child : Task({})) -> Task({}) =
    Task/spawn(child, (u) => Task/done(()));

-- A synchronous finalizer: run for effect at scope exit or on cancellation.
pub let Finalizer : Type = ({}) -> {};

-- A fiber: a `Task(A)` with its result type hidden behind an existential, so one
-- ready queue can hold tasks of differing result types, paired with the stack of
-- finalizers it has entered but not yet left. `@A` erases; the finalizer stack
-- is ordinary runtime state the scheduler threads, runs on normal scope exit,
-- and runs on drop so nothing leaks.
pub union Fiber
| fiber(@A : Type, Task(A), Lst(Finalizer))
end

pub use Fiber/*;

-- A parked fiber. Its resume re-packs into `Fiber`, resealing the existential
-- and carrying the finalizer stack forward; the explicit `finalizers` field lets
-- the scheduler run them if the fiber is dropped while parked, without resuming.
struct Parked pub { handle : Io, interest : Nat, finalizers : Lst(Finalizer), resume : (({}) -> Fiber) }

let is_ready(results : Nat, interest : Nat) -> Bln =
    Nat/gt(Nat/and(results, Nat/add(interest, Nat/add(ERR, HUP))), 0);

let partition(blocked : Lst(Parked), results : Arr(Nat), start : Nat) -> { Lst(Fiber), Lst(Parked) } =
    rec walk(rest : Lst(Parked), i : Nat, woken : Lst(Fiber), still : Lst(Parked)) -> { Lst(Fiber), Lst(Parked) } =
        match rest : { Lst(Fiber), Lst(Parked) }
        | nil() => (woken, still)
        | cons(p, tail) =>
            match is_ready(Arr/get(results, i), p.interest) : { Lst(Fiber), Lst(Parked) }
            | true =>
                let resume = p.resume;
                walk(tail, Nat/add(i, 1), Lst/cons(resume(()), woken), still)
            | false => walk(tail, Nat/add(i, 1), woken, Lst/cons(p, still))
            end
        end;
    walk(blocked, start, Lst/nil(), Lst/nil());

-- Run a finalizer stack for effect, most-recent first.
let run_all(fins : Lst(Finalizer)) -> {} =
    rec go(rest : Lst(Finalizer)) -> {} =
        match rest : {}
        | nil() => ()
        | cons(fin, more) => let ran = fin(()); go(more)
        end;
    go(fins);

let drain_blocked(blocked : Lst(Parked)) -> {} =
    rec go(rest : Lst(Parked)) -> {} =
        match rest : {}
        | nil() => ()
        | cons(p, more) => let ran = run_all(p.finalizers); go(more)
        end;
    go(blocked);

-- A bounded, best-effort shutdown drain that does NOT poll. It steps each ready
-- fiber to its next park or completion: a finished fiber drops cleanly, a fiber
-- that would block is cancelled with its finalizers run, and every still-parked
-- fiber is finalized too. This is where cancellation-safe `close` happens when a
-- root completes with children still outstanding.
rec drain(ready : Lst(Fiber), blocked : Lst(Parked)) -> {} =
    match ready : {}
    | nil() => drain_blocked(blocked)
    | cons(f, rest) =>
        match f : {}
        | fiber(_, t, fins) =>
            match t : {}
            | done(_) => let ran = run_all(fins); drain(rest, blocked)
            | wait(_, _, _) => let ran = run_all(fins); drain(rest, blocked)
            | spawn(child, k) =>
                drain(Lst/cons(Fiber/fiber(k(()), fins), Lst/cons(Fiber/fiber(child, Lst/nil()), rest)), blocked)
            | protect(fin, k) =>
                drain(Lst/cons(Fiber/fiber(k(()), Lst/cons(fin, fins)), rest), blocked)
            | unprotect(k) =>
                match fins : {}
                | cons(top, more) => let ran = top(()); drain(Lst/cons(Fiber/fiber(k(()), more), rest), blocked)
                | nil() => drain(Lst/cons(Fiber/fiber(k(()), Lst/nil()), rest), blocked)
                end
            end
        end
    end;

-- Run a set of fibers to completion, multiplexing them over one `Io/poll`.
-- Fire-and-forget: each fiber's result is discarded. `run` only returns once
-- everything has finished, so no fiber is ever dropped here; finalizers fire
-- through the normal `protect`/`unprotect` discipline.
pub rec run(ready : Lst(Fiber), blocked : Lst(Parked)) -> {} =
    match ready : {}
    | cons(f, rest) =>
        match f : {}
        | fiber(_, t, fins) =>
            match t : {}
            | done(_) => let ran = run_all(fins); run(rest, blocked)
            | wait(h, ev, k) =>
                run(rest, Lst/cons(Parked { handle = h, interest = ev, finalizers = fins, resume = (u) => Fiber/fiber(k(u), fins) }, blocked))
            | spawn(child, k) =>
                run(Lst/cons(Fiber/fiber(k(()), fins), Lst/cons(Fiber/fiber(child, Lst/nil()), rest)), blocked)
            | protect(fin, k) =>
                run(Lst/cons(Fiber/fiber(k(()), Lst/cons(fin, fins)), rest), blocked)
            | unprotect(k) =>
                match fins : {}
                | cons(top, more) => let ran = top(()); run(Lst/cons(Fiber/fiber(k(()), more), rest), blocked)
                | nil() => run(Lst/cons(Fiber/fiber(k(()), Lst/nil()), rest), blocked)
                end
            end
        end
    | nil() =>
        match blocked : {}
        | nil() => ()
        | cons(_, _) =>
            let handles = Lst/to_arr(Lst/map((p) => p.handle, blocked));
            let events = Lst/to_arr(Lst/map((p) => p.interest, blocked));
            let results = Io/poll(handles, events, -1);
            let split = partition(blocked, results, 0);
            run(split.0, split.1)
        end
    end;

-- Drive one fiber to its value while multiplexing any fibers it spawns. The root
-- stays an un-boxed `Task(A)` in its own poll slot (index 0); spawned children
-- ride the same machinery as `run`. The root carries its own finalizer stack
-- (`root_fins`). When the root completes, its remaining finalizers run and any
-- outstanding children are drained -- runnable work finishes, blocked work is
-- cancelled and finalized -- so nothing the program acquired is left open.
pub let block_on(@A : Type, t : Task(A)) -> A =
    rec loop(root : Task(A), root_fins : Lst(Finalizer), ready : Lst(Fiber), blocked : Lst(Parked)) -> A =
        match root : A
        | done(a) =>
            let cleaned = run_all(root_fins);
            let dropped = drain(ready, blocked);
            a
        | protect(fin, k) => loop(k(()), Lst/cons(fin, root_fins), ready, blocked)
        | unprotect(k) =>
            match root_fins : A
            | cons(top, more) => let ran = top(()); loop(k(()), more, ready, blocked)
            | nil() => loop(k(()), Lst/nil(), ready, blocked)
            end
        | spawn(child, k) => loop(k(()), root_fins, Lst/cons(Fiber/fiber(child, Lst/nil()), ready), blocked)
        | wait(rh, rev, rk) =>
            match ready : A
            | cons(f, rest) =>
                match f : A
                | fiber(_, ct, cfins) =>
                    match ct : A
                    | done(_) => let ran = run_all(cfins); loop(Task/wait(rh, rev, rk), root_fins, rest, blocked)
                    | wait(ch, cev, ck) =>
                        loop(Task/wait(rh, rev, rk), root_fins, rest,
                            Lst/cons(Parked { handle = ch, interest = cev, finalizers = cfins, resume = (u) => Fiber/fiber(ck(u), cfins) }, blocked))
                    | spawn(gc, ck) =>
                        loop(Task/wait(rh, rev, rk), root_fins,
                            Lst/cons(Fiber/fiber(ck(()), cfins), Lst/cons(Fiber/fiber(gc, Lst/nil()), rest)), blocked)
                    | protect(fin, ck) =>
                        loop(Task/wait(rh, rev, rk), root_fins,
                            Lst/cons(Fiber/fiber(ck(()), Lst/cons(fin, cfins)), rest), blocked)
                    | unprotect(ck) =>
                        match cfins : A
                        | cons(top, more) => let ran = top(()); loop(Task/wait(rh, rev, rk), root_fins, Lst/cons(Fiber/fiber(ck(()), more), rest), blocked)
                        | nil() => loop(Task/wait(rh, rev, rk), root_fins, Lst/cons(Fiber/fiber(ck(()), Lst/nil()), rest), blocked)
                        end
                    end
                end
            | nil() =>
                let handles = Lst/to_arr(Lst/cons(rh, Lst/map((p) => p.handle, blocked)));
                let events = Lst/to_arr(Lst/cons(rev, Lst/map((p) => p.interest, blocked)));
                let results = Io/poll(handles, events, -1);
                let split = partition(blocked, results, 1);
                match is_ready(Arr/get(results, 0), rev) : A
                | true => loop(rk(()), root_fins, split.0, split.1)
                | false => loop(Task/wait(rh, rev, rk), root_fins, split.0, split.1)
                end
            end
        end;
    loop(t, Lst/nil(), Lst/nil(), Lst/nil());
