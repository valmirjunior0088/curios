use /std/{Io, Bin, Nat, Bln, Arr, Lst, Result};

let READ : Nat = 1;
let WRITE : Nat = 2;
let ERR : Nat = 4;
let HUP : Nat = 8;

let OK : Nat = 0;
let EOF : Nat = 1;
let WOULD_BLOCK : Nat = 7;

pub union Task(A : Type)
| done(A)
| wait(Io, Nat, (() -> Task(A)))
| spawn(Task({}), (() -> Task(A)))
| spawn_guard((() -> {}), Task({}), (() -> Task(A)))
| protect((() -> {}), (() -> Task(A)))
| unprotect((() -> Task(A)))
| open((() -> Task(A)))
| join((() -> Task(A)))
| close((() -> Task(A)))
end

pub use Task/*;

pub let pure(@A : Type, a : A) -> Task(A) =
    Task/done(a);

pub rec bind(@A : Type, @B : Type) -> (Task(A), (A) -> Task(B)) -> Task(B) =
    (m, f) =>
        match m : Task(B)
        | done(a) => f(a)
        | wait(h, ev, k) => Task/wait(h, ev, () => bind(k(), f))
        | spawn(child, k) => Task/spawn(child, () => bind(k(), f))
        | spawn_guard(fin, child, k) => Task/spawn_guard(fin, child, () => bind(k(), f))
        | protect(fin, k) => Task/protect(fin, () => bind(k(), f))
        | unprotect(k) => Task/unprotect(() => bind(k(), f))
        | open(k) => Task/open(() => bind(k(), f))
        | join(k) => Task/join(() => bind(k(), f))
        | close(k) => Task/close(() => bind(k(), f))
        end;

pub let using(@R : Type, @A : Type, acquire : Task(R), release : (R) -> {}, body : (R) -> Task(A)) -> Task(A) =
    bind(acquire, (r) =>
        Task/protect(() => release(r), () =>
            bind(body(r), (a) =>
                Task/unprotect(() => Task/done(a)))));

pub let nonblocking(h : Io) -> {} =
    let status = /sys/Io/set_nonblocking(h, true);
    ();

pub rec read(h : Io, n : Nat) -> Task(Io/Read) =
    let r = Io/read(h, n);
    match Nat/eql(r.status, WOULD_BLOCK) : Task(Io/Read)
    | true => Task/wait(h, READ, () => read(h, n))
    | false =>
        match Nat/eql(r.status, EOF) : Task(Io/Read)
        | true => Task/done(Io/Read/eof())
        | false =>
            match Nat/eql(r.status, OK) : Task(Io/Read)
            | true => Task/done(Io/Read/chunk(r.bytes))
            | false => Task/done(Io/Read/error(Io/decode(r.status)))
            end
        end
    end;

pub rec write(h : Io, b : Bin) -> Task(Result({}, Io/Error)) =
    let r = Io/write(h, b);
    match Nat/eql(r.status, WOULD_BLOCK) : Task(Result({}, Io/Error))
    | true => Task/wait(h, WRITE, () => write(h, b))
    | false =>
        match Nat/eql(r.status, OK) : Task(Result({}, Io/Error))
        | true =>
            match Nat/lt(r.written, Bin/len(b)) : Task(Result({}, Io/Error))
            | true => Task/wait(h, WRITE, () => write(h, Bin/slice(b, r.written, Bin/len(b))))
            | false => Task/done(Result/success(()))
            end
        | false => Task/done(Result/failure(Io/decode(r.status)))
        end
    end;

pub rec accept(l : Io) -> Task(Result(Io, Io/Error)) =
    let r = /sys/Io/accept(l);
    match Nat/eql(r.status, WOULD_BLOCK) : Task(Result(Io, Io/Error))
    | true => Task/wait(l, READ, () => accept(l))
    | false =>
        match Nat/eql(r.status, OK) : Task(Result(Io, Io/Error))
        | true => Task/done(Result/success(r.handle))
        | false => Task/done(Result/failure(Io/decode(r.status)))
        end
    end;

pub let go(child : Task({})) -> Task({}) =
    Task/spawn(child, () => Task/done(()));

pub let go_using(@R : Type, r : R, release : (R) -> {}, body : (R) -> Task({})) -> Task({}) =
    Task/spawn_guard(() => release(r), body(r), () => Task/done(()));

pub let nursery(@A : Type, body : Task(A)) -> Task(A) =
    Task/open(() => bind(body, (a) => Task/join(() => Task/done(a))));

pub let scoped(@A : Type, body : Task(A)) -> Task(A) =
    Task/open(() => bind(body, (a) => Task/close(() => Task/done(a))));

pub let Finalizer : Type = () -> {};

pub union Fiber
| fiber(@A : Type, Task(A), Lst(Finalizer), Lst(Nat))
end

pub use Fiber/*;

struct Parked pub {
    handle : Io,
    interest : Nat,
    finalizers : Lst(Finalizer),
    groups : Lst(Nat),
    resume : (() -> Fiber)
}

struct Joined pub {
    awaited : Nat,
    groups : Lst(Nat),
    finalizers : Lst(Finalizer),
    resume : (() -> Fiber)
}

let is_ready(results : Nat, interest : Nat) -> Bln =
    Nat/gt(Nat/and(results, Nat/add(interest, Nat/add(ERR, HUP))), 0);

let partition(blocked : Lst(Parked), results : Arr(Nat), start : Nat) -> { Lst(Fiber), Lst(Parked) } =
    rec walk(rest : Lst(Parked), i : Nat, woken : Lst(Fiber), still : Lst(Parked)) -> { Lst(Fiber), Lst(Parked) } =
        match rest : { Lst(Fiber), Lst(Parked) }
        | nil() => (woken, still)
        | cons(p, tail) =>
            match is_ready(Arr/get(results, i), p.interest) : { Lst(Fiber), Lst(Parked) }
            | true =>
                let resume = p.resume;
                walk(tail, Nat/add(i, 1), Lst/cons(resume(), woken), still)
            | false => walk(tail, Nat/add(i, 1), woken, Lst/cons(p, still))
            end
        end;
    walk(blocked, start, Lst/nil(), Lst/nil());

let run_all(fins : Lst(Finalizer)) -> {} =
    rec go(rest : Lst(Finalizer)) -> {} =
        match rest : {}
        | nil() => ()
        | cons(fin, more) => let ran = fin(); go(more)
        end;
    go(fins);

let mem(x : Nat, xs : Lst(Nat)) -> Bln =
    rec go(rest : Lst(Nat)) -> Bln =
        match rest : Bln
        | nil() => false
        | cons(y, more) =>
            match Nat/eql(x, y) : Bln
            | true => true
            | false => go(more)
            end
        end;
    go(xs);

let cancelled_any(groups : Lst(Nat), cancelled : Lst(Nat)) -> Bln =
    rec go(rest : Lst(Nat)) -> Bln =
        match rest : Bln
        | nil() => false
        | cons(g, more) =>
            match mem(g, cancelled) : Bln
            | true => true
            | false => go(more)
            end
        end;
    go(groups);

let group_in_fibers(g : Nat, fs : Lst(Fiber)) -> Bln =
    rec go(rest : Lst(Fiber)) -> Bln =
        match rest : Bln
        | nil() => false
        | cons(f, more) =>
            match f : Bln
            | fiber(_, _, _, fg) =>
                match mem(g, fg) : Bln
                | true => true
                | false => go(more)
                end
            end
        end;
    go(fs);

let group_in_parked(g : Nat, ps : Lst(Parked)) -> Bln =
    rec go(rest : Lst(Parked)) -> Bln =
        match rest : Bln
        | nil() => false
        | cons(p, more) =>
            match mem(g, p.groups) : Bln
            | true => true
            | false => go(more)
            end
        end;
    go(ps);

let group_in_joining(g : Nat, js : Lst(Joined)) -> Bln =
    rec go(rest : Lst(Joined)) -> Bln =
        match rest : Bln
        | nil() => false
        | cons(j, more) =>
            match Nat/eql(j.awaited, g) : Bln
            | true => go(more)
            | false =>
                match mem(g, j.groups) : Bln
                | true => true
                | false => go(more)
                end
            end
        end;
    go(js);

let group_present(g : Nat, ready : Lst(Fiber), blocked : Lst(Parked), joining : Lst(Joined)) -> Bln =
    match group_in_fibers(g, ready) : Bln
    | true => true
    | false =>
        match group_in_parked(g, blocked) : Bln
        | true => true
        | false => group_in_joining(g, joining)
        end
    end;

let sweep_blocked(blocked : Lst(Parked), cancelled : Lst(Nat)) -> Lst(Parked) =
    rec go(rest : Lst(Parked)) -> Lst(Parked) =
        match rest : Lst(Parked)
        | nil() => Lst/nil()
        | cons(p, more) =>
            match cancelled_any(p.groups, cancelled) : Lst(Parked)
            | true => let ran = run_all(p.finalizers); go(more)
            | false => Lst/cons(p, go(more))
            end
        end;
    go(blocked);

let sweep_joining(joining : Lst(Joined), cancelled : Lst(Nat)) -> Lst(Joined) =
    rec go(rest : Lst(Joined)) -> Lst(Joined) =
        match rest : Lst(Joined)
        | nil() => Lst/nil()
        | cons(j, more) =>
            match cancelled_any(j.groups, cancelled) : Lst(Joined)
            | true => let ran = run_all(j.finalizers); go(more)
            | false => Lst/cons(j, go(more))
            end
        end;
    go(joining);

let wake(joining : Lst(Joined), ready : Lst(Fiber), blocked : Lst(Parked)) -> { Lst(Fiber), Lst(Joined) } =
    rec go(rest : Lst(Joined), woken : Lst(Fiber), still : Lst(Joined)) -> { Lst(Fiber), Lst(Joined) } =
        match rest : { Lst(Fiber), Lst(Joined) }
        | nil() => (woken, still)
        | cons(j, more) =>
            match group_present(j.awaited, ready, blocked, joining) : { Lst(Fiber), Lst(Joined) }
            | true => go(more, woken, Lst/cons(j, still))
            | false =>
                let resume = j.resume;
                go(more, Lst/cons(resume(), woken), still)
            end
        end;
    go(joining, Lst/nil(), Lst/nil());

let drain_joining(joining : Lst(Joined)) -> {} =
    rec go(rest : Lst(Joined)) -> {} =
        match rest : {}
        | nil() => ()
        | cons(j, more) => let ran = run_all(j.finalizers); go(more)
        end;
    go(joining);

let app_ids(xs : Lst(Nat), tail : Lst(Nat)) -> Lst(Nat) =
    rec go(rest : Lst(Nat)) -> Lst(Nat) =
        match rest : Lst(Nat)
        | nil() => tail
        | cons(x, more) => Lst/cons(x, go(more))
        end;
    go(xs);

let run_fiber_fins(f : Fiber) -> {} =
    match f : {}
    | fiber(_, _, fins, _) => run_all(fins)
    end;

let fiber_cancelled(f : Fiber, cancelled : Lst(Nat)) -> Bln =
    match f : Bln
    | fiber(_, _, _, fg) => cancelled_any(fg, cancelled)
    end;

union Stepped
| advanced(Lst(Fiber), Nat)
| parked(Parked, Nat)
| joined(Joined, Lst(Nat), Nat)
end

let splice(xs : Lst(Fiber), tail : Lst(Fiber)) -> Lst(Fiber) =
    rec go(rest : Lst(Fiber)) -> Lst(Fiber) =
        match rest : Lst(Fiber)
        | nil() => tail
        | cons(x, more) => Lst/cons(x, go(more))
        end;
    go(xs);

let step(f : Fiber, next_id : Nat) -> Stepped =
    match f : Stepped
    | fiber(_, t, fins, groups) =>
        match t : Stepped
        | done(_) =>
            let ran = run_all(fins);
            Stepped/advanced(Lst/nil(), next_id)
        | spawn(child, k) =>
            Stepped/advanced(
                Lst/cons(Fiber/fiber(k(), fins, groups), Lst/cons(Fiber/fiber(child, Lst/nil(), groups), Lst/nil())),
                next_id)
        | spawn_guard(fin, child, k) =>
            Stepped/advanced(
                Lst/cons(Fiber/fiber(k(), fins, groups), Lst/cons(Fiber/fiber(child, Lst/cons(fin, Lst/nil()), groups), Lst/nil())),
                next_id)
        | protect(fin, k) =>
            Stepped/advanced(Lst/cons(Fiber/fiber(k(), Lst/cons(fin, fins), groups), Lst/nil()), next_id)
        | unprotect(k) =>
            match fins : Stepped
            | cons(top, more) => let ran = top(); Stepped/advanced(Lst/cons(Fiber/fiber(k(), more, groups), Lst/nil()), next_id)
            | nil() => Stepped/advanced(Lst/cons(Fiber/fiber(k(), Lst/nil(), groups), Lst/nil()), next_id)
            end
        | wait(h, ev, k) =>
            Stepped/parked(Parked { handle = h, interest = ev, finalizers = fins, groups = groups, resume = () => Fiber/fiber(k(), fins, groups) }, next_id)
        | open(k) =>
            Stepped/advanced(Lst/cons(Fiber/fiber(k(), fins, Lst/cons(next_id, groups)), Lst/nil()), Nat/add(next_id, 1))
        | join(k) =>
            match groups : Stepped
            | cons(g, rest) =>
                Stepped/joined(Joined { awaited = g, groups = rest, finalizers = fins, resume = () => Fiber/fiber(k(), fins, rest) }, Lst/nil(), next_id)
            | nil() => Stepped/advanced(Lst/cons(Fiber/fiber(k(), fins, groups), Lst/nil()), next_id)
            end
        | close(k) =>
            match groups : Stepped
            | cons(g, rest) =>
                Stepped/joined(Joined { awaited = g, groups = rest, finalizers = fins, resume = () => Fiber/fiber(k(), fins, rest) }, Lst/cons(g, Lst/nil()), next_id)
            | nil() => Stepped/advanced(Lst/cons(Fiber/fiber(k(), fins, groups), Lst/nil()), next_id)
            end
        end
    end;

rec schedule(ready : Lst(Fiber), blocked : Lst(Parked), joining : Lst(Joined), cancelled : Lst(Nat), next_id : Nat) -> {} =
    let blocked1 = sweep_blocked(blocked, cancelled);
    let joining1 = sweep_joining(joining, cancelled);
    let woken = wake(joining1, ready, blocked1);
    let ready1 = splice(woken.0, ready);
    let joining2 = woken.1;
    match ready1 : {}
    | cons(f, rest) =>
        match fiber_cancelled(f, cancelled) : {}
        | true => let ran = run_fiber_fins(f); schedule(rest, blocked1, joining2, cancelled, next_id)
        | false =>
            match step(f, next_id) : {}
            | advanced(news, nid) => schedule(splice(news, rest), blocked1, joining2, cancelled, nid)
            | parked(p, nid) => schedule(rest, Lst/cons(p, blocked1), joining2, cancelled, nid)
            | joined(j, gc, nid) => schedule(rest, blocked1, Lst/cons(j, joining2), app_ids(gc, cancelled), nid)
            end
        end
    | nil() =>
        match blocked1 : {}
        | cons(_, _) =>
            let handles = Lst/to_arr(Lst/map((p) => p.handle, blocked1));
            let events = Lst/to_arr(Lst/map((p) => p.interest, blocked1));
            let results = Io/poll(handles, events, -1);
            let split = partition(blocked1, results, 0);
            schedule(split.0, split.1, joining2, cancelled, next_id)
        | nil() => drain_joining(joining2)
        end
    end;

pub let block_on(@A : Type, t : Task(A)) -> A =
    rec loop(root : Task(A), rgroups : Lst(Nat), rfins : Lst(Finalizer), ready : Lst(Fiber), blocked : Lst(Parked), joining : Lst(Joined), cancelled : Lst(Nat), next_id : Nat) -> A =
        let blocked1 = sweep_blocked(blocked, cancelled);
        let joining1 = sweep_joining(joining, cancelled);
        let woken = wake(joining1, ready, blocked1);
        let ready1 = splice(woken.0, ready);
        let joining2 = woken.1;
        match root : A
        | done(a) =>
            let cleaned = run_all(rfins);
            let dropped = schedule(ready1, blocked1, joining2, Lst/cons(0, cancelled), next_id);
            a
        | protect(fin, k) => loop(k(), rgroups, Lst/cons(fin, rfins), ready1, blocked1, joining2, cancelled, next_id)
        | unprotect(k) =>
            match rfins : A
            | cons(top, more) => let ran = top(); loop(k(), rgroups, more, ready1, blocked1, joining2, cancelled, next_id)
            | nil() => loop(k(), rgroups, Lst/nil(), ready1, blocked1, joining2, cancelled, next_id)
            end
        | spawn(child, k) => loop(k(), rgroups, rfins, Lst/cons(Fiber/fiber(child, Lst/nil(), rgroups), ready1), blocked1, joining2, cancelled, next_id)
        | spawn_guard(fin, child, k) => loop(k(), rgroups, rfins, Lst/cons(Fiber/fiber(child, Lst/cons(fin, Lst/nil()), rgroups), ready1), blocked1, joining2, cancelled, next_id)
        | open(k) => loop(k(), Lst/cons(next_id, rgroups), rfins, ready1, blocked1, joining2, cancelled, Nat/add(next_id, 1))
        | close(k) =>
            match rgroups : A
            | cons(g, grest) => loop(Task/join(k), rgroups, rfins, ready1, blocked1, joining2, Lst/cons(g, cancelled), next_id)
            | nil() => loop(k(), rgroups, rfins, ready1, blocked1, joining2, cancelled, next_id)
            end
        | join(k) =>
            match rgroups : A
            | cons(g, grest) =>
                match group_present(g, ready1, blocked1, joining2) : A
                | false => loop(k(), grest, rfins, ready1, blocked1, joining2, cancelled, next_id)
                | true =>
                    match ready1 : A
                    | cons(cf, crest) =>
                        match fiber_cancelled(cf, cancelled) : A
                        | true => let ran = run_fiber_fins(cf); loop(Task/join(k), rgroups, rfins, crest, blocked1, joining2, cancelled, next_id)
                        | false =>
                            match step(cf, next_id) : A
                            | advanced(news, nid) => loop(Task/join(k), rgroups, rfins, splice(news, crest), blocked1, joining2, cancelled, nid)
                            | parked(p, nid) => loop(Task/join(k), rgroups, rfins, crest, Lst/cons(p, blocked1), joining2, cancelled, nid)
                            | joined(j, gc, nid) => loop(Task/join(k), rgroups, rfins, crest, blocked1, Lst/cons(j, joining2), app_ids(gc, cancelled), nid)
                            end
                        end
                    | nil() =>
                        match blocked1 : A
                        | cons(_, _) =>
                            let handles = Lst/to_arr(Lst/map((p) => p.handle, blocked1));
                            let events = Lst/to_arr(Lst/map((p) => p.interest, blocked1));
                            let results = Io/poll(handles, events, -1);
                            let split = partition(blocked1, results, 0);
                            loop(Task/join(k), rgroups, rfins, split.0, split.1, joining2, cancelled, next_id)
                        | nil() => loop(k(), grest, rfins, ready1, blocked1, joining2, cancelled, next_id)
                        end
                    end
                end
            | nil() => loop(k(), rgroups, rfins, ready1, blocked1, joining2, cancelled, next_id)
            end
        | wait(rh, rev, rk) =>
            match ready1 : A
            | cons(cf, crest) =>
                match fiber_cancelled(cf, cancelled) : A
                | true => let ran = run_fiber_fins(cf); loop(Task/wait(rh, rev, rk), rgroups, rfins, crest, blocked1, joining2, cancelled, next_id)
                | false =>
                    match step(cf, next_id) : A
                    | advanced(news, nid) => loop(Task/wait(rh, rev, rk), rgroups, rfins, splice(news, crest), blocked1, joining2, cancelled, nid)
                    | parked(p, nid) => loop(Task/wait(rh, rev, rk), rgroups, rfins, crest, Lst/cons(p, blocked1), joining2, cancelled, nid)
                    | joined(j, gc, nid) => loop(Task/wait(rh, rev, rk), rgroups, rfins, crest, blocked1, Lst/cons(j, joining2), app_ids(gc, cancelled), nid)
                    end
                end
            | nil() =>
                let handles = Lst/to_arr(Lst/cons(rh, Lst/map((p) => p.handle, blocked1)));
                let events = Lst/to_arr(Lst/cons(rev, Lst/map((p) => p.interest, blocked1)));
                let results = Io/poll(handles, events, -1);
                let split = partition(blocked1, results, 1);
                match is_ready(Arr/get(results, 0), rev) : A
                | true => loop(rk(), rgroups, rfins, split.0, split.1, joining2, cancelled, next_id)
                | false => loop(Task/wait(rh, rev, rk), rgroups, rfins, split.0, split.1, joining2, cancelled, next_id)
                end
            end
        end;
    loop(t, Lst/cons(0, Lst/nil()), Lst/nil(), Lst/nil(), Lst/nil(), Lst/nil(), Lst/nil(), 1);

pub let run(main : Task({})) -> {} =
    let result = block_on(main);
    ();
