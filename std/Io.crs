pub use /sys/{Io};
pub use /sys/Io/{let stdin, let stdout, let stderr};
use /std/{Bin, Str, Nat, Option, Result};

pub union Error
| not_found()
| permission_denied()
| exists()
| refused()
| tls()
| other(Nat)
end

pub let error_of(status : Nat) -> Error =
    match status : Error
    | 2 => Error/not_found()
    | 3 => Error/permission_denied()
    | 4 => Error/exists()
    | 5 => Error/refused()
    | 7 => Error/tls()
    | _ => Error/other(status)
    end;

pub union Read
| chunk(Bin)
| eof()
| error(Error)
end

pub let read(h : Io, n : Nat) -> Read =
    let r = /sys/Io/read(h, n);
    match Nat/eql(r.status, 0) : Read
    | true => Read/chunk(r.bytes)
    | false =>
        match Nat/eql(r.status, 1) : Read
        | true => Read/eof()
        | false => Read/error(error_of(r.status))
        end
    end;

pub rec write(h : Io, b : Bin) -> Result({}, Error) =
    let r = /sys/Io/write(h, b);
    match Nat/eql(r.status, 0) : Result({}, Error)
    | true =>
        match Nat/lt(r.written, Bin/len(b)) : Result({}, Error)
        | true => write(h, Bin/slice(b, r.written, Bin/len(b)))
        | false => Result/success(())
        end
    | false => Result/failure(error_of(r.status))
    end;

pub let print(s : Str) -> {} =
    let _ = write(stdout, Str/to_bin(s));
    ();

pub let print_err(s : Str) -> {} =
    let _ = write(stderr, Str/to_bin(s));
    ();

pub let input() -> Option(Bin) =
    rec go(acc : Bin) -> Option(Bin) =
        let r = /sys/Io/read(stdin, 1);
        match Nat/eql(r.status, 0) : Option(Bin)
        | false =>
            match Nat/eql(Bin/len(acc), 0) : Option(Bin)
            | true => Option/none()
            | false => Option/some(acc)
            end
        | true =>
            match Nat/eql(Bin/get(r.bytes, 0), '\n') : Option(Bin)
            | true => Option/some(acc)
            | false => go(Bin/concat(acc, r.bytes))
            end
        end;
    go(\\);
