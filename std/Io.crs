pub use /sys/{Io};
pub use /sys/Io/{let stdin, let stdout, let stderr, let read, let write, let poll};
use /std/{Bin, Str, Nat, Option};

pub let print(s : Str) -> {} =
    let status = write(stdout, Str/to_bin(s));
    ();

pub let Reader : Type = { Io, Bin };

pub let reader(h : Io) -> Reader = (h, \\);

pub let Buf(A : Type) -> Type = (Reader) -> { Reader, A };

pub let pure(@A : Type, a : A) -> Buf(A) =
    (r) => (r, a);

pub let bind(@A : Type, @B : Type) -> (Buf(A), (A) -> Buf(B)) -> Buf(B) =
    (m, f) => (r) =>
        let p = m(r);
        f(p.1)(p.0);

pub let run(@A : Type, m : Buf(A), h : Io) -> A =
    m(reader(h)).1;

pub let drain(h : Io) -> Bin =
    rec go(acc : Bin) -> Bin =
        let r = read(h, 4096);
        match Nat/eql(r.status, 0)
        | true => go(Bin/concat(acc, r.bytes))
        | false => acc
        end;
    go(\\);

let find_newline(buf : Bin) -> Option(Nat) =
    let r : { Nat, Option(Nat) } =
        Bin/fold(buf, (0, Option/none()), (byte, acc) =>
            match acc.1
            | some(_) => acc
            | none() =>
                match Nat/eql(byte, '\n')
                | true => (acc.0, Option/some(acc.0))
                | false => (Nat/add(acc.0, 1), Option/none())
                end
            end);
    r.1;

pub rec read_line : Buf(Option(Bin)) =
    (r) =>
        match find_newline(r.1) : { Reader, Option(Bin) }
        | some(i) =>
            let stop = Nat/add(i, 1);
            let line = Bin/slice(r.1, 0, stop);
            let rest = Bin/slice(r.1, stop, Bin/len(r.1));
            ((r.0, rest), Option/some(line))
        | none() =>
            let chunk = read(r.0, 4096);
            match Nat/eql(chunk.status, 0)
            | false =>
                match Nat/eql(Bin/len(r.1), 0)
                | true => (r, Option/none())
                | false => ((r.0, \\), Option/some(r.1))
                end
            | true => read_line((r.0, Bin/concat(r.1, chunk.bytes)))
            end
        end;
