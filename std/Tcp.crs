use /std/{Bin, Str, Nat, Bln, Io, Result, Option, Time, Arr, Task};

pub struct Settings pub {
    connect_timeout : Option(Time/Duration),
    read_timeout : Option(Time/Duration),
    write_timeout : Option(Time/Duration),
    tls : Bln
}

pub let default : Settings = Settings {
    connect_timeout = Option/none(),
    read_timeout = Option/none(),
    write_timeout = Option/none(),
    tls = false
};

pub struct Socket { Io }

pub let read(c : Socket, n : Nat) -> Task(Io/Read) =
    Task/read(c.0, n);

pub let write(c : Socket, b : Bin) -> Task(Result({}, Io/Error)) =
    Task/write(c.0, b);

let configure(h : Io, settings : Settings) -> {} =
    let _ = /sys/Io/set_recv_timeout(h, Option/unwrap_or(Option/map(Time/to_millis, settings.read_timeout), 0));
    let _ = /sys/Io/set_send_timeout(h, Option/unwrap_or(Option/map(Time/to_millis, settings.write_timeout), 0));
    ();

let upgrade(h : Io, host : Str, tls : Bln) -> Nat =
    match tls : Nat
    | false => /sys/Io/Status/ok
    | true => /sys/Io/start_tls(h, Str/to_bin(host))
    end;

let connect_socket(settings : Settings, host : Str, port : Nat) -> Result(Socket, Io/Error) =
    let r = /sys/Io/resolve(Str/to_bin(host), port);
    match Nat/eql(r.status, /sys/Io/Status/ok) : Result(Socket, Io/Error)
    | false => Result/failure(Io/error_of(r.status))
    | true =>
        let addr = Arr/get(r.addresses, 0);
        let s = /sys/Io/socket(addr);
        match Nat/eql(s.status, /sys/Io/Status/ok) : Result(Socket, Io/Error)
        | false => Result/failure(Io/error_of(s.status))
        | true =>
            let _ = configure(s.handle, settings);
            let status = /sys/Io/connect(s.handle, addr);
            match Nat/eql(status, /sys/Io/Status/ok) : Result(Socket, Io/Error)
            | false =>
                let _ = /sys/Io/close(s.handle);
                Result/failure(Io/error_of(status))
            | true =>
                let upgraded = upgrade(s.handle, host, settings.tls);
                match Nat/eql(upgraded, /sys/Io/Status/ok) : Result(Socket, Io/Error)
                | false =>
                    let _ = /sys/Io/close(s.handle);
                    Result/failure(Io/error_of(upgraded))
                | true =>
                    let _ =
                        match settings.tls : {}
                        | false => Task/nonblocking(s.handle)
                        | true => ()
                        end;
                    Result/success(Socket { s.handle })
                end
            end
        end
    end;

pub let connect(settings : Settings, host : Str, port : Nat) -> Task(Result(Socket, Io/Error)) =
    Task/defer(() =>
        match connect_socket(settings, host, port) : Task(Result(Socket, Io/Error))
        | failure(e) => Task/pure(Result/failure(e))
        | success(c) =>
            Task/bind(Task/acquire(c.0, () => /sys/Io/close(c.0)), (_) => Task/pure(Result/success(c)))
        end);

pub let close(c : Socket) -> Task({}) =
    Task/release(c.0);

pub let with(@A : Type, settings : Settings, host : Str, port : Nat, f : (Socket) -> Task(A)) -> Task(Result(A, Io/Error)) =
    Task/bind(connect(settings, host, port), (opened) =>
        match opened : Task(Result(A, Io/Error))
        | failure(e) => Task/pure(Result/failure(e))
        | success(c) =>
            Task/bind(f(c), (a) =>
                Task/bind(close(c), (()) => Task/pure(Result/success(a))))
        end);

let drain(c : Socket) -> Task(Bin) =
    rec go(acc : Bin) -> Task(Bin) =
        Task/bind(read(c, 4096), (r) =>
            match r : Task(Bin)
            | chunk(bytes) => go(Bin/concat(acc, bytes))
            | eof() => Task/pure(acc)
            | error(_) => Task/pure(acc)
            end);
    go(\\);

pub let call(settings : Settings, host : Str, port : Nat, request : Bin) -> Task(Result(Bin, Io/Error)) =
    with(settings, host, port, (c) =>
        Task/bind(write(c, request), (_) => drain(c)));

struct Listener { Io }

let listen(host : Str, port : Nat) -> Result(Listener, Io/Error) =
    let r = /sys/Io/resolve(Str/to_bin(host), port);
    match Nat/eql(r.status, /sys/Io/Status/ok) : Result(Listener, Io/Error)
    | false => Result/failure(Io/error_of(r.status))
    | true =>
        let addr = Arr/get(r.addresses, 0);
        let s = /sys/Io/socket(addr);
        match Nat/eql(s.status, /sys/Io/Status/ok) : Result(Listener, Io/Error)
        | false => Result/failure(Io/error_of(s.status))
        | true =>
            let _ = /sys/Io/set_reuseaddr(s.handle, true);
            let bound = /sys/Io/bind(s.handle, addr);
            match Nat/eql(bound, /sys/Io/Status/ok) : Result(Listener, Io/Error)
            | false =>
                let _ = /sys/Io/close(s.handle);
                Result/failure(Io/error_of(bound))
            | true =>
                let status = /sys/Io/listen(s.handle, 128);
                match Nat/eql(status, /sys/Io/Status/ok) : Result(Listener, Io/Error)
                | false =>
                    let _ = /sys/Io/close(s.handle);
                    Result/failure(Io/error_of(status))
                | true =>
                    let _ = Task/nonblocking(s.handle);
                    Result/success(Listener { s.handle })
                end
            end
        end
    end;

let accept(l : Listener) -> Task(Result(Socket, Io/Error)) =
    Task/bind(Task/accept(l.0), (r) =>
        match r : Task(Result(Socket, Io/Error))
        | success(h) =>
            let _ = Task/nonblocking(h);
            Task/pure(Result/success(Socket { h }))
        | failure(e) => Task/pure(Result/failure(e))
        end);

pub let serve(host : Str, port : Nat, handler : (Socket) -> Task({})) -> Task(Result({}, Io/Error)) =
    Task/defer(() =>
        match listen(host, port) : Task(Result({}, Io/Error))
        | failure(e) => Task/pure(Result/failure(e))
        | success(l) =>
            Task/bind(
                Task/using(l.0, () => /sys/Io/close(l.0),
                    rec go() -> Task({}) =
                        Task/bind(accept(l), (r) =>
                            match r : Task({})
                            | success(c) =>
                                Task/bind(Task/go(() => Task/using(c.0, () => /sys/Io/close(c.0), handler(c))), (()) => go())
                            | failure(_) => Task/pure(())
                            end);
                    go()),
                (()) => Task/pure(Result/success(())))
        end);

pub let serve_tls(host : Str, port : Nat, cert : Bin, key : Bin, handler : (Socket) -> Task({})) -> Task(Result({}, Io/Error)) =
    Task/defer(() =>
        let cfg = /sys/Io/tls_server_config(cert, key);
        match Nat/eql(cfg.status, /sys/Io/Status/ok) : Task(Result({}, Io/Error))
        | false => Task/pure(Result/failure(Io/error_of(cfg.status)))
        | true =>
            Task/using(cfg.handle, () => let _ = /sys/Io/close(cfg.handle); (),
                match listen(host, port) : Task(Result({}, Io/Error))
                | failure(e) => Task/pure(Result/failure(e))
                | success(l) =>
                    Task/bind(
                        Task/using(l.0, () => /sys/Io/close(l.0),
                            rec go() -> Task({}) =
                                Task/bind(Task/accept(l.0), (r) =>
                                    match r : Task({})
                                    | failure(_) => Task/pure(())
                                    | success(h) =>
                                        let status = /sys/Io/start_tls_server(h, cfg.handle);
                                        match Nat/eql(status, /sys/Io/Status/ok) : Task({})
                                        | true => Task/bind(Task/using(h, () => /sys/Io/close(h), handler(Socket { h })), (()) => go())
                                        | false =>
                                            let _ = /sys/Io/close(h);
                                            go()
                                        end
                                    end);
                            go()),
                        (()) => Task/pure(Result/success(())))
                end)
        end);
