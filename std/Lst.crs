use /std/{Arr, Nat};

pub union Lst(A : Type)
| nil()
| cons(A, Lst(A))
end

pub use Lst/*;

pub let len(A : Type, l : Lst(A)) -> Nat =
    rec go(rest : Lst(A), acc : Nat) -> Nat =
        match rest
        | nil() => acc
        | cons(_, tail) => go(tail, Nat/add(acc, 1))
        end;
    go(l, 0);

pub let rev(A : Type, l : Lst(A)) -> Lst(A) =
    rec go(rest : Lst(A), acc : Lst(A)) -> Lst(A) =
        match rest
        | nil() => acc
        | cons(x, tail) => go(tail, Lst/cons(?, x, acc))
        end;
    go(l, Lst/nil(?));

pub let to_arr(A : Type, l : Lst(A)) -> Arr(A) =
    rec go(rest : Lst(A), n : Nat) -> { Arr(A), Lst(A) } =
        match Nat/lt(n, 2)
        | true =>
            match rest
            | nil() => ([], rest)
            | cons(x, tail) =>
                match Nat/eql(n, 0)
                | true => ([], rest)
                | false => ([x], tail)
                end
            end
        | false =>
            let half = Nat/div(n, 2);
            let left = go(rest, half);
            let right = go(left.1, Nat/sub(n, half));
            (Arr/concat(A, left.0, right.0), right.1)
        end;
    (go(l, len(A, l))).0;
