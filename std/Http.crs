use /std/{Bin, Str, Nat, Bln, Char, Lst, Parse, Result, Option, Tcp, Io, Task};

pub union Method
| get()
| post()
end

let method_str(m : Method) -> Str =
    match m : Str
    | get() => "GET"
    | post() => "POST"
    end;

pub union Error
| net(Io/Error)
| malformed(Str)
end

pub struct Request pub {
    method : Method,
    host : Str,
    port : Nat,
    path : Str,
    headers : Lst({Str, Str}),
    body : Bin,
    settings : Tcp/Settings
}

pub let get(host : Str, port : Nat, path : Str) -> Request =
    Request {
        method = Method/get(),
        host = host,
        port = port,
        path = path,
        headers = [],
        body = \\,
        settings = Tcp/default
    };

pub let post(host : Str, port : Nat, path : Str, body : Bin) -> Request =
    Request {
        method = Method/post(),
        host = host,
        port = port,
        path = path,
        headers = [],
        body = body,
        settings = Tcp/default
    };

let with_tls(s : Tcp/Settings) -> Tcp/Settings =
    Tcp/Settings {
        connect_timeout = s.connect_timeout,
        read_timeout = s.read_timeout,
        write_timeout = s.write_timeout,
        tls = true
    };

pub let secure(request : Request) -> Request =
    Request {
        method = request.method,
        host = request.host,
        port = request.port,
        path = request.path,
        headers = request.headers,
        body = request.body,
        settings = with_tls(request.settings)
    };

pub let get_tls(host : Str, port : Nat, path : Str) -> Request =
    secure(get(host, port, path));

pub let post_tls(host : Str, port : Nat, path : Str, body : Bin) -> Request =
    secure(post(host, port, path, body));

let until(target : Nat) -> (Nat) -> Bln =
    (byte) =>
        match Nat/eql(byte, target)
        | true => false
        | false => true
        end;

let header_lookup(headers : Lst({Str, Str}), name : Str) -> Option(Str) =
    Option/map((pair) => pair.1, Lst/find(headers, (pair) => Str/eql_ci(pair.0, name)));

let render_header(pair : {Str, Str}) -> Str =
    Str/flatten([pair.0, ": ", pair.1, "\r\n"]);

let content_length(body : Bin) -> Str =
    match Nat/eql(Bin/len(body), 0) : Str
    | true => ""
    | false => Str/flatten(["Content-Length: ", Nat/to_str(Bin/len(body)), "\r\n"])
    end;

pub let render(request : Request) -> Bin =
    Bin/concat(
        Str/to_bin(Str/flatten([
            method_str(request.method), " ", request.path, " HTTP/1.1\r\n",
            "Host: ", request.host, "\r\n",
            "Connection: close\r\n",
            content_length(request.body),
            Str/flatten(Lst/map(render_header, request.headers)),
            "\r\n"
        ])),
        request.body);

pub struct Status pub {
    version : Str,
    code : Nat,
    reason : Str
}

pub let status_line : Parse(Status) =
    let ! = Parse/bind;
    let version = Parse/take_while(until(' '))!;
    let _ = Parse/take_byte(' ')!;
    let digits = Parse/take_while(Char/is_digit)!;
    let _ = Parse/take_byte(' ')!;
    let reason = Parse/take_while(until('\r'))!;
    let _ = Parse/take_byte('\r')!;
    let _ = Parse/take_byte('\n')!;
    Parse/pure(Status {
        version = Option/unwrap_or(Str/of_bin(version), ""),
        code = Option/unwrap_or(Nat/of_str(Option/unwrap_or(Str/of_bin(digits), "")), 0),
        reason = Option/unwrap_or(Str/of_bin(reason), "")
    });

pub struct Response pub {
    status : Status,
    headers : Lst({Str, Str}),
    body : Bin
}

let rest : Parse(Bin) =
    (input, pos) =>
        Result/success((Bin/len(input), Bin/slice(input, pos, Bin/len(input))));

let guard_header : Parse({}) =
    (input, pos) =>
        match Nat/try_lt(pos, Bin/len(input))
        | none() => Result/failure("unexpected end of headers")
        | some(ok) =>
            match Nat/eql(Bin/at(input, pos, ok), '\r')
            | true => Result/failure("end of header block")
            | false => Result/success((pos, ()))
            end
        end;

let header_line : Parse({Str, Str}) =
    let ! = Parse/bind;
    let _ = guard_header!;
    let name = Parse/take_while(until(':'))!;
    let _ = Parse/take_byte(':')!;
    let value = Parse/take_while(until('\r'))!;
    let _ = Parse/take_byte('\r')!;
    let _ = Parse/take_byte('\n')!;
    Parse/pure((Option/unwrap_or(Str/of_bin(name), ""), Str/trim(Option/unwrap_or(Str/of_bin(value), ""))));

let take_n(n : Nat) -> Parse(Bin) =
    (input, pos) =>
        let stop = Nat/min(Nat/add(pos, n), Bin/len(input));
        Result/success((stop, Bin/slice(input, pos, stop)));

let content_length_of(headers : Lst({Str, Str})) -> Option(Nat) =
    match header_lookup(headers, "Content-Length") : Option(Nat)
    | some(value) => Nat/of_str(value)
    | none() => Option/none()
    end;

let body_parser(headers : Lst({Str, Str})) -> Parse(Bin) =
    match content_length_of(headers) : Parse(Bin)
    | some(n) => take_n(n)
    | none() => rest
    end;

pub let decode : Parse(Response) =
    let ! = Parse/bind;
    let status = status_line!;
    let headers = Parse/many0(header_line)!;
    let _ = Parse/take_byte('\r')!;
    let _ = Parse/take_byte('\n')!;
    let body = body_parser(headers)!;
    Parse/pure(Response {
        status = status,
        headers = headers,
        body = body
    });

pub let header(resp : Response, name : Str) -> Option(Str) =
    header_lookup(resp.headers, name);

pub let perform(request : Request) -> Task(Result(Response, Error)) =
    Task/bind(Tcp/call(request.settings, request.host, request.port, render(request)), (r) =>
        match r : Task(Result(Response, Error))
        | success(bytes) =>
            match Parse/run(decode, bytes) : Task(Result(Response, Error))
            | success(response) => Task/pure(Result/success(response))
            | failure(message) => Task/pure(Result/failure(Error/malformed(message)))
            end
        | failure(error) => Task/pure(Result/failure(Error/net(error)))
        end);
