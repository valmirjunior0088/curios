use /std/{Bin, Str, Nat, Bln, Char, Arr, Parse, Result, Option, Net};

pub union Method
| get()
| post()
end

let method_str(m : Method) -> Str =
    match m : Str
    | get() => "GET"
    | post() => "POST"
    end;

pub union Error
| net(Net/Error)
| malformed(Str)
end

pub struct Request pub {
    method : Method,
    host : Str,
    port : Nat,
    path : Str,
    headers : Arr({ Str, Str }),
    body : Bin,
    settings : Net/Settings
}

pub let get(host : Str, port : Nat, path : Str) -> Request =
    Request {
        method = Method/get(),
        host = host,
        port = port,
        path = path,
        headers = [],
        body = \\,
        settings = Net/default
    };

let as_str(b : Bin) -> Str =
    match Str/of_bin(b)
    | some(s) => s
    | none() => ""
    end;

let until(target : Nat) -> (Nat) -> Bln =
    (byte) =>
        match Nat/eql(byte, target)
        | true => false
        | false => true
        end;

let lower_byte(byte : Nat) -> Nat =
    match Nat/gte(byte, 65) : Nat
    | true =>
        match Nat/lte(byte, 90) : Nat
        | true => Nat/add(byte, 32)
        | false => byte
        end
    | false => byte
    end;

let lower(b : Bin) -> Bin =
    Bin/fold(b, \\, (byte, acc) => Bin/append(acc, lower_byte(byte)));

let eql_ci(a : Str, b : Str) -> Bln =
    Bin/eql(lower(Str/to_bin(a)), lower(Str/to_bin(b)));

let header_lookup(headers : Arr({ Str, Str }), name : Str) -> Option(Str) =
    Arr/fold(headers, Option/none(@Str), (pair, acc) =>
        match acc : Option(Str)
        | some(found) => Option/some(found)
        | none() =>
            match eql_ci(pair.0, name)
            | true => Option/some(pair.1)
            | false => Option/none()
            end
        end);

let render_header(pair : { Str, Str }) -> Str =
    Str/concat_all([pair.0, ": ", pair.1, "\r\n"]);

let content_length(body : Bin) -> Str =
    match Nat/eql(Bin/len(body), 0) : Str
    | true => ""
    | false => Str/concat_all(["Content-Length: ", Nat/to_str(Bin/len(body)), "\r\n"])
    end;

pub let render(request : Request) -> Bin =
    let head = Str/concat_all([
        method_str(request.method), " ", request.path, " HTTP/1.1\r\n",
        "Host: ", request.host, "\r\n",
        "Connection: close\r\n",
        content_length(request.body),
        Str/concat_all(Arr/map(render_header, request.headers)),
        "\r\n"
    ]);
    Bin/concat(Str/to_bin(head), request.body);

pub struct Status pub {
    version : Str,
    code : Nat,
    reason : Str
}

pub let status_line : Parse(Status) =
    let ! = Parse/bind;
    let version = Parse/take_while(until(' '))!;
    let _ = Parse/take_byte(' ')!;
    let digits = Parse/take_while(Char/is_digit)!;
    let _ = Parse/take_byte(' ')!;
    let reason = Parse/take_while(until('\r'))!;
    let _ = Parse/take_byte('\r')!;
    let _ = Parse/take_byte('\n')!;
    Parse/pure(Status {
        version = as_str(version),
        code = Nat/of_str(digits),
        reason = as_str(reason)
    });

pub struct Response pub {
    status : Status,
    headers : Arr({ Str, Str }),
    body : Bin
}

let rest : Parse(Bin) =
    (input, pos) =>
        Result/success((Bin/len(input), Bin/slice(input, pos, Bin/len(input))));

let guard_header : Parse({}) =
    (input, pos) =>
        match Nat/lt(pos, Bin/len(input))
        | false => Result/failure("unexpected end of headers")
        | true =>
            match Nat/eql(Bin/get(input, pos), '\r')
            | true => Result/failure("end of header block")
            | false => Result/success((pos, ()))
            end
        end;

let header_line : Parse({ Str, Str }) =
    let ! = Parse/bind;
    let _ = guard_header!;
    let name = Parse/take_while(until(':'))!;
    let _ = Parse/take_byte(':')!;
    let value = Parse/take_while(until('\r'))!;
    let _ = Parse/take_byte('\r')!;
    let _ = Parse/take_byte('\n')!;
    Parse/pure((as_str(name), as_str(Str/trim(value))));

let take_n(n : Nat) -> Parse(Bin) =
    (input, pos) =>
        let stop = Nat/min(Nat/add(pos, n), Bin/len(input));
        Result/success((stop, Bin/slice(input, pos, stop)));

let content_length_of(headers : Arr({ Str, Str })) -> Option(Nat) =
    match header_lookup(headers, "Content-Length") : Option(Nat)
    | some(value) => Option/some(Nat/of_str(Str/to_bin(value)))
    | none() => Option/none()
    end;

let body_parser(headers : Arr({ Str, Str })) -> Parse(Bin) =
    match content_length_of(headers) : Parse(Bin)
    | some(n) => take_n(n)
    | none() => rest
    end;

pub let decode : Parse(Response) =
    let ! = Parse/bind;
    let status = status_line!;
    let headers = Parse/many0(header_line)!;
    let _ = Parse/take_byte('\r')!;
    let _ = Parse/take_byte('\n')!;
    let body = body_parser(headers)!;
    Parse/pure(Response {
        status = status,
        headers = headers,
        body = body
    });

pub let header(resp : Response, name : Str) -> Option(Str) =
    header_lookup(resp.headers, name);

pub let perform(request : Request) -> Result(Response, Error) =
    match Net/call(request.settings, request.host, request.port, render(request)) : Result(Response, Error)
    | success(bytes) =>
        match Parse/run(decode, bytes) : Result(Response, Error)
        | success(response) => Result/success(response)
        | failure(message) => Result/failure(Error/malformed(message))
        end
    | failure(error) => Result/failure(Error/net(error))
    end;
