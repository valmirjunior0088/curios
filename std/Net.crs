use /std/{Bin, Str, Nat, Bln, Io, Result, Option, Time, Arr};

pub union Error
| refused()
| tls()
| other(Nat)
end

pub struct Socket { Io }

pub struct Settings pub {
    connect_timeout : Option(Time/Duration),
    read_timeout : Option(Time/Duration),
    write_timeout : Option(Time/Duration),
    tls : Bln
}

pub let default : Settings = Settings {
    connect_timeout = Option/none(),
    read_timeout = Option/none(),
    write_timeout = Option/none(),
    tls = false
};

pub let read(c : Socket, n : Nat) -> { status : Nat, bytes : Bin } =
    Io/read(c.0, n);

pub let write(c : Socket, b : Bin) -> Nat =
    Io/write(c.0, b);

let close(c : Socket) -> {} =
    /sys/Io/close(c.0);

let timeout_ms(t : Option(Time/Duration)) -> Nat =
    match t : Nat
    | none() => 0
    | some(d) => Time/to_millis(d)
    end;

let decode(status : Nat) -> Error =
    match status : Error
    | 6 => Error/refused()
    | 8 => Error/tls()
    | _ => Error/other(status)
    end;

let configure(h : Io, settings : Settings) -> {} =
    let r = /sys/Io/set_recv_timeout(h, timeout_ms(settings.read_timeout));
    let w = /sys/Io/set_send_timeout(h, timeout_ms(settings.write_timeout));
    ();

let upgrade(h : Io, host : Str, tls : Bln) -> Nat =
    match tls : Nat
    | false => 0
    | true => /sys/Io/start_tls(h, Str/to_bin(host))
    end;

pub let with(@A : Type, settings : Settings, host : Str, port : Nat, f : (Socket) -> A) -> Result(A, Error) =
    let r = /sys/Io/resolve(Str/to_bin(host), port);
    match Nat/eql(r.status, 0) : Result(A, Error)
    | false => Result/failure(decode(r.status))
    | true =>
        let addr = Arr/get(r.addresses, 0);
        let s = /sys/Io/socket(addr);
        match Nat/eql(s.status, 0) : Result(A, Error)
        | false => Result/failure(decode(s.status))
        | true =>
            let configured = configure(s.handle, settings);
            let status = /sys/Io/connect(s.handle, addr);
            match Nat/eql(status, 0) : Result(A, Error)
            | false =>
                let closed = /sys/Io/close(s.handle);
                Result/failure(decode(status))
            | true =>
                let upgraded = upgrade(s.handle, host, settings.tls);
                match Nat/eql(upgraded, 0) : Result(A, Error)
                | false =>
                    let closed = /sys/Io/close(s.handle);
                    Result/failure(decode(upgraded))
                | true =>
                    let c = Socket { s.handle };
                    let value = f(c);
                    let closed = close(c);
                    Result/success(value)
                end
            end
        end
    end;

pub let call(settings : Settings, host : Str, port : Nat, request : Bin) -> Result(Bin, Error) =
    with(settings, host, port, (c) =>
        let sent = write(c, request);
        Io/drain(c.0));

struct Listener { Io }

let listen(host : Str, port : Nat) -> Result(Listener, Error) =
    let r = /sys/Io/resolve(Str/to_bin(host), port);
    match Nat/eql(r.status, 0) : Result(Listener, Error)
    | false => Result/failure(decode(r.status))
    | true =>
        let addr = Arr/get(r.addresses, 0);
        let s = /sys/Io/socket(addr);
        match Nat/eql(s.status, 0) : Result(Listener, Error)
        | false => Result/failure(decode(s.status))
        | true =>
            let reused = /sys/Io/set_reuseaddr(s.handle, true);
            let bound = /sys/Io/bind(s.handle, addr);
            match Nat/eql(bound, 0) : Result(Listener, Error)
            | false =>
                let closed = /sys/Io/close(s.handle);
                Result/failure(decode(bound))
            | true =>
                let status = /sys/Io/listen(s.handle, 128);
                match Nat/eql(status, 0) : Result(Listener, Error)
                | false =>
                    let closed = /sys/Io/close(s.handle);
                    Result/failure(decode(status))
                | true => Result/success(Listener { s.handle })
                end
            end
        end
    end;

let accept(l : Listener) -> Result(Socket, Error) =
    let r = /sys/Io/accept(l.0);
    match Nat/eql(r.status, 0) : Result(Socket, Error)
    | true => Result/success(Socket { r.handle })
    | false => Result/failure(decode(r.status))
    end;

let close_listener(l : Listener) -> {} =
    /sys/Io/close(l.0);

pub let serve(host : Str, port : Nat, handler : (Socket) -> {}) -> Result({}, Error) =
    match listen(host, port) : Result({}, Error)
    | success(l) =>
        rec go(u : {}) -> {} =
            match accept(l) : {}
            | success(c) =>
                let handled = handler(c);
                let closed = close(c);
                go(())
            | failure(_) => ()
            end;
        let served = go(());
        let closed = close_listener(l);
        Result/success(())
    | failure(e) => Result/failure(e)
    end;

pub let serve_tls(host : Str, port : Nat, cert : Bin, key : Bin, handler : (Socket) -> {}) -> Result({}, Error) =
    let cfg = /sys/Io/tls_server_config(cert, key);
    match Nat/eql(cfg.status, 0) : Result({}, Error)
    | false => Result/failure(decode(cfg.status))
    | true =>
        match listen(host, port) : Result({}, Error)
        | failure(e) =>
            let dropped = /sys/Io/close(cfg.handle);
            Result/failure(e)
        | success(l) =>
            rec go(u : {}) -> {} =
                match accept(l) : {}
                | failure(_) => ()
                | success(c) =>
                    let status = /sys/Io/start_tls_server(c.0, cfg.handle);
                    match Nat/eql(status, 0) : {}
                    | true =>
                        let handled = handler(c);
                        let closed = close(c);
                        go(())
                    | false =>
                        let closed = close(c);
                        go(())
                    end
                end;
            let served = go(());
            let closed = close_listener(l);
            let dropped = /sys/Io/close(cfg.handle);
            Result/success(())
        end
    end;
