use /std/{Bin, Str, Nat, Io, Result, Option, Clock};

pub union Error
| refused()
| other(Nat)
end

-- A live connection handle. Like `/std/File`, a single-field struct is a
-- zero-cost newtype over the underlying `Io` byte stream, kept distinct so a
-- socket is not confused with stdin/stdout or a file.
pub struct Socket { Io }

-- Per-connection settings. Each timeout is optional; `none` blocks forever.
-- `connect_timeout` bounds the connect itself; `read_timeout`/`write_timeout`
-- bound subsequent reads/writes on the handle. The representation is public:
-- build one as `Settings { ... }`, or start from `default`.
pub struct Settings pub {
    connect_timeout : Option(Clock/Duration),
    read_timeout : Option(Clock/Duration),
    write_timeout : Option(Clock/Duration)
}

pub let default : Settings = Settings {
    connect_timeout = Option/none(),
    read_timeout = Option/none(),
    write_timeout = Option/none()
};

pub let read(c : Socket, n : Nat) -> { status : Nat, bytes : Bin } =
    Io/read(c.0, n);

pub let write(c : Socket, b : Bin) -> Nat =
    Io/write(c.0, b);

-- Closing is private: `with`/`call` bracket the connection so a handle never
-- outlives the body and cannot be used after close.
let close(c : Socket) -> {} =
    /sys/Io/close(c.0);

let timeout_ms(t : Option(Clock/Duration)) -> Nat =
    match t : Nat
    | none() => 0
    | some(d) => Nat/add(Nat/mul(Clock/secs(d), 1000), Nat/div(Clock/nanos(d), 1000000))
    end;

let decode(status : Nat) -> Error =
    match status : Error
    | 6 => Error/refused()
    | _ => Error/other(status)
    end;

pub let with(@A : Type, settings : Settings, host : Str, port : Nat, body : Socket -> A) -> Result(A, Error) =
    let r = /sys/Io/connect(
        Str/to_bin(host),
        port,
        timeout_ms(settings.connect_timeout),
        timeout_ms(settings.read_timeout),
        timeout_ms(settings.write_timeout));
    match Nat/eql(r.status, 0)
    | true =>
        let c = Socket { r.handle };
        let value = body(c);
        let closed = close(c);
        Result/success(value)
    | false => Result/failure(decode(r.status))
    end;

rec drain(c : Socket, acc : Bin) -> Bin =
    let r = read(c, 4096);
    match Nat/eql(r.status, 0)
    | true => drain(c, Bin/concat(acc, r.bytes))
    | false => acc
    end;

-- Open a connection, send `request`, read the whole response to EOF, close.
pub let call(settings : Settings, host : Str, port : Nat, request : Bin) -> Result(Bin, Error) =
    with(settings, host, port, (c) =>
        let sent = write(c, request);
        drain(c, Bin/empty));
