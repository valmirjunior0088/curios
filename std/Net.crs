use /std/{Bin, Str, Nat, Io, Result, Option, Time};

pub union Error
| refused()
| other(Nat)
end

pub struct Socket { Io }

pub struct Settings pub {
    connect_timeout : Option(Time/Duration),
    read_timeout : Option(Time/Duration),
    write_timeout : Option(Time/Duration)
}

pub let default : Settings = Settings {
    connect_timeout = Option/none(),
    read_timeout = Option/none(),
    write_timeout = Option/none()
};

pub let read(c : Socket, n : Nat) -> { status : Nat, bytes : Bin } =
    Io/read(c.0, n);

pub let write(c : Socket, b : Bin) -> Nat =
    Io/write(c.0, b);

let close(c : Socket) -> {} =
    /sys/Io/close(c.0);

let timeout_ms(t : Option(Time/Duration)) -> Nat =
    match t : Nat
    | none() => 0
    | some(d) => Nat/add(Nat/mul(Time/secs(d), 1000), Nat/div(Time/nanos(d), 1000000))
    end;

let decode(status : Nat) -> Error =
    match status : Error
    | 6 => Error/refused()
    | _ => Error/other(status)
    end;

pub let with(@A : Type, settings : Settings, host : Str, port : Nat, f : (Socket) -> A) -> Result(A, Error) =
    let r = /sys/Io/connect(
        Str/to_bin(host),
        port,
        timeout_ms(settings.connect_timeout),
        timeout_ms(settings.read_timeout),
        timeout_ms(settings.write_timeout));
    match Nat/eql(r.status, 0)
    | true =>
        let c = Socket { r.handle };
        let value = f(c);
        let closed = close(c);
        Result/success(value)
    | false => Result/failure(decode(r.status))
    end;

pub let call(settings : Settings, host : Str, port : Nat, request : Bin) -> Result(Bin, Error) =
    with(settings, host, port, (c) =>
        let sent = write(c, request);
        Io/drain(c.0));
