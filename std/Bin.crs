pub use /sys/Bin/*;
pub use /sys/{Bin};
use /std/{Arr, Nat};

pub let fold(A : Type, str : Bin, init : A, f : (Nat, A) -> A) -> A =
    match len(str) : A
    | 0 => init
    | pred + 1, ih => f(get(str, pred), ih)
    end;

-- Concatenate `parts` by divide-and-conquer: O(total bytes · log parts) instead of
-- the O(n^2) of folding `concat(acc, part)` left to right (each step copies the whole
-- accumulator). `[lo, hi)` is the sub-range of `parts` being concatenated.
pub let concat_all(parts : Arr(Bin)) -> Bin =
    rec go(lo : Nat, hi : Nat) -> Bin =
        match Nat/lt(Nat/add(lo, 1), hi) : Bin
        | false =>
            match Nat/lt(lo, hi) : Bin
            | false => ""
            | true => Arr/get(Bin, parts, lo)
            end
        | true =>
            let mid : Nat = Nat/div(Nat/add(lo, hi), 2);
            concat(go(lo, mid), go(mid, hi))
        end;
    go(0, Arr/len(Bin, parts));

-- Same balanced shape as `concat_all`, inserting `sep` at each split point — which
-- visits every adjacent pair exactly once, so exactly `len(parts) - 1` separators in
-- order. O(total bytes · log parts), versus the old left fold's O(n^2).
pub let join(sep : Bin, parts : Arr(Bin)) -> Bin =
    rec go(lo : Nat, hi : Nat) -> Bin =
        match Nat/lt(Nat/add(lo, 1), hi) : Bin
        | false =>
            match Nat/lt(lo, hi) : Bin
            | false => ""
            | true => Arr/get(Bin, parts, lo)
            end
        | true =>
            let mid : Nat = Nat/div(Nat/add(lo, hi), 2);
            concat(concat(go(lo, mid), sep), go(mid, hi))
        end;
    go(0, Arr/len(Bin, parts));
