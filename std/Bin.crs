pub use /sys/{Bin};
pub use /sys/Bin/{let len, let eql, let slice, let append, let concat, let flatten};
use /std/{Arr, Nat, Bln, Option};

pub let at(b : Bin, i : Nat, ok : Nat/Lt(i, len(b))) -> Nat =
    /sys/Bin/get(b, i);

pub let get(b : Bin, i : Nat) -> Option(Nat) =
    match Nat/lt(i, len(b))
    | true => Option/some(/sys/Bin/get(b, i))
    | false => Option/none()
    end;

pub let cons(head : Nat, tail : Bin) -> Bin =
    concat(append(\\, head), tail);

pub let fold(@A : Type, b : Bin, init : A, f : (Nat, A) -> A) -> A =
    match len(b)
    | 0 => init
    | pred + 1, ih => f(/sys/Bin/get(b, pred), ih)
    end;

pub let find_index(b : Bin, pred : (Nat) -> Bln) -> Option(Nat) =
    let r : {Nat, Option(Nat)} =
        fold(b, (0, Option/none()), (byte, acc) =>
            match acc.1
            | some(_) => acc
            | none() =>
                match pred(byte)
                | true => (acc.0, Option/some(acc.0))
                | false => (Nat/add(acc.0, 1), Option/none())
                end
            end);
    r.1;

pub let join(sep : Bin, parts : Arr(Bin)) -> Bin =
    Arr/balanced(Arr/len(parts), \\, (i) => Option/unwrap_or(Arr/get(parts, i), \\),
        (l, r) => concat(concat(l, sep), r));
