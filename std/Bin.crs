pub use /sys/{Bin};
pub use /sys/Bin/{len, eql, slice, append, concat, flatten};
use /std/{Arr, Nat, Bln, Option, Eq};

pub let at(b : Bin, i : Nat, ok : Nat/Lt(i, len(b))) -> Nat =
    /sys/Bin/get(b, i);

pub let get(b : Bin, i : Nat) -> Option(Nat) =
    match i < len(b)
    | true => Option/some(/sys/Bin/get(b, i))
    | false => Option/none()
    end;

pub let cons(head : Nat, tail : Bin) -> Bin =
    concat(append(\\, head), tail);

pub let fold(@A : Type, b : Bin, init : A, f : (Nat, A) -> A) -> A =
    let n = len(b);
    rec go(k : Nat, i : Nat, acc : A, inv : Eq(i + k, n)) -> A =
        let dispatch =
            match k : (m) => (proof : Eq(i + m, n)) -> A
            | 0 => (_) => acc
            | kp + 1, ih => (inv2) =>
                go(kp, i + 1,
                    f(at(b, i, Eq/subst((x) => Nat/Lt(i, x), inv2, Nat/lte_to_lt_succ(Nat/lte_add_r(i, kp)))), acc),
                    inv2)
            end;
        dispatch(inv);
    go(n, 0, init, Eq/refl());

pub let find_index(b : Bin, pred : (Nat) -> Bln) -> Option(Nat) =
    let r : {Nat, Option(Nat)} =
        fold(b, (0, Option/none()), (byte, acc) =>
            match acc.1
            | some(_) => acc
            | none() =>
                (acc.0 + 1,
                    match pred(byte)
                    | true => Option/some(acc.0)
                    | false => Option/none()
                    end)
            end);
    r.1;

pub let join(sep : Bin, parts : Arr(Bin)) -> Bin =
    Arr/balanced(Arr/len(parts), \\, (i) => Option/unwrap_or(Arr/get(parts, i), \\),
        (l, r) => concat(concat(l, sep), r));
