pub use /sys/{Bin};
pub use /sys/Bin/*;
use /std/{Arr, Nat};

pub let fold(@A : Type, str : Bin, init : A, f : (Nat, A) -> A) -> A =
    match len(str)
    | 0 => init
    | pred + 1, ih => f(get(str, pred), ih)
    end;

pub let concat_all(parts : Arr(Bin)) -> Bin =
    Arr/balanced(Arr/len(parts), \\, (i) => Arr/get(parts, i), concat);

pub let join(sep : Bin, parts : Arr(Bin)) -> Bin =
    Arr/balanced(Arr/len(parts), \\, (i) => Arr/get(parts, i),
        (l, r) => concat(concat(l, sep), r));
