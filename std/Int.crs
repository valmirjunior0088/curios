pub use /sys/{Int};
pub use /sys/Int/*;
use /std/{Nat, Str, Option};

pub let not(x : Int) -> Int =
    xor(x, -1);

pub let of_str(s : Str) -> Option(Int) =
    match Nat/eql(Str/len(s), 0)
    | true => Option/none()
    | false =>
        let ! = Option/bind;
        let first = Str/get(s, 0);
        let digits =
            match first
            | '+' => Str/slice(s, 1, Str/len(s))
            | '-' => Str/slice(s, 1, Str/len(s))
            | _ => s
            end;
        let negative = Nat/eql(first, '-');
        let n = Nat/of_str(digits)!;
        match negative
        | true => Option/some(Int/sub(+0, Nat/to_int(n)))
        | false => Option/some(Nat/to_int(n))
        end
    end;

pub let abs(n : Int) -> Nat =
    match gte(n, +0)
    | true => to_nat(n)
    | false => to_nat(sub(+0, n))
    end;
