pub use /sys/{Arr};
pub use /sys/Arr/*;
use /std/{Nat};

pub let fold(@T : Type, @A : Type, arr : Arr(T), init : A, f : (T, A) -> A) -> A =
    match len(arr)
    | 0 => init
    | pred + 1, ih => f(get(arr, pred), ih)
    end;

pub let map(@A : Type, @B : Type, f : (A) -> B, arr : Arr(A)) -> Arr(B) =
    rec go(lo : Nat, hi : Nat) -> Arr(B) =
        match Nat/lt(Nat/add(lo, 1), hi)
        | false =>
            match Nat/lt(lo, hi)
            | false => []
            | true => [f(get(arr, lo))]
            end
        | true =>
            let mid = Nat/div(Nat/add(lo, hi), 2);
            concat(go(lo, mid), go(mid, hi))
        end;
    go(0, len(arr));
