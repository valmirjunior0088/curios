pub use /syn/Str/{let Str};
use /syn/Str/{Scan, Utf8, let step, let Valid};
use /std/{Char, Nat, Bin, Bln, Arr, Lst, Option};


rec seq(@s : Scan, @a : Bin, @b : Bin, va : Utf8(s, a), vb : Valid(b))
    -> Utf8(s, Bin/concat(a, b)) =
    match va : (w : Utf8(q, x)) => Utf8(q, Bin/concat(x, b))
    | stop() => vb
    | more(c, st, t, rest) => Utf8/more(c, st, Bin/concat(t, b), seq(rest, vb))
    end;

let concat_closed(@a : Bin, @b : Bin, va : Valid(a), vb : Valid(b))
    -> Valid(Bin/concat(a, b)) =
    seq(va, vb);

let check(b : Bin) -> ((s : Scan) -> Option(Utf8(s, b))) =
    match b : (b) => (s : Scan) -> Option(Utf8(s, b))
    | \\ => (s) =>
        match s : (s) => Option(Utf8(s, \\))
        | lead() => Option/some(Utf8/stop())
        | cont(rem, lo, hi) => Option/none()
        | bad() => Option/none()
        end
    | (h, t), ih => (s) =>
        match ih(step(h, s)) : Option(Utf8(s, Bin/cons(h, t)))
        | some(rest) => Option/some(Utf8/more(h, s, t, rest))
        | none() => Option/none()
        end
    end;

pub let to_bin(s : Str) -> Bin =
    s.bytes;

pub let of_bin(b : Bin) -> Option(Str) =
    match check(b)(Scan/lead())
    | some(v) => Option/some(Str { bytes = b, valid = v })
    | none() => Option/none()
    end;

pub let concat(a : Str, b : Str) -> Str =
    Str { bytes = Bin/concat(a.bytes, b.bytes),
          valid = concat_closed(@a.bytes, @b.bytes, a.valid, b.valid) };

rec drop_width(n : Nat, s : Scan, b : Bin) -> Nat =
    match b
    | \\ => 0
    | (h, t), ih =>
        match s
        | lead() =>
            match n
            | 0 => 0
            | pred + 1, ih2 => Nat/add(1, drop_width(pred, step(h, Scan/lead()), t))
            end
        | cont(rem, lo, hi) => Nat/add(1, drop_width(n, step(h, Scan/cont(rem, lo, hi)), t))
        | bad() => Nat/add(1, drop_width(n, step(h, Scan/bad()), t))
        end
    end;

rec drop_valid(n : Nat, s : Scan, @b : Bin, d : Utf8(s, b))
    -> Valid(Bin/slice(b, drop_width(n, s, b), Bin/len(b))) =
    let go =
        match s : (s) => (p : Utf8(s, b))
            -> Valid(Bin/slice(b, drop_width(n, s, b), Bin/len(b)))
        | lead() => (p) =>
            match p : (w : Utf8(q, x)) => Valid(Bin/slice(x, drop_width(n, q, x), Bin/len(x)))
            | stop() => Utf8/stop()
            | more(c, st, t, rest) =>
                match n : (n) => Valid(Bin/slice(Bin/cons(c, t),
                    drop_width(n, Scan/lead(), Bin/cons(c, t)),
                    Bin/len(Bin/cons(c, t))))
                | 0 => Utf8/more(c, Scan/lead(), t, rest)
                | pred + 1, ih => drop_valid(pred, step(c, Scan/lead()), @t, rest)
                end
            end
        | cont(rem, lo, hi) => (p) =>
            match p : (w : Utf8(q, x)) => Valid(Bin/slice(x, drop_width(n, q, x), Bin/len(x)))
            | more(c, st, t, rest) => drop_valid(n, step(c, Scan/cont(rem, lo, hi)), @t, rest)
            end
        | bad() => (p) =>
            match p : (w : Utf8(q, x)) => Valid(Bin/slice(x, drop_width(n, q, x), Bin/len(x)))
            | more(c, st, t, rest) => drop_valid(n, step(c, Scan/bad()), @t, rest)
            end
        end;
    go(d);

rec take_valid(n : Nat, s : Scan, @b : Bin, d : Utf8(s, b))
    -> Utf8(s, Bin/slice(b, 0, drop_width(n, s, b))) =
    let go =
        match s : (s) => (p : Utf8(s, b))
            -> Utf8(s, Bin/slice(b, 0, drop_width(n, s, b)))
        | lead() => (p) =>
            match p : (w : Utf8(q, x)) => Utf8(q, Bin/slice(x, 0, drop_width(n, q, x)))
            | stop() => Utf8/stop()
            | more(c, st, t, rest) =>
                match n : (n) => Utf8(Scan/lead(), Bin/slice(Bin/cons(c, t), 0,
                    drop_width(n, Scan/lead(), Bin/cons(c, t))))
                | 0 => Utf8/stop()
                | pred + 1, ih =>
                    Utf8/more(c, Scan/lead(), Bin/slice(t, 0, drop_width(pred, step(c, Scan/lead()), t)),
                        take_valid(pred, step(c, Scan/lead()), @t, rest))
                end
            end
        | cont(rem, lo, hi) => (p) =>
            match p : (w : Utf8(q, x)) => Utf8(q, Bin/slice(x, 0, drop_width(n, q, x)))
            | more(c, st, t, rest) =>
                Utf8/more(c, Scan/cont(rem, lo, hi),
                    Bin/slice(t, 0, drop_width(n, step(c, Scan/cont(rem, lo, hi)), t)),
                    take_valid(n, step(c, Scan/cont(rem, lo, hi)), @t, rest))
            end
        | bad() => (p) =>
            match p : (w : Utf8(q, x)) => Utf8(q, Bin/slice(x, 0, drop_width(n, q, x)))
            | more(c, st, t, rest) =>
                Utf8/more(c, Scan/bad(),
                    Bin/slice(t, 0, drop_width(n, step(c, Scan/bad()), t)),
                    take_valid(n, step(c, Scan/bad()), @t, rest))
            end
        end;
    go(d);

let drop_n(n : Nat, s : Str) -> Str =
    Str { bytes = Bin/slice(s.bytes, drop_width(n, Scan/lead(), s.bytes), Bin/len(s.bytes)),
          valid = drop_valid(n, Scan/lead(), @s.bytes, s.valid) };

let take_n(n : Nat, s : Str) -> Str =
    Str { bytes = Bin/slice(s.bytes, 0, drop_width(n, Scan/lead(), s.bytes)),
          valid = take_valid(n, Scan/lead(), @s.bytes, s.valid) };

pub let slice(s : Str, x : Nat, y : Nat) -> Str =
    take_n(Nat/sub(y, x), drop_n(x, s));

pub let flatten(parts : Lst(Str)) -> Str =
    let pa = Lst/to_arr(parts);
    Str {
        bytes = Bin/flatten(Arr/map(to_bin, pa)),
        valid =
            match pa : (p) => Valid(Bin/flatten(Arr/map(to_bin, p)))
            | [] => Utf8/stop()
            | (h, t), ih => concat_closed(@to_bin(h), @Bin/flatten(Arr/map(to_bin, t)), h.valid, ih)
            end
    };

pub let eql(a : Str, b : Str) -> Bln =
    Bin/eql(to_bin(a), to_bin(b));

let lower_bytes(b : Bin) -> Bin =
    Bin/fold(b, \\, (byte, acc) => Bin/append(acc, Char/to_lower(byte)));

pub let eql_ci(a : Str, b : Str) -> Bln =
    Bin/eql(lower_bytes(to_bin(a)), lower_bytes(to_bin(b)));

pub rec repeat(s : Str, n : Nat) -> Str =
    match Nat/eql(n, 0)
    | true => ""
    | false => concat(s, repeat(s, Nat/sub(n, 1)))
    end;

rec scan_to_boundary(b : Bin, pos : Nat, st : Scan) -> Nat =
    match st
    | lead() => pos
    | bad() => pos
    | cont(rem, lo, hi) =>
        match Nat/lt(pos, Bin/len(b))
        | false => pos
        | true => scan_to_boundary(b, Nat/add(pos, 1), step(Bin/get(b, pos), st))
        end
    end;

let advance_codepoint(b : Bin, off : Nat) -> Nat =
    match Nat/lt(off, Bin/len(b))
    | false => off
    | true => scan_to_boundary(b, Nat/add(off, 1), step(Bin/get(b, off), Scan/lead()))
    end;

let decode_at(b : Bin, off : Nat) -> Nat =
    let lead = Bin/get(b, off);
    match Nat/lt(lead, 0x80)
    | true => lead
    | false =>
        match Nat/lt(lead, 0xE0)
        | true =>
            Nat/add(
                Nat/mul(Nat/sub(lead, 0xC0), 0x40),
                Nat/sub(Bin/get(b, Nat/add(off, 1)), 0x80))
        | false =>
            match Nat/lt(lead, 0xF0)
            | true =>
                Nat/add(
                    Nat/add(
                        Nat/mul(Nat/sub(lead, 0xE0), 0x1000),
                        Nat/mul(Nat/sub(Bin/get(b, Nat/add(off, 1)), 0x80), 0x40)),
                    Nat/sub(Bin/get(b, Nat/add(off, 2)), 0x80))
            | false =>
                Nat/add(
                    Nat/add(
                        Nat/add(
                            Nat/mul(Nat/sub(lead, 0xF0), 0x40000),
                            Nat/mul(Nat/sub(Bin/get(b, Nat/add(off, 1)), 0x80), 0x1000)),
                        Nat/mul(Nat/sub(Bin/get(b, Nat/add(off, 2)), 0x80), 0x40)),
                    Nat/sub(Bin/get(b, Nat/add(off, 3)), 0x80))
            end
        end
    end;

let byte_offset(b : Bin, i : Nat) -> Nat =
    match i : Nat
    | 0 => 0
    | pred + 1, ih => advance_codepoint(b, ih)
    end;

pub let fold(@A : Type, s : Str, init : A, f : (Nat, A) -> A) -> A =
    let b = to_bin(s);
    rec go(off : Nat, acc : A) -> A =
        match Nat/lt(off, Bin/len(b))
        | false => acc
        | true => go(advance_codepoint(b, off), f(decode_at(b, off), acc))
        end;
    go(0, init);

pub let len(s : Str) -> Nat =
    fold(s, 0, (cp, acc) => Nat/add(acc, 1));

pub let find_index(s : Str, pred : (Nat) -> Bln) -> Option(Nat) =
    let r : {Nat, Option(Nat)} =
        fold(s, (0, Option/none()), (cp, acc) =>
            match acc.1
            | some(_) => acc
            | none() =>
                match pred(cp)
                | true => (Nat/add(acc.0, 1), Option/some(acc.0))
                | false => (Nat/add(acc.0, 1), Option/none())
                end
            end);
    r.1;

pub let find(s : Str, target : Nat) -> Option(Nat) =
    find_index(s, (cp) => Nat/eql(cp, target));

pub let get(s : Str, i : Nat) -> Nat =
    let b = to_bin(s);
    decode_at(b, byte_offset(b, i));

pub let join(sep : Str, parts : Lst(Str)) -> Str =
    let pa = Lst/to_arr(parts);
    Arr/balanced(Arr/len(pa), "", (i) => Arr/get(pa, i),
        (l, r) => concat(concat(l, sep), r));

let trim_bounds(s : Str) -> {Nat, Nat} =
    let n = len(s);
    let r : {Nat, Nat, Nat} =
        fold(s, (0, n, 0), (cp, acc) =>
            match Char/is_whitespace(cp)
            | true => (Nat/add(acc.0, 1), acc.1, acc.2)
            | false =>
                let start =
                    match Nat/lt(acc.1, n)
                    | true => acc.1
                    | false => acc.0
                    end;
                (Nat/add(acc.0, 1), start, Nat/add(acc.0, 1))
            end);
    (r.1, r.2);

pub let trim(s : Str) -> Str =
    let b = trim_bounds(s);
    match Nat/lt(b.0, b.1)
    | false => ""
    | true => slice(s, b.0, b.1)
    end;
