pub use /syn/Str/{let Str};
use /syn/Str/{Scan, Utf8, Class, let step, let classify, let Valid};
use /std/{Char, Nat, Bin, Bln, Arr, Lst, Option, True, False, Eq};


rec seq(@s : Scan, @a : Bin, @b : Bin, va : Utf8(s, a), vb : Valid(b))
    -> Utf8(s, Bin/concat(a, b)) =
    match va : (w : Utf8(q, x)) => Utf8(q, Bin/concat(x, b))
    | stop() => vb
    | more(c, st, t, rest) => Utf8/more(c, st, Bin/concat(t, b), seq(rest, vb))
    end;

let concat_closed(@a : Bin, @b : Bin, va : Valid(a), vb : Valid(b))
    -> Valid(Bin/concat(a, b)) =
    seq(va, vb);

let check(b : Bin) -> ((s : Scan) -> Option(Utf8(s, b))) =
    match b : (b) => (s : Scan) -> Option(Utf8(s, b))
    | \\ => (s) =>
        match s : (s) => Option(Utf8(s, \\))
        | lead() => Option/some(Utf8/stop())
        | cont(rem, lo, hi) => Option/none()
        | bad() => Option/none()
        end
    | (h, t), ih => (s) =>
        match ih(step(h, s)) : Option(Utf8(s, Bin/cons(h, t)))
        | some(rest) => Option/some(Utf8/more(h, s, t, rest))
        | none() => Option/none()
        end
    end;

pub let to_bin(s : Str) -> Bin =
    s.bytes;

pub let of_bin(b : Bin) -> Option(Str) =
    match check(b)(Scan/lead())
    | some(v) => Option/some(Str { bytes = b, valid = v })
    | none() => Option/none()
    end;

pub let concat(a : Str, b : Str) -> Str =
    Str { bytes = Bin/concat(a.bytes, b.bytes),
          valid = concat_closed(@a.bytes, @b.bytes, a.valid, b.valid) };

rec drop_width(n : Nat, s : Scan, b : Bin) -> Nat =
    match b
    | \\ => 0
    | (h, t), ih =>
        match s
        | lead() =>
            match n
            | 0 => 0
            | pred + 1, ih2 => 1 + drop_width(pred, step(h, Scan/lead()), t)
            end
        | cont(rem, lo, hi) => 1 + drop_width(n, step(h, Scan/cont(rem, lo, hi)), t)
        | bad() => 1 + drop_width(n, step(h, Scan/bad()), t)
        end
    end;

rec drop_valid(n : Nat, s : Scan, @b : Bin, d : Utf8(s, b))
    -> Valid(Bin/slice(b, drop_width(n, s, b), Bin/len(b))) =
    let go =
        match s : (s) => (p : Utf8(s, b))
            -> Valid(Bin/slice(b, drop_width(n, s, b), Bin/len(b)))
        | lead() => (p) =>
            match p : (w : Utf8(q, x)) => Valid(Bin/slice(x, drop_width(n, q, x), Bin/len(x)))
            | stop() => Utf8/stop()
            | more(c, st, t, rest) =>
                match n : (n) => Valid(Bin/slice(Bin/cons(c, t),
                    drop_width(n, Scan/lead(), Bin/cons(c, t)),
                    Bin/len(Bin/cons(c, t))))
                | 0 => Utf8/more(c, Scan/lead(), t, rest)
                | pred + 1, ih => drop_valid(pred, step(c, Scan/lead()), @t, rest)
                end
            end
        | cont(rem, lo, hi) => (p) =>
            match p : (w : Utf8(q, x)) => Valid(Bin/slice(x, drop_width(n, q, x), Bin/len(x)))
            | more(c, st, t, rest) => drop_valid(n, step(c, Scan/cont(rem, lo, hi)), @t, rest)
            end
        | bad() => (p) =>
            match p : (w : Utf8(q, x)) => Valid(Bin/slice(x, drop_width(n, q, x), Bin/len(x)))
            | more(c, st, t, rest) => drop_valid(n, step(c, Scan/bad()), @t, rest)
            end
        end;
    go(d);

rec take_valid(n : Nat, s : Scan, @b : Bin, d : Utf8(s, b))
    -> Utf8(s, Bin/slice(b, 0, drop_width(n, s, b))) =
    let go =
        match s : (s) => (p : Utf8(s, b))
            -> Utf8(s, Bin/slice(b, 0, drop_width(n, s, b)))
        | lead() => (p) =>
            match p : (w : Utf8(q, x)) => Utf8(q, Bin/slice(x, 0, drop_width(n, q, x)))
            | stop() => Utf8/stop()
            | more(c, st, t, rest) =>
                match n : (n) => Utf8(Scan/lead(), Bin/slice(Bin/cons(c, t), 0,
                    drop_width(n, Scan/lead(), Bin/cons(c, t))))
                | 0 => Utf8/stop()
                | pred + 1, ih =>
                    Utf8/more(c, Scan/lead(), Bin/slice(t, 0, drop_width(pred, step(c, Scan/lead()), t)),
                        take_valid(pred, step(c, Scan/lead()), @t, rest))
                end
            end
        | cont(rem, lo, hi) => (p) =>
            match p : (w : Utf8(q, x)) => Utf8(q, Bin/slice(x, 0, drop_width(n, q, x)))
            | more(c, st, t, rest) =>
                Utf8/more(c, Scan/cont(rem, lo, hi),
                    Bin/slice(t, 0, drop_width(n, step(c, Scan/cont(rem, lo, hi)), t)),
                    take_valid(n, step(c, Scan/cont(rem, lo, hi)), @t, rest))
            end
        | bad() => (p) =>
            match p : (w : Utf8(q, x)) => Utf8(q, Bin/slice(x, 0, drop_width(n, q, x)))
            | more(c, st, t, rest) =>
                Utf8/more(c, Scan/bad(),
                    Bin/slice(t, 0, drop_width(n, step(c, Scan/bad()), t)),
                    take_valid(n, step(c, Scan/bad()), @t, rest))
            end
        end;
    go(d);

let drop_n(n : Nat, s : Str) -> Str =
    Str { bytes = Bin/slice(s.bytes, drop_width(n, Scan/lead(), s.bytes), Bin/len(s.bytes)),
          valid = drop_valid(n, Scan/lead(), @s.bytes, s.valid) };

let take_n(n : Nat, s : Str) -> Str =
    Str { bytes = Bin/slice(s.bytes, 0, drop_width(n, Scan/lead(), s.bytes)),
          valid = take_valid(n, Scan/lead(), @s.bytes, s.valid) };

pub let slice(s : Str, x : Nat, y : Nat) -> Str =
    take_n(y - x, drop_n(x, s));

pub let flatten(parts : Lst(Str)) -> Str =
    let pa = Lst/to_arr(parts);
    Str {
        bytes = Bin/flatten(Arr/map(to_bin, pa)),
        valid =
            match pa : (p) => Valid(Bin/flatten(Arr/map(to_bin, p)))
            | [] => Utf8/stop()
            | (h, t), ih => concat_closed(@to_bin(h), @Bin/flatten(Arr/map(to_bin, t)), h.valid, ih)
            end
    };

pub let eql(a : Str, b : Str) -> Bln =
    Bin/eql(to_bin(a), to_bin(b));

let lower_bytes(b : Bin) -> Bin =
    Bin/fold(b, \\, (byte, acc) => Bin/append(acc, Char/to_lower(byte)));

pub let eql_ci(a : Str, b : Str) -> Bln =
    Bin/eql(lower_bytes(to_bin(a)), lower_bytes(to_bin(b)));

pub rec repeat(s : Str, n : Nat) -> Str =
    match n == 0
    | true => ""
    | false => concat(s, repeat(s, n - 1))
    end;

pub rec bad_uninhabited(@x : Bin, w : Utf8(Scan/bad(), x)) -> False =
    match w : (w : Utf8(q, y)) => False
    | more(c, st, t, rest) => bad_uninhabited(@t, rest)
    end;

pub rec cont_len(k : Nat, @lo : Nat, @hi : Nat, @t : Bin, w : Utf8(Scan/cont(k, lo, hi), t))
    -> Nat/Le(k, Bin/len(t)) =
    let on_k =
        match k : (k) => (w : Utf8(Scan/cont(k, lo, hi), t)) -> Nat/Le(k, Bin/len(t))
        | 0 => (w) => Nat/Le/z()
        | kp + 1, ih => (w) =>
            let on_w =
                match w : (w : Utf8(q, y)) => Nat/Le(kp + 1, Bin/len(y))
                | more(c, st, tt, rest) =>
                    let on_kp =
                        match kp : (kp) =>
                            (rest : Utf8(step(c, Scan/cont(kp + 1, lo, hi)), tt))
                                -> Nat/Le(kp + 1, Bin/len(tt) + 1)
                        | 0 => (rest) => Nat/Le/s(Nat/Le/z())
                        | kpp + 1, ih2 => (rest) =>
                            let on_range =
                                match Nat/in_range(c, lo, hi) : (r) =>
                                    (rest : Utf8(match r
                                        | false => Scan/bad()
                                        | true => Scan/cont(kpp + 1, 0x80, 0xBF)
                                        end, tt))
                                        -> Nat/Le(kpp + 1, Bin/len(tt))
                                | true => (rest) => cont_len(kpp + 1, @0x80, @0xBF, @tt, rest)
                                | false => (rest) =>
                                    False/absurd(@Nat/Le(kpp + 1, Bin/len(tt)),
                                        bad_uninhabited(@tt, rest))
                                end;
                            Nat/Le/s(on_range(rest))
                        end;
                    on_kp(rest)
                end;
            on_w
        end;
    on_k(w);

pub rec cont0_uninhabited(@lo : Nat, @hi : Nat, @t : Bin, w : Utf8(Scan/cont(0, lo, hi), t)) -> False =
    match w : (w : Utf8(q, y)) => False
    | more(c, st, t2, rest) =>
        let on_range =
            match Nat/in_range(c, lo, hi) : (r) =>
                (rest : Utf8(match r
                    | false => Scan/bad()
                    | true => Scan/cont(0, 0x80, 0xBF)
                    end, t2))
                    -> False
            | false => (rest) => bad_uninhabited(@t2, rest)
            | true => (rest) => cont0_uninhabited(@0x80, @0xBF, @t2, rest)
            end;
        on_range(rest)
    end;

pub rec take_conts(b : Bin, off : Nat, remaining : Nat, acc : Nat,
    bound : Nat/Le(off + remaining, Bin/len(b))) -> {Nat, Nat} =
    let go =
        match remaining : (remaining) =>
            (bound : Nat/Le(off + remaining, Bin/len(b))) -> {Nat, Nat}
        | 0 => (bound) => (acc, off)
        | pred + 1, ih => (bound) =>
            take_conts(b, off + 1, pred,
                acc * 0x40 + (Bin/at(b, off,
                    Nat/lt_of_le_succ(Nat/le_trans(Nat/Le/s(Nat/le_add_r(off, pred)), bound))) - 0x80),
                bound)
        end;
    go(bound);

pub rec peel_byte(@s : Scan, @b : Bin, nz : Nat/Lt(0, Bin/len(b)), w : Utf8(s, b))
    -> Utf8(step(Bin/at(b, 0, nz), s), Bin/slice(b, 1, Bin/len(b))) =
    let go =
        match w : (w : Utf8(q, x)) => (nz : Nat/Lt(0, Bin/len(x)))
            -> Utf8(step(Bin/at(x, 0, nz), q), Bin/slice(x, 1, Bin/len(x)))
        | stop() => (nz) =>
            False/absurd(@Utf8(step(Bin/at(\\, 0, nz), Scan/lead()), Bin/slice(\\, 1, Bin/len(\\))), nz)
        | more(c, st, t, rest) => (nz) => rest
        end;
    go(nz);

pub rec count_w(s : Scan, b : Bin) -> Nat =
    match b
    | \\ => 0
    | (h, t), ih =>
        match s
        | lead() => count_w(step(h, Scan/lead()), t) + 1
        | cont(rem, lo, hi) => count_w(step(h, Scan/cont(rem, lo, hi)), t)
        | bad() => count_w(step(h, Scan/bad()), t)
        end
    end;

let lead_step(cl : Class) -> Scan =
    match cl
    | ascii() => Scan/lead()
    | lead(n, a, b, p) => Scan/cont(n, a, b)
    | bad() => Scan/bad()
    end;

pub let step_lead_lead(c : Nat, @k : Nat, @lo : Nat, @hi : Nat, @payload : Nat,
    eq : Eq(classify(c), Class/lead(k, lo, hi, payload)))
    -> Eq(step(c, Scan/lead()), Scan/cont(k, lo, hi)) =
    Eq/cong(lead_step, eq);

pub let step_lead_ascii(c : Nat, eq : Eq(classify(c), Class/ascii()))
    -> Eq(step(c, Scan/lead()), Scan/lead()) =
    Eq/cong(lead_step, eq);

pub let step_lead_bad(c : Nat, eq : Eq(classify(c), Class/bad()))
    -> Eq(step(c, Scan/lead()), Scan/bad()) =
    Eq/cong(lead_step, eq);

pub let decode_head(c : Nat, @t : Bin, w : Utf8(Scan/lead(), Bin/cons(c, t))) -> Nat =
    let go =
        match classify(c) : (cl) => (eq : Eq(classify(c), cl)) -> Nat
        | ascii() => (eq) => c
        | lead(k, lo, hi, payload) => (eq) =>
            take_conts(t, 0, k, payload,
                cont_len(k, @lo, @hi, @t,
                    Eq/subst((sc : Scan) => Utf8(sc, t), step_lead_lead(c, eq),
                        peel_byte(@Scan/lead(), @Bin/cons(c, t), True/qed(), w)))).0
        | bad() => (eq) =>
            False/absurd(@Nat,
                bad_uninhabited(@t,
                    Eq/subst((sc : Scan) => Utf8(sc, t), step_lead_bad(c, eq),
                        peel_byte(@Scan/lead(), @Bin/cons(c, t), True/qed(), w))))
        end;
    go(Eq/refl());

pub let fold(@A : Type, s : Str, init : A, f : (Nat, A) -> A) -> A =
    rec go(sc : Scan, b : Bin, valid : Utf8(sc, b), acc : A) -> A =
        (match b : (b) => (valid : Utf8(sc, b)) -> A
        | \\ => (valid) => acc
        | (h, t), ih => (valid) =>
            (match sc : (sc) => (valid : Utf8(sc, Bin/cons(h, t))) -> A
            | lead() => (valid) =>
                go(step(h, Scan/lead()), t,
                    peel_byte(@Scan/lead(), @Bin/cons(h, t), True/qed(), valid),
                    f(decode_head(h, @t, valid), acc))
            | cont(rem, lo, hi) => (valid) =>
                go(step(h, Scan/cont(rem, lo, hi)), t,
                    peel_byte(@Scan/cont(rem, lo, hi), @Bin/cons(h, t), True/qed(), valid), acc)
            | bad() => (valid) =>
                go(step(h, Scan/bad()), t,
                    peel_byte(@Scan/bad(), @Bin/cons(h, t), True/qed(), valid), acc)
            end)(valid)
        end)(valid);
    go(Scan/lead(), s.bytes, s.valid, init);

pub let len(s : Str) -> Nat =
    count_w(Scan/lead(), s.bytes);

pub let find_index(s : Str, pred : (Nat) -> Bln) -> Option(Nat) =
    let r : {Nat, Option(Nat)} =
        fold(s, (0, Option/none()), (codepoint, acc) =>
            match acc.1
            | some(_) => acc
            | none() =>
                match pred(codepoint)
                | true => (acc.0 + 1, Option/some(acc.0))
                | false => (acc.0 + 1, Option/none())
                end
            end);
    r.1;

pub let find(s : Str, target : Nat) -> Option(Nat) =
    find_index(s, (codepoint) => codepoint == target);

pub let get(s : Str, i : Nat) -> Option(Nat) =
    let r : {Nat, Option(Nat)} =
        fold(s, (0, Option/none()), (codepoint, acc) =>
            match acc.1
            | some(_) => acc
            | none() =>
                match acc.0 == i
                | true => (acc.0 + 1, Option/some(codepoint))
                | false => (acc.0 + 1, Option/none())
                end
            end);
    r.1;

rec le_succ_of_lt(i : Nat, n : Nat, p : Nat/Lt(i, n)) -> Nat/Le(i + 1, n) =
    let on_n =
        match n : (n) => (p : Nat/Lt(i, n)) -> Nat/Le(i + 1, n)
        | 0 => (p) => False/absurd(@Nat/Le(i + 1, 0), p)
        | np + 1, ihn => (p) =>
            let on_i =
                match i : (i) => (p : Nat/Lt(i, np + 1)) -> Nat/Le(i + 1, np + 1)
                | 0 => (p) => Nat/Le/s(Nat/Le/z())
                | ip + 1, ihi => (p) => Nat/Le/s(le_succ_of_lt(ip, np, p))
                end;
            on_i(p)
        end;
    on_n(p);

pub let at(s : Str, i : Nat, ok : Nat/Lt(i, len(s))) -> Nat =
    rec go(sc : Scan, b : Bin, valid : Utf8(sc, b), i : Nat,
        le : Nat/Le(i + 1, count_w(sc, b))) -> Nat =
        let on_b =
            match b : (b) =>
                (valid : Utf8(sc, b), le : Nat/Le(i + 1, count_w(sc, b))) -> Nat
            | \\ => (valid, le) => match le : Nat end
            | (h, t), ih => (valid, le) =>
                let on_sc =
                    match sc : (sc) =>
                        (valid : Utf8(sc, Bin/cons(h, t)),
                         le : Nat/Le(i + 1, count_w(sc, Bin/cons(h, t)))) -> Nat
                    | lead() => (valid, le) =>
                        let on_i =
                            match i : (i) =>
                                (le : Nat/Le(i + 1,
                                    count_w(Scan/lead(), Bin/cons(h, t)))) -> Nat
                            | 0 => (le) => decode_head(h, @t, valid)
                            | pred + 1, ih2 => (le) =>
                                go(step(h, Scan/lead()), t,
                                    peel_byte(@Scan/lead(), @Bin/cons(h, t), True/qed(), valid), pred,
                                    (match le : (le : Nat/Le(x, y))
                                        => Nat/Le(x - 1, y - 1)
                                     | s(a, c, prev) => prev
                                     end))
                            end;
                        on_i(le)
                    | cont(rem, lo, hi) => (valid, le) =>
                        go(step(h, Scan/cont(rem, lo, hi)), t,
                            peel_byte(@Scan/cont(rem, lo, hi), @Bin/cons(h, t), True/qed(), valid), i, le)
                    | bad() => (valid, le) =>
                        go(step(h, Scan/bad()), t,
                            peel_byte(@Scan/bad(), @Bin/cons(h, t), True/qed(), valid), i, le)
                    end;
                on_sc(valid, le)
            end;
        on_b(valid, le);
    go(Scan/lead(), s.bytes, s.valid, i,
        le_succ_of_lt(i, count_w(Scan/lead(), s.bytes), ok));

pub let join(sep : Str, parts : Lst(Str)) -> Str =
    let pa = Lst/to_arr(parts);
    Arr/balanced(Arr/len(pa), "", (i) => Option/unwrap_or(Arr/get(pa, i), ""),
        (l, r) => concat(concat(l, sep), r));

let trim_bounds(s : Str) -> {Nat, Nat} =
    let n = len(s);
    let r : {Nat, Nat, Nat} =
        fold(s, (0, n, 0), (codepoint, acc) =>
            match Char/is_whitespace(codepoint)
            | true => (acc.0 + 1, acc.1, acc.2)
            | false =>
                let start =
                    match acc.1 < n
                    | true => acc.1
                    | false => acc.0
                    end;
                (acc.0 + 1, start, acc.0 + 1)
            end);
    (r.1, r.2);

pub let trim(s : Str) -> Str =
    let b = trim_bounds(s);
    match b.0 < b.1
    | false => ""
    | true => slice(s, b.0, b.1)
    end;
