pub use /sys/{Str};
pub use /sys/Str/{let to_bin};
use /std/{Char, Nat, Bin, Bln, Arr, Option};

let in_range(c : Nat, lo : Nat, hi : Nat) -> Bln =
    match Nat/gte(c, lo)
    | true => Nat/lte(c, hi)
    | false => false
    end;

union Scan
| lead()
| cont(Nat, Nat, Nat)
| bad()
end

let classify(c : Nat) -> Scan =
    match in_range(c, 0, 127)
    | true => Scan/lead()
    | false =>
        match in_range(c, 194, 223)
        | true => Scan/cont(1, 128, 191)
        | false =>
            match in_range(c, 224, 239)
            | true =>
                let lo = match Nat/eql(c, 224) | true => 160 | false => 128 end;
                let hi = match Nat/eql(c, 237) | true => 159 | false => 191 end;
                Scan/cont(2, lo, hi)
            | false =>
                match in_range(c, 240, 244)
                | true =>
                    let lo = match Nat/eql(c, 240) | true => 144 | false => 128 end;
                    let hi = match Nat/eql(c, 244) | true => 143 | false => 191 end;
                    Scan/cont(3, lo, hi)
                | false => Scan/bad()
                end
            end
        end
    end;

let step(c : Nat, s : Scan) -> Scan =
    match s
    | bad() => Scan/bad()
    | cont(rem, lo, hi) =>
        match in_range(c, lo, hi)
        | false => Scan/bad()
        | true =>
            match Nat/eql(rem, 1)
            | true => Scan/lead()
            | false => Scan/cont(Nat/sub(rem, 1), 128, 191)
            end
        end
    | lead() => classify(c)
    end;

pub let is_utf8(b : Bin) -> Bln =
    match Bin/fold(b, Scan/lead(), step)
    | lead() => true
    | cont(rem, lo, hi) => false
    | bad() => false
    end;

pub let eql(a : Str, b : Str) -> Bln =
    Bin/eql(to_bin(a), to_bin(b));

pub let concat(a : Str, b : Str) -> Str =
    Str/of_bin(Bin/concat(to_bin(a), to_bin(b)));

pub let len(s : Str) -> Nat =
    Bin/fold(to_bin(s), 0, (byte, acc) =>
        match in_range(byte, 128, 191)
        | true => acc
        | false => Nat/add(acc, 1)
        end);

pub let of_bin(b : Bin) -> Option(Str) =
    match is_utf8(b)
    | true => Option/some(Str/of_bin(b))
    | false => Option/none()
    end;

pub let concat_all(parts : Arr(Str)) -> Str =
    rec go(lo : Nat, hi : Nat) -> Str =
        match Nat/lt(Nat/add(lo, 1), hi)
        | false =>
            match Nat/lt(lo, hi)
            | false => ""
            | true => Arr/get(parts, lo)
            end
        | true =>
            let mid = Nat/div(Nat/add(lo, hi), 2);
            concat(go(lo, mid), go(mid, hi))
        end;
    go(0, Arr/len(parts));

pub let join(sep : Str, parts : Arr(Str)) -> Str =
    rec go(lo : Nat, hi : Nat) -> Str =
        match Nat/lt(Nat/add(lo, 1), hi)
        | false =>
            match Nat/lt(lo, hi)
            | false => ""
            | true => Arr/get(parts, lo)
            end
        | true =>
            let mid = Nat/div(Nat/add(lo, hi), 2);
            concat(concat(go(lo, mid), sep), go(mid, hi))
        end;
    go(0, Arr/len(parts));

pub let trim_start(str : Bin) -> Nat =
    match Bin/len(str)
    | 0 => Bin/len(str)
    | pred + 1, ih =>
        match Nat/lt(pred, ih)
        | true =>
            match Char/is_whitespace(Bin/get(str, pred))
            | true => ih
            | false => pred
            end
        | false => ih
        end
    end;

pub let trim_stop(str : Bin) -> Nat =
    match Bin/len(str)
    | 0 => 0
    | pred + 1, ih =>
        match Char/is_whitespace(Bin/get(str, pred))
        | true => ih
        | false => Nat/add(pred, 1)
        end
    end;

pub let trim(str : Bin) -> Bin =
    let start = trim_start(str);
    let stop = trim_stop(str);
    Bin/slice(str, Nat/min(start, stop), stop);
