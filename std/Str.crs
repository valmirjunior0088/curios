pub use /syn/Str/{let Str};
use /syn/Str/{Scan, Utf8, Class, let step, let classify, let Valid};
use /std/{Char, Nat, Bin, Bln, Arr, Lst, Option, Void, Eq};


rec seq(@s : Scan, @a : Bin, @b : Bin, va : Utf8(s, a), vb : Valid(b))
    -> Utf8(s, Bin/concat(a, b)) =
    match va : (w : Utf8(q, x)) => Utf8(q, Bin/concat(x, b))
    | stop() => vb
    | more(c, st, t, rest) => Utf8/more(c, st, Bin/concat(t, b), seq(rest, vb))
    end;

let concat_closed(@a : Bin, @b : Bin, va : Valid(a), vb : Valid(b))
    -> Valid(Bin/concat(a, b)) =
    seq(va, vb);

let check(b : Bin) -> ((s : Scan) -> Option(Utf8(s, b))) =
    match b : (b) => (s : Scan) -> Option(Utf8(s, b))
    | \\ => (s) =>
        match s : (s) => Option(Utf8(s, \\))
        | lead() => Option/some(Utf8/stop())
        | cont(rem, lo, hi) => Option/none()
        | bad() => Option/none()
        end
    | (h, t), ih => (s) =>
        match ih(step(h, s)) : Option(Utf8(s, Bin/cons(h, t)))
        | some(rest) => Option/some(Utf8/more(h, s, t, rest))
        | none() => Option/none()
        end
    end;

pub let to_bin(s : Str) -> Bin =
    s.bytes;

pub let of_bin(b : Bin) -> Option(Str) =
    match check(b)(Scan/lead())
    | some(v) => Option/some(Str { bytes = b, valid = v })
    | none() => Option/none()
    end;

pub let concat(a : Str, b : Str) -> Str =
    Str { bytes = Bin/concat(a.bytes, b.bytes),
          valid = concat_closed(@a.bytes, @b.bytes, a.valid, b.valid) };

rec drop_width(n : Nat, s : Scan, b : Bin) -> Nat =
    match b
    | \\ => 0
    | (h, t), ih =>
        match s
        | lead() =>
            match n
            | 0 => 0
            | pred + 1, ih2 => Nat/add(1, drop_width(pred, step(h, Scan/lead()), t))
            end
        | cont(rem, lo, hi) => Nat/add(1, drop_width(n, step(h, Scan/cont(rem, lo, hi)), t))
        | bad() => Nat/add(1, drop_width(n, step(h, Scan/bad()), t))
        end
    end;

rec drop_valid(n : Nat, s : Scan, @b : Bin, d : Utf8(s, b))
    -> Valid(Bin/slice(b, drop_width(n, s, b), Bin/len(b))) =
    let go =
        match s : (s) => (p : Utf8(s, b))
            -> Valid(Bin/slice(b, drop_width(n, s, b), Bin/len(b)))
        | lead() => (p) =>
            match p : (w : Utf8(q, x)) => Valid(Bin/slice(x, drop_width(n, q, x), Bin/len(x)))
            | stop() => Utf8/stop()
            | more(c, st, t, rest) =>
                match n : (n) => Valid(Bin/slice(Bin/cons(c, t),
                    drop_width(n, Scan/lead(), Bin/cons(c, t)),
                    Bin/len(Bin/cons(c, t))))
                | 0 => Utf8/more(c, Scan/lead(), t, rest)
                | pred + 1, ih => drop_valid(pred, step(c, Scan/lead()), @t, rest)
                end
            end
        | cont(rem, lo, hi) => (p) =>
            match p : (w : Utf8(q, x)) => Valid(Bin/slice(x, drop_width(n, q, x), Bin/len(x)))
            | more(c, st, t, rest) => drop_valid(n, step(c, Scan/cont(rem, lo, hi)), @t, rest)
            end
        | bad() => (p) =>
            match p : (w : Utf8(q, x)) => Valid(Bin/slice(x, drop_width(n, q, x), Bin/len(x)))
            | more(c, st, t, rest) => drop_valid(n, step(c, Scan/bad()), @t, rest)
            end
        end;
    go(d);

rec take_valid(n : Nat, s : Scan, @b : Bin, d : Utf8(s, b))
    -> Utf8(s, Bin/slice(b, 0, drop_width(n, s, b))) =
    let go =
        match s : (s) => (p : Utf8(s, b))
            -> Utf8(s, Bin/slice(b, 0, drop_width(n, s, b)))
        | lead() => (p) =>
            match p : (w : Utf8(q, x)) => Utf8(q, Bin/slice(x, 0, drop_width(n, q, x)))
            | stop() => Utf8/stop()
            | more(c, st, t, rest) =>
                match n : (n) => Utf8(Scan/lead(), Bin/slice(Bin/cons(c, t), 0,
                    drop_width(n, Scan/lead(), Bin/cons(c, t))))
                | 0 => Utf8/stop()
                | pred + 1, ih =>
                    Utf8/more(c, Scan/lead(), Bin/slice(t, 0, drop_width(pred, step(c, Scan/lead()), t)),
                        take_valid(pred, step(c, Scan/lead()), @t, rest))
                end
            end
        | cont(rem, lo, hi) => (p) =>
            match p : (w : Utf8(q, x)) => Utf8(q, Bin/slice(x, 0, drop_width(n, q, x)))
            | more(c, st, t, rest) =>
                Utf8/more(c, Scan/cont(rem, lo, hi),
                    Bin/slice(t, 0, drop_width(n, step(c, Scan/cont(rem, lo, hi)), t)),
                    take_valid(n, step(c, Scan/cont(rem, lo, hi)), @t, rest))
            end
        | bad() => (p) =>
            match p : (w : Utf8(q, x)) => Utf8(q, Bin/slice(x, 0, drop_width(n, q, x)))
            | more(c, st, t, rest) =>
                Utf8/more(c, Scan/bad(),
                    Bin/slice(t, 0, drop_width(n, step(c, Scan/bad()), t)),
                    take_valid(n, step(c, Scan/bad()), @t, rest))
            end
        end;
    go(d);

let drop_n(n : Nat, s : Str) -> Str =
    Str { bytes = Bin/slice(s.bytes, drop_width(n, Scan/lead(), s.bytes), Bin/len(s.bytes)),
          valid = drop_valid(n, Scan/lead(), @s.bytes, s.valid) };

let take_n(n : Nat, s : Str) -> Str =
    Str { bytes = Bin/slice(s.bytes, 0, drop_width(n, Scan/lead(), s.bytes)),
          valid = take_valid(n, Scan/lead(), @s.bytes, s.valid) };

pub let slice(s : Str, x : Nat, y : Nat) -> Str =
    take_n(Nat/sub(y, x), drop_n(x, s));

pub let flatten(parts : Lst(Str)) -> Str =
    let pa = Lst/to_arr(parts);
    Str {
        bytes = Bin/flatten(Arr/map(to_bin, pa)),
        valid =
            match pa : (p) => Valid(Bin/flatten(Arr/map(to_bin, p)))
            | [] => Utf8/stop()
            | (h, t), ih => concat_closed(@to_bin(h), @Bin/flatten(Arr/map(to_bin, t)), h.valid, ih)
            end
    };

pub let eql(a : Str, b : Str) -> Bln =
    Bin/eql(to_bin(a), to_bin(b));

let lower_bytes(b : Bin) -> Bin =
    Bin/fold(b, \\, (byte, acc) => Bin/append(acc, Char/to_lower(byte)));

pub let eql_ci(a : Str, b : Str) -> Bln =
    Bin/eql(lower_bytes(to_bin(a)), lower_bytes(to_bin(b)));

pub rec repeat(s : Str, n : Nat) -> Str =
    match Nat/eql(n, 0)
    | true => ""
    | false => concat(s, repeat(s, Nat/sub(n, 1)))
    end;

pub rec bad_uninhabited(@x : Bin, w : Utf8(Scan/bad(), x)) -> Void =
    match w : (w : Utf8(q, y)) => Void
    | more(c, st, t, rest) => bad_uninhabited(@t, rest)
    end;

pub rec cont_len(k : Nat, @lo : Nat, @hi : Nat, @t : Bin, w : Utf8(Scan/cont(k, lo, hi), t))
    -> Nat/Le(k, Bin/len(t)) =
    let on_k =
        match k : (k) => (w : Utf8(Scan/cont(k, lo, hi), t)) -> Nat/Le(k, Bin/len(t))
        | 0 => (w) => Nat/Le/z()
        | kp + 1, ih => (w) =>
            let on_w =
                match w : (w : Utf8(q, y)) => Nat/Le(Nat/succ(kp), Bin/len(y))
                | more(c, st, tt, rest) =>
                    let on_kp =
                        match kp : (kp) =>
                            (rest : Utf8(step(c, Scan/cont(Nat/succ(kp), lo, hi)), tt))
                                -> Nat/Le(Nat/succ(kp), Nat/succ(Bin/len(tt)))
                        | 0 => (rest) => Nat/Le/s(Nat/Le/z())
                        | kpp + 1, ih2 => (rest) =>
                            let on_range =
                                match Nat/in_range(c, lo, hi) : (r) =>
                                    (rest : Utf8(match r
                                        | false => Scan/bad()
                                        | true => Scan/cont(Nat/succ(kpp), 0x80, 0xBF)
                                        end, tt))
                                        -> Nat/Le(Nat/succ(kpp), Bin/len(tt))
                                | true => (rest) => cont_len(Nat/succ(kpp), @0x80, @0xBF, @tt, rest)
                                | false => (rest) =>
                                    Void/absurd(@Nat/Le(Nat/succ(kpp), Bin/len(tt)),
                                        bad_uninhabited(@tt, rest))
                                end;
                            Nat/Le/s(on_range(rest))
                        end;
                    on_kp(rest)
                end;
            on_w
        end;
    on_k(w);

pub rec cont0_uninhabited(@lo : Nat, @hi : Nat, @t : Bin, w : Utf8(Scan/cont(0, lo, hi), t)) -> Void =
    match w : (w : Utf8(q, y)) => Void
    | more(c, st, t2, rest) =>
        let on_range =
            match Nat/in_range(c, lo, hi) : (r) =>
                (rest : Utf8(match r
                    | false => Scan/bad()
                    | true => Scan/cont(0, 0x80, 0xBF)
                    end, t2))
                    -> Void
            | false => (rest) => bad_uninhabited(@t2, rest)
            | true => (rest) => cont0_uninhabited(@0x80, @0xBF, @t2, rest)
            end;
        on_range(rest)
    end;

pub rec take_conts(b : Bin, off : Nat, remaining : Nat, acc : Nat,
    bound : @Nat/Le(Nat/add(off, remaining), Bin/len(b))) -> {Nat, Nat} =
    let go =
        match remaining : (remaining) =>
            (bound : @Nat/Le(Nat/add(off, remaining), Bin/len(b))) -> {Nat, Nat}
        | 0 => (bound) => (acc, off)
        | pred + 1, ih => (bound) =>
            take_conts(b, Nat/succ(off), pred,
                Nat/add(Nat/mul(acc, 0x40), Nat/sub(Bin/at(b, off,
                    Nat/lt_of_le_succ(Nat/le_trans(Nat/Le/s(Nat/le_add_r(off, pred)), bound))), 0x80)),
                bound)
        end;
    go(bound);

induct Cursor(b : Bin) : (off : Nat)
| mk(prefix : @Bin, rest : @Bin, valid : @Utf8(Scan/lead(), rest),
     split : @Eq(b, Bin/concat(prefix, rest)))
   : (Bin/len(prefix))
end

pub rec drop_cont(@b : Bin, prefix1 : @Bin, k : Nat, @lo : Nat, @hi : Nat, @t : Bin,
    w : Utf8(Scan/cont(k, lo, hi), t), split1 : @Eq(b, Bin/concat(prefix1, t)))
    -> Cursor(b, Nat/add(Bin/len(prefix1), k)) =
    let on_k =
        match k : (k) =>
            (w : Utf8(Scan/cont(k, lo, hi), t)) -> Cursor(b, Nat/add(Bin/len(prefix1), k))
        | 0 => (w) =>
            Void/absurd(@Cursor(b, Nat/add(Bin/len(prefix1), 0)), cont0_uninhabited(w))
        | kp + 1, ih => (w) =>
            let on_w =
                match w : (w : Utf8(q, y)) => Cursor(b, Nat/add(Bin/len(prefix1), Nat/succ(kp)))
                | more(c, st, tt, rest) =>
                    let on_kp =
                        match kp : (kp) =>
                            (rest : Utf8(step(c, Scan/cont(Nat/succ(kp), lo, hi)), tt))
                                -> Cursor(b, Nat/add(Bin/len(prefix1), Nat/succ(kp)))
                        | 0 => (rest) =>
                            let on_range =
                                match Nat/in_range(c, lo, hi) : (r) =>
                                    (rest : Utf8(match r
                                        | false => Scan/bad()
                                        | true => Scan/lead()
                                        end, tt))
                                        -> Cursor(b, Nat/add(Bin/len(prefix1), 1))
                                | true => (rest) =>
                                    Cursor/mk(Bin/concat(prefix1, Bin/append(\\, c)), tt, rest, split1)
                                | false => (rest) =>
                                    Void/absurd(@Cursor(b, Nat/add(Bin/len(prefix1), 1)),
                                        bad_uninhabited(@tt, rest))
                                end;
                            on_range(rest)
                        | kpp + 1, ih2 => (rest) =>
                            let on_range =
                                match Nat/in_range(c, lo, hi) : (r) =>
                                    (rest : Utf8(match r
                                        | false => Scan/bad()
                                        | true => Scan/cont(Nat/succ(kpp), 0x80, 0xBF)
                                        end, tt))
                                        -> Cursor(b, Nat/add(Bin/len(prefix1), Nat/succ(Nat/succ(kpp))))
                                | true => (rest) =>
                                    drop_cont(@b, Bin/concat(prefix1, Bin/append(\\, c)),
                                        Nat/succ(kpp), @0x80, @0xBF, @tt, rest, split1)
                                | false => (rest) =>
                                    Void/absurd(@Cursor(b, Nat/add(Bin/len(prefix1), Nat/succ(Nat/succ(kpp)))),
                                        bad_uninhabited(@tt, rest))
                                end;
                            on_range(rest)
                        end;
                    on_kp(rest)
                end;
            on_w
        end;
    on_k(w);

pub rec slice_get_zero(b : Bin, off : Nat, ok : Nat/Lt(off, Bin/len(b)))
    -> Eq(Bin/get(Bin/slice(b, off, Bin/len(b)), 0), Bin/get(b, off)) =
    let on_b =
        match b : (b) =>
            (off : Nat, ok : Nat/Lt(off, Bin/len(b)))
                -> Eq(Bin/get(Bin/slice(b, off, Bin/len(b)), 0), Bin/get(b, off))
        | \\ => (off, ok) => Void/absurd(ok)
        | (h, t), ih => (off, ok) =>
            let on_off =
                match off : (off) =>
                    (ok : Nat/Lt(off, Bin/len(Bin/cons(h, t))))
                        -> Eq(Bin/get(Bin/slice(Bin/cons(h, t), off, Bin/len(Bin/cons(h, t))), 0),
                              Bin/get(Bin/cons(h, t), off))
                | 0 => (ok) => Eq/refl()
                | offp + 1, ih2 => (ok) => slice_get_zero(t, offp, ok)
                end;
            on_off(ok)
        end;
    on_b(off, ok);

pub rec at_concat_head(prefix : Bin, @c : Nat, @t : Bin,
    @ok : Nat/Lt(Bin/len(prefix), Bin/len(Bin/concat(prefix, Bin/cons(c, t)))))
    -> Eq(Bin/at(Bin/concat(prefix, Bin/cons(c, t)), Bin/len(prefix), ok), c) =
    match prefix : (prefix) =>
        Eq(Bin/at(Bin/concat(prefix, Bin/cons(c, t)), Bin/len(prefix),
            Nat/le_to_lt_succ(Nat/le_add_r(Bin/len(prefix), Bin/len(t)))), c)
    | \\ => Eq/refl()
    | (h, p), ih => ih
    end;

let lead_step(cl : Class) -> Scan =
    match cl
    | ascii() => Scan/lead()
    | lead(n, a, b, p) => Scan/cont(n, a, b)
    | bad() => Scan/bad()
    end;

pub let step_lead_lead(c : Nat, @k : Nat, @lo : Nat, @hi : Nat, @payload : Nat,
    eq : Eq(classify(c), Class/lead(k, lo, hi, payload)))
    -> Eq(step(c, Scan/lead()), Scan/cont(k, lo, hi)) =
    Eq/cong(lead_step, eq);

pub let step_lead_ascii(c : Nat, eq : Eq(classify(c), Class/ascii()))
    -> Eq(step(c, Scan/lead()), Scan/lead()) =
    Eq/cong(lead_step, eq);

pub let step_lead_bad(c : Nat, eq : Eq(classify(c), Class/bad()))
    -> Eq(step(c, Scan/lead()), Scan/bad()) =
    Eq/cong(lead_step, eq);

induct Step(b : Bin)
| mk(codepoint : Nat, next : Nat, cursor : @Cursor(b, next))
end

pub let head_eq(@b : Bin, prefix : Bin, @cw : Nat, @tt : Bin,
    lt : Nat/Lt(Bin/len(prefix), Bin/len(b)),
    split : Eq(b, Bin/concat(prefix, Bin/cons(cw, tt))))
    -> Eq(Bin/at(b, Bin/len(prefix), lt), cw) =
    Eq/subst(
        (x : Bin) => (lx : Nat/Lt(Bin/len(prefix), Bin/len(x))) -> Eq(Bin/at(x, Bin/len(prefix), lx), cw),
        Eq/sym(split),
        (lx) => at_concat_head(prefix, @cw, @tt, @lx))(lt);

pub let decode_step_c(b : Bin, off : Nat, cur : @Cursor(b, off),
    lt : @Nat/Lt(off, Bin/len(b))) -> Step(b) =
    let c = Bin/at(b, off, lt);
    let go =
        match classify(c) : (cl) => (eq : Eq(classify(c), cl)) -> Step(b)
        | ascii() => (eq) =>
            Step/mk(c, Nat/succ(off),
                (match cur : (cur : Cursor(b, o)) =>
                    (lt : Nat/Lt(o, Bin/len(b)),
                     eq : Eq(classify(Bin/at(b, o, lt)), Class/ascii())) -> Cursor(b, Nat/succ(o))
                | mk(prefix, rest, valid, split) => (lt, eq) =>
                    (match valid : (valid : Utf8(sc, r)) =>
                        (split : Eq(b, Bin/concat(prefix, r))) -> Cursor(b, Nat/succ(Bin/len(prefix)))
                    | stop() => (split) =>
                        Void/absurd(Eq/subst((x : Bin) => Nat/Lt(Bin/len(prefix), Bin/len(x)), split, lt))
                    | more(head, st, tt, rest_tail) => (split) =>
                        let he = head_eq(@b, prefix, @head, @tt, lt, split);
                        let ch = Eq/trans(Eq/sym(Eq/cong(classify, he)), eq);
                        let rv = Eq/subst((s : Scan) => Utf8(s, tt), step_lead_ascii(head, ch), rest_tail);
                        Cursor/mk(Bin/concat(prefix, Bin/append(\\, head)), tt, rv, split)
                    end)(split)
                end)(lt, eq))
        | lead(k, lo, hi, payload) => (eq) =>
            Step/mk(
                take_conts(b, Nat/succ(off), k, payload,
                    (match cur : (cur : Cursor(b, o)) =>
                        (lt : Nat/Lt(o, Bin/len(b)),
                         eq : Eq(classify(Bin/at(b, o, lt)), Class/lead(k, lo, hi, payload)))
                            -> Nat/Le(Nat/add(Nat/succ(o), k), Bin/len(b))
                    | mk(prefix, rest, valid, split) => (lt, eq) =>
                        (match valid : (valid : Utf8(sc, r)) =>
                            (split : Eq(b, Bin/concat(prefix, r)))
                                -> Nat/Le(Nat/add(Nat/succ(Bin/len(prefix)), k), Bin/len(b))
                        | stop() => (split) =>
                            Void/absurd(Eq/subst((x : Bin) => Nat/Lt(Bin/len(prefix), Bin/len(x)), split, lt))
                        | more(head, st, tt, rest_tail) => (split) =>
                            let he = head_eq(@b, prefix, @head, @tt, lt, split);
                            let ch = Eq/trans(Eq/sym(Eq/cong(classify, he)), eq);
                            let rc = Eq/subst((s : Scan) => Utf8(s, tt), step_lead_lead(head, ch), rest_tail);
                            Eq/subst((x : Bin) => Nat/Le(Nat/add(Nat/succ(Bin/len(prefix)), k), Bin/len(x)),
                                Eq/sym(split),
                                Nat/Le/s(Nat/le_add_mono_l(Bin/len(prefix), cont_len(k, @lo, @hi, @tt, rc))))
                        end)(split)
                    end)(lt, eq)).0,
                Nat/add(Nat/succ(off), k),
                (match cur : (cur : Cursor(b, o)) =>
                    (lt : Nat/Lt(o, Bin/len(b)),
                     eq : Eq(classify(Bin/at(b, o, lt)), Class/lead(k, lo, hi, payload)))
                        -> Cursor(b, Nat/add(Nat/succ(o), k))
                | mk(prefix, rest, valid, split) => (lt, eq) =>
                    (match valid : (valid : Utf8(sc, r)) =>
                        (split : Eq(b, Bin/concat(prefix, r))) -> Cursor(b, Nat/add(Nat/succ(Bin/len(prefix)), k))
                    | stop() => (split) =>
                        Void/absurd(Eq/subst((x : Bin) => Nat/Lt(Bin/len(prefix), Bin/len(x)), split, lt))
                    | more(head, st, tt, rest_tail) => (split) =>
                        let he = head_eq(@b, prefix, @head, @tt, lt, split);
                        let ch = Eq/trans(Eq/sym(Eq/cong(classify, he)), eq);
                        let rc = Eq/subst((s : Scan) => Utf8(s, tt), step_lead_lead(head, ch), rest_tail);
                        drop_cont(@b, Bin/concat(prefix, Bin/append(\\, head)), k, @lo, @hi, @tt, rc, split)
                    end)(split)
                end)(lt, eq))
        | bad() => (eq) =>
            Void/absurd(@Step(b),
                (match cur : (cur : Cursor(b, o)) =>
                    (lt : Nat/Lt(o, Bin/len(b)),
                     eq : Eq(classify(Bin/at(b, o, lt)), Class/bad())) -> Void
                | mk(prefix, rest, valid, split) => (lt, eq) =>
                    (match valid : (valid : Utf8(sc, r)) =>
                        (split : Eq(b, Bin/concat(prefix, r))) -> Void
                    | stop() => (split) =>
                        Void/absurd(Eq/subst((x : Bin) => Nat/Lt(Bin/len(prefix), Bin/len(x)), split, lt))
                    | more(head, st, tt, rest_tail) => (split) =>
                        let he = head_eq(@b, prefix, @head, @tt, lt, split);
                        let ch = Eq/trans(Eq/sym(Eq/cong(classify, he)), eq);
                        let rbad = Eq/subst((s : Scan) => Utf8(s, tt), step_lead_bad(head, ch), rest_tail);
                        bad_uninhabited(@tt, rbad)
                    end)(split)
                end)(lt, eq))
        end;
    go(Eq/refl());

pub let fold(@A : Type, s : Str, init : A, f : (Nat, A) -> A) -> A =
    let b = to_bin(s);
    rec go(off : Nat, cur : @Cursor(b, off), acc : A) -> A =
        match Nat/try_lt(off, Bin/len(b)) : A
        | none() => acc
        | some(lt) =>
            match decode_step_c(b, off, cur, lt) : A
            | mk(codepoint, next, cursor) => go(next, cursor, f(codepoint, acc))
            end
        end;
    go(0, Cursor/mk(\\, b, s.valid, Eq/refl()), init);

pub let len(s : Str) -> Nat =
    fold(s, 0, (codepoint, acc) => Nat/add(acc, 1));

pub let find_index(s : Str, pred : (Nat) -> Bln) -> Option(Nat) =
    let r : {Nat, Option(Nat)} =
        fold(s, (0, Option/none()), (codepoint, acc) =>
            match acc.1
            | some(_) => acc
            | none() =>
                match pred(codepoint)
                | true => (Nat/add(acc.0, 1), Option/some(acc.0))
                | false => (Nat/add(acc.0, 1), Option/none())
                end
            end);
    r.1;

pub let find(s : Str, target : Nat) -> Option(Nat) =
    find_index(s, (codepoint) => Nat/eql(codepoint, target));

pub let get(s : Str, i : Nat) -> Option(Nat) =
    let r : {Nat, Option(Nat)} =
        fold(s, (0, Option/none()), (codepoint, acc) =>
            match acc.1
            | some(_) => acc
            | none() =>
                match Nat/eql(acc.0, i)
                | true => (Nat/add(acc.0, 1), Option/some(codepoint))
                | false => (Nat/add(acc.0, 1), Option/none())
                end
            end);
    r.1;

pub let at(s : Str, i : Nat, ok : @Nat/Lt(i, len(s))) -> Nat =
    Option/unwrap_or(get(s, i), 0);

pub let join(sep : Str, parts : Lst(Str)) -> Str =
    let pa = Lst/to_arr(parts);
    Arr/balanced(Arr/len(pa), "", (i) => Option/unwrap_or(Arr/get(pa, i), ""),
        (l, r) => concat(concat(l, sep), r));

let trim_bounds(s : Str) -> {Nat, Nat} =
    let n = len(s);
    let r : {Nat, Nat, Nat} =
        fold(s, (0, n, 0), (codepoint, acc) =>
            match Char/is_whitespace(codepoint)
            | true => (Nat/add(acc.0, 1), acc.1, acc.2)
            | false =>
                let start =
                    match Nat/lt(acc.1, n)
                    | true => acc.1
                    | false => acc.0
                    end;
                (Nat/add(acc.0, 1), start, Nat/add(acc.0, 1))
            end);
    (r.1, r.2);

pub let trim(s : Str) -> Str =
    let b = trim_bounds(s);
    match Nat/lt(b.0, b.1)
    | false => ""
    | true => slice(s, b.0, b.1)
    end;
