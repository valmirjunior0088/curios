pub use /sys/{Str};
pub use /sys/Str/{let to_bin};
use /std/{Char, Nat, Bin, Bln, Arr, Option};

let in_range(c : Nat, lo : Nat, hi : Nat) -> Bln =
    match Nat/gte(c, lo)
    | true => Nat/lte(c, hi)
    | false => false
    end;

union Scan
| lead()
| cont(Nat, Nat, Nat)
| bad()
end

let classify(c : Nat) -> Scan =
    match in_range(c, 0, 127)
    | true => Scan/lead()
    | false =>
        match in_range(c, 194, 223)
        | true => Scan/cont(1, 128, 191)
        | false =>
            match in_range(c, 224, 239)
            | true =>
                let lo = match Nat/eql(c, 224) | true => 160 | false => 128 end;
                let hi = match Nat/eql(c, 237) | true => 159 | false => 191 end;
                Scan/cont(2, lo, hi)
            | false =>
                match in_range(c, 240, 244)
                | true =>
                    let lo = match Nat/eql(c, 240) | true => 144 | false => 128 end;
                    let hi = match Nat/eql(c, 244) | true => 143 | false => 191 end;
                    Scan/cont(3, lo, hi)
                | false => Scan/bad()
                end
            end
        end
    end;

let step(c : Nat, s : Scan) -> Scan =
    match s
    | bad() => Scan/bad()
    | cont(rem, lo, hi) =>
        match in_range(c, lo, hi)
        | false => Scan/bad()
        | true =>
            match Nat/eql(rem, 1)
            | true => Scan/lead()
            | false => Scan/cont(Nat/sub(rem, 1), 128, 191)
            end
        end
    | lead() => classify(c)
    end;

pub let is_utf8(b : Bin) -> Bln =
    match Bin/fold(b, Scan/lead(), step)
    | lead() => true
    | cont(rem, lo, hi) => false
    | bad() => false
    end;

pub let eql(a : Str, b : Str) -> Bln =
    Bin/eql(to_bin(a), to_bin(b));

pub let concat(a : Str, b : Str) -> Str =
    /sys/Str/of_bin(Bin/concat(to_bin(a), to_bin(b)));

let codepoint_width(lead : Nat) -> Nat =
    match Nat/lt(lead, 128)
    | true => 1
    | false =>
        match Nat/lt(lead, 224)
        | true => 2
        | false =>
            match Nat/lt(lead, 240)
            | true => 3
            | false => 4
            end
        end
    end;

let decode_at(b : Bin, off : Nat) -> Nat =
    let lead = Bin/get(b, off);
    match Nat/lt(lead, 128)
    | true => lead
    | false =>
        match Nat/lt(lead, 224)
        | true =>
            Nat/add(
                Nat/mul(Nat/sub(lead, 192), 64),
                Nat/sub(Bin/get(b, Nat/add(off, 1)), 128))
        | false =>
            match Nat/lt(lead, 240)
            | true =>
                Nat/add(
                    Nat/add(
                        Nat/mul(Nat/sub(lead, 224), 4096),
                        Nat/mul(Nat/sub(Bin/get(b, Nat/add(off, 1)), 128), 64)),
                    Nat/sub(Bin/get(b, Nat/add(off, 2)), 128))
            | false =>
                Nat/add(
                    Nat/add(
                        Nat/add(
                            Nat/mul(Nat/sub(lead, 240), 262144),
                            Nat/mul(Nat/sub(Bin/get(b, Nat/add(off, 1)), 128), 4096)),
                        Nat/mul(Nat/sub(Bin/get(b, Nat/add(off, 2)), 128), 64)),
                    Nat/sub(Bin/get(b, Nat/add(off, 3)), 128))
            end
        end
    end;

let byte_offset(b : Bin, i : Nat) -> Nat =
    match i : Nat
    | 0 => 0
    | pred + 1, ih => Nat/add(ih, codepoint_width(Bin/get(b, ih)))
    end;

pub let fold(@A : Type, s : Str, init : A, f : (Nat, A) -> A) -> A =
    let b = to_bin(s);
    rec go(off : Nat, acc : A) -> A =
        match Nat/lt(off, Bin/len(b))
        | false => acc
        | true => go(Nat/add(off, codepoint_width(Bin/get(b, off))), f(decode_at(b, off), acc))
        end;
    go(0, init);

pub let len(s : Str) -> Nat =
    fold(s, 0, (cp, acc) => Nat/add(acc, 1));

pub let get(s : Str, i : Nat) -> Nat =
    let b = to_bin(s);
    decode_at(b, byte_offset(b, i));

pub let slice(s : Str, start : Nat, stop : Nat) -> Str =
    let b = to_bin(s);
    /sys/Str/of_bin(Bin/slice(b, byte_offset(b, start), byte_offset(b, stop)));

pub let of_bin(b : Bin) -> Option(Str) =
    match is_utf8(b)
    | true => Option/some(/sys/Str/of_bin(b))
    | false => Option/none()
    end;

pub let concat_all(parts : Arr(Str)) -> Str =
    Arr/balanced(Arr/len(parts), "", (i) => Arr/get(parts, i), concat);

pub let join(sep : Str, parts : Arr(Str)) -> Str =
    Arr/balanced(Arr/len(parts), "", (i) => Arr/get(parts, i),
        (l, r) => concat(concat(l, sep), r));

let trim_bounds(s : Str) -> { Nat, Nat } =
    let n = len(s);
    let init : { Nat, Nat, Nat } = (0, n, 0);
    let r =
        fold(s, init, (cp, acc) =>
            match Char/is_whitespace(cp) : { Nat, Nat, Nat }
            | true => (Nat/add(acc.0, 1), acc.1, acc.2)
            | false =>
                let start =
                    match Nat/lt(acc.1, n)
                    | true => acc.1
                    | false => acc.0
                    end;
                (Nat/add(acc.0, 1), start, Nat/add(acc.0, 1))
            end);
    (r.1, r.2);

pub let trim(s : Str) -> Str =
    let b = trim_bounds(s);
    match Nat/lt(b.0, b.1)
    | false => ""
    | true => slice(s, b.0, b.1)
    end;
