use /std/{Bin, Str, Bln, Char, Flt, Nat, Parse, Result, Option, Lst};

pub union Json
| null()
| bln(Bln)
| num(Flt)
| str(Str)
| arr(Lst(Json))
| obj(Lst({Str, Json}))
end

pub use Json/*;

let encode_num(n : Flt) -> Str =
    let raw = Flt/to_str(n);
    match Nat/eql(Str/get(raw, 0), '+')
    | true => Str/slice(raw, 1, Str/len(raw))
    | false => raw
    end;

let hex_char(nibble : Nat) -> Nat =
    match Nat/lt(nibble, 10)
    | true => Nat/add(nibble, '0')
    | false => Nat/add(Nat/sub(nibble, 10), 'a')
    end;

let escape_byte(byte : Nat) -> Bin =
    match byte
    | '"' => Str/to_bin("\\\"")
    | '\\' => Str/to_bin("\\\\")
    | '\n' => Str/to_bin("\\n")
    | '\r' => Str/to_bin("\\r")
    | '\t' => Str/to_bin("\\t")
    | 0x08 => Str/to_bin("\\b")
    | 0x0C => Str/to_bin("\\f")
    | _ =>
        match Nat/lt(byte, 0x20)
        | true =>
            Bin/append(
                Bin/append(Str/to_bin("\\u00"), hex_char(Nat/div(byte, 0x10))),
                hex_char(Nat/rem(byte, 0x10)))
        | false => Bin/append(\\, byte)
        end
    end;

let encode_str(s : Str) -> Str =
    let body =
        Bin/flatten(Lst/to_arr(Lst/rev(
            Bin/fold(Str/to_bin(s), Lst/nil(@Bin), (byte, acc) =>
                Lst/cons(escape_byte(byte), acc)))));
    Str/concat(Str/concat("\"", Option/unwrap_or(Str/of_bin(body), "")), "\"");

pub rec encode(v : Json) -> Str =
    match v
    | null() => "null"
    | bln(b) => Bln/to_str(b)
    | num(n) => encode_num(n)
    | str(s) => encode_str(s)
    | arr(xs) =>
        Str/concat(Str/concat("[",
            Str/join(",", Lst/map(encode, xs))), "]")
    | obj(ps) =>
        Str/concat(Str/concat("{",
            Str/join(",", Lst/map(
                (pair) => Str/concat(Str/concat(encode_str(pair.0), ":"), encode(pair.1)),
                ps))),
            "}")
    end;

let is_num_byte(byte : Nat) -> Bln =
    match Char/is_digit(byte)
    | true => true
    | false =>
        match byte
        | '-' => true
        | '+' => true
        | '.' => true
        | 'e' => true
        | 'E' => true
        | _ => false
        end
    end;

let take_literal(literal : Str) -> Parse({}) =
    (input, pos) =>
        let lit = Str/to_bin(literal);
        let r =
            match Bin/len(lit) : {Nat, Bln}
            | 0 => (pos, true)
            | step + 1, ih =>
                match ih.1
                | false => ih
                | true =>
                    match Nat/lt(ih.0, Bin/len(input))
                    | false => (ih.0, false)
                    | true =>
                        match Nat/eql(Bin/get(lit, step), Bin/get(input, ih.0))
                        | true => (Nat/add(ih.0, 1), true)
                        | false => (ih.0, false)
                        end
                    end
                end
            end;
        match r.1
        | true => Result/success((r.0, ()))
        | false => Result/failure("unexpected literal")
        end;

let parse_null : Parse(Json) =
    Parse/map((_) => Json/null(), take_literal("null"));

let parse_true_val : Parse(Json) =
    Parse/map((_) => Json/bln(true), take_literal("true"));

let parse_false_val : Parse(Json) =
    Parse/map((_) => Json/bln(false), take_literal("false"));

let parse_num : Parse(Json) =
    (input, pos) =>
        match Parse/take_while(is_num_byte)(input, pos)
        | success(pair) =>
            match Flt/of_str(Option/unwrap_or(Str/of_bin(pair.1), ""))
            | some(value) => Result/success((pair.0, Json/num(value)))
            | none() => Result/failure("expected number")
            end
        | failure(msg) => Result/failure(msg)
        end;

let is_not_string_special(byte : Nat) -> Bln =
    match byte
    | '"' => false
    | '\\' => false
    | _ => true
    end;

let between(c : Nat, lo : Nat, hi : Nat) -> Bln =
    match Nat/lte(lo, c)
    | true => Nat/lte(c, hi)
    | false => false
    end;

let hex_val(byte : Nat) -> Option(Nat) =
    match Char/is_digit(byte)
    | true => Option/some(Nat/sub(byte, '0'))
    | false =>
        match between(byte, 'a', 'f')
        | true => Option/some(Nat/add(Nat/sub(byte, 'a'), 10))
        | false =>
            match between(byte, 'A', 'F')
            | true => Option/some(Nat/add(Nat/sub(byte, 'A'), 10))
            | false => Option/none()
            end
        end
    end;

let hex_digit : Parse(Nat) =
    let ! = Parse/bind;
    let byte = Parse/any_byte!;
    match hex_val(byte) : Parse(Nat)
    | some(v) => Parse/pure(v)
    | none() => Parse/fail("invalid hex digit")
    end;

let hex4 : Parse(Nat) =
    let ! = Parse/bind;
    let a = hex_digit!;
    let b = hex_digit!;
    let c = hex_digit!;
    let d = hex_digit!;
    Parse/pure(
        Nat/add(
            Nat/add(Nat/add(Nat/mul(a, 0x1000), Nat/mul(b, 0x100)), Nat/mul(c, 0x10)),
            d));

let utf8_encode(cp : Nat) -> Bin =
    match Nat/lt(cp, 0x80)
    | true => Bin/append(\\, cp)
    | false =>
        match Nat/lt(cp, 0x800)
        | true =>
            Bin/append(
                Bin/append(\\, Nat/add(0xC0, Nat/div(cp, 0x40))),
                Nat/add(0x80, Nat/rem(cp, 0x40)))
        | false =>
            match Nat/lt(cp, 0x10000)
            | true =>
                Bin/append(
                    Bin/append(
                        Bin/append(\\, Nat/add(0xE0, Nat/div(cp, 0x1000))),
                        Nat/add(0x80, Nat/rem(Nat/div(cp, 0x40), 0x40))),
                    Nat/add(0x80, Nat/rem(cp, 0x40)))
            | false =>
                Bin/append(
                    Bin/append(
                        Bin/append(
                            Bin/append(\\, Nat/add(0xF0, Nat/div(cp, 0x40000))),
                            Nat/add(0x80, Nat/rem(Nat/div(cp, 0x1000), 0x40))),
                        Nat/add(0x80, Nat/rem(Nat/div(cp, 0x40), 0x40))),
                    Nat/add(0x80, Nat/rem(cp, 0x40)))
            end
        end
    end;

let parse_unicode : Parse(Bin) =
    let ! = Parse/bind;
    let hi = hex4!;
    match Bln/and(Nat/gte(hi, 0xD800), Nat/lte(hi, 0xDBFF)) : Parse(Bin)
    | true =>
        let _ = Parse/take_byte('\\')!;
        let _ = Parse/take_byte('u')!;
        let lo = hex4!;
        Parse/pure(utf8_encode(
            Nat/add(
                0x10000,
                Nat/add(Nat/mul(Nat/sub(hi, 0xD800), 0x400), Nat/sub(lo, 0xDC00)))))
    | false => Parse/pure(utf8_encode(hi))
    end;

let parse_str_escape : Parse(Bin) =
    let ! = Parse/bind;
    let _ = Parse/take_byte('\\')!;
    let byte = Parse/any_byte!;
    match byte : Parse(Bin)
    | '"' => Parse/pure(Str/to_bin("\""))
    | '\\' => Parse/pure(Str/to_bin("\\"))
    | '/' => Parse/pure(Str/to_bin("/"))
    | 'b' => Parse/pure(Bin/append(\\, 8))
    | 'f' => Parse/pure(Bin/append(\\, 12))
    | 'n' => Parse/pure(Str/to_bin("\n"))
    | 'r' => Parse/pure(Str/to_bin("\r"))
    | 't' => Parse/pure(Str/to_bin("\t"))
    | 'u' => parse_unicode
    | _ => Parse/fail("unknown escape")
    end;

let parse_str_segment : Parse(Bin) =
    Parse/take_while(is_not_string_special);

let parse_str_body : Parse(Lst(Bin)) =
    Parse/many0(Parse/or(parse_str_escape, parse_str_segment));

let parse_raw_str : Parse(Str) =
    let ! = Parse/bind;
    let _ = Parse/take_byte('"')!;
    let chunks = parse_str_body!;
    let _ = Parse/take_byte('"')!;
    match Str/of_bin(Bin/flatten(Lst/to_arr(chunks))) : Parse(Str)
    | some(s) => Parse/pure(s)
    | none() => Parse/fail("invalid UTF-8 in string")
    end;

let parse_str_value : Parse(Json) =
    Parse/map((s) => Json/str(s), parse_raw_str);

let ws : Parse({}) =
    Parse/map((_) => (), Parse/take_while(Char/is_whitespace));

let symbol(b : Nat) -> Parse(Nat) =
    let ! = Parse/bind;
    let _ = ws!;
    Parse/take_byte(b);

pub rec decode : Parse(Json) = (input, pos) =>
    match Nat/lt(pos, Bin/len(input))
    | false => Result/failure("unexpected end of input")
    | true =>
        match Bin/get(input, pos)
        | ' ' => decode(input, Nat/add(pos, 1))
        | '\t' => decode(input, Nat/add(pos, 1))
        | '\n' => decode(input, Nat/add(pos, 1))
        | '\r' => decode(input, Nat/add(pos, 1))
        | 'n' => parse_null(input, pos)
        | 't' => parse_true_val(input, pos)
        | 'f' => parse_false_val(input, pos)
        | '"' => parse_str_value(input, pos)
        | '[' => parse_arr(input, pos)
        | '{' => parse_obj(input, pos)
        | _ => parse_num(input, pos)
        end
    end
and parse_arr : Parse(Json) =
    let ! = Parse/bind;
    let _ = symbol('[')!;
    let elems = Parse/sep_by0(decode, symbol(','))!;
    let _ = symbol(']')!;
    Parse/pure(Json/arr(elems))
and parse_obj : Parse(Json) =
    let ! = Parse/bind;
    let _ = symbol('{')!;
    let pairs = Parse/sep_by0(parse_pair, symbol(','))!;
    let _ = symbol('}')!;
    Parse/pure(Json/obj(pairs))
and parse_pair : Parse({Str, Json}) =
    let ! = Parse/bind;
    let _ = ws!;
    let key = parse_raw_str!;
    let _ = symbol(':')!;
    let val = decode!;
    Parse/pure((key, val));
