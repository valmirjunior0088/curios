use /std/{Bin, Str, Nat, Parse, Io, Bln, Result};

pub union Fmt
| nil()
| lit(Str, Fmt)
| str(Fmt)
| nat(Fmt)
end

pub rec format_type_with(T: Type, f: Fmt) -> Type =
    match f
    | nil() => T
    | lit(_, rest) => format_type_with(T, rest)
    | str(rest) => (Str) -> format_type_with(T, rest)
    | nat(rest) => (Nat) -> format_type_with(T, rest)
    end;

let is_not_pct(byte : Nat) -> Bln =
    match byte
    | '%' => false
    | _ => true
    end;

rec parse_fmt : Parse(Fmt) = (input, pos) =>
    match Nat/try_lt(pos, Bin/len(input))
    | none() => Result/success((pos, Fmt/nil()))
    | some(ok) =>
        match Nat/eql(Bin/at(input, pos, ok), '%')
        | false => parse_lit(input, pos)
        | true => parse_spec(input, pos)
        end
    end
and parse_spec : Parse(Fmt) =
    Parse/or(
        let ! = Parse/bind;
        let _ = Parse/take_byte('%')!;
        let byte = Parse/any_byte!;
        let rest = parse_fmt!;
        match byte : Parse(Fmt)
        | 's' => Parse/pure(Fmt/str(rest))
        | 'd' => Parse/pure(Fmt/nat(rest))
        | _ => Parse/pure(rest)
        end,
        Parse/map((_) => Fmt/lit("%", Fmt/nil()), Parse/take_byte('%')))
and parse_lit : Parse(Fmt) =
    let ! = Parse/bind;
    let bytes = Parse/take_while(is_not_pct)!;
    let rest = parse_fmt!;
    match Str/of_bin(bytes) : Parse(Fmt)
    | some(piece) => Parse/pure(Fmt/lit(piece, rest))
    | none() => Parse/fail("invalid UTF-8 in format string")
    end;

pub let parse(s : Str) -> Fmt =
    match Parse/run(parse_fmt, Str/to_bin(s))
    | success(value) => value
    | failure(_) => Fmt/nil()
    end;

rec go_with(T : Type, finish : (Str) -> T, f : Fmt, acc : Str) -> format_type_with(T, f) =
    match f : (f) => format_type_with(T, f)
    | nil() => finish(acc)
    | lit(piece, rest) => go_with(T, finish, rest, Str/concat(acc, piece))
    | str(rest) => (s) => go_with(T, finish, rest, Str/concat(acc, s))
    | nat(rest) => (n) => go_with(T, finish, rest, Str/concat(acc, Nat/to_str(n)))
    end;

pub let format(s : Str) -> format_type_with(Str, parse(s)) =
    go_with(Str, (x) => x, parse(s), "");

pub let printf(s : Str) -> format_type_with({}, parse(s)) =
    go_with({}, (x) => Io/print(x), parse(s), "");
