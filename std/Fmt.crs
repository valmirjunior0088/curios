use /std/{Bin, Nat, Parse, Io, Bln, Result};

pub union Fmt
| nil()
| lit(Bin, Fmt)
| str(Fmt)
| nat(Fmt)
end

pub rec format_type_with(T: Type, f: Fmt) -> Type =
    match f
    | nil() => T
    | lit(_, rest) => format_type_with(T, rest)
    | str(rest) => Bin -> format_type_with(T, rest)
    | nat(rest) => Nat -> format_type_with(T, rest)
    end;

let is_not_pct(byte : Nat) -> Bln =
    match byte
    | '%' => false
    | _ => true
    end;

rec parse_fmt : Parse(Fmt) = (input, pos) =>
    match Nat/lt(pos, Bin/len(input))
    | false => Result/success((pos, Fmt/nil()))
    | true =>
        match Nat/eql(Bin/get(input, pos), '%')
        | false => parse_lit(input, pos)
        | true => parse_spec(input, pos)
        end
    end
and parse_spec : Parse(Fmt) =
    Parse/or(
        with Parse/bind
            let _ = Parse/take_byte('%')!;
            let byte = Parse/any_byte!;
            let rest = parse_fmt!;
            match byte : Parse(Fmt)
            | 's' => Parse/pure(Fmt/str(rest))
            | 'd' => Parse/pure(Fmt/nat(rest))
            | _ => Parse/pure(rest)
            end,
        Parse/map((_) => Fmt/lit("%", Fmt/nil()), Parse/take_byte('%')))
and parse_lit : Parse(Fmt) =
    with Parse/bind
        let bytes = Parse/take_while(is_not_pct)!;
        let rest = parse_fmt!;
        Parse/pure(Fmt/lit(bytes, rest));

pub let parse(input : Bin) -> Fmt =
    match Parse/run(parse_fmt, input)
    | success(value) => value
    | failure(_) => Fmt/nil()
    end;

rec go_with(T : Type, finish : Bin -> T, f : Fmt, acc : Bin) -> format_type_with(T, f) =
    match f : (f) => format_type_with(T, f)
    | nil() => finish(acc)
    | lit(bytes, rest) => go_with(T, finish, rest, Bin/concat(acc, bytes))
    | str(rest) => (s) => go_with(T, finish, rest, Bin/concat(acc, s))
    | nat(rest) => (n) => go_with(T, finish, rest, Bin/concat(acc, Nat/to_str(n)))
    end;

pub let format(s : Bin) -> format_type_with(Bin, parse(s)) =
    go_with(Bin, (x) => x, parse(s), "");

pub let printf(s : Bin) -> format_type_with({}, parse(s)) =
    go_with({}, (x) => Io/print(x), parse(s), "");
