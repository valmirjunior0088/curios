pub use /sys/{Nat};
pub use /sys/Nat/*;
use /std/{Str, Option, Char, Bin, Bln, Eq, Order, True, False};
use /syn/Str/{Scan, Utf8, let step, let Valid};

let single(c : Nat, ok : Eq(step(c, Scan/lead()), Scan/lead()))
    -> Valid(Bin/append(\\, c)) =
    let r : Utf8(step(c, Scan/lead()), \\) =
        Eq/subst((sc) => Utf8(sc, \\), Eq/sym(ok), Utf8/stop());
    Utf8/more(c, Scan/lead(), \\, r);

let digit(d : Nat) -> { c : Nat, ok : Eq(step(c, Scan/lead()), Scan/lead()) } =
    match Nat/eql(d, 0) | true => ('0', Eq/refl()) | false =>
    match Nat/eql(d, 1) | true => ('1', Eq/refl()) | false =>
    match Nat/eql(d, 2) | true => ('2', Eq/refl()) | false =>
    match Nat/eql(d, 3) | true => ('3', Eq/refl()) | false =>
    match Nat/eql(d, 4) | true => ('4', Eq/refl()) | false =>
    match Nat/eql(d, 5) | true => ('5', Eq/refl()) | false =>
    match Nat/eql(d, 6) | true => ('6', Eq/refl()) | false =>
    match Nat/eql(d, 7) | true => ('7', Eq/refl()) | false =>
    match Nat/eql(d, 8) | true => ('8', Eq/refl()) | false =>
    match Nat/eql(d, 9) | true => ('9', Eq/refl()) | false =>
    ('0', Eq/refl())
    end end end end end end end end end end;

let single_digit(d : Nat) -> Str =
    let g = digit(d);
    Str { bytes = Bin/append(\\, g.c), valid = single(g.c, g.ok) };

pub rec to_str(n : Nat) -> Str =
    match Nat/lt(n, 10)
    | true => single_digit(n)
    | false => Str/concat(to_str(Nat/div(n, 10)), single_digit(Nat/rem(n, 10)))
    end;

pub let of_str(s : Str) -> Option(Nat) =
    match Nat/eql(Str/len(s), 0)
    | true => Option/none()
    | false =>
        Str/fold(s, Option/some(0), (cp, acc) =>
            let ! = Option/bind;
            let n = acc!;
            match Char/is_digit(cp)
            | true => Option/some(Nat/add(Nat/mul(n, 10), Nat/sub(cp, '0')))
            | false => Option/none()
            end)
    end;

pub let pred(a : Nat) -> Nat =
    sub(a, 1);

pub let min(a : Nat, b : Nat) -> Nat =
    match lt(a, b)
    | true => a
    | false => b
    end;

pub let max(a : Nat, b : Nat) -> Nat =
    match lt(a, b)
    | true => b
    | false => a
    end;

pub let in_range(c : Nat, lo : Nat, hi : Nat) -> Bln =
    match gte(c, lo)
    | true => lte(c, hi)
    | false => false
    end;

pub let Lte(a : Nat, b : Nat) -> Prop =
    match lte(a, b) : Prop
    | true => True
    | false => False
    end;

pub let Lt(a : Nat, b : Nat) -> Prop =
    match lt(a, b) : Prop
    | true => True
    | false => False
    end;

pub let try_lt(a : Nat, b : Nat) -> Option(Lt(a, b)) =
    match lt(a, b) : (r) => Option(match r : Prop | true => True | false => False end)
    | true => Option/some(True/qed())
    | false => Option/none()
    end;

pub let lt_succ(@n : Nat) -> Lt(n, succ(n)) =
    True/qed();

pub induct Le : (a : Nat, b : Nat) -> Prop
| z(@n : Nat) : (0, n)
| s(@a : Nat, @b : Nat, prev : Le(a, b)) : (succ(a), succ(b))
end

pub rec le_refl(n : Nat) -> Le(n, n) =
    match n : (m) => Le(m, m)
    | 0 => Le/z()
    | pred + 1, ih => Le/s(ih)
    end;

pub rec le_succ_r(@a : Nat, @b : Nat, p : Le(a, b)) -> Le(a, succ(b)) =
    match p : (w : Le(x, y)) => Le(x, succ(y))
    | z(_) => Le/z()
    | s(_, _, prev) => Le/s(le_succ_r(prev))
    end;

pub rec le_add_r(a : Nat, k : Nat) -> Le(a, add(a, k)) =
    match k : (m) => Le(a, add(a, m))
    | 0 => le_refl(a)
    | pred + 1, ih => le_succ_r(ih)
    end;

pub rec le_to_lt_succ(@a : Nat, @b : Nat, p : Le(a, b)) -> Lt(a, succ(b)) =
    match p : (w : Le(x, y)) => Lt(x, succ(y))
    | z(_) => True/qed()
    | s(_, _, prev) => le_to_lt_succ(prev)
    end;

pub rec le_trans(@a : Nat, @b : Nat, @c : Nat, p : Le(a, b), q : Le(b, c)) -> Le(a, c) =
    let go =
        match p : (w : Le(x, y)) => (q : Le(y, c)) -> Le(x, c)
        | z(_) => (q) => Le/z()
        | s(a2, b2, prev) => (q) =>
            match q : (w : Le(u, v)) => Le(succ(a2), v)
            | s(b3, c3, q2) => Le/s(le_trans(prev, q2))
            end
        end;
    go(q);

pub let lt_of_le_succ(@a : Nat, @b : Nat, p : Le(succ(a), b)) -> Lt(a, b) =
    match p : (w : Le(x, y)) => Lt(pred(x), y)
    | s(a2, b2, prev) => le_to_lt_succ(prev)
    end;

pub rec le_add_mono_l(n : Nat, @a : Nat, @b : Nat, p : Le(a, b)) -> Le(add(n, a), add(n, b)) =
    match n : (m) => Le(add(m, a), add(m, b))
    | 0 => p
    | m + 1, ih => Le/s(ih)
    end;

pub let compare(x : Nat, y : Nat) -> Order =
    match lt(x, y)
    | true => Order/lt()
    | false =>
        match eql(x, y)
        | true => Order/eq()
        | false => Order/gt()
        end
    end;
