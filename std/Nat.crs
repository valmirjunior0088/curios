pub use /sys/{Nat};
pub use /sys/Nat/*;
use /std/{Str, Option, Char};

pub let to_str(n : Nat) -> Str =
    Str/of_nat(n);

pub let of_str(s : Str) -> Option(Nat) =
    match Nat/eql(Str/len(s), 0)
    | true => Option/none()
    | false =>
        Str/fold(s, Option/some(0), (cp, acc) =>
            let ! = Option/bind;
            let n = acc!;
            match Char/is_digit(cp)
            | true => Option/some(Nat/add(Nat/mul(n, 10), Nat/sub(cp, 48)))
            | false => Option/none()
            end)
    end;

pub let min(a : Nat, b : Nat) -> Nat =
    match lt(a, b)
    | true => a
    | false => b
    end;

pub let max(a : Nat, b : Nat) -> Nat =
    match lt(a, b)
    | true => b
    | false => a
    end;
