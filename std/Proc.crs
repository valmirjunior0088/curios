use /sys/{Io};
use /std/{Arr, Bin, Nat, Str, Option, False};

pub let args : Arr(Bin) =
    Io/args;

pub let env(name : Str) -> Option(Bin) =
    let r = Io/env(Str/to_bin(name));
    match r.status == /sys/Io/Status/ok
    | true => Option/some(r.value)
    | false => Option/none()
    end;

pub let exit(code : Nat) -> False =
    Io/exit(code);
