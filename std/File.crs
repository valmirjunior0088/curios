use /std/{Bin, Nat, Str, Io, Result, Task};

pub union Mode
| read()
| write()
| append()
end

pub struct File { Io }

let token(mode : Mode) -> Nat =
    match mode : Nat
    | read() => 0
    | write() => 1
    | append() => 2
    end;

pub let read(f : File, n : Nat) -> Task(Io/Read) =
    Task/read(f.0, n);

pub let write(f : File, b : Bin) -> Task(Result({}, Io/Error)) =
    Task/write(f.0, b);

let close(f : File) -> {} =
    /sys/Io/close(f.0);

-- Open `path`, configuring the handle non-blocking before it is ever read or
-- written, and wrapping it in the opaque `File`. The raw open status decodes to
-- a typed `Io/Error` on failure.
pub let open(path : Str, mode : Mode) -> Task(Result(File, Io/Error)) =
    let r = /sys/Io/open(Str/to_bin(path), token(mode));
    match Nat/eql(r.status, 0) : Task(Result(File, Io/Error))
    | true =>
        let nb = Task/nonblocking(r.handle);
        Task/done(Result/success(File { r.handle }))
    | false => Task/done(Result/failure(Io/decode(r.status)))
    end;

-- Open `path`, hand the `File` to `body`, and close it when `body`'s task
-- finishes -- or if the fiber is dropped first. The close is bracketed through
-- `Task/using`, so it is cancellation-safe.
pub let with(@A : Type, path : Str, mode : Mode, body : (File) -> Task(A)) -> Task(Result(A, Io/Error)) =
    Task/bind(open(path, mode), (opened) =>
        match opened : Task(Result(A, Io/Error))
        | success(f) =>
            Task/bind(Task/using(Task/pure(f), close, body), (a) =>
                Task/pure(Result/success(a)))
        | failure(e) => Task/pure(Result/failure(e))
        end);

let drain(f : File) -> Task(Bin) =
    rec go(acc : Bin) -> Task(Bin) =
        Task/bind(read(f, 4096), (r) =>
            match r : Task(Bin)
            | chunk(bytes) => go(Bin/concat(acc, bytes))
            | eof() => Task/pure(acc)
            | error(_) => Task/pure(acc)
            end);
    go(\\);

pub let read_all(path : Str) -> Task(Result(Bin, Io/Error)) =
    with(path, Mode/read(), (f) => drain(f));
