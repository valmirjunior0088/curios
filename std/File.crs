use /std/{Bin, Nat, Io, Result};

pub union Mode
| read()
| write()
| append()
end

pub union Error
| not_found()
| permission_denied()
| exists()
| other(Nat)
end

pub struct File { Io }

pub let read(f : File, n : Nat) -> { status : Nat, bytes : Bin } =
    Io/read(f.0, n);

pub let write(f : File, b : Bin) -> Nat =
    Io/write(f.0, b);

let close(f : File) -> {} =
    /sys/Io/close(f.0);

let token(mode : Mode) -> Nat =
    match mode : Nat
    | read() => 0
    | write() => 1
    | append() => 2
    end;

let decode(status : Nat) -> Error =
    match status : Error
    | 2 => Error/not_found()
    | 3 => Error/permission_denied()
    | 4 => Error/exists()
    | _ => Error/other(status)
    end;

pub let with(@A : Type, path : Bin, mode : Mode, body : (File) -> A) -> Result(A, Error) =
    let r = /sys/Io/open(path, token(mode));
    match Nat/eql(r.status, 0)
    | true =>
        let f = File { r.handle };
        let value = body(f);
        let closed = close(f);
        Result/success(value)
    | false => Result/failure(decode(r.status))
    end;

rec drain(f : File, acc : Bin) -> Bin =
    let r = read(f, 4096);
    match Nat/eql(r.status, 0)
    | true => drain(f, Bin/concat(acc, r.bytes))
    | false => acc
    end;

pub let read_all(path : Bin) -> Result(Bin, Error) =
    with(path, Mode/read(), (f) => drain(f, \\));
