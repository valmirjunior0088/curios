use /std/{Io, Bin, Nat, Option};

pub let Buffer : Type =
    { Io, Bin };

pub let Reader(A : Type) -> Type =
    (Buffer) -> { Buffer, A };

pub let buffer(h : Io) -> Buffer =
    (h, \\);

pub let pure(@A : Type, a : A) -> Reader(A) =
    (b) => (b, a);

pub let bind(@A : Type, @B : Type) -> (Reader(A), (A) -> Reader(B)) -> Reader(B) =
    (m, f) => (b) =>
        let p = m(b);
        f(p.1)(p.0);

pub let run(@A : Type, m : Reader(A), h : Io) -> A =
    m(buffer(h)).1;

let find_newline(buf : Bin) -> Option(Nat) =
    let (_, result) : { Nat, Option(Nat) } =
        Bin/fold(buf, (0, Option/none()), (byte, acc) =>
            match acc.1
            | some(_) => acc
            | none() =>
                match Nat/eql(byte, '\n')
                | true => (acc.0, Option/some(acc.0))
                | false => (Nat/add(acc.0, 1), Option/none())
                end
            end);
    result;

pub rec read_line : Reader(Option(Bin)) =
    (b) =>
        match find_newline(b.1) : { Buffer, Option(Bin) }
        | some(i) =>
            let stop = Nat/add(i, 1);
            let line = Bin/slice(b.1, 0, stop);
            let rest = Bin/slice(b.1, stop, Bin/len(b.1));
            ((b.0, rest), Option/some(line))
        | none() =>
            match Io/read(b.0, 4096) : { Buffer, Option(Bin) }
            | chunk(bytes) => read_line((b.0, Bin/concat(b.1, bytes)))
            | eof() =>
                match Nat/eql(Bin/len(b.1), 0)
                | true => (b, Option/none())
                | false => ((b.0, \\), Option/some(b.1))
                end
            | error(_) =>
                match Nat/eql(Bin/len(b.1), 0)
                | true => (b, Option/none())
                | false => ((b.0, \\), Option/some(b.1))
                end
            end
        end;
