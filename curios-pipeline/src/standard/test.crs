use /std/{Nat, Str, Bytes, List, Option, Io, Proc, Spell, Test};

-- What the test program's runner is handed of what a test found, one check that failed a call: the text `/std/Test`'s `Spell` writes of a failure, which the runner reads back as Curios. The runner answers it, and nothing else does.
foreign report(Bytes) -> {};

-- The index `raw` spells, where it spells one.
let parse_index(raw: Bytes) -> Option(Nat) =>
    match Str/of_bytes(raw)
    | success(s) => Nat/of_str(s)
    | failure(_) => Option/none()
    end;

-- The test the runner selected by `raw`, its index in `tests`, or one failing for naming none: an index the program does not hold is the runner's fault, said as a failure so a run that reports nothing is one that held.
let selected(tests: List(() -> Test({})), raw: Option(Bytes)) -> Test({}) =>
    match raw
    | some(raw) =>
        match parse_index(raw)
        | some(index) =>
            match List/try_get(tests, index)
            | some(body) => body()
            | none() =>
                Test/fail(Str/concat("the runner named no test at index ", Nat/to_str(index)))
            end
        | none() => Test/fail("the runner named a test by no index")
        end
    | none() => Test/fail("the runner named no test")
    end;

--- Run the test the runner selected, its index in `tests` the program's first argument, and hand the runner each check it found failed, in order: a test that held reports nothing.
pub let main(tests: List(() -> Test({}))) -> Io({}) =>
    let arguments = Proc/args()!;
    let failures = Test/run(selected(tests, List/try_get(arguments, 1)))!;
    List/each(failures, (failure) => report(Str/to_bytes(Spell/spell(failure))));
