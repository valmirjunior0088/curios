use /Parse;
use /std/Arr;
use /std/Str;
use /json/value;

let is_ws(byte : Nat) -> Bln =
    match byte : Bln;
    | ' ' => true;
    | '\t' => true;
    | '\n' => true;
    | '\r' => true;
    | _ => false;;

let is_num_byte(byte : Nat) -> Bln =
    match byte : Bln;
    | '-' => true;
    | '+' => true;
    | '.' => true;
    | 'e' => true;
    | 'E' => true;
    | _ =>
        match Nat.lte(48, byte) : Bln;
        | true => Nat.lte(byte, 57);
        | false => false;;;

let take_literal(literal : Bin) -> Parse/Parse({}) =
    (input, pos) =>
        let max : Nat = Bin.len(literal);
        let r : { Nat, Bln } =
            match max : { Nat, Bln };
            | 0 => (pos, true);
            | step ih =>
                match ih.1 : { Nat, Bln };
                | false => ih;
                | true =>
                    match Nat.lt(ih.0, Bin.len(input)) : { Nat, Bln };
                    | false => (ih.0, false);
                    | true =>
                        match Nat.eql(Bin.get(literal, step), Bin.get(input, ih.0)) : { Nat, Bln };
                        | true  => (Nat.add(ih.0, 1), true);
                        | false => (ih.0, false);;;;;
        match r.1 : Parse/Result({ Nat, {} });
        | true  => ('ok, (r.0, ()));
        | false => ('err, "unexpected literal");;

let parse_null : Parse/Parse(value/Value) =
    Parse/map({}, value/Value, _ => ('null, ()), take_literal("null"));

let parse_true_val : Parse/Parse(value/Value) =
    Parse/map({}, value/Value, _ => ('bln, true), take_literal("true"));

let parse_false_val : Parse/Parse(value/Value) =
    Parse/map({}, value/Value, _ => ('bln, false), take_literal("false"));

let parse_num : Parse/Parse(value/Value) = (input, pos) =>
    let r : Parse/Result({ Nat, Bin }) = Parse/take_while(is_num_byte)(input, pos);
    let bytes : Bin = r.1.1;
    match Nat.eql(Bin.len(bytes), 0) : Parse/Result({ Nat, value/Value });
    | true  => ('err, "expected number");
    | false => ('ok, (r.1.0, ('num, Str/from_flt(bytes))));;

let is_not_string_special(byte : Nat) -> Bln =
    match byte : Bln;
    | '"'  => false;
    | '\\' => false;
    | _    => true;;

let parse_str_escape : Parse/Parse(Bin) = (input, pos) =>
    let r1 : Parse/Result({ Nat, Nat }) = Parse/take_byte('\\')(input, pos);
    match r1.0 : Parse/Result({ Nat, Bin });
    | 'err => ('err, r1.1);
    | 'ok  =>
        let r2 : Parse/Result({ Nat, Nat }) = Parse/any_byte(input, r1.1.0);
        match r2.0 : Parse/Result({ Nat, Bin });
        | 'err => ('err, r2.1);
        | 'ok  =>
            match r2.1.1 : Parse/Result({ Nat, Bin });
            | '"'  => ('ok, (r2.1.0, "\""));
            | '\\' => ('ok, (r2.1.0, "\\"));
            | 'n'  => ('ok, (r2.1.0, "\n"));
            | 'r'  => ('ok, (r2.1.0, "\r"));
            | 't'  => ('ok, (r2.1.0, "\t"));
            | _    => ('err, "unknown escape");;;;

let parse_str_segment : Parse/Parse(Bin) =
    Parse/take_while(is_not_string_special);

let parse_str_body : Parse/Parse(Arr(Bin)) =
    Parse/many0(Bin, Parse/or(Bin, parse_str_escape, parse_str_segment));

let parse_raw_str : Parse/Parse(Bin) = (input, pos) =>
    let r1 : Parse/Result({ Nat, Nat }) = Parse/take_byte('"')(input, pos);
    match r1.0 : Parse/Result({ Nat, Bin });
    | 'err => ('err, r1.1);
    | 'ok  =>
        let r2 : Parse/Result({ Nat, Arr(Bin) }) = parse_str_body(input, r1.1.0);
        match r2.0 : Parse/Result({ Nat, Bin });
        | 'err => ('err, r2.1);
        | 'ok  =>
            let r3 : Parse/Result({ Nat, Nat }) = Parse/take_byte('"')(input, r2.1.0);
            match r3.0 : Parse/Result({ Nat, Bin });
            | 'err => ('err, r3.1);
            | 'ok  =>
                let str : Bin =
                    Arr/fold(Bin, Bin, r2.1.1, "", (chunk, acc) => Bin.concat(acc, chunk));
                ('ok, (r3.1.0, str));;;;

let parse_str_value : Parse/Parse(value/Value) =
    Parse/map(Bin, value/Value, s => ('str, s), parse_raw_str);

pub rec decode : Parse/Parse(value/Value) = (input, pos) =>
    match Nat.lt(pos, Bin.len(input)) : Parse/Result({ Nat, value/Value });
    | false => ('err, "unexpected end of input");
    | true  =>
        match Bin.get(input, pos) : Parse/Result({ Nat, value/Value });
        | ' '  => decode(input, Nat.add(pos, 1));
        | '\t' => decode(input, Nat.add(pos, 1));
        | '\n' => decode(input, Nat.add(pos, 1));
        | '\r' => decode(input, Nat.add(pos, 1));
        | 'n'  => parse_null(input, pos);
        | 't'  => parse_true_val(input, pos);
        | 'f'  => parse_false_val(input, pos);
        | '"'  => parse_str_value(input, pos);
        | '['  => parse_arr(input, pos);
        | '{'  => parse_obj(input, pos);
        | _    => parse_num(input, pos);;
and parse_arr : Parse/Parse(value/Value) = (input, pos) =>
    let r1 : Parse/Result({ Nat, Nat }) = Parse/take_byte('[')(input, pos);
    match r1.0 : Parse/Result({ Nat, value/Value });
    | 'err => ('err, r1.1);
    | 'ok  =>
        let r2 : Parse/Result({ Nat, Arr(value/Value) }) =
            Parse/sep_by0(value/Value, Nat, decode, Parse/take_byte(','))(input, r1.1.0);
        match r2.0 : Parse/Result({ Nat, value/Value });
        | 'err => ('err, r2.1);
        | 'ok  =>
            let r3 : Parse/Result({ Nat, Nat }) = Parse/take_byte(']')(input, r2.1.0);
            match r3.0 : Parse/Result({ Nat, value/Value });
            | 'err => ('err, r3.1);
            | 'ok  => ('ok, (r3.1.0, ('arr, r2.1.1)));;;
and parse_obj : Parse/Parse(value/Value) = (input, pos) =>
    let r1 : Parse/Result({ Nat, Nat }) = Parse/take_byte('{')(input, pos);
    match r1.0 : Parse/Result({ Nat, value/Value });
    | 'err => ('err, r1.1);
    | 'ok  =>
        let r2 : Parse/Result({ Nat, Arr({ Bin, value/Value }) }) =
            Parse/sep_by0({ Bin, value/Value }, Nat, parse_pair, Parse/take_byte(','))(input, r1.1.0);
        match r2.0 : Parse/Result({ Nat, value/Value });
        | 'err => ('err, r2.1);
        | 'ok  =>
            let r3 : Parse/Result({ Nat, Nat }) = Parse/take_byte('}')(input, r2.1.0);
            match r3.0 : Parse/Result({ Nat, value/Value });
            | 'err => ('err, r3.1);
            | 'ok  => ('ok, (r3.1.0, ('obj, r2.1.1)));;;
and parse_pair : Parse/Parse({ Bin, value/Value }) = (input, pos) =>
    let r1 : Parse/Result({ Nat, Bin }) = parse_raw_str(input, pos);
    match r1.0 : Parse/Result({ Nat, { Bin, value/Value } });
    | 'err => ('err, r1.1);
    | 'ok  =>
        let r2 : Parse/Result({ Nat, Nat }) = Parse/take_byte(':')(input, r1.1.0);
        match r2.0 : Parse/Result({ Nat, { Bin, value/Value } });
        | 'err => ('err, r2.1);
        | 'ok  =>
            let r3 : Parse/Result({ Nat, value/Value }) = decode(input, r2.1.0);
            match r3.0 : Parse/Result({ Nat, { Bin, value/Value } });
            | 'err => ('err, r3.1);
            | 'ok  => ('ok, (r3.1.0, (r1.1.1, r3.1.1)));;;;
