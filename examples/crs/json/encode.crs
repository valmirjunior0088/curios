use /std/{Arr, Bin, Bln, Flt, Nat};
use /json/{Value};

let encode_num(n : Flt) -> Bin =
    let str : Bin = Flt/to_str(n);
    match Nat/eql(Bin/get(str, 0), '+') : Bin
    | true => Bin/slice(str, 1, Bin/len(str))
    | false => str
    end;

let encode_str(s : Bin) -> Bin =
    Bin/concat(Bin/concat("\"",
        Bin/fold(Bin, s, "", (byte, acc) =>
            match byte : Bin
            | '"' => Bin/concat(acc, "\\\"")
            | '\\' => Bin/concat(acc, "\\\\")
            | '\n' => Bin/concat(acc, "\\n")
            | '\r' => Bin/concat(acc, "\\r")
            | '\t' => Bin/concat(acc, "\\t")
            | _ => Bin/append(acc, byte)
            end)),
        "\"");

pub rec encode(v: Value) -> Bin =
    match v : Bin
    | null() => "null"
    | bln(b) => Bln/to_str(b)
    | num(n) => encode_num(n)
    | str(s) => encode_str(s)
    | arr(xs) =>
        Bin/concat(Bin/concat("[",
            Bin/join(",", Arr/map(Value, Bin, encode, xs))), "]")
    | obj(ps) =>
        Bin/concat(Bin/concat("{",
            Bin/join(",", Arr/map({ Bin, Value }, Bin,
                (pair) => Bin/concat(Bin/concat(encode_str(pair.0), ":"), encode(pair.1)),
                ps))),
            "}")
    end;
