pub use /sys/Bin/*;
pub use /sys/{Bin};
use /std/{Arr, Nat};

pub let fold(A : Type, str : Bin, init : A, f : (Nat, A) -> A) -> A =
    match len(str) : A
    | 0 => init
    | pred ih => f(get(str, pred), ih)
    end;

pub let join(sep : Bin, parts : Arr(Bin)) -> Bin =
    Arr/fold(Bin, Bin, parts, "", (part, acc) =>
        match Nat/eql(len(acc), 0) : Bin
        | true => part
        | false => concat(concat(acc, sep), part)
        end);
