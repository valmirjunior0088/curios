use /std/{Nat, Bin, Bln, Arr};

pub union Result(A : Type)
| ok(A)
| err(Bin)
end

pub let Parse(A : Type) -> Type =
    (Bin, Nat) -> Result({ Nat, A });

pub let run(A : Type, p : Parse(A), input : Bin) -> Result(A) =
    let r : Result({ Nat, A }) = p(input, 0);
    match r : Result(A)
    | ok(pair) => Result/ok(A, pair.1)
    | err(msg) => Result/err(A, msg)
    end;

pub let pure(A : Type, a : A) -> Parse(A) =
    (input, pos) => Result/ok({ Nat, A }, (pos, a));

pub let fail(A : Type, msg : Bin) -> Parse(A) =
    (input, pos) => Result/err({ Nat, A }, msg);

pub let map(A : Type, B : Type, f : A -> B, p : Parse(A)) -> Parse(B) =
    (input, pos) =>
        let r : Result({ Nat, A }) = p(input, pos);
        match r : Result({ Nat, B })
        | ok(pair) => Result/ok({ Nat, B }, (pair.0, f(pair.1)))
        | err(msg) => Result/err({ Nat, B }, msg)
        end;

pub let bind(A : Type, B : Type, p : Parse(A), f : A -> Parse(B)) -> Parse(B) =
    (input, pos) =>
        let r : Result({ Nat, A }) = p(input, pos);
        match r : Result({ Nat, B })
        | ok(pair) => f(pair.1)(input, pair.0)
        | err(msg) => Result/err({ Nat, B }, msg)
        end;

pub let or(A : Type, p : Parse(A), q : Parse(A)) -> Parse(A) =
    (input, pos) =>
        let r : Result({ Nat, A }) = p(input, pos);
        match r : Result({ Nat, A })
        | ok(_) => r
        | err(_) => q(input, pos)
        end;

pub let and(A : Type, B : Type, p : Parse(A), q : Parse(B)) -> Parse({ A, B }) =
    (input, pos) =>
        let r : Result({ Nat, A }) = p(input, pos);
        match r : Result({ Nat, { A, B } })
        | ok(rp) =>
            let s : Result({ Nat, B }) = q(input, rp.0);
            match s : Result({ Nat, { A, B } })
            | ok(sp) => Result/ok({ Nat, { A, B } }, (sp.0, (rp.1, sp.1)))
            | err(msg) => Result/err({ Nat, { A, B } }, msg)
            end
        | err(msg) => Result/err({ Nat, { A, B } }, msg)
        end;

pub let and_drop(A : Type, B : Type, p : Parse(A), q : Parse(B)) -> Parse(A) =
    (input, pos) =>
        let r : Result({ Nat, A }) = p(input, pos);
        match r : Result({ Nat, A })
        | ok(rp) =>
            let s : Result({ Nat, B }) = q(input, rp.0);
            match s : Result({ Nat, A })
            | ok(sp) => Result/ok({ Nat, A }, (sp.0, rp.1))
            | err(msg) => Result/err({ Nat, A }, msg)
            end
        | err(_) => r
        end;

pub let and_keep(A : Type, B : Type, p : Parse(A), q : Parse(B)) -> Parse(B) =
    (input, pos) =>
        let r : Result({ Nat, A }) = p(input, pos);
        match r : Result({ Nat, B })
        | ok(pair) => q(input, pair.0)
        | err(msg) => Result/err({ Nat, B }, msg)
        end;

pub let any_byte : Parse(Nat) = (input, pos) =>
    match Nat/lt(pos, Bin/len(input)) : Result({ Nat, Nat })
    | false => Result/err({ Nat, Nat }, "unexpected end of input")
    | true  => Result/ok({ Nat, Nat }, (Nat/add(pos, 1), Bin/get(input, pos)))
    end;

pub let peek_byte : Parse(Nat) = (input, pos) =>
    match Nat/lt(pos, Bin/len(input)) : Result({ Nat, Nat })
    | false => Result/err({ Nat, Nat }, "unexpected end of input")
    | true  => Result/ok({ Nat, Nat }, (pos, Bin/get(input, pos)))
    end;

pub let take_byte(expected : Nat) -> Parse(Nat) =
    (input, pos) =>
        match Nat/lt(pos, Bin/len(input)) : Result({ Nat, Nat })
        | false => Result/err({ Nat, Nat }, "unexpected end of input")
        | true  =>
            let byte : Nat = Bin/get(input, pos);
            match Nat/eql(byte, expected) : Result({ Nat, Nat })
            | true  => Result/ok({ Nat, Nat }, (Nat/add(pos, 1), byte))
            | false => Result/err({ Nat, Nat }, "unexpected byte")
            end
        end;

pub let take_while(pred : Nat -> Bln) -> Parse(Bin) =
    (input, pos) =>
        let max : Nat = Nat/sub(Bin/len(input), pos);
        let r : { Nat, Bin, Bln } =
            match max : { Nat, Bin, Bln }
            | 0 => (pos, "", false)
            | step ih =>
                match ih.2 : { Nat, Bin, Bln }
                | true  => ih
                | false =>
                    let byte : Nat = Bin/get(input, ih.0);
                    match pred(byte) : { Nat, Bin, Bln }
                    | true  => (Nat/add(ih.0, 1), Bin/append(ih.1, byte), false)
                    | false => (ih.0, ih.1, true)
                    end
                end
            end;
        Result/ok({ Nat, Bin }, (r.0, r.1));

pub let many0(A : Type, p : Parse(A)) -> Parse(Arr(A)) =
    (input, pos) =>
        let empty : Arr(A) = [];
        rec go : (Arr(A), Nat) -> Result({ Nat, Arr(A) }) = (acc, cur) =>
            let r : Result({ Nat, A }) = p(input, cur);
            match r : Result({ Nat, Arr(A) })
            | err(_) => Result/ok({ Nat, Arr(A) }, (cur, acc))
            | ok(pair) =>
                match Nat/eql(pair.0, cur) : Result({ Nat, Arr(A) })
                | true  => Result/ok({ Nat, Arr(A) }, (cur, acc))
                | false => go(Arr/append(A, acc, pair.1), pair.0)
                end
            end;
        go(empty, pos);

pub let sep_by0(A : Type, S : Type, elem : Parse(A), sep : Parse(S)) -> Parse(Arr(A)) =
    (input, pos) =>
        let r : Result({ Nat, A }) = elem(input, pos);
        match r : Result({ Nat, Arr(A) })
        | err(_) =>
            Result/ok({ Nat, Arr(A) }, (pos, []))
        | ok(rp) =>
            let init : Arr(A) = [rp.1];
            rec go : (Arr(A), Nat) -> Result({ Nat, Arr(A) }) = (acc, cur) =>
                let s : Result({ Nat, S }) = sep(input, cur);
                match s : Result({ Nat, Arr(A) })
                | err(_) => Result/ok({ Nat, Arr(A) }, (cur, acc))
                | ok(sp) =>
                    let t : Result({ Nat, A }) = elem(input, sp.0);
                    match t : Result({ Nat, Arr(A) })
                    | err(_) => Result/ok({ Nat, Arr(A) }, (cur, acc))
                    | ok(tp) => go(Arr/append(A, acc, tp.1), tp.0)
                    end
                end;
            go(init, rp.0)
        end;
