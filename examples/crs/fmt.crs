use /std/{Bin, Nat, Parse, Io, Bln};

pub rec Fmt : Type = {
    tag : '[nil, lit, str, nat],
    match tag : Type
    | 'nil => {}
    | 'lit => { Bin, Fmt }
    | 'str => Fmt
    | 'nat => Fmt
    end };

pub rec format_type_with(result: Type, f: Fmt) -> Type =
    match f.0 : Type
    | 'nil => result
    | 'lit => format_type_with(result, f.1.1)
    | 'str => Bin -> format_type_with(result, f.1)
    | 'nat => Nat -> format_type_with(result, f.1)
    end;

let is_not_pct(byte : Nat) -> Bln =
    match byte : Bln
    | '%' => false
    | _   => true
    end;

rec parse_fmt : Parse(Fmt) = (input, pos) =>
    match Nat/lt(pos, Bin/len(input)) : Parse/Result({ Nat, Fmt })
    | false => ('ok, (pos, ('nil, ())))
    | true  =>
        match Nat/eql(Bin/get(input, pos), '%') : Parse/Result({ Nat, Fmt })
        | false => parse_lit(input, pos)
        | true  => parse_spec(input, pos)
        end
    end
and parse_spec : Parse(Fmt) =
    Parse/or(Fmt,
        Parse/bind(Nat, Fmt, Parse/take_byte('%'), _ =>
        Parse/bind(Nat, Fmt, Parse/any_byte, byte =>
        Parse/bind(Fmt, Fmt, parse_fmt, rest =>
            match byte : Parse(Fmt)
            | 's' => Parse/pure(Fmt, ('str, rest))
            | 'd' => Parse/pure(Fmt, ('nat, rest))
            | _   => Parse/pure(Fmt, rest)
            end))),
        Parse/map(Nat, Fmt, _ => ('lit, ("%", ('nil, ()))), Parse/take_byte('%')))
and parse_lit : Parse(Fmt) =
    Parse/bind(Bin, Fmt, Parse/take_while(is_not_pct), bytes =>
    Parse/bind(Fmt, Fmt, parse_fmt, rest =>
        Parse/pure(Fmt, ('lit, (bytes, rest)))));

pub let parse(input : Bin) -> Fmt =
    let r : Parse/Result(Fmt) = Parse/run(Fmt, parse_fmt, input);
    match r.0 : Fmt
    | 'ok  => r.1
    | 'err => ('nil, ())
    end;

rec go_with(result : Type, finish : Bin -> result, f : Fmt, acc : Bin) -> format_type_with(result, f) =
    match f.0 : format_type_with(result, f)
    | 'nil => finish(acc)
    | 'lit => go_with(result, finish, f.1.1, Bin/concat(acc, f.1.0))
    | 'str => s => go_with(result, finish, f.1, Bin/concat(acc, s))
    | 'nat => n => go_with(result, finish, f.1, Bin/concat(acc, Nat/to_str(n)))
    end;

pub let format(s : Bin) -> format_type_with(Bin, parse(s)) =
    go_with(Bin, x => x, parse(s), "");

pub let printf(s : Bin) -> format_type_with({}, parse(s)) =
    go_with({}, x => Io/print(x), parse(s), "");
