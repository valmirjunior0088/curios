pub mod std;
pub mod parser;
pub mod json;

let value : json/Value = ('obj, [
    ("name", ('str, "Alice")),
    ("score", ('num, +9.5)),
    ("active", ('bln, true)),
    ("tags", ('arr, [('str, "x"), ('str, "y")])),
    ("extra", ('null, ()))
]);

let encoded : Bin = json/encode value;

let decoded : parser/Result { Nat, json/Value } = json/decode encoded 0;

match decoded.0 : {};
| 'ok  => Sys.print (json/encode decoded.1.1);
| 'err => Sys.print decoded.1;
