-- JSONTestSuite's documents, decoded by `Json/decode`, each answered as its name's prefix asks: a `y_` document read, an `n_` one refused, and an `i_` one, which a parser is free to decide, either way. The one argument is the directory the cases stand in; every case answered otherwise is named, and the program fails where any is.
use /std/{Str, List, Option, Result, Try, Io, Proc, Fmt, Json, Path, File, fs, Bool, Bytes, Monad};

--- Whether `bytes` read as one JSON document: bytes that are no UTF-8 are no text, and refused where they would become text.
let reads(bytes: Bytes) -> Bool =
    match Str/of_bytes(bytes)
    | failure(_) => false
    | success(text) =>
        match Json/decode(text) | failure(_) => false | success(_) => true end
    end;

--- What is wrong with the case `name`, which the decoder answered `read`: nothing where its prefix leaves the answer free or the answer is the one the prefix asks for.
let judged(name: Str, read: Bool) -> Option(Str) =
    match (Str/starts_with(name, "y_"), Str/starts_with(name, "n_"), read)
    | (true, _, false) => Option/some(Str/concat(name, " is refused, which a parser must read"))
    | (_, true, true) => Option/some(Str/concat(name, " is read, which a parser must refuse"))
    | _ => Option/none()
    end;

let execute() -> Try(Io, Str, {}) =
    let arguments = Proc/args()!;
    let given =
        Option/to_result(List/try_get(arguments, 1), "the corpus's directory is the one argument")!;
    let directory = Path/of_bytes(given);
    let names =
        Try/map_failure(fs/list(directory), (_) => "the corpus's directory cannot be listed")!;
    let answers =
        List/traverse(names, (name: Path) =>
            let case = Result/map_failure(Path/to_str(name), (_) => "a case's name is not text")!;
            let bytes =
                Try/map_failure(
                    File/read_all(Path/join(directory, name)),
                    (_) => Str/concat("cannot read ", case))!;
            Try/pure((case, reads(bytes))))!;
    let wrong = List/filter_map(answers, (answer: {Str, Bool}) => judged(answer.0, answer.1));
    let read = List/length(List/filter(answers, (answer: {Str, Bool}) => answer.1));
    let () = Monad/lift(Fmt/print("% cases, % read\n")(List/length(answers))(read))!;
    match List/length(wrong)
    | 0 => Try/pure(())
    | count => Try/raise(Str/join("\n", [Fmt/render("% answered otherwise:")(count), ..wrong]))
    end;

execute()
