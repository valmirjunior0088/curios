-- A line comment.
use /std/{Nat, Option, mod Syntax, let parse};
pub use Option/*;

pub let zero: Nat = 0;

pub let map(@A: Type, @B: Type, m: Option(A), f: (A) -> B) -> Option(B) =
    match m | some(a) => Option/some(f(a)) | none() => Option/none() end;

pub rec even(n: Nat) -> Bool = match n | 0 => true | p + 1; _ => odd(p) end
and odd(n: Nat) -> Bool = even(n);

pub let and(p: Parse(A), q: Parse(B)) -> Parse({A, B}) = Parse/and(p, q);

satisfy Show(Nat) {
    show(n) = Nat/to_str(n),
}

satisfy (@A: Type, use Show(A)) => Show(List(A)) {
    show = show_list,
}
